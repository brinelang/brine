# Overflow-checked i128 arithmetic: each returns None where Rust's checked_*
# would (brine's own arithmetic panics on overflow instead).
from types import I128_MAX, I128_MIN, u128_max

fn checked_add(a: i128, b: i128) -> Option[i128]:
    if b > 0 and a > I128_MAX - b:
        return None
    if b < 0 and a < I128_MIN - b:
        return None
    return Some(a + b)

fn checked_sub(a: i128, b: i128) -> Option[i128]:
    if b < 0 and a > I128_MAX + b:
        return None
    if b > 0 and a < I128_MIN + b:
        return None
    return Some(a - b)

fn checked_neg(a: i128) -> Option[i128]:
    if a == I128_MIN:
        return None
    return Some(-a)

# |a| as a u128 (works for the smallest i128 too)
fn magnitude(a: i128) -> u128:
    if a >= 0:
        return u128(a)
    if a == I128_MIN:
        return u128(I128_MAX) + 1
    return u128(-a)

fn checked_mul(a: i128, b: i128) -> Option[i128]:
    if a == 0 or b == 0:
        return Some(0)
    let ma = magnitude(a)
    let mb = magnitude(b)
    if ma > u128_max() / mb:
        return None
    let p = ma * mb
    if (a < 0) != (b < 0):
        if p == u128(I128_MAX) + 1:
            return Some(I128_MIN)
        if p > u128(I128_MAX):
            return None
        return Some(-i128(p))
    if p > u128(I128_MAX):
        return None
    return Some(i128(p))

# Integer division rounding toward negative infinity (Python's `//`, brine's `/`).
fn floor_div(a: i128, b: i128) -> Option[i128]:
    if b == 0 or (a == I128_MIN and b == -1):
        return None
    return Some(a / b)

# The remainder with the sign of `b` (brine's `%`).
fn floor_mod(a: i128, b: i128) -> Option[i128]:
    if b == 0:
        return None
    if b == -1:
        return Some(0)
    return Some(a % b)

fn checked_shl(a: i128, b: i128) -> Option[i128]:
    if b < 0 or b >= 128:
        return None
    if b == 0 or a == 0:
        return Some(a)
    # the result must fit: |a| < 2^(127 - b)
    let limit = u128(1) << u128(127 - b)
    if a > 0 and u128(a) >= limit:
        return None
    if a < 0 and magnitude(a) > limit:
        return None
    if a < 0:
        let p = magnitude(a) << u128(b)
        if p == u128(I128_MAX) + 1:
            return Some(I128_MIN)
        return Some(-i128(p))
    return Some(i128(u128(a) << u128(b)))

fn checked_shr(a: i128, b: i128) -> Option[i128]:
    if b < 0 or b >= 128:
        return None
    return Some(a >> b)

# The 64 bits of `u` as an int (two's complement), for values >= 2^63 too.
fn u64_to_int(u: u64) -> int:
    let top: u64 = 9223372036854775807
    if u <= top:
        return int(u)
    return int(i128(u) - 18446744073709551616)
