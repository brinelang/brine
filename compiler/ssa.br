# SSA optimizations on the IR (ir.br) for native code, the same for every
# target. `optimize` takes a function as the lowering made it (flat code with
# labels, vregs assigned any number of times) to SSA form over basic blocks,
# simplifies it there, and turns it back into flat code:
#
# * SSA: every vreg is assigned once; where control flow merges, a `Phi`
#   picks the value of the edge it came in on (semi-pruned: only for vregs
#   read in a block other than the one that set them).
# * Constants: sparse conditional constant propagation (Wegman and Zadeck)
#   folds integer arithmetic, comparisons, conversions and checks whose
#   operands are known, and the branches they decide; code no executable
#   edge reaches goes away.
# * Redundancy: value numbering over the dominator tree. A pure instruction,
#   or a check that a dominating identical check already passed, reuses that
#   one's result; so does a load of a place an earlier load read or a store
#   wrote, with no write that may reach it in between (within an extended
#   basic block).
# * Loops: instructions whose operands don't change in a loop move to its
#   preheader. Ones that may panic or depend on memory only from the loop's
#   header, where they run on every trip, and only before anything with an
#   effect.
# * Dead code: instructions whose results nothing reads.
# * Vectors: innermost loops over arrays of doubles that vloop.br can run
#   several elements at a time get its kernel, called before the loop.
# * Lanes: innermost loops that run interleaved iterations in lockstep
#   (jam.br), four at a time doing the same work, get an AVX2 kernel from
#   vlane.br that runs them as vectors.
# * Reversals: a reversal of a prefix (lower.br's idiom) followed by a read
#   of the first element hands that element over in a register.
#
# Back in flat code every phi becomes copies at the end of its predecessors
# (critical edges are split first, and the copies on one edge are made in an
# order that doesn't overwrite a value another copy still reads).

from ir import K, Op, Inst, Func, KFunc, Slot
import vloop
import vlane
from vloop import LOp, L_LD, L_ST, L_ADD, L_SUB, L_MUL, L_DIV, L_IADD, L_ISUB, L_IMUL, L_IAND
from vloop import L_IOR, L_IXOR, L_SHL, L_SAR, L_SHR, L_CONV, L_RED

struct Block:
    label: int
    # phis first; the last instruction is the terminator. `Br` and `BrNot`
    # jump to label n, else to label c.
    code: [Inst]
    succ: [int]
    pred: [int]

struct SF:
    f: Func
    bs: [Block]
    # the block of each label, -1 for none
    lab: [int]

fn mk(op: Op, d: int, a: int, b: int, c: int, n: int) -> Inst:
    return Inst(op=op, d=d, a=a, b=b, c=c, n=n, s="", args=[])

fn is_term(op: Op) -> bool:
    match op:
        case Op.Jmp | Op.Br | Op.BrNot | Op.Switch | Op.Ret | Op.Unreachable:
            return true
        case _:
            return false

fn is_check(op: Op) -> bool:
    return op == Op.AddO or op == Op.SubO or op == Op.MulO or op == Op.IdxChk

# Every vreg x reads (a phi: its values, at odd positions of `args`).
fn uses(x: Inst) -> [int]:
    match x.op:
        case Op.Const | Op.FConst | Op.SlotAddr | Op.Global | Op.Label | Op.Jmp | Op.Line:
            return []
        case Op.Unreachable:
            return []
        case Op.Phi:
            var r: [int] = []
            var i = 1
            while i < len(x.args):
                r.push(x.args[i])
                i += 2
            return r
        case Op.Call:
            return x.args
        case Op.CallInd:
            var r = [x.a]
            r.extend(x.args)
            return r
        case Op.Ret:
            return [x.a] if x.a >= 0 else []
        case Op.Switch | Op.Br | Op.BrNot:
            return [x.a]
        case _:
            var r: [int] = []
            if x.a >= 0:
                r.push(x.a)
            if x.b >= 0:
                r.push(x.b)
            if is_check(x.op) and x.c >= 0:
                r.push(x.c)
            return r

# x with every vreg v it reads replaced by m[v].
fn map_uses(x: Inst, m: [int]) -> Inst:
    var y = x
    match x.op:
        case Op.Const | Op.FConst | Op.SlotAddr | Op.Global | Op.Label | Op.Jmp | Op.Line:
            return y
        case Op.Unreachable:
            return y
        case Op.Phi:
            var i = 1
            while i < len(y.args):
                y.args[i] = m[y.args[i]]
                i += 2
        case Op.Call:
            y.args = [m[v] for v in x.args]
        case Op.CallInd:
            y.a = m[x.a]
            y.args = [m[v] for v in x.args]
        case Op.Ret:
            if x.a >= 0:
                y.a = m[x.a]
        case Op.Switch | Op.Br | Op.BrNot:
            y.a = m[x.a]
        case _:
            if x.a >= 0:
                y.a = m[x.a]
            if x.b >= 0:
                y.b = m[x.b]
            if is_check(x.op) and x.c >= 0:
                y.c = m[x.c]
    return y

# Does x do something besides setting x.d (write memory, call, maybe panic,
# change control flow)?
fn effect(x: Inst) -> bool:
    match x.op:
        case Op.Store | Op.Copy | Op.Zero | Op.Call | Op.CallInd | Op.Line:
            return true
        case Op.AddO | Op.SubO | Op.MulO | Op.IdxChk:
            return true
        case _:
            return is_term(x.op)

# The labels a terminator can go to.
fn targets(x: Inst) -> [int]:
    match x.op:
        case Op.Jmp:
            return [x.n]
        case Op.Br | Op.BrNot:
            return [x.n, x.c]
        case Op.Switch:
            var r: [int] = []
            for l in x.args:
                if l not in r:
                    r.push(l)
            return r
        case _:
            return []

# A terminator that goes to label `to` where it went to `from`.
fn retarget(x: Inst, from: int, to: int) -> Inst:
    var y = x
    match x.op:
        case Op.Jmp:
            y.n = to
        case Op.Br | Op.BrNot:
            if y.n == from:
                y.n = to
            if y.c == from:
                y.c = to
        case Op.Switch:
            y.args = [to if l == from else l for l in x.args]
        case _:
            pass
    return y

# ================================================================ the CFG

fn new_label(ref sf: SF) -> int:
    sf.f.nlabels += 1
    sf.lab.push(-1)
    return sf.f.nlabels - 1

fn add_block(ref bs: [Block], label: int, code: [Inst]):
    bs.push(Block(label=label, code=code, succ=[], pred=[]))

fn build(f: Func) -> SF:
    var g = f
    g.code = []
    var nl = f.nlabels
    var bs: [Block] = []
    # an entry block nothing jumps back to, where the parameters (and any
    # vreg read before it's set) are defined
    var cur: [Inst] = []
    var label = nl
    nl += 1
    var open = true
    let n = len(f.code)
    var i = 0
    while i < n:
        let x = f.code[i]
        i += 1
        if x.op == Op.Line:
            continue
        if x.op == Op.Label:
            if open:
                cur.push(mk(Op.Jmp, -1, -1, -1, -1, x.n))
                add_block(ref bs, label, cur)
            cur = []
            label = x.n
            open = true
            continue
        if not open:
            # after a jump with no label: nothing reaches this
            cur = []
            label = nl
            nl += 1
            open = true
        if x.op == Op.Br or x.op == Op.BrNot:
            var y = x
            if i < n and f.code[i].op == Op.Label:
                y.c = f.code[i].n
                cur.push(y)
                add_block(ref bs, label, cur)
                open = false
            else:
                y.c = nl
                nl += 1
                cur.push(y)
                add_block(ref bs, label, cur)
                cur = []
                label = y.c
            continue
        cur.push(x)
        if is_term(x.op):
            add_block(ref bs, label, cur)
            open = false
    if open:
        cur.push(mk(Op.Ret, -1, -1, -1, -1, 0))
        add_block(ref bs, label, cur)
    g.nlabels = nl
    var sf = SF(f=g, bs=bs, lab=[-1] * nl)
    relink(ref sf)
    return sf

# Recomputes successors and predecessors from the terminators, drops the
# blocks the entry doesn't reach, and the phi entries of edges that are gone.
fn relink(ref sf: SF):
    let n = len(sf.bs)
    sf.lab = [-1] * sf.f.nlabels
    for i in 0..n:
        sf.lab[sf.bs[i].label] = i
    # a branch with both targets the same is a jump
    for i in 0..n:
        let m = len(sf.bs[i].code)
        let t = sf.bs[i].code[m - 1]
        if (t.op == Op.Br or t.op == Op.BrNot) and t.n == t.c:
            sf.bs[i].code[m - 1] = mk(Op.Jmp, -1, -1, -1, -1, t.n)
    var seen = [false] * n
    seen[0] = true
    var work = [0]
    while len(work) > 0:
        let b = work.pop()
        let m = len(sf.bs[b].code)
        for l in targets(sf.bs[b].code[m - 1]):
            let s = sf.lab[l]
            if not seen[s]:
                seen[s] = true
                work.push(s)
    var keep: [Block] = []
    for i in 0..n:
        if seen[i]:
            var b = sf.bs[i]
            b.succ = []
            b.pred = []
            keep.push(b)
    sf.bs = keep
    let k = len(keep)
    sf.lab = [-1] * sf.f.nlabels
    for i in 0..k:
        sf.lab[sf.bs[i].label] = i
    for i in 0..k:
        let m = len(sf.bs[i].code)
        for l in targets(sf.bs[i].code[m - 1]):
            let s = sf.lab[l]
            sf.bs[i].succ.push(s)
            sf.bs[s].pred.push(i)
    # phi entries for edges that no longer exist
    for i in 0..k:
        if len(sf.bs[i].code) == 0 or sf.bs[i].code[0].op != Op.Phi:
            continue
        var ok = [false] * sf.f.nlabels
        for p in sf.bs[i].pred:
            ok[sf.bs[p].label] = true
        for j in 0..len(sf.bs[i].code):
            let x = sf.bs[i].code[j]
            if x.op != Op.Phi:
                break
            var args: [int] = []
            var q = 0
            while q < len(x.args):
                if ok[x.args[q]]:
                    args.push(x.args[q])
                    args.push(x.args[q + 1])
                q += 2
            sf.bs[i].code[j].args = args

# Blocks in postorder from the entry.
fn postorder(bs: [Block]) -> [int]:
    let n = len(bs)
    var seen = [false] * n
    var out: [int] = []
    var st = [0]
    var it = [0]
    seen[0] = true
    while len(st) > 0:
        let top = len(st) - 1
        let b = st[top]
        let k = it[top]
        if k < len(bs[b].succ):
            it[top] = k + 1
            let s = bs[b].succ[k]
            if not seen[s]:
                seen[s] = true
                st.push(s)
                it.push(0)
        else:
            out.push(b)
            st.pop()
            it.pop()
    return out

# Immediate dominators (Cooper, Harvey and Kennedy); the entry's is itself.
fn idoms(bs: [Block], po: [int]) -> [int]:
    let n = len(bs)
    var pon = [-1] * n
    for i, b in enumerate(po):
        pon[b] = i
    var idom = [-1] * n
    idom[0] = 0
    var changed = true
    while changed:
        changed = false
        var j = len(po) - 1
        while j >= 0:
            let b = po[j]
            j -= 1
            if b == 0:
                continue
            var nd = -1
            for p in bs[b].pred:
                if idom[p] < 0:
                    continue
                if nd < 0:
                    nd = p
                else:
                    var x = p
                    var y = nd
                    while x != y:
                        while pon[x] < pon[y]:
                            x = idom[x]
                        while pon[y] < pon[x]:
                            y = idom[y]
                    nd = x
            if nd >= 0 and idom[b] != nd:
                idom[b] = nd
                changed = true
    return idom

fn dom_children(idom: [int]) -> [[int]]:
    var ch: [[int]] = [[]] * len(idom)
    for b in 1..len(idom):
        if idom[b] >= 0:
            ch[idom[b]].push(b)
    return ch

# Preorder numbers and subtree ends of the dominator tree: a dominates b when
# tin[a] <= tin[b] < tout[a].
fn dom_numbers(ch: [[int]]) -> ([int], [int]):
    let n = len(ch)
    var tin = [0] * n
    var tout = [0] * n
    var t = 0
    var st = [0]
    while len(st) > 0:
        let e = st.pop()
        if e < 0:
            tout[-e - 1] = t
            continue
        tin[e] = t
        t += 1
        st.push(-e - 1)
        var i = len(ch[e]) - 1
        while i >= 0:
            st.push(ch[e][i])
            i -= 1
    return (tin, tout)

# ================================================================ into SSA

fn undef_inst(d: int, k: K) -> Inst:
    if k.is_float():
        return mk(Op.FConst, d, -1, -1, -1, 0)
    return mk(Op.Const, d, -1, -1, 0, 0)

fn to_ssa(ref sf: SF):
    let n = len(sf.bs)
    let nv = len(sf.f.vk)
    let np = sf.f.nparams
    let po = postorder(sf.bs)
    let idom = idoms(sf.bs, po)
    let ch = dom_children(idom)
    # dominance frontiers
    var df: [[int]] = [[]] * n
    for b in 0..n:
        if len(sf.bs[b].pred) < 2:
            continue
        for p in sf.bs[b].pred:
            var r = p
            while r != idom[b]:
                if b not in df[r]:
                    df[r].push(b)
                r = idom[r]
    # vregs read in a block before it sets them, and the blocks setting each
    var glob = [false] * nv
    var defb: [[int]] = [[]] * nv
    var stamp = [-1] * nv
    for v in 0..np:
        defb[v].push(0)
        stamp[v] = 0
    for b in 0..n:
        for x in sf.bs[b].code:
            for u in uses(x):
                if stamp[u] != b:
                    glob[u] = true
            if x.d >= 0:
                if stamp[x.d] != b:
                    stamp[x.d] = b
                    defb[x.d].push(b)
        # the next block starts over
        for x in sf.bs[b].code:
            if x.d >= 0:
                stamp[x.d] = -1
        if b == 0:
            for v in 0..np:
                stamp[v] = -1
    # phis at the iterated dominance frontier of the blocks setting a vreg
    var phis: [[int]] = [[]] * n
    var placed = [-1] * n
    var inwork = [-1] * n
    for v in 0..nv:
        if not glob[v] or len(defb[v]) == 0:
            continue
        var work = defb[v]
        for b in work:
            inwork[b] = v
        while len(work) > 0:
            let b = work.pop()
            for d in df[b]:
                if placed[d] != v:
                    placed[d] = v
                    phis[d].push(v)
                    if inwork[d] != v:
                        inwork[d] = v
                        work.push(d)
    for b in 0..n:
        if len(phis[b]) == 0:
            continue
        var code: [Inst] = []
        for v in phis[b]:
            code.push(mk(Op.Phi, v, -1, -1, -1, v))
        code.extend(sf.bs[b].code)
        sf.bs[b].code = code
    # renaming, over the dominator tree
    let oldk = sf.f.vk
    var vk: [K] = []
    for v in 0..np:
        vk.push(oldk[v])
    var cur = [-1] * nv
    for v in 0..np:
        cur[v] = v
    var undef: {str: int} = {}
    var undef_code: [Inst] = []
    var log_v: [int] = []
    var log_old: [int] = []
    var marks = [0] * n
    var st = [0]
    while len(st) > 0:
        let e = st.pop()
        if e < 0:
            let b = -e - 1
            while len(log_v) > marks[b]:
                cur[log_v.pop()] = log_old.pop()
            continue
        let b = e
        marks[b] = len(log_v)
        st.push(-b - 1)
        var ci = len(ch[b]) - 1
        while ci >= 0:
            st.push(ch[b][ci])
            ci -= 1
        var code = sf.bs[b].code
        for i in 0..len(code):
            var x = code[i]
            if x.op != Op.Phi:
                for u in uses(x):
                    if cur[u] < 0:
                        let key = oldk[u].name()
                        match undef.get(key):
                            case Some(w):
                                cur[u] = w
                            case None:
                                let w = len(vk)
                                vk.push(oldk[u])
                                undef[key] = w
                                undef_code.push(undef_inst(w, oldk[u]))
                                cur[u] = w
                x = map_uses(x, cur)
            if x.d >= 0:
                let ov = x.d
                let nd = len(vk)
                vk.push(oldk[ov])
                log_v.push(ov)
                log_old.push(cur[ov])
                cur[ov] = nd
                x.d = nd
            code[i] = x
        sf.bs[b].code = code
        let lb = sf.bs[b].label
        for s in sf.bs[b].succ:
            for i in 0..len(sf.bs[s].code):
                let y = sf.bs[s].code[i]
                if y.op != Op.Phi:
                    break
                let ov = y.n
                var v = cur[ov]
                if v < 0:
                    let key = oldk[ov].name()
                    match undef.get(key):
                        case Some(w):
                            v = w
                        case None:
                            v = len(vk)
                            vk.push(oldk[ov])
                            undef[key] = v
                            undef_code.push(undef_inst(v, oldk[ov]))
                sf.bs[s].code[i].args.push(lb)
                sf.bs[s].code[i].args.push(v)
    if len(undef_code) > 0:
        undef_code.extend(sf.bs[0].code)
        sf.bs[0].code = undef_code
    sf.f.vk = vk

# ================================================================ constants

# Kinds whose values SCCP tracks: integers up to 64 bits, Bool and Ptr.
# Rewrites that give the same bits with less work: `2.0 * x` is `x + x`, and
# `a & (a & b)` (lanes of interleaved loops make it) is `a & b`.
fn rewrites(ref sf: SF):
    let nv = len(sf.f.vk)
    var two = [false] * nv
    var and_a = [-1] * nv
    var and_b = [-1] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.FConst and sf.f.vk[x.d] == K.F64 and x.n == 4611686018427387904:
                two[x.d] = true
            elif x.op == Op.And and x.d >= 0 and sf.f.vk[x.d] == K.Bool:
                and_a[x.d] = x.a
                and_b[x.d] = x.b
    for bi in 0..len(sf.bs):
        for i in 0..len(sf.bs[bi].code):
            let x = sf.bs[bi].code[i]
            if x.op == Op.Mul and x.d >= 0 and sf.f.vk[x.d] == K.F64:
                if two[x.a]:
                    sf.bs[bi].code[i] = mk(Op.Add, x.d, x.b, x.b, -1, 0)
                elif two[x.b]:
                    sf.bs[bi].code[i] = mk(Op.Add, x.d, x.a, x.a, -1, 0)
            elif x.op == Op.And and x.d >= 0 and sf.f.vk[x.d] == K.Bool:
                if and_a[x.b] == x.a or and_b[x.b] == x.a:
                    sf.bs[bi].code[i] = mk(Op.Mov, x.d, x.b, -1, -1, 0)
                elif and_a[x.a] == x.b or and_b[x.a] == x.b:
                    sf.bs[bi].code[i] = mk(Op.Mov, x.d, x.a, -1, -1, 0)

fn tracked(k: K) -> bool:
    return not k.is_float() and not k.is_wide()

fn bits_of(k: K) -> int:
    if k == K.Bool:
        return 1
    return k.size() * 8

fn two(e: int) -> i128:
    return i128(1) << e

# v (any value of the right magnitude) wrapped to kind k, canonical: the
# int holding it (64-bit unsigned values as their bit pattern).
fn wrapk(v: i128, k: K) -> int:
    if k == K.Bool:
        return 0 if v == 0 else 1
    let bits = bits_of(k)
    var m = v & (two(bits) - 1)
    if (k.is_signed() or bits == 64) and m >= two(bits - 1):
        m -= two(bits)
    return int(m)

# The number a canonical value of kind k stands for.
fn num(v: int, k: K) -> i128:
    if not k.is_signed() and v < 0:
        return i128(v) + two(64)
    return i128(v)

fn kmin(k: K) -> i128:
    if k.is_signed():
        return -two(bits_of(k) - 1)
    return 0

fn kmax(k: K) -> i128:
    if k == K.Bool:
        return 1
    if k.is_signed():
        return two(bits_of(k) - 1) - 1
    return two(bits_of(k)) - 1

# truncating division of numbers (b != 0)
fn tdiv(a: i128, b: i128) -> i128:
    let ma = a if a >= 0 else -a
    let mb = b if b >= 0 else -b
    let q = ma / mb
    return q if (a < 0) == (b < 0) else -q

const TOP = 0
const CONST = 1
const BOT = 2

# The value of x (setting a tracked kind) from its operands' values:
# (TOP | CONST | BOT, the constant).
fn fold(x: Inst, vk: [K], st: [int], val: [int]) -> (int, int):
    let k = vk[x.d]
    if x.op == Op.Mov:
        if not tracked(k):
            return (BOT, 0)
        return (st[x.a], val[x.a])
    if not tracked(k):
        return (BOT, 0)
    match x.op:
        case Op.Const:
            return (CONST, wrapk(i128(x.n), k))
        case Op.Add | Op.Sub | Op.Mul | Op.And | Op.Or | Op.Xor | Op.Shl | Op.Shr:
            pass
        case Op.Div | Op.Rem:
            pass
        case Op.AddO | Op.SubO | Op.MulO | Op.IdxChk:
            pass
        case Op.Neg | Op.Not | Op.Conv:
            if not tracked(vk[x.a]):
                return (BOT, 0)
            if st[x.a] != CONST:
                return (st[x.a], 0)
            let a = num(val[x.a], vk[x.a])
            match x.op:
                case Op.Neg:
                    return (CONST, wrapk(-a, k))
                case Op.Not:
                    if k == K.Bool:
                        return (CONST, 1 - int(a))
                    return (CONST, wrapk(a ^ (two(64) - 1), k))
                case _:
                    return (CONST, wrapk(a, k))
        case Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge:
            let ka = vk[x.a]
            if not tracked(ka):
                return (BOT, 0)
            if st[x.a] == BOT or st[x.b] == BOT:
                return (BOT, 0)
            if st[x.a] == TOP or st[x.b] == TOP:
                return (TOP, 0)
            let a = num(val[x.a], ka)
            let b = num(val[x.b], ka)
            var r = false
            match x.op:
                case Op.Eq:
                    r = a == b
                case Op.Ne:
                    r = a != b
                case Op.Lt:
                    r = a < b
                case Op.Le:
                    r = a <= b
                case Op.Gt:
                    r = a > b
                case _:
                    r = a >= b
            return (CONST, 1 if r else 0)
        case Op.Call:
            # the runtime's checked negation (`-B` for a constant B)
            if x.b != 1 or not x.s.starts_with("brine_neg_") or len(x.args) != 2:
                return (BOT, 0)
            let v = x.args[0]
            if vk[v] != k or st[v] != CONST:
                return (st[v] if st[v] == TOP else BOT, 0)
            let a = num(val[v], k)
            if a == kmin(k):
                return (BOT, 0)
            return (CONST, wrapk(-a, k))
        case _:
            return (BOT, 0)
    # binary arithmetic of kind k (checks: a and b of kind k too)
    let sa = st[x.a]
    let sb = st[x.b]
    # x * 0 and x & 0 are 0 whatever x is
    if (
        (x.op == Op.Mul or x.op == Op.And)
        and ((sa == CONST and val[x.a] == 0) or (sb == CONST and val[x.b] == 0))
    ):
        return (CONST, 0)
    if sa == BOT or sb == BOT:
        return (BOT, 0)
    if sa == TOP or sb == TOP:
        return (TOP, 0)
    let ka = vk[x.a]
    let a = num(val[x.a], ka)
    let b = num(val[x.b], vk[x.b])
    match x.op:
        case Op.Add:
            return (CONST, wrapk(a + b, k))
        case Op.Sub:
            return (CONST, wrapk(a - b, k))
        case Op.Mul:
            # the low 64 bits of the product, from the 64-bit patterns
            return (CONST, wrapk(i128(val[x.a]) * i128(val[x.b]), k))
        case Op.And:
            return (CONST, wrapk(i128(val[x.a] & val[x.b]), k))
        case Op.Or:
            return (CONST, wrapk(i128(val[x.a] | val[x.b]), k))
        case Op.Xor:
            return (CONST, wrapk(i128(val[x.a] ^ val[x.b]), k))
        case Op.Shl:
            if b < 0 or b >= i128(bits_of(k)):
                return (BOT, 0)
            return (CONST, wrapk(a << int(b), k))
        case Op.Shr:
            if b < 0 or b >= i128(bits_of(k)):
                return (BOT, 0)
            return (CONST, wrapk(a >> int(b), k))
        case Op.Div | Op.Rem:
            if b == 0 or (k.is_signed() and a == kmin(k) and b == -1):
                return (BOT, 0)
            let q = tdiv(a, b)
            if x.op == Op.Div:
                return (CONST, wrapk(q, k))
            return (CONST, wrapk(a - q * b, k))
        case Op.IdxChk:
            if a >= 0 and a < b:
                return (CONST, int(a))
            return (BOT, 0)
        case _:
            var r = a + b
            if x.op == Op.SubO:
                r = a - b
            elif x.op == Op.MulO:
                r = a * b
            if r < kmin(k) or r > kmax(k):
                return (BOT, 0)
            return (CONST, wrapk(r, k))

fn sccp(ref sf: SF):
    let n = len(sf.bs)
    let nv = len(sf.f.vk)
    var st = [TOP] * nv
    var val = [0] * nv
    for v in 0..sf.f.nparams:
        st[v] = BOT
    # where each vreg is read: block * 2^24 + index
    var users: [[int]] = [[]] * nv
    for b in 0..n:
        for i, x in enumerate(sf.bs[b].code):
            for u in uses(x):
                users[u].push(b * 16777216 + i)
    var exec_b = [false] * n
    var exec_e: {int: bool} = {}
    var flow: [int] = [n * n]
    var ssa_work: [int] = []
    while len(flow) > 0 or len(ssa_work) > 0:
        while len(flow) > 0:
            let e = flow.pop()
            var b = 0
            if e != n * n:
                if e in exec_e:
                    continue
                exec_e[e] = true
                b = e % n
            if exec_b[b]:
                # a new edge into a block already seen: only its phis change
                for i in 0..len(sf.bs[b].code):
                    if sf.bs[b].code[i].op != Op.Phi:
                        break
                    sccp_inst(sf, b, i, ref st, ref val, exec_e, exec_b, ref flow, ref ssa_work)
                continue
            exec_b[b] = true
            for i in 0..len(sf.bs[b].code):
                sccp_inst(sf, b, i, ref st, ref val, exec_e, exec_b, ref flow, ref ssa_work)
        while len(ssa_work) > 0:
            let v = ssa_work.pop()
            for u in users[v]:
                let b = u / 16777216
                if exec_b[b]:
                    sccp_inst(
                        sf,
                        b,
                        u % 16777216,
                        ref st,
                        ref val,
                        exec_e,
                        exec_b,
                        ref flow,
                        ref ssa_work
                    )
    # rewrite: constants, decided branches, blocks nothing reaches
    for b in 0..n:
        if not exec_b[b]:
            continue
        let m = len(sf.bs[b].code)
        for i in 0..m:
            let x = sf.bs[b].code[i]
            if x.d >= 0 and st[x.d] == CONST and x.op != Op.Const:
                sf.bs[b].code[i] = mk(Op.Const, x.d, -1, -1, 0 if val[x.d] >= 0 else -1, val[x.d])
            elif (x.op == Op.Br or x.op == Op.BrNot) and st[x.a] == CONST:
                let taken = (val[x.a] != 0) == (x.op == Op.Br)
                sf.bs[b].code[i] = mk(Op.Jmp, -1, -1, -1, -1, x.n if taken else x.c)
            elif x.op == Op.Switch and st[x.a] == CONST:
                sf.bs[b].code[i] = mk(Op.Jmp, -1, -1, -1, -1, switch_target(x, val[x.a]))
        # a phi that became a constant goes after the phis left: passes read
        # a block's phis up to the first instruction that isn't one
        var phis: [Inst] = []
        var rest: [Inst] = []
        for x in sf.bs[b].code:
            if x.op == Op.Phi:
                phis.push(x)
            else:
                rest.push(x)
        phis.extend(rest)
        sf.bs[b].code = phis
    relink(ref sf)

fn switch_target(x: Inst, v: int) -> int:
    let i = v - x.n
    if i >= 0 and i < len(x.args) - 1:
        return x.args[1 + i]
    return x.args[0]

fn sccp_edge(sf: SF, b: int, l: int, ref flow: [int]):
    let n = len(sf.bs)
    flow.push(b * n + sf.lab[l])

fn sccp_inst(
    sf: SF,
    b: int,
    i: int,
    ref st: [int],
    ref val: [int],
    exec_e: {int: bool},
    exec_b: [bool],
    ref flow: [int],
    ref ssa_work: [int]
):
    let x = sf.bs[b].code[i]
    let n = len(sf.bs)
    match x.op:
        case Op.Jmp:
            sccp_edge(sf, b, x.n, ref flow)
            return
        case Op.Br | Op.BrNot:
            if st[x.a] == CONST:
                let taken = (val[x.a] != 0) == (x.op == Op.Br)
                sccp_edge(sf, b, x.n if taken else x.c, ref flow)
            elif st[x.a] == BOT:
                sccp_edge(sf, b, x.n, ref flow)
                sccp_edge(sf, b, x.c, ref flow)
            return
        case Op.Switch:
            if st[x.a] == CONST:
                sccp_edge(sf, b, switch_target(x, val[x.a]), ref flow)
            elif st[x.a] == BOT:
                for l in targets(x):
                    sccp_edge(sf, b, l, ref flow)
            return
        case _:
            pass
    if x.d < 0:
        return
    var ns = BOT
    var nval = 0
    if x.op == Op.Phi:
        if not tracked(sf.f.vk[x.d]):
            ns = BOT
        else:
            ns = TOP
            var q = 0
            while q < len(x.args):
                let p = sf.lab[x.args[q]]
                let v = x.args[q + 1]
                q += 2
                if p < 0 or (p * n + b) not in exec_e:
                    continue
                if st[v] == BOT:
                    ns = BOT
                    break
                if st[v] == CONST:
                    if ns == TOP:
                        ns = CONST
                        nval = val[v]
                    elif nval != val[v]:
                        ns = BOT
                        break
    else:
        let (s1, v1) = fold(x, sf.f.vk, st, val)
        ns = s1
        nval = v1
    let d = x.d
    if ns == st[d] and (ns != CONST or nval == val[d]):
        return
    if ns < st[d]:
        return
    if ns == CONST and st[d] == CONST:
        # (can't happen in a monotone lattice; be safe)
        ns = BOT
    st[d] = ns
    val[d] = nval
    ssa_work.push(d)

# ================================================================ identities

# Instructions that do nothing (`x + 0`, `x * 1`, `x | 0`, ...) become copies;
# ones whose result doesn't depend on a variable operand (`0 << x`, `x - x`)
# become constants; multiplications by a power of two become shifts.
fn simplify(ref sf: SF):
    let nv = len(sf.f.vk)
    var is_c = [false] * nv
    var cv = [0] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.Const and tracked(sf.f.vk[x.d]):
                is_c[x.d] = true
                cv[x.d] = x.n
    # v = i & 63: a 64-bit shift by v is one by i, since x86-64 shifts take
    # their count mod 64 (and only x64.br gets this code)
    var low6 = [-1] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.And and x.d >= 0 and sf.f.vk[x.d].size() == 8:
                if x.b >= 0 and x.b < nv and is_c[x.b] and cv[x.b] == 63:
                    low6[x.d] = x.a
                elif x.a >= 0 and x.a < nv and is_c[x.a] and cv[x.a] == 63:
                    low6[x.d] = x.b
    var entry: [Inst] = []
    for bi in 0..len(sf.bs):
        for i in 0..len(sf.bs[bi].code):
            let x = sf.bs[bi].code[i]
            if x.d < 0 or not tracked(sf.f.vk[x.d]):
                continue
            let k = sf.f.vk[x.d]
            let ca = x.a >= 0 and x.a < nv and is_c[x.a]
            let cb = x.b >= 0 and x.b < nv and is_c[x.b]
            let a0 = ca and cv[x.a] == 0
            let b0 = cb and cv[x.b] == 0
            let a1 = ca and cv[x.a] == 1
            let b1 = cb and cv[x.b] == 1
            let ones = wrapk(i128(-1), k)
            var y = x
            var change = true
            match x.op:
                case Op.Add | Op.Or | Op.Xor:
                    if b0:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    elif a0:
                        y = mk(Op.Mov, x.d, x.b, -1, -1, 0)
                    elif x.a == x.b and x.op == Op.Xor:
                        y = mk(Op.Const, x.d, -1, -1, 0, 0)
                    elif x.a == x.b and x.op == Op.Or:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    else:
                        change = false
                case Op.Sub:
                    if b0:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    elif x.a == x.b:
                        y = mk(Op.Const, x.d, -1, -1, 0, 0)
                    else:
                        change = false
                case Op.AddO | Op.SubO:
                    if b0:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    elif a0 and x.op == Op.AddO:
                        y = mk(Op.Mov, x.d, x.b, -1, -1, 0)
                    else:
                        change = false
                case Op.Mul | Op.MulO:
                    if b1:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    elif a1:
                        y = mk(Op.Mov, x.d, x.b, -1, -1, 0)
                    elif x.op == Op.Mul and cb and cv[x.b] > 1 and cv[x.b] & (cv[x.b] - 1) == 0:
                        # (the shift count goes in the entry block, which dominates all)
                        let sh = len(sf.f.vk)
                        sf.f.vk.push(sf.f.vk[x.b])
                        entry.push(mk(Op.Const, sh, -1, -1, 0, log2i(cv[x.b])))
                        y = mk(Op.Shl, x.d, x.a, sh, -1, 0)
                    else:
                        change = false
                case Op.And:
                    if cb and cv[x.b] == ones:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    elif ca and cv[x.a] == ones:
                        y = mk(Op.Mov, x.d, x.b, -1, -1, 0)
                    elif x.a == x.b:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    else:
                        change = false
                case Op.Shl | Op.Shr:
                    if b0:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    elif a0:
                        y = mk(Op.Const, x.d, -1, -1, 0, 0)
                    elif k.size() == 8 and x.b >= 0 and x.b < nv and low6[x.b] >= 0:
                        y = x
                        y.b = low6[x.b]
                    else:
                        change = false
                case Op.Div:
                    if b1:
                        y = mk(Op.Mov, x.d, x.a, -1, -1, 0)
                    else:
                        change = false
                case Op.Eq | Op.Le | Op.Ge:
                    if x.a == x.b and tracked(sf.f.vk[x.a]):
                        y = mk(Op.Const, x.d, -1, -1, 0, 1)
                    else:
                        change = false
                case Op.Ne | Op.Lt | Op.Gt:
                    if x.a == x.b and tracked(sf.f.vk[x.a]):
                        y = mk(Op.Const, x.d, -1, -1, 0, 0)
                    else:
                        change = false
                case _:
                    change = false
            if change:
                sf.bs[bi].code[i] = y
                if y.op == Op.Const:
                    is_c[y.d] = true
                    cv[y.d] = y.n
    if len(entry) > 0:
        entry.extend(sf.bs[0].code)
        sf.bs[0].code = entry

# Loads and stores through `p = elem q + c * n` with a constant c (field and
# fixed-index addresses) use q and an offset instead, so the address needs no
# register and alias analysis sees the base.
fn addressing(ref sf: SF):
    let nv = len(sf.f.vk)
    var is_c = [false] * nv
    var cv = [0] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.Const and tracked(sf.f.vk[x.d]):
                is_c[x.d] = true
                cv[x.d] = x.n
    let lim = 1 << 30
    var base = [-1] * nv
    var off = [0] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.Elem and x.b >= 0 and is_c[x.b] and abs(cv[x.b]) < lim and x.n < lim:
                base[x.d] = x.a
                off[x.d] = cv[x.b] * x.n
    # chains of them (each step shortens one; SSA has no cycles here)
    var changed = true
    while changed:
        changed = false
        for v in 0..nv:
            let q = base[v]
            if q >= 0 and base[q] >= 0 and abs(off[v] + off[q]) < lim:
                base[v] = base[q]
                off[v] += off[q]
                changed = true
    for bi in 0..len(sf.bs):
        for i in 0..len(sf.bs[bi].code):
            let x = sf.bs[bi].code[i]
            if (x.op == Op.Load or x.op == Op.Store) and base[x.a] >= 0:
                if abs(x.n + off[x.a]) < lim:
                    var y = x
                    y.a = base[x.a]
                    y.n = x.n + off[x.a]
                    sf.bs[bi].code[i] = y

fn log2i(v: int) -> int:
    var n = 0
    while (1 << n) < v:
        n += 1
    return n

# ================================================================ copies

# Replaces every read of a copy (`d = mov v`) by v, and of a phi whose values
# are all one vreg (or itself) by that vreg.
fn copies(ref sf: SF):
    let nv = len(sf.f.vk)
    var repl = [0] * nv
    for v in 0..nv:
        repl[v] = v
    var changed = true
    while changed:
        changed = false
        for b in 0..len(sf.bs):
            for x in sf.bs[b].code:
                if x.d < 0 or repl[x.d] != x.d:
                    continue
                if x.op == Op.Mov and sf.f.vk[x.a] == sf.f.vk[x.d]:
                    let r = find(ref repl, x.a)
                    if r != x.d:
                        repl[x.d] = r
                        changed = true
                elif x.op == Op.Phi:
                    var one = -1
                    var many = false
                    var q = 1
                    while q < len(x.args):
                        let v = find(ref repl, x.args[q])
                        q += 2
                        if v == x.d:
                            continue
                        if one < 0:
                            one = v
                        elif one != v:
                            many = true
                            break
                    if not many and one >= 0:
                        repl[x.d] = one
                        changed = true
    for v in 0..nv:
        repl[v] = find(ref repl, v)
    for b in 0..len(sf.bs):
        var code: [Inst] = []
        for x in sf.bs[b].code:
            if x.d >= 0 and repl[x.d] != x.d:
                continue
            code.push(map_uses(x, repl))
        sf.bs[b].code = code

fn find(ref repl: [int], v: int) -> int:
    var r = v
    while repl[r] != r:
        r = repl[r]
    var w = v
    while repl[w] != r:
        let nx = repl[w]
        repl[w] = r
        w = nx
    return r

# ================================================================ memory

# The slots whose address only ever serves as the address of a load, a store,
# a copy or a zeroing: nothing else can point at them. (false for the others)
fn private_slots(sf: SF) -> [bool]:
    let nv = len(sf.f.vk)
    var slot = [-1] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.SlotAddr:
                slot[x.d] = x.a
    var ok = [true] * len(sf.f.slots)
    for b in sf.bs:
        for x in b.code:
            for u in uses(x):
                if slot[u] < 0:
                    continue
                let addr = (
                    ((x.op == Op.Load or x.op == Op.Zero) and x.a == u)
                    or (x.op == Op.Store and x.a == u and x.b != u)
                    or (x.op == Op.Copy and (x.a == u or x.b == u))
                )
                if not addr:
                    ok[slot[u]] = false
    return ok

# What a memory access touches: a base vreg plus [lo, hi) bytes; the slot
# the base is the address of (-1: unknown), and whether that slot is private.
struct Place:
    base: int
    lo: int
    hi: int
    slot: int
    private: bool

# Can a write to w change what a read of r sees?
fn may_alias(w: Place, r: Place) -> bool:
    if w.base == r.base:
        return w.lo < r.hi and r.lo < w.hi
    if w.slot >= 0 and r.slot >= 0:
        return w.slot == r.slot and w.lo < r.hi and r.lo < w.hi
    # a private slot is only reached through its own address
    if (w.slot >= 0 and w.private) or (r.slot >= 0 and r.private):
        return false
    return true

# ================================================================ value numbering

fn gvn_key(x: Inst, vk: [K]) -> str:
    match x.op:
        case Op.Add | Op.Mul | Op.And | Op.Or | Op.Xor | Op.Eq | Op.Ne:
            let a = min(x.a, x.b)
            let b = max(x.a, x.b)
            return f"{x.op.name()}|{vk[x.d].name()}|{vk[x.a].name()}|{a}|{b}"
        case Op.Sub | Op.Div | Op.Rem | Op.Shl | Op.Shr | Op.Lt | Op.Le | Op.Gt | Op.Ge:
            return f"{x.op.name()}|{vk[x.d].name()}|{vk[x.a].name()}|{x.a}|{x.b}"
        case Op.Neg | Op.Not | Op.Conv:
            return f"{x.op.name()}|{vk[x.d].name()}|{vk[x.a].name()}|{x.a}"
        case Op.Elem:
            return f"elem|{x.a}|{x.b}|{x.n}"
        case Op.AddO | Op.SubO | Op.MulO | Op.IdxChk:
            return f"{x.op.name()}|{vk[x.d].name()}|{x.a}|{x.b}"
        case Op.Global:
            return f"global|{x.s}"
        case Op.SlotAddr:
            return f"slot|{x.a}"
        case _:
            return ""

struct Avail:
    place: Place
    k: K
    v: int

fn gvn(ref sf: SF):
    let n = len(sf.bs)
    let nv = len(sf.f.vk)
    let po = postorder(sf.bs)
    let idom = idoms(sf.bs, po)
    let ch = dom_children(idom)
    let priv = private_slots(sf)
    var slot = [-1] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.SlotAddr:
                slot[x.d] = x.a
    var repl = [0] * nv
    for v in 0..nv:
        repl[v] = v
    var table: {str: int} = {}
    var log_k: [str] = []
    var marks = [0] * n
    # the loads and stores known at the end of each block, for a successor
    # that only it leads to
    var at_end: [[Avail]] = [[]] * n
    var st = [0]
    while len(st) > 0:
        let e = st.pop()
        if e < 0:
            let b = -e - 1
            while len(log_k) > marks[b]:
                table.remove(log_k.pop())
            continue
        let b = e
        marks[b] = len(log_k)
        st.push(-b - 1)
        var ci = len(ch[b]) - 1
        while ci >= 0:
            st.push(ch[b][ci])
            ci -= 1
        var avail: [Avail] = []
        if b != 0 and len(sf.bs[b].pred) == 1 and sf.bs[b].pred[0] == idom[b]:
            avail = at_end[idom[b]]
        var code = sf.bs[b].code
        for i in 0..len(code):
            var x = map_uses(code[i], repl)
            code[i] = x
            if x.op == Op.Phi:
                continue
            match x.op:
                case Op.Load:
                    let p = place(x.a, x.n, sf.f.vk[x.d].size(), slot, priv)
                    var hit = -1
                    for av in avail:
                        if (
                            av.place.base == p.base
                            and av.place.lo == p.lo
                            and av.place.hi == p.hi
                            and av.k == sf.f.vk[x.d]
                        ):
                            hit = av.v
                    if hit >= 0:
                        repl[x.d] = hit
                        code[i] = mk(Op.Mov, x.d, hit, -1, -1, 0)
                    else:
                        avail.push(Avail(place=p, k=sf.f.vk[x.d], v=x.d))
                    continue
                case Op.Store:
                    let p = place(x.a, x.n, sf.f.vk[x.b].size(), slot, priv)
                    avail = [av for av in avail if not may_alias(p, av.place)]
                    avail.push(Avail(place=p, k=sf.f.vk[x.b], v=x.b))
                    continue
                case Op.Copy | Op.Zero:
                    let p = place(x.a, 0, x.n, slot, priv)
                    avail = [av for av in avail if not may_alias(p, av.place)]
                    continue
                case Op.Call | Op.CallInd:
                    avail = [av for av in avail if av.place.slot >= 0 and av.place.private]
                case _:
                    pass
            if len(avail) > 64:
                avail = avail[len(avail) - 64:]
            if x.d < 0:
                continue
            let key = gvn_key(x, sf.f.vk)
            if key == "":
                continue
            match table.get(key):
                case Some(v):
                    repl[x.d] = v
                    code[i] = mk(Op.Mov, x.d, v, -1, -1, 0)
                case None:
                    table[key] = x.d
                    log_k.push(key)
        sf.bs[b].code = code
        for c in ch[b]:
            if len(sf.bs[c].pred) == 1:
                at_end[b] = avail
                break
    # phis read values of other blocks: map them now that all are known
    for b in 0..n:
        for i in 0..len(sf.bs[b].code):
            if sf.bs[b].code[i].op != Op.Phi:
                break
            sf.bs[b].code[i] = map_uses(sf.bs[b].code[i], repl)

fn place(base: int, off: int, size: int, slot: [int], priv: [bool]) -> Place:
    let s = slot[base]
    return Place(base=base, lo=off, hi=off + size, slot=s, private=s >= 0 and priv[s])

# ================================================================ dead code

fn dce(ref sf: SF):
    dce_pass(ref sf)
    while empty_ifs(ref sf):
        relink(ref sf)
        dce_pass(ref sf)

# Turns a branch to a block left empty (one that only jumps on) and to where
# that block goes into a jump there, when no phi tells the two edges apart:
# the condition is then dead too. True if it changed any.
fn empty_ifs(ref sf: SF) -> bool:
    var changed = false
    for b in 0..len(sf.bs):
        let m = len(sf.bs[b].code)
        let t = sf.bs[b].code[m - 1]
        if t.op != Op.Br and t.op != Op.BrNot:
            continue
        for e_lab in [t.n, t.c]:
            let x_lab = t.c if e_lab == t.n else t.n
            let e = sf.lab[e_lab]
            if e == b or not skips_to(sf.bs[e], x_lab):
                continue
            var same = true
            for x in sf.bs[sf.lab[x_lab]].code:
                if x.op != Op.Phi:
                    break
                if phi_value(x, sf.bs[b].label) != phi_value(x, e_lab):
                    same = false
            if same:
                sf.bs[b].code[m - 1] = mk(Op.Jmp, -1, -1, -1, -1, x_lab)
                changed = true
                break
    return changed

# A block that only picks a bool and branches on it (the end of `a and b`, `a
# or b`): a predecessor whose value for it is known (a constant, or the
# condition it branched there on) goes straight to where that leads; one that
# jumps there branches on its value itself, which native code fuses with the
# comparison that made it. The bool is then never made. True if it changed
# any.
fn bool_ifs(ref sf: SF) -> bool:
    let nv = len(sf.f.vk)
    var nuse = [0] * nv
    var cval = [-1] * nv
    for b in sf.bs:
        for x in b.code:
            for u in uses(x):
                nuse[u] += 1
            if x.op == Op.Const and x.d >= 0 and (x.n == 0 or x.n == 1):
                cval[x.d] = x.n
    var changed = false
    # (a block changed once waits for relink: its successors are stale)
    var touched = [false] * len(sf.bs)
    for b in 0..len(sf.bs):
        if len(sf.bs[b].code) != 2:
            continue
        let ph = sf.bs[b].code[0]
        let t = sf.bs[b].code[1]
        let bl = sf.bs[b].label
        if ph.op != Op.Phi or (t.op != Op.Br and t.op != Op.BrNot) or t.a != ph.d:
            continue
        if nuse[ph.d] != 1 or t.n == bl or t.c == bl:
            continue
        for p in sf.bs[b].pred:
            if touched[p]:
                continue
            let pl = sf.bs[p].label
            let v = phi_value(ph, pl)
            let m = len(sf.bs[p].code)
            let tp = sf.bs[p].code[m - 1]
            # v's value on this edge: 1, 0, or -1 when not known
            var known = cval[v]
            if (tp.op == Op.Br or tp.op == Op.BrNot) and tp.a == v and tp.n != tp.c:
                known = 1 if (tp.n == bl) == (tp.op == Op.Br) else 0
            if known >= 0:
                let dest = t.n if (known == 1) == (t.op == Op.Br) else t.c
                if not edge_ok(sf, p, dest):
                    continue
                sf.bs[p].code[m - 1] = retarget(tp, bl, dest)
                add_entries(ref sf, dest, pl, bl)
                touched[p] = true
                changed = true
            elif tp.op == Op.Jmp:
                if not edge_ok(sf, p, t.n) or not edge_ok(sf, p, t.c):
                    continue
                var y = t
                y.a = v
                sf.bs[p].code[m - 1] = y
                add_entries(ref sf, t.n, pl, bl)
                add_entries(ref sf, t.c, pl, bl)
                touched[p] = true
                changed = true
    return changed

# Can block p get an edge to label l? Not when it has one already and l's phis
# would then need two values for p.
fn edge_ok(sf: SF, p: int, l: int) -> bool:
    let s = sf.lab[l]
    if s not in sf.bs[p].succ:
        return true
    return len(sf.bs[s].code) == 0 or sf.bs[s].code[0].op != Op.Phi

# The phis of label l take, on a new edge from label pl, what they take on
# the edge from label bl.
fn add_entries(ref sf: SF, l: int, pl: int, bl: int):
    let s = sf.lab[l]
    for j in 0..len(sf.bs[s].code):
        let x = sf.bs[s].code[j]
        if x.op != Op.Phi:
            break
        sf.bs[s].code[j].args.push(pl)
        sf.bs[s].code[j].args.push(phi_value(x, bl))

# Does the block do nothing but jump to label l?
fn skips_to(b: Block, l: int) -> bool:
    for i, x in enumerate(b.code):
        if i == len(b.code) - 1:
            return x.op == Op.Jmp and x.n == l
        if x.op != Op.Line:
            return false
    return false

# The value a phi takes on the edge from label l (-1 for none)
fn phi_value(x: Inst, l: int) -> int:
    var q = 0
    while q < len(x.args):
        if x.args[q] == l:
            return x.args[q + 1]
        q += 2
    return -1

fn dce_pass(ref sf: SF):
    let nv = len(sf.f.vk)
    var def_b = [-1] * nv
    var def_i = [-1] * nv
    for b in 0..len(sf.bs):
        for i, x in enumerate(sf.bs[b].code):
            if x.d >= 0:
                def_b[x.d] = b
                def_i[x.d] = i
    var live = [false] * nv
    var work: [int] = []
    for b in sf.bs:
        for x in b.code:
            if effect(x):
                for u in uses(x):
                    if not live[u]:
                        live[u] = true
                        work.push(u)
    while len(work) > 0:
        let v = work.pop()
        if def_b[v] < 0:
            continue
        for u in uses(sf.bs[def_b[v]].code[def_i[v]]):
            if not live[u]:
                live[u] = true
                work.push(u)
    for b in 0..len(sf.bs):
        var code: [Inst] = []
        for x in sf.bs[b].code:
            if x.d >= 0 and not live[x.d] and not effect(x):
                continue
            code.push(x)
        sf.bs[b].code = code

# ================================================================ loops

struct Loop:
    header: int
    # the blocks in the loop (by block index)
    body: [int]

fn find_loops(sf: SF) -> [Loop]:
    let n = len(sf.bs)
    let po = postorder(sf.bs)
    let idom = idoms(sf.bs, po)
    let (tin, tout) = dom_numbers(dom_children(idom))
    var latches: [[int]] = [[]] * n
    for b in 0..n:
        for s in sf.bs[b].succ:
            if tin[s] <= tin[b] and tin[b] < tout[s]:
                latches[s].push(b)
    var loops: [Loop] = []
    var mark = [-1] * n
    for h in 0..n:
        if len(latches[h]) == 0:
            continue
        var body = [h]
        mark[h] = h
        var work: [int] = []
        for t in latches[h]:
            if mark[t] != h:
                mark[t] = h
                body.push(t)
                work.push(t)
        while len(work) > 0:
            let b = work.pop()
            for p in sf.bs[b].pred:
                if mark[p] != h:
                    mark[p] = h
                    body.push(p)
                    work.push(p)
        loops.push(Loop(header=h, body=body))
    return loops

# Gives every loop header a preheader: a block outside the loop that only
# jumps to the header, the only way into the loop.
fn preheaders(ref sf: SF):
    while preheader_one(ref sf):
        pass

# Adds one missing preheader; false when there is none to add.
fn preheader_one(ref sf: SF) -> bool:
    let loops = find_loops(sf)
    var made = false
    for lp in loops:
        let h = lp.header
        var inb = [false] * len(sf.bs)
        for b in lp.body:
            inb[b] = true
        var outside: [int] = []
        for p in sf.bs[h].pred:
            if not inb[p]:
                outside.push(p)
        if len(outside) == 1 and len(sf.bs[outside[0]].succ) == 1:
            continue
        let hl = sf.bs[h].label
        let pl = new_label(ref sf)
        var olab = [false] * sf.f.nlabels
        for p in outside:
            olab[sf.bs[p].label] = true
            let m = len(sf.bs[p].code)
            sf.bs[p].code[m - 1] = retarget(sf.bs[p].code[m - 1], hl, pl)
        # the header's phis: the entries from outside move to the preheader
        var pcode: [Inst] = []
        for j in 0..len(sf.bs[h].code):
            let x = sf.bs[h].code[j]
            if x.op != Op.Phi:
                break
            var inside: [int] = []
            var outs: [int] = []
            var q = 0
            while q < len(x.args):
                if olab[x.args[q]]:
                    outs.push(x.args[q])
                    outs.push(x.args[q + 1])
                else:
                    inside.push(x.args[q])
                    inside.push(x.args[q + 1])
                q += 2
            if len(outs) == 0:
                continue
            var v = outs[1]
            if len(outs) > 2:
                v = len(sf.f.vk)
                sf.f.vk.push(sf.f.vk[x.d])
                var y = mk(Op.Phi, v, -1, -1, -1, -1)
                y.args = outs
                pcode.push(y)
            inside.push(pl)
            inside.push(v)
            sf.bs[h].code[j].args = inside
        pcode.push(mk(Op.Jmp, -1, -1, -1, -1, hl))
        # placed right before the header (indices shift; relink fixes them)
        sf.bs.insert(h, Block(label=pl, code=pcode, succ=[], pred=[]))
        made = true
        # later loops' indices are stale now: do the rest next round
        break
    if made:
        relink(ref sf)
    return made

fn speculatable(x: Inst, sf: SF, def_b: [int], def_i: [int]) -> bool:
    match x.op:
        case Op.Const | Op.FConst | Op.Mov | Op.Global | Op.SlotAddr | Op.Elem:
            return true
        case Op.Add | Op.Sub | Op.Mul | Op.And | Op.Or | Op.Xor | Op.Shl | Op.Shr:
            return true
        case Op.Neg | Op.Not | Op.Conv:
            return true
        case Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge:
            return true
        case Op.Div | Op.Rem:
            if sf.f.vk[x.d].is_float():
                return true
            # a constant divisor other than 0 and -1 can't trap
            let db = def_b[x.b]
            if db < 0:
                return false
            let y = sf.bs[db].code[def_i[x.b]]
            return y.op == Op.Const and y.n != 0 and y.n != -1
        case _:
            return false

# Is u the same on every iteration of the loop (made outside it, or hoisted)?
fn inv(u: int, def_b: [int], inb: [bool], moved: [bool]) -> bool:
    return not (def_b[u] >= 0 and inb[def_b[u]] and not moved[u])

fn licm(ref sf: SF):
    preheaders(ref sf)
    var loops = find_loops(sf)
    if len(loops) == 0:
        return
    # innermost first: their hoisted code can move again with the outer loop
    var order: [(int, int)] = []
    for i, lp in enumerate(loops):
        order.push((len(lp.body), i))
    order.sort()
    let n = len(sf.bs)
    let nv = len(sf.f.vk)
    let priv = private_slots(sf)
    var slot = [-1] * nv
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.SlotAddr:
                slot[x.d] = x.a
    var def_b = [-1] * nv
    var def_i = [-1] * nv
    for (_, li) in order:
        let lp = loops[li]
        let h = lp.header
        var inb = [false] * n
        for b in lp.body:
            inb[b] = true
        var pre = -1
        for p in sf.bs[h].pred:
            if not inb[p]:
                pre = p
        if pre < 0:
            continue
        # where vregs are set now (hoisting moves them)
        for b in 0..n:
            for i, x in enumerate(sf.bs[b].code):
                if x.d >= 0:
                    def_b[x.d] = b
                    def_i[x.d] = i
        # the writes in the loop, for loads
        var writes: [Place] = []
        var calls = false
        for b in lp.body:
            for x in sf.bs[b].code:
                match x.op:
                    case Op.Store:
                        writes.push(place(x.a, x.n, sf.f.vk[x.b].size(), slot, priv))
                    case Op.Copy | Op.Zero:
                        writes.push(place(x.a, 0, x.n, slot, priv))
                    case Op.Call | Op.CallInd:
                        calls = true
                    case _:
                        pass
        # 64-bit adds in the loop, to split element indexes (below)
        var add_a = [-1] * len(sf.f.vk)
        var add_b = [-1] * len(sf.f.vk)
        for b in lp.body:
            for x in sf.bs[b].code:
                if x.op == Op.Add and sf.f.vk[x.d].size() == 8 and not sf.f.vk[x.d].is_float():
                    add_a[x.d] = x.a
                    add_b[x.d] = x.b
        var hoisted: [Inst] = []
        var moved = [false] * len(sf.f.vk)
        # in the loop's own order: an operand set earlier in it may move first
        let po = postorder(sf.bs)
        var j = len(po) - 1
        while j >= 0:
            let b = po[j]
            j -= 1
            if not inb[b]:
                continue
            var keep: [Inst] = []
            var blocked = false
            for x in sf.bs[b].code:
                var go = x.d >= 0 and x.op != Op.Phi
                if go:
                    for u in uses(x):
                        if def_b[u] >= 0 and inb[def_b[u]] and not moved[u]:
                            go = false
                            break
                if go:
                    if speculatable(x, sf, def_b, def_i):
                        pass
                    elif (
                        b == h
                        and not blocked
                        and (is_check(x.op) or x.op == Op.Div or x.op == Op.Rem)
                    ):
                        pass
                    elif b == h and x.op == Op.Load:
                        # (a load can't panic: only the writes matter)
                        let p = place(x.a, x.n, sf.f.vk[x.d].size(), slot, priv)
                        if calls and not (p.slot >= 0 and p.private):
                            go = false
                        for w in writes:
                            if may_alias(w, p):
                                go = false
                                break
                    else:
                        go = false
                if go:
                    hoisted.push(x)
                    moved[x.d] = true
                    continue
                if effect(x) and x.op != Op.Phi:
                    blocked = true
                # `elem a + (x + y) * n` with a and x invariant is
                # `elem (elem a + x * n) + y * n`, and the inner one moves out
                if x.op == Op.Elem and x.n != 0 and add_a[x.b] >= 0 and inv(x.a, def_b, inb, moved):
                    let p = add_a[x.b]
                    let q = add_b[x.b]
                    let ip = inv(p, def_b, inb, moved)
                    if ip != inv(q, def_b, inb, moved):
                        let t = len(sf.f.vk)
                        sf.f.vk.push(sf.f.vk[x.d])
                        moved.push(true)
                        def_b.push(-1)
                        def_i.push(-1)
                        hoisted.push(mk(Op.Elem, t, x.a, p if ip else q, -1, x.n))
                        keep.push(mk(Op.Elem, x.d, t, q if ip else p, -1, x.n))
                        continue
                keep.push(x)
            sf.bs[b].code = keep
        if len(hoisted) > 0:
            var pc = sf.bs[pre].code
            let t = pc.pop()
            pc.extend(hoisted)
            pc.push(t)
            sf.bs[pre].code = pc

# ================================================================ out of SSA

fn split_edges(ref sf: SF):
    var made = false
    let n = len(sf.bs)
    var new_blocks: [Block] = []
    for s in 0..n:
        if len(sf.bs[s].code) == 0 or sf.bs[s].code[0].op != Op.Phi:
            continue
        let sl = sf.bs[s].label
        for p in sf.bs[s].pred:
            if len(sf.bs[p].succ) < 2:
                continue
            let pl = sf.bs[p].label
            let nl = new_label(ref sf)
            let m = len(sf.bs[p].code)
            sf.bs[p].code[m - 1] = retarget(sf.bs[p].code[m - 1], sl, nl)
            for j in 0..len(sf.bs[s].code):
                if sf.bs[s].code[j].op != Op.Phi:
                    break
                var q = 0
                while q < len(sf.bs[s].code[j].args):
                    if sf.bs[s].code[j].args[q] == pl:
                        sf.bs[s].code[j].args[q] = nl
                    q += 2
            new_blocks.push(
                Block(label=nl, code=[mk(Op.Jmp, -1, -1, -1, -1, sl)], succ=[], pred=[])
            )
            made = true
    if made:
        sf.bs.extend(new_blocks)
        relink(ref sf)

# Sequential copies doing the parallel copies (d, v) at once.
fn parallel_copies(ref f: Func, ds: [int], vs: [int]) -> [Inst]:
    var pd: [int] = []
    var pv: [int] = []
    for i in 0..len(ds):
        if ds[i] != vs[i]:
            pd.push(ds[i])
            pv.push(vs[i])
    var out: [Inst] = []
    while len(pd) > 0:
        var pick = -1
        for i in 0..len(pd):
            var read = false
            for j in 0..len(pv):
                if j != i and pv[j] == pd[i]:
                    read = true
                    break
            if not read:
                pick = i
                break
        if pick >= 0:
            out.push(mk(Op.Mov, pd[pick], pv[pick], -1, -1, 0))
            pd.pop(pick)
            pv.pop(pick)
            continue
        # a cycle: save one destination's value first
        let d = pd[0]
        let t = len(f.vk)
        f.vk.push(f.vk[d])
        out.push(mk(Op.Mov, t, d, -1, -1, 0))
        for j in 0..len(pv):
            if pv[j] == d:
                pv[j] = t
    return out

fn from_ssa(sf0: SF) -> Func:
    var sf = sf0
    split_edges(ref sf)
    let n = len(sf.bs)
    # each predecessor's copies, for the phis of its successor
    for s in 0..n:
        if len(sf.bs[s].code) == 0 or sf.bs[s].code[0].op != Op.Phi:
            continue
        var np = 0
        while np < len(sf.bs[s].code) and sf.bs[s].code[np].op == Op.Phi:
            np += 1
        for p in sf.bs[s].pred:
            let pl = sf.bs[p].label
            var ds: [int] = []
            var vs: [int] = []
            for j in 0..np:
                let x = sf.bs[s].code[j]
                var q = 0
                while q < len(x.args):
                    if x.args[q] == pl:
                        ds.push(x.d)
                        vs.push(x.args[q + 1])
                        break
                    q += 2
            let cs = parallel_copies(ref sf.f, ds, vs)
            var pc = sf.bs[p].code
            let t = pc.pop()
            pc.extend(cs)
            pc.push(t)
            sf.bs[p].code = pc
        sf.bs[s].code = sf.bs[s].code[np:]
    # A jump to a block that only jumps on goes straight to where that goes.
    var fwd = [-1] * n
    for b in 1..n:
        if len(sf.bs[b].code) == 1 and sf.bs[b].code[0].op == Op.Jmp:
            fwd[b] = sf.bs[b].code[0].n
    for b in 0..n:
        let m = len(sf.bs[b].code)
        var t = sf.bs[b].code[m - 1]
        for l in targets(t):
            var to = l
            var hops = 0
            while fwd[sf.lab[to]] >= 0 and hops < n:
                to = fwd[sf.lab[to]]
                hops += 1
            if to != l:
                t = retarget(t, l, to)
        if (t.op == Op.Br or t.op == Op.BrNot) and t.n == t.c:
            t = mk(Op.Jmp, -1, -1, -1, -1, t.n)
        sf.bs[b].code[m - 1] = t
    # Depth first from the entry: what is reachable, and the back edges (to
    # a block still on the path), whose jumps make a loop's latch.
    var reach = [false] * n
    var on_path = [false] * n
    var latch = [-1] * n
    var path = [0]
    var next_succ = [0]
    reach[0] = true
    on_path[0] = true
    while len(path) > 0:
        let b = path[len(path) - 1]
        let t = sf.bs[b].code[len(sf.bs[b].code) - 1]
        let ts = targets(t)
        let k = next_succ[len(path) - 1]
        if k >= len(ts):
            on_path[b] = false
            path.pop()
            next_succ.pop()
            continue
        next_succ[len(path) - 1] = k + 1
        let s = sf.lab[ts[k]]
        if on_path[s]:
            if t.op == Op.Jmp and s > 0:
                latch[s] = b if latch[s] == -1 else -2
        elif not reach[s]:
            reach[s] = true
            on_path[s] = true
            path.push(s)
            next_succ.push(0)
    # Flat code, in block order, except that a loop header ending in a branch
    # goes right after its latch (the one block jumping back to it): then an
    # iteration ends in one conditional branch instead of a jump and a branch.
    var order: [int] = [i for i in 0..n]
    for h in 1..n:
        let t = sf.bs[h].code[len(sf.bs[h].code) - 1]
        if latch[h] >= 0 and (t.op == Op.Br or t.op == Op.BrNot):
            var at = 0
            while order[at] != h:
                at += 1
            order.pop(at)
            at = 0
            while order[at] != latch[h]:
                at += 1
            order.insert(at + 1, h)
    # Then chains: a block is followed by where it jumps, or by the block a
    # branch falls through to, if not placed yet, so the copies on an edge
    # (split blocks, made last) sit on the way instead of out of line. A
    # rotated loop header comes only after its latch.
    var placed = [false] * n
    var chained: [int] = []
    for start in order:
        var b = start
        while b >= 0 and reach[b] and not placed[b]:
            placed[b] = true
            chained.push(b)
            let t = sf.bs[b].code[len(sf.bs[b].code) - 1]
            var nb = -1
            if t.op == Op.Jmp:
                nb = sf.lab[t.n]
            elif t.op == Op.Br or t.op == Op.BrNot:
                nb = sf.lab[t.c]
            if nb >= 0 and latch[nb] >= 0 and latch[nb] != b:
                nb = -1
            b = nb
    order = chained
    let n2 = len(order)
    var code: [Inst] = []
    for oi in 0..n2:
        let b = sf.bs[order[oi]]
        code.push(mk(Op.Label, -1, -1, -1, -1, b.label))
        let m = len(b.code)
        for j in 0..m - 1:
            code.push(b.code[j])
        let t = b.code[m - 1]
        let next = sf.bs[order[oi + 1]].label if oi + 1 < n2 else -1
        match t.op:
            case Op.Jmp:
                if t.n != next:
                    code.push(t)
            case Op.Br | Op.BrNot:
                if t.c == next:
                    code.push(mk(t.op, -1, t.a, -1, -1, t.n))
                elif t.n == next:
                    let inv = Op.BrNot if t.op == Op.Br else Op.Br
                    code.push(mk(inv, -1, t.a, -1, -1, t.c))
                else:
                    code.push(mk(t.op, -1, t.a, -1, -1, t.n))
                    code.push(mk(Op.Jmp, -1, -1, -1, -1, t.c))
            case _:
                code.push(t)
    var f = sf.f
    f.code = code
    return f

# ================================================================ the pipeline

# ---------------------------------------------------------------- vector loops

# Gives each innermost loop vloop.br can run several elements at a time a call
# to its kernel (named `name`_0, _1, ...) before the loop, which then starts
# where the kernel stopped. Returns the kernels; `vw`: the most lanes.
fn vector_loops(ref sf: SF, name: str, vw: int) -> [KFunc]:
    var out: [KFunc] = []
    preheaders(ref sf)
    let loops = find_loops(sf)
    var is_head = [false] * len(sf.bs)
    for lp in loops:
        is_head[lp.header] = true
    for lp in loops:
        let (ok, k) = vector_loop(ref sf, lp, is_head, f"{name}_{len(out)}", vw)
        if ok:
            out.push(k)
    return out

fn new_v(ref sf: SF, k: K) -> int:
    sf.f.vk.push(k)
    return len(sf.f.vk) - 1

fn no_kernel() -> (bool, KFunc):
    return (false, vloop.no_kernel(""))

# The argument of a phi that comes from outside the loop, or -1.
fn outside_arg(sf: SF, phi: Inst, inb: [bool]) -> int:
    if len(phi.args) != 4:
        return -1
    var at = -1
    var q = 0
    while q < 4:
        let pb = sf.lab[phi.args[q]]
        if pb < 0 or not inb[pb]:
            if at >= 0:
                return -1
            at = q + 1
        q += 2
    return at

# The loop must be: a header with only `j = phi(lo, j + 1)`, sums of doubles
# `s = phi(s0, s op x)`, `j < hi` and the branch; then blocks in a row that
# compute `p + 8 * (j + v)` addresses, load and store doubles there, do
# + - * / on doubles, + - * & | ^ and shifts on integers, convert integers to
# doubles, update the sums and add 1 to j.
fn vector_loop(ref sf: SF, lp: Loop, is_head: [bool], name: str, vw: int) -> (bool, KFunc):
    let nb = len(sf.bs)
    let nv = len(sf.f.vk)
    let h = lp.header
    var inb = [false] * nb
    for b in lp.body:
        inb[b] = true
        if b != h and is_head[b]:
            return no_kernel()
    var hx: [Inst] = []
    var phis: [Inst] = []
    var phi_ats: [int] = []
    for i, x in enumerate(sf.bs[h].code):
        if x.op == Op.Phi:
            phis.push(x)
            phi_ats.push(i)
        elif x.op != Op.Line:
            hx.push(x)
    if len(hx) != 2 or hx[0].op != Op.Lt or (hx[1].op != Op.Br and hx[1].op != Op.BrNot):
        return no_kernel()
    let lt = hx[0]
    let br = hx[1]
    var ji = -1
    for i, x in enumerate(phis):
        if x.d == lt.a:
            ji = i
    if ji < 0 or sf.f.vk[lt.a] != K.I64 or br.a != lt.d:
        return no_kernel()
    let phi = phis[ji]
    var first = br.n
    var exitl = br.c
    if br.op == Op.BrNot:
        first = br.c
        exitl = br.n
    if first < 0 or exitl < 0 or sf.lab[first] < 0 or not inb[sf.lab[first]]:
        return no_kernel()
    if sf.lab[exitl] < 0 or inb[sf.lab[exitl]]:
        return no_kernel()
    let pre_q = outside_arg(sf, phi, inb)
    if pre_q < 0:
        return no_kernel()
    let pre = sf.lab[phi.args[pre_q - 1]]
    let jn = phi.args[4 - pre_q]
    if pre < 0:
        return no_kernel()
    let lo = phi.args[pre_q]
    var def_b = [-1] * nv
    var cval = [-1] * nv
    for b in 0..nb:
        for x in sf.bs[b].code:
            if x.d >= 0:
                def_b[x.d] = b
                if x.op == Op.Const and x.n >= 0 and x.n < 64:
                    cval[x.d] = x.n
    if (def_b[lt.b] >= 0 and inb[def_b[lt.b]]) or (def_b[lo] >= 0 and inb[def_b[lo]]):
        return no_kernel()
    # the sums: their phis, where their first value comes in, and the update
    var sum_of = [-1] * nv
    var sphi: [int] = []
    var sq: [int] = []
    var sback: [int] = []
    for i, x in enumerate(phis):
        if i == ji:
            continue
        let q = outside_arg(sf, x, inb)
        if q < 0 or sf.f.vk[x.d] != K.F64:
            return no_kernel()
        sum_of[x.d] = len(sphi)
        sphi.push(i)
        sq.push(q)
        sback.push(x.args[4 - q])
    # the body, in order
    var chain: [Inst] = []
    var b = sf.lab[first]
    var nblocks = 1
    while true:
        let code = sf.bs[b].code
        for i in 0..len(code) - 1:
            chain.push(code[i])
        let t = code[len(code) - 1]
        nblocks += 1
        if t.op != Op.Jmp or sf.lab[t.n] < 0 or nblocks > len(lp.body):
            return no_kernel()
        let nxt = sf.lab[t.n]
        if nxt == h:
            break
        if not inb[nxt]:
            return no_kernel()
        b = nxt
    if nblocks != len(lp.body):
        return no_kernel()
    # vreg -> the array it addresses (Elem); its value in the kernel
    var arr_of = [-1] * nv
    var val_of = [-1] * nv
    var bases: [int] = []
    var binv: [int] = []
    var ints: [int] = []
    var flts: [int] = []
    var stores = 0
    var inc = false
    # vreg -> v when it is j + v, v from outside the loop; whether it is j
    var idx_of = [-1] * nv
    var is_j = [false] * nv
    is_j[phi.d] = true
    # vregs made in the loop that are integers or doubles the kernel has
    var is_i = [false] * nv
    var is_f = [false] * nv
    is_i[phi.d] = true
    # bounds checks of j (-1) or j + v: v and the length
    var cinv: [int] = []
    var clen: [int] = []
    # how often each sum's phi and update are read in the loop
    var sreads = [0] * len(sphi)
    for x in chain:
        for u in uses(x):
            if sum_of[u] >= 0:
                sreads[sum_of[u]] += 1
            for k in 0..len(sphi):
                if u == sback[k]:
                    return no_kernel()
    for k in 0..len(sphi):
        if sreads[k] != 1:
            return no_kernel()
    var ops: [LOp] = []
    # first pass: what the body is, and the parameters
    for x in chain:
        let vd = sf.f.vk[x.d] if x.d >= 0 else K.I64
        match x.op:
            case Op.Line:
                pass
            case Op.IdxChk:
                if (not is_j[x.a] and idx_of[x.a] < 0) or ins(def_b, inb, x.b):
                    return no_kernel()
                is_j[x.d] = is_j[x.a]
                idx_of[x.d] = idx_of[x.a]
                is_i[x.d] = true
                cinv.push(idx_of[x.a])
                clen.push(x.b)
            case Op.Elem:
                if (not is_j[x.b] and idx_of[x.b] < 0) or x.n != 8 or ins(def_b, inb, x.a):
                    return no_kernel()
                let iv = -1 if is_j[x.b] else idx_of[x.b]
                var a = -1
                for i, v in enumerate(bases):
                    if v == x.a and binv[i] == iv:
                        a = i
                if a < 0:
                    a = len(bases)
                    bases.push(x.a)
                    binv.push(iv)
                arr_of[x.d] = a
            case Op.Load:
                if vd != K.F64 or arr_of[x.a] < 0:
                    return no_kernel()
                is_f[x.d] = true
            case Op.Store:
                if sf.f.vk[x.b] != K.F64 or arr_of[x.a] < 0:
                    return no_kernel()
                if not param(sf, x.b, K.F64, is_f, ins(def_b, inb, x.b), ref flts):
                    return no_kernel()
                stores += 1
            case Op.Add | Op.Sub | Op.Mul | Op.Div if vd == K.F64:
                if sum_of[x.a] >= 0:
                    # s op x: the sum's update
                    if x.d != sback[sum_of[x.a]] or x.op == Op.Div or sum_of[x.b] >= 0:
                        return no_kernel()
                elif not param(sf, x.a, K.F64, is_f, ins(def_b, inb, x.a), ref flts):
                    return no_kernel()
                if not param(sf, x.b, K.F64, is_f, ins(def_b, inb, x.b), ref flts):
                    return no_kernel()
                is_f[x.d] = true
            case Op.Add if x.d == jn and x.a == phi.d and not inc:
                if ins(def_b, inb, x.b) or cval[x.b] != 1:
                    return no_kernel()
                inc = true
            case Op.Add | Op.Sub | Op.Mul | Op.And | Op.Or | Op.Xor if vd == K.I64:
                if x.op == Op.Add and (is_j[x.a] or is_j[x.b]):
                    let o = x.b if is_j[x.a] else x.a
                    if not is_j[o] and not ins(def_b, inb, o):
                        idx_of[x.d] = o
                for v in [x.a, x.b]:
                    if not param(sf, v, K.I64, is_i, ins(def_b, inb, v), ref ints):
                        return no_kernel()
                is_i[x.d] = true
            case Op.Shl | Op.Shr if vd == K.I64:
                if (
                    cval[x.b] < 0
                    or ins(def_b, inb, x.b)
                    or not param(sf, x.a, K.I64, is_i, ins(def_b, inb, x.a), ref ints)
                ):
                    return no_kernel()
                is_i[x.d] = true
            case Op.Div if vd == K.I64:
                # by a power of two, as shifts
                let k = log2_exact(cval[x.b])
                if (
                    ins(def_b, inb, x.b)
                    or k < 1
                    or not param(sf, x.a, K.I64, is_i, ins(def_b, inb, x.a), ref ints)
                ):
                    return no_kernel()
                is_i[x.d] = true
            case Op.Conv if vd == K.F64 and sf.f.vk[x.a] == K.I64:
                if not param(sf, x.a, K.I64, is_i, ins(def_b, inb, x.a), ref ints):
                    return no_kernel()
                is_f[x.d] = true
            case _:
                return no_kernel()
    if not inc or (stores == 0 and len(sphi) == 0) or len(bases) == 0 or len(bases) > 3:
        return no_kernel()
    # nothing made in the loop is read after it, but j and the sums
    for bb in 0..nb:
        if not inb[bb]:
            for x in sf.bs[bb].code:
                for u in uses(x):
                    if u != phi.d and sum_of[u] < 0 and ins(def_b, inb, u):
                        return no_kernel()
    # second pass: the operations, on values numbered as vloop.br does
    let nint = len(ints)
    let nflt = len(flts)
    for v in 0..nv:
        val_of[v] = -1
    for i, v in enumerate(ints):
        val_of[v] = i
    for i, v in enumerate(flts):
        val_of[v] = nint + i
    val_of[phi.d] = nint + nflt
    var nval = nint + nflt + 1
    for x in chain:
        let vd = sf.f.vk[x.d] if x.d >= 0 else K.I64
        var op = -1
        var off = 0
        match x.op:
            case Op.IdxChk:
                val_of[x.d] = val_of[x.a]
            case Op.Load:
                ops.push(LOp(op=L_LD, a=-1, b=-1, arr=arr_of[x.a], off=x.n))
                val_of[x.d] = nval
                nval += 1
            case Op.Store:
                ops.push(LOp(op=L_ST, a=val_of[x.b], b=-1, arr=arr_of[x.a], off=x.n))
            case Op.Add | Op.Sub | Op.Mul | Op.Div if vd == K.F64:
                op = L_ADD
                if x.op == Op.Sub:
                    op = L_SUB
                elif x.op == Op.Mul:
                    op = L_MUL
                elif x.op == Op.Div:
                    op = L_DIV
                if sum_of[x.a] >= 0:
                    ops.push(LOp(op=L_RED, a=val_of[x.b], b=-1, arr=sum_of[x.a], off=op))
                    op = -1
            case Op.Add if x.d == jn and x.a == phi.d:
                pass
            case Op.Add | Op.Sub | Op.Mul | Op.And | Op.Or | Op.Xor if vd == K.I64:
                op = L_IADD
                if x.op == Op.Sub:
                    op = L_ISUB
                elif x.op == Op.Mul:
                    op = L_IMUL
                elif x.op == Op.And:
                    op = L_IAND
                elif x.op == Op.Or:
                    op = L_IOR
                elif x.op == Op.Xor:
                    op = L_IXOR
            case Op.Shl | Op.Shr if vd == K.I64:
                op = L_SHL if x.op == Op.Shl else L_SAR
                off = cval[x.b]
            case Op.Div if vd == K.I64:
                # truncating x / 2^k: (x + (x >> 63 as unsigned >> 64 - k)) >> k
                let k = log2_exact(cval[x.b])
                ops.push(LOp(op=L_SAR, a=val_of[x.a], b=-1, arr=-1, off=63))
                ops.push(LOp(op=L_SHR, a=nval, b=-1, arr=-1, off=64 - k))
                ops.push(LOp(op=L_IADD, a=val_of[x.a], b=nval + 1, arr=-1, off=0))
                ops.push(LOp(op=L_SAR, a=nval + 2, b=-1, arr=-1, off=k))
                val_of[x.d] = nval + 3
                nval += 4
            case Op.Conv:
                ops.push(LOp(op=L_CONV, a=val_of[x.a], b=-1, arr=-1, off=0))
                val_of[x.d] = nval
                nval += 1
            case _:
                pass
        if op >= 0:
            ops.push(LOp(op=op, a=val_of[x.a], b=val_of[x.b], arr=-1, off=off))
            val_of[x.d] = nval
            nval += 1
    let l = vloop.Loop(narr=len(bases), nint=nint, nflt=nflt, nred=len(sphi), ops=ops)
    let (ok, k) = vloop.compile(l, name, vw)
    if not ok:
        return no_kernel()
    # the block and the call, at the end of the preheader
    var code = sf.bs[pre].code
    let term = code.pop()
    let blk = new_v(ref sf, K.Ptr)
    sf.f.slots.push(Slot(size=8 * vloop.nwords(l), align=8, name="", typed=false, k=K.I64))
    code.push(mk(Op.SlotAddr, blk, len(sf.f.slots) - 1, -1, -1, 0))
    for i, base in enumerate(bases):
        var at = lo
        if binv[i] >= 0:
            at = new_v(ref sf, K.I64)
            code.push(mk(Op.Add, at, binv[i], lo, -1, 0))
        let p = new_v(ref sf, K.Ptr)
        code.push(mk(Op.Elem, p, base, at, -1, 8))
        code.push(mk(Op.Store, -1, blk, p, -1, 8 * i))
    # the count, or 0 unless lo < hi and every bounds check passes for every
    # j: the loop then does it all, and panics where it should
    let hi = lt.b
    var all = new_v(ref sf, K.Bool)
    code.push(mk(Op.Lt, all, lo, hi, -1, 0))
    if len(clen) > 0:
        let zero = new_v(ref sf, K.I64)
        code.push(mk(Op.Const, zero, -1, -1, -1, 0))
        let one = new_v(ref sf, K.I64)
        code.push(mk(Op.Const, one, -1, -1, -1, 1))
        let last = new_v(ref sf, K.I64)
        code.push(mk(Op.Sub, last, hi, one, -1, 0))
        for i, len_v in enumerate(clen):
            var f = lo
            var la = last
            # 0 <= f <= la < the length, for the first and the last index
            var ca = [zero]
            var cb = [f]
            if cinv[i] >= 0:
                # j + v as the loop computes it, which mustn't wrap around
                # between the first and the last j
                f = new_v(ref sf, K.I64)
                code.push(mk(Op.Add, f, lo, cinv[i], -1, 0))
                la = new_v(ref sf, K.I64)
                code.push(mk(Op.Add, la, last, cinv[i], -1, 0))
                ca = [zero, f]
                cb = [f, la]
            for ci in 0..len(ca):
                let c = new_v(ref sf, K.Bool)
                code.push(mk(Op.Le, c, ca[ci], cb[ci], -1, 0))
                let o2 = new_v(ref sf, K.Bool)
                code.push(mk(Op.And, o2, all, c, -1, 0))
                all = o2
            let c = new_v(ref sf, K.Bool)
            code.push(mk(Op.Lt, c, la, len_v, -1, 0))
            let o3 = new_v(ref sf, K.Bool)
            code.push(mk(Op.And, o3, all, c, -1, 0))
            all = o3
    let okn = new_v(ref sf, K.I64)
    code.push(mk(Op.Conv, okn, all, -1, -1, 0))
    let mask = new_v(ref sf, K.I64)
    code.push(mk(Op.Neg, mask, okn, -1, -1, 0))
    let span = new_v(ref sf, K.I64)
    code.push(mk(Op.Sub, span, hi, lo, -1, 0))
    let cnt = new_v(ref sf, K.I64)
    code.push(mk(Op.And, cnt, span, mask, -1, 0))
    code.push(mk(Op.Store, -1, blk, cnt, -1, 8 * vloop.w_cnt(l)))
    code.push(mk(Op.Store, -1, blk, lo, -1, 8 * vloop.w_lo(l)))
    for i, v in enumerate(ints):
        code.push(mk(Op.Store, -1, blk, v, -1, 8 * vloop.w_int(l, i)))
    for i, v in enumerate(flts):
        code.push(mk(Op.Store, -1, blk, v, -1, 8 * vloop.w_flt(l, i)))
    for s in 0..len(sphi):
        let init = phis[sphi[s]].args[sq[s]]
        code.push(mk(Op.Store, -1, blk, init, -1, 8 * vloop.w_red(l, s)))
    let done = new_v(ref sf, K.I64)
    code.push(Inst(op=Op.Call, d=done, a=-1, b=-1, c=-1, n=0, s=name, args=[blk]))
    let lo2 = new_v(ref sf, K.I64)
    code.push(mk(Op.Add, lo2, lo, done, -1, 0))
    # the sums so far, where the loop goes on from
    for s in 0..len(sphi):
        let v = new_v(ref sf, K.F64)
        code.push(mk(Op.Load, v, blk, -1, -1, 8 * vloop.w_red(l, s)))
        sf.bs[h].code[phi_ats[sphi[s]]].args[sq[s]] = v
    code.push(term)
    sf.bs[pre].code = code
    sf.bs[h].code[phi_ats[ji]].args[pre_q] = lo2
    return (true, k)

# Whether v can be an operand in the kernel: made in the loop as a value of
# the right type (`ok`), or from outside, which makes it a parameter (in `ps`).
fn param(sf: SF, v: int, k: K, ok: [bool], inside: bool, ref ps: [int]) -> bool:
    if inside:
        return ok[v]
    if sf.f.vk[v] != k:
        return false
    for p in ps:
        if p == v:
            return true
    ps.push(v)
    return true

fn ins(def_b: [int], inb: [bool], v: int) -> bool:
    return def_b[v] >= 0 and inb[def_b[v]]

# k when n is 2^k, else -1
fn log2_exact(n: int) -> int:
    if n <= 0:
        return -1
    var k = 0
    while (1 << k) < n:
        k += 1
    return k if (1 << k) == n else -1

# ================================================================ lane loops

# Innermost loops that run four interleaved iterations in lockstep get an
# AVX2 kernel (vlane.br), called before the loop.
fn lane_loops(ref sf: SF, name: str) -> [KFunc]:
    var out: [KFunc] = []
    preheaders(ref sf)
    let loops = find_loops(sf)
    var is_head = [false] * len(sf.bs)
    for lp in loops:
        is_head[lp.header] = true
    for lp in loops:
        let (ok, k) = lane_loop(ref sf, lp, is_head, f"{name}_{len(out)}")
        if ok:
            out.push(k)
    return out

# One scalar operation of a lane: a vlane.br operation (V_*) on vregs.
struct LaneOp:
    op: int
    p: int
    d: int
    args: [int]

fn lane_none() -> (bool, LaneOp):
    return (false, LaneOp(op=-1, p=0, d=-1, args=[]))

# x as a lane operation, if it is one vlane.br has.
fn lane_inst(sf: SF, x: Inst) -> (bool, LaneOp):
    if x.d < 0:
        return lane_none()
    let kd = sf.f.vk[x.d]
    var op = -1
    var p = 0
    var args = [x.a, x.b]
    if kd == K.F64:
        if x.op == Op.Add:
            op = vlane.V_FADD
        elif x.op == Op.Sub:
            op = vlane.V_FSUB
        elif x.op == Op.Mul:
            op = vlane.V_FMUL
        elif x.op == Op.Div:
            op = vlane.V_FDIV
    elif kd == K.I64 or kd == K.Bool:
        if x.op == Op.And:
            op = vlane.V_AND
        elif x.op == Op.Or:
            op = vlane.V_OR
        elif x.op == Op.Xor:
            op = vlane.V_XOR
        elif x.op == Op.Not:
            op = vlane.V_NOT
            args = [x.a]
        elif kd == K.I64 and x.op == Op.Add:
            op = vlane.V_IADD
        elif kd == K.I64 and x.op == Op.Sub:
            op = vlane.V_ISUB
    if kd == K.Bool and op < 0:
        let ka = sf.f.vk[x.a]
        if ka == K.F64:
            # the ordered predicates, but != (true for NaN)
            op = vlane.V_FCMP
            match x.op:
                case Op.Eq:
                    p = 0
                case Op.Ne:
                    p = 4
                case Op.Lt:
                    p = 17
                case Op.Le:
                    p = 18
                case Op.Gt:
                    p = 30
                case Op.Ge:
                    p = 29
                case _:
                    op = -1
        elif ka == K.I64:
            op = vlane.V_IGT
            match x.op:
                case Op.Gt:
                    pass
                case Op.Lt:
                    args = [x.b, x.a]
                case Op.Le:
                    p = 1
                case Op.Ge:
                    args = [x.b, x.a]
                    p = 1
                case Op.Eq:
                    op = vlane.V_IEQ
                case Op.Ne:
                    op = vlane.V_IEQ
                    p = 1
                case _:
                    op = -1
        elif ka == K.Bool and (x.op == Op.Eq or x.op == Op.Ne):
            # masks of -1 and 0 compare as integers
            op = vlane.V_IEQ
            p = 1 if x.op == Op.Ne else 0
    if op < 0:
        return lane_none()
    return (true, LaneOp(op=op, p=p, d=x.d, args=args))

fn lane_kind(k: K) -> bool:
    return k == K.F64 or k == K.I64 or k == K.Bool

# Whether block e only jumps from b to j, which only b and e reach.
fn side_block(sf: SF, e: int, j: int, b: int, h: int, inb: [bool]) -> bool:
    if e == h or j == h or not inb[e] or not inb[j]:
        return false
    let bs = sf.bs
    if len(bs[e].pred) != 1 or bs[e].pred[0] != b or len(bs[e].succ) != 1 or bs[e].succ[0] != j:
        return false
    let jp = bs[j].pred
    return len(jp) == 2 and ((jp[0] == b and jp[1] == e) or (jp[0] == e and jp[1] == b))

# The loop must be: a header with phis in groups of four of one type (lanes
# 0 to 3 of a variable), pure operations, and a branch into the loop when
# the `or` of four values (the lanes of one) is true; then blocks in a row
# where a branch on a value skips a block that only computes, with phis
# after it. Lane k's operations must read lane k's values and values from
# outside the loop, and each lane must do the same operations as lane 0 in
# the same order.
fn lane_loop(ref sf: SF, lp: Loop, is_head: [bool], name: str) -> (bool, KFunc):
    let nb = len(sf.bs)
    let nv = len(sf.f.vk)
    let h = lp.header
    var inb = [false] * nb
    for b in lp.body:
        inb[b] = true
        if b != h and is_head[b]:
            return no_kernel()
    if len(sf.bs[h].pred) != 2:
        return no_kernel()
    var phis: [Inst] = []
    var phi_ats: [int] = []
    var hops: [Inst] = []
    for i, x in enumerate(sf.bs[h].code):
        if x.op == Op.Phi:
            phis.push(x)
            phi_ats.push(i)
        elif x.op != Op.Line:
            hops.push(x)
    let nphi = len(phis)
    if nphi == 0 or nphi % 4 != 0 or nphi > 128 or len(hops) < 2:
        return no_kernel()
    let br = hops.pop()
    if br.op != Op.Br and br.op != Op.BrNot:
        return no_kernel()
    let first = br.n if br.op == Op.Br else br.c
    let exitl = br.c if br.op == Op.Br else br.n
    if first < 0 or exitl < 0 or sf.lab[first] < 0 or sf.lab[exitl] < 0:
        return no_kernel()
    if not inb[sf.lab[first]] or inb[sf.lab[exitl]]:
        return no_kernel()
    let pre_q = outside_arg(sf, phis[0], inb)
    if pre_q < 0:
        return no_kernel()
    let pre_l = phis[0].args[pre_q - 1]
    let pre = sf.lab[pre_l]
    if pre < 0:
        return no_kernel()
    for i, x in enumerate(phis):
        if outside_arg(sf, x, inb) != pre_q or x.args[pre_q - 1] != pre_l:
            return no_kernel()
        if not lane_kind(sf.f.vk[x.d]) or sf.f.vk[x.d] != sf.f.vk[phis[i - i % 4].d]:
            return no_kernel()
    var def_b = [-1] * nv
    for b in 0..nb:
        for x in sf.bs[b].code:
            if x.d >= 0:
                def_b[x.d] = b
    # reads in the loop, and where in the header each value is made
    var reads = [0] * nv
    var hdef = [-1] * nv
    for b in lp.body:
        for x in sf.bs[b].code:
            for u in uses(x):
                reads[u] += 1
    for i, x in enumerate(hops):
        if x.d >= 0:
            hdef[x.d] = i
    # the test: an `or` of values, read by nothing else
    var tree = [false] * nv
    var leaves = [br.a]
    if reads[br.a] != 1:
        return no_kernel()
    while len(leaves) < nphi:
        var at = -1
        for i, v in enumerate(leaves):
            if at < 0 and hdef[v] >= 0 and hops[hdef[v]].op == Op.Or and reads[v] == 1:
                at = i
        if at < 0:
            break
        let x = hops[hdef[leaves[at]]]
        tree[x.d] = true
        var nl: [int] = []
        for i, v in enumerate(leaves):
            if i == at:
                nl.push(x.a)
                nl.push(x.b)
            else:
                nl.push(v)
        leaves = nl
    if len(leaves) % 4 != 0:
        return no_kernel()
    # the operations in order: the header's, then the rest's, with each
    # skipped block's phis as selects
    var lin: [LaneOp] = []
    for x in hops:
        if x.d >= 0 and tree[x.d]:
            continue
        if x.op == Op.Mov:
            lin.push(LaneOp(op=-1, p=0, d=x.d, args=[x.a]))
            continue
        let (ok, o) = lane_inst(sf, x)
        if not ok:
            return no_kernel()
        lin.push(o)
    let nhead = len(lin)
    var b = sf.lab[first]
    var seen = 1
    var join = false
    while true:
        if not inb[b] or seen > len(lp.body):
            return no_kernel()
        seen += 1
        let code = sf.bs[b].code
        for i in 0..len(code) - 1:
            let x = code[i]
            if x.op == Op.Line or (join and x.op == Op.Phi):
                continue
            if x.op == Op.Mov:
                lin.push(LaneOp(op=-1, p=0, d=x.d, args=[x.a]))
                continue
            let (ok, o) = lane_inst(sf, x)
            if not ok:
                return no_kernel()
            lin.push(o)
        let t = code[len(code) - 1]
        if t.op == Op.Jmp:
            let nx = sf.lab[t.n]
            if nx == h:
                break
            if nx < 0 or len(sf.bs[nx].pred) != 1:
                return no_kernel()
            b = nx
            join = false
            continue
        if (t.op != Op.Br and t.op != Op.BrNot) or sf.lab[t.n] < 0 or sf.lab[t.c] < 0:
            return no_kernel()
        var e = sf.lab[t.n]
        var j = sf.lab[t.c]
        if not side_block(sf, e, j, b, h, inb):
            e = sf.lab[t.c]
            j = sf.lab[t.n]
            if not side_block(sf, e, j, b, h, inb):
                return no_kernel()
        seen += 1
        let ecode = sf.bs[e].code
        for i in 0..len(ecode) - 1:
            let x = ecode[i]
            if x.op == Op.Line:
                continue
            if x.op == Op.Mov:
                lin.push(LaneOp(op=-1, p=0, d=x.d, args=[x.a]))
                continue
            let (ok, o) = lane_inst(sf, x)
            if not ok:
                return no_kernel()
            lin.push(o)
        # e runs when t.a is `when_e`
        let el = sf.bs[e].label
        let when_e = (t.op == Op.Br and t.n == el) or (t.op == Op.BrNot and t.c == el)
        for x in sf.bs[j].code:
            if x.op != Op.Phi:
                continue
            if len(x.args) != 4 or not lane_kind(sf.f.vk[x.d]):
                return no_kernel()
            var ve = -1
            var vb = -1
            for q in [0, 2]:
                let lb = sf.lab[x.args[q]]
                if lb == e:
                    ve = x.args[q + 1]
                elif lb == b:
                    vb = x.args[q + 1]
            if ve < 0 or vb < 0:
                return no_kernel()
            let args = [t.a, ve, vb] if when_e else [t.a, vb, ve]
            lin.push(LaneOp(op=vlane.V_SEL, p=0, d=x.d, args=args))
        b = j
        join = true
    if seen != len(lp.body):
        return no_kernel()
    # values made in the loop: their vector and lane. Vectors 0 to nphi / 4
    # - 1 are the variables; each other one is made by the operation of its
    # lane 0, with operands vectors (>= 0) or values from outside (-1, and
    # those in `vinv`, 4 for each operand).
    let nvar = nphi / 4
    var vec = [-1] * nv
    var lane = [-1] * nv
    var alias = [-1] * nv
    for i, x in enumerate(phis):
        vec[x.d] = i / 4
        lane[x.d] = i % 4
    var vop: [int] = []
    var vp: [int] = []
    var vk: [K] = []
    var vopnd: [[int]] = []
    var vinv: [[int]] = []
    var vfill: [[int]] = []
    var vhead: [bool] = []
    for g in 0..nvar:
        vop.push(-1)
        vp.push(0)
        vk.push(sf.f.vk[phis[4 * g].d])
        vopnd.push([])
        vinv.push([])
        vfill.push([phis[4 * g].d, phis[4 * g + 1].d, phis[4 * g + 2].d, phis[4 * g + 3].d])
        vhead.push(true)
    for i, o in enumerate(lin):
        if o.op < 0:
            # a copy
            var a = o.args[0]
            if alias[a] >= 0:
                a = alias[a]
            alias[o.d] = a
            vec[o.d] = vec[a]
            lane[o.d] = lane[a]
            continue
        var args: [int] = []
        var ln = -1
        for u0 in o.args:
            let u = alias[u0] if alias[u0] >= 0 else u0
            args.push(u)
            if vec[u] >= 0:
                if ln >= 0 and ln != lane[u]:
                    return no_kernel()
                ln = lane[u]
            elif ins(def_b, inb, u) or not lane_kind(sf.f.vk[u]):
                return no_kernel()
        if ln < 0:
            return no_kernel()
        var v = -1
        if ln == 0:
            v = len(vop)
            vop.push(o.op)
            vp.push(o.p)
            vk.push(sf.f.vk[o.d])
            var opnd: [int] = []
            var inv = [-1] * (4 * len(args))
            for j, u in enumerate(args):
                opnd.push(vec[u])
                if vec[u] < 0:
                    inv[4 * j] = u
            vopnd.push(opnd)
            vinv.push(inv)
            vfill.push([o.d, -1, -1, -1])
            vhead.push(i < nhead)
        else:
            for c in nvar..len(vop):
                if (
                    v < 0
                    and vfill[c][ln] < 0
                    and vop[c] == o.op
                    and vp[c] == o.p
                    and vk[c] == sf.f.vk[o.d]
                ):
                    var same = len(vopnd[c]) == len(args)
                    if same:
                        for j, u in enumerate(args):
                            if vopnd[c][j] != vec[u]:
                                same = false
                    if same:
                        v = c
            if v < 0:
                return no_kernel()
            for j, u in enumerate(args):
                if vec[u] < 0:
                    vinv[v][4 * j + ln] = u
            vfill[v][ln] = o.d
        vec[o.d] = v
        lane[o.d] = ln
    for c in 0..len(vop):
        for k in 0..4:
            if vfill[c][k] < 0:
                return no_kernel()
    # the test's values are the lanes of vectors, each lane once
    var tvs: [int] = []
    var lanes_seen: [[bool]] = []
    for u0 in leaves:
        let u = alias[u0] if alias[u0] >= 0 else u0
        if vec[u] < 0 or not vhead[vec[u]]:
            return no_kernel()
        var at = -1
        for i, t in enumerate(tvs):
            if t == vec[u]:
                at = i
        if at < 0:
            at = len(tvs)
            tvs.push(vec[u])
            lanes_seen.push([false] * 4)
        if lanes_seen[at][lane[u]]:
            return no_kernel()
        lanes_seen[at][lane[u]] = true
    if len(tvs) * 4 != len(leaves):
        return no_kernel()
    # each variable's next value: lane k of one vector, or values from outside
    var nexts: [int] = []
    var next_inv: [[int]] = []
    for g in 0..nvar:
        var nx = -2
        var outs = [-1] * 4
        for k in 0..4:
            let x = phis[4 * g + k]
            var u = x.args[4 - pre_q]
            if alias[u] >= 0:
                u = alias[u]
            if vec[u] >= 0:
                if lane[u] != k or (nx != -2 and nx != vec[u]):
                    return no_kernel()
                nx = vec[u]
            elif ins(def_b, inb, u) or nx >= 0:
                return no_kernel()
            else:
                nx = -1
                outs[k] = u
        nexts.push(nx)
        next_inv.push(outs)
    # nothing made in the loop is read after it, but in the header
    for bb in 0..nb:
        if not inb[bb]:
            for x in sf.bs[bb].code:
                for u in uses(x):
                    if ins(def_b, inb, u) and def_b[u] != h:
                        return no_kernel()
    # the values from outside: one for each set of four
    var inv_keys: [str] = []
    var invs: [[int]] = []
    var inv_at: {str: int} = {}
    var vinv_ix: [[int]] = []
    for c in 0..len(vop):
        var ix: [int] = []
        for j in 0..len(vopnd[c]):
            if vopnd[c][j] >= 0:
                ix.push(-1)
                continue
            let four = [vinv[c][4 * j], vinv[c][4 * j + 1], vinv[c][4 * j + 2], vinv[c][4 * j + 3]]
            ix.push(inv_index(four, ref inv_at, ref invs))
        vinv_ix.push(ix)
    var next_ix = [-1] * nvar
    for g in 0..nvar:
        if nexts[g] == -1:
            next_ix[g] = inv_index(next_inv[g], ref inv_at, ref invs)
    let ninv = len(invs)
    # the vectors as vlane.br numbers values
    var num = [-1] * len(vop)
    for g in 0..nvar:
        num[g] = g
    var head: [vlane.VOp] = []
    var body: [vlane.VOp] = []
    var nvals = nvar + ninv
    var test = -1
    for in_head in [true, false]:
        for c in nvar..len(vop):
            if vhead[c] != in_head:
                continue
            num[c] = nvals
            nvals += 1
            var a = [-1, -1, -1]
            for j in 0..len(vopnd[c]):
                a[j] = num[vopnd[c][j]] if vopnd[c][j] >= 0 else nvar + vinv_ix[c][j]
            let o = vlane.VOp(op=vop[c], p=vp[c], d=num[c], a=a[0], b=a[1], c=a[2])
            if in_head:
                head.push(o)
            else:
                body.push(o)
        if in_head:
            # the test: the `or` of its vectors
            test = num[tvs[0]]
            for i in 1..len(tvs):
                head.push(vlane.VOp(op=vlane.V_OR, p=0, d=nvals, a=test, b=num[tvs[i]], c=-1))
                test = nvals
                nvals += 1
    var next: [int] = []
    for g in 0..nvar:
        next.push(num[nexts[g]] if nexts[g] >= 0 else nvar + next_ix[g])
    let l = vlane.Lanes(nvar=nvar, ninv=ninv, head=head, test=test, body=body, next=next)
    let (ok, k) = vlane.compile(l, name)
    if not ok:
        return no_kernel()
    # the block and the call, at the end of the preheader
    var code = sf.bs[pre].code
    let term = code.pop()
    let blk = new_v(ref sf, K.Ptr)
    sf.f.slots.push(Slot(size=8 * vlane.nwords(l), align=8, name="", typed=false, k=K.I64))
    code.push(mk(Op.SlotAddr, blk, len(sf.f.slots) - 1, -1, -1, 0))
    for i, x in enumerate(phis):
        lane_store(ref sf, ref code, blk, x.args[pre_q], 8 * i)
    for j, four in enumerate(invs):
        for k2 in 0..4:
            lane_store(ref sf, ref code, blk, four[k2], 8 * (4 * (nvar + j) + k2))
    code.push(Inst(op=Op.Call, d=-1, a=-1, b=-1, c=-1, n=0, s=name, args=[blk]))
    # where the loop goes on from
    for i, x in enumerate(phis):
        let kd = sf.f.vk[x.d]
        var v = new_v(ref sf, K.I64 if kd == K.Bool else kd)
        code.push(mk(Op.Load, v, blk, -1, -1, 8 * i))
        if kd == K.Bool:
            let zero = new_v(ref sf, K.I64)
            code.push(mk(Op.Const, zero, -1, -1, -1, 0))
            let t = new_v(ref sf, K.Bool)
            code.push(mk(Op.Ne, t, v, zero, -1, 0))
            v = t
        sf.bs[h].code[phi_ats[i]].args[pre_q] = v
    code.push(term)
    sf.bs[pre].code = code
    return (true, k)

fn inv_index(four: [int], ref at: {str: int}, ref invs: [[int]]) -> int:
    let key = f"{four[0]},{four[1]},{four[2]},{four[3]}"
    match at.get(key):
        case Some(i):
            return i
        case None:
            pass
    at[key] = len(invs)
    invs.push(four)
    return len(invs) - 1

# ================================================================ reversals

# A reversal of a prefix, d[0..=j] (lower.br's idiom), whose next block reads
# d[0] before anything writes memory: that read takes the new d[0] from the
# reversal instead (`brine_bytes_rev0`, which x64.br keeps in a register), so
# it doesn't wait for the reversal's stores to reach memory.
fn rev_first(ref sf: SF):
    var zero = [false] * len(sf.f.vk)
    for b in sf.bs:
        for x in b.code:
            if x.op == Op.Const and x.d >= 0 and x.n == 0:
                zero[x.d] = true
    for b in 0..len(sf.bs):
        let m = len(sf.bs[b].code)
        if m < 2:
            continue
        let t = sf.bs[b].code[m - 1]
        let c = sf.bs[b].code[m - 2]
        if (
            t.op != Op.BrNot
            or c.op != Op.Call
            or c.b != 1
            or c.s != "brine_bytes_rev"
            or c.d < 0
            or t.a != c.d
            or not zero[c.args[2]]
        ):
            continue
        # through blocks that only jump on, each reached from the last alone
        var s = sf.lab[t.c]
        var hops = 0
        while (
            len(sf.bs[s].pred) == 1
            and len(sf.bs[s].code) == 1
            and sf.bs[s].code[0].op == Op.Jmp
            and hops < 8
        ):
            s = sf.lab[sf.bs[s].code[0].n]
            hops += 1
        if s == b or len(sf.bs[s].pred) != 1:
            continue
        var at = -1
        for i, x in enumerate(sf.bs[s].code):
            if x.op == Op.Load and x.a == c.args[0] and x.n == 0 and sf.f.vk[x.d] == K.U8:
                at = i
                break
            if (
                x.op == Op.Store
                or x.op == Op.Copy
                or x.op == Op.Zero
                or x.op == Op.Call
                or x.op == Op.CallInd
            ):
                break
        if at < 0:
            continue
        # the new d[0], or -1 (it then did nothing) where the reversal isn't
        # all in bounds and short
        let r = new_v(ref sf, K.I64)
        let z = new_v(ref sf, K.I64)
        var call = c
        call.d = r
        call.s = "brine_bytes_rev0"
        call.args = [c.args[0], c.args[1], c.args[3]]
        var code: [Inst] = []
        for i in 0..m - 2:
            code.push(sf.bs[b].code[i])
        code.push(mk(Op.Const, z, -1, -1, -1, 0))
        code.push(call)
        code.push(mk(Op.Ge, c.d, r, z, -1, 0))
        code.push(t)
        sf.bs[b].code = code
        let v = sf.bs[s].code[at].d
        sf.bs[s].code[at] = mk(Op.Conv, v, r, -1, -1, 0)
        # widening it back is r itself
        for i in at + 1..len(sf.bs[s].code):
            let x = sf.bs[s].code[i]
            if x.op == Op.Conv and x.a == v and sf.f.vk[x.d] == K.I64:
                sf.bs[s].code[i] = mk(Op.Mov, x.d, r, -1, -1, 0)

# v at byte off of the block: booleans as -1 or 0.
fn lane_store(ref sf: SF, ref code: [Inst], blk: int, v: int, off: int):
    var w = v
    if sf.f.vk[v] == K.Bool:
        let n = new_v(ref sf, K.I64)
        code.push(mk(Op.Conv, n, v, -1, -1, 0))
        w = new_v(ref sf, K.I64)
        code.push(mk(Op.Neg, w, n, -1, -1, 0))
    code.push(mk(Op.Store, -1, blk, w, -1, off))

# f optimized, and the vector loop kernels it calls (x86-64; `vw`: their
# most lanes).
fn optimize(f: Func, vw: int) -> (Func, [KFunc]):
    var sf = build(f)
    to_ssa(ref sf)
    copies(ref sf)
    sccp(ref sf)
    simplify(ref sf)
    rewrites(ref sf)
    copies(ref sf)
    addressing(ref sf)
    gvn(ref sf)
    copies(ref sf)
    licm(ref sf)
    gvn(ref sf)
    copies(ref sf)
    # dead phis (of inlined calls' results) would hide loops' shapes
    dce(ref sf)
    var ks = vector_loops(ref sf, f"brv_{f.name}", vw)
    if vw >= 4:
        ks.extend(lane_loops(ref sf, f"brl_{f.name}"))
    rev_first(ref sf)
    while bool_ifs(ref sf):
        relink(ref sf)
    dce(ref sf)
    return (from_ssa(sf), ks)
