# Projects: `brine.toml`, `brine new`, `brine init`, and paths (as strings,
# with the platform's separators).
from diag import best_match

struct Project:
    root: str
    name: str
    version: str
    main: str
    # `[check] typed = true`: every variable needs a written type
    typed: bool
    # `[check] proven = true`: every runtime check must be proven away
    proven: bool
    # brine.toml's text, and its keys and sections brine doesn't know:
    # (lo, hi, message, help), for W0004
    toml: str
    unknown: [(int, int, str, str)]

# ---------------------------------------------------------------- paths

fn is_windows() -> bool:
    return os.name() == "windows"

fn is_sep(c: str) -> bool:
    return c == "/" or (c == "\\" and is_windows())

fn is_sep_byte(b: u8) -> bool:
    return b == 47 or (b == 92 and is_windows())

# Whether byte i of p is a separator. (Paths are looked at byte by byte:
# `p[i]` stops on a byte inside a character.)
fn sep_at(p: str, i: int) -> bool:
    return is_sep_byte(p.bytes()[i])

# Length of the root prefix: "/" or, on Windows, "C:", "C:\" or "\".
fn root_len(p: str) -> int:
    let b = p.bytes()
    if is_windows() and len(b) >= 2 and b[1] == 58 and b[0] < 0x80 and is_ascii_alpha(p[0]):
        if len(b) >= 3 and is_sep_byte(b[2]):
            return 3
        return 2
    if len(b) >= 1 and is_sep_byte(b[0]):
        return 1
    return 0

fn is_absolute(p: str) -> bool:
    return root_len(p) > 0

# `a/b` with the platform's separator; an absolute `b` replaces `a`.
fn join(a: str, b: str) -> str:
    if a == "" or is_absolute(b):
        return b
    if sep_at(a, len(a) - 1):
        return a + b
    if is_windows():
        return a + "\\" + b
    return a + "/" + b

# The directory containing `p`: None for a root or "",
# "" for a bare name.
fn parent(p: str) -> Option[str]:
    let root = root_len(p)
    let b = p.bytes()
    var n = len(b)
    while n > root and is_sep_byte(b[n - 1]):
        n -= 1
    if n <= root:
        return None
    var i = n
    while i > root and not is_sep_byte(b[i - 1]):
        i -= 1
    while i > root and is_sep_byte(b[i - 1]):
        i -= 1
    return Some(p[0:i])

# The last part of a path (None for a root, `.` or `..`).
fn file_name(p: str) -> Option[str]:
    let root = root_len(p)
    let b = p.bytes()
    var n = len(b)
    while n > root and is_sep_byte(b[n - 1]):
        n -= 1
    if n <= root:
        return None
    var i = n
    while i > root and not is_sep_byte(b[i - 1]):
        i -= 1
    let last = p[i:n]
    if last == ".." or last == ".":
        return None
    return Some(last)

# ---------------------------------------------------------------- brine.toml

# Minimal TOML subset: `[section]` headers and `key = "string"` / `key = 123`.
# Returns (section, key, value) triples.
fn parse_toml(text: str) -> Result[[(str, str, str)], str]:
    var out: [(str, str, str)] = []
    var section = ""
    let ls = text.lines()
    for i in 0..len(ls):
        let raw = ls[i]
        var line = raw
        match raw.find("#"):
            case Some(p):
                if not ("\"" in raw[0:p]):
                    line = raw[0:p]
            case None:
                pass
        line = line.strip()
        if line == "":
            continue
        if line.starts_with("["):
            if not line.ends_with("]"):
                return Err(f"line {i + 1}: expected `]`")
            section = line[1:len(line) - 1].strip()
            continue
        let eq = line.find("=")
        if eq.is_none():
            return Err(f"line {i + 1}: expected `key = value`")
        let at = eq.unwrap()
        let key = line[0:at].strip()
        var val = line[at + 1:len(line)].strip()
        for q in ["\"", "'"]:
            if val.starts_with(q):
                let v = val[1:len(val)]
                match v.find(q):
                    case Some(end):
                        val = v[0:end]
                    case None:
                        return Err(f"line {i + 1}: unterminated string")
                break
        out.push((section, key, val))
    return Ok(out)

fn toml_get(kv: [(str, str, str)], sec: str, k: str) -> Option[str]:
    for t in kv:
        let (s, kk, v) = t
        if s == sec and kk == k:
            return Some(v)
    return None

# Find `brine.toml` in `start` or any parent directory.
fn find(start: str) -> Option[Result[Project, str]]:
    var dir = Some(start)
    while dir.is_some():
        let d = dir.unwrap()
        if os.is_file(join(d, "brine.toml")):
            return Some(load(d))
        dir = parent(d)
    return None

fn load(root: str) -> Result[Project, str]:
    let path = join(root, "brine.toml")
    var text = ""
    match read_file(path):
        case Ok(t):
            text = t
        case Err(e):
            return Err(e)
    var kv: [(str, str, str)] = []
    match parse_toml(text):
        case Ok(x):
            kv = x
        case Err(e):
            return Err("brine.toml: " + e)
    let name = toml_get(kv, "package", "name")
    if name.is_none():
        return Err("brine.toml: missing `name` in [package]")
    # the name names the executable, so it can't be a path
    if not valid_name(name.unwrap()):
        return Err(f"brine.toml: `name = \"{name.unwrap()}\"` in [package] {NAME_RULE}")
    let version = toml_get(kv, "package", "version").unwrap_or("0.1.0")
    let main = join(root, toml_get(kv, "build", "main").unwrap_or("src/main.br"))
    var typed = false
    match toml_get(kv, "check", "typed"):
        case None:
            pass
        case Some(v):
            if v == "true":
                typed = true
            elif v != "false":
                return Err(f"brine.toml: `typed` in [check] must be true or false, not `{v}`")
    var proven = false
    match toml_get(kv, "check", "proven"):
        case None:
            pass
        case Some(v2):
            if v2 == "true":
                proven = true
            elif v2 != "false":
                return Err(f"brine.toml: `proven` in [check] must be true or false, not `{v2}`")
    return Ok(
        Project(
            root=root,
            name=name.unwrap(),
            version=version,
            main=main,
            typed=typed,
            proven=proven,
            toml=text,
            unknown=unknown_keys(text)
        )
    )

# The sections and keys brine reads.
fn toml_keys() -> [(str, [str])]:
    return [("package", ["name", "version"]), ("build", ["main"]), ("check", ["typed", "proven"])]

# The keys and sections of brine.toml that brine doesn't read, which are
# probably typos: (lo, hi, message, help). `text` parsed with `parse_toml`.
fn unknown_keys(text: str) -> [(int, int, str, str)]:
    let known = toml_keys()
    var out: [(int, int, str, str)] = []
    var section = ""
    var keys: [str] = []
    var sec_ok = true
    var at = 0
    for raw in text.split("\n"):
        let lo = at
        at += len(raw) + 1
        let line = raw.strip()
        if line == "" or line.starts_with("#"):
            continue
        let start = lo + (len(raw) - len(raw.lstrip()))
        if line.starts_with("[") and line.ends_with("]"):
            section = line[1:len(line) - 1].strip()
            sec_ok = false
            keys = []
            var names: [str] = []
            for sec, ks in known:
                names.push(sec)
                if sec == section:
                    sec_ok = true
                    keys = ks
            if not sec_ok:
                out.push(
                    (
                        start,
                        start + len(line),
                        f"brine.toml has a section `[{section}]` that brine doesn't read",
                        suggest(section, names, "the sections are [package], [build] and [check]")
                    )
                )
            continue
        match line.find("="):
            case Some(eq):
                let key = line[:eq].strip()
                if not sec_ok:
                    continue
                if section == "":
                    out.push(
                        (
                            start,
                            start + len(key),
                            f"`{key}` in brine.toml is outside any section, so brine doesn't read it",
                            "put it under the section it belongs to, e.g. `[package]`"
                        )
                    )
                elif key not in keys:
                    let list = ", ".join([f"`{k}`" for k in keys])
                    out.push(
                        (
                            start,
                            start + len(key),
                            f"brine doesn't read `{key}` in [{section}]",
                            suggest(key, keys, f"[{section}] has {list}")
                        )
                    )
            case None:
                pass
    return out

# "did you mean `x`?" for the closest of `names`, else `other`.
fn suggest(s: str, names: [str], other: str) -> str:
    match best_match(s, names):
        case Some(b):
            return f"did you mean `{b}`?"
        case None:
            return other

# ---------------------------------------------------------------- new projects

fn is_ascii_alpha(c: str) -> bool:
    return len(c) == 1 and ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z"))

fn is_ascii_digit(c: str) -> bool:
    return len(c) == 1 and c >= "0" and c <= "9"

const NAME_RULE = "isn't a valid name: use letters, digits, `_` and `-`, starting with a letter or `_`"

# A letter or `_`, then letters, digits, `_` and `-` (ASCII only).
fn valid_name(n: str) -> bool:
    if n == "":
        return false
    var first = true
    for c in n:
        if first:
            if not (is_ascii_alpha(c) or c == "_"):
                return false
            first = false
        elif not (is_ascii_alpha(c) or is_ascii_digit(c) or c == "_" or c == "-"):
            return false
    return true

fn main_template() -> str:
    return embed("templates/main.br.txt")

fn rules_template() -> str:
    return embed("templates/RULES.br.txt")

fn agents_md(name: str, main: str) -> str:
    return embed("templates/AGENTS.md.txt").replace("{name}", name).replace("{main}", main)

fn readme(name: str) -> str:
    return f"# {name}\n\nA brine project.\n\n```sh\nbrine run     # build and run\nbrine test    # run tests\nbrine rules   # what RULES.br promises, and whether it's proven\n```\n"

fn gitignore() -> str:
    return "/target\n"

fn toml(name: str) -> str:
    return f"[package]\nname = \"{name}\"\nversion = \"0.1.0\"\n"

# Write `content` to `dir/rel` unless that file exists; true if it was written.
fn write_new(dir: str, rel: str, content: str) -> Result[bool, str]:
    let p = join(dir, rel)
    if file_exists(p):
        return Ok(false)
    write_file(p, content)?
    return Ok(true)

# `/target` added to a `.gitignore`, unless it already ignores it.
fn ignore_target(text: str) -> Option[str]:
    for line in text.lines():
        let l = line.strip()
        if l == "/target" or l == "/target/" or l == "target" or l == "target/":
            return None
    if text == "" or text.ends_with("\n"):
        return Some(text + "/target\n")
    return Some(text + "\n/target\n")

# Is `dir` in a git work tree already? git decides: a stray empty `.git`
# folder above it isn't a repository (v091#22). One git won't open (owned by
# another user: "dubious ownership") still counts.
fn in_repo(dir: str) -> bool:
    match os.spawn(["git", "-C", dir, "rev-parse", "--is-inside-work-tree"], {}, true, false):
        case Ok(p):
            if os.wait(p) == 0:
                return true
            let (_, err) = os.output(p)
            return "safe.directory" in err or "dubious ownership" in err
        case Err(_):
            # no git: nothing to initialize either
            return true

# Create the project files in `dir` (which may already exist but must not contain
# brine.toml). A `main.br` already in `dir` (`brine init`) stays the main file.
# Returns the files it made or changed.
fn create(dir: str, name: str) -> Result[[str], str]:
    if file_exists(join(dir, "brine.toml")):
        return Err(f"`{dir}` already contains a brine project")
    let own_main = os.is_file(join(dir, "main.br")) and not file_exists(join(dir, "src/main.br"))
    var conf = toml(name)
    if own_main:
        conf += "\n[build]\nmain = \"main.br\"\n"
    else:
        os.make_dir(join(dir, "src"))?
    var made: [str] = []
    var files = [("brine.toml", conf)]
    if not own_main:
        files.push(("src/main.br", main_template()))
    files.extend(
        [
            ("RULES.br", rules_template()),
            (".gitignore", gitignore()),
            ("AGENTS.md", agents_md(name, "main.br" if own_main else "src/main.br")),
            ("README.md", readme(name))
        ]
    )
    for f in files:
        let (rel, content) = f
        if write_new(dir, rel, content)?:
            made.push(rel)
        elif rel == ".gitignore":
            match ignore_target(read_file(join(dir, rel))?):
                case Some(more):
                    write_file(join(dir, rel), more)?
                    made.push(rel)
                case None:
                    pass
    # initialize git like most project tools do, unless we're already inside a repo
    if not in_repo(dir):
        match os.spawn(["git", "-C", dir, "init", "-q"], {}, false, true):
            case Ok(p):
                os.wait(p)
            case Err(_):
                pass
    return Ok(made)
