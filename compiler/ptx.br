# PTX for NVIDIA GPUs: `par` bodies as kernels.
#
# The lowering lifts every `par for`, `par [...]` map and `par` reduction into
# a function of the IR (`br_par_*`). `build` decides which of them can run on
# a GPU and writes those, with every function they call, as one PTX module.
# The runtime JIT-compiles it with the CUDA driver the first time a kernel
# runs (brine_rt.c, "GPU").
#
# A body can run on the GPU when it only computes: integer, float and bool
# arithmetic of up to 64 bits, comparisons, branches, loops, loads and stores
# (the context, captured arrays of plain data, the stack), `sqrt`, `abs`,
# `floor`, `ceil`, `round`, `min`, `max`, and calls to functions that can
# themselves. Allocation, strings, maps, enum boxes, I/O, function values and
# math whose rounding is libm's own (`sin`, `exp`, `pow`, float `%`, ...) keep
# a body on the CPU. The lowering checks that the context holds only plain
# data and arrays of it, so every pointer a kernel follows is a device copy.
#
# Results are bit-identical to the CPU's: every float operation is IEEE with
# round-to-nearest (`add.rn`, `mul.rn`: never contracted into an fma), `/` and
# `sqrt` are correctly rounded, and subnormals are kept. A failing check
# (overflow, an index, division by zero, `panic`) sets `brine_gpu_err` and
# ends the thread; the runtime then drops the GPU's results and runs the
# construct on the CPU, which reports the error as usual.
from ir import K, Op, Inst, Func, Slot, f64_bits

# A kernel to build: lifted body `fname` as kernel `entry`. kind 0: `par for`,
# 1: map, 2: reduction leaf (with reducer `op` over values of kind `vk`).
struct KReq:
    fname: str
    entry: str
    kind: int
    op: int
    vk: K

struct GpuCode:
    # the module ("" when no kernel can run on a GPU)
    ptx: str
    ok: [bool]
    # why a kernel can't run on a GPU
    why: [str]
    # estimated instructions per element, and how many of them are f64 math
    cost: [int]
    cost64: [int]

# Elements per reduction leaf (BRINE_LEAF in brine_rt.h).
const LEAF = 16
# Threads per block; also the fan-in of a combine pass.
const BLOCK = 256

fn build(funcs: [Func], ks: [KReq]) -> GpuCode:
    var index: {str: int} = {}
    for i, f in enumerate(funcs):
        index[f.name] = i
    # the functions the kernels reach, and what each calls
    var reach: [int] = []
    var seen: {int: bool} = {}
    var calls: {int: [int]} = {}
    var bad: {int: str} = {}
    var stack: [int] = []
    for k in ks:
        match index.get(k.fname):
            case Some(i):
                if i not in seen:
                    seen[i] = true
                    stack.push(i)
            case None:
                pass
    while len(stack) > 0:
        let i = stack.pop()
        reach.push(i)
        let (why, cs) = local_check(funcs[i], index)
        if why != "":
            bad[i] = why
        var ids: [int] = []
        for c in cs:
            let j = index[c]
            ids.push(j)
            if j not in seen:
                seen[j] = true
                stack.push(j)
        calls[i] = ids
    # a function that calls one that can't run on the GPU can't either
    var changed = true
    while changed:
        changed = false
        for i in reach:
            if i in bad:
                continue
            for j in calls[i]:
                if j in bad:
                    bad[i] = bad[j]
                    changed = true
                    break
    var ok: [bool] = []
    var why: [str] = []
    var cost: [int] = []
    var cost64: [int] = []
    var memo: {int: (int, int)} = {}
    var any_ok = false
    for k in ks:
        var good = false
        var w = "no body"
        match index.get(k.fname):
            case Some(i):
                good = i not in bad and len(funcs[i].vk) >= nparams_of(k.kind)
                w = bad.get(i).unwrap_or("")
            case None:
                pass
        ok.push(good)
        why.push(w)
        if good:
            any_ok = true
            let (c, c64) = fn_cost(funcs, index, index[k.fname], ref memo, true, 0)
            cost.push(max(c, 1))
            cost64.push(c64)
        else:
            cost.push(0)
            cost64.push(0)
    if not any_ok:
        return GpuCode(ptx="", ok=ok, why=why, cost=cost, cost64=cost64)
    # the functions the good kernels call, in a fixed order
    var used: [int] = []
    var useen: {int: bool} = {}
    var work: [int] = []
    for i, k in enumerate(ks):
        if ok[i]:
            work.push(index[k.fname])
    while len(work) > 0:
        let i = work.pop()
        for j in calls[i]:
            if j not in useen:
                useen[j] = true
                used.push(j)
                work.push(j)
    used = sort_ints(used)
    var o: [str] = []
    o.push("// generated by brine")
    o.push(".version 6.0")
    o.push(".target sm_50")
    o.push(".address_size 64")
    o.push("")
    o.push(".visible .global .align 4 .u32 brine_gpu_err;")
    o.push("")
    for i in used:
        o.push(func_head(funcs[i]) + ";")
    o.push("")
    var combs: {str: bool} = {}
    for i, k in enumerate(ks):
        if not ok[i]:
            continue
        o.extend(emit_entry(funcs[index[k.fname]], k))
        if k.kind == 2:
            let cn = comb_name(k.op, k.vk)
            if cn not in combs:
                combs[cn] = true
                o.extend(emit_comb(k.op, k.vk))
    for i in used:
        o.extend(emit_func(funcs[i]))
    return GpuCode(ptx="\n".join(o) + "\n", ok=ok, why=why, cost=cost, cost64=cost64)

fn nparams_of(kind: int) -> int:
    return 6 if kind == 2 else 4

fn sort_ints(xs: [int]) -> [int]:
    if len(xs) <= 1:
        return xs
    let mid = len(xs) / 2
    let a = sort_ints(xs[:mid])
    let b = sort_ints(xs[mid:])
    var out: [int] = []
    var i = 0
    var j = 0
    while i < len(a) and j < len(b):
        if a[i] <= b[j]:
            out.push(a[i])
            i += 1
        else:
            out.push(b[j])
            j += 1
    out.extend(a[i:])
    out.extend(b[j:])
    return out

# The combine kernel for reducer `op` over kind `vk`.
fn comb_name(op: int, vk: K) -> str:
    return f"brine_comb_{op}_{vk.name()}"

# ================================================================ eligibility

# Register class of a kind: 0 b64, 1 b32 (narrow integers are kept sign- or
# zero-extended to 32 bits), 2 predicate, 3 f32, 4 f64; -1 can't run here.
fn cls(k: K) -> int:
    match k:
        case K.I64 | K.U64 | K.Ptr:
            return 0
        case K.I8 | K.I16 | K.I32 | K.U8 | K.U16 | K.U32:
            return 1
        case K.Bool:
            return 2
        case K.F32:
            return 3
        case K.F64:
            return 4
        case _:
            return -1

# Runtime functions a kernel calls that report an error.
fn is_panic(s: str) -> bool:
    return s.starts_with("brine_panic") or s == "brine_assert_fail" or s == "brine_unreachable"

# Reference counting: plain-data arrays on the device are never freed, so these do nothing.
fn is_refcount(s: str) -> bool:
    return s == "brine_arr_retain" or s == "brine_arr_release" or s.starts_with(
        "br_retain_"
    ) or s.starts_with("br_release_")

# `brine_<op>_<suffix>` integer helpers the GPU has (see `rt_int`).
fn int_helper(s: str) -> bool:
    let ops = [
        "div_",
        "mod_",
        "fdiv_",
        "fmod_",
        "neg_",
        "abs_",
        "shl_",
        "shr_",
        "add_",
        "sub_",
        "mul_"
    ]
    for op in ops:
        let p = "brine_" + op
        if s.starts_with(p):
            return suffix_kind(s[len(p):]).is_some()
    if s.starts_with("brine_conv_"):
        let rest = s[11:]
        for src in ["_from_i64", "_from_u64", "_from_f64"]:
            if rest.ends_with(src):
                return suffix_kind(rest[:len(rest) - len(src)]).is_some()
    return false

fn float_helper(s: str) -> bool:
    for n in ["sqrt", "fabs", "floor", "ceil", "round", "fmin", "fmax"]:
        if s == "brine_f_" + n or s == "brine_f_" + n + "f":
            return true
    return false

fn suffix_kind(s: str) -> Option[K]:
    match s:
        case "i8":
            return Some(K.I8)
        case "i16":
            return Some(K.I16)
        case "i32":
            return Some(K.I32)
        case "i64":
            return Some(K.I64)
        case "u8":
            return Some(K.U8)
        case "u16":
            return Some(K.U16)
        case "u32":
            return Some(K.U32)
        case "u64":
            return Some(K.U64)
        case _:
            return None

# Can `f` run on a GPU, as far as its own code goes? "" if so, or why not;
# and the module functions it calls.
fn local_check(f: Func, index: {str: int}) -> (str, [str]):
    var callees: [str] = []
    for k in f.vk:
        if cls(k) < 0:
            return ("uses 128-bit integers", callees)
    if f.has_ret and cls(f.ret) < 0:
        return ("uses 128-bit integers", callees)
    # vregs holding the address of a symbol: only error locations, which
    # kernels don't need, may use them
    var glob: {int: bool} = {}
    for x in f.code:
        if x.op == Op.Global:
            glob[x.d] = true
    let global_use = "uses a global"
    for x in f.code:
        match x.op:
            case Op.CallInd:
                return ("calls a function value", callees)
            case Op.Global:
                pass
            case Op.Call:
                if is_panic(x.s) or is_refcount(x.s):
                    pass
                elif x.b == 1:
                    if not (int_helper(x.s) or float_helper(x.s)):
                        return (f"uses {helper_name(x.s)}", callees)
                    # only the last argument (a location) may be a symbol
                    for i, a in enumerate(x.args):
                        if a in glob and i != len(x.args) - 1:
                            return (global_use, callees)
                elif x.s in index:
                    for a in x.args:
                        if a in glob:
                            return (global_use, callees)
                    if x.s not in callees:
                        callees.push(x.s)
                else:
                    return (f"calls {x.s}", callees)
            case Op.AddO | Op.SubO | Op.MulO | Op.IdxChk:
                if x.a in glob or x.b in glob:
                    return (global_use, callees)
            case _:
                for v in [x.a, x.b, x.c]:
                    if v >= 0 and v in glob and x.op != Op.Const:
                        return (global_use, callees)
                if x.op == Op.Rem and f.vk[x.d].is_float():
                    return ("uses float %", callees)
    return ("", callees)

# What a runtime helper is in the source.
fn helper_name(s: str) -> str:
    if s.starts_with("brine_f_"):
        var n = s[8:]
        if n == "fmod" or n == "fmodf":
            return "float %"
        if n.ends_with("f") and n != "f":
            n = n[:len(n) - 1]
        return n
    return s

# ================================================================ cost

# Estimated instructions per element (and the f64 ones among them). Loops
# count 16 times; the body's own iteration loop (`root`) once.
fn fn_cost(
    funcs: [Func],
    index: {str: int},
    i: int,
    ref memo: {int: (int, int)},
    root: bool,
    depth: int
) -> (int, int):
    if not root:
        match memo.get(i):
            case Some(c):
                return c
            case None:
                pass
    if depth > 8:
        return (1000, 0)
    let f = funcs[i]
    var at: {int: int} = {}
    for j, x in enumerate(f.code):
        if x.op == Op.Label:
            at[x.n] = j
    # loop nesting at each instruction, from the back edges
    var nest = [0] * (len(f.code) + 1)
    for j, x in enumerate(f.code):
        if x.op == Op.Jmp or x.op == Op.Br or x.op == Op.BrNot:
            match at.get(x.n):
                case Some(h):
                    if h < j:
                        nest[h] += 1
                        nest[j + 1] -= 1
                case None:
                    pass
    var c = 0
    var c64 = 0
    var d = 0
    for j, x in enumerate(f.code):
        d += nest[j]
        var lv = d - 1 if root else d
        if lv < 0:
            lv = 0
        if lv > 3:
            lv = 3
        var mul = 1
        for _ in 0..lv:
            mul *= 16
        var w = 1
        var w64 = 0
        match x.op:
            case Op.Label | Op.Line:
                w = 0
            case Op.Div | Op.Rem:
                w = 16
            case Op.Copy | Op.Zero:
                w = x.n / 8 + 1
            case Op.Call:
                if x.s in index and x.b == 0:
                    let (cc, cc64) = fn_cost(funcs, index, index[x.s], ref memo, false, depth + 1)
                    w = cc + 4
                    w64 = cc64
                elif x.b == 1:
                    w = 16
                else:
                    w = 1
            case _:
                pass
        if x.d >= 0 and f.vk[x.d] == K.F64:
            match x.op:
                case Op.Add | Op.Sub | Op.Mul | Op.Div | Op.Conv:
                    w64 = w
                case Op.Call:
                    if x.b == 1:
                        w64 = w
                case _:
                    pass
        c += w * mul
        c64 += w64 * mul
        if c > 100000000:
            c = 100000000
        if c64 > 100000000:
            c64 = 100000000
    if not root:
        memo[i] = (c, c64)
    return (c, c64)

# ================================================================ emission

fn reg(k: K, v: int) -> str:
    match cls(k):
        case 0:
            return f"%rd{v}"
        case 1:
            return f"%r{v}"
        case 2:
            return f"%p{v}"
        case 3:
            return f"%f{v}"
        case _:
            return f"%fd{v}"

# `mov`'s type for a class
fn bty(k: K) -> str:
    match cls(k):
        case 0:
            return "b64"
        case 1:
            return "b32"
        case 2:
            return "pred"
        case 3:
            return "f32"
        case _:
            return "f64"

# Arithmetic type: signedness and register width.
fn aty(k: K) -> str:
    match k:
        case K.I64:
            return "s64"
        case K.U64 | K.Ptr:
            return "u64"
        case K.I8 | K.I16 | K.I32:
            return "s32"
        case K.U8 | K.U16 | K.U32 | K.Bool:
            return "u32"
        case K.F32:
            return "f32"
        case _:
            return "f64"

# Memory type of `ld`/`st` (bools are loaded as bytes, see `load`).
fn mty(k: K) -> str:
    match k:
        case K.I8:
            return "s8"
        case K.U8 | K.Bool:
            return "u8"
        case K.I16:
            return "s16"
        case K.U16:
            return "u16"
        case K.I32:
            return "s32"
        case K.U32:
            return "u32"
        case K.I64:
            return "s64"
        case K.F32:
            return "f32"
        case K.F64:
            return "f64"
        case _:
            return "u64"

# A parameter's type
fn pty(k: K) -> str:
    match cls(k):
        case 0:
            return "b64"
        case 3:
            return "f32"
        case 4:
            return "f64"
        case _:
            return "b32"

fn hex64(n: int) -> str:
    var u = i128(n)
    if u < 0:
        u += 18446744073709551616
    return f"0x{u64(u):016x}"

fn hex32(n: int) -> str:
    var u = i128(n) & 4294967295
    return f"0x{u64(u):08x}"

# The value of an integer constant of kind k as its register holds it.
fn int_imm(k: K, n: int) -> str:
    if cls(k) == 0:
        return hex64(n)
    return hex32(n)

fn kmin(k: K) -> int:
    match k:
        case K.I8:
            return -128
        case K.I16:
            return -32768
        case K.I32:
            return -2147483648
        case K.I64:
            return -9223372036854775807 - 1
        case _:
            return 0

fn kmax(k: K) -> int:
    match k:
        case K.I8:
            return 127
        case K.I16:
            return 32767
        case K.I32:
            return 2147483647
        case K.U8:
            return 255
        case K.U16:
            return 65535
        case K.U32:
            return 4294967295
        case _:
            return 9223372036854775807

fn kbits(k: K) -> int:
    return k.size() * 8

fn is_narrow(k: K) -> bool:
    match k:
        case K.I8 | K.I16 | K.U8 | K.U16:
            return true
        case _:
            return false

fn func_head(f: Func) -> str:
    var ps: [str] = []
    for i in 0..f.nparams:
        ps.push(f".param .{pty(f.vk[i])} {f.name}_p{i}")
    let r = f"(.param .{pty(f.ret)} func_retval0) " if f.has_ret else ""
    return f".func {r}{f.name}(" + ", ".join(ps) + ")"

# Where a vreg points when it's a fixed offset into a stack slot.
struct LocalAddr:
    slot: int
    off: int

struct Em:
    f: Func
    o: [str]
    # vregs that are stack slot addresses, and those also needed as generic pointers
    base: {int: LocalAddr}
    gen: {int: bool}
    # slots kept in a register (named after the vreg numbering, past the last vreg)
    promo: {int: bool}
    uses_err: bool
    entry: bool
    nlab: int

    fn e(ref self, s: str):
        self.o.push("\t" + s)

    fn r(self, v: int) -> str:
        return reg(self.f.vk[v], v)

    fn k(self, v: int) -> K:
        return self.f.vk[v]

    fn label(ref self) -> str:
        self.nlab += 1
        return f"$Lt{self.nlab}"

    fn err_if(ref self, p: str):
        self.uses_err = true
        self.e(f"@{p} bra $Lerr;")

    fn err_unless(ref self, p: str):
        self.uses_err = true
        self.e(f"@!{p} bra $Lerr;")

    # the register a promoted slot lives in
    fn slot_reg(self, s: int) -> str:
        return reg(self.f.slots[s].k, len(self.f.vk) + s)

    # an address operand for vreg `a` plus `off`
    fn addr(self, a: int, off: int) -> (str, str):
        match self.base.get(a):
            case Some(la):
                return (".local", f"[__s{la.slot}+{la.off + off}]")
            case None:
                return ("", f"[%rd{a}+{off}]")

    # keep a narrow integer sign- or zero-extended
    fn norm(ref self, k: K, r: str):
        match k:
            case K.I8:
                self.e(f"bfe.s32 {r}, {r}, 0, 8;")
            case K.I16:
                self.e(f"bfe.s32 {r}, {r}, 0, 16;")
            case K.U8:
                self.e(f"and.b32 {r}, {r}, 255;")
            case K.U16:
                self.e(f"and.b32 {r}, {r}, 65535;")
            case _:
                pass

# ---------------------------------------------------------------- analysis

# Stack slot addresses that stay known (for `.local` accesses), which of them
# also need a generic address, and which slots can live in a register.
fn analyze(ref em: Em):
    let f = em.f
    var defs = [0] * len(f.vk)
    for x in f.code:
        if x.d >= 0:
            defs[x.d] += 1
    var consts: {int: int} = {}
    for x in f.code:
        if x.op == Op.Const and defs[x.d] == 1:
            consts[x.d] = x.n
    # params are defined on entry
    for i in 0..f.nparams:
        defs[i] += 1
    var base: {int: LocalAddr} = {}
    for _ in 0..2:
        for x in f.code:
            if x.d < 0 or defs[x.d] != 1 or x.d in base:
                continue
            match x.op:
                case Op.SlotAddr:
                    base[x.d] = LocalAddr(slot=x.a, off=0)
                case Op.Mov:
                    match base.get(x.a):
                        case Some(la):
                            base[x.d] = la
                        case None:
                            pass
                case Op.Elem:
                    match base.get(x.a):
                        case Some(la):
                            match consts.get(x.b):
                                case Some(c):
                                    base[x.d] = LocalAddr(slot=la.slot, off=la.off + c * x.n)
                                case None:
                                    pass
                        case None:
                            pass
                case _:
                    pass
    var gen: {int: bool} = {}
    var escaped: {int: bool} = {}
    var nopromo: {int: bool} = {}
    for x in f.code:
        match x.op:
            case Op.Load:
                match base.get(x.a):
                    case Some(la):
                        let s = f.slots[la.slot]
                        if la.off + x.n != 0 or f.vk[x.d] != s.k:
                            nopromo[la.slot] = true
                    case None:
                        pass
            case Op.Store:
                match base.get(x.a):
                    case Some(la):
                        let s = f.slots[la.slot]
                        if la.off + x.n != 0 or f.vk[x.b] != s.k:
                            nopromo[la.slot] = true
                    case None:
                        pass
                if x.b in base:
                    gen[x.b] = true
            case Op.Copy | Op.Zero:
                for v in [x.a, x.b]:
                    match base.get(v):
                        case Some(la):
                            nopromo[la.slot] = true
                        case None:
                            pass
            case Op.Mov:
                if x.a in base and x.d not in base:
                    gen[x.a] = true
            case Op.Elem:
                if x.a in base and x.d not in base:
                    gen[x.a] = true
                if x.b in base:
                    gen[x.b] = true
            case Op.SlotAddr:
                pass
            case Op.Call | Op.CallInd:
                for a in x.args:
                    if a in base:
                        gen[a] = true
            case _:
                for v in [x.a, x.b]:
                    if v >= 0 and v in base:
                        gen[v] = true
    for v in gen:
        escaped[base[v].slot] = true
    for i, s in enumerate(f.slots):
        if s.typed and s.size == s.k.size() and i not in escaped and i not in nopromo:
            em.promo[i] = true
    em.base = base
    em.gen = gen

# ---------------------------------------------------------------- functions

fn decls(em: Em) -> [str]:
    let n = len(em.f.vk) + len(em.f.slots)
    var o: [str] = []
    o.push(f"\t.reg .b64 %rd<{n}>;")
    o.push(f"\t.reg .b32 %r<{n}>;")
    o.push(f"\t.reg .pred %p<{n}>;")
    o.push(f"\t.reg .f32 %f<{n}>;")
    o.push(f"\t.reg .f64 %fd<{n}>;")
    o.push("\t.reg .b64 %ta<8>;")
    o.push("\t.reg .b32 %tb<8>;")
    o.push("\t.reg .pred %tp<4>;")
    o.push("\t.reg .f64 %tf<4>;")
    o.push("\t.reg .f32 %tg<4>;")
    for i, s in enumerate(em.f.slots):
        if i not in em.promo:
            o.push(f"\t.local .align {s.align} .b8 __s{i}[{s.size}];")
    return o

fn new_em(f: Func, entry: bool) -> Em:
    var em = Em(f=f, o=[], base={}, gen={}, promo={}, uses_err=false, entry=entry, nlab=0)
    analyze(ref em)
    return em

fn emit_func(f: Func) -> [str]:
    var em = new_em(f, false)
    for i in 0..f.nparams:
        let k = f.vk[i]
        if cls(k) == 2:
            em.e(f"ld.param.b32 %tb0, [{f.name}_p{i}];")
            em.e(f"setp.ne.b32 %p{i}, %tb0, 0;")
        else:
            em.e(f"ld.param.{pty(k)} {reg(k, i)}, [{f.name}_p{i}];")
    body(ref em)
    var o = [func_head(f), "{"]
    o.extend(decls(em))
    o.extend(em.o)
    if em.uses_err:
        o.extend(err_tail())
    o.push("}")
    o.push("")
    return o

fn err_tail() -> [str]:
    return ["$Lerr:", "\tmov.u32 %tb0, 1;", "\tst.global.u32 [brine_gpu_err], %tb0;", "\texit;"]

# The kernel of a lifted body: thread `t` runs element (or leaf) base + t.
fn emit_entry(f: Func, k: KReq) -> [str]:
    var em = new_em(f, true)
    let e = k.entry
    var ps = [
        f".param .u64 {e}_ctx",
        f".param .u64 {e}_n",
        f".param .u64 {e}_base",
        f".param .u64 {e}_count"
    ]
    if k.kind == 2:
        ps.push(f".param .u64 {e}_vals")
        ps.push(f".param .u64 {e}_has")
    em.e(f"ld.param.u64 %ta0, [{e}_ctx];")
    em.e(f"ld.param.u64 %ta1, [{e}_n];")
    em.e(f"ld.param.u64 %ta2, [{e}_base];")
    em.e("mov.u32 %tb0, %ctaid.x;")
    em.e("mov.u32 %tb1, %ntid.x;")
    em.e("mov.u32 %tb2, %tid.x;")
    em.e("mul.wide.u32 %ta3, %tb0, %tb1;")
    em.e("cvt.u64.u32 %ta4, %tb2;")
    em.e("add.s64 %ta3, %ta3, %ta4;")
    em.e(f"ld.param.u64 %ta4, [{e}_count];")
    em.e("setp.ge.u64 %tp0, %ta3, %ta4;")
    em.e("@%tp0 bra $Lret;")
    em.e("add.s64 %ta5, %ta3, %ta2;")
    em.e("mov.b64 %rd0, %ta0;")
    em.e("mov.b64 %rd1, %ta5;")
    if k.kind == 2:
        # leaf i: elements [16 i, min(16 i + 16, n))
        em.e(f"mul.lo.s64 %ta6, %ta5, {LEAF};")
        em.e("mov.b64 %rd2, %ta6;")
        em.e(f"add.s64 %ta6, %ta6, {LEAF};")
        em.e("min.s64 %rd3, %ta6, %ta1;")
        let sz = k.vk.size()
        em.e(f"ld.param.u64 %ta0, [{e}_vals];")
        em.e(f"mad.lo.s64 %rd4, %ta3, {sz}, %ta0;")
        em.e(f"ld.param.u64 %ta0, [{e}_has];")
        em.e("add.s64 %rd5, %ta3, %ta0;")
    else:
        em.e("mov.b64 %rd2, %ta5;")
        em.e("add.s64 %rd3, %ta5, 1;")
    body(ref em)
    var o = [f".visible .entry {e}(" + ", ".join(ps) + ")", "{"]
    o.extend(decls(em))
    o.extend(em.o)
    o.push("$Lret:")
    o.push("\tret;")
    if em.uses_err:
        o.extend(err_tail())
    o.push("}")
    o.push("")
    return o

fn body(ref em: Em):
    let f = em.f
    # slot addresses that are also needed as plain pointers
    for i, x in enumerate(f.code):
        inst(ref em, x)

fn inst(ref em: Em, x: Inst):
    let f = em.f
    match x.op:
        case Op.Const:
            let k = em.k(x.d)
            match cls(k):
                case 0 | 1:
                    em.e(f"mov.{bty(k)} {em.r(x.d)}, {int_imm(k, x.n)};")
                case 2:
                    em.e(f"setp.ne.u32 {em.r(x.d)}, {1 if x.n != 0 else 0}, 0;")
                case _:
                    em.e(f"mov.b64 %ta0, {hex64(x.n)};")
                    em.e(f"cvt.rn.{aty(k)}.s64 {em.r(x.d)}, %ta0;")
        case Op.FConst:
            let k = em.k(x.d)
            if k == K.F32:
                em.e(f"mov.b32 %tb0, {hex32(x.n)};")
                em.e(f"mov.b32 {em.r(x.d)}, %tb0;")
            else:
                em.e(f"mov.b64 %ta0, {hex64(x.n)};")
                em.e(f"mov.b64 {em.r(x.d)}, %ta0;")
        case Op.Mov:
            if x.d in em.base:
                if x.d in em.gen:
                    gen_addr(ref em, x.d)
            else:
                let k = em.k(x.d)
                em.e(f"mov.{bty(k)} {em.r(x.d)}, {em.r(x.a)};")
        case Op.Add | Op.Sub | Op.Mul | Op.Div | Op.Rem:
            arith(ref em, x)
        case Op.And | Op.Or | Op.Xor:
            let k = em.k(x.d)
            let nm = "and" if x.op == Op.And else ("or" if x.op == Op.Or else "xor")
            let t = "pred" if cls(k) == 2 else ("b64" if cls(k) == 0 else "b32")
            em.e(f"{nm}.{t} {em.r(x.d)}, {em.r(x.a)}, {em.r(x.b)};")
        case Op.Shl | Op.Shr:
            let k = em.k(x.d)
            let amt = shift_amount(ref em, x.b)
            let w = "64" if cls(k) == 0 else "32"
            if x.op == Op.Shl:
                em.e(f"shl.b{w} {em.r(x.d)}, {em.r(x.a)}, {amt};")
                em.norm(k, em.r(x.d))
            else:
                let s = "s" if k.is_signed() else "u"
                em.e(f"shr.{s}{w} {em.r(x.d)}, {em.r(x.a)}, {amt};")
        case Op.Neg:
            let k = em.k(x.d)
            if k.is_float():
                em.e(f"neg.{aty(k)} {em.r(x.d)}, {em.r(x.a)};")
            else:
                let w = "s64" if cls(k) == 0 else "s32"
                em.e(f"neg.{w} {em.r(x.d)}, {em.r(x.a)};")
                em.norm(k, em.r(x.d))
        case Op.Not:
            let k = em.k(x.d)
            if cls(k) == 2:
                em.e(f"not.pred {em.r(x.d)}, {em.r(x.a)};")
            else:
                let w = "b64" if cls(k) == 0 else "b32"
                em.e(f"not.{w} {em.r(x.d)}, {em.r(x.a)};")
                em.norm(k, em.r(x.d))
        case Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge:
            compare(ref em, x)
        case Op.Conv:
            conv(ref em, em.k(x.d), x.d, em.k(x.a), em.r(x.a))
        case Op.AddO | Op.SubO | Op.MulO:
            let k = em.k(x.d)
            let nm = "add" if x.op == Op.AddO else ("sub" if x.op == Op.SubO else "mul")
            checked(ref em, nm, k, em.r(x.d), em.r(x.a), em.r(x.b))
        case Op.IdxChk:
            em.e(f"setp.ge.u64 %tp0, {em.r(x.a)}, {em.r(x.b)};")
            em.err_if("%tp0")
            em.e(f"mov.b64 {em.r(x.d)}, {em.r(x.a)};")
        case Op.SlotAddr:
            if x.d in em.gen:
                gen_addr(ref em, x.d)
        case Op.Global:
            em.e(f"mov.b64 {em.r(x.d)}, 0;")
        case Op.Load:
            load(ref em, x.d, x.a, x.n)
        case Op.Store:
            store(ref em, x.a, x.n, x.b)
        case Op.Elem:
            if x.d in em.base:
                if x.d in em.gen:
                    gen_addr(ref em, x.d)
            elif x.n == 1:
                em.e(f"add.s64 {em.r(x.d)}, {em.r(x.a)}, {em.r(x.b)};")
            else:
                em.e(f"mad.lo.s64 {em.r(x.d)}, {em.r(x.b)}, {x.n}, {em.r(x.a)};")
        case Op.Copy:
            copy(ref em, x.a, x.b, x.n)
        case Op.Zero:
            copy(ref em, x.a, -1, x.n)
        case Op.Call:
            call(ref em, x)
        case Op.Label:
            em.o.push(f"$L{x.n}:")
        case Op.Jmp:
            em.e(f"bra $L{x.n};")
        case Op.Br:
            em.e(f"@{em.r(x.a)} bra $L{x.n};")
        case Op.BrNot:
            em.e(f"@!{em.r(x.a)} bra $L{x.n};")
        case Op.Ret:
            if em.entry:
                em.e("bra $Lret;")
            else:
                if f.has_ret and x.a >= 0:
                    let k = f.ret
                    if cls(k) == 2:
                        em.e(f"selp.u32 %tb0, 1, 0, {em.r(x.a)};")
                        em.e("st.param.b32 [func_retval0], %tb0;")
                    else:
                        em.e(f"st.param.{pty(k)} [func_retval0], {em.r(x.a)};")
                em.e("ret;")
        case Op.Unreachable:
            em.uses_err = true
            em.e("bra $Lerr;")
        case _:
            pass

# The generic address of slot-address vreg `v`.
fn gen_addr(ref em: Em, v: int):
    let la = em.base[v]
    em.e(f"mov.u64 %rd{v}, __s{la.slot};")
    em.e(f"cvta.local.u64 %rd{v}, %rd{v};")
    if la.off != 0:
        em.e(f"add.s64 %rd{v}, %rd{v}, {la.off};")

fn shift_amount(ref em: Em, b: int) -> str:
    if cls(em.k(b)) == 0:
        em.e(f"cvt.u32.u64 %tb7, {em.r(b)};")
        return "%tb7"
    return em.r(b)

fn arith(ref em: Em, x: Inst):
    let k = em.k(x.d)
    let d = em.r(x.d)
    let a = em.r(x.a)
    let b = em.r(x.b)
    if k.is_float():
        let t = aty(k)
        match x.op:
            case Op.Add:
                em.e(f"add.rn.{t} {d}, {a}, {b};")
            case Op.Sub:
                em.e(f"sub.rn.{t} {d}, {a}, {b};")
            case Op.Mul:
                em.e(f"mul.rn.{t} {d}, {a}, {b};")
            case _:
                em.e(f"div.rn.{t} {d}, {a}, {b};")
        return
    let t = aty(k)
    match x.op:
        case Op.Add:
            em.e(f"add.{t} {d}, {a}, {b};")
        case Op.Sub:
            em.e(f"sub.{t} {d}, {a}, {b};")
        case Op.Mul:
            em.e(f"mul.lo.{t} {d}, {a}, {b};")
        case Op.Div:
            em.e(f"div.{t} {d}, {a}, {b};")
        case _:
            em.e(f"rem.{t} {d}, {a}, {b};")
    em.norm(k, d)

fn cmp_name(op: Op, float: bool) -> str:
    match op:
        case Op.Eq:
            return "eq"
        case Op.Ne:
            # unordered: NaN != x is true
            return "neu" if float else "ne"
        case Op.Lt:
            return "lt"
        case Op.Le:
            return "le"
        case Op.Gt:
            return "gt"
        case _:
            return "ge"

fn compare(ref em: Em, x: Inst):
    let k = em.k(x.a)
    let d = em.r(x.d)
    if cls(k) == 2:
        em.e(f"selp.u32 %tb0, 1, 0, {em.r(x.a)};")
        em.e(f"selp.u32 %tb1, 1, 0, {em.r(x.b)};")
        em.e(f"setp.{cmp_name(x.op, false)}.u32 {d}, %tb0, %tb1;")
        return
    em.e(f"setp.{cmp_name(x.op, k.is_float())}.{aty(k)} {d}, {em.r(x.a)}, {em.r(x.b)};")

# d (kind dk) = a (kind ak, register ar), like a C cast.
fn conv(ref em: Em, dk: K, d: int, ak: K, ar: str):
    let dr = reg(dk, d)
    if cls(ak) == 2:
        if dk.is_float():
            em.e(f"selp.u32 %tb0, 1, 0, {ar};")
            em.e(f"cvt.rn.{aty(dk)}.u32 {dr}, %tb0;")
        else:
            let w = "b64" if cls(dk) == 0 else "b32"
            em.e(f"selp.{w} {dr}, 1, 0, {ar};")
        return
    if dk.is_float() and ak.is_float():
        if dk == ak:
            em.e(f"mov.{aty(dk)} {dr}, {ar};")
        elif dk == K.F32:
            em.e(f"cvt.rn.f32.f64 {dr}, {ar};")
        else:
            em.e(f"cvt.f64.f32 {dr}, {ar};")
        return
    if dk.is_float():
        em.e(f"cvt.rn.{aty(dk)}.{aty(ak)} {dr}, {ar};")
        return
    if ak.is_float():
        # the lowering has checked the range: truncate toward zero
        em.e(f"cvt.rzi.{aty(dk)}.{aty(ak)} {dr}, {ar};")
        em.norm(dk, dr)
        return
    # integer to integer: extend by the source's signedness, then truncate
    let ca = cls(ak)
    let cd = cls(dk)
    if cd == 0:
        if ca == 0:
            em.e(f"mov.b64 {dr}, {ar};")
        else:
            let s = "s" if ak.is_signed() else "u"
            em.e(f"cvt.{s}64.{s}32 {dr}, {ar};")
        return
    if ca == 0:
        em.e(f"cvt.u32.u64 {dr}, {ar};")
    else:
        em.e(f"mov.b32 {dr}, {ar};")
    em.norm(dk, dr)

# d = a op b of kind k, ending the thread with an error on overflow.
fn checked(ref em: Em, op: str, k: K, d: str, a: str, b: str):
    if cls(k) == 0:
        let s = k.is_signed()
        if op == "add":
            em.e(f"add.s64 %ta2, {a}, {b};")
            if s:
                em.e(f"xor.b64 %ta0, {a}, %ta2;")
                em.e(f"xor.b64 %ta1, {b}, %ta2;")
                em.e("and.b64 %ta0, %ta0, %ta1;")
                em.e("setp.lt.s64 %tp0, %ta0, 0;")
            else:
                em.e(f"setp.lt.u64 %tp0, %ta2, {a};")
        elif op == "sub":
            em.e(f"sub.s64 %ta2, {a}, {b};")
            if s:
                em.e(f"xor.b64 %ta0, {a}, {b};")
                em.e(f"xor.b64 %ta1, {a}, %ta2;")
                em.e("and.b64 %ta0, %ta0, %ta1;")
                em.e("setp.lt.s64 %tp0, %ta0, 0;")
            else:
                em.e(f"setp.lt.u64 %tp0, {a}, {b};")
        else:
            em.e(f"mul.lo.s64 %ta2, {a}, {b};")
            if s:
                em.e(f"mul.hi.s64 %ta0, {a}, {b};")
                em.e("shr.s64 %ta1, %ta2, 63;")
                em.e("setp.ne.s64 %tp0, %ta0, %ta1;")
            else:
                em.e(f"mul.hi.u64 %ta0, {a}, {b};")
                em.e("setp.ne.u64 %tp0, %ta0, 0;")
        em.err_if("%tp0")
        em.e(f"mov.b64 {d}, %ta2;")
        return
    if k == K.I32 or k == K.U32:
        let s = k == K.I32
        if op == "add":
            em.e(f"add.s32 %tb2, {a}, {b};")
            if s:
                em.e(f"xor.b32 %tb0, {a}, %tb2;")
                em.e(f"xor.b32 %tb1, {b}, %tb2;")
                em.e("and.b32 %tb0, %tb0, %tb1;")
                em.e("setp.lt.s32 %tp0, %tb0, 0;")
            else:
                em.e(f"setp.lt.u32 %tp0, %tb2, {a};")
        elif op == "sub":
            em.e(f"sub.s32 %tb2, {a}, {b};")
            if s:
                em.e(f"xor.b32 %tb0, {a}, {b};")
                em.e(f"xor.b32 %tb1, {a}, %tb2;")
                em.e("and.b32 %tb0, %tb0, %tb1;")
                em.e("setp.lt.s32 %tp0, %tb0, 0;")
            else:
                em.e(f"setp.lt.u32 %tp0, {a}, {b};")
        else:
            if s:
                em.e(f"mul.wide.s32 %ta0, {a}, {b};")
                em.e("cvt.u32.u64 %tb2, %ta0;")
                em.e("cvt.s64.s32 %ta1, %tb2;")
                em.e("setp.ne.s64 %tp0, %ta0, %ta1;")
            else:
                em.e(f"mul.wide.u32 %ta0, {a}, {b};")
                em.e("cvt.u32.u64 %tb2, %ta0;")
                em.e("setp.gt.u64 %tp0, %ta0, 4294967295;")
        em.err_if("%tp0")
        em.e(f"mov.b32 {d}, %tb2;")
        return
    # 8 and 16 bits: exact in 32 bits, then in range?
    let t = aty(k)
    if op == "mul":
        em.e(f"mul.lo.{t} %tb2, {a}, {b};")
    else:
        em.e(f"{op}.{t} %tb2, {a}, {b};")
    em.e("mov.b32 %tb1, %tb2;")
    em.norm(k, "%tb1")
    em.e("setp.ne.b32 %tp0, %tb1, %tb2;")
    em.err_if("%tp0")
    em.e(f"mov.b32 {d}, %tb2;")

fn load(ref em: Em, d: int, a: int, off: int):
    let k = em.k(d)
    match em.base.get(a):
        case Some(la):
            if la.slot in em.promo:
                em.e(f"mov.{bty(k)} {em.r(d)}, {em.slot_reg(la.slot)};")
                return
        case None:
            pass
    let (sp, ad) = em.addr(a, off)
    if cls(k) == 2:
        em.e(f"ld{sp}.u8 %tb0, {ad};")
        em.e(f"setp.ne.b32 {em.r(d)}, %tb0, 0;")
    else:
        em.e(f"ld{sp}.{mty(k)} {em.r(d)}, {ad};")

fn store(ref em: Em, a: int, off: int, v: int):
    let k = em.k(v)
    match em.base.get(a):
        case Some(la):
            if la.slot in em.promo:
                em.e(f"mov.{bty(k)} {em.slot_reg(la.slot)}, {em.r(v)};")
                return
        case None:
            pass
    let (sp, ad) = em.addr(a, off)
    if cls(k) == 2:
        em.e(f"selp.u32 %tb0, 1, 0, {em.r(v)};")
        em.e(f"st{sp}.u8 {ad}, %tb0;")
    else:
        em.e(f"st{sp}.{mty(k)} {ad}, {em.r(v)};")

# Alignment a stack slot address is known to have (up to 8).
fn local_align(em: Em, la: LocalAddr) -> int:
    var al = min(em.f.slots[la.slot].align, 8)
    while al > 1 and la.off % al != 0:
        al = al / 2
    return al

# memcpy(dst, src, n), or memset(dst, 0, n) when src is -1. Chunks as wide
# as both addresses allow: known for stack slots, tested at run time for
# other pointers (an aggregate's alignment isn't in the IR).
fn copy(ref em: Em, dst: int, src: int, n: int):
    if n <= 0:
        return
    var al = 8
    var dyn: [int] = []
    for v in [dst, src]:
        if v < 0:
            continue
        match em.base.get(v):
            case Some(la):
                al = min(al, local_align(em, la))
            case None:
                dyn.push(v)
    if len(dyn) == 0 or al == 1:
        copy_chunks(ref em, dst, src, n, al)
        return
    let done = em.label()
    # widest first: test the dynamic addresses' low bits
    var w = al
    while w > 1:
        let next = em.label()
        if len(dyn) == 1:
            em.e(f"and.b64 %ta7, %rd{dyn[0]}, {w - 1};")
        else:
            em.e(f"or.b64 %ta7, %rd{dyn[0]}, %rd{dyn[1]};")
            em.e(f"and.b64 %ta7, %ta7, {w - 1};")
        em.e("setp.ne.u64 %tp3, %ta7, 0;")
        em.e(f"@%tp3 bra {next};")
        copy_chunks(ref em, dst, src, n, w)
        em.e(f"bra {done};")
        em.o.push(f"{next}:")
        w = w / 2
    copy_chunks(ref em, dst, src, n, 1)
    em.o.push(f"{done}:")

fn copy_chunks(ref em: Em, dst: int, src: int, n: int, al: int):
    if n > 512:
        # a loop of bytes for big aggregates (rare)
        let top = em.label()
        em.e("mov.u64 %ta6, 0;")
        if src >= 0:
            src_ptr(ref em, src, "%ta4")
        src_ptr(ref em, dst, "%ta5")
        em.o.push(f"{top}:")
        if src >= 0:
            em.e("add.s64 %ta3, %ta4, %ta6;")
            em.e("ld.u8 %tb6, [%ta3];")
        else:
            em.e("mov.u32 %tb6, 0;")
        em.e("add.s64 %ta3, %ta5, %ta6;")
        em.e("st.u8 [%ta3], %tb6;")
        em.e("add.s64 %ta6, %ta6, 1;")
        em.e(f"setp.lt.u64 %tp3, %ta6, {n};")
        em.e(f"@%tp3 bra {top};")
        return
    var off = 0
    while off < n:
        var w = al
        while w > n - off:
            w = w / 2
        let (t, r) = chunk_reg(w)
        if src >= 0:
            let (sp, ad) = em.addr(src, off)
            em.e(f"ld{sp}.{t} {r}, {ad};")
        else:
            em.e(f"mov.{t} {r}, 0;")
        let (dp, dd) = em.addr(dst, off)
        em.e(f"st{dp}.{t} {dd}, {r};")
        off += w

fn chunk_reg(w: int) -> (str, str):
    match w:
        case 8:
            return ("u64", "%ta6")
        case 4:
            return ("u32", "%tb6")
        case 2:
            return ("u16", "%tb6")
        case _:
            return ("u8", "%tb6")

# a generic pointer to what `v` points to, in register `r`
fn src_ptr(ref em: Em, v: int, r: str):
    match em.base.get(v):
        case Some(la):
            em.e(f"mov.u64 {r}, __s{la.slot};")
            em.e(f"cvta.local.u64 {r}, {r};")
            em.e(f"add.s64 {r}, {r}, {la.off};")
        case None:
            em.e(f"mov.b64 {r}, %rd{v};")

fn call(ref em: Em, x: Inst):
    if is_panic(x.s):
        em.uses_err = true
        em.e("bra $Lerr;")
        return
    if is_refcount(x.s):
        return
    if x.b == 1:
        if x.s.starts_with("brine_f_"):
            rt_float(ref em, x)
        else:
            rt_int(ref em, x)
        return
    em.e("{")
    var names: [str] = []
    for i, a in enumerate(x.args):
        let k = em.k(a)
        let p = f"param{i}"
        names.push(p)
        em.e(f".param .{pty(k)} {p};")
        if cls(k) == 2:
            em.e(f"selp.u32 %tb0, 1, 0, {em.r(a)};")
            em.e(f"st.param.b32 [{p}], %tb0;")
        else:
            em.e(f"st.param.{pty(k)} [{p}], {em.r(a)};")
    let args = ", ".join(names)
    if x.d >= 0:
        let k = em.k(x.d)
        em.e(f".param .{pty(k)} retval0;")
        em.e(f"call (retval0), {x.s}, ({args});")
        if cls(k) == 2:
            em.e("ld.param.b32 %tb0, [retval0];")
            em.e(f"setp.ne.b32 {em.r(x.d)}, %tb0, 0;")
        else:
            em.e(f"ld.param.{pty(k)} {em.r(x.d)}, [retval0];")
    else:
        em.e(f"call {x.s}, ({args});")
    em.e("}")

# The integer helpers of brine_rt.h, with the same checks.
fn rt_int(ref em: Em, x: Inst):
    let s = x.s[6:]
    var name = ""
    var suf = ""
    var src = ""
    if s.starts_with("conv_"):
        let rest = s[5:]
        let at = len(rest) - 9
        suf = rest[:at]
        src = rest[at + 6:]
        name = "conv"
    else:
        var i = 0
        while s[i] != "_":
            i += 1
        name = s[:i]
        suf = s[i + 1:]
    let k = suffix_kind(suf).unwrap_or(K.I64)
    let d = em.r(x.d)
    let a = em.r(x.args[0])
    let t = aty(k)
    let w = "64" if cls(k) == 0 else "32"
    let signed = k.is_signed()
    match name:
        case "add" | "sub" | "mul":
            checked(ref em, name, k, d, a, em.r(x.args[1]))
        case "div" | "mod" | "fdiv" | "fmod":
            let b = em.r(x.args[1])
            if name == "div" or name == "mod":
                em.e(f"setp.eq.{t} %tp0, {b}, 0;")
                em.err_if("%tp0")
            if name == "div" and signed:
                em.e(f"setp.eq.{t} %tp0, {b}, -1;")
                em.e(f"setp.eq.{t} %tp1, {a}, {int_imm(k, kmin(k))};")
                em.e("and.pred %tp0, %tp0, %tp1;")
                em.err_if("%tp0")
            let ta = "%ta" if cls(k) == 0 else "%tb"
            let bt = "b64" if cls(k) == 0 else "b32"
            if not signed:
                let o = "div" if name == "div" or name == "fdiv" else "rem"
                em.e(f"{o}.{t} {d}, {a}, {b};")
            elif name == "div" or name == "fdiv":
                # floor: one less when the remainder isn't 0 and the signs differ
                em.e(f"div.{t} {ta}2, {a}, {b};")
                em.e(f"rem.{t} {ta}3, {a}, {b};")
                em.e(f"xor.{bt} {ta}4, {a}, {b};")
                em.e(f"setp.lt.{t} %tp0, {ta}4, 0;")
                em.e(f"setp.ne.{t} %tp1, {ta}3, 0;")
                em.e("and.pred %tp0, %tp0, %tp1;")
                em.e(f"@%tp0 sub.{t} {ta}2, {ta}2, 1;")
                em.e(f"mov.{bt} {d}, {ta}2;")
                em.norm(k, d)
            else:
                # the remainder takes the divisor's sign; `x % -1` is 0
                em.e(f"setp.eq.{t} %tp0, {b}, -1;")
                em.e(f"selp.{bt} {ta}4, 1, {b}, %tp0;")
                em.e(f"rem.{t} {ta}3, {a}, {ta}4;")
                em.e(f"xor.{bt} {ta}5, {ta}3, {ta}4;")
                em.e(f"setp.lt.{t} %tp0, {ta}5, 0;")
                em.e(f"setp.ne.{t} %tp1, {ta}3, 0;")
                em.e("and.pred %tp0, %tp0, %tp1;")
                em.e(f"@%tp0 add.{t} {ta}3, {ta}3, {ta}4;")
                em.e(f"mov.{bt} {d}, {ta}3;")
                em.norm(k, d)
        case "neg":
            em.e(f"setp.eq.{t} %tp0, {a}, {int_imm(k, kmin(k))};")
            em.err_if("%tp0")
            em.e(f"neg.s{w} {d}, {a};")
            em.norm(k, d)
        case "abs":
            if signed:
                em.e(f"setp.eq.{t} %tp0, {a}, {int_imm(k, kmin(k))};")
                em.err_if("%tp0")
                em.e(f"abs.s{w} {d}, {a};")
            else:
                em.e(f"mov.b{w} {d}, {a};")
        case "shl" | "shr":
            let b = em.r(x.args[1])
            em.e(f"setp.ge.u64 %tp0, {b}, {kbits(k)};")
            em.err_if("%tp0")
            em.e(f"cvt.u32.u64 %tb7, {b};")
            if name == "shl":
                em.e(f"shl.b{w} {d}, {a}, %tb7;")
                em.norm(k, d)
            else:
                let sg = "s" if signed else "u"
                em.e(f"shr.{sg}{w} {d}, {a}, %tb7;")
        case _:
            conv_checked(ref em, k, x.d, src, a)

# `brine_conv_<k>_from_<src>`: a narrowing conversion that must fit.
fn conv_checked(ref em: Em, k: K, d: int, src: str, a: str):
    let dr = reg(k, d)
    if src == "f64":
        # !(x >= MIN && x < MAX + 1) is out of range (or NaN)
        var lo = 0.0
        var hi = 0.0
        if k.is_signed():
            lo = -float(kmax(k)) - 1.0
            hi = float(kmax(k)) + 1.0
        elif k == K.U64:
            hi = 18446744073709551616.0
        else:
            hi = float(kmax(k)) + 1.0
        em.e(f"setp.ge.f64 %tp0, {a}, 0d{hex64(f64_bits(lo))[2:]};")
        em.e(f"setp.lt.f64 %tp1, {a}, 0d{hex64(f64_bits(hi))[2:]};")
        em.e("and.pred %tp0, %tp0, %tp1;")
        em.err_unless("%tp0")
        em.e(f"cvt.rzi.{aty(k)}.f64 {dr}, {a};")
        em.norm(k, dr)
        return
    if src == "i64":
        if k != K.I64:
            if k.is_signed() or k != K.U64:
                em.e(f"setp.lt.s64 %tp0, {a}, {kmin(k)};")
                em.err_if("%tp0")
            if k != K.U64:
                em.e(f"setp.gt.s64 %tp0, {a}, {kmax(k)};")
                em.err_if("%tp0")
            else:
                em.e(f"setp.lt.s64 %tp0, {a}, 0;")
                em.err_if("%tp0")
    elif k != K.U64:
        em.e(f"setp.gt.u64 %tp0, {a}, {kmax(k)};")
        em.err_if("%tp0")
    if cls(k) == 0:
        em.e(f"mov.b64 {dr}, {a};")
    else:
        em.e(f"cvt.u32.u64 {dr}, {a};")

# `brine_f_*` float helpers: the same results as the C library's, exactly.
fn rt_float(ref em: Em, x: Inst):
    let k = em.k(x.d)
    let t = aty(k)
    let d = em.r(x.d)
    let a = em.r(x.args[0])
    var n = x.s[8:]
    if k == K.F32:
        n = n[:len(n) - 1]
    let tf = "%tg" if k == K.F32 else "%tf"
    let ib = "b32" if k == K.F32 else "b64"
    let it = "%tb" if k == K.F32 else "%ta"
    match n:
        case "sqrt":
            em.e(f"sqrt.rn.{t} {d}, {a};")
        case "fabs":
            em.e(f"abs.{t} {d}, {a};")
        case "floor":
            em.e(f"cvt.rmi.{t}.{t} {d}, {a};")
        case "ceil":
            em.e(f"cvt.rpi.{t}.{t} {d}, {a};")
        case "round":
            # half away from zero: truncate, then step if the dropped part is >= 0.5
            let one = "0f3F800000" if k == K.F32 else "0d3FF0000000000000"
            let half = "0f3F000000" if k == K.F32 else "0d3FE0000000000000"
            em.e(f"cvt.rzi.{t}.{t} {tf}0, {a};")
            em.e(f"sub.rn.{t} {tf}1, {a}, {tf}0;")
            em.e(f"abs.{t} {tf}1, {tf}1;")
            em.e(f"setp.ge.{t} %tp0, {tf}1, {half};")
            em.e(f"mov.{t} {tf}2, {one};")
            em.e(f"copysign.{t} {tf}2, {a}, {tf}2;")
            em.e(f"@%tp0 add.rn.{t} {tf}0, {tf}0, {tf}2;")
            em.e(f"mov.{t} {d}, {tf}0;")
        case _:
            # brine_f_fmin/fmax (brine_rt.h): NaN loses; -0.0 < +0.0
            let b = em.r(x.args[1])
            let lt = "lt" if n == "fmin" else "gt"
            em.e(f"mov.{ib} {it}0, {a};")
            em.e(f"setp.lt.s{ib[1:]} %tp2, {it}0, 0;")
            if n == "fmin":
                em.e(f"selp.{t} {tf}0, {a}, {b}, %tp2;")
            else:
                em.e(f"selp.{t} {tf}0, {b}, {a}, %tp2;")
            em.e(f"setp.{lt}.{t} %tp0, {b}, {a};")
            em.e(f"setp.nan.{t} %tp1, {a}, {a};")
            em.e("or.pred %tp0, %tp0, %tp1;")
            em.e(f"selp.{t} {tf}0, {b}, {tf}0, %tp0;")
            em.e(f"setp.{lt}.{t} %tp0, {a}, {b};")
            em.e(f"setp.nan.{t} %tp1, {b}, {b};")
            em.e("or.pred %tp0, %tp0, %tp1;")
            em.e(f"selp.{t} {d}, {a}, {tf}0, %tp0;")

# ================================================================ combine kernels

# One pass of a reduction tree: block b combines nodes [256 b, 256 b + 256) of
# `vals`/`has` level by level (pairs at distance 1, 2, 4, ...) into node b of
# the output. Overflow sets `brine_gpu_err` (the CPU then redoes it all).
fn emit_comb(op: int, vk: K) -> [str]:
    let e = comb_name(op, vk)
    let sz = vk.size()
    var o: [str] = []
    o.push(
        f".visible .entry {e}(.param .u64 {e}_vin, .param .u64 {e}_hin, .param .u64 {e}_n, .param .u64 {e}_vout, .param .u64 {e}_hout)"
    )
    o.push("{")
    o.push("\t.reg .b64 %ta<12>;")
    o.push("\t.reg .b32 %tb<12>;")
    o.push("\t.reg .pred %tp<6>;")
    o.push("\t.reg .f64 %tf<4>;")
    o.push("\t.reg .f32 %tg<4>;")
    o.push("\t.reg .b32 %tc<2>;")
    o.push(f"\t.shared .align 8 .b8 sv[{BLOCK * 8}];")
    o.push(f"\t.shared .align 4 .b8 sh[{BLOCK}];")
    var em = Em(
        f=Func(name=e, nparams=0, has_ret=false, ret=K.I64, vk=[], slots=[], code=[], nlabels=0, public=false),
        o=[],
        base={},
        gen={},
        promo={},
        uses_err=false,
        entry=true,
        nlab=0
    )
    let (vr, vr2) = comb_regs(vk)
    em.e(f"ld.param.u64 %ta0, [{e}_vin];")
    em.e(f"ld.param.u64 %ta1, [{e}_hin];")
    em.e(f"ld.param.u64 %ta2, [{e}_n];")
    em.e("mov.u32 %tc0, %ctaid.x;")
    em.e("mov.u32 %tc1, %tid.x;")
    em.e(f"mul.wide.u32 %ta3, %tc0, {BLOCK};")
    em.e("cvt.u64.u32 %ta4, %tc1;")
    em.e("add.s64 %ta3, %ta3, %ta4;")
    # this thread's node, or none past the end
    em.e("mov.u32 %tb2, 0;")
    em.e(f"mov.{comb_bty(vk)} {vr}, {zero_imm(vk)};")
    em.e("setp.lt.u64 %tp0, %ta3, %ta2;")
    em.e("add.s64 %ta5, %ta1, %ta3;")
    em.e("@%tp0 ld.global.u8 %tb2, [%ta5];")
    em.e(f"mad.lo.s64 %ta5, %ta3, {sz}, %ta0;")
    em.e(f"@%tp0 ld.global.{comb_mty(vk)} {vr}, [%ta5];")
    em.e("mov.u32 %tb3, sv;")
    em.e("mad.lo.u32 %tb4, %tc1, 8, %tb3;")
    em.e("mov.u32 %tb3, sh;")
    em.e("add.u32 %tb5, %tc1, %tb3;")
    em.e(f"st.shared.{comb_mty(vk)} [%tb4], {vr};")
    em.e("st.shared.u8 [%tb5], %tb2;")
    em.e("bar.sync 0;")
    var s = 1
    while s < BLOCK:
        let skip = em.label()
        em.e(f"and.b32 %tb6, %tc1, {2 * s - 1};")
        em.e("setp.ne.u32 %tp1, %tb6, 0;")
        em.e(f"@%tp1 bra {skip};")
        em.e(f"ld.shared.u8 %tb7, [%tb5+{s}];")
        em.e("setp.eq.u32 %tp1, %tb7, 0;")
        em.e(f"@%tp1 bra {skip};")
        em.e(f"ld.shared.{comb_mty(vk)} {vr2}, [%tb4+{8 * s}];")
        em.e("ld.shared.u8 %tb8, [%tb5];")
        em.e("setp.eq.u32 %tp1, %tb8, 0;")
        em.e(f"ld.shared.{comb_mty(vk)} {vr}, [%tb4];")
        em.e(f"@%tp1 mov.{comb_bty(vk)} {vr}, {vr2};")
        let join = em.label()
        em.e(f"@%tp1 bra {join};")
        comb_op(ref em, op, vk, vr, vr2)
        em.o.push(f"{join}:")
        em.e(f"st.shared.{comb_mty(vk)} [%tb4], {vr};")
        em.e("mov.u32 %tb8, 1;")
        em.e("st.shared.u8 [%tb5], %tb8;")
        em.o.push(f"{skip}:")
        em.e("bar.sync 0;")
        s *= 2
    let fin = em.label()
    em.e("setp.ne.u32 %tp1, %tc1, 0;")
    em.e(f"@%tp1 bra {fin};")
    em.e(f"ld.param.u64 %ta0, [{e}_vout];")
    em.e(f"ld.param.u64 %ta1, [{e}_hout];")
    em.e("cvt.u64.u32 %ta6, %tc0;")
    em.e(f"ld.shared.{comb_mty(vk)} {vr}, [sv];")
    em.e("ld.shared.u8 %tb8, [sh];")
    em.e(f"mad.lo.s64 %ta7, %ta6, {sz}, %ta0;")
    em.e(f"st.global.{comb_mty(vk)} [%ta7], {vr};")
    em.e("add.s64 %ta7, %ta6, %ta1;")
    em.e("st.global.u8 [%ta7], %tb8;")
    em.o.push(f"{fin}:")
    em.e("ret;")
    o.extend(em.o)
    o.push("}")
    o.push("")
    return o

fn zero_imm(k: K) -> str:
    match cls(k):
        case 3:
            return "0f00000000"
        case 4:
            return "0d0000000000000000"
        case _:
            return "0"

# Registers holding the left and right value of a combine.
fn comb_regs(vk: K) -> (str, str):
    match cls(vk):
        case 0:
            return ("%ta8", "%ta9")
        case 3:
            return ("%tg0", "%tg1")
        case 4:
            return ("%tf0", "%tf1")
        case _:
            return ("%tb9", "%tb10")

fn comb_bty(vk: K) -> str:
    match cls(vk):
        case 0:
            return "b64"
        case 3:
            return "f32"
        case 4:
            return "f64"
        case _:
            return "b32"

fn comb_mty(vk: K) -> str:
    if vk == K.Bool:
        return "u8"
    return mty(vk)

# l = l (op) r, as brine_rt.c's combine functions do it.
fn comb_op(ref em: Em, op: int, vk: K, l: str, r: str):
    let t = aty(vk)
    match op:
        case 0 | 1:
            let nm = "add" if op == 0 else "mul"
            if vk.is_float():
                em.e(f"{nm}.rn.{t} {l}, {l}, {r};")
            else:
                # overflow is an error, but the barriers need every thread: no exit
                checked_flag(ref em, nm, vk, l, r)
        case 2 | 3:
            let c = "lt" if op == 2 else "gt"
            em.e(f"setp.{c}.{t} %tp2, {r}, {l};")
            em.e(f"@%tp2 mov.{comb_bty(vk)} {l}, {r};")
        case 4:
            em.e(f"or.b32 {l}, {l}, {r};")
        case _:
            em.e(f"and.b32 {l}, {l}, {r};")

# l = l op r with overflow setting the error flag (the thread goes on).
fn checked_flag(ref em: Em, op: str, k: K, l: str, r: str):
    var sub = Em(f=em.f, o=[], base={}, gen={}, promo={}, uses_err=false, entry=true, nlab=em.nlab)
    checked(ref sub, op, k, l, l, r)
    em.nlab = sub.nlab
    for line in sub.o:
        if line.ends_with("bra $Lerr;"):
            # `@%tp0 bra $Lerr;` -> set the flag instead
            let p = line.strip()[:len(line.strip()) - 10].strip()
            em.e("mov.u32 %tb11, 1;")
            em.e(f"{p} st.global.u32 [brine_gpu_err], %tb11;")
        else:
            em.o.push(line)
