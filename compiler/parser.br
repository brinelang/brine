# The parser: recursive descent over the lexer's tokens. Errors are collected; after one,
# the parser skips to the next line and keeps going.
from diag import Span, Diag
import diag
from lexer import Tok, Kw, Token, FPart, lex, describe, kw_name, punct_str, is_layout
from ast import TypeExpr, BinOp, CmpOp, UnOp, FSeg, Arg, CompKind, Comp, Unpack, Expr, ExprKind, mk
from ast import LetPat, Pattern, PatKind, Case, ContractKind, Stmt, StmtKind, Block, stmt, pattern
from types import I128_MAX
from ast import Param, FnDecl, FieldDecl, StructDecl, VariantDecl, EnumDecl, ConstDecl, Import, Module
from ast import RuleInfo, EffectsLine

fn is_int(t: Tok) -> bool:
    match t:
        case Tok.Int(_):
            return true
        case _:
            return false

fn is_str(t: Tok) -> bool:
    match t:
        case Tok.Str(_):
            return true
        case _:
            return false

fn is_ident(t: Tok) -> bool:
    match t:
        case Tok.Ident(_):
            return true
        case _:
            return false

fn empty_block() -> Block:
    return Block(stmts=[], span=Span(file=0, lo=0, hi=0))

# A first value for a variable of type `te`, for helps.
fn zero_text(te: TypeExpr) -> str:
    match te:
        case TypeExpr.Named(path, _, _):
            let n = path[len(path) - 1]
            if n == "int" or (len(n) >= 2 and (n[0] == "i" or n[0] == "u") and n[1:].is_digit()):
                return "0"
            if n == "float" or n == "f32" or n == "f64":
                return "0.0"
            if n == "bool":
                return "false"
            if n == "str":
                return "\"\""
            if n == "Option":
                return "None"
            return f"{n}(...)"
        case TypeExpr.Array(_, _):
            return "[]"
        case TypeExpr.Map(_, _, _):
            return "{}"
        case TypeExpr.Tuple(es, _):
            return "(" + ", ".join([zero_text(e) for e in es]) + ")"

# What to write for Rust's `Name::...` (`after_lt`: `::<T>` follows), or None
# when `.` is the fix (`Shape::Circle`, `geometry::area`).
fn rust_path_help(name: str, after_lt: bool) -> Option[str]:
    match name:
        case "String":
            return Some("a string literal is already a `str`: write `\"hi\"` (or `\"\"`)")
        case "Vec" | "VecDeque":
            return Some(
                "arrays are built in: write `[]`, with the element type on the variable: `var xs: [int] = []`; `vec![x; n]` is `[x] * n`"
            )
        case "HashMap" | "BTreeMap":
            return Some(
                "maps are built in: write `{}`, with the types on the variable: `var m: {str: int} = {}`; `m.insert(k, v)` is `m[k] = v`"
            )
        case "HashSet" | "BTreeSet":
            return Some(
                "brine has no sets: use a map to `bool`, `var seen: {int: bool} = {}`, with `seen[x] = true` and `x in seen`"
            )
        case "std" | "io" | "fs" | "env" | "process" | "mem" | "cmp" | "fmt" | "iter":
            return Some(
                "there is no standard library to import from: `print`, `read_file`, `args()`, `exit`, `min`, `max` and the rest are built in (`brine guide` lists them)"
            )
        case "collect" | "parse" | "into" | "sum" | "product":
            return Some(
                "brine has no `::<T>`: a comprehension builds an array (`[f(x) for x in xs]`), `\"\".join(parts)` a string, `s.to_int()` parses"
            )
        case _:
            if after_lt:
                return Some(
                    "brine has no `::<T>`: write the type on the variable instead: `let n: int = ...`"
                )
            return None

fn async_help() -> str:
    return "a call finishes before it returns; to run work at the same time, use `par`: `let (a, b) = par(f(x), g(y))` or `par for i in 0..n:`"

# What a loop or `let` unpacks into: a name, or a parenthesized tuple of targets.
enum Target:
    Name(name: str, span: Span, ty: Option[TypeExpr])
    Tuple(items: [Target], span: Span)

    fn span(self) -> Span:
        match self:
            case Target.Name(_, s, _):
                return s
            case Target.Tuple(_, s):
                return s

struct Parser:
    toks: [Token]
    pos: int
    file: int
    diags: [Diag]
    # statements to add after the one just parsed (the unpacking of nested tuples)
    pending: [Stmt]
    # the file's text, for helps that quote it
    text: str
    # a `try` was reported: its `except` and `finally` lines are the same mistake
    after_try: bool

    # ------------------------------------------------------------ helpers
    fn peek(self) -> Tok:
        return self.toks[self.pos].tok

    fn peek_at(self, n: int) -> Tok:
        return self.toks[min(self.pos + n, len(self.toks) - 1)].tok

    fn span(self) -> Span:
        let t = self.toks[self.pos]
        return Span(file=self.file, lo=t.lo, hi=t.hi)

    fn prev_span(self) -> Span:
        if self.pos == 0:
            return self.span()
        let t = self.toks[self.pos - 1]
        return Span(file=self.file, lo=t.lo, hi=t.hi)

    fn bump(ref self) -> Span:
        let s = self.span()
        if self.pos < len(self.toks) - 1:
            self.pos += 1
        return s

    fn at(self, t: Tok) -> bool:
        return self.peek() == t

    fn at_kw(self, k: Kw) -> bool:
        return self.peek() == Tok.Keyword(k)

    fn eat(ref self, t: Tok) -> bool:
        if self.at(t):
            self.bump()
            return true
        return false

    fn eat_kw(ref self, k: Kw) -> bool:
        if self.at_kw(k):
            self.bump()
            return true
        return false

    fn error_here(self, code: str, msg: str, label: str) -> Diag:
        return diag.error(code, msg).label(self.span(), label)

    # report an error at the current token
    fn report(ref self, code: str, msg: str, label: str):
        self.diags.push(self.error_here(code, msg, label))

    # the source text of bytes `lo..hi` ("" if that isn't text of this file)
    fn src(self, lo: int, hi: int) -> str:
        if lo < 0 or hi > len(self.text) or lo > hi:
            return ""
        let bs = self.text.bytes()
        if (
            (lo < len(bs) and (int(bs[lo]) & 0xc0) == 0x80)
            or (hi < len(bs) and (int(bs[hi]) & 0xc0) == 0x80)
        ):
            return ""
        return self.text[lo:hi]

    # true if token `pos + n` ends exactly where the next one starts (`::`, `:=`, `=>`)
    fn glued(self, n: int) -> bool:
        let i = self.pos + n
        if i < 0 or i + 1 >= len(self.toks):
            return false
        return self.toks[i].hi == self.toks[i + 1].lo

    # the index of the layout token that ends the current line
    fn line_end(self) -> int:
        var i = self.pos
        while i < len(self.toks) - 1 and not is_layout(self.toks[i].tok):
            i += 1
        return i

    # the source text from the current token to the end of its line
    fn line_rest(self) -> str:
        let e = self.line_end()
        if e <= self.pos:
            return ""
        return self.src(self.toks[self.pos].lo, self.toks[e - 1].hi)

    # true if the current token starts a value and can't continue one (`?` then
    # a name or a literal: a C ternary)
    fn starts_operand(self) -> bool:
        match self.peek():
            case Tok.Ident(_) | Tok.Int(_) | Tok.Float(_) | Tok.Str(_) | Tok.FStr(_):
                return true
            case Tok.Keyword(Kw.True) | Tok.Keyword(Kw.False):
                return true
            case _:
                return false

    # true if `t` comes later on the current line
    fn line_has(self, t: Tok) -> bool:
        for i in self.pos..self.line_end():
            if self.toks[i].tok == t:
                return true
        return false

    # the index of the first token of the current line
    fn line_head(self) -> int:
        var i = self.pos
        while i > 0 and not is_layout(self.toks[i - 1].tok):
            i -= 1
        return i

    # true if the token before the current one starts its line
    fn prev_starts_line(self) -> bool:
        return self.pos > 0 and self.line_head() == self.pos - 1

    fn push_foreign(ref self, span: Span, msg: str, label: str, help: str):
        self.diags.push(diag.error("E0115", msg).label(span, label).with_help(help))

    # A construct from another language at the current token: report it as E0115
    # with what brine writes instead, and return true. `in_expr` is true where an
    # expression should start.
    fn foreign(ref self, in_expr: bool) -> bool:
        let t = self.peek()
        let sp = self.span()
        var prev = Tok.Eof
        var psp = sp
        if self.pos > 0:
            prev = self.toks[self.pos - 1].tok
            psp = self.prev_span()
        let lambda_help = "define a named function (`fn double(x: int) -> int:`) and call it, for example in a comprehension: `[double(x) for x in xs]`"
        match t:
            case Tok.Ident(w) if w == "is" and not in_expr:
                var d = diag.error("E0115", "brine has no `is` operator").label(sp, "`is`")
                if self.peek_at(1) == Tok.Keyword(Kw.Not):
                    let s2 = Span(file=sp.file, lo=sp.lo, hi=self.toks[self.pos + 1].hi)
                    d = d.fix(s2, "!=", "replace `is not` with `!=`")
                else:
                    d = d.fix(sp, "==", "replace `is` with `==`")
                self.diags.push(
                    d.with_help(
                        "compare with `==` or `!=` (`x != None`); an `Option` also has `x.is_some()` and `x.is_none()`"
                    )
                )
                return true
            case Tok.Ident(w) if w == "lambda":
                self.push_foreign(sp, "brine has no lambdas", "`lambda`", lambda_help)
                return true
            case Tok.Keyword(Kw.As) if not in_expr:
                var d = diag.error("E0115", "brine has no `as` casts").label(sp, "`as`")
                d = d.with_help("convert by calling the type: `u8(x)`, `float(n)`, `int(f)`")
                match (prev, self.peek_at(1)):
                    case (Tok.Ident(_), Tok.Ident(ty)) | (Tok.Int(_), Tok.Ident(ty)):
                        let ps = self.prev_span()
                        let ts = self.toks[self.pos + 1]
                        let whole = Span(file=sp.file, lo=ps.lo, hi=ts.hi)
                        let arg = self.src(ps.lo, ps.hi)
                        if arg != "" and not (
                            self.peek_at(2) == Tok.Dot or self.peek_at(2) == Tok.LBracket
                        ):
                            d = d.fix(whole, f"{ty}({arg})", f"write `{ty}({arg})`")
                    case _:
                        pass
                self.diags.push(d)
                return true
            case Tok.Colon if self.peek_at(1) == Tok.Colon and self.glued(0):
                let s2 = Span(file=sp.file, lo=sp.lo, hi=self.toks[self.pos + 1].hi)
                var d = diag.error("E0115", "brine has no `::` paths").label(s2, "`::`")
                var pw = ""
                match prev:
                    case Tok.Ident(w):
                        pw = w
                    case _:
                        pass
                match rust_path_help(pw, self.peek_at(2) == Tok.Lt):
                    case Some(h):
                        d = d.with_help(h)
                    case None:
                        d = d.with_help(
                            "use `.`: `Shape.Circle`, `geometry.area(...)`"
                        ).fix(s2, ".", "replace `::` with `.`")
                self.diags.push(d)
                return true
            # Go's slice type `[]int`, as in `make([]int, n)`
            case Tok.Ident(w) if (
                not in_expr
                and prev == Tok.RBracket
                and self.pos >= 2
                and self.toks[self.pos - 2].tok == Tok.LBracket
                and self.glued(-1)
            ):
                self.push_foreign(
                    Span(file=sp.file, lo=self.toks[self.pos - 2].lo, hi=sp.hi),
                    "brine writes an array type as `[T]`",
                    "a Go slice type",
                    f"write `[{w}]`; `make([]{w}, n)` is `[0] * n` (any first value), and an empty one is `var xs: [{w}] = []`"
                )
                return true
            case Tok.Colon if self.peek_at(1) == Tok.Assign and self.glued(0):
                let s2 = Span(file=sp.file, lo=sp.lo, hi=self.toks[self.pos + 1].hi)
                self.push_foreign(
                    s2,
                    "brine has no `:=`",
                    "`:=`",
                    "give the value a name on a line of its own first: `let y = f(x)` (`var y = ...` if it changes)"
                )
                return true
            case Tok.Assign if self.peek_at(1) == Tok.Gt and self.glued(0):
                let s2 = Span(file=sp.file, lo=sp.lo, hi=self.toks[self.pos + 1].hi)
                self.push_foreign(s2, "brine has no arrow functions", "`=>`", lambda_help)
                return true
            case Tok.Pipe if in_expr:
                self.push_foreign(sp, "brine has no closures", "a closure's `|`", lambda_help)
                return true
            case Tok.Amp if in_expr:
                var e = self.toks[self.pos + 1].lo
                if self.peek_at(1) == Tok.Keyword(Kw.Mut):
                    e = self.toks[self.pos + 2].lo
                let d = diag.error(
                    "E0115",
                    "brine passes references with `ref`, not `&`"
                ).label(sp, "`&`")
                self.diags.push(
                    d.with_help(
                        "write `ref x`; the parameter is declared `ref name: type`"
                    ).fix(Span(file=sp.file, lo=sp.lo, hi=e), "ref ", "replace with `ref`")
                )
                return true
            case Tok.Keyword(Kw.Let) if in_expr:
                # `if let Some(x) = opt:`
                var i = self.pos + 1
                var eq = -1
                var colon = -1
                while i < len(self.toks) and not is_layout(self.toks[i].tok):
                    if self.toks[i].tok == Tok.Assign and eq < 0:
                        eq = i
                    if self.toks[i].tok == Tok.Colon:
                        colon = i
                    i += 1
                var help = "use `match value:` with a `case Some(x):` line and a `case _:` line for the rest"
                if eq > self.pos + 1 and colon > eq + 1:
                    let pat = self.src(self.toks[self.pos + 1].lo, self.toks[eq - 1].hi)
                    let val = self.src(self.toks[eq + 1].lo, self.toks[colon - 1].hi)
                    if pat != "" and val != "":
                        help = f"use `match {val}:` with a `case {pat}:` line and a `case _:` line for the rest"
                self.push_foreign(sp, "brine has no `if let`", "`let` here", help)
                return true
            case Tok.DotDot if in_expr and self.peek_at(1) == Tok.Dot and self.glued(0):
                let s2 = Span(file=sp.file, lo=sp.lo, hi=self.toks[self.pos + 1].hi)
                let d = diag.error("E0115", "`...` isn't a statement in brine").label(s2, "`...`")
                self.diags.push(
                    d.with_help("an empty body is written `pass`").fix(s2, "pass", "write `pass`")
                )
                return true
            case Tok.LBrace if is_ident(prev) and not in_expr:
                return self.struct_literal()
            case _:
                pass
        if prev == Tok.Ident("lambda"):
            self.push_foreign(psp, "brine has no lambdas", "`lambda`", lambda_help)
            return true
        return false

    # The statement so far is one word (`try`, `raise`, `retrun`, ...) and the
    # current token can't follow it: a construct from another language, or a
    # misspelled keyword. Only called at the end of a statement.
    fn foreign_word(ref self) -> bool:
        if not self.prev_starts_line():
            return false
        let prev = self.toks[self.pos - 1].tok
        let psp = self.prev_span()
        match prev:
            case Tok.Ident(w):
                match w:
                    case "try" | "except" | "finally" | "catch":
                        if w != "try" and self.after_try:
                            return true
                        self.after_try = true
                        self.push_foreign(
                            psp,
                            "brine has no exceptions",
                            f"`{w}`",
                            "a function that can fail returns `Result[T, E]` (or `Option[T]`): handle it with `match` (`case Ok(v):` / `case Err(e):`), or pass it on with `?`; text to a number is `s.to_int()`, an `Option[int]`"
                        )
                        return true
                    case "raise" | "throw":
                        self.push_foreign(
                            psp,
                            "brine has no exceptions",
                            f"`{w}`",
                            "return `Err(\"...\")` from a function that returns `Result[T, str]`, or call `panic(\"...\")` to stop the program"
                        )
                        return true
                    case "with":
                        self.push_foreign(
                            psp,
                            "brine has no `with` blocks",
                            "`with`",
                            "files are read and written in one call, and nothing needs closing: `read_file(path)` gives a `Result[str, str]`, `write_file(path, text)` writes one"
                        )
                        return true
                    case "switch":
                        self.push_foreign(
                            psp,
                            "brine has no `switch`",
                            "`switch`",
                            "write `match x:` with a `case 1:` line for each value and `case _:` for the rest"
                        )
                        return true
                    case "global" | "nonlocal":
                        self.push_foreign(
                            psp,
                            "brine has no global variables",
                            f"`{w}`",
                            "pass the variable with `ref` (`fn bump(ref counter: int)`, called as `bump(ref counter)`), or return the new value"
                        )
                        return true
                    case "loop":
                        var d = diag.error("E0115", "brine has no `loop`").label(psp, "`loop`")
                        d = d.with_help("write `while true:` and leave it with `break`")
                        if self.at(Tok.Colon):
                            d = d.fix(psp, "while true", "write `while true`")
                        self.diags.push(d)
                        return true
                    case "defer":
                        self.push_foreign(
                            psp,
                            "brine has no `defer`",
                            "`defer`",
                            "nothing needs closing (files are read and written in one call): run the code at the end of the function, before each `return`"
                        )
                        return true
                    case "go" | "spawn":
                        self.push_foreign(
                            psp,
                            "brine has no goroutines or threads to start",
                            f"`{w}`",
                            "run calls at the same time with `par`: `let (a, b) = par(f(x), g(y))`, `par for i in 0..n:` or `par [f(x) for x in xs]`"
                        )
                        return true
                    case "yield":
                        self.push_foreign(
                            psp,
                            "brine has no generators",
                            "`yield`",
                            "collect the values in an array and return it: `var out: [int] = []`, then `out.push(x)` where you would `yield x`, and `return out` at the end"
                        )
                        return true
                    case "async" | "await":
                        self.push_foreign(
                            psp,
                            "brine has no `async` or `await`",
                            f"`{w}`",
                            async_help()
                        )
                        return true
                    case "print":
                        # Python 2: `print "hi"`
                        var d = diag.error(
                            "E0115",
                            "`print` is a function in brine"
                        ).label(psp, "call it with `(...)`")
                        let rest = self.line_rest()
                        if rest != "":
                            d = d.with_help(f"write `print({rest})`")
                            d = d.fix(
                                Span(file=psp.file, lo=psp.hi, hi=self.toks[self.line_end()].lo),
                                f"({rest})",
                                "add the parentheses"
                            )
                        else:
                            d = d.with_help("write `print(x)`")
                        self.diags.push(d)
                        return true
                    case _:
                        pass
                # Python's `total: int = 0`, without `let` or `var`
                if self.at(Tok.Colon) and self.line_has(Tok.Assign):
                    self.diags.push(
                        diag.error("E0110", "a new variable starts with `let` or `var`")
                        .label(psp, "no `let` or `var`")
                        .with_help(f"write `var {w}: ...` (`let` if it never changes)")
                        .fix(Span(file=psp.file, lo=psp.lo, hi=psp.lo), "var ", "add `var`")
                    )
                    return true
                if len(w) >= 3:
                    let kws = [
                        "return",
                        "while",
                        "for",
                        "if",
                        "elif",
                        "else",
                        "match",
                        "let",
                        "var",
                        "break",
                        "continue",
                        "pass",
                        "assert",
                        "import",
                        "struct",
                        "enum",
                        "const"
                    ]
                    match diag.best_match(w, kws):
                        case Some(k):
                            self.diags.push(
                                diag.error("E0110", f"`{w}` isn't a keyword")
                                .label(psp, "not a keyword")
                                .with_help(f"did you mean `{k}`?")
                                .fix(psp, k, f"replace with `{k}`")
                            )
                            return true
                        case None:
                            pass
            case _:
                pass
        return false

    # `Point { x: 1, y: 2 }` at the `{`: brine writes `Point(x=1, y=2)`
    fn struct_literal(ref self) -> bool:
        let head = self.toks[self.line_head()].tok
        match head:
            case Tok.Keyword(Kw.If) | Tok.Keyword(Kw.Elif) | Tok.Keyword(Kw.While) | Tok.Keyword(
                Kw.For
            ) | Tok.Keyword(Kw.Match) | Tok.Keyword(Kw.Fn) | Tok.Keyword(Kw.Struct) | Tok.Keyword(Kw.Enum):
                return false
            case _:
                pass
        # `try {`, `loop {`, `defer {`: a block from another language, not a struct
        match self.toks[self.pos - 1].tok:
            case Tok.Ident(w) if w in [
                "try",
                "catch",
                "except",
                "finally",
                "loop",
                "defer",
                "go",
                "async",
                "spawn"
            ] and self.prev_starts_line():
                return self.foreign_word()
            case _:
                pass
        let name = self.prev_span()
        let lb = self.span()
        var d = diag.error(
            "E0115",
            "brine builds a struct by calling its name"
        ).label(lb, "a Rust/Go struct literal")
        let n = self.src(name.lo, name.hi)
        d = d.with_help(f"write `{n}(x=1, y=2)`: one keyword argument per field")
        # the fix: `{` becomes `(`, each `field:` becomes `field=`, `}` becomes `)`
        var i = self.pos + 1
        var depth = 0
        var edits: [(Span, str)] = [(Span(file=lb.file, lo=name.hi, hi=self.toks[i].lo), "(")]
        var ok = false
        while i < len(self.toks) and not is_layout(self.toks[i].tok):
            let tk = self.toks[i]
            match tk.tok:
                case Tok.LParen | Tok.LBracket | Tok.LBrace:
                    depth += 1
                case Tok.RParen | Tok.RBracket:
                    depth -= 1
                case Tok.RBrace:
                    if depth == 0:
                        let last = self.toks[i - 1]
                        edits.push((Span(file=lb.file, lo=last.hi, hi=tk.hi), ")"))
                        ok = true
                        break
                    depth -= 1
                case Tok.Colon if depth == 0 and is_ident(self.toks[i - 1].tok):
                    let nx = self.toks[i + 1]
                    edits.push((Span(file=lb.file, lo=tk.lo, hi=nx.lo), "="))
                case _:
                    pass
            i += 1
        if ok:
            for s, r in edits:
                d = d.fix(s, r, f"write `{n}(...)`")
        self.diags.push(d)
        return true

    # `)`, `]` or `}` was expected at the current token, which is on a later line
    # than the token before it: the bracket opened earlier is never closed. Point
    # at it, and offer to close it where the line before ended.
    fn unclosed(ref self, t: Tok) -> bool:
        if not (t == Tok.RParen or t == Tok.RBracket or t == Tok.RBrace) or self.pos == 0:
            return false
        let prev = self.toks[self.pos - 1]
        let cur = self.toks[self.pos]
        if not self.at(Tok.Eof) and "\n" not in self.src(prev.hi, cur.lo):
            return false
        var depth = 0
        var i = self.pos - 1
        while i >= 0:
            match self.toks[i].tok:
                case Tok.RParen | Tok.RBracket | Tok.RBrace:
                    depth += 1
                case Tok.LParen | Tok.LBracket | Tok.LBrace:
                    if depth == 0:
                        break
                    depth -= 1
                case _:
                    pass
            i -= 1
        if i < 0:
            return false
        let op = self.toks[i]
        let open = punct_str(op.tok)
        let close = punct_str(t)
        let osp = Span(file=self.file, lo=op.lo, hi=op.hi)
        let at = Span(file=self.file, lo=prev.hi, hi=prev.hi)
        let d = diag.error("E0110", f"this `{open}` is never closed").label(osp, "opened here")
        self.diags.push(
            d.label(self.span(), f"expected `{close}` before this")
            .with_help(f"add `{close}` where the expression ends")
            .fix(at, close, f"add `{close}`")
        )
        return true

    fn expect(ref self, t: Tok, what: str) -> Result[Span, ()]:
        if self.at(t):
            return Ok(self.bump())
        if self.unclosed(t) or self.foreign(false):
            return Err(())
        let found = describe(self.peek())
        var d = self.error_here("E0110", f"expected {what}, found {found}", f"expected {what}")
        if t == Tok.Colon and self.at(Tok.Newline):
            let s = self.prev_span()
            d = d.with_help(
                "blocks start with `:` at the end of the line"
            ).fix(Span(file=s.file, lo=s.hi, hi=s.hi), ":", "add `:`")
        elif t == Tok.Colon and self.at(Tok.LBrace):
            d = diag.error(
                "E0106",
                "brine uses indentation for blocks, not braces"
            ).label(self.span(), "unexpected brace")
            d = d.with_help("end the line with `:` and indent the block by 4 spaces")
            d = self.unbrace(d)
        self.diags.push(d)
        return Err(())

    # At a block's `{`: the fix that makes it `:` and drops its `}`, when the
    # `}` is alone at the end of its line (not `} else {`).
    fn unbrace(self, d: Diag) -> Diag:
        var depth = 0
        var k = self.pos
        while k < len(self.toks):
            match self.toks[k].tok:
                case Tok.LBrace:
                    depth += 1
                case Tok.RBrace:
                    depth -= 1
                case _:
                    pass
            if depth == 0:
                break
            k += 1
        if k >= len(self.toks) - 1 or k <= self.pos + 1:
            return d
        let next = self.toks[k + 1].tok
        if not (is_layout(next) or next == Tok.Eof):
            return d
        let before = self.toks[k - 1]
        if "\n" not in self.src(before.hi, self.toks[k].lo):
            return d
        let lb = self.span()
        let prev = self.prev_span()
        return d.fix(
            Span(file=lb.file, lo=prev.hi, hi=lb.hi),
            ":",
            "replace `{` with `:`"
        ).fix(Span(file=lb.file, lo=before.hi, hi=self.toks[k].hi), "", "remove the `}`")

    # A field name: any keyword works too after `.` (`any_kw`) or before `:`
    # in a field declaration, e.g. `requires: [Expr]` and `f.requires`.
    fn field_name(ref self, what: str, any_kw: bool) -> Result[(str, Span), ()]:
        match self.peek():
            case Tok.Keyword(k) if any_kw or self.peek_at(1) == Tok.Colon:
                return Ok((kw_name(k), self.bump()))
            case _:
                return self.expect_ident(what)

    fn expect_ident(ref self, what: str) -> Result[(str, Span), ()]:
        match self.peek():
            case Tok.Ident(s):
                return Ok((s, self.bump()))
            case Tok.Keyword(k):
                let kw = kw_name(k)
                let d = self.error_here(
                    "E0110",
                    f"expected {what}, found keyword `{kw}`",
                    "keywords can't be used as names"
                )
                self.diags.push(
                    d.with_help(f"`{kw}` is a keyword in brine; pick another name, such as `{kw}_`")
                )
                return Err(())
            case t:
                if self.foreign(false):
                    return Err(())
                self.report("E0110", f"expected {what}, found {describe(t)}", f"expected {what}")
                return Err(())

    fn skip_newlines(ref self):
        while self.at(Tok.Newline):
            self.bump()

    # Skip to the end of the current line (and any nested block).
    fn sync_line(ref self):
        var depth = 0
        while true:
            match self.peek():
                case Tok.Eof:
                    return
                case Tok.Newline if depth == 0:
                    self.bump()
                    if self.at(Tok.Indent):
                        depth += 1
                        self.bump()
                        continue
                    return
                case Tok.Indent:
                    depth += 1
                    self.bump()
                case Tok.Dedent:
                    if depth == 0:
                        return
                    depth -= 1
                    self.bump()
                    if depth == 0:
                        return
                case _:
                    self.bump()

    fn end_stmt(ref self) -> Result[(), ()]:
        match self.peek():
            case Tok.Newline:
                self.bump()
                return Ok(())
            case Tok.Dedent | Tok.Eof:
                return Ok(())
            case t:
                if self.foreign(false) or self.foreign_word():
                    return Err(())
                let d = self.error_here(
                    "E0110",
                    f"expected end of line, found {describe(t)}",
                    "unexpected here"
                )
                self.diags.push(
                    d.with_help(
                        "a statement ends at the end of its line; look for a missing operator, `,` or bracket before this"
                    )
                )
                return Err(())

    # ------------------------------------------------------------ items
    fn module(ref self, name: str) -> Module:
        var m = Module(
            name=name,
            file=self.file,
            imports=[],
            fns=[],
            structs=[],
            enums=[],
            consts=[],
            tests=[]
        )
        self.skip_newlines()
        while not self.at(Tok.Eof):
            if self.item(ref m).is_err():
                self.sync_line()
            self.skip_newlines()
            while self.at(Tok.Dedent):
                self.bump()
                self.skip_newlines()
        return m

    fn item(ref self, ref m: Module) -> Result[(), ()]:
        match self.peek():
            case Tok.Keyword(Kw.Fn):
                m.fns.push(self.fn_decl(None)?)
            case Tok.Keyword(Kw.Struct):
                self.struct_decl(ref m)?
            case Tok.Keyword(Kw.Enum):
                self.enum_decl(ref m)?
            case Tok.Keyword(Kw.Const):
                m.consts.push(self.const_decl()?)
            case Tok.Keyword(Kw.Import):
                m.imports.push(self.import_decl()?)
            # `test` is only a keyword here, at the start of a top-level line
            case Tok.Ident(s) if s == "test":
                m.tests.push(self.test_decl()?)
            # so is `rule`, before its name
            case Tok.Ident(s) if s == "rule" and is_str(self.peek_at(1)):
                m.tests.push(self.rule_decl()?)
            case Tok.Keyword(Kw.Extern):
                m.fns.push(self.extern_decl()?)
            case Tok.Indent:
                self.report(
                    "E0103",
                    "unexpected indentation",
                    "this line is indented but isn't inside a block"
                )
                return Err(())
            # `def f(...)`, `function f(...)` and typos like `fucntion f(...)`: a
            # function with another keyword; report it and read the function
            case Tok.Ident(s) if is_ident(self.peek_at(1)) and (
                self.peek_at(2) == Tok.LParen
                or self.peek_at(2) == Tok.Lt
                or self.peek_at(2) == Tok.LBracket
            ):
                let sp = self.span()
                let other = s in ["def", "function", "func", "fun", "proc", "sub"]
                let code = "E0115" if other else "E0110"
                let msg = (
                    "brine uses `fn` to define functions" if other else f"`{s}` isn't a keyword"
                )
                self.diags.push(
                    diag.error(code, msg).label(sp, "use `fn` here").with_help(
                        "a function is written `fn name(x: int) -> int:` with its body indented below"
                    ).fix(sp, "fn", f"replace `{s}` with `fn`")
                )
                m.fns.push(self.fn_decl(None)?)
            case Tok.Ident(s) if s == "class":
                let sp = self.span()
                self.diags.push(
                    diag.error("E0115", "brine uses `struct` to define types")
                    .label(sp, "use `struct` here")
                    .fix(sp, "struct", "replace `class` with `struct`")
                    .with_help(
                        "list the fields as `x: int` lines; a value is built with `Point(x=1, y=2)` (no `__init__`), and methods take `self` first"
                    )
                )
                return Err(())
            case Tok.Ident(s) if s in ["pub", "export", "public", "private", "static"]:
                let sp = self.span()
                let next = self.toks[self.pos + 1]
                self.diags.push(
                    diag.error("E0115", f"brine has no `{s}`")
                    .label(sp, "not needed")
                    .with_help(
                        "every top-level item is visible to the modules that import this file"
                    )
                    .fix(Span(file=sp.file, lo=sp.lo, hi=next.lo), "", f"remove `{s}`")
                )
                self.bump()
                return self.item(ref m)
            case Tok.Ident(s) if s == "impl":
                let sp = self.span()
                self.push_foreign(
                    sp,
                    "brine has no `impl` blocks",
                    "`impl`",
                    "write the methods inside the `struct` (or `enum`) itself, indented under its fields, with `self` as the first parameter: `fn area(self) -> float:`"
                )
                return Err(())
            case Tok.Ident(s) if s in ["trait", "interface", "protocol"]:
                let sp = self.span()
                self.push_foreign(
                    sp,
                    "brine has no traits or interfaces",
                    f"`{s}`",
                    "for a value that is one of several kinds, use an `enum` with a variant per kind and `match` on it; for code that works on many types, a generic function `fn f[T](x: T)`"
                )
                return Err(())
            case Tok.Keyword(Kw.Var) | Tok.Keyword(Kw.Let):
                let sp = self.span()
                self.push_foreign(
                    sp,
                    "brine has no global variables",
                    "outside any function",
                    "use `const NAME = value` for a value that never changes; for one that does, create it in `main` and pass it with `ref` to the functions that change it"
                )
                return Err(())
            case Tok.Ident(s) if s == "from":
                m.imports.push(self.from_import()?)
            # `async def f(...)`: report `async`, then read the function
            case Tok.Ident(s) if s == "async":
                let sp = self.span()
                let next = self.toks[self.pos + 1]
                var d = diag.error("E0115", "brine has no `async` or `await`").label(sp, "`async`")
                d = d.with_help(async_help())
                if is_ident(next.tok) or next.tok == Tok.Keyword(Kw.Fn):
                    d = d.fix(Span(file=sp.file, lo=sp.lo, hi=next.lo), "", "remove `async`")
                    self.diags.push(d)
                    self.bump()
                    return self.item(ref m)
                self.diags.push(d)
                return Err(())
            # Go's `type Point struct {` and TypeScript's `type T = ...`
            case Tok.Ident(s) if s == "type" and is_ident(self.peek_at(1)):
                let sp = self.span()
                var name = "Point"
                match self.peek_at(1):
                    case Tok.Ident(n):
                        name = n
                    case _:
                        pass
                self.push_foreign(
                    sp,
                    "brine defines types with `struct` and `enum`",
                    "`type`",
                    f"write `struct {name}:` with one `field: type` line per field indented below (`x: int`), and the methods after them"
                )
                return Err(())
            # Go's `func (p Point) area() float {`: a method outside its type
            case Tok.Ident(s) if s == "func" and self.peek_at(1) == Tok.LParen:
                let sp = self.span()
                var ty = "Point"
                var i = self.pos + 2
                while i < len(self.toks) and self.toks[i].tok != Tok.RParen:
                    match self.toks[i].tok:
                        case Tok.Ident(n):
                            ty = n
                        case _:
                            pass
                    i += 1
                self.push_foreign(
                    sp,
                    "brine writes methods inside their struct",
                    "a Go method",
                    f"indent the method under `struct {ty}:`, after its fields, with `self` as the first parameter: `fn area(self) -> float:`"
                )
                return Err(())
            # Python's `if __name__ == "__main__":`
            case Tok.Keyword(Kw.If) if self.peek_at(1) == Tok.Ident("__name__"):
                self.push_foreign(
                    self.span(),
                    "brine has no `__name__`",
                    "not needed",
                    "a program starts at `fn main():`; call your code from there, and remove this `if`"
                )
                return Err(())
            # Go's `package main`, Rust's `use std::...`
            case Tok.Ident(s) if (s == "package" or s == "use") and is_ident(self.peek_at(1)):
                let sp = self.span()
                if s == "package":
                    self.diags.push(
                        diag.error("E0115", "brine has no `package` line")
                        .label(sp, "not needed")
                        .with_help("a file is a module named after the file; nothing declares it")
                        .fix(
                            Span(file=sp.file, lo=sp.lo, hi=self.toks[self.line_end()].lo),
                            "",
                            "remove the line"
                        )
                    )
                else:
                    self.push_foreign(
                        sp,
                        "brine imports with `import` or `from`",
                        "`use`",
                        "write `import geometry` (the file geometry.br) or `from geometry import area`; the standard library needs no import"
                    )
                return Err(())
            case t:
                let d = self.error_here(
                    "E0110",
                    f"expected a top-level item, found {describe(t)}",
                    "expected `fn`, `struct`, `enum`, `const`, `import` or `test`"
                )
                self.diags.push(
                    d.with_help(
                        "statements must be inside a function; put program code inside `fn main():`"
                    )
                )
                return Err(())
        return Ok(())

    fn module_path(ref self) -> Result[[str], ()]:
        # each leading `..` is one directory up from the main file's
        var path: [str] = []
        while self.eat(Tok.DotDot):
            path.push("..")
        let (first, _) = self.expect_ident("module name")?
        path.push(first)
        while self.eat(Tok.Dot):
            let (n, _) = self.expect_ident("module name")?
            path.push(n)
        return Ok(path)

    fn import_decl(ref self) -> Result[Import, ()]:
        let start = self.bump()
        var path = self.module_path()?
        if self.at(Tok.Slash):
            # `import util/strings`: a file path; brine writes `util.strings`
            var d = diag.error("E0110", "module paths use `.`, not `/`").label(self.span(), "`/`")
            while self.at(Tok.Slash) and is_ident(self.peek_at(1)):
                d = d.fix(self.span(), ".", "replace `/` with `.`")
                self.bump()
                let (n, _) = self.expect_ident("module name")?
                path.push(n)
            self.diags.push(d.with_help("`import util.strings` loads util/strings.br"))
        var alias = path[len(path) - 1]
        if self.eat_kw(Kw.As):
            let (a, _) = self.expect_ident("alias")?
            alias = a
        let span = start.to(self.prev_span())
        self.end_stmt()?
        return Ok(Import(path=path, alias=alias, names=[], span=span))

    # `from a.b import x, y` (`from` is only special at the start of a top-level line)
    fn from_import(ref self) -> Result[Import, ()]:
        let start = self.bump()
        let path = self.module_path()?
        if not self.eat_kw(Kw.Import):
            let d = self.error_here(
                "E0110",
                "expected `import` after the module name",
                "expected `import`"
            )
            self.diags.push(d.with_help("write `from module import name1, name2`"))
            return Err(())
        if self.at(Tok.Star):
            let mod = ".".join(path)
            self.push_foreign(
                self.span(),
                "brine can't import every name at once",
                "`*`",
                f"name the ones you use: `from {mod} import area, Point`, or write `import {mod}` and use `{mod}.area`"
            )
            return Err(())
        var names = [self.expect_ident("a name to import")?]
        while self.eat(Tok.Comma):
            names.push(self.expect_ident("a name to import")?)
        let span = start.to(self.prev_span())
        self.end_stmt()?
        return Ok(Import(path=path, alias="", names=names, span=span))

    fn const_decl(ref self) -> Result[ConstDecl, ()]:
        let start = self.bump()
        if self.at_kw(Kw.Fn):
            self.diags.push(
                diag.error("E0115", "brine has no `const fn`").label(start, "`const`").with_help(
                    "write a plain `fn`; a `const` can only use literals, arithmetic and other constants"
                ).fix(Span(file=start.file, lo=start.lo, hi=self.span().lo), "", "remove `const`")
            )
            return Err(())
        let (name, _) = self.expect_ident("constant name")?
        var ty: Option[TypeExpr] = None
        if self.eat(Tok.Colon):
            ty = Some(self.type_expr()?)
        self.expect(Tok.Assign, "`=`")?
        let value = self.expr()?
        let span = start.to(self.prev_span())
        self.end_stmt()?
        return Ok(ConstDecl(name=name, span=span, ty=ty, value=value))

    # one line of a struct body: `name: type`, `invariant e`, a method or `pass`
    fn struct_member(
        ref self,
        owner: str,
        ref fields: [FieldDecl],
        ref invariants: [Expr],
        ref m: Module
    ) -> Result[(), ()]:
        match self.peek():
            case Tok.Keyword(Kw.Fn):
                m.fns.push(self.fn_decl(Some(owner))?)
            # `invariant: int` is a field
            case Tok.Keyword(Kw.Invariant) if self.peek_at(1) != Tok.Colon:
                self.bump()
                invariants.push(self.expr()?)
                self.end_stmt()?
            case Tok.Keyword(Kw.Pass):
                self.bump()
                self.end_stmt()?
            case Tok.Newline:
                self.bump()
            case _:
                let (fname, fspan) = self.field_name("field name", false)?
                self.expect(Tok.Colon, "`:` and a type")?
                let ty = self.type_expr()?
                fields.push(FieldDecl(name=fname, span=fspan, ty=ty))
                self.end_stmt()?
        return Ok(())

    fn struct_decl(ref self, ref m: Module) -> Result[(), ()]:
        let start = self.bump()
        let (name, _) = self.expect_ident("struct name")?
        let tparams = self.tparams()?
        self.expect(Tok.Colon, "`:`")?
        self.expect(Tok.Newline, "a new line after `:`")?
        if not self.eat(Tok.Indent):
            self.report(
                "E0110",
                "expected an indented list of fields",
                "struct body must be indented"
            )
            return Err(())
        var fields: [FieldDecl] = []
        var invariants: [Expr] = []
        while not self.at(Tok.Dedent) and not self.at(Tok.Eof):
            if self.struct_member(name, ref fields, ref invariants, ref m).is_err():
                self.sync_line()
        self.eat(Tok.Dedent)
        if len(tparams) > 0 and len(invariants) > 0:
            self.diags.push(
                diag.error("E0112", "generic structs can't have an `invariant` yet")
                .label(invariants[0].span, "invariant of a generic struct")
                .with_help(
                    "state the fact in the `requires` and `ensures` of the functions that use it"
                )
            )
        m.structs.push(
            StructDecl(name=name, span=start, tparams=tparams, fields=fields, invariants=invariants)
        )
        return Ok(())

    # one line of an enum body: a variant (`Circle(radius: float)` or `Empty`), a method or `pass`
    fn enum_member(
        ref self,
        owner: str,
        ref variants: [VariantDecl],
        ref m: Module
    ) -> Result[(), ()]:
        match self.peek():
            case Tok.Keyword(Kw.Fn):
                m.fns.push(self.fn_decl(Some(owner))?)
            case Tok.Keyword(Kw.Pass):
                self.bump()
                self.end_stmt()?
            case Tok.Newline:
                self.bump()
            case _:
                let (vname, vspan) = self.expect_ident("variant name")?
                var fields: [FieldDecl] = []
                if self.eat(Tok.LParen):
                    while not self.at(Tok.RParen):
                        let (fname, fspan) = self.field_name("field name", false)?
                        if not self.at(Tok.Colon):
                            let d = self.error_here(
                                "E0110",
                                f"variant field `{fname}` needs a type",
                                "expected `: type`"
                            )
                            self.diags.push(
                                d.with_help(f"write `{vname}({fname}: int)` (or another type)")
                            )
                            return Err(())
                        self.bump()
                        let ty = self.type_expr()?
                        fields.push(FieldDecl(name=fname, span=fspan, ty=ty))
                        if not self.eat(Tok.Comma):
                            break
                    self.expect(Tok.RParen, "`)`")?
                variants.push(VariantDecl(name=vname, span=vspan, fields=fields))
                self.end_stmt()?
        return Ok(())

    fn enum_decl(ref self, ref m: Module) -> Result[(), ()]:
        let start = self.bump()
        let (name, _) = self.expect_ident("enum name")?
        let tparams = self.tparams()?
        self.expect(Tok.Colon, "`:`")?
        self.expect(Tok.Newline, "a new line after `:`")?
        if not self.eat(Tok.Indent):
            let d = self.error_here(
                "E0110",
                "expected an indented list of variants",
                "enum body must be indented"
            )
            self.diags.push(
                d.with_help("list one variant per line, e.g. `Circle(radius: float)` or `Empty`")
            )
            return Err(())
        var variants: [VariantDecl] = []
        while not self.at(Tok.Dedent) and not self.at(Tok.Eof):
            if self.enum_member(name, ref variants, ref m).is_err():
                self.sync_line()
        self.eat(Tok.Dedent)
        m.enums.push(EnumDecl(name=name, span=start, tparams=tparams, variants=variants))
        return Ok(())

    fn params(ref self, method: bool) -> Result[[Param], ()]:
        self.expect(Tok.LParen, "`(`")?
        var ps: [Param] = []
        while not self.at(Tok.RParen):
            let mut_span = self.span()
            let by_ref = self.eat_kw(Kw.Ref)
            let mutable = not by_ref and self.eat_kw(Kw.Mut)
            if self.at(Tok.Star):
                self.push_foreign(
                    self.span(),
                    "brine has no `*args`",
                    "`*`",
                    "take an array instead, `args: [int]`, and call with `log(\"msg\", [1, 2, 3])`"
                )
                return Err(())
            if self.at(Tok.Amp) and not by_ref and not mutable:
                # Rust's `&self`, `&mut self`, `x: &T`'s cousin `&x`
                let sp = self.span()
                var e = self.toks[self.pos + 1].lo
                if self.peek_at(1) == Tok.Keyword(Kw.Mut):
                    e = self.toks[self.pos + 2].lo
                let is_self = (
                    self.peek_at(1) == Tok.Ident("self") or self.peek_at(2) == Tok.Ident("self")
                )
                let help = (
                    "a method that changes its receiver takes `ref self`; one that only reads it takes `self`"
                    if is_self
                    else "a parameter the function changes is declared `ref name: type`; otherwise just `name: type`"
                )
                let to = "ref " if self.peek_at(1) == Tok.Keyword(Kw.Mut) or not is_self else ""
                self.diags.push(
                    diag.error("E0115", "brine passes references with `ref`, not `&`")
                    .label(sp, "`&`")
                    .with_help(help)
                    .fix(
                        Span(file=sp.file, lo=sp.lo, hi=e),
                        to,
                        "use `ref`" if to != "" else "remove `&`"
                    )
                )
                # read on, so the rest of the function is checked too
                self.bump()
                self.eat_kw(Kw.Mut)
            let (name, span) = self.expect_ident("parameter name")?
            if mutable and name == "self":
                let d = diag.error(
                    "E0402",
                    "use `ref self` for a method that changes its receiver"
                ).label(mut_span.to(span), "`mut self` would only change a copy")
                self.diags.push(d.fix(mut_span, "ref", "replace with `ref`"))
            var ty: Option[TypeExpr] = None
            if not (name == "self" and len(ps) == 0 and method):
                if not self.at(Tok.Colon):
                    let d = self.error_here(
                        "E0110",
                        f"parameter `{name}` needs a type",
                        "expected `: type`"
                    )
                    self.diags.push(d.with_help(f"write `{name}: int` (or another type)"))
                    return Err(())
                self.bump()
                var is_ref = by_ref
                if self.at(Tok.Amp):
                    # `xs: &mut [int]`: brine writes `ref xs: [int]`
                    let amp = self.span()
                    self.bump()
                    self.eat_kw(Kw.Mut)
                    let d = diag.error(
                        "E0115",
                        "brine passes references with `ref`, not `&`"
                    ).label(amp, "`&`")
                    var d2 = d.with_help(
                        f"declare the parameter `ref {name}: ...`, and call with `ref`: `f(ref x)`"
                    )
                    if not by_ref:
                        d2 = d2.fix(
                            Span(file=span.file, lo=span.lo, hi=span.lo),
                            "ref ",
                            "add `ref`"
                        )
                    self.diags.push(
                        d2.fix(Span(file=amp.file, lo=amp.lo, hi=self.span().lo), "", "remove `&`")
                    )
                    is_ref = true
                ty = Some(self.type_expr()?)
                if self.at(Tok.Assign):
                    self.push_foreign(
                        self.span(),
                        "brine has no default parameter values",
                        "a default value",
                        "pass every argument at every call, or write a second function that calls this one with the default"
                    )
                    return Err(())
                ps.push(Param(name=name, span=span, ty=ty, by_ref=is_ref, mutable=mutable))
                if not self.eat(Tok.Comma):
                    break
                continue
            ps.push(Param(name=name, span=span, ty=ty, by_ref=by_ref, mutable=mutable))
            if not self.eat(Tok.Comma):
                break
        self.expect(Tok.RParen, "`)`")?
        return Ok(ps)

    fn ret_type(ref self) -> Result[Option[TypeExpr], ()]:
        if self.eat(Tok.Arrow):
            return Ok(Some(self.type_expr()?))
        return Ok(None)

    fn fn_decl(ref self, method_of: Option[str]) -> Result[FnDecl, ()]:
        let start = self.bump()
        let (name, name_span) = self.expect_ident("function name")?
        var tparams: [(str, Span)] = []
        if self.at(Tok.Lt):
            tparams = self.angle_brackets("type parameters", "fn first[T](xs: [T]) -> T")?
        else:
            tparams = self.tparams()?
        let params = self.params(method_of.is_some())?
        let ret = self.ret_type()?
        let sig_span = start.to(self.prev_span())
        self.expect(Tok.Colon, "`:`")?
        let (body, contracts) = self.block([ContractKind.Requires, ContractKind.Ensures])?
        var pre: [Expr] = []
        var post: [Expr] = []
        for k, e in contracts:
            if k == ContractKind.Requires:
                pre.push(e)
            else:
                post.push(e)
        return Ok(
            FnDecl(
                name=name,
                name_span=name_span,
                params=params,
                ret=ret,
                requires=pre,
                ensures=post,
                body=body,
                span=sig_span,
                is_extern=false,
                method_of=method_of,
                tparams=tparams,
                test_name=None,
                rule=None,
                id=0,
                locals=[],
                param_locals=[],
                result_local=None
            )
        )

    fn extern_decl(ref self) -> Result[FnDecl, ()]:
        let start = self.bump()
        if not self.at_kw(Kw.Fn):
            self.report("E0110", "expected `fn` after `extern`", "expected `fn`")
            return Err(())
        self.bump()
        let (name, name_span) = self.expect_ident("function name")?
        let params = self.params(false)?
        let ret = self.ret_type()?
        let span = start.to(self.prev_span())
        self.end_stmt()?
        return Ok(
            FnDecl(
                name=name,
                name_span=name_span,
                params=params,
                ret=ret,
                requires=[],
                ensures=[],
                body=empty_block(),
                span=span,
                is_extern=true,
                method_of=None,
                tparams=[],
                test_name=None,
                rule=None,
                id=0,
                locals=[],
                param_locals=[],
                result_local=None
            )
        )

    fn test_decl(ref self) -> Result[FnDecl, ()]:
        let start = self.bump()
        var name = ""
        match self.peek():
            case Tok.Str(s):
                self.bump()
                name = s
            case _:
                self.report("E0110", "expected a test name string", "e.g. test \"adds numbers\":")
                return Err(())
        let span = start.to(self.prev_span())
        self.expect(Tok.Colon, "`:`")?
        let (body, _) = self.block([])?
        return Ok(
            FnDecl(
                name="test_0",
                name_span=span,
                params=[],
                ret=None,
                requires=[],
                ensures=[],
                body=body,
                span=span,
                is_extern=false,
                method_of=None,
                tparams=[],
                test_name=Some(name),
                rule=None,
                id=0,
                locals=[],
                param_locals=[],
                result_local=None
            )
        )

    # `rule "name" for x: T, y: U:` and a body like a test's, which may also say
    # `effects m: none` and `proven m.f`. The inputs are the parameters.
    fn rule_decl(ref self) -> Result[FnDecl, ()]:
        let start = self.bump()
        var name = ""
        match self.peek():
            case Tok.Str(s):
                self.bump()
                name = s
            case _:
                pass
        var params: [Param] = []
        if self.eat_kw(Kw.For):
            while true:
                let (pn, ps) = self.expect_ident("the name of an input")?
                if not self.at(Tok.Colon):
                    let d = self.error_here(
                        "E0110",
                        f"rule input `{pn}` needs a type",
                        "expected `: type`"
                    )
                    self.diags.push(d.with_help(f"write `for {pn}: int:` (or another type)"))
                    return Err(())
                self.bump()
                let ty = self.type_expr()?
                params.push(Param(name=pn, span=ps, ty=Some(ty), by_ref=false, mutable=false))
                if not self.eat(Tok.Comma):
                    break
        let span = start.to(self.prev_span())
        self.expect(Tok.Colon, "`:`")?
        if not self.at(Tok.Newline):
            self.report("E0110", "a rule's body goes on the lines below it", "expected a new line")
            return Err(())
        self.bump()
        if not self.eat(Tok.Indent):
            let d = self.error_here(
                "E0103",
                "expected an indented block",
                "this should be indented"
            )
            self.diags.push(d.with_help("indent the body of the rule by 4 spaces"))
            return Err(())
        var stmts: [Stmt] = []
        var effects: [EffectsLine] = []
        var proven: [([str], Span)] = []
        while not self.at(Tok.Dedent) and not self.at(Tok.Eof):
            # `effects m: ...` and `proven m.f`: a name and then another name
            let line = self.peek()
            let two_names = is_ident(self.peek_at(1))
            if line == Tok.Ident("effects") and two_names:
                match self.effects_line():
                    case Ok(e):
                        effects.push(e)
                    case Err(_):
                        self.sync_line()
            elif line == Tok.Ident("proven") and two_names:
                let ls = self.bump()
                match self.module_path():
                    case Ok(path):
                        proven.push((path, ls.to(self.prev_span())))
                        if self.end_stmt().is_err():
                            self.sync_line()
                    case Err(_):
                        self.sync_line()
            else:
                match self.stmt():
                    case Ok(st):
                        stmts.push(st)
                        self.take_pending(ref stmts)
                    case Err(_):
                        self.pending = []
                        self.sync_line()
            self.skip_newlines()
        let whole = start.to(self.prev_span())
        self.eat(Tok.Dedent)
        let (body, contracts) = self.split_contracts(
            stmts,
            Block(stmts=[], span=whole),
            [ContractKind.Requires]
        )
        return Ok(
            FnDecl(
                name="rule_0",
                name_span=span,
                params=params,
                ret=None,
                requires=[e for _, e in contracts],
                ensures=[],
                body=body,
                span=span,
                is_extern=false,
                method_of=None,
                tparams=[],
                test_name=Some(name),
                rule=Some(RuleInfo(name=name, effects=effects, proven=proven, whole=whole)),
                id=0,
                locals=[],
                param_locals=[],
                result_local=None
            )
        )

    # `effects m: none` or `effects m: files, console`
    fn effects_line(ref self) -> Result[EffectsLine, ()]:
        let start = self.bump()
        let path = self.module_path()?
        self.expect(Tok.Colon, "`:` and what the module may do (`none`, or e.g. `files, console`)")?
        var allowed: [str] = []
        while true:
            let (w, _) = self.expect_ident("an effect (`none`, `files`, `console`, ...)")?
            allowed.push(w)
            if not self.eat(Tok.Comma):
                break
        let span = start.to(self.prev_span())
        self.end_stmt()?
        return Ok(EffectsLine(module=path, allowed=allowed, span=span))

    # ------------------------------------------------------------ types
    # Optional type parameters: `[T, U]`.
    fn tparams(ref self) -> Result[[(str, Span)], ()]:
        var ps: [(str, Span)] = []
        if not self.eat(Tok.LBracket):
            return Ok(ps)
        while true:
            let (n, sp) = self.expect_ident("type parameter name")?
            for p, _ in ps:
                if p == n:
                    self.diags.push(
                        diag.error(
                            "E0202",
                            f"type parameter `{n}` is declared twice"
                        ).label(sp, "duplicate")
                    )
                    break
            ps.push((n, sp))
            if not self.eat(Tok.Comma):
                break
            if self.at(Tok.RBracket):
                break
        self.expect(Tok.RBracket, "`]`")?
        return Ok(ps)

    # `<T>` after a function name: report that brine writes `[T]`, and skip it
    fn angle_brackets(ref self, what: str, example: str) -> Result[[(str, Span)], ()]:
        let lt = self.span()
        var i = self.pos + 1
        var names: [(str, Span)] = []
        while i < len(self.toks):
            match self.toks[i].tok:
                case Tok.Ident(n):
                    names.push((n, Span(file=self.file, lo=self.toks[i].lo, hi=self.toks[i].hi)))
                case Tok.Comma:
                    pass
                case _:
                    break
            i += 1
        var d = diag.error("E0115", f"brine writes {what} in `[...]`, not `<...>`").label(lt, "`<`")
        d = d.with_help(f"for example `{example}`")
        if i < len(self.toks) and self.toks[i].tok == Tok.Gt:
            let gt = self.toks[i]
            d = d.fix(
                lt,
                "[",
                "replace `<` with `[`"
            ).fix(Span(file=lt.file, lo=gt.lo, hi=gt.hi), "]", "replace `>` with `]`")
            self.diags.push(d)
            self.pos = i + 1
            return Ok(names)
        self.diags.push(d)
        return Err(())

    # `Vec<int>`, `HashMap<str, int>`, `Option<T>` in a type: report what brine
    # writes, then read the arguments so the rest of the line still parses
    fn angle_type(ref self, path: [str], start: Span) -> Result[TypeExpr, ()]:
        let name = path[len(path) - 1]
        let lt = self.span()
        self.bump()
        var args: [TypeExpr] = []
        var commas: [Span] = []
        while true:
            args.push(self.type_expr()?)
            if not self.at(Tok.Comma):
                break
            commas.push(self.bump())
        if not self.at(Tok.Gt):
            self.report(
                "E0115",
                f"brine writes type arguments in `[...]`, not `<...>`",
                "expected `>`"
            )
            return Err(())
        let gt = self.bump()
        let span = start.to(gt)
        let head = Span(file=start.file, lo=start.lo, hi=lt.hi)
        let is_array = name in ["Vec", "List", "Array", "ArrayList", "Slice", "list"]
        let is_map = name in ["HashMap", "Map", "Dict", "BTreeMap", "dict", "Record"]
        var d = diag.error(
            "E0115",
            f"brine writes type arguments in `[...]`, not `<...>`"
        ).label(lt, "`<`")
        if is_array and len(args) == 1:
            d = (
                d.with_help("an array of ints is `[int]`")
                .fix(head, "[", "write `[...]`")
                .fix(gt, "]", "write `[...]`")
            )
            self.diags.push(d)
            return Ok(TypeExpr.Array(args[0], span))
        if is_map and len(args) == 2:
            d = d.with_help(
                "a map from `str` to `int` is `{str: int}`"
            ).fix(head, "{", "write `{K: V}`")
            d = d.fix(commas[0], ":", "write `{K: V}`").fix(gt, "}", "write `{K: V}`")
            self.diags.push(d)
            return Ok(TypeExpr.Map(args[0], args[1], span))
        d = (
            d.with_help(f"write `{name}[...]`, like `Option[int]`")
            .fix(lt, "[", "replace `<` with `[`")
            .fix(gt, "]", "replace `>` with `]`")
        )
        self.diags.push(d)
        return Ok(TypeExpr.Named(path, args, span))

    fn type_expr(ref self) -> Result[TypeExpr, ()]:
        let start = self.span()
        match self.peek():
            case Tok.LBracket:
                self.bump()
                let elem = self.type_expr()?
                self.expect(Tok.RBracket, "`]`")?
                return Ok(TypeExpr.Array(elem, start.to(self.prev_span())))
            case Tok.LBrace:
                self.bump()
                let key = self.type_expr()?
                self.expect(Tok.Colon, "`:` between the key and value types")?
                let val = self.type_expr()?
                self.expect(Tok.RBrace, "`}`")?
                return Ok(TypeExpr.Map(key, val, start.to(self.prev_span())))
            case Tok.LParen:
                self.bump()
                var elems: [TypeExpr] = []
                while not self.at(Tok.RParen):
                    elems.push(self.type_expr()?)
                    if not self.eat(Tok.Comma):
                        break
                self.expect(Tok.RParen, "`)`")?
                return Ok(TypeExpr.Tuple(elems, start.to(self.prev_span())))
            case Tok.Ident(_):
                let (first, _) = self.expect_ident("type")?
                var path = [first]
                while self.at(Tok.Dot):
                    self.bump()
                    let (n, _) = self.expect_ident("type name")?
                    path.push(n)
                var args: [TypeExpr] = []
                if self.at(Tok.Lt):
                    return self.angle_type(path, start)
                if self.eat(Tok.LBracket):
                    while true:
                        args.push(self.type_expr()?)
                        if not self.eat(Tok.Comma):
                            break
                        if self.at(Tok.RBracket):
                            break
                    self.expect(Tok.RBracket, "`]`")?
                return Ok(TypeExpr.Named(path, args, start.to(self.prev_span())))
            case Tok.Keyword(Kw.Ref):
                let returned = self.pos > 0 and self.toks[self.pos - 1].tok == Tok.Arrow
                let msg = (
                    "a function can't return a `ref`" if returned else "a `ref` can't be stored"
                )
                let d = self.error_here("E0110", msg, "`ref` here")
                let help = (
                    "return the value: copies are cheap (copy-on-write); to change the caller's variable, take it as a `ref` parameter instead"
                    if returned
                    else "references can't be kept in fields or arrays, so they never dangle: store the value itself (copies are cheap, copy-on-write), or pass the variable with `ref` to the functions that need it"
                )
                self.diags.push(
                    d.with_help(help).fix(
                        Span(file=start.file, lo=start.lo, hi=self.toks[self.pos + 1].lo),
                        "",
                        "remove `ref`"
                    )
                )
                # read the type itself, so the rest of the function is checked too
                self.bump()
                return self.type_expr()
            case Tok.Amp:
                self.push_foreign(
                    start,
                    "brine passes references with `ref`, not `&`",
                    "`&`",
                    "a parameter that changes the caller's variable is declared `ref name: type`"
                )
                return Err(())
            case t:
                self.report(
                    "E0110",
                    f"expected a type, found {describe(t)}",
                    "expected a type like `int`, `[float]` or `Point`"
                )
                return Err(())

    # ------------------------------------------------------------ blocks & statements

    # Parses `NEWLINE INDENT stmts DEDENT` (or a single simple statement on the
    # same line). Leading contract statements of the allowed kinds are returned
    # separately.
    fn block(ref self, allow: [ContractKind]) -> Result[(Block, [(ContractKind, Expr)]), ()]:
        let start = self.span()
        var stmts: [Stmt] = []
        if self.at(Tok.LBrace):
            # `if x > 0: {`: half-converted C or JavaScript
            self.diags.push(
                self.error_here(
                    "E0106",
                    "brine uses indentation for blocks, not braces",
                    "unexpected brace"
                ).with_help("remove the braces: the `:` ends the line and the block is indented by 4 spaces")
            )
            return Err(())
        if not self.at(Tok.Newline):
            # single-line block: `if x: return 1`
            stmts.push(self.simple_stmt()?)
            self.take_pending(ref stmts)
        else:
            self.bump()
            if not self.eat(Tok.Indent):
                let d = self.error_here(
                    "E0103",
                    "expected an indented block",
                    "this should be indented"
                )
                self.diags.push(
                    d.with_help(
                        "indent the body of the block by 4 spaces (use `pass` for an empty block)"
                    )
                )
                return Err(())
            while not self.at(Tok.Dedent) and not self.at(Tok.Eof):
                match self.stmt():
                    case Ok(s):
                        stmts.push(s)
                        self.take_pending(ref stmts)
                        self.after_try = false
                    case Err(_):
                        self.pending = []
                        self.sync_line()
                self.skip_newlines()
            self.eat(Tok.Dedent)
        let span = start.to(self.prev_span())
        return Ok(self.split_contracts(stmts, Block(stmts=[], span=span), allow))

    # The leading contract statements of the allowed kinds, taken out of `stmts`;
    # the rest go into `into`.
    fn split_contracts(
        ref self,
        stmts: [Stmt],
        into: Block,
        allow: [ContractKind]
    ) -> (Block, [(ContractKind, Expr)]):
        var contracts: [(ContractKind, Expr)] = []
        var leading = true
        var kept: [Stmt] = []
        for s in stmts:
            match s.kind:
                case StmtKind.Contract(k, e):
                    if leading and k in allow:
                        contracts.push((k, e))
                    else:
                        let where = (
                            "at the start of a `while` or `for` loop body, or in a `struct`"
                            if k == ContractKind.Invariant
                            else "at the start of a function body"
                        )
                        let d = diag.error(
                            "E0112",
                            f"`{k.keyword()}` is only allowed {where}"
                        ).label(s.span, "misplaced contract")
                        self.diags.push(
                            d.with_help(
                                "move it to the top of the body, before any other statement"
                            )
                        )
                case _:
                    leading = false
                    kept.push(s)
        return (Block(stmts=kept, span=into.span), contracts)

    fn stmt(ref self) -> Result[Stmt, ()]:
        let start = self.span()
        match self.peek():
            case Tok.Keyword(Kw.If):
                return self.if_stmt()
            case Tok.Keyword(Kw.While):
                self.bump()
                let cond = self.expr()?
                self.expect(Tok.Colon, "`:`")?
                let (body, invs) = self.block([ContractKind.Invariant])?
                return Ok(stmt(StmtKind.While(cond, [e for _, e in invs], body), start))
            case Tok.Keyword(Kw.For):
                return self.for_stmt(false)
            case Tok.Keyword(Kw.Match):
                return self.match_stmt()
            case Tok.Keyword(Kw.Par) if self.peek_at(1) == Tok.Keyword(Kw.For):
                self.bump()
                return self.for_stmt(true)
            case _:
                return self.simple_stmt()

    # `: type` after a loop variable, if written
    fn loop_var_type(ref self) -> Result[Option[TypeExpr], ()]:
        if self.eat(Tok.Colon):
            return Ok(Some(self.type_expr()?))
        return Ok(None)

    fn for_stmt(ref self, is_par: bool) -> Result[Stmt, ()]:
        let start = self.bump()
        # Go's `for i, v := range xs {`
        for k in self.pos..self.line_end():
            if self.toks[k].tok == Tok.LBrace or self.toks[k].tok == Tok.Keyword(Kw.In):
                break
            if (
                self.toks[k].tok == Tok.Colon
                and self.toks[k + 1].tok == Tok.Assign
                and self.glued(k - self.pos)
            ):
                var names: [str] = []
                for t in self.toks[self.pos:k]:
                    match t.tok:
                        case Tok.Ident(n):
                            names.push(n)
                        case _:
                            pass
                var xs = "xs"
                if self.toks[k + 2].tok == Tok.Ident("range"):
                    var e = k + 3
                    while e < self.line_end() and self.toks[e].tok != Tok.LBrace:
                        e += 1
                    if e > k + 3:
                        let t = self.src(self.toks[k + 3].lo, self.toks[e - 1].hi)
                        if t != "":
                            xs = t
                var write = f"for x in {xs}:"
                if len(names) == 2 and names[0] == "_":
                    write = f"for {names[1]} in {xs}:"
                elif len(names) == 2:
                    write = f"for {names[0]}, {names[1]} in enumerate({xs}):"
                elif len(names) == 1:
                    write = f"for {names[0]} in 0..len({xs}):"
                self.push_foreign(
                    Span(file=self.file, lo=self.toks[k].lo, hi=self.toks[k + 1].hi),
                    "brine's `for` loop is `for x in xs:`",
                    "`:=`",
                    f"write `{write}` and indent the body under it"
                )
                return Err(())
        let items = self.targets("loop variable", true)?
        let name_span = items[0].span().to(items[len(items) - 1].span())
        var name = ""
        var t: Option[TypeExpr] = None
        # `for k, v in m.items():` loops over a hidden variable and unpacks it first thing
        var lets: [Stmt] = []
        match items[0]:
            case Target.Name(n, _, nt) if len(items) == 1:
                name = n
                t = nt
            case _:
                name = f"for'{name_span.lo}"
                let tuple = self.tuple_items(items, name_span)?
                self.all_typed_or_none(tuple, name_span)?
                lets = unpack_lets(unpack_items(tuple, name, None), false)
        if not self.eat_kw(Kw.In):
            self.report("E0110", "expected `in` after the loop variable", "expected `in`")
            return Err(())
        let iter = self.expr()?
        self.expect(Tok.Colon, "`:`")?
        var (body, invs) = self.block([ContractKind.Invariant])?
        lets.extend(body.stmts)
        body.stmts = lets
        return Ok(
            stmt(
                StmtKind.For(name, name_span, t, iter, [e for _, e in invs], body, is_par),
                start.to(name_span)
            )
        )

    # `a`, `a, b`, `(a, b)` or `i, (a, b)`: what a loop or `let` assigns. Loop
    # variables can have types (`k: str, v: int`); a `let` has one for the whole.
    fn targets(ref self, what: str, typed: bool) -> Result[[Target], ()]:
        var items = [self.target(what, typed)?]
        while self.eat(Tok.Comma):
            items.push(self.target(what, typed)?)
        return Ok(items)

    fn target(ref self, what: str, typed: bool) -> Result[Target, ()]:
        if self.at(Tok.LParen):
            let lo = self.bump()
            var items: [Target] = []
            while not self.at(Tok.RParen):
                items.push(self.target(what, typed)?)
                if not self.eat(Tok.Comma):
                    break
            self.expect(Tok.RParen, "`)`")?
            return Ok(Target.Tuple(items, lo.to(self.prev_span())))
        let (n, sp) = self.expect_ident(what)?
        var t: Option[TypeExpr] = None
        if typed:
            t = self.loop_var_type()?
        return Ok(Target.Name(n, sp, t))

    # The names a loop unpacks each element into: `(a, b)` on its own is `a, b`.
    fn tuple_items(ref self, items: [Target], span: Span) -> Result[[Target], ()]:
        match items[0]:
            case Target.Tuple(inner, _) if len(items) == 1:
                if len(inner) == 0:
                    self.diags.push(
                        diag.error(
                            "E0110",
                            "expected loop variables in the `()`"
                        ).label(span, "nothing to unpack into")
                    )
                    return Err(())
                return Ok(inner)
            case _:
                return Ok(items)

    # `for k: str, v: int in ...`: all typed or none
    fn all_typed_or_none(ref self, items: [Target], span: Span) -> Result[(), ()]:
        var typed = 0
        var names = 0
        count_typed(items, ref typed, ref names)
        if typed > 0 and typed < names:
            self.diags.push(
                diag.error(
                    "E0110",
                    "give every loop variable a type, or none"
                ).label(span, "some of these have types and some don't")
            )
            return Err(())
        return Ok(())

    fn take_pending(ref self, ref stmts: [Stmt]):
        stmts.extend(self.pending)
        self.pending = []

    # `case` is only a keyword at the start of a line in a `match`
    fn at_case(self) -> bool:
        match self.peek():
            case Tok.Ident(s):
                return s == "case"
            case _:
                return false

    fn case_clause(ref self) -> Result[Case, ()]:
        if not self.at_case():
            # Rust's `0 => ...` and `_ => ...`
            for i in self.pos..self.line_end():
                if (
                    self.toks[i].tok == Tok.Assign
                    and self.toks[i + 1].tok == Tok.Gt
                    and i > self.pos
                ):
                    let arrow = Span(file=self.file, lo=self.toks[i].lo, hi=self.toks[i + 1].hi)
                    let pat = self.src(self.toks[self.pos].lo, self.toks[i - 1].hi)
                    var d = diag.error(
                        "E0115",
                        "brine writes a `match` arm as `case pattern:`"
                    ).label(arrow, "`=>`")
                    d = d.with_help(
                        f"write `case {pat}:` and the arm's code after the `:` or indented below"
                    )
                    if pat != "":
                        let here = self.span()
                        d = d.fix(
                            Span(file=here.file, lo=here.lo, hi=here.lo),
                            "case ",
                            "add `case`"
                        )
                        d = d.fix(
                            Span(file=here.file, lo=self.toks[i - 1].hi, hi=self.toks[i + 1].hi),
                            ":",
                            "replace `=>` with `:`"
                        )
                        let last = self.line_end() - 1
                        if last > i + 1 and self.toks[last].tok == Tok.Comma:
                            d = d.fix(
                                Span(file=here.file, lo=self.toks[last].lo, hi=self.toks[last].hi),
                                "",
                                "remove the `,`"
                            )
                    self.diags.push(d)
                    return Err(())
            self.report(
                "E0110",
                f"expected `case`, found {describe(self.peek())}",
                "expected `case pattern:`"
            )
            return Err(())
        let cstart = self.bump()
        let pat = self.pattern()?
        var guard: Option[Expr] = None
        if self.eat_kw(Kw.If):
            guard = Some(self.expr()?)
        let span = cstart.to(self.prev_span())
        self.expect(Tok.Colon, "`:`")?
        let (body, _) = self.block([])?
        return Ok(Case(pat=pat, guard=guard, body=body, span=span))

    fn match_stmt(ref self) -> Result[Stmt, ()]:
        let start = self.bump()
        let scrut = self.expr()?
        self.expect(Tok.Colon, "`:`")?
        self.expect(Tok.Newline, "a new line after `:`")?
        if not self.eat(Tok.Indent):
            let d = self.error_here(
                "E0103",
                "expected an indented list of `case`s",
                "this should be indented"
            )
            self.diags.push(d.with_help("write each case on its own line: `case pattern:`"))
            return Err(())
        var cases: [Case] = []
        let errors = len(self.diags)
        while not self.at(Tok.Dedent) and not self.at(Tok.Eof):
            if self.eat(Tok.Newline):
                continue
            match self.case_clause():
                case Ok(c):
                    cases.push(c)
                case Err(_):
                    self.sync_line()
            self.skip_newlines()
        self.eat(Tok.Dedent)
        if len(cases) == 0 and len(self.diags) == errors:
            self.diags.push(
                diag.error("E0110", "`match` needs at least one `case`").label(start, "no cases")
            )
        return Ok(stmt(StmtKind.Match(scrut, cases), start))

    fn pattern(ref self) -> Result[Pattern, ()]:
        let first = self.closed_pattern()?
        if not self.at(Tok.Pipe):
            return Ok(first)
        var alts = [first]
        while self.eat(Tok.Pipe):
            alts.push(self.closed_pattern()?)
        let span = alts[0].span.to(alts[len(alts) - 1].span)
        return Ok(pattern(PatKind.Or(alts), span))

    fn closed_pattern(ref self) -> Result[Pattern, ()]:
        let start = self.span()
        var kind = PatKind.Wild
        match self.peek():
            case Tok.Int(v):
                self.bump()
                kind = PatKind.Int(i128(v))
            case Tok.Minus if is_int(self.peek_at(1)):
                self.bump()
                match self.peek():
                    case Tok.Int(v):
                        kind = PatKind.Int(-i128(v))
                    case _:
                        pass
                self.bump()
            case Tok.Str(s):
                self.bump()
                kind = PatKind.Str(s)
            case Tok.Keyword(Kw.True):
                self.bump()
                kind = PatKind.Bool(true)
            case Tok.Keyword(Kw.False):
                self.bump()
                kind = PatKind.Bool(false)
            case Tok.Float(_):
                let d = self.error_here(
                    "E0110",
                    "floats can't be used as patterns",
                    "float pattern"
                )
                self.diags.push(
                    d.with_help(
                        "compare floats with `if`/`elif`, or bind the value and add a guard: `case x if x < 0.5:`"
                    )
                )
                return Err(())
            case Tok.LParen:
                self.bump()
                var elems: [Pattern] = []
                while not self.at(Tok.RParen):
                    elems.push(self.pattern()?)
                    if not self.eat(Tok.Comma):
                        break
                self.expect(Tok.RParen, "`)`")?
                if len(elems) == 1:
                    return Ok(pattern(elems[0].kind, start.to(self.prev_span())))
                kind = PatKind.Tuple(elems)
            case Tok.Ident(name):
                self.bump()
                if not self.at(Tok.Dot) and not self.at(Tok.LParen):
                    kind = PatKind.Wild if name == "_" else PatKind.Bind(name)
                else:
                    var path = [name]
                    while self.eat(Tok.Dot):
                        let (n, _) = self.expect_ident("variant name")?
                        path.push(n)
                    var args: Option[[(Option[(str, Span)], Pattern)]] = None
                    if self.eat(Tok.LParen):
                        var xs: [(Option[(str, Span)], Pattern)] = []
                        while not self.at(Tok.RParen):
                            var kw: Option[(str, Span)] = None
                            match (self.peek(), self.peek_at(1)):
                                case (Tok.Ident(n), Tok.Assign):
                                    let sp = self.bump()
                                    self.bump()
                                    kw = Some((n, sp))
                                case (Tok.Keyword(k), Tok.Assign):
                                    let sp = self.bump()
                                    self.bump()
                                    kw = Some((kw_name(k), sp))
                                case _:
                                    pass
                            let p = self.pattern()?
                            xs.push((kw, p))
                            if not self.eat(Tok.Comma):
                                break
                        self.expect(Tok.RParen, "`)`")?
                        args = Some(xs)
                    kind = PatKind.Variant(path, args)
            case t:
                let d = self.error_here(
                    "E0110",
                    f"expected a pattern, found {describe(t)}",
                    "expected a pattern"
                )
                self.diags.push(
                    d.with_help(
                        "patterns look like `_`, `name`, `0`, `\"text\"`, `Shape.Circle(r)` or `(a, b)`"
                    )
                )
                return Err(())
        return Ok(pattern(kind, start.to(self.prev_span())))

    # `cond: block` after `if`/`elif`
    fn branch(ref self) -> Result[(Expr, Block), ()]:
        let c = self.expr()?
        self.expect(Tok.Colon, "`:`")?
        let (b, _) = self.block([])?
        return Ok((c, b))

    fn if_stmt(ref self) -> Result[Stmt, ()]:
        let start = self.bump()
        var branches = [self.branch()?]
        var els: Option[Block] = None
        while true:
            self.skip_newlines_before_else()
            if self.at_kw(Kw.Elif):
                self.bump()
                branches.push(self.branch()?)
            elif self.at_kw(Kw.Else):
                let else_span = self.bump()
                if self.at_kw(Kw.If):
                    let sp = else_span.to(self.span())
                    self.diags.push(
                        diag.error("E0114", "use `elif` instead of `else if`")
                        .label(sp, "write `elif`")
                        .with_help(
                            "brine chains conditions with `elif cond:` lines between `if` and `else`"
                        )
                        .fix(sp, "elif", "replace with `elif`")
                    )
                    self.bump()
                    branches.push(self.branch()?)
                    continue
                self.expect(Tok.Colon, "`:`")?
                let (b, _) = self.block([])?
                els = Some(b)
                break
            else:
                break
        return Ok(stmt(StmtKind.If(branches, els), start))

    fn skip_newlines_before_else(ref self):
        # blocks end with DEDENT; `elif`/`else` follow directly
        var i = self.pos
        while self.toks[i].tok == Tok.Newline:
            i += 1
        let t = self.toks[i].tok
        if t == Tok.Keyword(Kw.Elif) or t == Tok.Keyword(Kw.Else):
            self.pos = i

    # `let Some(x) = opt` (Rust): brine takes values apart with `match`
    fn let_pattern(ref self, kw_span: Span) -> Result[StmtKind, ()]:
        var i = self.pos
        var eq = -1
        while i < len(self.toks) and not is_layout(self.toks[i].tok):
            if self.toks[i].tok == Tok.Assign and eq < 0:
                eq = i
            i += 1
        var help = "use `match value:` with a `case Some(x):` line and a `case _:` line for the rest"
        if eq > self.pos and eq + 1 < i:
            let pat = self.src(self.toks[self.pos].lo, self.toks[eq - 1].hi)
            let val = self.src(self.toks[eq + 1].lo, self.toks[i - 1].hi)
            if pat != "" and val != "":
                help = f"use `match {val}:` with a `case {pat}:` line and a `case _:` line for the rest (there, `{pat}` binds its names)"
        let pend = self.toks[max(eq - 1, self.pos)]
        let sp = Span(file=self.file, lo=self.toks[self.pos].lo, hi=pend.hi)
        self.diags.push(
            diag.error("E0115", "`let` can't take apart an enum value")
            .label(sp, "a pattern")
            .with_help(help)
        )
        return Err(())

    fn simple_kind(ref self) -> Result[StmtKind, ()]:
        match self.peek():
            case Tok.Keyword(Kw.Let) | Tok.Keyword(Kw.Var):
                var mutable = self.at_kw(Kw.Var)
                let kw_span = self.bump()
                if not mutable and self.at_kw(Kw.Mut):
                    # `let mut x = ...`: brine's word for that is `var`
                    let ms = self.bump()
                    self.diags.push(
                        diag.error("E0115", "brine writes `var` for a variable that changes")
                        .label(kw_span.to(ms), "`let mut`")
                        .with_help("`let` names a value that never changes, `var` one that does")
                        .fix(kw_span.to(ms), "var", "replace with `var`")
                    )
                    mutable = true
                let lo = self.span()
                if is_ident(self.peek()) and self.peek_at(1) == Tok.LParen:
                    return self.let_pattern(kw_span)
                let items = self.targets("variable name", false)?
                var ty: Option[TypeExpr] = None
                if self.eat(Tok.Colon):
                    ty = Some(self.type_expr()?)
                var pat = LetPat.Tuple([])
                var tuple = items
                match items[0]:
                    case Target.Name(n, sp, _) if len(items) == 1:
                        pat = LetPat.Name(n, sp)
                    case Target.Tuple(inner, _) if len(items) == 1:
                        tuple = inner
                    case _:
                        pass
                match pat:
                    case LetPat.Tuple(_):
                        # nested tuples are unpacked by `let`s that follow
                        let us = unpack_items(tuple, "", ty)
                        pat = LetPat.Tuple([(u.name, u.span) for u in us if u.parent == ""])
                        self.pending.extend(unpack_lets([u for u in us if u.parent != ""], mutable))
                    case _:
                        pass
                if not self.at(Tok.Assign):
                    let d = self.error_here(
                        "E0110",
                        "variables must be initialized",
                        "expected `=` and a value"
                    )
                    var vn = "x"
                    match items[0]:
                        case Target.Name(n, _, _):
                            vn = n
                        case _:
                            pass
                    let kw = "var" if mutable else "let"
                    match ty:
                        case Some(te):
                            # keep the written type: `var p: P = P(...)`
                            let tt = self.src(te.span().lo, te.span().hi)
                            let v = zero_text(te)
                            var help = f"every variable starts with a value: `{kw} {vn}: {tt} = {v}`"
                            if v.ends_with("(...)"):
                                help += ", with the value you would assign first"
                            self.diags.push(d.with_help(help))
                        case None:
                            # Go's `var x int = 5`: the type needs a `:`
                            match self.peek():
                                case Tok.Ident(tn) if self.line_has(Tok.Assign):
                                    let at = self.prev_span()
                                    self.diags.push(
                                        diag.error(
                                            "E0110",
                                            "the type of a variable comes after `:`"
                                        )
                                        .label(self.span(), "expected `:` before the type")
                                        .with_help(f"write `{kw} {vn}: {tn} = ...`")
                                        .fix(Span(file=at.file, lo=at.hi, hi=at.hi), ":", "add `:`")
                                    )
                                case _:
                                    self.diags.push(
                                        d.with_help(
                                            f"every variable starts with a value: `{kw} {vn} = 0`, or `{kw} {vn}: [int] = []` for an empty array"
                                        )
                                    )
                    return Err(())
                self.bump()
                let is_ref = self.eat_kw(Kw.Ref)
                let init = self.expr()?
                return Ok(StmtKind.Let(mutable, pat, ty, init, is_ref))
            case Tok.Keyword(Kw.Return):
                self.bump()
                match self.peek():
                    case Tok.Newline | Tok.Dedent | Tok.Eof:
                        return Ok(StmtKind.Return(None))
                    case _:
                        return Ok(StmtKind.Return(Some(self.expr()?)))
            case Tok.Keyword(Kw.Break):
                self.bump()
                return Ok(StmtKind.Break)
            case Tok.Keyword(Kw.Continue):
                self.bump()
                return Ok(StmtKind.Continue)
            case Tok.Keyword(Kw.Pass):
                self.bump()
                return Ok(StmtKind.Pass)
            case Tok.Keyword(Kw.Requires):
                self.bump()
                return Ok(StmtKind.Contract(ContractKind.Requires, self.expr()?))
            case Tok.Keyword(Kw.Ensures):
                self.bump()
                return Ok(StmtKind.Contract(ContractKind.Ensures, self.expr()?))
            case Tok.Keyword(Kw.Invariant):
                self.bump()
                return Ok(StmtKind.Contract(ContractKind.Invariant, self.expr()?))
            case Tok.Keyword(Kw.Assert):
                self.bump()
                let cond = self.expr()?
                var msg: Option[Expr] = None
                if self.eat(Tok.Comma):
                    msg = Some(self.expr()?)
                return Ok(StmtKind.Assert(cond, msg))
            case Tok.Keyword(Kw.Prove):
                self.bump()
                return Ok(StmtKind.Prove(self.expr()?))
            case Tok.Keyword(Kw.If) | Tok.Keyword(Kw.While) | Tok.Keyword(Kw.For):
                self.report(
                    "E0110",
                    "compound statements must start on their own line",
                    "move this to a new line"
                )
                return Err(())
            case _:
                var e = self.expr()?
                # `a, b = b, a`: a tuple of places
                if self.at(Tok.Comma):
                    e = self.comma_tuple(e)?
                    if not self.at(Tok.Assign):
                        self.report("E0110", "expected `=` after a list of places", "expected `=`")
                        return Err(())
                    self.bump()
                    let first = self.expr()?
                    return Ok(StmtKind.Assign(e, None, self.comma_tuple(first)?))
                var op: Option[BinOp] = None
                match self.peek():
                    case Tok.Assign:
                        pass
                    case Tok.PlusEq:
                        op = Some(BinOp.Add)
                    case Tok.MinusEq:
                        op = Some(BinOp.Sub)
                    case Tok.StarEq:
                        op = Some(BinOp.Mul)
                    case Tok.SlashEq:
                        op = Some(BinOp.Div)
                    case Tok.PercentEq:
                        op = Some(BinOp.Mod)
                    case Tok.AmpEq:
                        op = Some(BinOp.BitAnd)
                    case Tok.PipeEq:
                        op = Some(BinOp.BitOr)
                    case Tok.CaretEq:
                        op = Some(BinOp.BitXor)
                    case Tok.ShlEq:
                        op = Some(BinOp.Shl)
                    case Tok.ShrEq:
                        op = Some(BinOp.Shr)
                    case _:
                        return Ok(StmtKind.ExprStmt(e))
                self.bump()
                var value = self.expr()?
                if op.is_none() and self.at(Tok.Comma):
                    value = self.comma_tuple(value)?
                return Ok(StmtKind.Assign(e, op, value))

    # `first, b, c` without parentheses, as on either side of `a, b = b, a`
    fn comma_tuple(ref self, first: Expr) -> Result[Expr, ()]:
        if not self.at(Tok.Comma):
            return Ok(first)
        var elems = [first]
        while self.eat(Tok.Comma):
            elems.push(self.expr()?)
        let span = first.span.to(elems[len(elems) - 1].span)
        return Ok(mk(ExprKind.Tuple(elems), span))

    fn simple_stmt(ref self) -> Result[Stmt, ()]:
        let start = self.span()
        let kind = self.simple_kind()?
        let span = start.to(self.prev_span())
        self.end_stmt()?
        return Ok(stmt(kind, span))

    # ------------------------------------------------------------ expressions
    fn expr(ref self) -> Result[Expr, ()]:
        let e = self.or_expr()?
        if not self.at_kw(Kw.If):
            return Ok(e)
        # conditional expression: a if cond else b
        self.bump()
        let cond = self.or_expr()?
        if not self.eat_kw(Kw.Else):
            let d = self.error_here(
                "E0110",
                "expected `else` in conditional expression",
                "expected `else`"
            )
            self.diags.push(d.with_help("write `a if cond else b`"))
            return Err(())
        let els = self.expr()?
        let span = e.span.to(els.span)
        return Ok(mk(ExprKind.IfElse(cond, e, els), span))

    fn or_expr(ref self) -> Result[Expr, ()]:
        var l = self.and_expr()?
        while self.at_kw(Kw.Or):
            self.bump()
            let r = self.and_expr()?
            let span = l.span.to(r.span)
            l = mk(ExprKind.Binary(BinOp.Or, l, r), span)
        return Ok(l)

    fn and_expr(ref self) -> Result[Expr, ()]:
        var l = self.not_expr()?
        while self.at_kw(Kw.And):
            self.bump()
            let r = self.not_expr()?
            let span = l.span.to(r.span)
            l = mk(ExprKind.Binary(BinOp.And, l, r), span)
        return Ok(l)

    fn not_expr(ref self) -> Result[Expr, ()]:
        if self.at_kw(Kw.Not):
            let s = self.bump()
            let e = self.not_expr()?
            let span = s.to(e.span)
            return Ok(mk(ExprKind.Unary(UnOp.Not, e), span))
        return self.comparison()

    fn cmp_op(self) -> Option[CmpOp]:
        match self.peek():
            case Tok.EqEq:
                return Some(CmpOp.Eq)
            case Tok.Ne:
                return Some(CmpOp.Ne)
            case Tok.Lt:
                return Some(CmpOp.Lt)
            case Tok.Le:
                return Some(CmpOp.Le)
            case Tok.Gt:
                return Some(CmpOp.Gt)
            case Tok.Ge:
                return Some(CmpOp.Ge)
            case _:
                return None

    fn comparison(ref self) -> Result[Expr, ()]:
        let first = self.range_expr()?
        let neg = self.at_kw(Kw.Not) and self.peek_at(1) == Tok.Keyword(Kw.In)
        if self.at_kw(Kw.In) or neg:
            self.bump()
            if neg:
                self.bump()
            let coll = self.range_expr()?
            let span = first.span.to(coll.span)
            return Ok(mk(ExprKind.Contains(first, coll, neg), span))
        var rest: [(CmpOp, Expr)] = []
        while true:
            match self.cmp_op():
                case Some(op):
                    self.bump()
                    rest.push((op, self.range_expr()?))
                case None:
                    break
        if len(rest) == 0:
            return Ok(first)
        let (_, last) = rest[len(rest) - 1]
        let span = first.span.to(last.span)
        return Ok(mk(ExprKind.Compare(first, rest), span))

    fn range_expr(ref self) -> Result[Expr, ()]:
        let lo = self.binary(0)?
        if self.at(Tok.DotDot) or self.at(Tok.DotDotEq):
            let inclusive = self.at(Tok.DotDotEq)
            self.bump()
            let hi = self.binary(0)?
            let span = lo.span.to(hi.span)
            return Ok(mk(ExprKind.Range(lo, hi, inclusive), span))
        return Ok(lo)

    # The operator at the current token, if it belongs to precedence `level`
    # (0 binds loosest: `|`, then `^`, `&`, shifts, `+ -`, `* / %`).
    fn bin_op(self, level: int) -> Option[BinOp]:
        match (level, self.peek()):
            case (0, Tok.Pipe):
                return Some(BinOp.BitOr)
            case (1, Tok.Caret):
                return Some(BinOp.BitXor)
            case (2, Tok.Amp):
                return Some(BinOp.BitAnd)
            case (3, Tok.Shl):
                return Some(BinOp.Shl)
            case (3, Tok.Shr):
                return Some(BinOp.Shr)
            case (4, Tok.Plus):
                return Some(BinOp.Add)
            case (4, Tok.Minus):
                return Some(BinOp.Sub)
            case (5, Tok.Star):
                return Some(BinOp.Mul)
            case (5, Tok.Slash):
                return Some(BinOp.Div)
            case (5, Tok.Percent):
                return Some(BinOp.Mod)
            case _:
                return None

    fn operand(ref self, level: int) -> Result[Expr, ()]:
        if level >= 5:
            return self.unary()
        return self.binary(level + 1)

    fn binary(ref self, level: int) -> Result[Expr, ()]:
        var l = self.operand(level)?
        while true:
            match self.bin_op(level):
                case Some(op):
                    self.bump()
                    let r = self.operand(level)?
                    let span = l.span.to(r.span)
                    l = mk(ExprKind.Binary(op, l, r), span)
                case None:
                    break
        return Ok(l)

    fn unary(ref self) -> Result[Expr, ()]:
        var op = UnOp.Neg
        match self.peek():
            case Tok.Minus:
                op = UnOp.Neg
            case Tok.Tilde:
                op = UnOp.BitNot
            case _:
                return self.postfix()
        let s = self.bump()
        let e = self.unary()?
        let span = s.to(e.span)
        return Ok(mk(ExprKind.Unary(op, e), span))

    # call arguments; the `(` is already consumed
    fn args(ref self) -> Result[[Arg], ()]:
        var args: [Arg] = []
        while not self.at(Tok.RParen):
            let mut_span = self.span()
            var by_ref = false
            if self.eat_kw(Kw.Mut):
                self.diags.push(
                    diag.error("E0402", "pass references with `ref`, not `mut`")
                    .label(mut_span, "write `ref` here")
                    .fix(mut_span, "ref", "replace with `ref`")
                )
                by_ref = true
            elif self.at(Tok.Amp):
                # `f(&mut xs)`: brine writes `f(ref xs)`
                let amp = self.bump()
                self.eat_kw(Kw.Mut)
                self.diags.push(
                    diag.error("E0115", "brine passes references with `ref`, not `&`")
                    .label(amp, "`&`")
                    .with_help("write `f(ref x)`; the parameter is declared `ref name: type`")
                    .fix(
                        Span(file=amp.file, lo=amp.lo, hi=self.span().lo),
                        "ref ",
                        "replace with `ref`"
                    )
                )
                by_ref = true
            else:
                by_ref = self.eat_kw(Kw.Ref)
            var name: Option[(str, Span)] = None
            match (self.peek(), self.peek_at(1)):
                case (Tok.Ident(n), Tok.Assign):
                    let sp = self.bump()
                    self.bump()
                    name = Some((n, sp))
                # `Fn(requires=[])`: a keyword names a field here
                case (Tok.Keyword(k), Tok.Assign):
                    let sp = self.bump()
                    self.bump()
                    name = Some((kw_name(k), sp))
                case _:
                    pass
            let e = self.expr()?
            if self.at_kw(Kw.For) and len(args) == 0 and name.is_none():
                let comp = self.comp_tail(e, CompKind.Gen)?
                args.push(Arg(by_ref=by_ref, name=name, expr=comp))
                break
            args.push(Arg(by_ref=by_ref, name=name, expr=e))
            if not self.eat(Tok.Comma):
                break
        self.expect(Tok.RParen, "`)`")?
        return Ok(args)

    fn comp_tail(ref self, body: Expr, kind: CompKind) -> Result[Expr, ()]:
        self.bump()
        let items = self.targets("loop variable", false)?
        var name = ""
        let name_span = items[0].span().to(items[len(items) - 1].span())
        # `[v for k, v in pairs]`: unpack each element
        var unpack: [Unpack] = []
        match items[0]:
            case Target.Name(n, _, _) if len(items) == 1:
                name = n
            case _:
                name = f"for'{name_span.lo}"
                unpack = unpack_items(self.tuple_items(items, name_span)?, name, None)
        if not self.eat_kw(Kw.In):
            self.report("E0110", "expected `in`", "expected `in`")
            return Err(())
        let iter = self.or_expr()?
        var filter: Option[Expr] = None
        if self.eat_kw(Kw.If):
            filter = Some(self.or_expr()?)
        if self.at_kw(Kw.For):
            self.report(
                "E0110",
                "nested comprehensions are not supported yet",
                "only one `for` per comprehension"
            )
            return Err(())
        let span = body.span.to(self.prev_span())
        let c = Comp(
            kind=kind,
            body=body,
            name=name,
            name_span=name_span,
            unpack=unpack,
            iter=iter,
            filter=filter,
            par=false
        )
        return Ok(mk(ExprKind.Comp(c), span))

    # C's `c ? a : b`, just after the `?`: say `a if c else b`, and write it
    # when the condition starts after `=`, `(`, `,`, `return` or the line's start
    fn ternary(ref self):
        let q = self.pos - 1
        var i = q - 1
        var depth = 0
        while i > 0:
            match self.toks[i - 1].tok:
                case Tok.RParen | Tok.RBracket | Tok.RBrace:
                    depth += 1
                case Tok.LParen | Tok.LBracket | Tok.LBrace:
                    if depth == 0:
                        break
                    depth -= 1
                case Tok.Assign | Tok.Comma | Tok.Keyword(Kw.Return):
                    if depth == 0:
                        break
                case Tok.Newline | Tok.Indent | Tok.Dedent:
                    break
                case _:
                    pass
            i -= 1
        var colon = -1
        depth = 0
        var j = self.pos
        let end = self.line_end()
        while j < end:
            match self.toks[j].tok:
                case Tok.LParen | Tok.LBracket | Tok.LBrace:
                    depth += 1
                case Tok.RParen | Tok.RBracket | Tok.RBrace:
                    depth -= 1
                case Tok.Colon if depth == 0 and colon < 0:
                    colon = j
                case _:
                    pass
            if depth < 0:
                break
            j += 1
        var help = "write `a if c else b`; `?` after a value passes on its `None` or `Err`"
        var d = diag.error("E0115", "brine has no `? :` operator").label(self.prev_span(), "`?`")
        if colon > self.pos and j > colon + 1:
            let c = self.src(self.toks[i].lo, self.toks[q - 1].hi)
            let a = self.src(self.toks[self.pos].lo, self.toks[colon - 1].hi)
            let b = self.src(self.toks[colon + 1].lo, self.toks[j - 1].hi)
            if c != "" and a != "" and b != "":
                let rep = f"{a} if {c} else {b}"
                help = f"write `{rep}`"
                d = d.fix(
                    Span(file=self.file, lo=self.toks[i].lo, hi=self.toks[j - 1].hi),
                    rep,
                    "write `a if c else b`"
                )
        self.diags.push(d.with_help(help))

    # `xs[::-1]`, `xs[a:b:2]`: at the `:` before the step
    fn slice_step(ref self, e: Expr):
        let x = self.src(e.span.lo, e.span.hi)
        let xs = x if x != "" else "xs"
        var step = ""
        if self.peek_at(1) == Tok.Minus and self.peek_at(2) == Tok.Int(u128(1)):
            step = "-1"
        elif self.peek_at(2) == Tok.Minus and self.peek_at(3) == Tok.Int(u128(1)):
            step = "-1"
        let help = (
            f"to reverse, reverse a copy: `var ys = {xs}`, then `ys.reverse()` (for a string, `var cs = {xs}.chars()`, `cs.reverse()`, then `\"\".join(cs)`)"
            if step == "-1"
            else f"pick the elements with a comprehension over a `range` with a step: `[{xs}[i] for i in range(0, len({xs}), 2)]`"
        )
        self.diags.push(
            diag.error("E0115", "brine slices have no step")
            .label(self.span(), "a step")
            .with_help(help)
        )

    # the rest of a slice after `:`, up to and including `]`
    fn slice_hi(ref self) -> Result[Option[Expr], ()]:
        if self.at(Tok.RBracket):
            return Ok(None)
        return Ok(Some(self.expr()?))

    fn postfix(ref self) -> Result[Expr, ()]:
        var e = self.primary()?
        while true:
            match self.peek():
                case Tok.LParen:
                    self.bump()
                    let args = self.args()?
                    let span = e.span.to(self.prev_span())
                    match e.kind:
                        case ExprKind.Field(recv, name, name_span):
                            e = mk(ExprKind.MethodCall(recv, name, name_span, args), span)
                        case _:
                            e = mk(ExprKind.Call(e, args), span)
                case Tok.Question:
                    self.bump()
                    if self.starts_operand() and self.line_has(Tok.Colon):
                        # C's `c ? a : b`
                        self.ternary()
                        return Err(())
                    let span = e.span.to(self.prev_span())
                    e = mk(ExprKind.Try(e), span)
                case Tok.LBracket:
                    self.bump()
                    if self.at(Tok.Colon) and self.peek_at(1) == Tok.Colon:
                        self.slice_step(e)
                        return Err(())
                    if self.eat(Tok.Colon):
                        let hi = self.slice_hi()?
                        if self.at(Tok.Colon):
                            self.slice_step(e)
                            return Err(())
                        self.expect(Tok.RBracket, "`]`")?
                        let span = e.span.to(self.prev_span())
                        e = mk(ExprKind.Slice(e, None, hi), span)
                        continue
                    var idx = self.expr()?
                    if self.at(Tok.Comma):
                        # `Pair[int, str]`: type arguments, read as a tuple like Python does
                        var elems = [idx]
                        while self.eat(Tok.Comma):
                            if self.at(Tok.RBracket):
                                break
                            elems.push(self.expr()?)
                        let sp = elems[0].span.to(self.prev_span())
                        idx = mk(ExprKind.Tuple(elems), sp)
                    if self.eat(Tok.Colon):
                        let hi = self.slice_hi()?
                        if self.at(Tok.Colon):
                            self.slice_step(e)
                            return Err(())
                        self.expect(Tok.RBracket, "`]`")?
                        let span = e.span.to(self.prev_span())
                        e = mk(ExprKind.Slice(e, Some(idx), hi), span)
                        continue
                    self.expect(Tok.RBracket, "`]`")?
                    let span = e.span.to(self.prev_span())
                    e = mk(ExprKind.Index(e, idx), span)
                case Tok.Dot:
                    self.bump()
                    var name = ""
                    var name_span = self.span()
                    match self.peek():
                        case Tok.Int(n):
                            name_span = self.bump()
                            name = f"{n}"
                        case Tok.Float(_):
                            # `t.0.1` lexes as a float; not supported
                            self.report(
                                "E0110",
                                "nested tuple indexing needs parentheses",
                                "write `(t.0).1`"
                            )
                            return Err(())
                        case _:
                            let (n, ns) = self.field_name("field or method name", true)?
                            name = n
                            name_span = ns
                    let span = e.span.to(name_span)
                    e = mk(ExprKind.Field(e, name, name_span), span)
                case _:
                    return Ok(e)
        return Ok(e)

    # `(a, b)` after `(`; a single parenthesized expression keeps its kind
    fn paren(ref self, sp: Span) -> Result[Expr, ()]:
        if self.at(Tok.RParen):
            self.bump()
            return Ok(mk(ExprKind.Tuple([]), sp.to(self.prev_span())))
        let first = self.expr()?
        if self.eat(Tok.Comma):
            var elems = [first]
            while not self.at(Tok.RParen):
                elems.push(self.expr()?)
                if not self.eat(Tok.Comma):
                    break
            self.expect(Tok.RParen, "`)`")?
            return Ok(mk(ExprKind.Tuple(elems), sp.to(self.prev_span())))
        self.expect(Tok.RParen, "`)`")?
        return Ok(mk(first.kind, sp.to(self.prev_span())))

    fn bracket(ref self, sp: Span) -> Result[Expr, ()]:
        if self.at(Tok.RBracket):
            self.bump()
            return Ok(mk(ExprKind.Array([]), sp.to(self.prev_span())))
        let first = self.expr()?
        if self.at_kw(Kw.For):
            let c = self.comp_tail(first, CompKind.List)?
            self.expect(Tok.RBracket, "`]`")?
            return Ok(mk(c.kind, sp.to(self.prev_span())))
        var elems = [first]
        while self.eat(Tok.Comma):
            if self.at(Tok.RBracket):
                break
            elems.push(self.expr()?)
        self.expect(Tok.RBracket, "`]`")?
        return Ok(mk(ExprKind.Array(elems), sp.to(self.prev_span())))

    fn brace(ref self, sp: Span) -> Result[Expr, ()]:
        var entries: [(Expr, Expr)] = []
        while not self.at(Tok.RBrace):
            let k = self.expr()?
            if self.at_kw(Kw.For) and len(entries) == 0:
                self.push_foreign(
                    self.span(),
                    "brine has no set comprehensions",
                    "`for` in `{...}`",
                    "brine has no sets: build a map to `bool` in a loop, `var seen: {int: bool} = {}`, then `seen[x] = true`, and test with `x in seen`"
                )
                return Err(())
            self.expect(Tok.Colon, "`:` between the key and value")?
            let v = self.expr()?
            if self.at_kw(Kw.For) and len(entries) == 0:
                self.push_foreign(
                    self.span(),
                    "brine has no map comprehensions",
                    "`for` in `{...}`",
                    "build the map in a loop: `var m: {str: int} = {}`, then `for (k, v) in pairs:` with `m[k] = v` in its body"
                )
                return Err(())
            entries.push((k, v))
            if not self.eat(Tok.Comma):
                break
        self.expect(Tok.RBrace, "`}`")?
        return Ok(mk(ExprKind.Map(entries), sp.to(self.prev_span())))

    fn primary(ref self) -> Result[Expr, ()]:
        let before = self.pos
        let tok = self.peek()
        let sp = self.bump()
        match tok:
            case Tok.Int(v):
                if v > u128(I128_MAX):
                    return Ok(mk(ExprKind.UInt(v), sp))
                return Ok(mk(ExprKind.Int(i128(v)), sp))
            case Tok.Float(v):
                return Ok(mk(ExprKind.Float(v), sp))
            case Tok.Str(s):
                return Ok(mk(ExprKind.Str(s), sp))
            case Tok.FStr(parts):
                let segs = self.fstring(parts)?
                return Ok(mk(ExprKind.FStr(segs), sp.to(self.prev_span())))
            case Tok.Keyword(Kw.True):
                return Ok(mk(ExprKind.Bool(true), sp))
            case Tok.Keyword(Kw.False):
                return Ok(mk(ExprKind.Bool(false), sp))
            case Tok.Ident(name):
                # Python-style constants that don't exist
                if name == "True" or name == "False":
                    let f = name.lower()
                    let p = self.pos
                    if (
                        p >= 3
                        and self.toks[p - 2].tok == Tok.Assign
                        and self.toks[p - 3].tok == Tok.Ident("reverse")
                    ):
                        # `xs.sort(reverse=True)`: the checker says what to write instead
                        return Ok(mk(ExprKind.Bool(name == "True"), sp))
                    self.diags.push(
                        diag.error("E0201", f"`{name}` is not defined")
                        .label(sp, f"did you mean `{f}`?")
                        .fix(sp, f, f"replace with `{f}`")
                    )
                    return Ok(mk(ExprKind.Bool(name == "True"), sp))
                return Ok(mk(ExprKind.Ident(name), sp))
            case Tok.LParen:
                return self.paren(sp)
            case Tok.LBracket:
                return self.bracket(sp)
            case Tok.LBrace:
                return self.brace(sp)
            case Tok.Keyword(Kw.Par):
                return self.par_expr(sp)
            case Tok.Keyword(Kw.Not):
                # allow `not` in operand positions (e.g. after `==`)
                let e = self.unary()?
                return Ok(mk(ExprKind.Unary(UnOp.Not, e), sp.to(e.span)))
            case _:
                self.pos = before
                if self.foreign(true):
                    return Err(())
                if tok == Tok.Indent:
                    let d = self.error_here(
                        "E0103",
                        "unexpected indentation",
                        "this line is indented more than the one above"
                    )
                    self.diags.push(
                        d.with_help(
                            "indent it like the line above; only a line that ends with `:` starts an indented block"
                        )
                    )
                    return Err(())
                if tok == Tok.Keyword(Kw.Else) or tok == Tok.Keyword(Kw.Elif):
                    let kw = "else" if tok == Tok.Keyword(Kw.Else) else "elif"
                    let d = self.error_here(
                        "E0103",
                        f"`{kw}` doesn't line up with an `if`",
                        f"`{kw}` here"
                    )
                    self.diags.push(
                        d.with_help(f"indent `{kw}` exactly like the `if` it belongs to")
                    )
                    return Err(())
                if tok == Tok.Keyword(Kw.Ref) and self.pos + 1 < len(self.toks):
                    # `return ref x`, `View(data=ref xs)`: the value itself is meant
                    let rsp = self.span()
                    let next = self.toks[self.pos + 1].lo
                    self.diags.push(
                        diag.error("E0110", "`ref` can't be used here")
                        .label(rsp, "`ref` here")
                        .with_help(
                            "`ref` marks an argument for a `ref` parameter (`f(ref x)`) or names a variable (`let r = ref x`); a reference can't be returned or stored, so use the value itself (copies are cheap, copy-on-write)"
                        )
                        .fix(Span(file=self.file, lo=rsp.lo, hi=next), "", "remove `ref`")
                    )
                    self.bump()
                    return self.unary()
                var d = self.error_here(
                    "E0111",
                    f"expected an expression, found {describe(tok)}",
                    "expected an expression"
                )
                match tok:
                    case Tok.Keyword(k) if k != Kw.Not:
                        d = d.with_help(
                            f"`{kw_name(k)}` is a keyword; it can't be used as a value or a name"
                        )
                    case Tok.Star:
                        let p = self.toks[self.pos - 1].tok if self.pos > 0 else Tok.Eof
                        if p == Tok.LParen or p == Tok.Comma:
                            d = d.with_help(
                                "brine has no `*` unpacking: pass the array itself (`print(xs)`), or make one string: `print(\" \".join([str(x) for x in xs]))`"
                            )
                        else:
                            d = d.with_help(
                                "brine has no `**` or `*args`: write `pow(x, y)` on floats, or `x * x`"
                            )
                    case _:
                        pass
                if tok == Tok.Newline:
                    d = d.with_help(
                        "the expression is incomplete; continue it on this line or wrap it in parentheses to span lines"
                    )
                self.diags.push(d)
                return Err(())

    fn par_expr(ref self, start: Span) -> Result[Expr, ()]:
        match self.peek():
            case Tok.LParen:
                self.bump()
                var elems: [Expr] = []
                while not self.at(Tok.RParen):
                    elems.push(self.expr()?)
                    if not self.eat(Tok.Comma):
                        break
                self.expect(Tok.RParen, "`)`")?
                let span = start.to(self.prev_span())
                if len(elems) < 2:
                    let d = diag.error(
                        "E0113",
                        "`par(...)` needs at least two expressions to run in parallel"
                    ).label(span, "only one expression")
                    self.diags.push(d.with_help("write `par(f(x), g(y))`"))
                return Ok(mk(ExprKind.ParTuple(elems), span))
            case Tok.LBracket:
                let e = self.primary()?
                let span = start.to(e.span)
                match e.kind:
                    case ExprKind.Comp(c):
                        var pc = c
                        pc.par = true
                        return Ok(mk(ExprKind.Comp(pc), span))
                    case _:
                        let d = diag.error(
                            "E0113",
                            "`par [...]` must be a list comprehension"
                        ).label(span, "not a comprehension")
                        self.diags.push(d.with_help("write `par [f(i) for i in 0..n]`"))
                        return Err(())
            case Tok.Ident(_):
                let e = self.postfix()?
                let span = start.to(e.span)
                match e.kind:
                    case ExprKind.Call(callee, args):
                        if len(args) > 0:
                            let a = args[0]
                            match a.expr.kind:
                                case ExprKind.Comp(c) if c.kind == CompKind.Gen:
                                    var new_args = args
                                    var pc = c
                                    pc.par = true
                                    let comp = mk(ExprKind.Comp(pc), a.expr.span)
                                    new_args[0] = Arg(by_ref=a.by_ref, name=a.name, expr=comp)
                                    return Ok(mk(ExprKind.Call(callee, new_args), span))
                                case _:
                                    pass
                    case _:
                        pass
                self.diags.push(
                    diag.error(
                        "E0113",
                        "`par` must be followed by a reduction over a generator"
                    ).label(span, "expected e.g. `par sum(x * x for x in xs)`")
                )
                return Err(())
            case _:
                let d = self.error_here(
                    "E0113",
                    "`par` must be followed by `for`, `[...]`, `(a, b)` or a reduction",
                    "unexpected after `par`"
                )
                self.diags.push(
                    d.with_help(
                        "examples: `par for i in 0..n:`, `par [f(i) for i in 0..n]`, `par sum(x for x in xs)`, `par(f(a), g(b))`"
                    )
                )
                return Err(())

    fn fstring(ref self, parts: [FPart]) -> Result[[FSeg], ()]:
        var segs: [FSeg] = []
        for p in parts:
            match p:
                case FPart.Lit(s):
                    segs.push(FSeg.Lit(s))
                case FPart.Expr(src, offset, spec):
                    let (toks, lex_diags) = lex(src, self.file, offset, false, false)
                    self.diags.extend(lex_diags)
                    var sub = Parser(
                        toks=toks,
                        pos=0,
                        file=self.file,
                        diags=[],
                        pending=[],
                        text=self.text,
                        after_try=false
                    )
                    let r = sub.expr()
                    if r.is_ok() and sub.at(Tok.Assign) and sub.peek_at(1) == Tok.Eof:
                        # `{x=}` (Python's debug form)
                        let e = sub.prev_span()
                        let field = Span(file=self.file, lo=offset - 1, hi=offset + len(src) + 1)
                        let name = self.src(offset, e.hi)
                        var d = diag.error(
                            "E0115",
                            "f-strings have no `{x=}` form"
                        ).label(sub.span(), "`=`")
                        d = d.with_help("write the name in the text: `x={x}`")
                        if spec.is_none() and name != "":
                            d = d.fix(field, name + "={" + name + "}", "write the name in the text")
                        self.diags.push(d)
                        return Err(())
                    if r.is_ok() and not sub.at(Tok.Eof):
                        sub.diags.push(
                            sub.error_here(
                                "E0110",
                                "unexpected tokens in f-string expression",
                                "unexpected"
                            )
                        )
                    # the expression ends at the field's `}`, not at the end of the file
                    for d in sub.diags:
                        var d2 = d
                        d2.msg = d.msg.replace("found end of file", "found `}`")
                        self.diags.push(d2)
                    let e = r?
                    var trimmed: Option[str] = None
                    match spec:
                        case Some(s):
                            trimmed = Some(s.strip())
                        case None:
                            pass
                    segs.push(FSeg.Part(e, trimmed))
        return Ok(segs)

# Parse a whole file: the module and every error, the lexer's first.
fn parse_module(text: str, file: int, name: str) -> (Module, [Diag]):
    let (toks, lex_diags) = lex(text, file, 0, false, true)
    var p = Parser(toks=toks, pos=0, file=file, diags=[], pending=[], text=text, after_try=false)
    let m = p.module(name)
    # After a broken string the quotes pair up wrongly to the end of the file, so
    # every later error is a guess: keep the ones before it (from the start of its
    # token) and say how many were dropped. After a construct from another
    # language (E0115, such as a C `for` line) or a character the lexer dropped
    # (E0101), the parser's errors on that line are noise.
    var cut = len(text) + 1
    var cut_at = -1
    var quiet: [(int, int)] = []
    for i, d in enumerate(lex_diags):
        if len(d.labels) == 0:
            continue
        let at = d.labels[0].span.lo
        if d.code == "E0102" and cut_at < 0:
            cut_at = i
            cut = at
            for t in toks:
                if t.lo <= at and at < t.hi:
                    cut = t.lo
                    break
        elif d.code == "E0115" or (d.code == "E0101" and d.msg.starts_with("unexpected character")):
            let bs = text.bytes()
            var a = at
            while a > 0 and bs[a - 1] != 10:
                a -= 1
            var b = at
            while b < len(bs) and bs[b] != 10:
                b += 1
            quiet.push((a, b))
    var diags: [Diag] = []
    var dropped = 0
    for i, d in enumerate(lex_diags):
        if cut_at >= 0 and i != cut_at and len(d.labels) > 0 and d.labels[0].span.lo >= cut:
            dropped += 1
        else:
            diags.push(d)
    for d in p.diags:
        var keep = true
        if len(d.labels) > 0:
            let lo = d.labels[0].span.lo
            if lo >= cut:
                keep = false
                dropped += 1
            for a, b in quiet:
                if a <= lo and lo <= b:
                    keep = false
        if keep:
            diags.push(d)
    if dropped > 0:
        for k, d in enumerate(diags):
            if d.code == "E0102":
                let more = "1 later error is" if dropped == 1 else f"{dropped} later errors are"
                diags[k] = d.note(
                    f"{more} not shown: after a broken string the rest of the file can't be read reliably; fix this one and check again"
                )
                break
    return (m, by_position(diags))

# `ds` in source order (stable): the lexer's and the parser's errors interleaved
fn by_position(ds: [Diag]) -> [Diag]:
    var out: [Diag] = []
    for d in ds:
        out.push(d)
        var j = len(out) - 1
        while j > 0 and out[j - 1].span().lo > d.span().lo:
            out[j] = out[j - 1]
            j -= 1
        out[j] = d
    return out

# The names `items` unpack `parent` into, nested tuples flattened: each gets a
# hidden name (`tup'<offset>`) unpacked in turn. `ty` is the written type of
# the whole tuple, if any.
fn unpack_items(items: [Target], parent: str, ty: Option[TypeExpr]) -> [Unpack]:
    var out: [Unpack] = []
    flatten(items, parent, ty, ref out)
    return out

fn flatten(items: [Target], parent: str, ty: Option[TypeExpr], ref out: [Unpack]):
    var elems: [Option[TypeExpr]] = [None for _ in items]
    match ty:
        case Some(TypeExpr.Tuple(es, _)):
            if len(es) == len(items):
                elems = [Some(e) for e in es]
        case _:
            pass
    for i, t in enumerate(items):
        match t:
            case Target.Name(n, sp, nt):
                let written = nt if nt.is_some() else elems[i]
                out.push(Unpack(name=n, span=sp, parent=parent, index=i, ty=written))
            case Target.Tuple(sub, sp):
                let hidden = f"tup'{sp.lo}"
                let written = elems[i] if elems[i].is_some() else target_type(t)
                out.push(Unpack(name=hidden, span=sp, parent=parent, index=i, ty=written))
                flatten(sub, hidden, written, ref out)

# the type written on every name of a target, as one type (None if any is missing)
fn target_type(t: Target) -> Option[TypeExpr]:
    match t:
        case Target.Name(_, _, ty):
            return ty
        case Target.Tuple(items, sp):
            var tys: [TypeExpr] = []
            for x in items:
                match target_type(x):
                    case Some(xt):
                        tys.push(xt)
                    case None:
                        return None
            return Some(TypeExpr.Tuple(tys, sp))

fn count_typed(items: [Target], ref typed: int, ref names: int):
    for t in items:
        match t:
            case Target.Name(_, _, ty):
                names += 1
                if ty.is_some():
                    typed += 1
            case Target.Tuple(sub, _):
                count_typed(sub, ref typed, ref names)

# One `let (a, b) = parent` per variable that is unpacked, outer ones first.
fn unpack_lets(us: [Unpack], mutable: bool) -> [Stmt]:
    var parents: [str] = []
    for u in us:
        if u.parent not in parents:
            parents.push(u.parent)
    var out: [Stmt] = []
    for p in parents:
        let group = [u for u in us if u.parent == p]
        let span = group[0].span.to(group[len(group) - 1].span)
        var ty: Option[TypeExpr] = None
        if all(u.ty.is_some() for u in group):
            ty = Some(TypeExpr.Tuple([u.ty.unwrap() for u in group], span))
        let names = [(u.name, u.span) for u in group]
        let init = mk(ExprKind.Ident(p), span)
        out.push(stmt(StmtKind.Let(mutable, LetPat.Tuple(names), ty, init, false), span))
    return out
