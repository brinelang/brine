# AArch64 machine code for the brine IR, for Linux (ELF64, see obj.br). The
# same approach as x64.br: every vreg has a home in the frame, in canonical
# form (integers sign- or zero-extended to 64 bits by their kind, Bool 0/1,
# F32 in the low 4 bytes), and each instruction loads its operands into
# scratch registers, computes and stores the result; vregs ra64.br puts in
# registers live there instead (except in debug builds).
# Vregs set once by a Const, SlotAddr or Global get no home.
#
# Frame: x29 points at the saved x29 / x30 pair, the callee-saved registers
# the function uses are right below it, and homes, stack slots and outgoing
# arguments are addressed from sp, which doesn't move in the body.
#
# Scratch registers: x9-x12 and v0-v2 (caller-saved), x16 for addresses out of
# an instruction's reach. Overflow and index checks branch to cold stubs after
# the function body. Every function gets an .eh_frame entry.
#
# Debug builds (`emit_obj` with `dbg`) keep every vreg in its home and get DWARF
# line and variable info (dwarf.br), as in x64.br.

from ir import K, Op, Inst, Func, Module, KFunc, KOp
from ir import KO_MOV, KO_LD, KO_LDP, KO_LDH, KO_ST, KO_STH, KO_OP, KO_SQRT, KO_SHUF
from ir import KO_CONST, KO_CONST2, KO_SPILL, KO_FILL, KO_ARG, KPath
from ir import KV_BCF, KV_LD, KV_ST, KV_MOV, KV_FOP, KV_RLD, KV_RST, KV_RED
from ir import SSE_ADD, SSE_MUL, SSE_SUB, SSE_DIV, SSE_XOR, SSE_UNPH, PFX_PD
from opt import promote, const_arrs, arr_data, prune_rt, inline_small, reads
from dwarf import Dwarf, DFn, DRow, DLocal, new_dwarf, loc_breg, loc_deref, write_dwarf
from obj import ObjFile, OSym, ORel, new_obj, write_elf, put16, put32, set32, uleb, sleb, log2
from obj import SEC_UNDEF, SEC_TEXT, SEC_DATA, SEC_RODATA, R_PC32, R_ABS64, ARCH_A64
from obj import R_A64_CALL26, R_A64_PAGE, R_A64_LO12, R_A64_GOT_PAGE, R_A64_GOT_LO12, R_A64_LDR12
import ra64
from x64 import canon, fl_of, align_up, w128, wide_rt_helpers, emit_order, opt_func

const T0 = 9
const T1 = 10
const T2 = 11
const T3 = 12
const IP0 = 16
const FP = 29
const LR = 30
# sp or xzr, by instruction
const SP = 31
const ZR = 31

# condition codes
const C_EQ = 0
const C_NE = 1
const C_HS = 2
const C_LO = 3
const C_MI = 4
const C_VS = 6
const C_HI = 8
const C_LS = 9
const C_GE = 10
const C_LT = 11
const C_GT = 12
const C_LE = 13

# how a vreg is folded away
const F_NONE = 0
const F_CONST = 1
const F_SLOT = 2
const F_GLOBAL = 3
# an element address used only by the load or store right after it, which
# takes it as base and index registers (fval: the Elem's position)
const F_ELEM = 4
# a float constant that got no register, made again at each use (fval: its
# bits)
const F_FCONST = 5
# `~b` read only by the `and` right after it, which is then a bic (fval: b)
const F_NOT = 6
# `a * b` read only by the `+` right after it, which is then a madd (fval:
# the multiplication's position)
const F_MUL = 7

# call argument sources
const A_VAL = 0
const A_ADDR = 1
const A_IMM = 2
const A_SYM = 3
const A_FRAME = 4

# argument locations: x register i, v register 100 + i, stack 1000 + byte offset
const L_V = 100
const L_STACK = 1000

# panic stubs
const S_ADD = 0
const S_SUB = 1
const S_MUL = 2
const S_IDX = 3

# branch fields to patch: imm26 (b, bl), imm19 (b.cond, cbz), imm14 (tbz);
# W32: a jump table word, the byte offset from itself
const B26 = 0
const B19 = 1
const B14 = 2
const W32 = 3

# memory access instructions, see `mop`
const M_LDRX = 0
const M_STRX = 1
const M_LDRW = 2
const M_STRW = 3
const M_LDRSW = 4
const M_LDRH = 5
const M_LDRSH = 6
const M_STRH = 7
const M_LDRB = 8
const M_LDRSB = 9
const M_STRB = 10
const M_LDRD = 11
const M_STRD = 12
const M_LDRS = 13
const M_STRS = 14
const M_LDRQ = 15
const M_STRQ = 16

# (unsigned-offset encoding, unscaled encoding, access size)
fn mop(m: int) -> (int, int, int):
    match m:
        case 0:
            return (0xF9400000, 0xF8400000, 8)
        case 1:
            return (0xF9000000, 0xF8000000, 8)
        case 2:
            return (0xB9400000, 0xB8400000, 4)
        case 3:
            return (0xB9000000, 0xB8000000, 4)
        case 4:
            return (0xB9800000, 0xB8800000, 4)
        case 5:
            return (0x79400000, 0x78400000, 2)
        case 6:
            return (0x79800000, 0x78800000, 2)
        case 7:
            return (0x79000000, 0x78000000, 2)
        case 8:
            return (0x39400000, 0x38400000, 1)
        case 9:
            return (0x39800000, 0x38800000, 1)
        case 10:
            return (0x39000000, 0x38000000, 1)
        case 11:
            return (0xFD400000, 0xFC400000, 8)
        case 12:
            return (0xFD000000, 0xFC000000, 8)
        case 13:
            return (0xBD400000, 0xBC400000, 4)
        case 14:
            return (0xBD000000, 0xBC000000, 4)
        case 15:
            return (0x3DC00000, 0x3CC00000, 16)
        case _:
            return (0x3D800000, 0x3C800000, 16)

# the load of kind k, in canonical form
fn load_op(k: K) -> int:
    match k:
        case K.I8:
            return M_LDRSB
        case K.U8 | K.Bool:
            return M_LDRB
        case K.I16:
            return M_LDRSH
        case K.U16:
            return M_LDRH
        case K.I32:
            return M_LDRSW
        case K.U32 | K.F32:
            return M_LDRW
        case _:
            return M_LDRX

fn store_op(size: int) -> int:
    if size == 1:
        return M_STRB
    if size == 2:
        return M_STRH
    if size == 4:
        return M_STRW
    return M_STRX

# Does a canonical value of integer kind ks need `norm` to be one of kd?
fn needs_norm(ks: K, kd: K) -> bool:
    if kd.size() == 8:
        return false
    if ks.size() < kd.size():
        return ks.is_signed() and not kd.is_signed()
    return ks.size() > kd.size() or ks.is_signed() != kd.is_signed()

# The extend option (of an extended-register operand) that makes a value of
# kind k (under 64 bits) canonical.
fn ext_option(k: K) -> int:
    let n = 0 if k.size() == 1 else (1 if k.size() == 2 else 2)
    return n + (4 if k.is_signed() else 0)

# The 8-bit immediate of `fmov` for the float with bits b (a double when d),
# or -1 when there is none: +-(16..31)/16 * 2^(-3..4).
fn fmov_imm(b: int, d: bool) -> int:
    if d:
        if b & 0xFFFFFFFFFFFF != 0:
            return -1
        let e = (b >> 54) & 0xFF
        let top = (b >> 62) & 1
        if (e != 0 and e != 0xFF) or top == (e & 1):
            return -1
        return (((b >> 63) & 1) << 7) | ((e & 1) << 6) | ((b >> 48) & 0x3F)
    if b & 0x7FFFF != 0 or b >> 32 != 0:
        return -1
    let e = (b >> 25) & 0x1F
    let top = (b >> 30) & 1
    if (e != 0 and e != 0x1F) or top == (e & 1):
        return -1
    return (((b >> 31) & 1) << 7) | ((e & 1) << 6) | ((b >> 19) & 0x3F)

# The instructions movz / movn and movk take for v.
fn mov_chunks(v: int) -> int:
    var zeros = 0
    var ones = 0
    for i in 0..4:
        let c = (v >> (16 * i)) & 0xFFFF
        if c == 0:
            zeros += 1
        elif c == 0xFFFF:
            ones += 1
    return max(4 - max(zeros, ones), 1)

# The instructions `mov_ri` takes for v.
fn mov_cost(v: int) -> int:
    let n = mov_chunks(v)
    if n > 1 and logic_imm(v) >= 0:
        return 1
    return n

# v as the immediate of a 64-bit logical instruction (and, orr, eor): its
# N:immr:imms bits, or -1 when it isn't one (a rotated run of ones repeated
# in elements of 2, 4, ... 64 bits).
fn logic_imm(v: int) -> int:
    if v == 0 or v == -1:
        return -1
    var size = 64
    while size > 2:
        let h = size / 2
        let m = (1 << h) - 1
        if (v & m) != ((v >> h) & m):
            break
        size = h
    var ones = 0
    for k in 0..size:
        ones += (v >> k) & 1
    # the rotation r that brings the run of ones down to bit 0
    for r in 0..size:
        if (v >> r) & 1 == 0 or (v >> ((r + size - 1) % size)) & 1 == 1:
            continue
        for t in 0..ones:
            if (v >> ((r + t) % size)) & 1 == 0:
                return -1
        let immr = (size - r) % size
        let imms = (-(size << 1) | (ones - 1)) & 0x3F
        return ((1 if size == 64 else 0) << 12) | (immr << 6) | imms
    return -1

struct CArg:
    how: int
    v: int
    # 0: integer class, 1: f64, 2: f32
    fl: int

struct Stub:
    # the b.cond to the stub
    at: int
    kind: int
    a: int
    b: int
    c: int

# Where (offsets in .text) a function's prologue steps end, for .eh_frame.
struct Unw:
    start: int
    # after x29 is set
    fp: int
    # after the callee-saved registers are stored
    pro_end: int
    # after the `ldp x29, x30` of each epilogue (`ret` follows)
    epis: [int]

# The CIE of .eh_frame: on entry the CFA is sp and the return address is in
# x30; FDEs give their code range pc-relative.
fn a64_cie(ref out: [u8]):
    put32(ref out, 0)
    put32(ref out, 0)
    # version 1, augmentation "zR"
    out.extend([1, 122, 82, 0])
    # code alignment 1, data alignment -8, return address register 30
    uleb(ref out, 1)
    sleb(ref out, -8)
    uleb(ref out, 30)
    uleb(ref out, 1)
    # DW_EH_PE_pcrel | DW_EH_PE_sdata4
    out.push(27)
    # DW_CFA_def_cfa sp, 0
    out.extend([12, 31, 0])
    while len(out) % 8 != 0:
        out.push(0)
    set32(ref out, 0, len(out) - 4)

struct A:
    o: ObjFile
    syms: {str: int}
    wide_ret: {str: bool}
    wide_rt: {str: bool}
    text_sym: int
    ovf: [int]
    # the function being compiled
    code: [Inst]
    vk: [K]
    nparams: int
    # sp-relative home of each vreg
    home: [int]
    # the callee-saved register holding the vreg for the whole function, or -1
    reg: [int]
    freg: [int]
    saved: [int]
    fsaved: [int]
    fold: [int]
    fval: [int]
    # by vreg: the low 7 bits of a 128-bit constant (-1: not one), for shifts
    wshift: [int]
    # the last st16: where its code ends, its registers and its home (a
    # load right after it, that nothing jumps to, reads the registers)
    st_end: int
    st_lo: int
    st_home: int
    nuse: [int]
    # the index of the Br / BrNot a brine_box_dec being written branches on
    # (its only use), or -1
    dec_br: int
    # sp-relative offset of each stack slot
    slot_off: [int]
    ploc: [int]
    lpos: [int]
    # branches to labels not placed yet: position, label, field
    jat: [int]
    jlab: [int]
    jkind: [int]
    stubs: [Stub]
    # sp-relative home of the hidden pointer to a 128-bit result
    retp: int
    # a 16-byte frame slot for ignored 128-bit results
    scratch: int
    # the functions whose calls are slow paths (Module.cold, and `_cold` ones),
    # the registers saved around each (ra64's keep) and where
    cold: {str: bool}
    keep: [[int]]
    keep_off: int
    has_ret: bool
    ret: K
    cur: int
    u: Unw
    dbg: bool
    dw: Dwarf
    ipos: [int]
    rows: [DRow]
    entry_main: bool
    entry: (int, int)
    # optimized code (SSA): single definitions dominate their uses
    ssa: bool
    # instructions left out (after a jump, with no label anyone jumps to)
    dead: [bool]

    # ------------------------------------------------------------ bytes
    fn w(ref self, ins: int):
        put32(ref self.o.text, ins & 0xFFFFFFFF)

    fn pos(self) -> int:
        return len(self.o.text)

    # The runtime module's atomics (`atomic_add` etc. in check.br) on the 8
    # bytes at args[0]: load-acquire / store-release, and exclusive-pair loops
    # for the others (no LSE: ARMv8.0 has none), as C compilers make them for
    # sequentially consistent operations.
    fn atomic(ref self, x: Inst):
        if x.s == "brine_cpu_relax":
            # yield
            self.w(0xD503203F)
            return
        let n = x.s[13:]
        let p = self.use(T0, x.args[0])
        var old = T2
        if n == "load":
            # ldar x2, [p]
            self.w(0xC8DFFC00 | (p << 5) | T2)
        elif n == "store":
            let v = self.use(T1, x.args[1])
            # stlr v, [p]
            self.w(0xC89FFC00 | (p << 5) | v)
        elif n == "cas":
            let e = self.use(T1, x.args[1])
            let v = self.use(T2, x.args[2])
            old = T3
            # (if_no_lse uses x12, old's register, before it is set)
            let ll = self.if_no_lse()
            # mov x12, e; casal x12, v, [p]
            self.mov_rr(T3, e)
            self.w(0xC8E0FC00 | (T3 << 16) | (p << 5) | v)
            let e2 = self.fwd(0x14000000)
            self.here(ll, B19)
            let top = self.pos()
            # ldaxr old, [p]; cmp old, e; b.ne done; stlxr w16, v, [p]; cbnz w16, top
            self.w(0xC85FFC00 | (p << 5) | old)
            self.w(0xEB000000 | (e << 16) | (old << 5) | ZR)
            self.w(0x54000000 | (3 << 5) | 1)
            self.w(0xC800FC00 | (IP0 << 16) | (p << 5) | v)
            self.w(0x35000000 | ((((top - self.pos()) / 4) & 0x7FFFF) << 5) | IP0)
            self.here(e2, B26)
        else:
            let v = self.use(T1, x.args[1])
            let ll = self.if_no_lse()
            # ldaddal / swpal v, x11, [p]
            self.w((0xF8E00000 if n == "add" else 0xF8E08000) | (v << 16) | (p << 5) | old)
            let e2 = self.fwd(0x14000000)
            self.here(ll, B19)
            let top = self.pos()
            # ldaxr old, [p]; (add x3, old, v;) stlxr w16, x3 / v, [p]; cbnz w16, top
            self.w(0xC85FFC00 | (p << 5) | old)
            var put = v
            if n == "add":
                put = T3
                self.w(0x8B000000 | (v << 16) | (old << 5) | T3)
            self.w(0xC800FC00 | (IP0 << 16) | (p << 5) | put)
            self.w(0x35000000 | ((((top - self.pos()) / 4) & 0x7FFFF) << 5) | IP0)
            self.here(e2, B26)
        if x.d >= 0:
            self.st(old, x.d)

    fn get32(self, at: int) -> int:
        let t = self.o.text
        return int(t[at]) | (int(t[at + 1]) << 8) | (int(t[at + 2]) << 16) | (int(t[at + 3]) << 24)

    fn reloc(ref self, kind: int, sym: int, add: int):
        self.o.trel.push(ORel(off=self.pos(), sym=sym, kind=kind, add=add))

    # ------------------------------------------------------------ symbols
    fn sym_ref(ref self, name: str) -> int:
        match self.syms.get(name):
            case Some(i):
                return i
            case None:
                let i = len(self.o.syms)
                self.o.syms.push(OSym(name=name, sec=SEC_UNDEF, off=0, global=false, func=false))
                self.syms[name] = i
                return i

    fn sym_def(ref self, name: str, sec: int, off: int, global: bool, func: bool) -> int:
        let i = self.sym_ref(name)
        self.o.syms[i] = OSym(name=name, sec=sec, off=off, global=global, func=func)
        return i

    # The table `tbl` reverses bytes 0..=k of 16 with, at 16 * k: byte t is
    # k - t up to k, then t.
    fn revtab_sym(ref self) -> int:
        let i = self.sym_ref("__brx_revtab")
        if self.o.syms[i].sec != SEC_UNDEF:
            return i
        while len(self.o.rodata) % 16 != 0:
            self.o.rodata.push(0)
        self.o.rodata_align = max(self.o.rodata_align, 16)
        let off = len(self.o.rodata)
        for k in 0..16:
            for t in 0..16:
                self.o.rodata.push(u8(k - t if t <= k else t))
        return self.sym_def("__brx_revtab", SEC_RODATA, off, false, false)

    # The table `tbl` rotates bytes 0..=k of 16 left by one with, at 16 * k:
    # byte t is t + 1 below k, 0 at k, then t.
    fn rotltab_sym(ref self) -> int:
        let i = self.sym_ref("__brx_rotltab")
        if self.o.syms[i].sec != SEC_UNDEF:
            return i
        while len(self.o.rodata) % 16 != 0:
            self.o.rodata.push(0)
        self.o.rodata_align = max(self.o.rodata_align, 16)
        let off = len(self.o.rodata)
        for k in 0..16:
            for t in 0..16:
                self.o.rodata.push(u8(t + 1 if t < k else (0 if t == k else t)))
        return self.sym_def("__brx_rotltab", SEC_RODATA, off, false, false)

    fn ovf_sym(ref self, kind: int) -> int:
        if self.ovf[kind] < 0:
            let names = ["addition", "subtraction", "multiplication"]
            let off = len(self.o.rodata)
            for c in names[kind].bytes():
                self.o.rodata.push(u8(c))
            self.o.rodata.push(0)
            self.ovf[kind] = self.sym_def(f"__brx_ovf_{names[kind]}", SEC_RODATA, off, false, false)
        return self.ovf[kind]

    # ------------------------------------------------------------ instructions
    fn mov_rr(ref self, d: int, s: int):
        if d != s:
            # orr d, xzr, s
            self.w(0xAA0003E0 | (s << 16) | d)

    fn mov_ri(ref self, r: int, v: int):
        if mov_chunks(v) > 1:
            let li = logic_imm(v)
            if li >= 0:
                # orr r, xzr, #v
                self.w(0xB20003E0 | (li << 10) | r)
                return
        # movz with the chunks that aren't 0, or movn with those that aren't ffff
        var zeros = 0
        var ones = 0
        for i in 0..4:
            let c = (v >> (16 * i)) & 0xFFFF
            if c == 0:
                zeros += 1
            elif c == 0xFFFF:
                ones += 1
        let neg = ones > zeros
        let skip = 0xFFFF if neg else 0
        var first = true
        for i in 0..4:
            let c = (v >> (16 * i)) & 0xFFFF
            if c == skip and not (first and i == 3):
                continue
            if first:
                if neg:
                    # movn
                    self.w(0x92800000 | (i << 21) | ((c ^ 0xFFFF) << 5) | r)
                else:
                    # movz
                    self.w(0xD2800000 | (i << 21) | (c << 5) | r)
                first = false
            else:
                # movk
                self.w(0xF2800000 | (i << 21) | (c << 5) | r)

    # d = n + v (d and n may be sp)
    fn add_ri(ref self, d: int, n: int, v: int):
        if v >= 0 and v < 4096:
            self.w(0x91000000 | (v << 10) | (n << 5) | d)
        elif v < 0 and v > -4096:
            self.w(0xD1000000 | ((-v) << 10) | (n << 5) | d)
        elif v > 0 and v < 16777216 and (v & 4095) == 0:
            self.w(0x91400000 | ((v >> 12) << 10) | (n << 5) | d)
        else:
            self.mov_ri(IP0, v)
            # add d, n, x16 (extended register: n may be sp)
            self.w(0x8B206000 | (IP0 << 16) | (n << 5) | d)

    # op d, n, m (shifted register; 31 is xzr)
    fn rrr(ref self, op: int, d: int, n: int, m: int):
        self.w(op | (m << 16) | (n << 5) | d)

    # a load or store of register t at [base + disp] (base may be sp)
    fn ldst(ref self, m: int, t: int, base: int, disp: int):
        let (u, s, sz) = mop(m)
        if disp >= 0 and disp % sz == 0 and disp / sz < 4096:
            self.w(u | ((disp / sz) << 10) | (base << 5) | t)
        elif disp >= -256 and disp < 256:
            self.w(s | ((disp & 511) << 12) | (base << 5) | t)
        else:
            self.add_ri(IP0, base, disp)
            self.w(u | (IP0 << 5) | t)

    # a load or store of register t at the element address p (F_ELEM):
    # [base, index, lsl #log2(size)]
    fn ldst_elem(ref self, m: int, t: int, p: int):
        let e = self.code[self.fval[p]]
        let rb = self.use(T1, e.a)
        let ri = self.use(T2, e.b)
        let (u, _, sz) = mop(m)
        let sh = 1 if e.n == sz and sz > 1 else 0
        # the register-offset form of the unsigned-offset encoding u
        self.w((u & ~0x01000000) | 0x206800 | (ri << 16) | (sh << 12) | (rb << 5) | t)

    # brings r into canonical form for kind k
    fn norm(ref self, r: int, k: K):
        match k:
            case K.I8:
                self.w(0x93401C00 | (r << 5) | r)
            case K.U8 | K.Bool:
                self.w(0xD3401C00 | (r << 5) | r)
            case K.I16:
                self.w(0x93403C00 | (r << 5) | r)
            case K.U16:
                self.w(0xD3403C00 | (r << 5) | r)
            case K.I32:
                self.w(0x93407C00 | (r << 5) | r)
            case K.U32:
                self.w(0xD3407C00 | (r << 5) | r)
            case _:
                pass

    # cmp n, v (an immediate when it fits)
    fn cmp_ri(ref self, n: int, v: int):
        if v >= 0 and v < 4096:
            self.w(0xF100001F | (v << 10) | (n << 5))
        elif v < 0 and v > -4096:
            # cmn
            self.w(0xB100001F | ((-v) << 10) | (n << 5))
        else:
            self.mov_ri(IP0, v)
            self.rrr(0xEB000000, ZR, n, IP0)

    fn cset(ref self, r: int, cc: int):
        # csinc r, xzr, xzr, !cc
        self.w(0x9A9F07E0 | ((cc ^ 1) << 12) | r)

    # fmov between v registers (fl 1: d, 2: s)
    fn fmov(ref self, fl: int, d: int, s: int):
        if d != s:
            self.w((0x1E604000 if fl == 1 else 0x1E204000) | (s << 5) | d)

    # ------------------------------------------------------------ branches
    # The conditional branch code[i] to label l: `yes` is the instruction that
    # jumps when the condition holds, `no` when it doesn't (offsets still 0).
    # When a jump follows and l comes right after it, the branch is flipped
    # and goes to the jump's target instead; likewise when the jump goes back
    # (a loop's next iteration) and the branch forward (out of it). Returns
    # the next instruction's index.
    fn cond_jump(ref self, i: int, yes: int, no: int, l: int) -> int:
        if i + 1 < len(self.code) and self.code[i + 1].op == Op.Jmp and not self.dead[i + 1]:
            let j = self.code[i + 1].n
            if self.falls_to(i + 2, l):
                self.br_label(no, B19, j)
                return i + 2
            if self.lpos[j] >= 0 and self.lpos[l] < 0 and not self.falls_to(i + 2, j):
                self.br_label(no, B19, j)
                self.jmp_label(l)
                return i + 2
        self.br_label(yes, B19, l)
        return i + 1

    # Is x no code at all? (A copy between vregs in the same register.)
    fn no_code(self, x: Inst) -> bool:
        if x.op == Op.Label or x.op == Op.Line:
            return true
        if x.op != Op.Mov or x.d < 0 or x.a < 0 or self.fold[x.a] != F_NONE:
            return x.op == Op.Mov and x.d == x.a
        if self.reg[x.d] >= 0:
            return self.reg[x.d] == self.reg[x.a]
        return self.freg[x.d] >= 0 and self.freg[x.d] == self.freg[x.a]

    # Jumps to a block that only jumps on (an edge's copies all went away in
    # register allocation) go straight to its target; the blocks nothing
    # jumps to any more are then left out.
    fn thread_jumps(ref self, nlabels: int):
        let n = len(self.code)
        var fwd = [-1] * nlabels
        for i, x in enumerate(self.code):
            if x.op == Op.Label:
                var j = i + 1
                while j < n and self.no_code(self.code[j]):
                    j += 1
                if j < n and self.code[j].op == Op.Jmp:
                    fwd[x.n] = self.code[j].n
        var refs = [0] * nlabels
        for i in 0..n:
            var x = self.code[i]
            if x.op == Op.Jmp or x.op == Op.Br or x.op == Op.BrNot:
                var hops = 0
                while fwd[x.n] >= 0 and fwd[x.n] != x.n and hops < 8:
                    x.n = fwd[x.n]
                    hops += 1
                self.code[i] = x
                refs[x.n] += 1
            elif x.op == Op.Switch:
                for l in x.args:
                    refs[l] += 1
        var gone = false
        for i, x in enumerate(self.code):
            if x.op == Op.Label:
                gone = gone and refs[x.n] == 0
            self.dead[i] = gone
            if not gone and (
                x.op == Op.Jmp or x.op == Op.Ret or x.op == Op.Unreachable or x.op == Op.Switch
            ):
                gone = true

    # Does control fall from code[j] on to label l, with no code between?
    fn falls_to(self, j: int, l: int) -> bool:
        var k = j
        while k < len(self.code):
            let x = self.code[k]
            if x.op == Op.Label and x.n == l:
                return true
            if not self.dead[k] and not self.no_code(x):
                return false
            k += 1
        return false

    fn patch(ref self, at: int, to: int, kind: int):
        if kind == W32:
            set32(ref self.o.text, at, (to - at) & 0xFFFFFFFF)
            return
        let off = (to - at) / 4
        var ins = self.get32(at)
        if kind == B26:
            ins = ins | (off & 0x3FFFFFF)
        elif kind == B19:
            ins = ins | ((off & 0x7FFFF) << 5)
        else:
            ins = ins | ((off & 0x3FFF) << 5)
        set32(ref self.o.text, at, ins & 0xFFFFFFFF)

    # a branch (instruction `ins`, its offset field still 0) to label l
    fn br_label(ref self, ins: int, kind: int, l: int):
        let at = self.pos()
        self.w(ins)
        self.to_label(at, kind, l)

    # the branch at `at` (its offset field still 0) to label l
    fn to_label(ref self, at: int, kind: int, l: int):
        if self.lpos[l] >= 0:
            self.patch(at, self.lpos[l], kind)
        else:
            self.jat.push(at)
            self.jlab.push(l)
            self.jkind.push(kind)

    fn jmp_label(ref self, l: int):
        self.br_label(0x14000000, B26, l)

    fn bcc_label(ref self, cc: int, l: int):
        self.br_label(0x54000000 | cc, B19, l)

    # a forward branch inside one instruction's expansion: emit it, then
    # `here` where it lands
    fn fwd(ref self, ins: int) -> int:
        self.w(ins)
        return self.pos() - 4

    fn here(ref self, at: int, kind: int):
        self.patch(at, self.pos(), kind)
        self.st_end = -1

    fn bcc_stub(ref self, cc: int, kind: int, a: int, b: int, c: int):
        self.stubs.push(Stub(at=self.pos(), kind=kind, a=a, b=b, c=c))
        self.w(0x54000000 | cc)

    # ------------------------------------------------------------ vregs
    fn imm(self, v: int) -> bool:
        return self.fold[v] == F_CONST

    # r = the address of symbol s
    fn ld_sym(ref self, r: int, s: int):
        if self.o.syms[s].sec != SEC_UNDEF:
            self.reloc(R_A64_PAGE, s, 0)
            self.w(0x90000000 | r)
            self.reloc(R_A64_LO12, s, 0)
            self.w(0x91000000 | (r << 5) | r)
        else:
            # through the GOT (PIE)
            self.reloc(R_A64_GOT_PAGE, s, 0)
            self.w(0x90000000 | r)
            self.reloc(R_A64_GOT_LO12, s, 0)
            self.w(0xF9400000 | (r << 5) | r)

    # r = the 8 bytes at symbol s + n (n a multiple of 8), as adrp; ldr
    fn ld_sym_x(ref self, r: int, s: int, n: int):
        if self.o.syms[s].sec != SEC_UNDEF:
            self.reloc(R_A64_PAGE, s, n)
            self.w(0x90000000 | r)
            self.reloc(R_A64_LDR12, s, n)
            self.w(0xF9400000 | (r << 5) | r)
        else:
            self.ld_sym(r, s)
            self.ldst(M_LDRX, r, r, n)

    # r = the value of v (64 bits, canonical; the low half of a 128-bit vreg)
    fn ld(ref self, r: int, v: int):
        let f = self.fold[v]
        if f == F_NONE:
            if self.reg[v] >= 0:
                self.mov_rr(r, self.reg[v])
            elif self.freg[v] >= 0:
                # fmov x, d / fmov w, s
                let k = self.vk[v]
                self.w((0x9E660000 if k == K.F64 else 0x1E260000) | (self.freg[v] << 5) | r)
            else:
                self.ldst(M_LDRX, r, SP, self.home[v])
        elif f == F_CONST or f == F_FCONST:
            self.mov_ri(r, self.fval[v])
        elif f == F_SLOT:
            self.add_ri(r, SP, self.slot_off[self.fval[v]])
        else:
            self.ld_sym(r, self.fval[v])

    fn st(ref self, r: int, d: int):
        if self.reg[d] >= 0:
            self.mov_rr(self.reg[d], r)
        elif self.freg[d] >= 0:
            # fmov d, x / fmov s, w
            let k = self.vk[d]
            self.w((0x9E670000 if k == K.F64 else 0x1E270000) | (r << 5) | self.freg[d])
        else:
            self.ldst(M_STRX, r, SP, self.home[d])

    # a register holding v: its own, or r after loading it there
    fn use(ref self, r: int, v: int) -> int:
        if self.fold[v] == F_NONE and self.reg[v] >= 0:
            return self.reg[v]
        self.ld(r, v)
        return r

    # the register to compute d in: its own, or T0
    fn dst(self, d: int) -> int:
        if self.reg[d] >= 0:
            return self.reg[d]
        return T0

    fn set_v(ref self, d: int, v: int):
        if self.reg[d] >= 0:
            self.ld(self.reg[d], v)
        else:
            let r = self.use(T0, v)
            self.st(r, d)

    # v register x = float vreg v
    fn fld(ref self, fl: int, x: int, v: int):
        let r = self.freg[v]
        if r >= 0:
            self.fmov(fl, x, r)
        elif self.fold[v] == F_FCONST:
            self.fconst(fl, x, self.fval[v])
        else:
            self.ldst(M_LDRD if fl == 1 else M_LDRS, x, SP, self.home[v])

    # v register x = the float with bits b
    fn fconst(ref self, fl: int, x: int, b: int):
        let i8 = fmov_imm(b, fl == 1)
        if b == 0:
            # fmov d, xzr / fmov s, wzr
            self.w((0x9E6703E0 if fl == 1 else 0x1E2703E0) | x)
        elif i8 >= 0:
            # fmov d, #imm / fmov s, #imm
            self.w((0x1E601000 if fl == 1 else 0x1E201000) | (i8 << 13) | x)
        else:
            self.mov_ri(IP0, b)
            self.w((0x9E670000 if fl == 1 else 0x1E270000) | (IP0 << 5) | x)

    fn fst(ref self, fl: int, v: int, x: int):
        let r = self.freg[v]
        if r >= 0:
            self.fmov(fl, r, x)
        else:
            self.ldst(M_STRD if fl == 1 else M_STRS, x, SP, self.home[v])

    # a v register holding float vreg v: its own, or x after loading it there
    fn fuse(ref self, fl: int, x: int, v: int) -> int:
        if self.freg[v] >= 0:
            return self.freg[v]
        self.fld(fl, x, v)
        return x

    # the v register to compute float d in
    fn fdst(self, d: int) -> int:
        if self.freg[d] >= 0:
            return self.freg[d]
        return 0

    # The memory at pointer vreg p plus n: (base register, offset). May load
    # p into r.
    fn addr(ref self, p: int, n: int, r: int) -> (int, int):
        if self.fold[p] == F_SLOT:
            return (SP, self.slot_off[self.fval[p]] + n)
        return (self.use(r, p), n)

    fn copy16(ref self, db: int, dd: int, sb: int, sd: int):
        var r = T2
        if (
            sb == SP
            and self.st_end == self.pos()
            and self.st_home == sd
            and db != self.st_lo
            and db != self.st_lo + 1
        ):
            # (just stored from registers: copy from them)
            r = self.st_lo
        else:
            self.ldst(M_LDRX, T2, sb, sd)
            self.ldst(M_LDRX, T3, sb, sd + 8)
        self.ldst(M_STRX, r, db, dd)
        self.ldst(M_STRX, r + 1, db, dd + 8)
        if db == SP:
            self.st_end = self.pos()
            self.st_lo = r
            self.st_home = dd

    # copies 128-bit vreg s to d
    fn copy_v16(ref self, d: int, s: int):
        self.copy16(SP, self.home[d], SP, self.home[s])

    # ------------------------------------------------------------ calls
    # Each argument's location (see L_*) and the bytes of stack arguments.
    fn arg_locs(self, fls: [int]) -> ([int], int):
        var out: [int] = []
        var ni = 0
        var nf = 0
        var ns = 0
        for fl in fls:
            if fl != 0 and nf < 8:
                out.push(L_V + nf)
                nf += 1
            elif fl == 0 and ni < 8:
                out.push(ni)
                ni += 1
            else:
                out.push(L_STACK + ns)
                ns += 8
        return (out, ns)

    fn arg_int(ref self, r: int, a: CArg):
        match a.how:
            case 0:
                self.ld(r, a.v)
            case 1:
                self.add_ri(r, SP, self.home[a.v])
            case 2:
                self.mov_ri(r, a.v)
            case 3:
                self.ld_sym(r, a.v)
            case _:
                self.add_ri(r, SP, a.v)

    # calls symbol `sym` (or, with sym < 0, the pointer in vreg fp)
    fn do_call(ref self, sym: int, fp: int, args: [CArg]):
        var fls: [int] = []
        for a in args:
            fls.push(a.fl)
        let (locs, _) = self.arg_locs(fls)
        for i, a in enumerate(args):
            let l = locs[i]
            if l >= L_STACK:
                if a.fl != 0:
                    self.fld(a.fl, 0, a.v)
                    self.ldst(M_STRD if a.fl == 1 else M_STRS, 0, SP, l - L_STACK)
                else:
                    self.arg_int(T0, a)
                    self.ldst(M_STRX, T0, SP, l - L_STACK)
        for i, a in enumerate(args):
            let l = locs[i]
            if l >= L_STACK:
                pass
            elif l >= L_V:
                self.fld(a.fl, l - L_V, a.v)
            else:
                self.arg_int(l, a)
        if sym >= 0:
            self.reloc(R_A64_CALL26, sym, 0)
            self.w(0x94000000)
        else:
            # blr (fp is in no argument register)
            self.w(0xD63F0000 | (self.use(T0, fp) << 5))

    fn call_rt(ref self, name: str, args: [CArg]):
        let s = self.sym_ref(name)
        self.do_call(s, -1, args)

    # stores the result of a call (in x0 / v0) to d
    fn store_ret(ref self, d: int):
        let k = self.vk[d]
        if k.is_float():
            self.fst(fl_of(k), d, 0)
        elif not k.is_wide():
            self.norm(0, k)
            self.st(0, d)

    # Does the call return a 128-bit value (through a hidden first argument)?
    fn wide_call(self, x: Inst) -> bool:
        if x.d >= 0:
            return self.vk[x.d].is_wide()
        if x.op == Op.CallInd:
            return self.fold[x.a] == F_GLOBAL and self.o.syms[self.fval[x.a]].name in self.wide_ret
        if x.b == 1:
            return x.s in self.wide_rt
        return x.s in self.wide_ret

    # Reference counting inline, as in brine_rt.h: a negative count is
    # immortal (strings and boxes), a count of 1 is ours alone, and changes
    # are exclusive load / store loops.
    # A cbnz to patch (B19) taken when other threads may touch values
    # (`brine_mt`, see brine_rt.h): only then do counts need exclusive
    # loads and stores. Uses x12.
    fn if_mt(ref self) -> int:
        self.ld_sym_x(T3, self.sym_ref("brine_mt"), 0)
        return self.fwd(0xB5000000 | T3)

    # A cbz to patch (B19) taken when the CPU lacks ARMv8.1's atomic
    # instructions (`brine_lse`, see rt.br). Uses x12.
    fn if_no_lse(ref self) -> int:
        self.ld_sym_x(T3, self.sym_ref("brine_lse"), 0)
        return self.fwd(0xB4000000 | T3)

    # As if_no_lse, but right where if_mt jumped to (x12 is still brine_mt,
    # odd on a CPU without them, see rt.br): a tbnz to patch (B14).
    fn if_no_lse_mt(ref self) -> int:
        return self.fwd(0x37000000 | T3)

    fn inline_rc(ref self, x: Inst) -> bool:
        let n = x.s
        let retain = (
            n == "brine_str_retain"
            or n == "brine_arr_retain"
            or n == "brine_map_retain"
            or n == "brine_box_retain"
        )
        var free = ""
        if n == "brine_str_release":
            free = "brine_str_free"
        elif n == "brine_arr_release":
            free = "brine_arr_free"
        elif n == "brine_map_release":
            free = "brine_map_free"
        elif not retain and n != "brine_box_dec":
            return false
        let p = x.args[0]
        let b = self.use(T1, p)
        let immortal = (
            n == "brine_str_retain"
            or n == "brine_str_release"
            or n == "brine_box_retain"
            or n == "brine_box_dec"
        )
        if retain:
            var skip = -1
            self.ldst(M_LDRX, T0, b, 0)
            if immortal:
                # tbnz x9, #63
                skip = self.fwd(0xB7F80000 | T0)
            let shared = self.if_mt()
            # a plain add unless other threads may hold the value
            self.w(0x91000400 | (T0 << 5) | T0)
            self.ldst(M_STRX, T0, b, 0)
            let e = self.fwd(0x14000000)
            self.here(shared, B19)
            let ll = self.if_no_lse_mt()
            # mov x9, #1; stadd x9, [b]
            self.mov_ri(T0, 1)
            self.w(0xF820001F | (T0 << 16) | (b << 5))
            let e2 = self.fwd(0x14000000)
            self.here(ll, B14)
            let top = self.pos()
            # ldxr x9, [b]; add x9, x9, #1; stxr w11, x9, [b]; cbnz w11, top
            self.w(0xC85F7C00 | (b << 5) | T0)
            self.w(0x91000400 | (T0 << 5) | T0)
            self.w(0xC8007C00 | (T2 << 16) | (b << 5) | T0)
            self.w(0x35000000 | ((((top - self.pos()) / 4) & 0x7FFFF) << 5) | T2)
            self.here(e, B26)
            self.here(e2, B26)
            if skip >= 0:
                self.here(skip, B14)
            return true
        var done: [int] = []
        var frees: [int] = []
        # one thread: a plain load, and no acquire (ldar) to wait for
        let shared = self.if_mt()
        self.ldst(M_LDRX, T0, b, 0)
        if immortal:
            done.push(self.fwd(0xB7F80000 | T0))
        # subs x9, x9, #1
        self.w(0xF1000400 | (T0 << 5) | T0)
        if n == "brine_map_release":
            # (a map is freed with its count stored as 0)
            self.ldst(M_STRX, T0, b, 0)
            done.push(self.fwd(0x54000000 | C_NE))
            frees.push(self.fwd(0x14000000))
        else:
            frees.push(self.fwd(0x54000000 | C_EQ))
            self.ldst(M_STRX, T0, b, 0)
            done.push(self.fwd(0x14000000))
        self.here(shared, B19)
        # ldar x9, [b]
        self.w(0xC8DFFC00 | (b << 5) | T0)
        if immortal:
            done.push(self.fwd(0xB7F80000 | T0))
        if n != "brine_map_release":
            # the only reference: no other thread can change the count
            self.cmp_ri(T0, 1)
            frees.push(self.fwd(0x54000000 | C_EQ))
        let ll = self.if_no_lse_mt()
        # mov x9, #-1; ldaddal x9, x9, [b]; cmp x9, #1 (the count before)
        self.mov_ri(T0, -1)
        self.w(0xF8E00000 | (T0 << 16) | (b << 5) | T0)
        self.cmp_ri(T0, 1)
        done.push(self.fwd(0x54000000 | C_NE))
        frees.push(self.fwd(0x14000000))
        self.here(ll, B14)
        let top = self.pos()
        # ldaxr x9, [b]; sub x9, x9, #1; stlxr w11, x9, [b]; cbnz w11, top
        self.w(0xC85FFC00 | (b << 5) | T0)
        self.w(0xD1000400 | (T0 << 5) | T0)
        self.w(0xC800FC00 | (T2 << 16) | (b << 5) | T0)
        self.w(0x35000000 | ((((top - self.pos()) / 4) & 0x7FFFF) << 5) | T2)
        # cbnz x9, done
        done.push(self.fwd(0xB5000000 | T0))
        for at in frees:
            self.here(at, B26 if self.get32(at) >> 26 == 5 else B19)
        if n == "brine_box_dec" and self.dec_br >= 0:
            let br = self.code[self.dec_br]
            if br.op == Op.Br:
                self.jmp_label(br.n)
                for at in done:
                    self.here(at, done_kind(self.get32(at)))
            else:
                # (straight to the label, but a tbnz reaches only 32 KiB)
                var near: [int] = []
                for at in done:
                    let k = done_kind(self.get32(at))
                    if k == B14:
                        near.push(at)
                    else:
                        self.to_label(at, k, br.n)
                if len(near) > 0:
                    let over = self.fwd(0x14000000)
                    for at in near:
                        self.here(at, B14)
                    self.jmp_label(br.n)
                    self.here(over, B26)
            return true
        if n == "brine_box_dec":
            self.mov_ri(T0, 1)
            let over = self.fwd(0x14000000)
            for at in done:
                self.here(at, done_kind(self.get32(at)))
            self.mov_ri(T0, 0)
            self.here(over, B26)
            if x.d >= 0:
                self.st(T0, x.d)
            return true
        self.call_rt(free, [CArg(how=A_VAL, v=p, fl=0)])
        for at in done:
            self.here(at, done_kind(self.get32(at)))
        return true

    fn ir_call(ref self, x: Inst):
        if x.op == Op.Call and x.b == 1 and self.inline_rc(x):
            return
        if (
            x.op == Op.Call
            and x.b == 1
            and (x.s == "brine_f_sqrt" or x.s == "brine_f_sqrtf")
            and x.d >= 0
        ):
            let fl = fl_of(self.vk[x.d])
            let s = self.fuse(fl, 0, x.args[0])
            let r = self.fdst(x.d)
            # fsqrt
            self.w((0x1E61C000 if fl == 1 else 0x1E21C000) | (s << 5) | r)
            self.fst(fl, x.d, r)
            return
        if x.op == Op.Call and x.b == 1 and x.s == "brine_thread_ptr" and x.d >= 0:
            let r = self.dst(x.d)
            # mrs r, tpidr_el0
            self.w(0xD53BD040 | r)
            self.st(r, x.d)
            return
        if (
            x.op == Op.Call
            and x.b == 1
            and (x.s.starts_with("brine_atomic_") or x.s == "brine_cpu_relax")
        ):
            self.atomic(x)
            return
        if x.op == Op.Call and x.b == 1 and x.s == "brine_bytes_rev" and x.d >= 0:
            self.bytes_rev(x)
            return
        if x.op == Op.Call and x.b == 1 and x.s == "brine_bytes_rev0" and x.d >= 0:
            self.bytes_rev0(x)
            return
        if x.op == Op.Call and x.b == 1 and x.s == "brine_bytes_rotl" and x.d >= 0:
            self.bytes_rotl(x)
            return
        if x.op == Op.Call and x.b == 1 and x.s == "brine_bytes_copy" and x.d >= 0:
            self.bytes_copy(x)
            return
        if (
            x.op == Op.Call
            and x.b == 1
            and (x.s == "brine_clz_u64" or x.s == "brine_ctz_u64" or x.s == "brine_bswap_u64")
            and x.d >= 0
        ):
            let r = self.dst(x.d)
            let ra = self.use(T0, x.args[0])
            if x.s == "brine_bswap_u64":
                # rev
                self.w(0xDAC00C00 | (ra << 5) | r)
            elif x.s == "brine_clz_u64":
                # clz (64 for 0, as the runtime's)
                self.w(0xDAC01000 | (ra << 5) | r)
            else:
                # rbit, then clz
                self.w(0xDAC00000 | (ra << 5) | r)
                self.w(0xDAC01000 | (r << 5) | r)
            self.st(r, x.d)
            return
        if x.op == Op.Call and x.b == 1 and x.s == "brine_umulh_u64" and x.d >= 0:
            let r = self.dst(x.d)
            let ra = self.use(T0, x.args[0])
            let rb = self.use(T1, x.args[1])
            # umulh r, ra, rb
            self.w(0x9BC07C00 | (rb << 16) | (ra << 5) | r)
            self.st(r, x.d)
            return
        let keep = self.keep[self.cur] if len(self.keep) > 0 else []
        for j, v in enumerate(keep):
            if self.reg[v] >= 0:
                self.ldst(M_STRX, self.reg[v], SP, self.keep_off + 8 * j)
            else:
                self.ldst(M_STRD, self.freg[v], SP, self.keep_off + 8 * j)
        self.rt_call(x)
        for j, v in enumerate(keep):
            if self.reg[v] >= 0:
                self.ldst(M_LDRX, self.reg[v], SP, self.keep_off + 8 * j)
            else:
                self.ldst(M_LDRD, self.freg[v], SP, self.keep_off + 8 * j)

    # the call itself, to the runtime's version or the function
    fn rt_call(ref self, x: Inst):
        var args: [CArg] = []
        let ind = x.op == Op.CallInd
        var name = x.s
        if not ind and x.b == 1:
            name = "brine_x_" + x.s[6:]
        if self.wide_call(x):
            if x.d >= 0:
                args.push(CArg(how=A_ADDR, v=x.d, fl=0))
            else:
                args.push(CArg(how=A_FRAME, v=self.scratch, fl=0))
        for a in x.args:
            let k = self.vk[a]
            if k.is_wide():
                args.push(CArg(how=A_ADDR, v=a, fl=0))
            else:
                args.push(CArg(how=A_VAL, v=a, fl=fl_of(k)))
        if not ind:
            let s = self.sym_ref(name)
            self.do_call(s, -1, args)
        elif self.fold[x.a] == F_GLOBAL:
            self.do_call(self.fval[x.a], -1, args)
        else:
            self.do_call(-1, x.a, args)
        if x.d >= 0:
            self.store_ret(x.d)

    # stack argument bytes a call needs
    fn call_stack(self, x: Inst) -> int:
        var fls: [int] = []
        if self.wide_call(x):
            fls.push(0)
        for a in x.args:
            fls.push(fl_of(self.vk[a]))
        let (_, n) = self.arg_locs(fls)
        return n

    # ------------------------------------------------------------ functions
    fn func(ref self, f0: Func):
        let f = split_consts(f0) if self.ssa and not self.dbg else f0
        let nv = len(f.vk)
        self.code = f.code
        self.vk = f.vk
        self.nparams = f.nparams
        self.has_ret = f.has_ret
        self.ret = f.ret
        self.fold = [0] * nv
        self.fval = [0] * nv
        self.wshift = [-1] * nv
        self.home = [0] * nv
        self.nuse = [0] * nv
        self.lpos = [-1] * f.nlabels
        self.jat = []
        self.jlab = []
        self.jkind = []
        self.stubs = []
        var ndef = [0] * nv
        var dpos = [0] * nv
        for i in 0..f.nparams:
            ndef[i] = 1
        let ncode = len(f.code)
        for i in 0..ncode:
            let x = f.code[i]
            if x.d >= 0:
                ndef[x.d] += 1
                dpos[x.d] = i
            if x.a >= 0 and x.a < nv:
                self.nuse[x.a] += 1
            # (a call's b is a flag, not a vreg)
            if x.b >= 0 and x.b < nv and x.op != Op.Call:
                self.nuse[x.b] += 1
            if x.c >= 0 and x.c < nv:
                self.nuse[x.c] += 1
            if x.op == Op.Call or x.op == Op.CallInd:
                for a in x.args:
                    self.nuse[a] += 1
        # (in SSA code, constants an instruction can't take as an immediate,
        # like the 1 of `1 << n`, can have a register too)
        var reg_k = [false] * nv
        if self.ssa:
            for x in f.code:
                match x.op:
                    case Op.Sub | Op.Shl | Op.Shr:
                        reg_k[x.a] = true
                    case Op.Mul | Op.Div | Op.Rem:
                        reg_k[x.a] = true
                        reg_k[x.b] = true
                    case _:
                        pass
        for v in f.nparams..nv:
            if ndef[v] == 1:
                let x = f.code[dpos[v]]
                let k = f.vk[v]
                if x.op == Op.Const and k.is_wide():
                    self.wshift[v] = x.n & 127
                # (in SSA code, constants that take more than one
                # instruction are made once, in a register)
                if (
                    x.op == Op.Const
                    and not k.is_float()
                    and not k.is_wide()
                    and (not self.ssa or (mov_cost(canon(x.n, k)) == 1 and not reg_k[v]))
                ):
                    self.fold[v] = F_CONST
                    self.fval[v] = canon(x.n, k)
                elif x.op == Op.SlotAddr:
                    self.fold[v] = F_SLOT
                    self.fval[v] = x.a
                elif x.op == Op.Global:
                    self.fold[v] = F_GLOBAL
                    self.fval[v] = self.sym_ref(x.s)
        for i in 0..ncode - 1:
            let x = f.code[i]
            if (
                x.op != Op.Elem
                or self.nuse[x.d] != 1
                or ndef[x.d] != 1
                or self.fold[x.d] != F_NONE
                or self.imm(x.b)
            ):
                continue
            let y = f.code[i + 1]
            var k = K.I64
            if y.op == Op.Load and y.a == x.d and y.n == 0:
                k = f.vk[y.d]
            elif y.op == Op.Store and y.a == x.d and y.b != x.d and y.n == 0:
                k = f.vk[y.b]
            else:
                continue
            if not k.is_wide() and (x.n == 1 or x.n == k.size()):
                self.fold[x.d] = F_ELEM
                self.fval[x.d] = i
        for i in 1..ncode:
            let x = f.code[i]
            let y = f.code[i - 1]
            if x.op != Op.And or y.op != Op.Not or (y.d != x.a and y.d != x.b) or x.a == x.b:
                continue
            let k = f.vk[x.d]
            if (
                k.is_float()
                or k.is_wide()
                or k == K.Bool
                or f.vk[y.d] != k
                or self.nuse[y.d] != 1
                or ndef[y.d] != 1
            ):
                continue
            self.fold[y.d] = F_NOT
            self.fval[y.d] = y.a
        for i in 1..ncode:
            let x = f.code[i]
            let y = f.code[i - 1]
            if x.op != Op.Add or y.op != Op.Mul or (y.d != x.a and y.d != x.b) or x.a == x.b:
                continue
            let k = f.vk[x.d]
            if (
                (k != K.I64 and k != K.U64)
                or f.vk[y.d] != k
                or self.nuse[y.d] != 1
                or ndef[y.d] != 1
                or self.fold[y.d] != F_NONE
            ):
                continue
            self.fold[y.d] = F_MUL
            self.fval[y.d] = i - 1
        var out_bytes = 0
        for x in f.code:
            if x.op == Op.Call or x.op == Op.CallInd:
                out_bytes = max(out_bytes, self.call_stack(x))
        self.reg = [-1] * nv
        self.freg = [-1] * nv
        self.saved = []
        self.fsaved = []
        self.keep = []
        if not self.dbg:
            var ok = [false] * nv
            for v in 0..nv:
                ok[v] = (
                    self.fold[v] == F_NONE
                    and not f.vk[v].is_wide()
                    and (ndef[v] > 0 or v < f.nparams)
                )
            # a compare fused into the next branch never lives anywhere
            for i in 0..ncode - 1:
                let x = f.code[i]
                if (
                    (
                        x.op == Op.Eq
                        or x.op == Op.Ne
                        or x.op == Op.Lt
                        or x.op == Op.Le
                        or x.op == Op.Gt
                        or x.op == Op.Ge
                    )
                    and self.nuse[x.d] == 1
                ):
                    let y = f.code[i + 1]
                    if (y.op == Op.Br or y.op == Op.BrNot) and y.a == x.d:
                        ok[x.d] = false
            let r = ra64.allocate(f, ok, self.cold)
            self.reg = r.reg
            self.freg = r.freg
            self.saved = r.saved
            self.fsaved = r.fsaved
            self.keep = r.keep
            # a constant with no register is made again where it's used,
            # rather than kept in the frame
            for v in f.nparams..nv:
                if not ok[v] or ndef[v] != 1 or self.reg[v] >= 0 or self.freg[v] >= 0:
                    continue
                let x = f.code[dpos[v]]
                let k = f.vk[v]
                if x.op == Op.Const:
                    self.fold[v] = F_CONST
                    self.fval[v] = canon(x.n, k)
                elif x.op == Op.FConst:
                    self.fold[v] = F_FCONST
                    self.fval[v] = x.n & 0xFFFFFFFF if k == K.F32 else x.n
        let hidden = f.has_ret and f.ret.is_wide()
        var fls: [int] = []
        if hidden:
            fls.push(0)
        for i in 0..f.nparams:
            let k = f.vk[i]
            fls.push(0 if k.is_wide() else fl_of(k))
        let (pl, _) = self.arg_locs(fls)
        self.ploc = pl
        # frame layout, from sp up: outgoing arguments, homes, slots
        var off = align_up(out_bytes, 16)
        if hidden:
            self.retp = off
            off += 8
        for v in 0..nv:
            if (
                self.fold[v] != F_NONE
                or self.reg[v] >= 0
                or self.freg[v] >= 0
                or (ndef[v] == 0 and self.nuse[v] == 0)
            ):
                continue
            if f.vk[v].is_wide():
                off = align_up(off, 16)
                self.home[v] = off
                off += 16
            else:
                self.home[v] = off
                off += 8
        var realign = 16
        self.slot_off = []
        for s in f.slots:
            let a = 1 << log2(max(s.align, 1))
            off = align_up(off, a)
            self.slot_off.push(off)
            off += s.size
            realign = max(realign, a)
        off = align_up(off, 16)
        self.scratch = off
        off += 16
        self.keep_off = off
        for l in self.keep:
            off = max(off, self.keep_off + 8 * len(l))
        let nsave = len(self.saved) + len(self.fsaved)
        let frame = align_up(off, 16) + align_up(8 * nsave, 16) + realign - 16
        # prologue
        while len(self.o.text) % 16 != 0:
            # nop
            self.w(0xD503201F)
        self.sym_def(f.name, SEC_TEXT, self.pos(), f.public or f.export, true)
        self.u = Unw(start=self.pos(), fp=0, pro_end=0, epis=[])
        # stp x29, x30, [sp, #-16]!; mov x29, sp
        self.w(0xA9BF7BFD)
        self.w(0x910003FD)
        self.u.fp = self.pos()
        var rest = frame
        if frame >= 4096:
            # touch each page in order (the guard page below a thread's stack)
            self.mov_ri(IP0, frame / 4096)
            let top = self.pos()
            # sub sp, sp, #4096; str xzr, [sp]; subs x16, x16, #1; b.ne top
            self.w(0xD14007FF)
            self.w(0xF90003FF)
            self.w(0xF1000610)
            self.w(0x54000000 | ((((top - self.pos()) / 4) & 0x7FFFF) << 5) | C_NE)
            rest = frame % 4096
        if rest > 0:
            self.add_ri(SP, SP, -rest)
        if realign > 16:
            # mov x16, sp; and sp, x16, #-realign
            self.w(0x910003F0)
            let k = log2(realign)
            self.w(0x92400000 | (((64 - k) & 63) << 16) | ((63 - k) << 10) | (IP0 << 5) | SP)
        self.save_regs(false)
        self.u.pro_end = self.pos()
        self.store_params(f)
        # body
        self.ipos = [-1] * (ncode + 1)
        self.rows = []
        if self.dbg and f.dline > 0 and not f.dfile.starts_with("<"):
            let fi = self.dw.file(f.dfile)
            self.rows.push(DRow(pc=self.u.start, file=fi, line=f.dline))
        self.dead = [false] * ncode
        if not self.dbg:
            self.thread_jumps(f.nlabels)
        var i = 0
        while i < ncode:
            if self.dead[i]:
                i += 1
                continue
            self.cur = i
            self.ipos[i] = self.pos()
            i = self.inst(i)
        self.ipos[ncode] = self.pos()
        if ncode == 0 or not (
            f.code[ncode - 1].op == Op.Ret
            or f.code[ncode - 1].op == Op.Jmp
            or f.code[ncode - 1].op == Op.Unreachable
            or f.code[ncode - 1].op == Op.Switch
        ):
            self.epilogue()
        # cold stubs
        for s in self.stubs:
            self.here(s.at, B19)
            if s.kind == S_IDX:
                self.call_rt(
                    "brine_panic_idx",
                    [
                        CArg(how=A_VAL, v=s.a, fl=0),
                        CArg(how=A_VAL, v=s.b, fl=0),
                        CArg(how=A_VAL, v=s.c, fl=0)
                    ]
                )
            else:
                let msg = self.ovf_sym(s.kind)
                self.call_rt(
                    "brine_panic_ovf",
                    [CArg(how=A_SYM, v=msg, fl=0), CArg(how=A_VAL, v=s.c, fl=0)]
                )
        for j in 0..len(self.jat):
            self.patch(self.jat[j], self.lpos[self.jlab[j]], self.jkind[j])
        self.unwind_elf()
        if self.dbg:
            self.debug_func(f)

    # ------------------------------------------------------------ kernels
    # A vector kernel (xkern.br) for SSE2's two-lane xmm registers, in NEON:
    # xmm i is v i, so float parameters come in where the kernel wants them,
    # and v30 / v31 are scratch. Array pointers stay in x0-x3. A scalar SSE2
    # operation keeps the upper lane, so it goes through v31 and an `ins`.
    fn kernel(ref self, k: KFunc):
        self.saved = []
        self.fsaved = []
        for r in k.regs:
            if r >= 8 and r < 16:
                self.fsaved.push(r)
        let fs = align_up(8 * len(self.fsaved), 16)
        let frame = fs + 16 * k.nslots
        while len(self.o.text) % 16 != 0:
            self.w(0xD503201F)
        self.sym_def(k.name, SEC_TEXT, self.pos(), false, true)
        self.u = Unw(start=self.pos(), fp=0, pro_end=0, epis=[])
        # stp x29, x30, [sp, #-16]!; mov x29, sp
        self.w(0xA9BF7BFD)
        self.w(0x910003FD)
        self.u.fp = self.pos()
        if frame > 0:
            self.add_ri(SP, SP, -frame)
        self.save_regs(false)
        self.u.pro_end = self.pos()
        if k.loop:
            self.kernel_loop(k)
        else:
            let hd = hi_dead(k.ops)
            let el = kmul_lanes(k.ops, hd, k.has_ret)
            var i = 0
            while i < len(k.ops):
                if el[i] == -2:
                    i += 1
                    continue
                if (
                    k.ops[i].op == KO_MOV
                    and i + 1 < len(k.ops)
                    and self.kop_from(k.ops[i + 1], k.ops[i].b, k.ops[i].a, hd[i + 1], el[i + 1])
                ):
                    i += 2
                    continue
                if i + 1 < len(k.ops) and self.kop_pair(k.ops[i], k.ops[i + 1]):
                    i += 2
                    continue
                if el[i] >= 0:
                    let o = k.ops[i]
                    self.kmul_el(o.a, el[i] >> 6, el[i], o.m == PFX_PD, hd[i])
                    i += 1
                    continue
                self.kop(k.ops[i], k.nslots, hd[i])
                i += 1
        self.epilogue()
        self.unwind_elf()

    # A loop kernel (vloop.br), its two-lane path: the block stays in x0, the
    # arrays' addresses go in x1-x3, x8 counts the elements done (returned).
    fn kernel_loop(ref self, k: KFunc):
        # movz x8, #0
        self.w(0xD2800008)
        for i in 0..k.narr:
            self.ldst(M_LDRX, 1 + i, 0, 8 * i)
        var outs: [int] = []
        for o in k.ops:
            # KO_CHK: out when 0 < (b + n) - a < 8m: x17 = that - 1, unsigned
            self.add_ri(17, 1 + o.b, o.n - 1)
            self.rrr(0xCB000000, 17, 17, 1 + o.a)
            self.cmp_ri(17, 8 * o.m - 2)
            outs.push(self.fwd(0x54000000 | C_LS))
        for t in k.paths:
            if t.w == 2:
                self.kpath(t, k.narr)
        for at in outs:
            self.here(at, B19)
        self.mov_rr(0, 8)

    # x9 is the count rounded down to a multiple of 2 (x10: of 4, for the
    # body twice over when it can be); x11 + i holds array i's element x8
    fn kpath(ref self, t: KPath, narr: int):
        self.kvs(t.pre, false)
        let body = no_copies(t.body)
        let twice = unroll2(t, body)
        self.ldst(M_LDRX, 9, 0, 8 * narr)
        if len(twice) > 0:
            # ands x10, x9, #-4; b.le skip
            self.w(0xF2000000 | (logic_imm(-4) << 10) | (9 << 5) | 10)
            let skip = self.fwd(0x54000000 | C_LE)
            let top = self.pos()
            self.kvs(twice, true)
            self.add_ri(8, 8, 4)
            self.rrr(0xEB000000, ZR, 8, 10)
            self.w(0x54000000 | ((((top - self.pos()) / 4) & 0x7FFFF) << 5) | C_LT)
            self.here(skip, B19)
        # and x9, x9, #-2; cmp x8, x9; b.ge skip
        self.w(0x92000000 | (logic_imm(-2) << 10) | (9 << 5) | 9)
        self.rrr(0xEB000000, ZR, 8, 9)
        let skip = self.fwd(0x54000000 | C_GE)
        let top = self.pos()
        self.kvs(body, true)
        self.add_ri(8, 8, 2)
        self.rrr(0xEB000000, ZR, 8, 9)
        self.w(0x54000000 | ((((top - self.pos()) / 4) & 0x7FFFF) << 5) | C_LT)
        self.here(skip, B19)
        self.kvs(t.post, false)

    # Operations of a two-lane path; in a loop body, first the address of
    # each array's element x8 into x11 + i.
    fn kvs(ref self, ops: [KOp], body: bool):
        if body:
            var done: [bool] = []
            for o in ops:
                if o.op == KV_LD or o.op == KV_ST:
                    while len(done) <= o.b:
                        done.push(false)
                    if not done[o.b]:
                        done[o.b] = true
                        assert o.b < 5, "a64: a loop kernel of more than five arrays"
                        # add x11+b, x1+b, x8, lsl #3
                        self.w(0x8B000000 | (8 << 16) | (3 << 10) | ((1 + o.b) << 5) | (11 + o.b))
        for o in ops:
            self.kv(o)

    # One operation of a two-lane path; x0 holds the block.
    fn kv(ref self, o: KOp):
        let a = o.a
        match o.op:
            case KV_BCF:
                # ldr da, [x0, #8n]; dup va.2d, va.d[0]
                self.ldst(M_LDRD, a, 0, 8 * o.n)
                self.w(0x4E080400 | (a << 5) | a)
            case KV_LD | KV_ST:
                # [x11+b + n], x11+b array b's element x8
                self.ldst(M_LDRQ if o.op == KV_LD else M_STRQ, a, 11 + o.b, o.n)
            case KV_MOV:
                self.w(0x4EA01C00 | (o.b << 16) | (o.b << 5) | a)
            case KV_FOP:
                var op = 0x4E60D400
                if o.n == 0x5C:
                    op = 0x4EE0D400
                elif o.n == 0x59:
                    op = 0x6E60DC00
                elif o.n == 0x5E:
                    op = 0x6E60FC00
                else:
                    assert o.n == 0x58, f"a64: loop kernel opcode {o.n}"
                self.w(op | (o.m << 16) | (o.b << 5) | a)
            case KV_RLD:
                self.ldst(M_LDRD, a, 0, 8 * o.n)
            case KV_RST:
                self.ldst(M_STRD, a, 0, 8 * o.n)
            case KV_RED:
                # a = (a op b[0]) op b[1]
                var op = 0x1E602800
                if o.n == 0x5C:
                    op = 0x1E603800
                elif o.n == 0x59:
                    op = 0x1E600800
                elif o.n == 0x5E:
                    op = 0x1E601800
                self.w(op | (o.b << 16) | (a << 5) | a)
                # dup d31, vb.d[1]
                self.w(0x5E180400 | (o.b << 5) | 31)
                self.w(op | (31 << 16) | (a << 5) | a)
            case _:
                assert false, f"a64: loop kernel operation {o.op} (more than two lanes)"

    # Two loads or stores of neighbouring doubles in one instruction: x's at
    # [b + n], y's at [b + n + 8]. False when they aren't such a pair.
    fn kop_pair(ref self, x: KOp, y: KOp) -> bool:
        if y.op != x.op or y.b != x.b or y.n != x.n + 8 or x.n % 8 != 0 or x.n < -512 or x.n > 496:
            return false
        let imm = (x.n / 8) & 0x7F
        match x.op:
            case KO_LD:
                if x.a == y.a:
                    return false
                # ldp dx, dy, [b, #n]
                self.w(0x6D400000 | (imm << 15) | (y.a << 10) | (x.b << 5) | x.a)
            case KO_ST:
                if x.m != 0 or y.m != 0:
                    return false
                # stp dx, dy, [b, #n]
                self.w(0x6D000000 | (imm << 15) | (y.a << 10) | (x.b << 5) | x.a)
            case KO_STH:
                # zip2 v31.2d, vx.2d, vy.2d; str q31, [b + n]
                self.w(0x4EC07800 | (y.a << 16) | (x.a << 5) | 31)
                self.ldst(M_STRQ, 31, x.b, x.n)
            case _:
                return false
        return true

    # (hd: nothing reads a's upper lane after o, so a scalar operation can
    # clear it)
    fn kop(ref self, o: KOp, nslots: int, hd: bool):
        let a = o.a
        match o.op:
            case KO_MOV:
                # orr va.16b, vb.16b, vb.16b
                self.w(0x4EA01C00 | (o.b << 16) | (o.b << 5) | a)
            case KO_LD:
                self.ldst(M_LDRD, a, o.b, o.n)
            case KO_LDP:
                self.ldst(M_LDRQ, a, o.b, o.n)
            case KO_LDH:
                # ldr d31, [b + n]; ins va.d[1], v31.d[0]
                self.ldst(M_LDRD, 31, o.b, o.n)
                self.w(0x6E180400 | (31 << 5) | a)
            case KO_ST:
                # (m = 1: both lanes)
                self.ldst(M_STRQ if o.m == 1 else M_STRD, a, o.b, o.n)
            case KO_STH:
                # dup d31, va.d[1]; str d31, [b + n]
                self.w(0x5E180400 | (a << 5) | 31)
                self.ldst(M_STRD, 31, o.b, o.n)
            case KO_OP:
                self.kop_arith(o, hd)
            case KO_SQRT:
                if o.m == PFX_PD:
                    # fsqrt va.2d, vb.2d
                    self.w(0x6EE1F800 | (o.b << 5) | a)
                elif hd:
                    # fsqrt da, db
                    self.w(0x1E61C000 | (o.b << 5) | a)
                else:
                    # fsqrt d31, db; ins va.d[0], v31.d[0]
                    self.w(0x1E61C000 | (o.b << 5) | 31)
                    self.w(0x6E080400 | (31 << 5) | a)
            case KO_SHUF:
                # shufpd: low lane a[n & 1], high lane b[n >> 1]
                match o.n & 3:
                    case 0:
                        # zip1 va.2d, va.2d, vb.2d
                        self.w(0x4EC03800 | (o.b << 16) | (a << 5) | a)
                    case 1:
                        # ext va.16b, va.16b, vb.16b, #8
                        self.w(0x6E004000 | (o.b << 16) | (a << 5) | a)
                    case 2:
                        # ins va.d[1], vb.d[1]
                        self.w(0x6E184400 | (o.b << 5) | a)
                    case _:
                        # zip2 va.2d, va.2d, vb.2d
                        self.w(0x4EC07800 | (o.b << 16) | (a << 5) | a)
            case KO_CONST:
                # (a scalar write clears the upper lane, as movsd's load does)
                self.fconst(1, a, o.n)
            case KO_CONST2:
                self.fconst(1, a, o.n)
                if o.m != 0:
                    self.mov_ri(IP0, o.m)
                    # ins va.d[1], x16
                    self.w(0x4E181C00 | (IP0 << 5) | a)
            case KO_SPILL:
                # (slot n is at x29 - fs - 16 (n + 1): from sp, one instruction)
                self.ldst(M_STRQ, a, SP, 16 * (nslots - 1 - o.n))
            case KO_FILL:
                self.ldst(M_LDRQ, a, SP, 16 * (nslots - 1 - o.n))
            case _:
                # KO_ARG: a float parameter on the stack, above x29 and x30
                self.ldst(M_LDRD, a, FP, o.n)

    # A copy of v src into o.a, then o (a = a op b): one NEON operation
    # reading src, when o is one with three registers that reads all of a.
    # False if it isn't (nothing emitted).
    fn kop_from(ref self, o: KOp, src: int, a: int, hd: bool, el: int) -> bool:
        if o.a != a or (o.op != KO_OP and o.op != KO_SHUF):
            return false
        let m = src if o.b == a else o.b
        if el >= 0:
            # a = src * the lane (o.b is the splat, so o.b != a)
            self.kmul_el(a, src, el, o.m == PFX_PD, hd)
            return true
        var op = -1
        if o.op == KO_OP and o.m != PFX_PD and hd and o.n != SSE_XOR and o.n != SSE_UNPH:
            # a scalar operation, a's upper lane unread
            op = scalar_fop(o.n)
        elif o.op == KO_SHUF:
            match o.n & 3:
                case 0:
                    op = 0x4EC03800
                case 1:
                    op = 0x6E004000
                case 3:
                    op = 0x4EC07800
                case _:
                    return false
        elif o.n == SSE_XOR:
            op = 0x6E201C00
        elif o.n == SSE_UNPH:
            op = 0x4EC07800
        elif o.m == PFX_PD:
            if o.n == SSE_ADD:
                op = 0x4E60D400
            elif o.n == SSE_SUB:
                op = 0x4EE0D400
            elif o.n == SSE_MUL:
                op = 0x6E60DC00
            elif o.n == SSE_DIV:
                op = 0x6E60FC00
        if op < 0:
            return false
        self.w(op | (m << 16) | (src << 5) | a)
        return true

    # d = n * lane el & 1 of v (el & 63) >> 1: both lanes, or the low one
    # (hd: d's upper lane unread, else it stays)
    fn kmul_el(ref self, d: int, n: int, el: int, pd: bool, hd: bool):
        let lane = ((el & 1) << 11) | (((el & 63) >> 1) << 16)
        if pd:
            # fmul vd.2d, vn.2d, vs.d[l]
            self.w(0x4FC09000 | lane | (n << 5) | d)
        elif hd:
            # fmul dd, dn, vs.d[l]
            self.w(0x5FC09000 | lane | (n << 5) | d)
        else:
            self.w(0x5FC09000 | lane | (n << 5) | 31)
            self.w(0x6E080400 | (31 << 5) | d)

    # a = a op b, SSE2 opcode o.n: packed (both lanes) or scalar (the low one)
    fn kop_arith(ref self, o: KOp, hd: bool):
        let a = o.a
        let b = o.b
        if o.n == SSE_XOR:
            # eor va.16b, va.16b, vb.16b
            self.w(0x6E201C00 | (b << 16) | (a << 5) | a)
            return
        if o.n == SSE_UNPH:
            # zip2 va.2d, va.2d, vb.2d
            self.w(0x4EC07800 | (b << 16) | (a << 5) | a)
            return
        if o.m == PFX_PD:
            var op = 0x4E60D400
            if o.n == SSE_SUB:
                op = 0x4EE0D400
            elif o.n == SSE_MUL:
                op = 0x6E60DC00
            elif o.n == SSE_DIV:
                op = 0x6E60FC00
            else:
                assert o.n == SSE_ADD, f"a64: kernel opcode {o.n}"
            self.w(op | (b << 16) | (a << 5) | a)
            return
        let op = scalar_fop(o.n)
        if hd:
            # fop da, da, db
            self.w(op | (b << 16) | (a << 5) | a)
            return
        # fop d31, da, db; ins va.d[0], v31.d[0]
        self.w(op | (b << 16) | (a << 5) | 31)
        self.w(0x6E080400 | (31 << 5) | a)

    # The callee-saved registers to (or from, `load`) their slots: slot n
    # (x29 - 8(n + 1)) holds saved[n], then fsaved; neighbours of the same
    # kind go in one stp / ldp.
    fn save_regs(ref self, load: bool):
        var rs: [int] = []
        var fl: [bool] = []
        for r in self.saved:
            rs.push(r)
            fl.push(false)
        for r in self.fsaved:
            rs.push(r)
            fl.push(true)
        var n = 0
        while n < len(rs):
            if n + 1 < len(rs) and fl[n + 1] == fl[n]:
                # stp / ldp rs[n + 1], rs[n], [x29, #-8(n + 2)]
                var op = 0x6D000000 if fl[n] else 0xA9000000
                if load:
                    op = op | 0x400000
                let imm = (-(n + 2)) & 0x7F
                self.w(op | (imm << 15) | (rs[n] << 10) | (FP << 5) | rs[n + 1])
                n += 2
            else:
                var op = M_STRD if fl[n] else M_STRX
                if load:
                    op = M_LDRD if fl[n] else M_LDRX
                self.ldst(op, rs[n], FP, -8 * (n + 1))
                n += 1

    fn epilogue(ref self):
        self.save_regs(true)
        # mov sp, x29; ldp x29, x30, [sp], #16
        self.w(0x910003BF)
        self.w(0xA8C17BFD)
        self.u.epis.push(self.pos())
        self.w(0xD65F03C0)

    # ------------------------------------------------------------ unwind tables
    # The function's FDE in .eh_frame (the CIE is at its start).
    fn unwind_elf(ref self):
        let u = self.u
        let at = len(self.o.unwind)
        put32(ref self.o.unwind, 0)
        put32(ref self.o.unwind, at + 4)
        self.o.urel.push(ORel(off=len(self.o.unwind), sym=self.text_sym, kind=R_PC32, add=u.start))
        put32(ref self.o.unwind, 0)
        put32(ref self.o.unwind, self.pos() - u.start)
        self.o.unwind.push(0)
        # after the stp: CFA = sp + 16, x29 and x30 saved below it
        var loc = self.cfi_at(u.start, u.start + 4)
        self.o.unwind.push(14)
        uleb(ref self.o.unwind, 16)
        self.cfi_saved(FP, 2)
        self.cfi_saved(LR, 1)
        # then CFA = x29 + 16
        loc = self.cfi_at(loc, u.fp)
        self.cfi_def_cfa(FP, 16)
        loc = self.cfi_at(loc, u.pro_end)
        for i, r in enumerate(self.saved):
            self.cfi_saved(r, 3 + i)
        for j, r in enumerate(self.fsaved):
            self.cfi_saved(64 + r, 3 + len(self.saved) + j)
        # between an epilogue's ldp and its ret, CFA = sp
        for e in u.epis:
            loc = self.cfi_at(loc, e)
            self.o.unwind.push(10)
            self.cfi_def_cfa(SP, 0)
            loc = self.cfi_at(loc, e + 4)
            self.o.unwind.push(11)
        while len(self.o.unwind) % 8 != 0:
            self.o.unwind.push(0)
        set32(ref self.o.unwind, at, len(self.o.unwind) - at - 4)

    fn cfi_at(ref self, loc: int, to: int) -> int:
        let d = to - loc
        if d == 0:
            return to
        if d < 64:
            self.o.unwind.push(u8(64 | d))
        elif d < 256:
            self.o.unwind.push(2)
            self.o.unwind.push(u8(d))
        elif d < 65536:
            self.o.unwind.push(3)
            put16(ref self.o.unwind, d)
        else:
            self.o.unwind.push(4)
            put32(ref self.o.unwind, d)
        return to

    fn cfi_def_cfa(ref self, r: int, n: int):
        self.o.unwind.push(12)
        uleb(ref self.o.unwind, r)
        uleb(ref self.o.unwind, n)

    # DW_CFA_offset (extended for DWARF registers past 63): r is at CFA - 8n
    fn cfi_saved(ref self, r: int, n: int):
        if r < 64:
            self.o.unwind.push(u8(128 | r))
        else:
            self.o.unwind.push(5)
            uleb(ref self.o.unwind, r)
        uleb(ref self.o.unwind, n)

    # ------------------------------------------------------------ debug info
    fn line_row(ref self, x: Inst):
        if x.s.starts_with("<"):
            return
        let fi = self.dw.file(x.s)
        let row = DRow(pc=self.pos(), file=fi, line=x.n)
        let n = len(self.rows)
        if n > 0:
            let last = self.rows[n - 1]
            if last.line == x.n and last.file == fi:
                return
            if last.pc == row.pc:
                self.rows[n - 1] = row
                return
        self.rows.push(row)

    fn next_row(self, pc: int, hi: int) -> int:
        for r in self.rows:
            if r.pc > pc:
                return min(r.pc, hi)
        return hi

    fn debug_func(ref self, f: Func):
        let end = self.pos()
        for j in 1..len(self.ipos):
            if self.ipos[j] < 0:
                self.ipos[j] = self.ipos[j - 1]
        var file = -1
        var line = 0
        if f.dline > 0 and not f.dfile.starts_with("<"):
            file = self.dw.file(f.dfile)
            line = f.dline
        var locals: [DLocal] = []
        for v in f.dvars:
            var loc: [u8] = []
            if v.slot >= 0:
                loc = loc_breg(SP, self.slot_off[v.slot])
            elif self.fold[v.ptr] == F_SLOT:
                loc = loc_breg(SP, self.slot_off[self.fval[v.ptr]])
            elif self.fold[v.ptr] == F_NONE and self.reg[v.ptr] < 0:
                loc = loc_deref(loc_breg(SP, self.home[v.ptr]))
            else:
                continue
            var lo = -1
            var hi = end
            if not v.param:
                if v.hi >= 0:
                    hi = self.ipos[v.hi]
                lo = self.next_row(self.ipos[v.lo], hi)
            locals.push(DLocal(name=v.name, ty=v.ty, param=v.param, loc=loc, lo=lo, hi=hi))
        if f.public and f.dname == "" and self.entry_main:
            self.entry = (self.u.start, end)
            return
        let name = f.name if f.dname == "" else f.dname
        var d = DFn(
            name=name,
            lo=self.u.start,
            hi=end,
            lo2=-1,
            hi2=-1,
            ret=f.dret,
            file=file,
            line=line,
            rows=self.rows,
            locals=locals
        )
        if f.name == "main__main" and self.entry.0 >= 0:
            d.lo2 = self.entry.0
            d.hi2 = self.entry.1
        self.dw.fns.push(d)

    # Keeps the most used vregs (uses in loops count more) in callee-saved
    # registers for the whole function: integers in x19-x28, floats in d8-d15.
    fn store_params(ref self, f: Func):
        let h = 1 if f.has_ret and f.ret.is_wide() else 0
        if h == 1:
            self.ldst(M_STRX, 0, SP, self.retp)
        for i in 0..f.nparams:
            let k = f.vk[i]
            let l = self.ploc[i + h]
            # incoming stack arguments start at the caller's sp, x29 + 16
            if k.is_wide():
                var r = T1
                if l >= L_STACK:
                    self.ldst(M_LDRX, T1, FP, 16 + l - L_STACK)
                else:
                    r = l
                self.copy16(SP, self.home[i], r, 0)
            elif l >= L_STACK:
                if k.is_float():
                    self.ldst(M_LDRD if k == K.F64 else M_LDRS, 0, FP, 16 + l - L_STACK)
                    self.fst(fl_of(k), i, 0)
                else:
                    let r = self.dst(i)
                    self.ldst(load_op(k), r, FP, 16 + l - L_STACK)
                    if r == T0:
                        self.st(T0, i)
            elif l >= L_V:
                self.fst(fl_of(k), i, l - L_V)
            else:
                self.norm(l, k)
                self.st(l, i)

    # ------------------------------------------------------------ instructions
    # Compiles the instruction at i; returns the index of the next one.
    fn inst(ref self, i: int) -> int:
        let x = self.code[i]
        if x.d >= 0 and self.fold[x.d] != F_NONE:
            return i + 1
        match x.op:
            case Op.Const:
                self.op_const(x)
            case Op.FConst:
                let k = self.vk[x.d]
                let b = x.n & 0xFFFFFFFF if k == K.F32 else x.n
                if self.freg[x.d] >= 0:
                    self.fconst(fl_of(k), self.freg[x.d], b)
                else:
                    self.mov_ri(T0, b)
                    self.st(T0, x.d)
            case Op.Mov:
                if x.d != x.a:
                    let k = self.vk[x.d]
                    if k.is_wide():
                        self.copy_v16(x.d, x.a)
                    elif k.is_float():
                        let fl = fl_of(k)
                        if self.freg[x.d] >= 0:
                            self.fld(fl, self.freg[x.d], x.a)
                        else:
                            let fa = self.fuse(fl, 0, x.a)
                            self.fst(fl, x.d, fa)
                    else:
                        self.set_v(x.d, x.a)
            case Op.Add | Op.Sub | Op.Mul | Op.Div | Op.Rem | Op.And | Op.Or | Op.Xor | Op.Shl | Op.Shr:
                let k = self.vk[x.d]
                if k.is_wide():
                    self.wide_bin(x)
                elif k.is_float():
                    self.float_bin(x)
                else:
                    self.int_bin(x)
            case Op.Neg | Op.Not:
                self.unary(x)
            case Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge:
                return self.compare(i, x)
            case Op.Conv:
                self.conv(x)
            case Op.Bits:
                # fmov between a v register and a general one
                if self.vk[x.d].is_float():
                    self.st(self.use(T0, x.a), x.d)
                else:
                    let r = self.dst(x.d)
                    self.ld(r, x.a)
                    self.norm(r, self.vk[x.d])
                    self.st(r, x.d)
            case Op.AddO | Op.SubO | Op.MulO:
                self.checked(x)
            case Op.IdxChk:
                let ra = self.use(T0, x.a)
                if self.imm(x.b):
                    self.cmp_ri(ra, self.fval[x.b])
                else:
                    let rb = self.use(T1, x.b)
                    self.rrr(0xEB000000, ZR, ra, rb)
                self.bcc_stub(C_HS, S_IDX, x.a, x.b, x.c)
                if x.d != x.a:
                    self.st(ra, x.d)
            case Op.SlotAddr:
                let r = self.dst(x.d)
                self.add_ri(r, SP, self.slot_off[x.a])
                self.st(r, x.d)
            case Op.Global:
                let r = self.dst(x.d)
                let s = self.sym_ref(x.s)
                self.ld_sym(r, s)
                self.st(r, x.d)
            case Op.Load:
                let k = self.vk[x.d]
                if self.fold[x.a] == F_ELEM:
                    if self.freg[x.d] >= 0:
                        self.ldst_elem(M_LDRD if k == K.F64 else M_LDRS, self.freg[x.d], x.a)
                    else:
                        let r = self.dst(x.d)
                        self.ldst_elem(load_op(k), r, x.a)
                        self.st(r, x.d)
                    return i + 1
                if (
                    self.fold[x.a] == F_GLOBAL
                    and not k.is_wide()
                    and load_op(k) == M_LDRX
                    and self.freg[x.d] < 0
                    and x.n % 8 == 0
                    and x.n >= 0
                ):
                    let r = self.dst(x.d)
                    self.ld_sym_x(r, self.fval[x.a], x.n)
                    self.st(r, x.d)
                    return i + 1
                let (b, o) = self.addr(x.a, x.n, T1)
                if k.is_wide():
                    self.copy16(SP, self.home[x.d], b, o)
                elif self.freg[x.d] >= 0:
                    self.ldst(M_LDRD if k == K.F64 else M_LDRS, self.freg[x.d], b, o)
                else:
                    let r = self.dst(x.d)
                    self.ldst(load_op(k), r, b, o)
                    self.st(r, x.d)
            case Op.Store:
                let k = self.vk[x.b]
                if self.fold[x.a] == F_ELEM:
                    if self.freg[x.b] >= 0:
                        self.ldst_elem(M_STRD if k == K.F64 else M_STRS, self.freg[x.b], x.a)
                    else:
                        var r = ZR
                        if not (self.imm(x.b) and self.fval[x.b] == 0):
                            r = self.use(T0, x.b)
                        self.ldst_elem(store_op(k.size()), r, x.a)
                    return i + 1
                let (b, o) = self.addr(x.a, x.n, T1)
                if k.is_wide():
                    self.copy16(b, o, SP, self.home[x.b])
                elif self.freg[x.b] >= 0:
                    self.ldst(M_STRD if k == K.F64 else M_STRS, self.freg[x.b], b, o)
                else:
                    # xzr for 0
                    var r = ZR
                    if not (self.imm(x.b) and self.fval[x.b] == 0):
                        r = self.use(T0, x.b)
                    self.ldst(store_op(k.size()), r, b, o)
            case Op.Elem:
                self.elem(x)
            case Op.Copy:
                self.copy_mem(x.a, x.b, x.n)
            case Op.Zero:
                self.zero_mem(x.a, x.n)
            case Op.Call | Op.CallInd:
                if x.op == Op.Call and x.s == "brine_arr_unique" and len(x.args) == 1:
                    # only when the array *p is shared (its count isn't 1),
                    # as br_arr_mine in brine_rt.h does
                    let (base, disp) = self.addr(x.args[0], 0, T1)
                    self.ldst(M_LDRX, T0, base, disp)
                    self.ldst(M_LDRX, T0, T0, 0)
                    self.cmp_ri(T0, 1)
                    let skip = self.fwd(0x54000000 | C_EQ)
                    self.ir_call(x)
                    self.here(skip, B19)
                elif (
                    x.op == Op.Call
                    and x.b == 1
                    and x.s == "brine_box_dec"
                    and x.d >= 0
                    and self.nuse[x.d] == 1
                    and i + 1 < len(self.code)
                    and not self.dead[i + 1]
                    and (self.code[i + 1].op == Op.Br or self.code[i + 1].op == Op.BrNot)
                    and self.code[i + 1].a == x.d
                ):
                    # no 0 or 1 to branch on: straight from where it is known
                    self.dec_br = i + 1
                    self.ir_call(x)
                    self.dec_br = -1
                    return i + 2
                else:
                    self.ir_call(x)
            case Op.Label:
                self.lpos[x.n] = self.pos()
                self.st_end = -1
            case Op.Jmp:
                # no jump to the next instruction
                if not self.falls_to(i + 1, x.n):
                    self.jmp_label(x.n)
            case Op.Br | Op.BrNot:
                let want = x.op == Op.Br
                if self.fold[x.a] == F_CONST:
                    if (self.fval[x.a] != 0) == want:
                        self.jmp_label(x.n)
                else:
                    let r = self.use(T0, x.a)
                    # cbnz / cbz
                    let nz = 0xB5000000 | r
                    let z = 0xB4000000 | r
                    return self.cond_jump(i, nz if want else z, z if want else nz, x.n)
            case Op.Switch:
                self.switch(x)
            case Op.Ret:
                self.op_ret(x)
            case Op.Unreachable:
                self.call_rt("brine_unreachable", [])
            case Op.Phi:
                panic("a64: phis only exist inside ssa.br")
            case Op.Line:
                if self.dbg:
                    self.line_row(x)
        return i + 1

    # a jump table of words, each the offset of its label from itself
    fn switch(ref self, x: Inst):
        let n = len(x.args) - 1
        let r = self.use(T0, x.a)
        self.add_ri(T1, r, -x.n)
        self.cmp_ri(T1, n)
        self.bcc_label(C_HS, x.args[0])
        # adr x11, table; add x11, x11, x10, lsl #2; ldrsw x10, [x11];
        # add x11, x11, x10; br x11
        self.w(0x10000000 | (5 << 5) | T2)
        self.w(0x8B000800 | (T1 << 16) | (T2 << 5) | T2)
        self.w(0xB9800000 | (T2 << 5) | T1)
        self.rrr(0x8B000000, T2, T2, T1)
        self.w(0xD61F0000 | (T2 << 5))
        for l in x.args[1:]:
            self.br_label(0, W32, l)

    fn op_const(ref self, x: Inst):
        let k = self.vk[x.d]
        if k.is_wide():
            self.mov_ri(T0, x.n)
            self.ldst(M_STRX, T0, SP, self.home[x.d])
            self.mov_ri(T0, x.c)
            self.ldst(M_STRX, T0, SP, self.home[x.d] + 8)
        elif k.is_float():
            self.mov_ri(T0, x.n)
            # scvtf d0 / s0, x9
            self.w((0x9E620000 if k == K.F64 else 0x9E220000) | (T0 << 5))
            self.fst(fl_of(k), x.d, 0)
        else:
            let r = self.dst(x.d)
            self.mov_ri(r, canon(x.n, k))
            self.st(r, x.d)

    fn op_ret(ref self, x: Inst):
        if x.a >= 0 and self.has_ret:
            let k = self.vk[x.a]
            if k.is_wide():
                self.ldst(M_LDRX, 0, SP, self.retp)
                self.copy16(0, 0, SP, self.home[x.a])
            elif k.is_float():
                self.fld(fl_of(k), 0, x.a)
            else:
                self.ld(0, x.a)
        self.epilogue()

    fn int_bin(ref self, x0: Inst):
        if x0.op == Op.Add and (self.fold[x0.a] == F_MUL or self.fold[x0.b] == F_MUL):
            let m = x0.a if self.fold[x0.a] == F_MUL else x0.b
            let y = self.code[self.fval[m]]
            let r = self.dst(x0.d)
            let p = self.use(T0, y.a)
            let q = self.use(T1, y.b)
            let c = self.use(T2, x0.b if m == x0.a else x0.a)
            # madd r, p, q, c
            self.w(0x9B000000 | (q << 16) | (c << 10) | (p << 5) | r)
            self.st(r, x0.d)
            return
        var x = x0
        if (
            (x.op == Op.Add or x.op == Op.And or x.op == Op.Or or x.op == Op.Xor)
            and self.imm(x.a)
            and not self.imm(x.b)
        ):
            # the constant as the immediate
            x.a = x0.b
            x.b = x0.a
        let k = self.vk[x.d]
        let r = self.dst(x.d)
        # (a `~b` folded into a bic is never made)
        let ra = T0 if self.fold[x.a] == F_NOT else self.use(T0, x.a)
        match x.op:
            case Op.Add | Op.Sub:
                if self.imm(x.b) and self.fval[x.b] > -4096 and self.fval[x.b] < 4096:
                    let v = self.fval[x.b]
                    self.add_ri(r, ra, v if x.op == Op.Add else -v)
                else:
                    let rb = self.use(T1, x.b)
                    self.rrr(0x8B000000 if x.op == Op.Add else 0xCB000000, r, ra, rb)
                self.norm(r, k)
            case Op.And | Op.Or | Op.Xor:
                let li = logic_imm(self.fval[x.b]) if self.imm(x.b) else -1
                if x.op == Op.And and (self.fold[x.a] == F_NOT or self.fold[x.b] == F_NOT):
                    # bic r, p, q: p & ~q
                    let nb = self.fold[x.b] == F_NOT
                    let p = self.use(T0, x.a if nb else x.b)
                    let q = self.use(T1, self.fval[x.b if nb else x.a])
                    self.rrr(0x8A200000, r, p, q)
                elif li >= 0:
                    var op = 0x92000000
                    if x.op == Op.Or:
                        op = 0xB2000000
                    elif x.op == Op.Xor:
                        op = 0xD2000000
                    self.w(op | (li << 10) | (ra << 5) | r)
                else:
                    let rb = self.use(T1, x.b)
                    var op = 0x8A000000
                    if x.op == Op.Or:
                        op = 0xAA000000
                    elif x.op == Op.Xor:
                        op = 0xCA000000
                    self.rrr(op, r, ra, rb)
            case Op.Mul:
                let rb = self.use(T1, x.b)
                # madd r, ra, rb, xzr
                self.w(0x9B007C00 | (rb << 16) | (ra << 5) | r)
                self.norm(r, k)
            case Op.Div | Op.Rem:
                let rb = self.use(T1, x.b)
                let div = 0x9AC00C00 if k.is_signed() else 0x9AC00800
                if x.op == Op.Div:
                    self.rrr(div, r, ra, rb)
                else:
                    self.rrr(div, T2, ra, rb)
                    # msub r, x11, rb, ra
                    self.w(0x9B008000 | (rb << 16) | (ra << 10) | (T2 << 5) | r)
            case _:
                if self.imm(x.b):
                    let n = self.fval[x.b] & 63
                    if x.op == Op.Shl:
                        # lsl: ubfm r, ra, #(-n % 64), #(63 - n)
                        self.w(
                            0xD3400000 | (((64 - n) & 63) << 16) | ((63 - n) << 10) | (ra << 5) | r
                        )
                    elif k.is_signed():
                        # asr: sbfm r, ra, #n, #63
                        self.w(0x9340FC00 | (n << 16) | (ra << 5) | r)
                    else:
                        # lsr: ubfm r, ra, #n, #63
                        self.w(0xD340FC00 | (n << 16) | (ra << 5) | r)
                else:
                    let rb = self.use(T1, x.b)
                    var op = 0x9AC02000
                    if x.op == Op.Shr:
                        op = 0x9AC02800 if k.is_signed() else 0x9AC02400
                    self.rrr(op, r, ra, rb)
                if x.op == Op.Shl:
                    self.norm(r, k)
        self.st(r, x.d)

    fn float_bin(ref self, x: Inst):
        let k = self.vk[x.d]
        let fl = fl_of(k)
        if x.op == Op.Rem:
            let name = "brine_x_f_fmod" if fl == 1 else "brine_x_f_fmodf"
            self.call_rt(name, [CArg(how=A_VAL, v=x.a, fl=fl), CArg(how=A_VAL, v=x.b, fl=fl)])
            self.store_ret(x.d)
            return
        var op = 0x1E202800
        if x.op == Op.Sub:
            op = 0x1E203800
        elif x.op == Op.Mul:
            op = 0x1E200800
        elif x.op == Op.Div:
            op = 0x1E201800
        if fl == 1:
            op = op | 0x400000
        let fa = self.fuse(fl, 0, x.a)
        let fb = self.fuse(fl, 1, x.b)
        let r = self.fdst(x.d)
        self.rrr(op, r, fa, fb)
        self.fst(fl, x.d, r)

    # the two halves of 128-bit vreg v: x11, x12 (a) or x9, x10 (b)
    fn ld16(ref self, lo: int, v: int):
        if self.st_end == self.pos() and self.st_home == self.home[v]:
            self.mov_rr(lo, self.st_lo)
            self.mov_rr(lo + 1, self.st_lo + 1)
            return
        self.ldst(M_LDRX, lo, SP, self.home[v])
        self.ldst(M_LDRX, lo + 1, SP, self.home[v] + 8)

    fn st16(ref self, lo: int, v: int):
        self.ldst(M_STRX, lo, SP, self.home[v])
        self.ldst(M_STRX, lo + 1, SP, self.home[v] + 8)
        self.st_end = self.pos()
        self.st_lo = lo
        self.st_home = self.home[v]

    fn wide_bin(ref self, x: Inst):
        let k = self.vk[x.d]
        match x.op:
            case Op.Add | Op.Sub | Op.And | Op.Or | Op.Xor:
                # adds / adc, subs / sbc, and, orr, eor
                var lo = 0xAB000000
                var hi = 0x9A000000
                if x.op == Op.Sub:
                    lo = 0xEB000000
                    hi = 0xDA000000
                elif x.op == Op.And:
                    lo = 0x8A000000
                    hi = lo
                elif x.op == Op.Or:
                    lo = 0xAA000000
                    hi = lo
                elif x.op == Op.Xor:
                    lo = 0xCA000000
                    hi = lo
                self.ld16(T0, x.a)
                self.ld16(T2, x.b)
                self.rrr(lo, T0, T0, T2)
                self.rrr(hi, T1, T1, T3)
                self.st16(T0, x.d)
            case Op.Shl | Op.Shr:
                self.ld16(T0, x.a)
                let c = self.shift_amount(x.b)
                if c >= 0:
                    self.wide_shift_by(x.op == Op.Shl, k.is_signed(), c)
                    self.st16(T2, x.d)
                    return
                # by s & 127: the halves shifted by s & 63, joined, then
                # moved over a whole half when s & 64
                let s = self.use(IP0, x.b)
                # x17 = ~s: (63 - s) & 63 as a shift amount
                self.rrr(0xAA200000, 17, ZR, s)
                if x.op == Op.Shl:
                    # x12 = hi << s | (lo >> 1) >> (63 - s); x11 = lo << s
                    self.rrr(0x9AC02000, T3, T1, s)
                    self.w(0xD341FC00 | (T0 << 5) | T2)
                    self.rrr(0x9AC02400, T2, T2, 17)
                    self.rrr(0xAA000000, T3, T3, T2)
                    self.rrr(0x9AC02000, T2, T0, s)
                    # tst s, #64; hi = s & 64 ? x11 : x12; lo = s & 64 ? 0 : x11
                    self.w(0xF2000000 | (logic_imm(64) << 10) | (s << 5) | ZR)
                    self.w(0x9A800000 | (T3 << 16) | (C_NE << 12) | (T2 << 5) | T1)
                    self.w(0x9A800000 | (T2 << 16) | (C_NE << 12) | (ZR << 5) | T0)
                else:
                    # x11 = lo >> s | (hi << 1) << (63 - s); x12 = hi >> s
                    self.rrr(0x9AC02400, T2, T0, s)
                    self.w(0xD37FF800 | (T1 << 5) | T3)
                    self.rrr(0x9AC02000, T3, T3, 17)
                    self.rrr(0xAA000000, T2, T2, T3)
                    let signed = k.is_signed()
                    self.rrr(0x9AC02800 if signed else 0x9AC02400, T3, T1, s)
                    if signed:
                        # asr x17, hi, #63
                        self.w(0x937FFC00 | (T1 << 5) | 17)
                    self.w(0xF2000000 | (logic_imm(64) << 10) | (s << 5) | ZR)
                    # lo = s & 64 ? x12 : x11; hi = s & 64 ? sign : x12
                    self.w(0x9A800000 | (T2 << 16) | (C_NE << 12) | (T3 << 5) | T0)
                    let fill = 17 if signed else ZR
                    self.w(0x9A800000 | (T3 << 16) | (C_NE << 12) | (fill << 5) | T1)
                self.st16(T0, x.d)
            case Op.Mul:
                # lo = al * bl; hi = umulh(al, bl) + al * bh + ah * bl
                self.ld16(T0, x.a)
                self.ld16(T2, x.b)
                self.w(0x9BC07C00 | (T2 << 16) | (T0 << 5) | 17)
                # madd x17, x9, x12, x17; madd x17, x10, x11, x17
                self.w(0x9B000000 | (T3 << 16) | (17 << 10) | (T0 << 5) | 17)
                self.w(0x9B000000 | (T2 << 16) | (17 << 10) | (T1 << 5) | 17)
                self.w(0x9B007C00 | (T2 << 16) | (T0 << 5) | T0)
                self.rrr(0xAA000000, T1, ZR, 17)
                self.st16(T0, x.d)
            case _:
                var nm = "mul"
                if x.op == Op.Div:
                    nm = "div"
                elif x.op == Op.Rem:
                    nm = "rem"
                self.call_rt(
                    f"brine_x_{w128(k)}_{nm}",
                    [
                        CArg(how=A_ADDR, v=x.d, fl=0),
                        CArg(how=A_ADDR, v=x.a, fl=0),
                        CArg(how=A_ADDR, v=x.b, fl=0)
                    ]
                )

    # a shift's amount & 127 when it is a constant (-1: it isn't)
    fn shift_amount(self, v: int) -> int:
        if self.wshift[v] >= 0:
            return self.wshift[v]
        if self.imm(v):
            return self.fval[v] & 127
        return -1

    # x11, x12 = x9, x10 (lo, hi) shifted by c (0 <= c < 128)
    fn wide_shift_by(ref self, left: bool, signed: bool, c: int):
        if c == 0:
            self.mov_rr(T2, T0)
            self.mov_rr(T3, T1)
        elif left and c < 64:
            # extr x12, x10, x9, #(64 - c); lsl x11, x9, #c
            self.w(0x93C00000 | (T0 << 16) | ((64 - c) << 10) | (T1 << 5) | T3)
            self.w(0xD3400000 | (((64 - c) & 63) << 16) | ((63 - c) << 10) | (T0 << 5) | T2)
        elif left:
            # lsl x12, x9, #(c - 64); x11 = 0
            let e = c - 64
            self.w(0xD3400000 | (((64 - e) & 63) << 16) | ((63 - e) << 10) | (T0 << 5) | T3)
            self.mov_rr(T2, ZR)
        elif c < 64:
            # extr x11, x10, x9, #c; lsr / asr x12, x10, #c
            self.w(0x93C00000 | (T0 << 16) | (c << 10) | (T1 << 5) | T2)
            self.w((0x9340FC00 if signed else 0xD340FC00) | (c << 16) | (T1 << 5) | T3)
        else:
            # lsr / asr x11, x10, #(c - 64); x12 = 0, or the sign
            if c == 64:
                self.mov_rr(T2, T1)
            else:
                self.w((0x9340FC00 if signed else 0xD340FC00) | ((c - 64) << 16) | (T1 << 5) | T2)
            if signed:
                self.w(0x9340FC00 | (63 << 16) | (T1 << 5) | T3)
            else:
                self.mov_rr(T3, ZR)

    fn unary(ref self, x: Inst):
        let k = self.vk[x.d]
        if k.is_wide():
            self.ld16(T0, x.a)
            if x.op == Op.Not:
                # mvn
                self.rrr(0xAA200000, T0, ZR, T0)
                self.rrr(0xAA200000, T1, ZR, T1)
            else:
                # negs x9, x9; ngc x10, x10
                self.rrr(0xEB000000, T0, ZR, T0)
                self.rrr(0xDA000000, T1, ZR, T1)
            self.st16(T0, x.d)
            return
        if k.is_float():
            let fl = fl_of(k)
            let fa = self.fuse(fl, 0, x.a)
            let r = self.fdst(x.d)
            # fneg
            self.w((0x1E614000 if fl == 1 else 0x1E214000) | (fa << 5) | r)
            self.fst(fl, x.d, r)
            return
        let r = self.dst(x.d)
        let ra = self.use(T0, x.a)
        if x.op == Op.Neg:
            self.rrr(0xCB000000, r, ZR, ra)
            self.norm(r, k)
        elif k == K.Bool:
            # eor r, ra, #1
            self.w(0xD2400000 | (ra << 5) | r)
        else:
            self.rrr(0xAA200000, r, ZR, ra)
            self.norm(r, k)
        self.st(r, x.d)

    # Sets the flags for a comparison; returns the condition that means true.
    fn cmp_flags(ref self, x: Inst) -> int:
        let k = self.vk[x.a]
        let signed = k.is_signed()
        if k.is_float():
            let fl = fl_of(k)
            let fa = self.fuse(fl, 0, x.a)
            let fb = self.fuse(fl, 1, x.b)
            # fcmp: unordered sets C and V, which every condition here rejects
            # except NE
            self.w((0x1E602000 if fl == 1 else 0x1E202000) | (fb << 16) | (fa << 5))
            match x.op:
                case Op.Eq:
                    return C_EQ
                case Op.Ne:
                    return C_NE
                case Op.Lt:
                    return C_MI
                case Op.Le:
                    return C_LS
                case Op.Gt:
                    return C_GT
                case _:
                    return C_GE
        if k.is_wide():
            if x.op == Op.Eq or x.op == Op.Ne:
                self.ld16(T0, x.a)
                self.ld16(T2, x.b)
                self.rrr(0xCA000000, T0, T0, T2)
                self.rrr(0xCA000000, T1, T1, T3)
                # orrs via cmp: orr x9, x9, x10; cmp x9, #0
                self.rrr(0xAA000000, T0, T0, T1)
                self.cmp_ri(T0, 0)
                return C_EQ if x.op == Op.Eq else C_NE
            # p - q, flags from subs / sbcs
            var p = x.a
            var q = x.b
            if x.op == Op.Gt or x.op == Op.Le:
                p = x.b
                q = x.a
            self.ld16(T0, p)
            self.ld16(T2, q)
            self.rrr(0xEB000000, ZR, T0, T2)
            self.rrr(0xFA000000, ZR, T1, T3)
            if x.op == Op.Lt or x.op == Op.Gt:
                return C_LT if signed else C_LO
            return C_GE if signed else C_HS
        let ra = self.use(T0, x.a)
        if self.imm(x.b):
            self.cmp_ri(ra, self.fval[x.b])
        else:
            let rb = self.use(T1, x.b)
            self.rrr(0xEB000000, ZR, ra, rb)
        match x.op:
            case Op.Eq:
                return C_EQ
            case Op.Ne:
                return C_NE
            case Op.Lt:
                return C_LT if signed else C_LO
            case Op.Le:
                return C_LE if signed else C_LS
            case Op.Gt:
                return C_GT if signed else C_HI
            case _:
                return C_GE if signed else C_HS

    fn compare(ref self, i: int, x: Inst) -> int:
        # fuse with a branch right after that is the only use
        if i + 1 < len(self.code) and self.nuse[x.d] == 1:
            let y = self.code[i + 1]
            if (y.op == Op.Br or y.op == Op.BrNot) and y.a == x.d:
                let k = self.vk[x.a]
                var yes = 0
                var no = 0
                if (
                    (x.op == Op.Eq or x.op == Op.Ne)
                    and not k.is_float()
                    and not k.is_wide()
                    and self.imm(x.b)
                    and self.fval[x.b] == 0
                ):
                    # cbz / cbnz
                    let r = self.use(T0, x.a)
                    let z = 0xB4000000 | r
                    let nz = 0xB5000000 | r
                    yes = z if x.op == Op.Eq else nz
                    no = nz if x.op == Op.Eq else z
                else:
                    let cc = self.cmp_flags(x)
                    yes = 0x54000000 | cc
                    no = 0x54000000 | (cc ^ 1)
                if y.op == Op.BrNot:
                    let t = yes
                    yes = no
                    no = t
                return self.cond_jump(i + 1, yes, no, y.n)
        let cc = self.cmp_flags(x)
        let r = self.dst(x.d)
        self.cset(r, cc)
        self.st(r, x.d)
        return i + 1

    fn checked(ref self, x: Inst):
        let k = self.vk[x.d]
        var kind = S_ADD
        if x.op == Op.SubO:
            kind = S_SUB
        elif x.op == Op.MulO:
            kind = S_MUL
        if k.is_wide() and kind != S_MUL:
            # adds / adcs, subs / sbcs: V is signed overflow, C unsigned
            self.ld16(T0, x.a)
            self.ld16(T2, x.b)
            self.rrr(0xAB000000 if kind == S_ADD else 0xEB000000, T0, T0, T2)
            self.rrr(0xBA000000 if kind == S_ADD else 0xFA000000, T1, T1, T3)
            var cc = C_VS
            if not k.is_signed():
                cc = C_HS if kind == S_ADD else C_LO
            self.bcc_stub(cc, kind, x.a, x.b, x.c)
            self.st16(T0, x.d)
            return
        if k.is_wide():
            # both in 64 bits: the product fits; else the runtime
            self.ld16(T0, x.a)
            self.ld16(T2, x.b)
            var slow: [int] = []
            if k.is_signed():
                # cmp hi, lo, asr #63; b.ne slow
                self.w(0xEB80FC1F | (T0 << 16) | (T1 << 5))
                slow.push(self.fwd(0x54000000 | C_NE))
                self.w(0xEB80FC1F | (T2 << 16) | (T3 << 5))
                slow.push(self.fwd(0x54000000 | C_NE))
                # smulh x10, x9, x11
                self.w(0x9B407C00 | (T2 << 16) | (T0 << 5) | T1)
            else:
                # cbnz
                slow.push(self.fwd(0xB5000000 | T1))
                slow.push(self.fwd(0xB5000000 | T3))
                # umulh x10, x9, x11
                self.w(0x9BC07C00 | (T2 << 16) | (T0 << 5) | T1)
            self.w(0x9B007C00 | (T2 << 16) | (T0 << 5) | T0)
            self.st16(T0, x.d)
            let done = self.fwd(0x14000000)
            for at in slow:
                self.here(at, B19)
            let nm = ["add", "sub", "mul"][kind]
            self.call_rt(
                f"brine_x_{nm}_{w128(k)}",
                [
                    CArg(how=A_ADDR, v=x.d, fl=0),
                    CArg(how=A_ADDR, v=x.a, fl=0),
                    CArg(how=A_ADDR, v=x.b, fl=0),
                    CArg(how=A_VAL, v=x.c, fl=0)
                ]
            )
            self.here(done, B26)
            return
        let signed = k.is_signed()
        let r = self.dst(x.d)
        let ra = self.use(T0, x.a)
        if k.size() == 8 and kind != S_MUL and self.imm(x.b):
            let v = self.fval[x.b]
            if v >= 0 and v < 4096:
                # adds / subs with an immediate
                self.w((0xB1000000 if kind == S_ADD else 0xF1000000) | (v << 10) | (ra << 5) | r)
                var cc = C_VS
                if not signed:
                    cc = C_HS if kind == S_ADD else C_LO
                self.bcc_stub(cc, kind, x.a, x.b, x.c)
                self.st(r, x.d)
                return
        let rb = self.use(T1, x.b)
        if k.size() == 8:
            if kind == S_MUL:
                # the high half first: r may be a's or b's register
                if signed:
                    self.w(0x9B407C00 | (rb << 16) | (ra << 5) | T2)
                else:
                    self.w(0x9BC07C00 | (rb << 16) | (ra << 5) | T2)
                self.w(0x9B007C00 | (rb << 16) | (ra << 5) | r)
                if signed:
                    # cmp x11, r, asr #63
                    self.w(0xEB80FC1F | (r << 16) | (T2 << 5))
                else:
                    self.cmp_ri(T2, 0)
                self.bcc_stub(C_NE, kind, x.a, x.b, x.c)
            else:
                # adds / subs
                self.rrr(0xAB000000 if kind == S_ADD else 0xEB000000, r, ra, rb)
                var cc = C_VS
                if not signed:
                    cc = C_HS if kind == S_ADD else C_LO
                self.bcc_stub(cc, kind, x.a, x.b, x.c)
        else:
            # exact in 64 bits; overflow iff the result isn't canonical
            if kind == S_MUL:
                self.w(0x9B007C00 | (rb << 16) | (ra << 5) | r)
            else:
                self.rrr(0x8B000000 if kind == S_ADD else 0xCB000000, r, ra, rb)
            # cmp r, w(r), sxt / uxt of the kind
            self.w(0xEB20001F | (r << 16) | (ext_option(k) << 13) | (r << 5))
            self.bcc_stub(C_NE, kind, x.a, x.b, x.c)
        self.st(r, x.d)

    # brine_bytes_rev(d, n, i, j): bytes i..=j of byte array data d reversed
    # when that's in 0..n and under 16 bytes long; else false, having done
    # nothing. (Byte arrays have room for 16 bytes past any index: one 16-byte
    # load, a tbl and a store.)
    fn bytes_rev(ref self, x: Inst):
        let rd = self.use(T0, x.args[0])
        let rn = self.use(T1, x.args[1])
        let ri = self.use(T2, x.args[2])
        let rj = self.use(T3, x.args[3])
        self.rrr(0xEB000000, ZR, ri, rj)
        let t1 = self.fwd(0x54000000 | C_GE)
        self.cmp_ri(ri, 0)
        let f1 = self.fwd(0x54000000 | C_LT)
        self.rrr(0xEB000000, ZR, rj, rn)
        let f2 = self.fwd(0x54000000 | C_GE)
        # k = j - i, p = d + i
        self.rrr(0xCB000000, IP0, rj, ri)
        self.cmp_ri(IP0, 16)
        let f3 = self.fwd(0x54000000 | C_GE)
        self.rrr(0x8B000000, T3, rd, ri)
        self.rev16(T3, IP0)
        self.here(t1, B19)
        let r = self.dst(x.d)
        self.mov_ri(r, 1)
        let e = self.fwd(0x14000000)
        for f in [f1, f2, f3]:
            self.here(f, B19)
        self.mov_ri(r, 0)
        self.here(e, B26)
        self.st(r, x.d)

    # brine_bytes_rev0(d, n, j): bytes 0..=j reversed and the new d[0], when j
    # is in 0..min(n, 16); else -1, having done nothing.
    fn bytes_rev0(ref self, x: Inst):
        let rd = self.use(T0, x.args[0])
        let rn = self.use(T1, x.args[1])
        let rj = self.use(T2, x.args[2])
        self.rrr(0xEB000000, ZR, rj, rn)
        let f1 = self.fwd(0x54000000 | C_GE)
        # (unsigned: j < 0 fails too)
        self.cmp_ri(rj, 16)
        let f2 = self.fwd(0x54000000 | C_HS)
        self.rev16(rd, rj)
        let r = self.dst(x.d)
        # umov w, v0.b[0]
        self.w(0x0E013C00 | r)
        let e = self.fwd(0x14000000)
        self.here(f1, B19)
        self.here(f2, B19)
        self.mov_ri(r, -1)
        self.here(e, B26)
        self.st(r, x.d)

    # brine_bytes_rotl(d, n, lo, hi): t = d[lo]; d[lo..hi] = d[lo + 1..=hi];
    # d[hi] = t, false (doing nothing) unless lo <= hi in 0..n. Inline under 16
    # bytes, a tbl as in rev16. (Still a call to ra64.br, for the rest.)
    fn bytes_rotl(ref self, x: Inst):
        let rd = self.use(T0, x.args[0])
        let rn = self.use(T1, x.args[1])
        let rl = self.use(T2, x.args[2])
        let rh = self.use(T3, x.args[3])
        self.rrr(0xEB000000, ZR, rl, rh)
        let f1 = self.fwd(0x54000000 | C_GT)
        self.cmp_ri(rl, 0)
        let f2 = self.fwd(0x54000000 | C_LT)
        self.rrr(0xEB000000, ZR, rh, rn)
        let f3 = self.fwd(0x54000000 | C_GE)
        # k = hi - lo in IP0, p = d + lo in x17
        self.rrr(0xCB000000, IP0, rh, rl)
        self.cmp_ri(IP0, 16)
        let slow = self.fwd(0x54000000 | C_GE)
        self.rrr(0x8B000000, 17, rd, rl)
        self.ld_sym(T0, self.rotltab_sym())
        # add x9, x9, x16, lsl #4
        self.w(0x8B000000 | (IP0 << 16) | (4 << 10) | (T0 << 5) | T0)
        # ldr q0, [x17]; ldr q1, [x9]; tbl v0.16b, {v0.16b}, v1.16b; str q0, [x17]
        self.w(0x3DC00000 | (17 << 5))
        self.w(0x3DC00000 | (T0 << 5) | 1)
        self.w(0x4E010000)
        self.w(0x3D800000 | (17 << 5))
        self.bool_tail(x, [], [f1, f2, f3], [slow])

    # brine_bytes_copy(db, nb, da, na, lo, hi): b[lo..hi] = a[lo..hi], false
    # (doing nothing) when that is out of a's or b's bounds. Inline when it
    # runs to b's end and is at most 16 bytes: one 16-byte load and store
    # (byte arrays have room for 16 past any index).
    fn bytes_copy(ref self, x: Inst):
        let rl = self.use(T0, x.args[4])
        let rh = self.use(T1, x.args[5])
        self.rrr(0xEB000000, ZR, rl, rh)
        let t1 = self.fwd(0x54000000 | C_GE)
        self.cmp_ri(rl, 0)
        let f1 = self.fwd(0x54000000 | C_LT)
        let rna = self.use(T2, x.args[3])
        self.rrr(0xEB000000, ZR, rh, rna)
        let f2 = self.fwd(0x54000000 | C_GT)
        let rnb = self.use(T2, x.args[1])
        self.rrr(0xEB000000, ZR, rh, rnb)
        let f3 = self.fwd(0x54000000 | C_GT)
        let s1 = self.fwd(0x54000000 | C_NE)
        self.rrr(0xCB000000, IP0, rh, rl)
        self.cmp_ri(IP0, 16)
        let s2 = self.fwd(0x54000000 | C_GT)
        let rda = self.use(T2, x.args[2])
        # ldr q0, [da, lo]
        self.w(0x3CE06800 | (rl << 16) | (rda << 5))
        let rdb = self.use(T2, x.args[0])
        # str q0, [db, lo]
        self.w(0x3CA06800 | (rl << 16) | (rdb << 5))
        self.bool_tail(x, [t1], [f1, f2, f3], [s1, s2])

    # Ends an inline runtime operation: true from here and the `ok` jumps,
    # false from the `fail` ones; the `slow` ones jump to the call.
    fn bool_tail(ref self, x: Inst, ok: [int], fail: [int], slow: [int]):
        for f in ok:
            self.here(f, B19)
        let r = self.dst(x.d)
        self.mov_ri(r, 1)
        let e = self.fwd(0x14000000)
        for f in fail:
            self.here(f, B19)
        self.mov_ri(r, 0)
        self.here(e, B26)
        self.st(r, x.d)
        if len(slow) > 0:
            let e2 = self.fwd(0x14000000)
            for f in slow:
                self.here(f, B19)
            self.rt_call(x)
            self.here(e2, B26)

    # Bytes 0..=k (k in register rk, below 16) of the 16 at register p
    # reversed, the rest kept; v0 holds the result. Uses T2 / T3 unless they
    # are p or rk.
    fn rev16(ref self, p: int, rk: int):
        let t = T2 if p != T2 and rk != T2 else (T3 if p != T3 and rk != T3 else T1)
        self.ld_sym(t, self.revtab_sym())
        # add t, t, rk, lsl #4
        self.w(0x8B000000 | (rk << 16) | (4 << 10) | (t << 5) | t)
        # ldr q0, [p]; ldr q1, [t]; tbl v0.16b, {v0.16b}, v1.16b; str q0, [p]
        self.w(0x3DC00000 | (p << 5))
        self.w(0x3DC00000 | (t << 5) | 1)
        self.w(0x4E010000)
        self.w(0x3D800000 | (p << 5))

    fn elem(ref self, x: Inst):
        let n = x.n
        if n == 0:
            self.set_v(x.d, x.a)
            return
        let r = self.dst(x.d)
        # (an index this large is out of bounds, in code that never runs)
        if self.imm(x.b) and self.fval[x.b] >= -(1 << 40) and self.fval[x.b] < 1 << 40:
            let off = self.fval[x.b] * n
            if self.fold[x.a] == F_SLOT:
                self.add_ri(r, SP, self.slot_off[self.fval[x.a]] + off)
            else:
                let ra = self.use(T0, x.a)
                self.add_ri(r, ra, off)
            self.st(r, x.d)
            return
        let ra = self.use(T0, x.a)
        let rb = self.use(T1, x.b)
        if (n & (n - 1)) == 0:
            # add r, ra, rb, lsl #log2(n)
            self.w(0x8B000000 | (rb << 16) | (log2(n) << 10) | (ra << 5) | r)
        else:
            self.mov_ri(T2, n)
            # madd r, rb, x11, ra
            self.w(0x9B000000 | (T2 << 16) | (ra << 10) | (rb << 5) | r)
        self.st(r, x.d)

    fn copy_mem(ref self, dst: int, src: int, n: int):
        if n > 64:
            self.call_rt(
                "memcpy",
                [
                    CArg(how=A_VAL, v=dst, fl=0),
                    CArg(how=A_VAL, v=src, fl=0),
                    CArg(how=A_IMM, v=n, fl=0)
                ]
            )
            return
        let (db, dd) = self.addr(dst, 0, T2)
        let (sb, sd) = self.addr(src, 0, T3)
        var i = 0
        for (size, ld, st) in [
            (8, M_LDRX, M_STRX),
            (4, M_LDRW, M_STRW),
            (2, M_LDRH, M_STRH),
            (1, M_LDRB, M_STRB)
        ]:
            while i + size <= n:
                self.ldst(ld, T0, sb, sd + i)
                self.ldst(st, T0, db, dd + i)
                i += size

    fn zero_mem(ref self, dst: int, n: int):
        if n > 64:
            self.call_rt(
                "memset",
                [
                    CArg(how=A_VAL, v=dst, fl=0),
                    CArg(how=A_IMM, v=0, fl=0),
                    CArg(how=A_IMM, v=n, fl=0)
                ]
            )
            return
        let (db, dd) = self.addr(dst, 0, T2)
        var i = 0
        for (size, st) in [(8, M_STRX), (4, M_STRW), (2, M_STRH), (1, M_STRB)]:
            while i + size <= n:
                self.ldst(st, ZR, db, dd + i)
                i += size

    # ------------------------------------------------------------ conversions
    fn conv(ref self, x: Inst):
        let ks = self.vk[x.a]
        let kd = self.vk[x.d]
        if ks == kd:
            if kd.is_wide():
                self.copy_v16(x.d, x.a)
            elif kd.is_float():
                let fl = fl_of(kd)
                let fa = self.fuse(fl, 0, x.a)
                self.fst(fl, x.d, fa)
            else:
                self.set_v(x.d, x.a)
            return
        if ks.is_float() and kd.is_float():
            let fa = self.fuse(fl_of(ks), 0, x.a)
            let r = self.fdst(x.d)
            # fcvt d, s / fcvt s, d
            self.w((0x1E22C000 if ks == K.F32 else 0x1E624000) | (fa << 5) | r)
            self.fst(fl_of(kd), x.d, r)
            return
        if ks.is_wide():
            if kd.is_wide():
                self.copy_v16(x.d, x.a)
            elif kd.is_float():
                let nm = "f64" if kd == K.F64 else "f32"
                self.call_rt(f"brine_x_{w128(ks)}_to_{nm}", [CArg(how=A_ADDR, v=x.a, fl=0)])
                self.store_ret(x.d)
            elif kd == K.Bool:
                self.ld16(T0, x.a)
                self.rrr(0xAA000000, T0, T0, T1)
                self.cmp_ri(T0, 0)
                self.cset(T0, C_NE)
                self.st(T0, x.d)
            else:
                # the low word only (from its register, if just stored)
                var r = self.dst(x.d)
                if self.st_end == self.pos() and self.st_home == self.home[x.a]:
                    r = self.st_lo
                else:
                    self.ldst(M_LDRX, r, SP, self.home[x.a])
                self.norm(r, kd)
                self.st(r, x.d)
            return
        if kd.is_wide():
            if ks.is_float():
                let nm = "f64" if ks == K.F64 else "f32"
                self.call_rt(
                    f"brine_x_{w128(kd)}_from_{nm}",
                    [CArg(how=A_ADDR, v=x.d, fl=0), CArg(how=A_VAL, v=x.a, fl=fl_of(ks))]
                )
            else:
                let ra = self.use(T0, x.a)
                self.ldst(M_STRX, ra, SP, self.home[x.d])
                if ks.is_signed():
                    # asr x10, ra, #63
                    self.w(0x9340FC00 | (63 << 16) | (ra << 5) | T1)
                    self.ldst(M_STRX, T1, SP, self.home[x.d] + 8)
                else:
                    self.ldst(M_STRX, ZR, SP, self.home[x.d] + 8)
            return
        if kd.is_float():
            let ra = self.use(T0, x.a)
            let r = self.fdst(x.d)
            # scvtf / ucvtf
            var op = 0x9E220000 if ks.is_signed() else 0x9E230000
            if kd == K.F64:
                op = op | 0x400000
            self.w(op | (ra << 5) | r)
            self.fst(fl_of(kd), x.d, r)
            return
        if ks.is_float():
            let fa = self.fuse(fl_of(ks), 0, x.a)
            let r = self.dst(x.d)
            # fcvtzu for 64-bit unsigned results, fcvtzs for the rest (the
            # lowering checks the range first)
            var op = 0x9E390000 if kd == K.U64 or kd == K.Ptr else 0x9E380000
            if ks == K.F64:
                op = op | 0x400000
            self.w(op | (fa << 5) | r)
            self.norm(r, kd)
            self.st(r, x.d)
            return
        # integer to integer
        let r = self.dst(x.d)
        let ra = self.use(T0, x.a)
        if kd == K.Bool:
            self.cmp_ri(ra, 0)
            self.cset(r, C_NE)
        else:
            self.mov_rr(r, ra)
            if needs_norm(ks, kd):
                self.norm(r, kd)
        self.st(r, x.d)

# ================================================================ module

fn emit_object(m: Module, release: bool) -> [u8]:
    var o = emit(m, false, release, "", "", "")
    return write_elf(ref o)

# The object in memory, for brine's own linker (link.br); with DWARF debug
# info when `dbg`, for the main source file `src` relative to `comp_dir`.
fn emit_obj(m: Module, dbg: bool, release: bool, src: str, comp_dir: str, producer: str) -> ObjFile:
    return emit(m, dbg, release and not dbg, src, comp_dir, producer)

fn emit(m0: Module, dbg: bool, on: bool, src: str, comp_dir: str, producer: str) -> ObjFile:
    let m = prune_rt(m0)
    var dw = new_dwarf()
    # DW_OP_reg29
    dw.fbase = 80 + FP
    var o = new_obj()
    o.arch = ARCH_A64
    var x = A(
        o=o,
        syms={},
        wide_ret={},
        wide_rt=wide_rt_helpers(),
        text_sym=0,
        ovf=[-1, -1, -1],
        code=[],
        vk=[],
        nparams=0,
        home=[],
        reg=[],
        freg=[],
        saved=[],
        fsaved=[],
        fold=[],
        fval=[],
        wshift=[],
        st_end=-1,
        st_lo=0,
        st_home=0,
        nuse=[],
        dec_br=-1,
        slot_off=[],
        ploc=[],
        lpos=[],
        jat=[],
        jlab=[],
        jkind=[],
        stubs=[],
        retp=0,
        scratch=0,
        cold={},
        keep=[],
        keep_off=0,
        has_ret=false,
        ret=K.I64,
        cur=0,
        u=Unw(start=0, fp=0, pro_end=0, epis=[]),
        dbg=dbg,
        dw=dw,
        ipos=[],
        rows=[],
        entry_main=false,
        entry=(-1, -1),
        ssa=on,
        dead=[]
    )
    for n in m.cold:
        x.cold[n] = true
    for f in m.funcs:
        if f.cold:
            x.cold[f.name] = true
    x.text_sym = x.sym_def("__brx_text", SEC_TEXT, 0, false, false)
    a64_cie(ref x.o.unwind)
    for f in m.funcs:
        x.sym_def(f.name, SEC_TEXT, 0, f.public or f.export, true)
        if f.has_ret and f.ret.is_wide():
            x.wide_ret[f.name] = true
    for d in m.data:
        # read-only data with addresses in it goes to .data (PIE)
        let ro = d.readonly and len(d.relocs) == 0
        let a = max(d.align, 1)
        var base = 0
        if ro:
            while len(x.o.rodata) % a != 0:
                x.o.rodata.push(0)
            x.o.rodata_align = max(x.o.rodata_align, a)
            base = len(x.o.rodata)
            x.sym_def(d.name, SEC_RODATA, base, false, false)
            x.o.rodata.extend(d.bytes)
        else:
            while len(x.o.data) % a != 0:
                x.o.data.push(0)
            x.o.data_align = max(x.o.data_align, a)
            base = len(x.o.data)
            # (the runtime's variables C reads too)
            x.sym_def(d.name, SEC_DATA, base, d.name.starts_with("brine_"), false)
            x.o.data.extend(d.bytes)
        for r in d.relocs:
            let rs = x.sym_ref(r.sym)
            x.o.drel.push(ORel(off=base + r.off, sym=rs, kind=R_ABS64, add=r.add))
    x.entry_main = dbg and any(f.name == "main__main" for f in m.funcs)
    let arrs = const_arrs(m)
    if dbg:
        for f in emit_order(m.funcs, dbg):
            x.func(f)
    else:
        # each function is optimized on its own, so all at once
        let fs = inline_small(m.funcs, on)
        let done = par [opt_func(f, arrs, on, 2, true) for f in fs]
        var ks = m.kernels
        for (g, gk) in done:
            x.func(g)
            ks.extend(gk)
        for k in ks:
            x.kernel(k)
    # calls inside .text need no relocation
    var keep: [ORel] = []
    for r in x.o.trel:
        let s = x.o.syms[r.sym]
        if r.kind == R_A64_CALL26 and s.sec == SEC_TEXT:
            x.patch(r.off, s.off + r.add, B26)
        else:
            keep.push(r)
    x.o.trel = keep
    if dbg:
        write_dwarf(ref x.o, x.dw, m.dtypes, x.text_sym, src, comp_dir, producer)
    return x.o

# A two-lane loop body without vloop.br's copies: SSE2 operations change
# their first operand, so it copies that into the result's register first,
# but KV_FOP names the operand, which NEON reads instead.
fn no_copies(ops: [KOp]) -> [KOp]:
    var out: [KOp] = []
    var i = 0
    while i < len(ops):
        let o = ops[i]
        if not (
            o.op == KV_MOV
            and i + 1 < len(ops)
            and ops[i + 1].op == KV_FOP
            and ops[i + 1].a == o.a
            and ops[i + 1].b != o.a
            and ops[i + 1].m != o.a
        ):
            out.push(o)
        i += 1
    return out

# The body twice over, for two steps (four elements) at a time, or [] when it
# can't be: the second copy writes other registers and reads [n + 16], which
# needs every register the body writes to be written before it is read (no
# value carried from one step to the next, as a sum is) and none read after
# the loop, and enough free registers (of v0-v7 and v16-v29).
fn unroll2(t: KPath, body: [KOp]) -> [KOp]:
    var used = [false] * 32
    for ops in [t.pre, t.post]:
        for o in ops:
            used[o.a] = true
            if o.op == KV_FOP or o.op == KV_MOV or o.op == KV_RED:
                used[o.b] = true
            if o.op == KV_FOP:
                used[o.m] = true
    var written = [false] * 32
    var rename = [-1] * 32
    for o in body:
        var reads: [int] = []
        var w = -1
        match o.op:
            case KV_LD:
                w = o.a
            case KV_ST:
                reads = [o.a]
            case KV_MOV:
                reads = [o.b]
                w = o.a
            case KV_FOP:
                reads = [o.b, o.m]
                w = o.a
            case _:
                return []
        for r in reads:
            used[r] = true
        if w >= 0:
            if used[w] and not written[w]:
                return []
            written[w] = true
            used[w] = true
    var next = 0
    for r in 0..32:
        if written[r]:
            # (not v8-v15: the caller's, and only k.regs get saved)
            while next < 30 and (used[next] or (next >= 8 and next < 16)):
                next += 1
            if next >= 30:
                return []
            rename[r] = next
            next += 1
    for ops in [t.post]:
        for o in ops:
            if written[o.a] or ((o.op == KV_RED or o.op == KV_MOV) and written[o.b]):
                return []
    var out = body
    for o in body:
        var c = o
        if rename[c.a] >= 0:
            c.a = rename[c.a]
        if c.op == KV_LD or c.op == KV_ST:
            c.n += 16
        else:
            if rename[c.b] >= 0:
                c.b = rename[c.b]
            if c.op == KV_FOP and rename[c.m] >= 0:
                c.m = rename[c.m]
        out.push(c)
    return out

# fadd / fsub / fmul / fdiv d, d, d for the SSE2 opcode n
fn scalar_fop(n: int) -> int:
    if n == SSE_SUB:
        return 0x1E603800
    if n == SSE_MUL:
        return 0x1E600800
    if n == SSE_DIV:
        return 0x1E601800
    assert n == SSE_ADD, f"a64: kernel opcode {n}"
    return 0x1E602800

# For each operation of a kernel: is its register a's upper lane unread
# after it (until something writes it)? SSE2's scalar operations keep that
# lane, which costs NEON a second instruction, unless nothing reads it.
fn hi_dead(ops: [KOp]) -> [bool]:
    var live = [false] * 32
    var dead = [false] * len(ops)
    var i = len(ops) - 1
    while i >= 0:
        let o = ops[i]
        let a = o.a
        dead[i] = not live[a]
        let la = live[a]
        match o.op:
            case KO_MOV:
                live[a] = false
                if la:
                    live[o.b] = true
            case KO_ST:
                if o.m == 1:
                    live[a] = true
            case KO_STH | KO_SPILL:
                live[a] = true
            case KO_OP:
                if o.n == SSE_UNPH:
                    live[a] = true
                    if la:
                        live[o.b] = true
                elif o.m == PFX_PD or o.n == SSE_XOR:
                    if la:
                        live[o.b] = true
            case KO_SQRT:
                if o.m == PFX_PD:
                    live[a] = false
                    if la:
                        live[o.b] = true
            case KO_SHUF:
                live[a] = (o.n & 1) == 1
                if la and (o.n & 2) != 0:
                    live[o.b] = true
            case KO_LD | KO_LDP | KO_LDH | KO_CONST | KO_CONST2 | KO_FILL | KO_ARG:
                live[a] = false
            case _:
                live[a] = true
        i -= 1
    return dead

# Splats NEON doesn't need: a copy t = s then t = (s[l], s[l]), when every
# read of t before it's written again is a multiply (NEON multiplies by a
# lane) and s stays the same until then. For each operation: -2 to leave it
# out, 64x + 2s + l for a multiply of x and s's lane l (in place of t), -1
# else.
fn kmul_lanes(ops: [KOp], hd: [bool], has_ret: bool) -> [int]:
    var el = [-1] * len(ops)
    var i = 0
    while i + 1 < len(ops):
        let c = ops[i]
        let p = ops[i + 1]
        let t = c.a
        let s = c.b
        var l = -1
        if c.op == KO_MOV and t != s and p.a == t and (p.b == t or p.b == s):
            if p.op == KO_SHUF and (p.n & 3) == 0:
                l = 0
            elif p.op == KO_SHUF and (p.n & 3) == 3:
                l = 1
            elif p.op == KO_OP and p.n == SSE_UNPH:
                l = 1
        if l < 0 or el[i] != -1 or el[i + 1] != -1:
            i += 1
            continue
        var uses: [int] = []
        var ok = true
        var dirty = false
        var j = i + 2
        while j < len(ops):
            let o = ops[j]
            let mul = o.op == KO_OP and o.n == SSE_MUL and (o.m == PFX_PD or hd[j])
            if mul and (o.a == t) != (o.b == t) and el[j] == -1:
                if dirty:
                    ok = false
                    break
                uses.push(j)
                if o.a == t:
                    break
            elif kop_reads(o, t):
                ok = false
                break
            elif o.a == t:
                break
            if o.a == s and o.op != KO_ST and o.op != KO_STH and o.op != KO_SPILL:
                dirty = true
            j += 1
        if j == len(ops) and has_ret and t == 0:
            ok = false
        if ok and len(uses) > 0:
            el[i] = -2
            el[i + 1] = -2
            for u in uses:
                let o = ops[u]
                el[u] = 64 * (o.b if o.a == t else o.a) + 2 * s + l
            i += 2
        else:
            i += 1
    return el

# Does o read register r (any lane)?
fn kop_reads(o: KOp, r: int) -> bool:
    match o.op:
        case KO_LD | KO_LDP | KO_CONST | KO_CONST2 | KO_FILL | KO_ARG:
            return false
        case KO_MOV:
            return o.b == r
        case KO_ST | KO_STH | KO_SPILL | KO_LDH:
            return o.a == r
        case KO_SQRT:
            return o.b == r or (o.a == r and o.m != PFX_PD)
        case _:
            return o.a == r or o.b == r

# The kind of branch to patch at a release's exits: tbnz (B14), b (B26), or
# b.cond / cbnz (B19).
fn done_kind(ins: int) -> int:
    if ins >> 24 == 0xB7:
        return B14
    if ins >> 26 == 5:
        return B26
    return B19

# Is operand j (0: a, 1: b) of x one a64.br needs in a register even when it
# is a constant (it has no immediate form there)?
fn needs_reg(x: Inst, j: int) -> bool:
    match x.op:
        case Op.Sub | Op.Shl | Op.Shr:
            return j == 0
        case Op.Mul | Op.Div | Op.Rem:
            return true
        case _:
            return false

# A one-instruction integer constant that some instructions need in a
# register (the 1 of `1 << n`) gets a register, and so would every other use
# of it, which could take it as an immediate. Those get a copy of the
# constant of their own, made where they use it, so the register is held
# only for the uses that need it.
fn split_consts(f: Func) -> Func:
    let nv = len(f.vk)
    var ndef = [0] * nv
    var at = [-1] * nv
    for i in 0..f.nparams:
        ndef[i] = 1
    for i, x in enumerate(f.code):
        if x.d >= 0:
            ndef[x.d] += 1
            at[x.d] = i
    var ok = [false] * nv
    for v in f.nparams..nv:
        if ndef[v] == 1:
            let x = f.code[at[v]]
            let k = f.vk[v]
            ok[v] = (
                x.op == Op.Const
                and not k.is_float()
                and not k.is_wide()
                and mov_cost(canon(x.n, k)) == 1
            )
    # uses of each constant, and those that need it in a register
    var nall = [0] * nv
    var nreg = [0] * nv
    for x in f.code:
        let rs = reads(x, nv)
        if len(rs) == 0:
            continue
        for v in rs:
            nall[v] += 1
        if x.op != Op.Switch and x.op != Op.Call:
            if x.a >= 0 and x.a < nv and needs_reg(x, 0):
                nreg[x.a] += 1
            if x.b >= 0 and x.b < nv and needs_reg(x, 1):
                nreg[x.b] += 1
    var to = [-1] * nv
    var g = f
    for v in f.nparams..nv:
        if ok[v] and nreg[v] > 0 and nall[v] > nreg[v]:
            to[v] = len(g.vk)
            g.vk.push(f.vk[v])
    if len(g.vk) == nv:
        return f
    var code: [Inst] = []
    for x0 in f.code:
        var x = x0
        if x.op == Op.Switch:
            if x.a >= 0 and x.a < nv and to[x.a] >= 0:
                x.a = to[x.a]
        elif x.op == Op.Call or x.op == Op.CallInd:
            for j in 0..len(x.args):
                let v = x.args[j]
                if to[v] >= 0:
                    x.args[j] = to[v]
            if x.op == Op.CallInd and x.a >= 0 and x.a < nv and to[x.a] >= 0:
                x.a = to[x.a]
        elif len(reads(x, nv)) > 0:
            if x.a >= 0 and x.a < nv and to[x.a] >= 0 and not needs_reg(x, 0):
                x.a = to[x.a]
            if x.b >= 0 and x.b < nv and to[x.b] >= 0 and not needs_reg(x, 1):
                x.b = to[x.b]
            if (
                (x.op == Op.AddO or x.op == Op.SubO or x.op == Op.MulO or x.op == Op.IdxChk)
                and x.c >= 0
                and to[x.c] >= 0
            ):
                x.c = to[x.c]
        code.push(x)
        if x0.d >= 0 and x0.d < nv and to[x0.d] >= 0:
            var y = x0
            y.d = to[x0.d]
            code.push(y)
    g.code = code
    return g
