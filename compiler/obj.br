# Relocatable object files for the native backend: an in-memory object
# (sections, symbols, relocations) and writers for COFF (Windows) and ELF64
# (Linux), both x86-64.

from ir import str_bytes

# sections
const SEC_UNDEF = 0
const SEC_TEXT = 1
const SEC_DATA = 2
const SEC_RODATA = 3
# unwind tables: COFF .xdata (UNWIND_INFO), ELF .eh_frame
const SEC_UNWIND = 4
# COFF only: .pdata, the table of functions and their UNWIND_INFO
const SEC_PDATA = 5

# Relocation kinds. Addends follow ELF: the value stored is S + A (absolute) or
# S + A - P (pc-relative, P = the address of the 4-byte field).
# a rip-relative data reference (lea / mov / ... [rip + disp32])
const R_PC32 = 0
# call rel32
const R_CALL = 1
# an 8-byte absolute address in data
const R_ABS64 = 2
# ELF only: `mov r64, [rip + disp32]` loading the address from the GOT
const R_GOT = 3
# COFF only: a 4-byte address relative to the image base (S + A - ImageBase)
const R_RVA32 = 4

struct OSym:
    name: str
    # SEC_*; SEC_UNDEF for external symbols
    sec: int
    off: int
    global: bool
    func: bool

struct ORel:
    off: int
    sym: int
    kind: int
    add: int

struct ObjFile:
    text: [u8]
    data: [u8]
    rodata: [u8]
    unwind: [u8]
    pdata: [u8]
    # alignment of each section (a power of two)
    text_align: int
    data_align: int
    rodata_align: int
    syms: [OSym]
    trel: [ORel]
    drel: [ORel]
    rrel: [ORel]
    urel: [ORel]
    prel: [ORel]

fn new_obj() -> ObjFile:
    return ObjFile(
        text=[],
        data=[],
        rodata=[],
        unwind=[],
        pdata=[],
        text_align=16,
        data_align=16,
        rodata_align=16,
        syms=[],
        trel=[],
        drel=[],
        rrel=[],
        urel=[],
        prel=[]
    )

# ================================================================ bytes

fn put8(ref out: [u8], v: int):
    out.push(u8(v & 255))

fn put16(ref out: [u8], v: int):
    out.push(u8(v & 255))
    out.push(u8((v >> 8) & 255))

fn put32(ref out: [u8], v: int):
    out.push(u8(v & 255))
    out.push(u8((v >> 8) & 255))
    out.push(u8((v >> 16) & 255))
    out.push(u8((v >> 24) & 255))

fn put64(ref out: [u8], v: int):
    put32(ref out, v & 4294967295)
    put32(ref out, (v >> 32) & 4294967295)

# unsigned and signed LEB128 (DWARF)
fn uleb(ref out: [u8], v: int):
    var x = v
    while x >= 128:
        out.push(u8((x & 127) | 128))
        x = x >> 7
    out.push(u8(x))

fn sleb(ref out: [u8], v: int):
    var x = v
    while true:
        let b = x & 127
        x = x >> 7
        if (x == 0 and (b & 64) == 0) or (x == -1 and (b & 64) != 0):
            out.push(u8(b))
            return
        out.push(u8(b | 128))

fn set32(ref out: [u8], at: int, v: int):
    out[at] = u8(v & 255)
    out[at + 1] = u8((v >> 8) & 255)
    out[at + 2] = u8((v >> 16) & 255)
    out[at + 3] = u8((v >> 24) & 255)

fn set64(ref out: [u8], at: int, v: int):
    set32(ref out, at, v & 4294967295)
    set32(ref out, at + 4, (v >> 32) & 4294967295)

fn pad_to(ref out: [u8], align: int):
    while len(out) % align != 0:
        out.push(0)

# a fixed-size name field (COFF section names)
fn put_name8(ref out: [u8], s: str):
    let bs = s.bytes()
    for i in 0..8:
        if i < len(bs):
            out.push(u8(bs[i]))
        else:
            out.push(0)

fn log2(n: int) -> int:
    var k = 0
    while (1 << k) < n:
        k += 1
    return k

# ================================================================ COFF

fn coff_reloc_type(kind: int) -> int:
    if kind == R_ABS64:
        # IMAGE_REL_AMD64_ADDR64
        return 1
    if kind == R_RVA32:
        # IMAGE_REL_AMD64_ADDR32NB
        return 3
    # IMAGE_REL_AMD64_REL32
    return 4

# COFF keeps addends in the section bytes: REL32 adds the stored value to
# S - (P + 4), ADDR64 to S and ADDR32NB to S - ImageBase.
fn coff_addends(ref sec: [u8], rels: [ORel]):
    for r in rels:
        if r.kind == R_ABS64:
            set64(ref sec, r.off, r.add)
        elif r.kind == R_RVA32:
            set32(ref sec, r.off, r.add)
        else:
            set32(ref sec, r.off, r.add + 4)

fn coff_relocs(ref out: [u8], rels: [ORel]):
    if len(rels) >= 65535:
        # IMAGE_SCN_LNK_NRELOC_OVFL: the first entry holds the count
        put32(ref out, len(rels) + 1)
        put32(ref out, 0)
        put16(ref out, 0)
    for r in rels:
        put32(ref out, r.off)
        put32(ref out, r.sym)
        put16(ref out, coff_reloc_type(r.kind))

fn coff_align_flag(a: int) -> int:
    # IMAGE_SCN_ALIGN_<a>BYTES
    return (log2(a) + 1) << 20

fn write_coff(ref o: ObjFile) -> [u8]:
    coff_addends(ref o.text, o.trel)
    coff_addends(ref o.data, o.drel)
    coff_addends(ref o.rodata, o.rrel)
    coff_addends(ref o.unwind, o.urel)
    coff_addends(ref o.pdata, o.prel)
    # in SEC_* order, so a symbol's section number is its index + 1
    let secs = [o.text, o.data, o.rodata, o.unwind, o.pdata]
    let rels = [o.trel, o.drel, o.rrel, o.urel, o.prel]
    let names = [".text", ".data", ".rdata", ".xdata", ".pdata"]
    # code / initialized data, and read / write / execute
    let flags = [
        1610612768 | coff_align_flag(o.text_align),
        3221225536 | coff_align_flag(o.data_align),
        1073741888 | coff_align_flag(o.rodata_align),
        1073741888 | coff_align_flag(4),
        1073741888 | coff_align_flag(4)
    ]
    let nsec = len(secs)
    var pos = 20 + 40 * nsec
    # per section: [raw data pointer, relocations pointer]
    var at: [[int]] = []
    for i in 0..nsec:
        pos = (pos + 15) / 16 * 16
        let raw = pos
        pos += len(secs[i])
        pos = (pos + 3) / 4 * 4
        let rel = pos
        var nr = len(rels[i])
        if nr >= 65535:
            nr += 1
        pos += 10 * nr
        at.push([raw, rel])
    pos = (pos + 3) / 4 * 4
    let symtab = pos
    var out: [u8] = []
    # file header
    put16(ref out, 34404)
    put16(ref out, nsec)
    put32(ref out, 0)
    put32(ref out, symtab)
    put32(ref out, len(o.syms))
    put16(ref out, 0)
    put16(ref out, 0)
    for i in 0..nsec:
        let size = len(secs[i])
        let nr = len(rels[i])
        put_name8(ref out, names[i])
        put32(ref out, 0)
        put32(ref out, 0)
        put32(ref out, size)
        put32(ref out, at[i][0] if size > 0 else 0)
        put32(ref out, at[i][1] if nr > 0 else 0)
        put32(ref out, 0)
        var fl = flags[i]
        if nr >= 65535:
            put16(ref out, 65535)
            fl = fl | 16777216
        else:
            put16(ref out, nr)
        put16(ref out, 0)
        put32(ref out, fl)
    for i in 0..nsec:
        pad_to(ref out, 16)
        out.extend(secs[i])
        pad_to(ref out, 4)
        coff_relocs(ref out, rels[i])
    pad_to(ref out, 4)
    # symbols
    var strs: [u8] = []
    put32(ref strs, 0)
    for s in o.syms:
        let bs = s.name.bytes()
        if len(bs) <= 8:
            put_name8(ref out, s.name)
        else:
            put32(ref out, 0)
            put32(ref out, len(strs))
            str_bytes(ref strs, s.name)
            strs.push(0)
        put32(ref out, s.off if s.sec != SEC_UNDEF else 0)
        put16(ref out, s.sec)
        put16(ref out, 32 if s.func else 0)
        out.push(u8(2 if s.global or s.sec == SEC_UNDEF else 3))
        out.push(0)
    set32(ref strs, 0, len(strs))
    out.extend(strs)
    return out

# ================================================================ ELF64

fn elf_reloc_type(kind: int) -> int:
    match kind:
        case 0:
            # R_X86_64_PC32
            return 2
        case 1:
            # R_X86_64_PLT32
            return 4
        case 2:
            # R_X86_64_64
            return 1
        case _:
            # R_X86_64_GOTPCREL
            return 9

fn elf_relocs(rels: [ORel], map: [int]) -> [u8]:
    var out: [u8] = []
    for r in rels:
        put64(ref out, r.off)
        put32(ref out, elf_reloc_type(r.kind))
        put32(ref out, map[r.sym])
        put64(ref out, r.add)
    return out

fn elf_shdr(
    ref out: [u8],
    name: int,
    typ: int,
    flags: int,
    off: int,
    size: int,
    link: int,
    info: int,
    align: int,
    entsize: int
):
    put32(ref out, name)
    put32(ref out, typ)
    put64(ref out, flags)
    put64(ref out, 0)
    put64(ref out, off)
    put64(ref out, size)
    put32(ref out, link)
    put32(ref out, info)
    put64(ref out, align)
    put64(ref out, entsize)

# section header indexes
const ELF_RELA = 5
const ELF_SYMTAB = 9
const ELF_STRTAB = 10
const ELF_SHSTRTAB = 11
const ELF_NOTE = 12
const ELF_NSEC = 13

fn write_elf(ref o: ObjFile) -> [u8]:
    # symbol order: null, locals, then globals (ELF requires it)
    let n = len(o.syms)
    var map = [0] * n
    var order: [int] = []
    for i in 0..n:
        if not (o.syms[i].global or o.syms[i].sec == SEC_UNDEF):
            map[i] = len(order) + 1
            order.push(i)
    let first_global = len(order) + 1
    for i in 0..n:
        if o.syms[i].global or o.syms[i].sec == SEC_UNDEF:
            map[i] = len(order) + 1
            order.push(i)
    var strtab: [u8] = [0]
    var symtab: [u8] = []
    for _ in 0..24:
        symtab.push(0)
    for i in order:
        let s = o.syms[i]
        put32(ref symtab, len(strtab))
        str_bytes(ref strtab, s.name)
        strtab.push(0)
        let bind = 1 if s.global or s.sec == SEC_UNDEF else 0
        var typ = 0
        if s.sec != SEC_UNDEF:
            typ = 2 if s.func else 1
        symtab.push(u8(bind * 16 + typ))
        symtab.push(0)
        put16(ref symtab, s.sec)
        put64(ref symtab, s.off if s.sec != SEC_UNDEF else 0)
        put64(ref symtab, 0)
    # sections 1-4 are SEC_TEXT .. SEC_UNWIND, so symbols name them by number;
    # sections 5-8 hold their relocations
    let progs = [o.text, o.data, o.rodata, o.unwind]
    let rels = [o.trel, o.drel, o.rrel, o.urel]
    let pnames = [".text", ".data", ".rodata", ".eh_frame"]
    # SHT_PROGBITS, SHT_X86_64_UNWIND
    let ptype = [1, 1, 1, 1879048193]
    # SHF_ALLOC 2, SHF_WRITE 1, SHF_EXECINSTR 4
    let pflags = [6, 3, 2, 2]
    let palign = [o.text_align, o.data_align, o.rodata_align, 8]
    var names: [str] = []
    names.extend(pnames)
    for nm in pnames:
        names.push(".rela" + nm)
    names.extend([".symtab", ".strtab", ".shstrtab", ".note.GNU-stack"])
    var shstr: [u8] = [0]
    var name_off: [int] = [0]
    for nm in names:
        name_off.push(len(shstr))
        str_bytes(ref shstr, nm)
        shstr.push(0)
    var out: [u8] = []
    for _ in 0..64:
        out.push(0)
    # section contents, remembering offsets and sizes
    var offs = [0] * ELF_NSEC
    var sizes = [0] * ELF_NSEC
    for i in 0..4:
        pad_to(ref out, 16)
        offs[1 + i] = len(out)
        sizes[1 + i] = len(progs[i])
        out.extend(progs[i])
    pad_to(ref out, 8)
    for i in 0..4:
        let r = elf_relocs(rels[i], map)
        offs[ELF_RELA + i] = len(out)
        sizes[ELF_RELA + i] = len(r)
        out.extend(r)
    offs[ELF_SYMTAB] = len(out)
    sizes[ELF_SYMTAB] = len(symtab)
    out.extend(symtab)
    offs[ELF_STRTAB] = len(out)
    sizes[ELF_STRTAB] = len(strtab)
    out.extend(strtab)
    offs[ELF_SHSTRTAB] = len(out)
    sizes[ELF_SHSTRTAB] = len(shstr)
    out.extend(shstr)
    offs[ELF_NOTE] = len(out)
    pad_to(ref out, 8)
    let shoff = len(out)
    for _ in 0..64:
        out.push(0)
    for i in 0..4:
        elf_shdr(
            ref out,
            name_off[1 + i],
            ptype[i],
            pflags[i],
            offs[1 + i],
            sizes[1 + i],
            0,
            0,
            palign[i],
            0
        )
    for i in 0..4:
        let s = ELF_RELA + i
        # SHT_RELA, SHF_INFO_LINK
        elf_shdr(ref out, name_off[s], 4, 64, offs[s], sizes[s], ELF_SYMTAB, 1 + i, 8, 24)
    elf_shdr(
        ref out,
        name_off[ELF_SYMTAB],
        2,
        0,
        offs[ELF_SYMTAB],
        sizes[ELF_SYMTAB],
        ELF_STRTAB,
        first_global,
        8,
        24
    )
    elf_shdr(ref out, name_off[ELF_STRTAB], 3, 0, offs[ELF_STRTAB], sizes[ELF_STRTAB], 0, 0, 1, 0)
    elf_shdr(
        ref out,
        name_off[ELF_SHSTRTAB],
        3,
        0,
        offs[ELF_SHSTRTAB],
        sizes[ELF_SHSTRTAB],
        0,
        0,
        1,
        0
    )
    elf_shdr(ref out, name_off[ELF_NOTE], 1, 0, offs[ELF_NOTE], 0, 0, 0, 1, 0)
    # ELF header
    out[0] = 127
    out[1] = 69
    out[2] = 76
    out[3] = 70
    # 64-bit, little endian, version 1
    out[4] = 2
    out[5] = 1
    out[6] = 1
    var h: [u8] = []
    # ET_REL, EM_X86_64, version
    put16(ref h, 1)
    put16(ref h, 62)
    put32(ref h, 1)
    put64(ref h, 0)
    put64(ref h, 0)
    put64(ref h, shoff)
    put32(ref h, 0)
    put16(ref h, 64)
    put16(ref h, 0)
    put16(ref h, 0)
    put16(ref h, 64)
    put16(ref h, ELF_NSEC)
    put16(ref h, ELF_SHSTRTAB)
    for i in 0..len(h):
        out[16 + i] = h[i]
    return out
