# IR to C: the portable backend for lowered programs (see ir.br).
#
# The C is close to the IR: every vreg is a local variable, every stack slot a
# byte array, every instruction one statement. Pointers are `void *`; the
# runtime's prototypes (brine_rt.h) take care of the types at calls.
from ir import K, Op, Inst, Func, Data, Module
from lower import Lowered

fn c_type(k: K) -> str:
    match k:
        case K.I8:
            return "int8_t"
        case K.I16:
            return "int16_t"
        case K.I32:
            return "int32_t"
        case K.I64:
            return "int64_t"
        case K.I128:
            return "brine_i128"
        case K.U8:
            return "uint8_t"
        case K.U16:
            return "uint16_t"
        case K.U32:
            return "uint32_t"
        case K.U64:
            return "uint64_t"
        case K.U128:
            return "brine_u128"
        case K.F32:
            return "float"
        case K.F64:
            return "double"
        case K.Ptr:
            return "void *"
        case K.Bool:
            return "bool"

# The unsigned type integer arithmetic wraps in.
fn c_utype(k: K) -> str:
    match k:
        case K.I8 | K.U8:
            return "uint8_t"
        case K.I16 | K.U16:
            return "uint16_t"
        case K.I32 | K.U32:
            return "uint32_t"
        case K.I128 | K.U128:
            return "brine_u128"
        case _:
            return "uint64_t"

# The 64 bits of `n` as an unsigned C literal.
fn u64_lit(n: int) -> str:
    if n < 0:
        let u = i128(n) + 18446744073709551616
        return f"{u}ULL"
    return f"{n}ULL"

fn c_escape_bytes(b: [u8]) -> str:
    var parts: [str] = []
    for x in b:
        parts.push(f"{x}")
    return ", ".join(parts)

# A file name inside a C string literal.
fn path_lit(p: str) -> str:
    var o = ""
    for c in p.chars():
        if c == "\\" or c == "\"":
            o += "\\"
        o += c
    return o

fn v(n: int) -> str:
    return f"v{n}"

fn proto(f: Func, split: bool) -> str:
    if f.name == "main":
        return "int main(int v0, char **v1)"
    var ps: [str] = []
    for i in 0..f.nparams:
        ps.push(c_type(f.vk[i]) + " " + v(i))
    let pl = "void" if len(ps) == 0 else ", ".join(ps)
    let rt = c_type(f.ret) if f.has_ret else "void"
    let st = "" if f.public or split else "static "
    return f"{st}{rt} {f.name}({pl})"

fn extern_proto(f: Func) -> str:
    var ps: [str] = []
    for i in 0..f.nparams:
        ps.push(c_type(f.vk[i]))
    let pl = "void" if len(ps) == 0 else ", ".join(ps)
    let rt = c_type(f.ret) if f.has_ret else "void"
    return f"{rt} {f.name}({pl});\n"

fn data_words(d: Data) -> bool:
    return len(d.relocs) > 0

fn data_decl(d: Data) -> str:
    if data_words(d):
        return f"extern void *{d.name}[];\n"
    return f"extern uint8_t {d.name}[];\n"

fn data_def(d: Data, split: bool) -> str:
    let st = "" if split else "static "
    if not data_words(d):
        let n = max(len(d.bytes), 1)
        let body = c_escape_bytes(d.bytes) if len(d.bytes) > 0 else "0"
        return f"{st}_Alignas({d.align}) uint8_t {d.name}[{n}] = \{{body}\};\n"
    # pointers in it: a table of 8-byte words (relocations are word-aligned)
    var words: [str] = []
    var i = 0
    while i < len(d.bytes):
        var w = ""
        for r in d.relocs:
            if r.off == i:
                w = f"(void *)((char *)&{r.sym} + {r.add})"
        if w == "":
            var x = 0
            for j in 0..8:
                if i + j < len(d.bytes):
                    x = x | (int(d.bytes[i + j]) << (8 * j))
            w = f"(void *)(uintptr_t){u64_lit(x)}"
        words.push(w)
        i += 8
    let n = len(words)
    let body = ", ".join(words)
    return f"{st}void *{d.name}[{n}] = \{{body}\};\n"

fn prelude() -> str:
    var o = "/* generated by brine — do not edit */\n#include \"brine_rt.h\"\n\n"
    o += "static inline double br_f64(uint64_t b) { double d; __builtin_memcpy(&d, &b, 8); return d; }\n"
    o += "static inline float br_f32(uint32_t b) { float f; __builtin_memcpy(&f, &b, 4); return f; }\n\n"
    return o

# The whole program as one translation unit.
fn emit_c(l: Lowered) -> str:
    let m = l.m
    var o = prelude()
    for f in l.externs:
        o += extern_proto(f)
    for f in m.funcs:
        o += proto(f, false)
        o += ";\n"
    o += "\n"
    for d in m.data:
        o += data_def(d, false)
    o += "\n"
    for f in m.funcs:
        o += func_def(f, false)
    return o

fn name_hash(s: str) -> int:
    var h: u128 = 2166136261
    for b in s.bytes():
        h = ((h ^ u128(b)) * 16777619) & 4294967295
    return int(h)

# The program as `n` translation units that the C compiler can work on in
# parallel. A function's unit depends only on its name, and a unit declares
# only what it uses, so a change to one function leaves the other units'
# text (and their cached objects) alone.
fn emit_units(l: Lowered, n: int) -> [str]:
    let m = l.m
    var decl: {str: str} = {}
    for f in l.externs:
        decl[f.name] = extern_proto(f)
    for f in m.funcs:
        decl[f.name] = proto(f, true) + ";\n"
    for d in m.data:
        decl[d.name] = data_decl(d)
    var fs: [[int]] = [[] for _ in 0..n]
    var ds: [[int]] = [[] for _ in 0..n]
    for i, f in enumerate(m.funcs):
        fs[name_hash(f.name) % n].push(i)
    for i, d in enumerate(m.data):
        ds[name_hash(d.name) % n].push(i)
    var out: [str] = []
    for u in 0..n:
        var used: {str: bool} = {}
        for i in fs[u]:
            used[m.funcs[i].name] = true
            for x in m.funcs[i].code:
                if (x.op == Op.Call or x.op == Op.Global) and x.s in decl:
                    used[x.s] = true
        for i in ds[u]:
            used[m.data[i].name] = true
            for r in m.data[i].relocs:
                if r.sym in decl:
                    used[r.sym] = true
        var names = used.keys()
        names.sort()
        var o = prelude()
        for nm in names:
            o += decl[nm]
        o += "\n"
        for i in ds[u]:
            o += data_def(m.data[i], true)
        o += "\n"
        for i in fs[u]:
            o += func_def(m.funcs[i], true)
        out.push(o)
    return out

fn func_def(f: Func, split: bool) -> str:
    var o = proto(f, split) + " {\n"
    for i in f.nparams..len(f.vk):
        o += "    " + c_type(f.vk[i]) + " " + v(i) + ";\n"
    for i, s in enumerate(f.slots):
        if typed_slot(f, i):
            o += f"    {c_type(s.k)} {slot_name(f, i)};\n"
        else:
            o += f"    _Alignas({s.align}) uint8_t {slot_name(f, i)}[{s.size}];\n"
    for x in f.code:
        o += inst_c(f, x)
    o += "}\n\n"
    return o

# Stack slots of named variables carry the brine name (with a suffix that
# keeps it apart from C keywords and the `v<n>` registers).
fn slot_name(f: Func, i: int) -> str:
    let n = f.slots[i].name
    if not c_ident(n):
        return f"s{i}"
    return f"{n}_{i}"

# Hidden locals of the compiler (`for'12`) aren't C identifiers.
fn c_ident(n: str) -> bool:
    if n == "":
        return false
    for b in n.bytes():
        let ok = (
            u8(97) <= b <= u8(122)
        ) or (u8(65) <= b <= u8(90)) or (u8(48) <= b <= u8(57)) or b == u8(95)
        if not ok:
            return false
    return true

fn typed_slot(f: Func, i: int) -> bool:
    return f.slots[i].typed and c_ident(f.slots[i].name)

fn bin_sym(op: Op) -> str:
    match op:
        case Op.Add:
            return "+"
        case Op.Sub:
            return "-"
        case Op.Mul:
            return "*"
        case Op.Div:
            return "/"
        case Op.Rem:
            return "%"
        case Op.And:
            return "&"
        case Op.Or:
            return "|"
        case Op.Xor:
            return "^"
        case Op.Eq:
            return "=="
        case Op.Ne:
            return "!="
        case Op.Lt:
            return "<"
        case Op.Le:
            return "<="
        case Op.Gt:
            return ">"
        case Op.Ge:
            return ">="
        case _:
            return "?"

fn ovf_name(op: Op) -> (str, str):
    match op:
        case Op.AddO:
            return ("add", "addition")
        case Op.SubO:
            return ("sub", "subtraction")
        case _:
            return ("mul", "multiplication")

fn args_c(x: Inst) -> str:
    return ", ".join([v(a) for a in x.args])

fn inst_c(f: Func, x: Inst) -> str:
    let d = v(x.d)
    let a = v(x.a)
    let b = v(x.b)
    match x.op:
        case Op.Const:
            let k = f.vk[x.d]
            if k == K.I128 or k == K.U128:
                let ct = c_type(k)
                return f"    {d} = ({ct})(((brine_u128){u64_lit(x.c)} << 64) | (brine_u128){u64_lit(x.n)});\n"
            if k == K.Ptr:
                return f"    {d} = (void *)(uintptr_t){u64_lit(x.n)};\n"
            if k == K.Bool:
                return f"    {d} = {x.n} != 0;\n"
            let ct = c_type(k)
            return f"    {d} = ({ct}){u64_lit(x.n)};\n"
        case Op.FConst:
            if f.vk[x.d] == K.F32:
                return f"    {d} = br_f32((uint32_t){u64_lit(x.n)});\n"
            return f"    {d} = br_f64({u64_lit(x.n)});\n"
        case Op.Mov:
            return f"    {d} = {a};\n"
        case Op.Add | Op.Sub | Op.Mul:
            let k = f.vk[x.d]
            if k.is_float():
                return f"    {d} = {a} {bin_sym(x.op)} {b};\n"
            let ut = c_utype(k)
            let ct = c_type(k)
            return f"    {d} = ({ct})(({ut}){a} {bin_sym(x.op)} ({ut}){b});\n"
        case Op.Div | Op.Rem | Op.And | Op.Or | Op.Xor:
            return f"    {d} = {a} {bin_sym(x.op)} {b};\n"
        case Op.Shl:
            let k = f.vk[x.d]
            return f"    {d} = ({c_type(k)})(({c_utype(k)}){a} << {b});\n"
        case Op.Shr:
            return f"    {d} = {a} >> {b};\n"
        case Op.Neg:
            let k = f.vk[x.d]
            if k.is_float():
                return f"    {d} = -{a};\n"
            return f"    {d} = ({c_type(k)})(0 - ({c_utype(k)}){a});\n"
        case Op.Not:
            let k = f.vk[x.d]
            if k == K.Bool:
                return f"    {d} = !{a};\n"
            return f"    {d} = ({c_type(k)})~{a};\n"
        case Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge:
            return f"    {d} = {a} {bin_sym(x.op)} {b};\n"
        case Op.Conv:
            let k = f.vk[x.d]
            let src = f.vk[x.a]
            if k == K.Ptr:
                return f"    {d} = (void *)(uintptr_t){a};\n"
            if src == K.Ptr:
                return f"    {d} = ({c_type(k)})(uintptr_t){a};\n"
            return f"    {d} = ({c_type(k)}){a};\n"
        case Op.AddO | Op.SubO | Op.MulO:
            let (n, what) = ovf_name(x.op)
            return f"    if (BR_UNLIKELY(__builtin_{n}_overflow({a}, {b}, &{d}))) brine_panic_ovf(\"{what}\", {v(x.c)});\n"
        case Op.IdxChk:
            return f"    if (BR_UNLIKELY((uint64_t){a} >= (uint64_t){b})) brine_panic_idx({a}, {b}, {v(x.c)});\n    {d} = {a};\n"
        case Op.SlotAddr:
            if typed_slot(f, x.a):
                return f"    {d} = (void *)&{slot_name(f, x.a)};\n"
            return f"    {d} = (void *){slot_name(f, x.a)};\n"
        case Op.Global:
            return f"    {d} = (void *)&{x.s};\n"
        case Op.Load:
            let ct = c_type(f.vk[x.d])
            return f"    {d} = *({ct} *)((char *){a} + {x.n});\n"
        case Op.Store:
            let ct = c_type(f.vk[x.b])
            return f"    *({ct} *)((char *){a} + {x.n}) = {b};\n"
        case Op.Elem:
            return f"    {d} = (char *){a} + {b} * {x.n};\n"
        case Op.Copy:
            return f"    __builtin_memcpy({a}, {b}, {x.n});\n"
        case Op.Zero:
            return f"    __builtin_memset({a}, 0, {x.n});\n"
        case Op.Call:
            let call = f"{x.s}({args_c(x)})"
            if x.d < 0:
                return f"    {call};\n"
            return f"    {d} = {call};\n"
        case Op.CallInd:
            var ts: [str] = []
            for p in x.args:
                ts.push(c_type(f.vk[p]))
            let rt = c_type(f.vk[x.d]) if x.d >= 0 else "void"
            let pl = "void" if len(ts) == 0 else ", ".join(ts)
            let call = f"(({rt} (*)({pl})){a})({args_c(x)})"
            if x.d < 0:
                return f"    {call};\n"
            return f"    {d} = {call};\n"
        case Op.Label:
            return f"L{x.n}:;\n"
        case Op.Jmp:
            return f"    goto L{x.n};\n"
        case Op.Br:
            return f"    if ({a}) goto L{x.n};\n"
        case Op.BrNot:
            return f"    if (!{a}) goto L{x.n};\n"
        case Op.Ret:
            if x.a < 0:
                if f.name == "main":
                    return "    return 0;\n"
                return "    return;\n"
            return f"    return {a};\n"
        case Op.Unreachable:
            return "    brine_unreachable();\n"
        case Op.Line:
            return f"#line {x.n} \"{path_lit(x.s)}\"\n"
