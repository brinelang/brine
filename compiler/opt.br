# Optimizations on the IR for the native backend (x64.br). The C backend
# doesn't need them: the C compiler does the same and more.
#
# The lowering keeps every local variable in a stack slot and reads and writes
# it through its address. `promote` moves the slots that are only read and
# written (their address goes nowhere else) into vregs, one per field, so the
# register allocator can keep them in registers, and then removes the copies
# that this leaves behind. A slot whose address is also passed to calls (the
# appender of `s += t[i]`, to the runtime's slow paths) is in memory only
# during those calls.

from ir import K, Op, Inst, Func, Module

# m without the runtime module's functions (runtime/rt.br) that nothing
# reaches. The roots are the program's own functions, everything data points
# to, and the exports C or the backends may call by name, except the math ones
# (`brine_x_f_<name>`), which only calls the backends didn't inline make.
fn prune_rt(m: Module) -> Module:
    var at: {str: int} = {}
    for i, f in enumerate(m.funcs):
        at[f.name] = i
    let n = len(m.funcs)
    var live = [false] * n
    var work: [int] = []
    for i, f in enumerate(m.funcs):
        let rt = f.name.starts_with("__rt__") and not f.export
        let math = (
            f.export
            and f.name.starts_with("brine_x_f_")
            and not f.name.starts_with("brine_x_f_fmod")
        )
        if not rt and not math:
            live[i] = true
            work.push(i)
    for d in m.data:
        for r in d.relocs:
            match at.get(r.sym):
                case Some(j):
                    if not live[j]:
                        live[j] = true
                        work.push(j)
                case None:
                    pass
    while len(work) > 0:
        let i = work.pop()
        for x in m.funcs[i].code:
            var names: [str] = []
            if x.op == Op.Call or x.op == Op.Global:
                names.push(x.s)
                if x.op == Op.Call and x.b == 1 and x.s.starts_with("brine_"):
                    names.push("brine_x_" + x.s[6:])
            for s in names:
                match at.get(s):
                    case Some(j):
                        if not live[j]:
                            live[j] = true
                            work.push(j)
                    case None:
                        pass
    var out = m
    out.funcs = []
    for i, f in enumerate(m.funcs):
        if live[i]:
            out.funcs.push(f)
    return out

# The constant arrays (lower.br's `br_ca` objects): their data pointer, the 8
# bytes at 48, is their own address + 56, and nothing ever writes it.
fn const_arrs(m: Module) -> {str: bool}:
    var r: {str: bool} = {}
    for d in m.data:
        for x in d.relocs:
            if x.off == 48 and x.sym == d.name and x.add == 56 and d.name.starts_with("br_ca"):
                r[d.name] = true
    return r

# Reads of a constant array's data pointer as that address + 56: no load, and
# the address is the same everywhere (LICM moves it out of loops).
fn arr_data(f: Func, arrs: {str: bool}) -> Func:
    if len(arrs) == 0:
        return f
    let nv = len(f.vk)
    var ndef = [0] * nv
    var sym = [""] * nv
    for x in f.code:
        if x.d >= 0:
            ndef[x.d] += 1
            if x.op == Op.Global:
                sym[x.d] = x.s
    var g = f
    g.code = []
    for x in f.code:
        if x.op == Op.Load and x.n == 48 and ndef[x.a] == 1 and sym[x.a] in arrs:
            let c = len(g.vk)
            g.vk.push(K.I64)
            g.code.push(Inst(op=Op.Const, d=c, a=-1, b=-1, c=-1, n=56, s="", args=[]))
            g.code.push(Inst(op=Op.Elem, d=x.d, a=x.a, b=c, c=-1, n=1, s="", args=[]))
        else:
            g.code.push(x)
    return g

# The vregs that only ever hold the address of one slot: slot by vreg, -1 for
# the others.
fn slot_vregs(f: Func) -> [int]:
    let nv = len(f.vk)
    var slot = [-1] * nv
    var ndef = [0] * nv
    for x in f.code:
        if x.d >= 0:
            ndef[x.d] += 1
            if x.op == Op.SlotAddr:
                slot[x.d] = x.a
    # the second copy of a twin loop sets its pointers again: `p = mov q`
    # with p and q addresses of the same slot
    for x in f.code:
        if same_slot(x, slot):
            ndef[x.d] -= 1
    for v in 0..nv:
        if ndef[v] != 1 or v < f.nparams:
            slot[v] = -1
    # a copy of an address, made once (an inlined function's parameter)
    var more = true
    while more:
        more = false
        for x in f.code:
            if x.op == Op.Mov and slot[x.d] < 0 and slot[x.a] >= 0:
                if ndef[x.d] == 1 and x.d >= f.nparams:
                    slot[x.d] = slot[x.a]
                    more = true
    return slot

fn same_slot(x: Inst, slot: [int]) -> bool:
    return x.op == Op.Mov and slot[x.d] >= 0 and slot[x.a] == slot[x.d]

# Every vreg an instruction reads.
fn reads(x: Inst, nv: int) -> [int]:
    var r: [int] = []
    if x.op == Op.Const or x.op == Op.FConst or x.op == Op.SlotAddr or x.op == Op.Global:
        return r
    if x.op == Op.Label or x.op == Op.Jmp or x.op == Op.Line or x.op == Op.Unreachable:
        return r
    if x.op == Op.Switch:
        return [x.a]
    # (a call's b is a flag, not a vreg)
    if x.op == Op.Call:
        return x.args
    if x.a >= 0 and x.a < nv:
        r.push(x.a)
    if x.b >= 0 and x.b < nv:
        r.push(x.b)
    # c is a vreg only for these (elsewhere it is an immediate or unused)
    if (x.op == Op.AddO or x.op == Op.SubO or x.op == Op.MulO or x.op == Op.IdxChk) and x.c >= 0:
        r.push(x.c)
    if x.op == Op.Call or x.op == Op.CallInd:
        r.extend(x.args)
    return r

# The fields of the slots that can live in vregs: their offsets and kinds
# (none: it can't), and whether calls are passed the slot's address.
struct Fields:
    off: [[int]]
    kind: [[K]]
    calls: [bool]

fn field_of(fs: Fields, s: int, n: int) -> int:
    for i, o in enumerate(fs.off[s]):
        if o == n:
            return i
    return -1

fn promotable(f: Func, slot: [int]) -> Fields:
    let ns = len(f.slots)
    let nv = len(f.vk)
    var ok = [true] * ns
    var fs = Fields(off=[[] for _ in 0..ns], kind=[[] for _ in 0..ns], calls=[false] * ns)
    for x in f.code:
        if x.op == Op.SlotAddr:
            # (an address in a vreg set more than once: not followed)
            if slot[x.d] < 0:
                ok[x.a] = false
            continue
        if x.op == Op.Mov and slot[x.d] >= 0 and slot[x.a] == slot[x.d]:
            continue
        # a slot address used as anything but the address of a load or store
        # or a call's argument
        var addr = -1
        var k = K.I64
        if x.op == Op.Load and slot[x.a] >= 0:
            addr = x.a
            k = f.vk[x.d]
        elif x.op == Op.Store and slot[x.a] >= 0 and slot[x.b] != slot[x.a]:
            # (storing another slot's address, `let p = stack_mem(n)`: that
            # one escapes, below, and this one is a variable as any other)
            addr = x.a
            k = f.vk[x.b]
        elif x.op == Op.Call:
            for v in x.args:
                if slot[v] >= 0:
                    fs.calls[slot[v]] = true
            continue
        for v in reads(x, nv):
            if v != addr and slot[v] >= 0:
                ok[slot[v]] = false
        if addr >= 0:
            let s = slot[addr]
            let i = field_of(fs, s, x.n)
            if x.n < 0:
                ok[s] = false
            elif i < 0:
                fs.off[s].push(x.n)
                fs.kind[s].push(k)
            elif fs.kind[s][i] != k and not punnable(fs.kind[s][i], k):
                ok[s] = false
    for s in 0..ns:
        # fields that overlap: no
        for i, a in enumerate(fs.off[s]):
            for j, b in enumerate(fs.off[s]):
                if i != j and a <= b and b < a + fs.kind[s][i].size():
                    ok[s] = false
        if not ok[s] or len(fs.off[s]) == 0:
            fs.off[s] = []
            fs.kind[s] = []
    return fs

# A float written to a slot and read as an integer of its size, or the other
# way around (`to_bits`, `from_bits`): an `Op.Bits` between their vregs.
fn punnable(a: K, b: K) -> bool:
    if a.is_wide() or b.is_wide() or a.size() != b.size() or a.is_float() == b.is_float():
        return false
    let i = b if a.is_float() else a
    return i == K.I64 or i == K.U64 or i == K.I32 or i == K.U32

fn bits(d: int, a: int) -> Inst:
    return Inst(op=Op.Bits, d=d, a=a, b=-1, c=-1, n=0, s="", args=[])

fn arith(op: Op) -> bool:
    match op:
        case Op.Add | Op.Sub | Op.Mul | Op.And | Op.Or | Op.Xor | Op.Shl | Op.Shr:
            return true
        case Op.AddO | Op.SubO | Op.MulO:
            return true
        case _:
            return false

fn mov(d: int, a: int) -> Inst:
    return Inst(op=Op.Mov, d=d, a=a, b=-1, c=-1, n=0, s="", args=[])

# Copies through a slot used for nothing else, `copy t <- p; copy u <- t`
# (a value read out of an array, then into a variable), copy p to u
# directly, when nothing between them changes memory or p.
fn copy_chains(f: Func) -> Func:
    let slot = slot_vregs(f)
    let ns = len(f.slots)
    # by slot: the copy into it, the copy out of it, and whether it has any
    # other use
    var into = [-1] * ns
    var out = [-1] * ns
    var other = [false] * ns
    let nv = len(f.vk)
    for i, x in enumerate(f.code):
        if x.op == Op.SlotAddr or same_slot(x, slot):
            continue
        var skip = -1
        if x.op == Op.Copy and slot[x.a] >= 0 and slot[x.b] != slot[x.a]:
            let s = slot[x.a]
            if into[s] < 0:
                into[s] = i
                skip = x.a
            else:
                other[s] = true
        if x.op == Op.Copy and slot[x.b] >= 0 and slot[x.a] != slot[x.b]:
            let s = slot[x.b]
            if out[s] < 0 and into[s] >= 0:
                out[s] = i
                skip = x.b
            else:
                other[s] = true
        for v in reads(x, nv):
            if v != skip and slot[v] >= 0:
                other[slot[v]] = true
    var drop = [false] * len(f.code)
    var code = f.code
    for s in 0..ns:
        let a = into[s]
        let b = out[s]
        if other[s] or a < 0 or b < 0 or drop[b] or code[a].n != code[b].n or slot[code[b].a] < 0:
            continue
        # (code[a] may already copy from further back: a chain of three)
        let p = code[a].b
        var ok = true
        for i in a + 1..b:
            let y = f.code[i]
            if y.d == p:
                ok = false
            match y.op:
                case Op.Const | Op.FConst | Op.Mov | Op.SlotAddr | Op.Global | Op.Elem | Op.Load | Op.Line:
                    pass
                case _:
                    ok = false
        if ok:
            drop[a] = true
            code[b].b = p
    var g = f
    g.code = [x for i, x in enumerate(code) if not drop[i]]
    return g

# A slot t filled by one copy from p (another slot, or a field of one),
# `copy t <- p; ...; load [t + k]; copy u <- t`, then only read: its reads
# read p instead where nothing between the copy and the read can change p
# (the `?` and `match` of a struct moves it through several temporaries).
# When every read can, the copy goes. Calls change only the slots they're
# passed, since nothing else holds a slot's address.
fn copy_forward(f: Func) -> Func:
    let slot = slot_vregs(f)
    let ns = len(f.slots)
    let nv = len(f.vk)
    let n = len(f.code)
    var ndef = [0] * nv
    for x in f.code:
        if x.d >= 0:
            ndef[x.d] += 1
    # base[v]: the slot v points into (v is its address, one inside it, or a
    # copy of one)
    var base = slot
    var more = true
    while more:
        more = false
        for x in f.code:
            if (
                (x.op == Op.Elem or x.op == Op.Mov)
                and base[x.d] < 0
                and base[x.a] >= 0
                and ndef[x.d] == 1
                and x.d >= f.nparams
            ):
                base[x.d] = base[x.a]
                more = true
    # esc[s]: s's address goes somewhere this pass doesn't follow; other[s]:
    # s is read through an address inside it; wr[s]: the instructions that
    # write s, rd[s]: those that read it through its own address
    var esc = [false] * ns
    var other = [false] * ns
    var wr: [[int]] = [[] for _ in 0..ns]
    var rd: [[int]] = [[] for _ in 0..ns]
    for i, x in enumerate(f.code):
        if x.op == Op.SlotAddr:
            if base[x.d] < 0:
                esc[x.a] = true
            continue
        if same_slot(x, slot):
            continue
        if (x.op == Op.Elem or x.op == Op.Mov) and base[x.d] >= 0:
            continue
        var addr = -1
        match x.op:
            case Op.Load:
                addr = x.a
                if slot[x.a] >= 0:
                    rd[slot[x.a]].push(i)
                elif base[x.a] >= 0:
                    other[base[x.a]] = true
            case Op.Store | Op.Zero:
                addr = x.a
                if base[x.a] >= 0:
                    wr[base[x.a]].push(i)
            case Op.Copy:
                if base[x.a] >= 0:
                    wr[base[x.a]].push(i)
                if slot[x.b] >= 0 and base[x.a] != slot[x.b]:
                    rd[slot[x.b]].push(i)
                elif base[x.b] >= 0:
                    other[base[x.b]] = true
                for v in reads(x, nv):
                    if v != x.a and v != x.b and base[v] >= 0:
                        esc[base[v]] = true
                continue
            case Op.Call:
                for v in x.args:
                    if base[v] >= 0:
                        wr[base[v]].push(i)
                continue
            case _:
                pass
        for v in reads(x, nv):
            if v != addr and base[v] >= 0:
                esc[base[v]] = true
    # the jumps to each label
    var from: [[int]] = [[] for _ in 0..f.nlabels]
    for i, x in enumerate(f.code):
        for l in ssa_targets(x):
            from[l].push(i)
    var code = f.code
    var drop = [false] * n
    # (in order of their copies, so a chain t1 <- p, t2 <- t1 reads p)
    var order: [(int, int)] = []
    for t in 0..ns:
        if not esc[t] and not other[t] and len(wr[t]) == 1 and len(rd[t]) > 0:
            let a = wr[t][0]
            let x = f.code[a]
            if x.op == Op.Copy and slot[x.a] == t and x.n == f.slots[t].size:
                order.push((a, t))
    order.sort()
    for at in order:
        let a = at.0
        let t = at.1
        let p = code[a].b
        let ps = base[p]
        if ps < 0 or ps == t or esc[ps] or ndef[p] != 1:
            continue
        var all = true
        for u in rd[t]:
            if u <= a or u - a > 4000 or not unchanged(code, from, base, a, u, ps):
                all = false
                continue
            # (memcpy's regions can't overlap)
            if code[u].op == Op.Copy and base[code[u].a] == ps:
                all = false
                continue
            if code[u].op == Op.Load:
                code[u].a = p
            else:
                code[u].b = p
        if all:
            drop[a] = true
    var g = f
    g.code = [x for i, x in enumerate(code) if not drop[i]]
    return g

# Nothing after code[a] and before code[u] writes slot ps, and control
# reaches u from a only through code in between.
fn unchanged(code: [Inst], from: [[int]], base: [int], a: int, u: int, ps: int) -> bool:
    for i in a + 1..u:
        let y = code[i]
        match y.op:
            case Op.Label:
                for j in from[y.n]:
                    if j < a or j > u:
                        return false
            case Op.Store | Op.Zero | Op.Copy:
                if base[y.a] == ps:
                    return false
            case Op.Call:
                for v in y.args:
                    if base[v] == ps:
                        return false
            case Op.CallInd:
                return false
            case _:
                pass
    return true

# The labels a terminator can go to (ssa.targets).
fn ssa_targets(x: Inst) -> [int]:
    match x.op:
        case Op.Jmp:
            return [x.n]
        case Op.Br | Op.BrNot:
            return [x.n, x.c] if x.c >= 0 else [x.n]
        case Op.Switch:
            return x.args
        case _:
            return []

# The unsigned kind of n bytes (1, 2, 4 or 8).
fn ukind(n: int) -> K:
    if n == 1:
        return K.U8
    if n == 2:
        return K.U16
    if n == 4:
        return K.U32
    return K.U64

# A store to a slot that a copy reads right after: bytes off..off + size of
# the slot are v.
struct Piece:
    off: int
    size: int
    v: int

# A copy out of a slot just after stores to it (an Option or a Result made
# to be returned or kept: `store [s + 0], tag; store [s + 4], x; copy p <- s, 8`)
# would load 8 bytes from narrower stores, which the CPU can't forward to a
# load (only from one store that holds all of it): the load waits until they
# reach the cache. Instead the copy stores the values themselves, 8 bytes at
# a time, put together in a register; and the slot, now only stored to, can
# go to vregs.
fn pack_copies(f: Func) -> Func:
    let slot = slot_vregs(f)
    var g = f
    var code: [Inst] = []
    for i, x in enumerate(f.code):
        if x.op != Op.Copy or slot[x.b] < 0 or slot[x.a] == slot[x.b] or x.n > 32:
            code.push(x)
            continue
        let s = slot[x.b]
        let n = x.n
        # the stores to s since anything else may have written it, the last
        # first, with values that are still the same at the copy
        var ps: [Piece] = []
        var cov = [false] * n
        var set: [int] = []
        var j = len(code) - 1
        while j >= 0 and len(code) - j <= 64:
            let y = code[j]
            if y.op == Op.Store and slot[y.a] == s:
                let k = g.vk[y.b]
                let sz = k.size()
                if k.is_wide() or y.b in set or y.n < 0 or y.n % sz != 0 or y.n + sz > n:
                    if y.n >= n or y.n + sz <= 0:
                        j -= 1
                        continue
                    break
                var some = false
                var all = true
                for b in y.n..y.n + sz:
                    if cov[b]:
                        some = true
                    else:
                        all = false
                if all:
                    j -= 1
                    continue
                if some:
                    break
                for b in y.n..y.n + sz:
                    cov[b] = true
                ps.push(Piece(off=y.n, size=sz, v=y.b))
            elif y.op == Op.Store and slot[y.a] < 0:
                break
            elif (
                y.op == Op.Label
                or y.op == Op.Copy
                or y.op == Op.Zero
                or y.op == Op.Call
                or y.op == Op.CallInd
                or y.op == Op.Phi
            ):
                break
            if y.d >= 0:
                set.push(y.d)
            j -= 1
        if len(ps) == 0:
            code.push(x)
            continue
        # 8 bytes at a time (and 4, 2, 1 for the rest)
        var c = 0
        while c < n:
            var cs = 8
            while c + cs > n:
                cs /= 2
            let ck = ukind(cs)
            var inp: [Piece] = []
            var mixed = false
            for p in ps:
                if p.off < c + cs and p.off + p.size > c:
                    if p.off < c or p.off + p.size > c + cs:
                        mixed = true
                    if g.vk[p.v].is_float() and p.size < cs:
                        mixed = true
                    inp.push(p)
            if len(inp) == 1 and inp[0].off == c and inp[0].size == cs:
                code.push(Inst(op=Op.Store, d=-1, a=x.a, b=inp[0].v, c=-1, n=c, s="", args=[]))
            elif len(inp) == 0 or mixed:
                let t = len(g.vk)
                g.vk.push(ck)
                code.push(Inst(op=Op.Load, d=t, a=x.b, b=-1, c=-1, n=c, s="", args=[]))
                code.push(Inst(op=Op.Store, d=-1, a=x.a, b=t, c=-1, n=c, s="", args=[]))
            else:
                # the pieces, and loads of the bytes between them (aligned)
                var parts: [Piece] = []
                for p in inp:
                    parts.push(p)
                var b = c
                while b < c + cs:
                    var hit = false
                    for p in inp:
                        if p.off <= b and b < p.off + p.size:
                            hit = true
                    if hit:
                        b += 1
                        continue
                    var gs = 4
                    while b % gs != 0 or b + gs > c + cs or gs >= cs:
                        gs /= 2
                    var free = true
                    for p in inp:
                        if p.off < b + gs and p.off + p.size > b:
                            free = false
                    while not free:
                        gs /= 2
                        free = true
                        for p in inp:
                            if p.off < b + gs and p.off + p.size > b:
                                free = false
                    let t = len(g.vk)
                    g.vk.push(ukind(gs))
                    code.push(Inst(op=Op.Load, d=t, a=x.b, b=-1, c=-1, n=b, s="", args=[]))
                    parts.push(Piece(off=b, size=gs, v=t))
                    b += gs
                if slot[x.a] >= 0:
                    # into a slot: the same fields, so it can go to vregs
                    # too (and a copy out of it gets the same treatment)
                    for p in parts:
                        code.push(
                            Inst(op=Op.Store, d=-1, a=x.a, b=p.v, c=-1, n=p.off, s="", args=[])
                        )
                    c += cs
                    continue
                var acc = -1
                for p in parts:
                    # zero-extended to the chunk's kind, then shifted into place
                    var v = p.v
                    let uk = ukind(p.size)
                    if g.vk[v] != uk:
                        let t = len(g.vk)
                        g.vk.push(uk)
                        code.push(Inst(op=Op.Conv, d=t, a=v, b=-1, c=-1, n=0, s="", args=[]))
                        v = t
                    if uk != ck:
                        let t = len(g.vk)
                        g.vk.push(ck)
                        code.push(Inst(op=Op.Conv, d=t, a=v, b=-1, c=-1, n=0, s="", args=[]))
                        v = t
                    if p.off > c:
                        let sh = len(g.vk)
                        g.vk.push(ck)
                        code.push(
                            Inst(
                                op=Op.Const,
                                d=sh,
                                a=-1,
                                b=-1,
                                c=0,
                                n=8 * (p.off - c),
                                s="",
                                args=[]
                            )
                        )
                        let t = len(g.vk)
                        g.vk.push(ck)
                        code.push(Inst(op=Op.Shl, d=t, a=v, b=sh, c=-1, n=0, s="", args=[]))
                        v = t
                    if acc < 0:
                        acc = v
                    else:
                        let t = len(g.vk)
                        g.vk.push(ck)
                        code.push(Inst(op=Op.Or, d=t, a=acc, b=v, c=-1, n=0, s="", args=[]))
                        acc = t
                code.push(Inst(op=Op.Store, d=-1, a=x.a, b=acc, c=-1, n=c, s="", args=[]))
            c += cs
    g.code = code
    return g

# The reference count kind of a retain or release call: "arr" for
# brine_arr_retain, and so on ("" for any other call).
fn rc_kind(x: Inst, which: str) -> str:
    if x.op != Op.Call or len(x.args) != 1:
        return ""
    for k in ["arr", "str", "map", "box"]:
        if x.s == "brine_" + k + "_" + which:
            return k
    return ""

# A retain of a value loaded from memory and the releases of that value
# cancel when nothing in the function can change memory or drop another
# reference: no stores but to its own slots, no copies, no calls but such
# retains and releases. Then whatever holds the value (the caller's, through a
# parameter) holds it until the function returns: `for p in self.t` in a
# method that only reads. All or nothing: every retain and release in the
# function must be of such a value, each retained once.
fn borrowed_rc(f: Func) -> Func:
    let nv = len(f.vk)
    var slot = [false] * nv
    var ndef = [0] * nv
    var loaded = [false] * nv
    for x in f.code:
        if x.d >= 0 and x.d < nv:
            ndef[x.d] += 1
            if x.op == Op.SlotAddr:
                slot[x.d] = true
            if x.op == Op.Load:
                loaded[x.d] = true
    var nret = [0] * nv
    var nrel = [0] * nv
    var kind: [str] = [""] * nv
    var any = false
    for x in f.code:
        match x.op:
            case Op.CallInd:
                return f
            case Op.Call:
                let r = rc_kind(x, "retain")
                let l = rc_kind(x, "release")
                if r == "" and l == "":
                    return f
                let v = x.args[0]
                let k = r if r != "" else l
                if v < 0 or v >= nv or ndef[v] != 1 or not loaded[v]:
                    return f
                if kind[v] != "" and kind[v] != k:
                    return f
                kind[v] = k
                if r != "":
                    nret[v] += 1
                    any = true
                else:
                    nrel[v] += 1
            case Op.Copy:
                return f
            case Op.Store | Op.Zero:
                if x.a < 0 or x.a >= nv or not slot[x.a]:
                    return f
            case _:
                pass
    if not any:
        return f
    # each such value: retained once and released (a retain with no release
    # hands the value on, as does a copy of what holds it), and otherwise
    # only read through
    for x in f.code:
        if x.op == Op.Call:
            continue
        for v in reads(x, nv):
            if kind[v] == "":
                continue
            let addr = (x.op == Op.Load or x.op == Op.Elem) and x.a == v and x.b != v
            let cmp = x.op == Op.Eq or x.op == Op.Ne
            if not addr and not cmp:
                return f
    for v in 0..nv:
        if kind[v] != "" and (nret[v] != 1 or nrel[v] == 0):
            return f
    var g = f
    g.code = [x for x in f.code if x.op != Op.Call]
    return g

fn promote(f0: Func) -> Func:
    let f = pack_copies(copy_chains(copy_forward(f0)))
    let slot = slot_vregs(f)
    let fs = promotable(f, slot)
    var g = f
    # the vreg of each field: home[s] + field
    var home = [-1] * len(f.slots)
    for s in 0..len(f.slots):
        home[s] = len(g.vk)
        g.vk.extend(fs.kind[s])
    # the fields something stores to; the rest are padding a copy moved, and
    # a load of them is zero (a narrow vreg that was never set needn't be
    # zero-extended, and a wider one built from it would show its garbage)
    var put: [[bool]] = [[fs.calls[s]] * len(fs.off[s]) for s in 0..len(f.slots)]
    for x in f.code:
        let s = slot[x.a] if x.op == Op.Store else -1
        if s >= 0 and len(fs.off[s]) > 0:
            put[s][field_of(fs, s, x.n)] = true
    var code: [Inst] = []
    for x in f.code:
        # the address, when nothing needs it any more
        if x.op == Op.SlotAddr or x.op == Op.Mov:
            let t = slot[x.d] if x.d >= 0 else -1
            if t >= 0 and (x.op == Op.SlotAddr or slot[x.a] == t):
                if len(fs.off[t]) > 0 and not fs.calls[t]:
                    continue
        let s = slot[x.a] if (x.op == Op.Load or x.op == Op.Store) else -1
        if s >= 0 and len(fs.off[s]) > 0:
            let v = home[s] + field_of(fs, s, x.n)
            if x.op == Op.Load and not put[s][v - home[s]]:
                let z = Op.FConst if g.vk[x.d].is_float() else Op.Const
                code.push(Inst(op=z, d=x.d, a=-1, b=-1, c=-1, n=0, s="", args=[]))
            elif x.op == Op.Load:
                code.push(mov(x.d, v) if g.vk[x.d] == g.vk[v] else bits(x.d, v))
            else:
                code.push(mov(v, x.b) if g.vk[x.b] == g.vk[v] else bits(v, x.b))
            continue
        if x.op != Op.Call:
            code.push(x)
            continue
        # the slots it is passed, in memory for the call
        var ss: [int] = []
        var at: [int] = []
        for a in x.args:
            let t = slot[a]
            if t >= 0 and len(fs.off[t]) > 0 and t not in ss:
                ss.push(t)
                at.push(a)
        for i, t in enumerate(ss):
            for j, n in enumerate(fs.off[t]):
                code.push(Inst(op=Op.Store, d=-1, a=at[i], b=home[t] + j, c=-1, n=n, s="", args=[]))
        code.push(x)
        for i, t in enumerate(ss):
            for j, n in enumerate(fs.off[t]):
                code.push(Inst(op=Op.Load, d=home[t] + j, a=at[i], b=-1, c=-1, n=n, s="", args=[]))
    g.code = code
    return forward(g)

# Removes the copies `d = v` with d read once, later in the same block: the
# reader reads v itself if v doesn't change in between. And `d = t` where t is
# made just before and read only there: t's instruction writes d directly.
fn forward(f: Func) -> Func:
    let nv = len(f.vk)
    var ndef = [0] * nv
    var nuse = [0] * nv
    for i in 0..f.nparams:
        ndef[i] = 1
    for x in f.code:
        if x.d >= 0:
            ndef[x.d] += 1
        for v in reads(x, nv):
            nuse[v] += 1
    var code = f.code
    var dead = [false] * len(code)
    let n = len(code)
    for i in 0..n:
        let x = code[i]
        if x.op != Op.Mov or ndef[x.d] != 1 or nuse[x.d] != 1:
            continue
        # the reader, in the same block, with v unchanged until it
        let d = x.d
        let v = x.a
        var j = i + 1
        var found = -1
        while j < n:
            let y = code[j]
            if (
                y.op == Op.Label
                or y.op == Op.Jmp
                or y.op == Op.Br
                or y.op == Op.BrNot
                or y.op == Op.Ret
            ):
                if y.a == d and (y.op == Op.Br or y.op == Op.BrNot or y.op == Op.Ret):
                    found = j
                break
            if y.op == Op.Unreachable:
                break
            if d in reads(y, nv):
                found = j
                break
            if y.d == v:
                break
            j += 1
        if found < 0:
            continue
        var y = code[found]
        if y.d == v and y.op != Op.Mov and not arith(y.op):
            continue
        if y.a == d:
            y.a = v
        if y.b == d:
            y.b = v
        if (
            (y.op == Op.AddO or y.op == Op.SubO or y.op == Op.MulO or y.op == Op.IdxChk)
            and y.c == d
        ):
            y.c = v
        if y.op == Op.Call or y.op == Op.CallInd:
            for k in 0..len(y.args):
                if y.args[k] == d:
                    y.args[k] = v
        code[found] = y
        dead[i] = true
    # `t = ...; d = t` with t read only by the copy, and d not read or written
    # in between: the first writes d
    for i in 0..n:
        let x = code[i]
        if dead[i] or x.op != Op.Mov or ndef[x.a] != 1 or nuse[x.a] != 1 or x.a < f.nparams:
            continue
        let t = x.a
        let d = x.d
        if f.vk[t] != f.vk[d]:
            continue
        var j = i - 1
        while j >= 0 and dead[j]:
            j -= 1
        if j < 0 or code[j].d != t:
            continue
        let op = code[j].op
        if op == Op.Call or op == Op.CallInd or op == Op.Label:
            continue
        # `d = d op x`: only where x64.br reads the operands before writing d
        if d in reads(code[j], nv) and not arith(op):
            continue
        code[j].d = d
        dead[i] = true
    var out: [Inst] = []
    for i in 0..n:
        if not dead[i]:
            out.push(code[i])
    var g = f
    g.code = out
    return g

# ================================================================ jump tables
# `match x:` on integers or enum variants lowers to a chain of tests, `x == k0
# or go to next0, body0; next0: x == k1 or go to next1, body1; ...`, which
# native code would go through one by one. A chain of at least SW_MIN tests
# of the same value on dense constants gets a `Switch` in front of it that
# jumps straight to the body of the first test the value passes, or to where
# the chain stops. The tests stay, for a guard that fails (it goes to the
# next test as before) and for the values the table sends to the end.
const SW_MIN = 4

# One test of a chain starting at i: the value tested (a vreg, or `Load`
# number `lv` re-reading the same place), the constant, where it goes when
# the test fails, and where its body starts.
struct SwTest:
    key: int
    lv: int
    k: int
    fail: int
    body: int

fn sw_kind(k: K) -> bool:
    match k:
        case K.I8 | K.I16 | K.I32 | K.I64 | K.U8 | K.U16 | K.U32:
            return true
        case _:
            return false

# The table jumps over every test but the first, so a later one joins the
# chain only when what it computes (its load, constant and comparison) is
# read by nothing else: an optimized function can read a test's load again
# further down. The constant is made right before the comparison, or once
# before the first branch (a64.br's optimized code): `kdef` has where, for
# those, else -1.
fn sw_test(f: Func, i0: int, ndef: [int], nuse: [int], kdef: [int], first: bool) -> Option[SwTest]:
    let n = len(f.code)
    var i = i0
    while i < n and f.code[i].op == Op.Line:
        i += 1
    var lv = -1
    if i < n and f.code[i].op == Op.Load:
        lv = i
        i += 1
    if i >= n:
        return None
    var c = f.code[i]
    let inline = c.op == Op.Const
    if inline:
        i += 1
    if i + 1 >= n:
        return None
    let e = f.code[i]
    let b = f.code[i + 1]
    if e.op != Op.Eq or b.op != Op.BrNot or b.a != e.d or e.b < 0:
        return None
    if inline:
        if e.b != c.d or ndef[c.d] != 1:
            return None
    elif kdef[e.b] >= 0:
        c = f.code[kdef[e.b]]
    else:
        return None
    if ndef[e.d] != 1 or not sw_kind(f.vk[e.a]):
        return None
    if not first and (
        (inline and nuse[c.d] != 1) or nuse[e.d] != 1 or (lv >= 0 and nuse[e.a] != 1)
    ):
        return None
    if lv >= 0 and f.code[lv].d != e.a:
        return None
    if c.n < -(1 << 30) or c.n > (1 << 30):
        return None
    return Some(SwTest(key=e.a, lv=lv, k=c.n, fail=b.n, body=i + 2))

# Do two tests read the same value: one vreg, or the same load of a pointer
# that doesn't change in between?
fn sw_same(f: Func, a: SwTest, b: SwTest) -> bool:
    if a.lv < 0 or b.lv < 0:
        return a.lv < 0 and b.lv < 0 and a.key == b.key
    let x = f.code[a.lv]
    let y = f.code[b.lv]
    return x.a == y.a and x.n == y.n and f.vk[x.d] == f.vk[y.d]

fn switches(f: Func) -> Func:
    let n = len(f.code)
    let nv = len(f.vk)
    var ndef = [0] * nv
    var nuse = [0] * nv
    for x in f.code:
        if x.d >= 0:
            ndef[x.d] += 1
        for v in reads(x, nv):
            nuse[v] += 1
    var lat = [-1] * f.nlabels
    for i in 0..n:
        if f.code[i].op == Op.Label:
            lat[f.code[i].n] = i
    var kdef = [-1] * nv
    for i in 0..n:
        let x = f.code[i]
        if x.op == Op.Label or x.op == Op.Jmp or x.op == Op.Br or x.op == Op.BrNot:
            break
        if x.op == Op.Const and ndef[x.d] == 1:
            kdef[x.d] = i
    # the tests that start a chain, and the label to put at each body
    var before: {int: Inst} = {}
    var body_label: {int: int} = {}
    var seen: {int: bool} = {}
    var nl = f.nlabels
    for i in 0..n:
        if i in seen:
            continue
        match sw_test(f, i, ndef, nuse, kdef, true):
            case Some(t0):
                var chain = [t0]
                var at = i
                while true:
                    let last = chain[len(chain) - 1]
                    let l = lat[last.fail]
                    if l < 0 or l <= at:
                        break
                    match sw_test(f, l + 1, ndef, nuse, kdef, false):
                        case Some(t):
                            if not sw_same(f, t0, t):
                                break
                            seen[l + 1] = true
                            chain.push(t)
                            at = l
                        case None:
                            break
                if len(chain) < SW_MIN:
                    continue
                var lo = chain[0].k
                var hi = lo
                for t in chain:
                    lo = min(lo, t.k)
                    hi = max(hi, t.k)
                let span = hi - lo + 1
                if span > 3 * len(chain) or span > 4096:
                    continue
                let dflt = chain[len(chain) - 1].fail
                var table = [dflt] * span
                var set = [false] * span
                for t in chain:
                    if not set[t.k - lo]:
                        set[t.k - lo] = true
                        if t.body in body_label:
                            table[t.k - lo] = body_label[t.body]
                        else:
                            table[t.k - lo] = nl
                            body_label[t.body] = nl
                            nl += 1
                var args = [dflt]
                args.extend(table)
                # in front of the first test's comparison (after its load and
                # constant)
                var pos = i
                while (
                    f.code[pos].op == Op.Line
                    or f.code[pos].op == Op.Load
                    or f.code[pos].op == Op.Const
                ):
                    pos += 1
                before[pos] = Inst(op=Op.Switch, d=-1, a=t0.key, b=-1, c=-1, n=lo, s="", args=args)
            case None:
                pass
    if len(before) == 0:
        return f
    var out: [Inst] = []
    for i in 0..n:
        # (a body can start with a switch of its own)
        match body_label.get(i):
            case Some(l):
                out.push(Inst(op=Op.Label, d=-1, a=-1, b=-1, c=-1, n=l, s="", args=[]))
            case None:
                pass
        match before.get(i):
            case Some(x):
                out.push(x)
            case None:
                pass
        out.push(f.code[i])
    var g = f
    g.code = out
    g.nlabels = nl
    return g

# ================================================================ inlining
# Small functions that call nothing (or only `cheap_call`s) are copied into
# their callers (native code, not debug builds): the calls of float code
# made of little helpers (`fmin`, a dot product) cost more than the helpers
# do. Tiny ones that do call are too (a release function that frees through
# `brine_drop`): one call instead of two. `hot` ones (the runtime's fast
# paths, a map's hash and key comparison) up to a larger size, calls and
# all; an indirect call of a function the caller names becomes a direct
# one, inlined in the next round. A small function that calls itself gets
# its body in place of those calls, once: half the calls of a walk over a
# tree.
const INLINE_MAX = 64
const INLINE_CALLS = 12
const INLINE_HOT = 160
const INLINE_ROUNDS = 3
# the most code a function calling itself may end up with
const INLINE_SELF = 160

# Calls that cost about as little as an instruction: reference count
# increments and the check before a write into an array (written inline by
# the backends) and the runtime's fast paths in brine (`hot`, themselves
# inlined).
fn cheap_call(x: Inst, hot: {str: bool}) -> bool:
    if x.b == 0:
        return x.s in hot or x.s == "brine_arr_unique"
    let n = x.s
    return (
        n == "brine_str_retain"
        or n == "brine_arr_retain"
        or n == "brine_map_retain"
        or n == "brine_box_retain"
    )

fn inlinable(f: Func, hot: {str: bool}) -> bool:
    # (a runtime function C calls too stays one: it is no fast path, and its
    # fast paths inlined at every call would make the program much bigger)
    if f.public or f.export or f.cold:
        return false
    if len(f.code) > INLINE_HOT:
        return false
    var calls = false
    var writes = false
    var loops = false
    var seen = [false] * f.nlabels
    for x in f.code:
        match x.op:
            case Op.Switch:
                return false
            case Op.CallInd:
                if not f.hot:
                    return false
                calls = true
            case Op.Call:
                if x.b == 0 and x.s == f.name:
                    return false
                if not cheap_call(x, hot):
                    calls = true
                if x.s == "brine_arr_unique":
                    writes = true
            case Op.Label:
                seen[x.n] = true
            case Op.Jmp | Op.Br | Op.BrNot:
                if seen[x.n]:
                    loops = true
            case _:
                pass
    if f.hot:
        return true
    # a method that writes into arrays it is given (`ref self`), with no
    # loop or call: in a caller's loop its copy-on-write checks can move
    # out of the loop (ssa.uniques)
    if writes and not calls and not loops:
        return true
    if len(f.code) > INLINE_MAX:
        return false
    return not calls or len(f.code) <= INLINE_CALLS

# With `borrow` (optimized builds), the retains and releases a read-only
# function needs for what it borrows are dropped first, so they don't count
# against it as calls (`Lin.coef`'s loop over its terms is inlined then).
fn inline_small(fs: [Func], borrow: bool) -> [Func]:
    var cur = [borrowed_rc(f) for f in fs] if borrow else fs
    for _ in 0..INLINE_ROUNDS:
        let (next, changed) = inline_round(cur)
        cur = next
        if not changed:
            break
    return [self_inline(f) for f in cur]

fn self_inline(f: Func) -> Func:
    if f.public or f.hot:
        return f
    var n = 0
    for x in f.code:
        if x.op == Op.Switch:
            return f
        if x.op == Op.Call and x.b == 0 and x.s == f.name and len(x.args) == f.nparams:
            n += 1
    if n == 0 or len(f.code) * (n + 1) > INLINE_SELF:
        return f
    let c = promote(f)
    var g = f
    var code: [Inst] = []
    for x in f.code:
        if x.op == Op.Call and x.b == 0 and x.s == f.name and len(x.args) == f.nparams:
            inline_call(ref g, ref code, x, c)
        else:
            code.push(x)
    g.code = code
    return g

fn inline_round(fs: [Func]) -> ([Func], bool):
    var small: {str: Func} = {}
    var names: {str: bool} = {}
    var hot: {str: bool} = {}
    for f in fs:
        names[f.name] = true
        if f.hot:
            hot[f.name] = true
    for f in fs:
        # its parameters in vregs rather than slots; a runtime fast path is
        # measured that way too, as the loads and stores of its variables
        # are gone then
        if f.hot:
            let p = promote(f)
            if inlinable(p, hot):
                small[f.name] = p
        elif inlinable(f, hot):
            small[f.name] = promote(f)
    var changed = false
    var out: [Func] = []
    for f in fs:
        let (g0, direct) = direct_calls(f, names)
        if direct:
            changed = true
        if not any(x.op == Op.Call and x.b == 0 and x.s in small for x in g0.code):
            out.push(g0)
            continue
        var g = g0
        var code: [Inst] = []
        for x in g0.code:
            if x.op == Op.Call and x.b == 0 and x.s in small:
                let c = small[x.s]
                if len(x.args) == c.nparams and c.name != f.name:
                    inline_call(ref g, ref code, x, c)
                    changed = true
                    continue
            code.push(x)
        g.code = code
        out.push(g)
    return (out, changed)

# An indirect call whose target is, through copies, the address of a function
# of the module: a call of that function.
fn direct_calls(f: Func, names: {str: bool}) -> (Func, bool):
    var def = [-1] * len(f.vk)
    var ndef = [0] * len(f.vk)
    for i, x in enumerate(f.code):
        if x.d >= 0:
            def[x.d] = i
            ndef[x.d] += 1
    var g = f
    var done = false
    for i, x in enumerate(f.code):
        if x.op != Op.CallInd:
            continue
        var v = x.a
        var sym = ""
        var hops = 0
        while v >= 0 and ndef[v] == 1 and hops < 16:
            let y = f.code[def[v]]
            if y.op == Op.Mov:
                v = y.a
                hops += 1
            elif y.op == Op.Global:
                sym = y.s
                break
            else:
                break
        if sym != "" and sym in names:
            g.code[i].op = Op.Call
            g.code[i].a = -1
            g.code[i].b = 0
            g.code[i].s = sym
            done = true
    return (g, done)

# Appends a copy of `c`'s body for `call` to `code`, with c's vregs, labels
# and slots after g's.
fn inline_call(ref g: Func, ref code: [Inst], call: Inst, c: Func):
    let vb = len(g.vk)
    g.vk.extend(c.vk)
    let lb = g.nlabels
    let end = lb + c.nlabels
    g.nlabels = end + 1
    let sb = len(g.slots)
    g.slots.extend(c.slots)
    for i in 0..c.nparams:
        code.push(Inst(op=Op.Mov, d=vb + i, a=call.args[i], b=-1, c=-1, n=0, s="", args=[]))
    for x in c.code:
        var y = x
        if y.d >= 0:
            y.d += vb
        match y.op:
            case Op.Const | Op.FConst | Op.Global | Op.Unreachable:
                pass
            case Op.Line:
                continue
            case Op.SlotAddr:
                y.a += sb
            case Op.Label | Op.Jmp:
                y.n += lb
            case Op.Br | Op.BrNot:
                y.a += vb
                y.n += lb
            case Op.Call:
                y.args = [a + vb for a in y.args]
            case Op.CallInd:
                y.a += vb
                y.args = [a + vb for a in y.args]
            case Op.Ret:
                if y.a >= 0 and call.d >= 0:
                    code.push(Inst(op=Op.Mov, d=call.d, a=y.a + vb, b=-1, c=-1, n=0, s="", args=[]))
                code.push(Inst(op=Op.Jmp, d=-1, a=-1, b=-1, c=-1, n=end, s="", args=[]))
                continue
            case _:
                if y.a >= 0:
                    y.a += vb
                if y.b >= 0:
                    y.b += vb
                if (
                    (y.op == Op.AddO or y.op == Op.SubO or y.op == Op.MulO or y.op == Op.IdxChk)
                    and y.c >= 0
                ):
                    y.c += vb
        code.push(y)
    code.push(Inst(op=Op.Label, d=-1, a=-1, b=-1, c=-1, n=end, s="", args=[]))
