# C11 code generation. A port of src/codegen.rs.
#
# Ownership model: `expr()` returns a side-effect-free C expression. Anything
# with side effects (calls, allocation, communication) is hoisted into a temp
# declared as a statement, so evaluation order is always left to right.
# A managed value (str, array, or an aggregate containing one) is either
# *borrowed* (a path into a live variable) or an *owned temp* registered in the
# current statement frame. `owned()` claims an owned temp or retains a borrow.
# Unclaimed temps are released when the statement's frame is popped.
#
# This backend works from the checked, verified AST. Another backend (native
# machine code) can be added next to it, reading the same input.
from diag import Span, SourceMap
from types import Ty, IntTy, FloatTy, Res, CallRes, Builtin, StrM, Reducer, WorldOp, OsOp, LocalInfo, LocalKind, int_ty, float_ty
from ast import BinOp, CmpOp, UnOp, FSeg, Arg, Comp, CompKind, Expr, ExprKind, LetPat, Pattern, PatKind, Case, Stmt, StmtKind, Block, FnDecl, Program
from info import ProgramInfo, ConstVal, TryKind, try_kind, PRELUDE
from check import mangle_module, FmtSpec, parse_fmt_spec

struct Options:
    # emit `#line` directives so debuggers show brine source
    debug: bool
    # generate a test-runner `main` instead of the program's `main`
    tests: bool

struct Temp:
    name: str
    ty: Ty
    claimed: bool

struct Ctx:
    out: str
    ind: int
    frames: [[Temp]]
    scopes: [[(str, Ty)]]
    loops: [int]
    par_writes: {int: bool}
    mut_params: {int: bool}

fn new_ctx() -> Ctx:
    return Ctx(out="", ind=0, frames=[], scopes=[], loops=[], par_writes={}, mut_params={})

struct Sub:
    code: str
    val: str
    temps: [Temp]

enum Dom:
    Range(ty: IntTy, lo: str, hi: str, incl: bool, step: Option[str])
    Arr(arr: str, elem: Ty)

fn c_reserved() -> {str: bool}:
    var m: {str: bool} = {}
    for n in [
        "auto",
        "break",
        "case",
        "char",
        "const",
        "continue",
        "default",
        "do",
        "double",
        "else",
        "enum",
        "extern",
        "float",
        "for",
        "goto",
        "if",
        "inline",
        "int",
        "long",
        "register",
        "restrict",
        "return",
        "short",
        "signed",
        "sizeof",
        "static",
        "struct",
        "switch",
        "typedef",
        "union",
        "unsigned",
        "void",
        "volatile",
        "while",
        "bool",
        "true",
        "false",
        "alignas",
        "alignof",
        "constexpr",
        "nullptr",
        "static_assert",
        "thread_local",
        "typeof",
        "typeof_unqual",
        "noreturn",
        "asm",
        "fortran",
        "main",
        "argc",
        "argv",
        "errno",
        "isnan",
        "isinf",
        "isfinite",
        "isnormal",
        "signbit",
        "fpclassify",
        "isgreater",
        "isgreaterequal",
        "isless",
        "islessequal",
        "islessgreater",
        "isunordered",
        "offsetof",
        "math_errhandling",
        "stdin",
        "stdout",
        "stderr",
        "assert",
        "unix",
        "linux",
        "i386",
        "complex",
        "imaginary",
        "sb",
        "v",
        "a",
        "b",
        "p",
        "i"
    ]:
        m[n] = true
    return m

fn generate(prog: Program, info: ProgramInfo, sm: SourceMap, opts: Options) -> str:
    var g = Gen(
        prog=prog,
        info=info,
        sm=sm,
        opts=opts,
        fwd="",
        defs="",
        edefs="",
        lits="",
        hproto="",
        hbody="",
        fproto="",
        ctxdefs="",
        lifted="",
        bodies="",
        types_done={},
        pending=[],
        flushing=false,
        helpers_done={},
        strs={},
        ntmp=0,
        nlift=0,
        cx=new_ctx(),
        fnd=None,
        flocals=[],
        externs={},
        reserved=c_reserved()
    )
    return g.run()

fn octal3(b: int) -> str:
    return f"{b / 64}{(b / 8) % 8}{b % 8}"

# Escape bytes for a C string literal body.
fn c_escape(s: str) -> str:
    var o = ""
    for x in s.bytes():
        let b = int(x)
        if b == 34:
            o += "\\\""
        elif b == 92:
            o += "\\\\"
        elif b == 63:
            o += "\\?"
        elif b == 10:
            o += "\\n"
        elif b == 9:
            o += "\\t"
        elif 32 <= b <= 126:
            o += chr(b)
        else:
            o += "\\" + octal3(b)
    return o

fn widens(from: IntTy, to: IntTy) -> bool:
    return to.min() <= from.min() and from.umax() <= to.umax()

struct Gen:
    prog: Program
    info: ProgramInfo
    sm: SourceMap
    opts: Options
    fwd: str
    defs: str
    # enum boxes: after `defs`, since their fields may be structs by value
    edefs: str
    lits: str
    hproto: str
    hbody: str
    fproto: str
    ctxdefs: str
    lifted: str
    bodies: str
    types_done: {str: bool}
    pending: [Ty]
    flushing: bool
    helpers_done: {str: bool}
    strs: {str: int}
    ntmp: int
    nlift: int
    cx: Ctx
    # the function being generated, and its locals
    fnd: Option[FnDecl]
    flocals: [LocalInfo]
    externs: {str: bool}
    reserved: {str: bool}

    # ============================================================ driver
    fn run(ref self) -> str:
        let prog = self.prog
        let info = self.info
        for f in info.fns:
            if f.is_extern:
                self.externs[f.c_name] = true
        for sid in 0..len(info.structs):
            self.cty(Ty.Struct(sid))
        for eid in 0..len(info.enums):
            self.cty(Ty.Enum(eid))
        for m in prog.modules:
            for f in m.fns:
                let p = self.proto(f)
                self.fproto += p
                self.fproto += ";\n"
        for m in prog.modules:
            for f in m.fns:
                if not f.is_extern:
                    let sig = info.fns[f.id]
                    let proto = self.proto(f)
                    var muts: [int] = []
                    for i, p in enumerate(sig.params):
                        if p.by_ref:
                            muts.push(f.param_locals[i])
                    self.gen_body(f, proto, muts, sig.ret != Ty.Unit)
        let main = self.gen_tests() if self.opts.tests else self.gen_main()
        var o = "/* generated by brine — do not edit */\n#include \"brine_rt.h\"\n\n"
        for s in [
            self.fwd,
            self.defs,
            self.edefs,
            self.lits,
            self.hproto,
            self.fproto,
            self.ctxdefs,
            self.hbody,
            self.lifted,
            self.bodies
        ]:
            if s != "":
                o += s
                o += "\n"
        o += main
        return o

    fn proto(ref self, f: FnDecl) -> str:
        let sig = self.info.fns[f.id]
        let ret = "void" if sig.ret == Ty.Unit else self.cty(sig.ret)
        var ps: [str] = []
        for i, p in enumerate(sig.params):
            let t = self.cty(p.ty)
            # the local's name, which differs from the declared name for `mut` value params
            var n = ""
            if i < len(f.param_locals) and not sig.is_extern:
                let l = f.param_locals[i]
                if f.locals[l].name == "_":
                    n = f"__u_w{l}"
                else:
                    n = self.cname(f.locals[l].name)
            elif f.params[i].name == "_":
                n = f"__u_p{i}"
            else:
                n = self.cname(f.params[i].name)
            ps.push(f"{t} *{n}" if p.by_ref else f"{t} {n}")
        if self.tracks_caller(f.id):
            ps.push("const char *__loc")
        let pl = "void" if len(ps) == 0 else ", ".join(ps)
        if sig.is_extern:
            return f"{ret} {sig.c_name}({pl})"
        return f"static {ret} {sig.c_name}({pl})"

    fn gen_body(ref self, f: FnDecl, proto: str, muts: [int], returns: bool):
        self.fnd = Some(f)
        self.flocals = f.locals
        self.cx = new_ctx()
        for m in muts:
            self.cx.mut_params[m] = true
        self.cx.out += proto
        self.cx.out += " {\n"
        self.cx.ind = 1
        self.block(f.body)
        if returns:
            self.line("brine_unreachable();")
        self.cx.out += "}\n\n"
        let code = self.cx.out
        self.cx.out = ""
        self.bodies += code

    fn gen_main(ref self) -> str:
        let prog = self.prog
        let m = prog.modules[prog.main_module]
        var body = "    brine_rt_shutdown();\n    return 0;\n"
        for f in m.fns:
            if f.name == "main" and f.method_of.is_none():
                let sig = self.info.fns[f.id]
                if sig.ret == Ty.Unit:
                    body = f"    {sig.c_name}();\n    brine_rt_shutdown();\n    return 0;\n"
                else:
                    match try_kind(self.info, sig.ret):
                        case Some(TryKind.Res(_, err_v, _, err)):
                            # `main() -> Result[(), E]`: an `Err` prints "error: ..." and exits with 1
                            let rty = sig.ret
                            var eid = 0
                            match rty:
                                case Ty.Enum(x):
                                    eid = x
                                case _:
                                    pass
                            let ef = self.cname(self.info.enums[eid].variants[err_v].fields[0].0)
                            let ct = self.cty(rty)
                            let c = self.fmt_code("&sb", f"r->u.v{err_v}.{ef}", err, false)
                            let rl = self.release_code("r", rty)
                            body = (
                                f"    {ct} r = {sig.c_name}();\n    int code = 0;\n    if (r->tag == {err_v}) \{\n        brine_sb sb; brine_sb_init(&sb);\n        brine_sb_cat(&sb, \"error: \", 7);\n        {c}\n        brine_eprint_sb(&sb);\n        code = 1;\n    \}\n    {rl}\n    brine_rt_shutdown();\n    return code;\n"
                            )
                        case _:
                            body = f"    int64_t code = {sig.c_name}();\n    brine_rt_shutdown();\n    return (int)code;\n"
                break
        return "int main(int argc, char **argv) {\n    brine_rt_init(argc, argv);\n" + body + "}\n"

    fn gen_tests(ref self) -> str:
        let prog = self.prog
        var tests: [(str, str)] = []
        for m in prog.modules:
            let mm = mangle_module(m.name)
            for ti, t in enumerate(m.tests):
                let c = f"{mm}__test_{ti}"
                let proto = f"static void {c}(void)"
                self.fproto += proto
                self.fproto += ";\n"
                self.gen_body(t, proto, [], false)
                let prefix = "" if m.name == prog.modules[prog.main_module].name else m.name + ": "
                let name = prefix + t.test_name.unwrap_or("")
                tests.push((c, name))
        var o = "static int br_streq(const char *a, const char *b) {\n    while (*a && *a == *b) { a++; b++; }\n    return *a == *b;\n}\n\n"
        o += "int main(int argc, char **argv) {\n    brine_rt_init(argc, argv);\n"
        o += f"    int64_t n = {len(tests)};\n"
        o += "    if (argc >= 2 && br_streq(argv[1], \"--list\")) {\n        brine_sb sb;\n"
        for i, t in enumerate(tests):
            let name = t.1
            o += f"        brine_sb_init(&sb); brine_sb_i64(&sb, {i}); brine_sb_cat(&sb, \"\\t\", 1); brine_sb_cat(&sb, \"{c_escape(name)}\", {len(name)}); brine_print_sb(&sb);\n"
        o += "    } else if (argc >= 3 && br_streq(argv[1], \"--run\")) {\n        int64_t k = 0;\n        for (const char *p = argv[2]; *p; p++) k = k * 10 + (*p - '0');\n        switch (k) {\n"
        for i, t in enumerate(tests):
            o += f"        case {i}: {t.0}(); break;\n"
        o += "        default: brine_panic_at(\"<test>\", \"no such test\");\n        }\n    } else {\n"
        for t in tests:
            let c = t.0
            let name = t.1
            o += f"        \{ brine_sb sb; brine_sb_init(&sb); brine_sb_cat(&sb, \"test {c_escape(name)} ... \", {len(name) + 9}); {c}(); brine_sb_cat(&sb, \"ok\", 2); brine_print_sb(&sb); \}\n"
        o += "    }\n    (void)n;\n    brine_rt_shutdown();\n    return 0;\n}\n"
        return o

    # ============================================================ emission helpers
    fn line(ref self, s: str):
        for _ in 0..self.cx.ind:
            self.cx.out += "    "
        self.cx.out += s
        self.cx.out += "\n"

    fn fresh(ref self) -> str:
        self.ntmp += 1
        return f"__t{self.ntmp}"

    fn loc(self, span: Span) -> str:
        match self.fnd:
            case Some(f):
                if f.test_name.is_none() and self.tracks_caller(f.id):
                    return "__loc"
            case None:
                pass
        return "\"" + c_escape(self.sm.loc(span)) + "\""

    # Prelude functions (like `unwrap()`) report errors at their caller's location.
    fn tracks_caller(self, id: int) -> bool:
        let sig = self.info.fns[id]
        return not sig.is_extern and self.info.module_names[sig.module] == PRELUDE

    fn locals(self) -> [LocalInfo]:
        return self.flocals

    fn cname(self, n: str) -> str:
        if "'" in n:
            # compiler-made names such as `x'` (the caller's value of a `mut` parameter)
            return "__u_" + n.replace("'", "_p")
        let bad = (
            n in self.reserved or "__" in n or n.starts_with("_") or n.starts_with("br") or n.ends_with("_t") or not any("a" <= c <= "z" for c in n.chars()) or n in self.externs
        )
        if bad:
            return "__u_" + n
        return n

    fn local_c(self, id: int) -> str:
        let name = self.flocals[id].name
        # `_` may be declared many times in one scope
        let n = f"__u_w{id}" if name == "_" else self.cname(name)
        if id in self.cx.mut_params:
            return "(*" + n + ")"
        return n

    fn push_frame(ref self):
        self.cx.frames.push([])

    fn pop_frame(ref self):
        var f: [Temp] = []
        if len(self.cx.frames) > 0:
            f = self.cx.frames.pop()
        self.release_temps(f)

    fn release_temps(ref self, temps: [Temp]):
        var i = len(temps) - 1
        while i >= 0:
            let t = temps[i]
            if not t.claimed:
                let c = self.release_code(t.name, t.ty)
                if c != "":
                    self.line(c)
            i -= 1

    fn register(ref self, name: str, ty: Ty):
        if self.managed(ty):
            if len(self.cx.frames) == 0:
                self.cx.frames.push([])
            let k = len(self.cx.frames) - 1
            self.cx.frames[k].push(Temp(name=name, ty=ty, claimed=false))

    fn claim(ref self, name: str) -> bool:
        var fi = len(self.cx.frames) - 1
        while fi >= 0:
            for ti in 0..len(self.cx.frames[fi]):
                if self.cx.frames[fi][ti].name == name and not self.cx.frames[fi][ti].claimed:
                    self.cx.frames[fi][ti].claimed = true
                    return true
            fi -= 1
        return false

    fn is_temp(self, name: str) -> bool:
        return any(any(t.name == name for t in f) for f in self.cx.frames)

    fn push_scope(ref self):
        self.cx.scopes.push([])

    fn pop_scope(ref self):
        var s: [(str, Ty)] = []
        if len(self.cx.scopes) > 0:
            s = self.cx.scopes.pop()
        var i = len(s) - 1
        while i >= 0:
            let c = self.release_code(s[i].0, s[i].1)
            if c != "":
                self.line(c)
            i -= 1

    fn add_local(ref self, name: str, ty: Ty):
        if self.managed(ty):
            let k = len(self.cx.scopes) - 1
            self.cx.scopes[k].push((name, ty))

    fn release_scopes_from(ref self, depth: int):
        var lines: [(str, Ty)] = []
        var i = len(self.cx.scopes) - 1
        while i >= depth:
            let sc = self.cx.scopes[i]
            var j = len(sc) - 1
            while j >= 0:
                lines.push(sc[j])
                j -= 1
            i -= 1
        for n, t in lines:
            let c = self.release_code(n, t)
            if c != "":
                self.line(c)

    # Declare a temp holding `init`; managed temps are owned by the current frame.
    fn decl_temp(ref self, ty: Ty, init: str) -> str:
        let n = self.fresh()
        let ct = self.cty(ty)
        self.line(f"{ct} {n} = {init};")
        self.register(n, ty)
        return n

    # Declare an unmanaged temp.
    fn decl_scalar(ref self, ty: Ty, init: str) -> str:
        let n = self.fresh()
        let ct = self.cty(ty)
        self.line(f"{ct} {n} = {init};")
        return n

    fn owned(ref self, e: Expr) -> str:
        let v = self.expr(e)
        return self.own(v, e.ty)

    # Take ownership of an evaluated value: claim a temp, or retain a borrowed value.
    fn own(ref self, v: str, ty: Ty) -> str:
        if not self.managed(ty):
            return v
        if self.claim(v):
            return v
        let t = self.fresh()
        let ct = self.cty(ty)
        self.line(f"{ct} {t} = {v};")
        let r = self.retain_code(t, ty)
        self.line(r)
        return t

    # Owned values of several expressions. All are evaluated before any is
    # claimed, so a `?` in a later one can't leak an earlier one.
    fn owned_all(ref self, es: [Expr]) -> [str]:
        var vals: [str] = []
        for e in es:
            vals.push(self.expr(e))
        var out: [str] = []
        for i, e in enumerate(es):
            out.push(self.own(vals[i], e.ty))
        return out

    # Generate into a separate buffer, one indent level deeper, with its own
    # frame: `let saved = self.sub_begin()`, generate, then `self.sub_end(saved, val)`.
    fn sub_begin(ref self) -> str:
        let saved = self.cx.out
        self.cx.out = ""
        self.cx.ind += 1
        self.cx.frames.push([])
        return saved

    fn sub_end(ref self, saved: str, val: str) -> Sub:
        var temps: [Temp] = []
        if len(self.cx.frames) > 0:
            temps = self.cx.frames.pop()
        self.cx.ind -= 1
        let code = self.cx.out
        self.cx.out = saved
        return Sub(code=code, val=val, temps=temps)

    # `sub(|g| g.expr(e))`
    fn sub_expr(ref self, e: Expr) -> Sub:
        let saved = self.sub_begin()
        let v = self.expr(e)
        return self.sub_end(saved, v)

    # `sub(|g| g.owned(e))`
    fn sub_owned(ref self, e: Expr) -> Sub:
        let saved = self.sub_begin()
        let v = self.owned(e)
        return self.sub_end(saved, v)

    fn emit_sub(ref self, s: Sub, assign: Option[str]):
        self.cx.out += s.code
        self.cx.ind += 1
        match assign:
            case Some(a):
                self.line(a)
            case None:
                pass
        self.release_temps(s.temps)
        self.cx.ind -= 1

    # ============================================================ types
    fn managed(self, t: Ty) -> bool:
        match t:
            case Ty.Str | Ty.Array(_) | Ty.Map(_, _):
                return true
            case Ty.Tuple(ts):
                return any(self.managed(x) for x in ts)
            case Ty.Struct(sid):
                return any(self.managed(f.1) for f in self.info.structs[sid].fields)
            case Ty.Enum(eid):
                return self.info.enums[eid].has_payload()
            case _:
                return false

    fn boxed(self, t: Ty) -> bool:
        match t:
            case Ty.Enum(eid):
                return self.info.enums[eid].has_payload()
            case _:
                return false

    # `helpers_done.insert(k)`: true the first time.
    fn mark_done(ref self, k: str) -> bool:
        if k in self.helpers_done:
            return false
        self.helpers_done[k] = true
        return true

    # `types_done.insert(k)`: true the first time.
    fn mark_type(ref self, k: str) -> bool:
        if k in self.types_done:
            return false
        self.types_done[k] = true
        return true

    fn mangle(self, t: Ty) -> str:
        match t:
            case Ty.Int(k):
                return k.suffix()
            case Ty.Float(FloatTy.F64):
                return "f64"
            case Ty.Float(FloatTy.F32):
                return "f32"
            case Ty.Bool:
                return "bool"
            case Ty.Str:
                return "str"
            case Ty.Array(e):
                return "arr_" + self.mangle(e)
            case Ty.Map(k, v):
                return "map_" + self.mangle(k) + "_" + self.mangle(v)
            case Ty.Tuple(ts):
                return f"tup{len(ts)}_" + "_".join([self.mangle(x) for x in ts])
            case Ty.Struct(sid):
                return self.info.structs[sid].c_name
            case Ty.Enum(eid):
                return self.info.enums[eid].c_name
            case _:
                return "unit"

    fn ctype_name(self, t: Ty) -> str:
        match t:
            case Ty.Int(k):
                return k.c_type()
            case Ty.Float(FloatTy.F64):
                return "double"
            case Ty.Float(FloatTy.F32):
                return "float"
            case Ty.Bool:
                return "bool"
            case Ty.Str:
                return "brine_str*"
            case Ty.Array(_):
                return "brine_arr*"
            case Ty.Map(_, _):
                return "brine_map*"
            # `()` stored in a variable or field (functions returning `()` are `void`)
            case Ty.Unit:
                return "brine_unit"
            case Ty.Tuple(_):
                return "brine_" + self.mangle(t)
            case Ty.Struct(sid):
                return self.info.structs[sid].c_name
            case Ty.Enum(eid):
                return self.info.enums[eid].c_name
            case _:
                return "void"

    fn ensure_inner(ref self, t: Ty):
        match t:
            case Ty.Array(e):
                self.pending.push(e)
            case Ty.Map(k, v):
                self.pending.push(k)
                self.pending.push(v)
            case Ty.Tuple(ts):
                let n = self.ctype_name(t)
                if self.mark_type(n):
                    for x in ts:
                        self.ensure_inner(x)
                    var d = "struct " + n + " {\n"
                    for i, x in enumerate(ts):
                        let cn = self.ctype_name(x)
                        d += f"    {cn} f{i};\n"
                    d += "};\n"
                    self.fwd += f"typedef struct {n} {n};\n"
                    self.defs += d
            case Ty.Struct(sid):
                let n = self.ctype_name(t)
                if self.mark_type(n):
                    let fields = self.info.structs[sid].fields
                    for fd in fields:
                        self.ensure_inner(fd.1)
                    var d = "struct " + n + " {\n"
                    for fd in fields:
                        let cn = self.ctype_name(fd.1)
                        let fc = self.cname(fd.0)
                        d += f"    {cn} {fc};\n"
                    if len(fields) == 0:
                        d += "    char _unused;\n"
                    d += "};\n"
                    self.fwd += f"typedef struct {n} {n};\n"
                    self.defs += d
            case Ty.Enum(eid):
                let n = self.ctype_name(t)
                if self.mark_type(n):
                    let en = self.info.enums[eid]
                    if not en.has_payload():
                        self.fwd += f"typedef int32_t {n};\n"
                        return
                    self.fwd += f"typedef struct {n}_box {n}_box;\ntypedef {n}_box *{n};\n"
                    let variants = en.variants
                    # the payload sits behind a pointer, so its types can be defined later
                    # (defining them now could emit a struct before a struct it contains)
                    for v in variants:
                        for fd in v.fields:
                            self.pending.push(fd.1)
                    var d = f"struct {n}_box \{\n    int64_t rc;\n    int64_t tag;\n    union \{\n"
                    for vi, v in enumerate(variants):
                        if len(v.fields) == 0:
                            continue
                        d += "        struct {\n"
                        for fd in v.fields:
                            let cn = self.ctype_name(fd.1)
                            let fc = self.cname(fd.0)
                            d += f"            {cn} {fc};\n"
                        d += f"        \} v{vi};\n"
                    d += "    } u;\n};\n"
                    for vi, v in enumerate(variants):
                        if len(v.fields) == 0:
                            d += f"static {n}_box br_ev_{n}_{vi} = \{-1, {vi}\};\n"
                    self.edefs += d
            case _:
                pass

    fn cty(ref self, t: Ty) -> str:
        self.ensure_inner(t)
        if not self.flushing:
            self.flushing = true
            while len(self.pending) > 0:
                let p = self.pending.pop()
                self.ensure_inner(p)
            self.flushing = false
        return self.ctype_name(t)

    fn field_c(self, t: Ty, idx: int) -> str:
        match t:
            case Ty.Struct(sid):
                return self.cname(self.info.structs[sid].fields[idx].0)
            case _:
                return f"f{idx}"

    fn fields_of(self, t: Ty) -> [(str, Ty)]:
        var out: [(str, Ty)] = []
        match t:
            case Ty.Struct(sid):
                for i, fd in enumerate(self.info.structs[sid].fields):
                    out.push((self.field_c(t, i), fd.1))
            case Ty.Tuple(ts):
                for i, ft in enumerate(ts):
                    out.push((f"f{i}", ft))
            case _:
                pass
        return out

    fn retain_code(ref self, v: str, t: Ty) -> str:
        match t:
            case Ty.Str:
                return f"brine_str_retain({v});"
            case Ty.Array(_):
                return f"brine_arr_retain({v});"
            case Ty.Map(_, _):
                return f"brine_map_retain({v});"
            case Ty.Enum(_):
                if self.boxed(t):
                    return f"brine_box_retain({v});"
                return ""
            case Ty.Tuple(_) | Ty.Struct(_):
                if self.managed(t):
                    let m = self.need_rc(t)
                    return f"br_retain_{m}({v});"
                return ""
            case _:
                return ""

    fn release_code(ref self, v: str, t: Ty) -> str:
        match t:
            case Ty.Str:
                return f"brine_str_release({v});"
            case Ty.Array(_):
                return f"brine_arr_release({v});"
            case Ty.Map(_, _):
                return f"brine_map_release({v});"
            case Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                if self.managed(t):
                    let m = self.need_rc(t)
                    return f"br_release_{m}({v});"
                return ""
            case _:
                return ""

    fn need_rc(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        if not self.mark_done("rc_" + m):
            return m
        let ct = self.cty(t)
        self.hproto += f"static void br_retain_{m}({ct} v);\nstatic void br_release_{m}({ct} v);\nstatic void br_rtp_{m}(void *p);\nstatic void br_rlp_{m}(void *p);\n"
        match t:
            case Ty.Enum(eid):
                let variants = self.info.enums[eid].variants
                var cases = ""
                for vi, v in enumerate(variants):
                    var rl = ""
                    for fd in v.fields:
                        let fc = self.cname(fd.0)
                        let c = self.release_code(f"v->u.v{vi}.{fc}", fd.1)
                        if c != "":
                            rl += f"        {c}\n"
                    if rl != "":
                        cases += f"    case {vi}:\n{rl}        break;\n"
                let sw = "" if cases == "" else f"    switch (v->tag) \{\n{cases}    \}\n"
                self.hbody += f"static void br_retain_{m}({ct} v) \{ brine_box_retain(v); \}\nstatic void br_release_{m}({ct} v) \{\n    if (!brine_box_dec(v)) return;\n{sw}    brine_box_free(v);\n\}\nstatic void br_rtp_{m}(void *p) \{ brine_box_retain(*({ct} *)p); \}\nstatic void br_rlp_{m}(void *p) \{ br_release_{m}(*({ct} *)p); \}\n\n"
                return m
            case _:
                pass
        var rt = ""
        var rl = ""
        for fd in self.fields_of(t):
            let a = self.retain_code("v." + fd.0, fd.1)
            let b = self.release_code("v." + fd.0, fd.1)
            if a != "":
                rt += f"    {a}\n"
                rl += f"    {b}\n"
        self.hbody += f"static void br_retain_{m}({ct} v) \{\n{rt}\}\nstatic void br_release_{m}({ct} v) \{\n{rl}\}\nstatic void br_rtp_{m}(void *p) \{ br_retain_{m}(*({ct} *)p); \}\nstatic void br_rlp_{m}(void *p) \{ br_release_{m}(*({ct} *)p); \}\n\n"
        return m

    fn elem_fns(ref self, t: Ty) -> (str, str):
        match t:
            case Ty.Str:
                return ("brine_rt_str", "brine_rl_str")
            case Ty.Array(_):
                return ("brine_rt_arr", "brine_rl_arr")
            case Ty.Map(_, _):
                return ("brine_rt_map", "brine_rl_map")
            case Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                if self.managed(t):
                    let m = self.need_rc(t)
                    return ("br_rtp_" + m, "br_rlp_" + m)
                return ("NULL", "NULL")
            case _:
                return ("NULL", "NULL")

    fn new_arr(ref self, elem: Ty, n: str, loc: str) -> str:
        let et = self.cty(elem)
        let (rt, rl) = self.elem_fns(elem)
        return f"brine_arr_new({n}, sizeof({et}), {rt}, {rl}, {loc})"

    # Statement appending a value to string builder pointer `sb`.
    fn fmt_code(ref self, sb: str, v: str, t: Ty, nested: bool) -> str:
        match t:
            case Ty.Int(IntTy.I128):
                return f"brine_sb_i128({sb}, {v});"
            case Ty.Int(IntTy.U128):
                return f"brine_sb_u128({sb}, {v});"
            case Ty.Int(k):
                if k.signed():
                    return f"brine_sb_i64({sb}, (int64_t)({v}));"
                return f"brine_sb_u64({sb}, (uint64_t)({v}));"
            case Ty.Float(FloatTy.F64):
                return f"brine_sb_f64({sb}, {v});"
            case Ty.Float(FloatTy.F32):
                return f"brine_sb_f32({sb}, {v});"
            case Ty.Bool:
                return f"brine_sb_bool({sb}, {v});"
            case Ty.Unit:
                return f"brine_sb_cat({sb}, \"()\", 2);"
            case Ty.Str:
                if nested:
                    return f"brine_sb_repr_str({sb}, {v});"
                return f"brine_sb_str({sb}, {v});"
            case Ty.Array(_) | Ty.Map(_, _) | Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                let f = self.need_fmt(t)
                return f"{f}({sb}, {v});"
            case _:
                return ""

    # The `brine_map_ty` descriptor for map type `t`, as a pointer expression.
    fn map_ty(ref self, t: Ty) -> str:
        var k = Ty.Error
        var v = Ty.Error
        match t:
            case Ty.Map(a, b):
                k = a
                v = b
            case _:
                pass
        let m = self.mangle(t)
        let name = "br_mt_" + m
        if not self.mark_done(name):
            return "(&" + name + ")"
        let kc = self.cty(k)
        let vc = self.cty(v)
        let h = self.hash_code(f"*({kc} const *)p", k)
        let keq = self.eq_code(f"*({kc} const *)a", f"*({kc} const *)b", k)
        let veq = self.eq_code(f"*({vc} const *)a", f"*({vc} const *)b", v)
        let kf = self.fmt_code("sb", f"*({kc} const *)p", k, true)
        let (krt, krl) = self.elem_fns(k)
        let (vrt, vrl) = self.elem_fns(v)
        self.hproto += f"static const brine_map_ty {name};\n"
        self.hbody += (
            f"static uint64_t br_hk_{m}(const void *p) \{ return {h}; \}\n" + f"static bool br_kq_{m}(const void *a, const void *b) \{ return {keq}; \}\n" + f"static bool br_vq_{m}(const void *a, const void *b) \{ return {veq}; \}\n" + f"static void br_kf_{m}(brine_sb *sb, const void *p) \{ {kf} \}\n" + f"static const brine_map_ty {name} = \{sizeof({kc}), sizeof({vc}), br_hk_{m}, br_kq_{m}, br_vq_{m}, br_kf_{m}, {krt}, {krl}, {vrt}, {vrl}\};\n\n"
        )
        return "(&" + name + ")"

    # An `Option` value: `Some(val)` when `present` holds, else `None`. `val` is borrowed.
    fn make_option(ref self, oty: Ty, present: str, val: str, vt: Ty) -> str:
        var eid = 0
        match oty:
            case Ty.Enum(x):
                eid = x
            case _:
                return "0"
        let en = self.info.enums[eid]
        var some = 0
        var none = 1
        var found_some = false
        var found_none = false
        for i, v in enumerate(en.variants):
            if not found_some and v.name == "Some":
                some = i
                found_some = true
            if not found_none and v.name == "None":
                none = i
                found_none = true
        let ct = self.cty(oty)
        let none_c = self.variant_const(oty, none)
        let t = self.decl_temp(oty, none_c)
        let field = self.cname(en.variants[some].fields[0].0)
        let rt = self.retain_code(f"{t}->u.v{some}.{field}", vt)
        self.line(
            f"if ({present}) \{ {t} = ({ct})brine_box_new(offsetof({ct}_box, u) + sizeof(((({ct}_box *)0)->u.v{some})), {some}); {t}->u.v{some}.{field} = {val}; {rt} \}"
        )
        return t

    # A `Result` value: `Ok(val)` when `ok` holds, else `Err(err)`. Both are moved in.
    fn make_result(ref self, rty: Ty, ok: str, val: str, err: str) -> str:
        var eid = 0
        match rty:
            case Ty.Enum(x):
                eid = x
            case _:
                return "0"
        let en = self.info.enums[eid]
        var okv = 0
        var errv = 1
        var found_ok = false
        var found_err = false
        for i, v in enumerate(en.variants):
            if not found_ok and v.name == "Ok":
                okv = i
                found_ok = true
            if not found_err and v.name == "Err":
                errv = i
                found_err = true
        let okf = self.cname(en.variants[okv].fields[0].0)
        let errf = self.cname(en.variants[errv].fields[0].0)
        let ct = self.cty(rty)
        let t = self.decl_temp(rty, f"({ct})brine_box_new(sizeof({ct}_box), {ok} ? {okv} : {errv})")
        self.line(f"if ({ok}) {t}->u.v{okv}.{okf} = {val}; else {t}->u.v{errv}.{errf} = {err};")
        return t

    # `static int cmp(const void *, const void *)` ordering values of `t` (for sorting).
    fn need_cmp(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_cmp_" + m
        if not self.mark_done(name):
            return name
        let ct = self.cty(t)
        var body = "return (x > y) - (x < y);"
        match t:
            case Ty.Str:
                body = "return brine_str_cmp(x, y);"
            # NaN sorts after every number
            case Ty.Float(_):
                body = "if (x != x || y != y) return (x != x) - (y != y);\n    return (x > y) - (x < y);"
            case _:
                pass
        self.hbody += f"static int {name}(const void *a, const void *b) \{\n    {ct} x = *({ct} const *)a;\n    {ct} y = *({ct} const *)b;\n    {body}\n\}\n\n"
        return name

    # `m[k] = v` for a map literal under construction.
    fn map_set(ref self, m: str, k: Expr, v: Expr):
        let kvs = self.owned_all([k, v])
        let ks = self.decl_scalar(k.ty, kvs[0])
        let vs = self.decl_scalar(v.ty, kvs[1])
        self.line(f"brine_map_set(&{m}, &{ks}, &{vs});")

    # A `uint64_t` hash of `v` (equal values hash equally).
    fn hash_code(ref self, v: str, t: Ty) -> str:
        match t:
            case Ty.Int(k):
                if k.bits() == 128:
                    return f"brine_hash_u128((brine_u128)({v}))"
                return f"brine_hash_u64((uint64_t)({v}))"
            case Ty.Bool:
                return f"brine_hash_u64((uint64_t)({v}))"
            case Ty.Enum(_):
                if not self.boxed(t):
                    return f"brine_hash_u64((uint64_t)({v}))"
                let f = self.need_hash(t)
                return f"{f}({v})"
            case Ty.Str:
                return f"brine_hash_str({v})"
            case Ty.Array(_) | Ty.Tuple(_) | Ty.Struct(_):
                let f = self.need_hash(t)
                return f"{f}({v})"
            case _:
                return "0"

    fn need_hash(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_hash_" + m
        if not self.mark_done(name):
            return name
        let ct = self.cty(t)
        self.hproto += f"static uint64_t {name}({ct} v);\n"
        var b = f"static uint64_t {name}({ct} v) \{\n    uint64_t h = 0x84222325ULL;\n"
        match t:
            case Ty.Array(e):
                let et = self.cty(e)
                let c = self.hash_code(f"(({et} *)v->data)[i]", e)
                b += f"    for (int64_t i = 0; i < v->len; i++) h = brine_hash_mix(h, {c});\n    h = brine_hash_mix(h, (uint64_t)v->len);\n"
            case Ty.Enum(eid):
                let variants = self.info.enums[eid].variants
                b += "    h = brine_hash_mix(h, (uint64_t)v->tag);\n    switch (v->tag) {\n"
                for vi, var_ in enumerate(variants):
                    if len(var_.fields) == 0:
                        continue
                    b += f"    case {vi}:\n"
                    for fd in var_.fields:
                        let fc = self.cname(fd.0)
                        let c = self.hash_code(f"v->u.v{vi}.{fc}", fd.1)
                        b += f"        h = brine_hash_mix(h, {c});\n"
                    b += "        break;\n"
                b += "    }\n"
            case _:
                for fd in self.fields_of(t):
                    let c = self.hash_code("v." + fd.0, fd.1)
                    b += f"    h = brine_hash_mix(h, {c});\n"
        b += "    return h;\n}\n\n"
        self.hbody += b
        return name

    fn need_fmt(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_fmt_" + m
        if not self.mark_done(name):
            return name
        let ct = self.cty(t)
        self.hproto += f"static void {name}(brine_sb *sb, {ct} v);\n"
        var b = f"static void {name}(brine_sb *sb, {ct} v) \{\n"
        match t:
            case Ty.Array(e):
                let et = self.cty(e)
                b += fmt_lit("[")
                b += "    for (int64_t i = 0; i < v->len; i++) {\n        if (i) brine_sb_cat(sb, \", \", 2);\n"
                let c = self.fmt_code("sb", f"(({et} *)v->data)[i]", e, true)
                b += f"        {c}\n    \}\n"
                b += fmt_lit("]")
            case Ty.Map(kt, vt):
                let kc = self.cty(kt)
                let vc = self.cty(vt)
                b += fmt_lit("{")
                b += "    for (int64_t i = 0, n = 0; i < v->used; i++) {\n        if (!v->live[i]) continue;\n        if (n++) brine_sb_cat(sb, \", \", 2);\n"
                let ck = self.fmt_code("sb", f"(({kc} *)v->keys)[i]", kt, true)
                let cv = self.fmt_code("sb", f"(({vc} *)v->vals)[i]", vt, true)
                b += f"        {ck}\n        brine_sb_cat(sb, \": \", 2);\n        {cv}\n    \}\n"
                b += fmt_lit("}")
            case Ty.Tuple(_) | Ty.Struct(_):
                var open = "("
                var names: [str] = []
                match t:
                    case Ty.Struct(sid):
                        let s = self.info.structs[sid]
                        open = s.name + "("
                        names = [fd.0 + "=" for fd in s.fields]
                    case Ty.Tuple(ts):
                        names = [""] * len(ts)
                    case _:
                        pass
                b += fmt_lit(open)
                for i, fd in enumerate(self.fields_of(t)):
                    let sep = ", " if i > 0 else ""
                    let pre = sep + names[i]
                    if pre != "":
                        b += fmt_lit(pre)
                    let c = self.fmt_code("sb", "v." + fd.0, fd.1, true)
                    b += f"    {c}\n"
                b += fmt_lit(")")
            case Ty.Enum(eid):
                let en = self.info.enums[eid]
                let boxed = en.has_payload()
                let sw = "v->tag" if boxed else "v"
                b += f"    switch ({sw}) \{\n"
                for vi, v in enumerate(en.variants):
                    b += f"    case {vi}:\n"
                    let head = en.variant_label(vi) + ("" if len(v.fields) == 0 else "(")
                    b += "    " + fmt_lit(head)
                    for i, fd in enumerate(v.fields):
                        # prelude enums print like `Some(5)`, others like `Shape.Circle(radius=1.0)`
                        let pre = ("" if i == 0 else ", ") + ("" if en.bare else fd.0 + "=")
                        b += "    " + fmt_lit(pre)
                        let fc = self.cname(fd.0)
                        let c = self.fmt_code("sb", f"v->u.v{vi}.{fc}", fd.1, true)
                        b += f"        {c}\n"
                    if len(v.fields) > 0:
                        b += "    " + fmt_lit(")")
                    b += "        break;\n"
                b += "    }\n"
            case _:
                pass
        b += "}\n\n"
        self.hbody += b
        return name

    fn eq_code(ref self, a: str, b: str, t: Ty) -> str:
        match t:
            case Ty.Str:
                return f"brine_str_eq({a}, {b})"
            case Ty.Map(_, _):
                self.map_ty(t)
                return f"brine_map_eq({a}, {b})"
            case Ty.Array(_) | Ty.Tuple(_) | Ty.Struct(_):
                let f = self.need_eq(t)
                return f"{f}({a}, {b})"
            case Ty.Enum(_):
                if self.boxed(t):
                    let f = self.need_eq(t)
                    return f"{f}({a}, {b})"
                return f"(({a}) == ({b}))"
            case _:
                return f"(({a}) == ({b}))"

    fn need_eq(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_eq_" + m
        if not self.mark_done(name):
            return name
        let ct = self.cty(t)
        self.hproto += f"static bool {name}({ct} a, {ct} b);\n"
        var body = f"static bool {name}({ct} a, {ct} b) \{\n"
        match t:
            case Ty.Array(e):
                let et = self.cty(e)
                let c = self.eq_code(f"(({et} *)a->data)[i]", f"(({et} *)b->data)[i]", e)
                body += f"    if (a == b) return true;\n    if (a->len != b->len) return false;\n    for (int64_t i = 0; i < a->len; i++)\n        if (!{c}) return false;\n    return true;\n"
            case Ty.Enum(eid):
                let variants = self.info.enums[eid].variants
                body += "    if (a == b) return true;\n    if (a->tag != b->tag) return false;\n    switch (a->tag) {\n"
                for vi, v in enumerate(variants):
                    if len(v.fields) == 0:
                        continue
                    var parts: [str] = []
                    for fd in v.fields:
                        let fc = self.cname(fd.0)
                        parts.push(self.eq_code(f"a->u.v{vi}.{fc}", f"b->u.v{vi}.{fc}", fd.1))
                    let j = " && ".join(parts)
                    body += f"    case {vi}: return {j};\n"
                body += "    }\n    return true;\n"
            case _:
                var parts: [str] = []
                for fd in self.fields_of(t):
                    parts.push(self.eq_code("a." + fd.0, "b." + fd.0, fd.1))
                if len(parts) == 0:
                    parts.push("true")
                let j = " && ".join(parts)
                body += f"    return {j};\n"
        body += "}\n\n"
        self.hbody += body
        return name

    # ============================================================ literals
    fn int_lit(self, v: i128, t: Ty) -> str:
        match t:
            case Ty.Float(_):
                return self.float_lit(float(v), t)
            case Ty.Int(IntTy.I64) | Ty.Unknown | Ty.Error:
                let lo: i128 = -9223372036854775807 - 1
                if v == lo:
                    return "INT64_MIN"
                if v < 0:
                    return f"(-{-v}LL)"
                return f"{v}LL"
            case Ty.Int(IntTy.U64):
                return f"{v}ULL"
            case Ty.Int(k):
                if k.bits() == 128:
                    # C has no 128-bit literals: build the magnitude from two halves
                    let u: u128 = u128(-(v + 1)) + 1 if v < 0 else u128(v)
                    let mask: u128 = 18446744073709551615
                    let hi = u >> 64
                    let lo = u & mask
                    let mag = f"((brine_u128){lo}ULL)" if hi == 0 else f"(((brine_u128){hi}ULL << 64) | {lo}ULL)"
                    let ct = k.c_type()
                    if v < 0:
                        return f"(({ct})(0 - {mag}))"
                    return f"(({ct}){mag})"
                let ct = k.c_type()
                if v < 0:
                    return f"(({ct})-{-v})"
                return f"(({ct}){v})"
            case _:
                return f"{v}"

    fn float_lit(self, v: float, t: Ty) -> str:
        let nan = v != v
        let d = v - v
        let finite = not nan and d == d
        var s = ""
        if nan:
            s = "NAN"
        elif not finite:
            s = "(-INFINITY)" if v < 0.0 else "INFINITY"
        else:
            let r = f64_repr(v)
            s = "(" + r + ")" if v < 0.0 else r
        var is_f32 = false
        match t:
            case Ty.Float(FloatTy.F32):
                is_f32 = true
            case _:
                pass
        if is_f32 and finite:
            return "((float)" + s + ")"
        return s

    fn str_lit(ref self, s: str) -> str:
        var id = 0
        match self.strs.get(s):
            case Some(i):
                id = i
            case None:
                id = len(self.strs)
                self.strs[s] = id
                self.lits += f"static struct \{ int64_t rc, len; char d[{len(s) + 1}]; \} br_s{id} = \{-1, {len(s)}, \"{c_escape(s)}\"\};\n"
        return f"((brine_str *)&br_s{id})"

    fn const_val(ref self, id: int) -> str:
        let c = self.info.consts[id]
        match c.value:
            case ConstVal.Int(v):
                return self.int_lit(v, c.ty)
            case ConstVal.Float(v):
                return self.float_lit(v, c.ty)
            case ConstVal.Bool(b):
                return "true" if b else "false"
            case ConstVal.Str(s):
                return self.str_lit(s)

    # ============================================================ statements
    fn block(ref self, b: Block):
        self.push_scope()
        for s in b.stmts:
            self.stmt(s)
        self.pop_scope()

    fn stmt(ref self, s: Stmt):
        if self.opts.debug:
            let f = self.sm.file(s.span.file)
            let (l, _) = f.line_col(s.span.lo)
            self.cx.out += f"#line {l} \"{c_escape(f.path)}\"\n"
        match s.kind:
            case StmtKind.Let(_, pat, _, init, _):
                self.push_frame()
                let v = self.owned(init)
                match pat:
                    case LetPat.Name(_, _):
                        let id = s.locals[0]
                        let ty = self.flocals[id].ty
                        let ct = self.cty(ty)
                        let n = self.local_c(id)
                        self.line(f"{ct} {n} = {v};")
                        self.add_local(n, ty)
                    case LetPat.Tuple(_):
                        let tt = self.cty(init.ty)
                        let tv = self.fresh()
                        self.line(f"{tt} {tv} = {v};")
                        for i, id in enumerate(s.locals):
                            let ty = self.flocals[id].ty
                            let ct = self.cty(ty)
                            let n = self.local_c(id)
                            self.line(f"{ct} {n} = {tv}.f{i};")
                            self.add_local(n, ty)
                self.pop_frame()
            case StmtKind.Assign(target, op, value):
                self.push_frame()
                let ty = target.ty
                let ct = self.cty(ty)
                let loc = self.loc(s.span)
                var map_set = false
                var base = target
                var idx = target
                match target.kind:
                    case ExprKind.Index(b0, i0):
                        match b0.ty:
                            case Ty.Map(_, _):
                                if op.is_none():
                                    map_set = true
                                    base = b0
                                    idx = i0
                            case _:
                                pass
                    case _:
                        pass
                if map_set:
                    let vks = self.owned_all([value, idx])
                    let vs = self.decl_scalar(ty, vks[0])
                    let ks = self.decl_scalar(idx.ty, vks[1])
                    let b = self.lvalue(base)
                    self.line(f"brine_map_set(&({b}), &{ks}, &{vs});")
                else:
                    match op:
                        case None:
                            let v = self.owned(value)
                            let lv = self.lvalue(target)
                            if self.managed(ty):
                                let p = self.fresh()
                                let o = self.fresh()
                                self.line(f"{ct} *{p} = &({lv});")
                                self.line(f"{ct} {o} = *{p};")
                                self.line(f"*{p} = {v};")
                                let r = self.release_code(o, ty)
                                self.line(r)
                            else:
                                self.line(f"{lv} = {v};")
                        case Some(o2):
                            let v = self.expr(value)
                            let lv = self.lvalue(target)
                            let p = self.fresh()
                            self.line(f"{ct} *{p} = &({lv});")
                            if ty == Ty.Str:
                                let n = self.fresh()
                                self.line(f"brine_str *{n} = brine_str_concat(*{p}, {v});")
                                self.line(f"brine_str_release(*{p});")
                                self.line(f"*{p} = {n};")
                            else:
                                let c = self.arith(o2, f"(*{p})", v, ty, true, loc)
                                self.line(f"*{p} = {c};")
                self.pop_frame()
            case StmtKind.ExprStmt(e):
                self.push_frame()
                let v = self.expr(e)
                if v != "" and e.ty != Ty.Unit and not self.is_temp(v):
                    self.line(f"(void)({v});")
                self.pop_frame()
            case StmtKind.If(branches, els):
                self.if_chain(branches, els)
            case StmtKind.Match(scrut, cases):
                self.match_stmt(scrut, cases)
            case StmtKind.While(cond, _, body):
                let sc = self.sub_expr(cond)
                if sc.code == "":
                    self.line(f"while ({sc.val}) \{")
                else:
                    self.line("for (;;) {")
                    let c = self.fresh()
                    let v = sc.val
                    self.emit_sub(Sub(code=sc.code, val="", temps=[]), Some(f"bool {c} = {v};"))
                    self.cx.ind += 1
                    self.release_temps(sc.temps)
                    self.line(f"if (!{c}) break;")
                    self.cx.ind -= 1
                self.cx.ind += 1
                let depth = len(self.cx.scopes)
                self.cx.loops.push(depth)
                self.block(body)
                self.cx.loops.pop()
                self.cx.ind -= 1
                self.line("}")
            case StmtKind.For(_, _, _, iter, _, body, is_par):
                if is_par:
                    self.par_for(iter, s.local, s.caps, s.writes, body, s.span)
                else:
                    self.line("{")
                    self.cx.ind += 1
                    self.push_scope()
                    self.push_frame()
                    let dom = self.domain(iter, true)
                    self.pop_frame()
                    self.loop_open(dom, s.local)
                    let depth = len(self.cx.scopes)
                    self.cx.loops.push(depth)
                    self.block(body)
                    self.cx.loops.pop()
                    self.loop_close()
                    self.pop_scope()
                    self.cx.ind -= 1
                    self.line("}")
            case StmtKind.Return(value):
                match value:
                    case Some(e):
                        self.push_frame()
                        let v = self.owned(e)
                        let ct = self.cty(e.ty)
                        let r = self.fresh()
                        self.line(f"{ct} {r} = {v};")
                        self.pop_frame()
                        self.release_scopes_from(0)
                        self.line(f"return {r};")
                    case None:
                        self.release_scopes_from(0)
                        self.line("return;")
            case StmtKind.Break:
                let d = self.cx.loops[len(self.cx.loops) - 1]
                self.release_scopes_from(d)
                self.line("break;")
            case StmtKind.Continue:
                let d = self.cx.loops[len(self.cx.loops) - 1]
                self.release_scopes_from(d)
                self.line("continue;")
            case StmtKind.Pass:
                pass
            case StmtKind.Assert(cond, msg):
                if s.proven:
                    return
                self.push_frame()
                let c = self.expr(cond)
                self.line(f"if (BR_UNLIKELY(!({c}))) \{")
                self.cx.ind += 1
                self.push_frame()
                var m = "NULL"
                match msg:
                    case Some(mx):
                        m = self.expr(mx)
                    case None:
                        pass
                let loc = self.loc(s.span)
                let src = c_escape(self.sm.snippet(cond.span))
                self.line(f"brine_assert_fail({loc}, \"{src}\", {m});")
                self.cx.frames.pop()
                self.cx.ind -= 1
                self.line("}")
                self.pop_frame()
            case _:
                pass

    fn if_chain(ref self, branches: [(Expr, Block)], els: Option[Block]):
        let c = branches[0].0
        let b = branches[0].1
        let sc = self.sub_expr(c)
        let inline = sc.code == ""
        var cond = sc.val
        if not inline:
            self.line("{")
            let cv = self.fresh()
            let v = sc.val
            self.emit_sub(Sub(code=sc.code, val="", temps=[]), Some(f"bool {cv} = {v};"))
            self.cx.ind += 1
            self.release_temps(sc.temps)
            cond = cv
        self.line(f"if ({cond}) \{")
        self.cx.ind += 1
        self.block(b)
        self.cx.ind -= 1
        if len(branches) > 1 or els.is_some():
            self.line("} else {")
            self.cx.ind += 1
            if len(branches) > 1:
                self.if_chain(branches[1:], els)
            else:
                match els:
                    case Some(eb):
                        self.block(eb)
                    case None:
                        pass
            self.cx.ind -= 1
        self.line("}")
        if not inline:
            self.cx.ind -= 1
            self.line("}")

    fn lvalue(ref self, e: Expr) -> str:
        match e.kind:
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        return self.local_c(id)
                    case _:
                        return self.expr(e)
            case ExprKind.Field(base, _, _):
                let b = self.lvalue(base)
                return b + "." + self.field_c(base.ty, e.idx)
            case ExprKind.Index(base, idx):
                match base.ty:
                    case Ty.Map(_, _):
                        let k0 = self.expr(idx)
                        let k = self.decl_scalar(idx.ty, k0)
                        let b = self.lvalue(base)
                        let vt = self.cty(e.ty)
                        let loc = self.loc(e.span)
                        return f"(*({vt} *)brine_map_at_mut(&({b}), &{k}, {loc}))"
                    case _:
                        pass
                let i = self.expr(idx)
                let b = self.lvalue(base)
                var skip = false
                match base.kind:
                    case ExprKind.Ident(_):
                        match base.res:
                            case Res.Local(l):
                                skip = l in self.cx.par_writes
                            case _:
                                pass
                    case _:
                        pass
                if not skip:
                    self.line(f"brine_arr_unique(&({b}));")
                let et = self.cty(e.ty)
                if e.checked:
                    let loc = self.loc(e.span)
                    return f"(({et} *)({b})->data)[brine_idx((int64_t)({i}), ({b})->len, {loc})]"
                return f"(({et} *)({b})->data)[(int64_t)({i})]"
            case _:
                return self.expr(e)

    # ============================================================ expressions
    fn expr(ref self, e: Expr) -> str:
        let loc = self.loc(e.span)
        match e.kind:
            case ExprKind.Int(v):
                return self.int_lit(v, e.ty)
            case ExprKind.Float(v):
                return self.float_lit(v, e.ty)
            case ExprKind.Bool(b):
                return "true" if b else "false"
            case ExprKind.Str(s):
                return self.str_lit(s)
            case ExprKind.FStr(segs):
                let sb = self.fresh()
                self.line(f"brine_sb {sb}; brine_sb_init(&{sb});")
                let sbp = "&" + sb
                for seg in segs:
                    match seg:
                        case FSeg.Lit(s):
                            if s != "":
                                self.line(f"brine_sb_cat({sbp}, \"{c_escape(s)}\", {len(s)});")
                        case FSeg.Part(x, spec):
                            let v = self.expr(x)
                            var fs: Option[FmtSpec] = None
                            match spec:
                                case Some(sp):
                                    fs = parse_fmt_spec(sp)
                                case None:
                                    pass
                            match fs:
                                case None:
                                    let c = self.fmt_code(sbp, v, x.ty, false)
                                    self.line(c)
                                case Some(f):
                                    self.fmt_spec(sb, v, x.ty, f)
                return self.decl_temp(Ty.Str, f"brine_sb_finish(&{sb})")
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        return self.local_c(id)
                    case Res.Const(id):
                        return self.const_val(id)
                    case Res.Variant(_, vi):
                        return self.variant_const(e.ty, vi)
                    case _:
                        return "0"
            case ExprKind.Try(x):
                return self.try_expr(x, e)
            case ExprKind.Unary(op, x):
                let v = self.expr(x)
                match op:
                    case UnOp.Neg:
                        match e.ty:
                            case Ty.Int(k):
                                if k.signed():
                                    return f"brine_neg_{k.suffix()}({v}, {loc})"
                            case _:
                                pass
                        return f"(-({v}))"
                    case UnOp.Not:
                        return f"(!({v}))"
                    case UnOp.BitNot:
                        let tn = self.ctype_name(e.ty)
                        return f"(({tn})~({v}))"
            case ExprKind.Binary(op, l, r):
                if op == BinOp.And or op == BinOp.Or:
                    let a = self.expr(l)
                    let sr = self.sub_expr(r)
                    let is_and = op == BinOp.And
                    if sr.code == "":
                        let sym = "&&" if is_and else "||"
                        return f"({a} {sym} {sr.val})"
                    let t = self.decl_scalar(Ty.Bool, a)
                    let bang = "" if is_and else "!"
                    self.line(f"if ({bang}{t}) \{")
                    let v = sr.val
                    self.emit_sub(sr, Some(f"{t} = {v};"))
                    self.line("}")
                    return t
                if op == BinOp.Add and e.ty == Ty.Str:
                    let a = self.expr(l)
                    let b = self.expr(r)
                    return self.decl_temp(Ty.Str, f"brine_str_concat({a}, {b})")
                let a = self.expr(l)
                let b = self.expr(r)
                return self.arith(op, a, b, e.ty, e.checked, loc)
            case ExprKind.Compare(first, rest):
                let a = self.expr(first)
                if len(rest) == 1:
                    let b = self.expr(rest[0].1)
                    return self.cmp_code(rest[0].0, a, b, first.ty)
                let r = self.fresh()
                self.line(f"bool {r} = false;")
                var prev = a
                var stack: [[Temp]] = []
                let n = len(rest)
                for i, opx in enumerate(rest):
                    let op = opx.0
                    let x = opx.1
                    let sx = self.sub_expr(x)
                    self.line("{")
                    self.cx.out += sx.code
                    self.cx.ind += 1
                    let c = self.cmp_code(op, prev, sx.val, x.ty)
                    self.line(f"{r} = {c};")
                    if i + 1 < n:
                        self.line(f"if ({r}) \{")
                        self.cx.ind += 1
                    prev = sx.val
                    stack.push(sx.temps)
                var j = len(stack) - 1
                while j >= 0:
                    if j + 1 < n:
                        self.cx.ind -= 1
                        self.line("}")
                    self.release_temps(stack[j])
                    self.cx.ind -= 1
                    self.line("}")
                    j -= 1
                return r
            case ExprKind.IfElse(cond, then, els):
                let c = self.expr(cond)
                let m = self.managed(e.ty)
                let sv1 = self.sub_begin()
                let v1x = self.owned(then) if m else self.expr(then)
                let s1 = self.sub_end(sv1, v1x)
                let sv2 = self.sub_begin()
                let v2x = self.owned(els) if m else self.expr(els)
                let s2 = self.sub_end(sv2, v2x)
                if not m and s1.code == "" and s2.code == "":
                    return f"({c} ? {s1.val} : {s2.val})"
                let t = self.fresh()
                let ct = self.cty(e.ty)
                self.line(f"{ct} {t};")
                self.register(t, e.ty)
                self.line(f"if ({c}) \{")
                let v1 = s1.val
                self.emit_sub(s1, Some(f"{t} = {v1};"))
                self.line("} else {")
                let v2 = s2.val
                self.emit_sub(s2, Some(f"{t} = {v2};"))
                self.line("}")
                return t
            case ExprKind.Call(_, args):
                match e.cres:
                    case CallRes.Fn(id):
                        return self.call_fn(id, None, args, e.span)
                    case CallRes.Ctor(sid):
                        return self.ctor(sid, args, e)
                    case CallRes.Variant(eid, vi):
                        return self.variant(eid, vi, args, e)
                    case CallRes.Builtin(b):
                        return self.builtin(b, None, args, e)
                    case CallRes.Reduce(r):
                        return self.reduce(r, args[0].expr, e)
                    case CallRes.Convert(t):
                        return self.convert(t, args[0].expr, e)
                    case _:
                        return "0"
            case ExprKind.MethodCall(recv, _, _, args):
                match e.cres:
                    case CallRes.Fn(id):
                        return self.call_fn(id, None, args, e.span)
                    case CallRes.Method(id):
                        return self.call_fn(id, Some(recv), args, e.span)
                    case CallRes.Ctor(sid):
                        return self.ctor(sid, args, e)
                    case CallRes.Variant(eid, vi):
                        return self.variant(eid, vi, args, e)
                    case CallRes.Builtin(b):
                        return self.builtin(b, Some(recv), args, e)
                    case CallRes.World(op):
                        return self.world(op, args, e)
                    case CallRes.Os(op):
                        return self.os(op, args, e)
                    case _:
                        return "0"
            case ExprKind.Field(base, _, _):
                match e.res:
                    case Res.Const(id):
                        return self.const_val(id)
                    case Res.Variant(_, vi):
                        return self.variant_const(e.ty, vi)
                    case _:
                        pass
                let b = self.expr(base)
                return b + "." + self.field_c(base.ty, e.idx)
            case ExprKind.Slice(base, lo, hi):
                let b = self.expr(base)
                var l0 = "0"
                match lo:
                    case Some(x):
                        l0 = self.expr(x)
                    case None:
                        pass
                let l = self.decl_scalar(int_ty(), l0)
                var h = f"({b})->len"
                match hi:
                    case Some(x):
                        h = self.expr(x)
                    case None:
                        pass
                let f = "brine_str_slice" if base.ty == Ty.Str else "brine_arr_slice"
                return self.decl_temp(e.ty, f"{f}({b}, {l}, {h}, {loc})")
            case ExprKind.Index(base, idx):
                if base.ty == Ty.Str:
                    let b = self.expr(base)
                    let i = self.expr(idx)
                    if e.checked:
                        return f"brine_str_at({b}, (int64_t)({i}), {loc})"
                    return f"brine_str_byte({b}, (int64_t)({i}))"
                match base.ty:
                    case Ty.Map(_, _):
                        let b = self.expr(base)
                        let k0 = self.expr(idx)
                        let k = self.decl_scalar(idx.ty, k0)
                        let vt = self.cty(e.ty)
                        return f"(*({vt} *)brine_map_at({b}, &{k}, {loc}))"
                    case _:
                        pass
                let b = self.expr(base)
                let i = self.expr(idx)
                let et = self.cty(e.ty)
                if e.checked:
                    return f"(({et} *)({b})->data)[brine_idx((int64_t)({i}), ({b})->len, {loc})]"
                return f"(({et} *)({b})->data)[(int64_t)({i})]"
            case ExprKind.Map(kvs):
                let mt = self.map_ty(e.ty)
                let t = self.decl_temp(e.ty, f"brine_map_new({mt})")
                for k, v in kvs:
                    self.map_set(t, k, v)
                return t
            case ExprKind.Contains(item, coll, neg):
                let c = self.expr(coll)
                let x = self.expr(item)
                var tst = ""
                match coll.ty:
                    case Ty.Map(_, _):
                        let k = self.decl_scalar(item.ty, x)
                        tst = f"brine_map_has({c}, &{k})"
                    case Ty.Str:
                        tst = f"brine_str_contains({c}, {x})"
                    case _:
                        let el = coll.ty.elem()
                        let et = self.cty(el)
                        let xv = self.decl_scalar(el, x)
                        let r = self.decl_scalar(Ty.Bool, "false")
                        let i = self.fresh()
                        let eq = self.eq_code(f"(({et} *)({c})->data)[{i}]", xv, el)
                        self.line(
                            f"for (int64_t {i} = 0; {i} < ({c})->len; {i}++) if ({eq}) \{ {r} = true; break; \}"
                        )
                        tst = r
                if neg:
                    return f"(!{tst})"
                return tst
            case ExprKind.Array(es):
                let el = e.ty.elem()
                let vals = self.owned_all(es)
                let init = self.new_arr(el, f"{len(es)}", loc)
                let t = self.decl_temp(e.ty, init)
                let et = self.cty(el)
                for i, v in enumerate(vals):
                    self.line(f"(({et} *){t}->data)[{i}] = {v};")
                return t
            case ExprKind.Repeat(elem, count):
                let el = e.ty.elem()
                let v = self.expr(elem)
                let n0 = self.expr(count)
                let n = self.decl_scalar(int_ty(), n0)
                let init = self.new_arr(el, n, loc)
                let t = self.decl_temp(e.ty, init)
                var zero = false
                match elem.kind:
                    case ExprKind.Int(z):
                        zero = z == 0
                    case ExprKind.Bool(z):
                        zero = not z
                    case ExprKind.Float(z):
                        let zs = f"{z}"
                        zero = z == 0.0 and not zs.starts_with("-")
                    case _:
                        pass
                if not zero:
                    let et = self.cty(el)
                    let k = self.fresh()
                    let rt = self.retain_code(f"(({et} *){t}->data)[{k}]", el)
                    self.line(
                        f"for (int64_t {k} = 0; {k} < {n}; {k}++) \{ (({et} *){t}->data)[{k}] = {v}; {rt} \}"
                    )
                return t
            case ExprKind.Tuple(es):
                if len(es) == 0:
                    return "((brine_unit)0)"
                let vals = self.owned_all(es)
                return self.decl_temp(e.ty, "{" + ", ".join(vals) + "}")
            case ExprKind.Comp(c):
                if c.par:
                    return self.par_list(c, e)
                return self.seq_list(c, e)
            case ExprKind.ParTuple(elems):
                return self.par_tuple(elems, e.caps, e)
            case _:
                return "0"

    fn fmt_spec(ref self, sb: str, v: str, t: Ty, fs: FmtSpec):
        let sbp = "&" + sb
        var st: Option[str] = None
        if fs.width > 0:
            let s = self.fresh()
            self.line(f"int64_t {s} = {sb}.len;")
            st = Some(s)
        let k = fs.kind.unwrap_or("")
        if k == "f" or k == "e":
            let p = fs.prec.unwrap_or(-1)
            self.line(f"brine_sb_fmt_f64({sbp}, (double)({v}), {p}, '{k}');")
        elif k == "x" or k == "b":
            match t:
                case Ty.Int(IntTy.I128):
                    self.line(f"brine_sb_fmt_i128({sbp}, {v}, '{k}');")
                case Ty.Int(IntTy.U128):
                    self.line(f"brine_sb_fmt_u128({sbp}, {v}, '{k}');")
                case Ty.Int(ik):
                    if ik.signed():
                        self.line(f"brine_sb_fmt_i64({sbp}, (int64_t)({v}), '{k}');")
                    else:
                        self.line(f"brine_sb_fmt_u64({sbp}, (uint64_t)({v}), '{k}');")
                case _:
                    self.line(f"brine_sb_fmt_u64({sbp}, (uint64_t)({v}), '{k}');")
        else:
            let c = self.fmt_code(sbp, v, t, false)
            self.line(c)
        match st:
            case Some(s):
                let left = "true" if fs.left else "false"
                let zero = "true" if fs.zero else "false"
                self.line(f"brine_sb_pad({sbp}, {s}, {fs.width}, {left}, {zero});")
            case None:
                pass

    fn arith(ref self, op: BinOp, a: str, b: str, ty: Ty, checked: bool, loc: str) -> str:
        match ty:
            case Ty.Int(k):
                let ct = k.c_type()
                let s = k.suffix()
                match op:
                    case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.Div | BinOp.Mod:
                        if checked:
                            var n = "mod"
                            match op:
                                case BinOp.Add:
                                    n = "add"
                                case BinOp.Sub:
                                    n = "sub"
                                case BinOp.Mul:
                                    n = "mul"
                                case BinOp.Div:
                                    n = "div"
                                case _:
                                    pass
                            return f"brine_{n}_{s}({a}, {b}, {loc})"
                        if op == BinOp.Div:
                            return f"brine_fdiv_{s}({a}, {b})"
                        if op == BinOp.Mod:
                            return f"brine_fmod_{s}({a}, {b})"
                        return f"(({ct})(({a}) {op.sym()} ({b})))"
                    case BinOp.BitAnd | BinOp.BitOr | BinOp.BitXor:
                        return f"(({ct})(({a}) {op.sym()} ({b})))"
                    case BinOp.Shl:
                        if checked:
                            return f"brine_shl_{s}({a}, (int64_t)({b}), {loc})"
                        return f"(({ct})((uint64_t)({a}) << ({b})))"
                    case BinOp.Shr:
                        if checked:
                            return f"brine_shr_{s}({a}, (int64_t)({b}), {loc})"
                        return f"(({ct})(({a}) >> ({b})))"
                    case _:
                        return "0"
            case Ty.Float(f):
                if op == BinOp.Mod:
                    if f == FloatTy.F32:
                        return f"brine_f_fmodf({a}, {b})"
                    return f"brine_f_fmod({a}, {b})"
                return f"(({a}) {op.sym()} ({b}))"
            case _:
                return "0"

    fn cmp_code(ref self, op: CmpOp, a: str, b: str, t: Ty) -> str:
        match t:
            case Ty.Str:
                match op:
                    case CmpOp.Eq:
                        return f"brine_str_eq({a}, {b})"
                    case CmpOp.Ne:
                        return f"(!brine_str_eq({a}, {b}))"
                    case _:
                        return f"(brine_str_cmp({a}, {b}) {op.sym()} 0)"
            case Ty.Array(_) | Ty.Map(_, _) | Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                let c = self.eq_code(a, b, t)
                if op == CmpOp.Ne:
                    return f"(!{c})"
                return c
            case _:
                return f"(({a}) {op.sym()} ({b}))"

    fn call_fn(ref self, id: int, recv: Option[Expr], args: [Arg], span: Span) -> str:
        let sig = self.info.fns[id]
        # With a `ref` parameter, by-value arguments may read the variable the call
        # changes; holding a reference of their own makes copy-on-write protect them.
        let has_ref = any(p.by_ref for p in sig.params)
        var cargs: [str] = []
        var pi = 0
        match recv:
            case Some(r):
                if sig.params[0].by_ref:
                    let lv = self.lvalue(r)
                    cargs.push("&(" + lv + ")")
                else:
                    cargs.push(self.value_arg(r, has_ref))
                pi = 1
            case None:
                pass
        for i, a in enumerate(args):
            if pi + i >= len(sig.params):
                break
            if sig.params[pi + i].by_ref:
                let lv = self.lvalue(a.expr)
                cargs.push("&(" + lv + ")")
            else:
                cargs.push(self.value_arg(a.expr, has_ref))
        if self.tracks_caller(id):
            cargs.push(self.loc(span))
        let call = sig.c_name + "(" + ", ".join(cargs) + ")"
        if sig.ret == Ty.Unit:
            self.line(call + ";")
            return "((brine_unit)0)"
        return self.decl_temp(sig.ret, call)

    # `x?`: return `None`/`Err` from the function, or continue with the value inside.
    fn try_expr(ref self, x: Expr, e: Expr) -> str:
        let v0 = self.expr(x)
        let v = self.decl_scalar(x.ty, v0)
        let f = self.fnd.unwrap()
        let rty = self.info.fns[f.id].ret
        let kind = try_kind(self.info, x.ty).unwrap()
        var fail_v = 0
        var ok_v = 0
        match kind:
            case TryKind.Opt(some, none, _):
                fail_v = none
                ok_v = some
            case TryKind.Res(okv, errv, _, _):
                fail_v = errv
                ok_v = okv
        self.line(f"if ({v}->tag == {fail_v}) \{")
        self.cx.ind += 1
        var ret = ""
        let rk = try_kind(self.info, rty)
        match (kind, rk):
            case (TryKind.Res(_, _, _, err), Some(TryKind.Res(_, rerr_v, _, _))):
                let xe = cg_enum_id(x.ty)
                let re = cg_enum_id(rty)
                let xf = self.cname(self.info.enums[xe].variants[fail_v].fields[0].0)
                let rf = self.cname(self.info.enums[re].variants[rerr_v].fields[0].0)
                let ct = self.cty(rty)
                let r = self.fresh()
                self.line(f"{ct} {r} = ({ct})brine_box_new(sizeof({ct}_box), {rerr_v});")
                self.line(f"{r}->u.v{rerr_v}.{rf} = {v}->u.v{fail_v}.{xf};")
                let rc = self.retain_code(f"{r}->u.v{rerr_v}.{rf}", err)
                self.line(rc)
                ret = r
            case (_, Some(TryKind.Opt(_, none, _))):
                ret = self.variant_const(rty, none)
            case _:
                panic("`?` in a function that doesn't return Option/Result")
        # leave the function: release this statement's temps and every local
        var temps: [Temp] = []
        for fr in self.cx.frames:
            temps.extend(fr)
        self.release_temps(temps)
        self.release_scopes_from(0)
        self.line(f"return {ret};")
        self.cx.ind -= 1
        self.line("}")
        let xe2 = cg_enum_id(x.ty)
        let of = self.cname(self.info.enums[xe2].variants[ok_v].fields[0].0)
        return f"{v}->u.v{ok_v}.{of}"

    # A by-value argument; `hold` keeps a reference until the end of the statement.
    fn value_arg(ref self, e: Expr, hold: bool) -> str:
        if not hold or not self.managed(e.ty):
            return self.expr(e)
        let v = self.owned(e)
        self.register(v, e.ty)
        return v

    fn ctor(ref self, sid: int, args: [Arg], e: Expr) -> str:
        let s = self.info.structs[sid]
        let n = len(s.fields)
        # evaluate every argument before claiming any (see `owned_all`)
        let owned = self.owned_all([a.expr for a in args])
        var vals: [str] = [""] * n
        for i, a in enumerate(args):
            if i >= len(owned):
                break
            var idx = i
            match a.name:
                case Some((name, _)):
                    for j, fd in enumerate(s.fields):
                        if fd.0 == name:
                            idx = j
                            break
                case None:
                    pass
            if idx < n:
                vals[idx] = owned[i]
        let init = "{0}" if n == 0 else "{" + ", ".join(vals) + "}"
        return self.decl_temp(e.ty, init)

    # A variant without fields used as a value: `Color.Red`, `None`.
    fn variant_const(ref self, t: Ty, vi: int) -> str:
        let ct = self.cty(t)
        if self.boxed(t):
            return f"(&br_ev_{ct}_{vi})"
        return f"(({ct}){vi})"

    fn variant(ref self, eid: int, vi: int, args: [Arg], e: Expr) -> str:
        let ct = self.cty(e.ty)
        let fields = self.info.enums[eid].variants[vi].fields
        if len(fields) == 0:
            return f"(&br_ev_{ct}_{vi})"
        let n = len(fields)
        # evaluate every argument before claiming any (see `owned_all`)
        let owned = self.owned_all([a.expr for a in args])
        var vals: [str] = [""] * n
        for i, a in enumerate(args):
            if i >= len(owned):
                break
            var idx = i
            match a.name:
                case Some((name, _)):
                    for j, fd in enumerate(fields):
                        if fd.0 == name:
                            idx = j
                            break
                case None:
                    pass
            if idx < n:
                vals[idx] = owned[i]
        let t = self.decl_temp(
            e.ty,
            f"({ct})brine_box_new(offsetof({ct}_box, u) + sizeof(((({ct}_box *)0)->u.v{vi})), {vi})"
        )
        for i, fd in enumerate(fields):
            let fc = self.cname(fd.0)
            self.line(f"{t}->u.v{vi}.{fc} = {vals[i]};")
        return t

    # ------------------------------------------------------------ match
    fn match_stmt(ref self, scrut: Expr, cases: [Case]):
        let ty = scrut.ty
        self.line("{")
        self.cx.ind += 1
        self.push_scope()
        self.push_frame()
        let v = self.owned(scrut)
        let ct = self.cty(ty)
        let s = self.fresh()
        self.line(f"{ct} {s} = {v};")
        self.pop_frame()
        self.add_local(s, ty)
        let fr = self.fresh()
        let end = fr + "_end"
        for c in cases:
            let cond = self.pat_test(c.pat, s, ty)
            self.line(f"if ({cond}) \{")
            self.cx.ind += 1
            self.pat_bind(c.pat, s, ty)
            match c.guard:
                case None:
                    self.block(c.body)
                    self.line(f"goto {end};")
                case Some(g):
                    let sb = self.sub_expr(g)
                    let cv = self.fresh()
                    self.line("{")
                    let val = sb.val
                    self.emit_sub(Sub(code=sb.code, val="", temps=[]), Some(f"bool {cv} = {val};"))
                    self.cx.ind += 1
                    self.release_temps(sb.temps)
                    self.line(f"if ({cv}) \{")
                    self.cx.ind += 1
                    self.block(c.body)
                    self.line(f"goto {end};")
                    self.cx.ind -= 1
                    self.line("}")
                    self.cx.ind -= 1
                    self.line("}")
            self.cx.ind -= 1
            self.line("}")
        self.line("brine_unreachable();")
        self.line(f"{end}:;")
        self.pop_scope()
        self.cx.ind -= 1
        self.line("}")

    # C condition: does the value `v` (of type `ty`) match `p`?
    fn pat_test(ref self, p: Pattern, v: str, ty: Ty) -> str:
        match p.kind:
            case PatKind.Wild | PatKind.Bind(_):
                return "1"
            case PatKind.Int(n):
                let l = self.int_lit(n, ty)
                return f"({v} == {l})"
            case PatKind.Str(s):
                let l = self.str_lit(s)
                return f"brine_str_eq({v}, {l})"
            case PatKind.Bool(b):
                if b:
                    return f"({v})"
                return f"(!({v}))"
            case PatKind.Or(alts):
                var parts: [str] = []
                for a in alts:
                    parts.push(self.pat_test(a, v, ty))
                if "1" in parts:
                    return "1"
                return "(" + " || ".join(parts) + ")"
            case PatKind.Tuple(ps):
                var ts: [Ty] = []
                match ty:
                    case Ty.Tuple(xs):
                        ts = xs
                    case _:
                        return "1"
                var parts: [str] = []
                for i, q in enumerate(ps):
                    let t = self.pat_test(q, f"{v}.f{i}", ts[i])
                    if t != "1":
                        parts.push(t)
                if len(parts) == 0:
                    return "1"
                return "(" + " && ".join(parts) + ")"
            case PatKind.Variant(_, _):
                match p.vres:
                    case Some((eid, vi)):
                        if not self.boxed(ty):
                            return f"({v} == {vi})"
                        let fts = self.info.enums[eid].variants[vi].fields
                        var parts = [f"{v}->tag == {vi}"]
                        for i in 0..min(len(p.fields), len(fts)):
                            let fc = self.cname(fts[i].0)
                            let t = self.pat_test(p.fields[i], f"{v}->u.v{vi}.{fc}", fts[i].1)
                            if t != "1":
                                parts.push(t)
                        return "(" + " && ".join(parts) + ")"
                    case None:
                        return "0"

    # Declare the names bound by `p`. They borrow from the matched value,
    # which the `match` keeps alive.
    fn pat_bind(ref self, p: Pattern, v: str, ty: Ty):
        match p.kind:
            case PatKind.Bind(_):
                let ct = self.cty(ty)
                let n = self.local_c(p.local)
                self.line(f"{ct} {n} = {v};")
            case PatKind.Tuple(ps):
                match ty:
                    case Ty.Tuple(ts):
                        for i, q in enumerate(ps):
                            self.pat_bind(q, f"{v}.f{i}", ts[i])
                    case _:
                        pass
            case PatKind.Variant(_, _):
                match p.vres:
                    case Some((eid, vi)):
                        let fts = self.info.enums[eid].variants[vi].fields
                        for i in 0..min(len(p.fields), len(fts)):
                            let fc = self.cname(fts[i].0)
                            let path = f"{v}->u.v{vi}.{fc}"
                            self.pat_bind(p.fields[i], path, fts[i].1)
                    case None:
                        pass
            case _:
                pass

    fn builtin(ref self, b: Builtin, recv: Option[Expr], args: [Arg], e: Expr) -> str:
        let loc = self.loc(e.span)
        match b:
            case Builtin.Print | Builtin.Eprint:
                var vals: [(str, Ty)] = []
                for a in args:
                    vals.push((self.expr(a.expr), a.expr.ty))
                let sb = self.fresh()
                self.line(f"brine_sb {sb}; brine_sb_init(&{sb});")
                for i, vt in enumerate(vals):
                    if i > 0:
                        self.line(f"brine_sb_cat(&{sb}, \" \", 1);")
                    let c = self.fmt_code("&" + sb, vt.0, vt.1, false)
                    self.line(c)
                let f = "brine_print_sb" if b == Builtin.Print else "brine_eprint_sb"
                self.line(f"{f}(&{sb});")
                return ""
            case Builtin.Len:
                let v = self.expr(args[0].expr)
                return f"(({v})->len)"
            case Builtin.Get:
                let r = recv.unwrap()
                var vt = Ty.Error
                match r.ty:
                    case Ty.Map(_, x):
                        vt = x
                    case _:
                        pass
                let m = self.expr(r)
                let k0 = self.expr(args[0].expr)
                let k = self.decl_scalar(args[0].expr.ty, k0)
                let vc = self.cty(vt)
                let ix = self.decl_scalar(int_ty(), f"brine_map_find({m}, &{k})")
                let found = f"(({vc} *)({m})->vals)[{ix}]"
                if len(args) == 2:
                    let d = self.expr(args[1].expr)
                    return self.decl_scalar(vt, f"{ix} >= 0 ? {found} : {d}")
                return self.make_option(e.ty, f"{ix} >= 0", found, vt)
            case Builtin.Remove:
                let r = recv.unwrap()
                let k0 = self.expr(args[0].expr)
                let k = self.decl_scalar(args[0].expr.ty, k0)
                let lv = self.lvalue(r)
                return self.decl_scalar(Ty.Bool, f"brine_map_remove(&({lv}), &{k})")
            case Builtin.Keys | Builtin.Values:
                let m = self.expr(recv.unwrap())
                let f = "brine_map_keys" if b == Builtin.Keys else "brine_map_values"
                return self.decl_temp(e.ty, f"{f}({m})")
            case Builtin.Items:
                let r = recv.unwrap()
                var kt = Ty.Error
                var vt = Ty.Error
                match r.ty:
                    case Ty.Map(x, y):
                        kt = x
                        vt = y
                    case _:
                        pass
                let m = self.expr(r)
                let el = e.ty.elem()
                let init = self.new_arr(el, f"({m})->len", loc)
                let t = self.decl_temp(e.ty, init)
                let kc = self.cty(kt)
                let vc = self.cty(vt)
                let ec = self.cty(el)
                let i = self.fresh()
                let j = self.fresh()
                let p = self.fresh()
                let rk = self.retain_code(f"{p}->f0", kt)
                let rv = self.retain_code(f"{p}->f1", vt)
                self.line(
                    f"for (int64_t {i} = 0, {j} = 0; {i} < ({m})->used; {i}++) \{ if (!({m})->live[{i}]) continue; {ec} *{p} = &(({ec} *){t}->data)[{j}++]; {p}->f0 = (({kc} *)({m})->keys)[{i}]; {p}->f1 = (({vc} *)({m})->vals)[{i}]; {rk} {rv} \}"
                )
                return t
            case Builtin.Abs:
                let v = self.expr(args[0].expr)
                match e.ty:
                    case Ty.Int(k):
                        let suf = k.suffix()
                        return f"brine_abs_{suf}({v}, {loc})"
                    case Ty.Float(FloatTy.F32):
                        return f"brine_f_fabsf({v})"
                    case _:
                        return f"brine_f_fabs({v})"
            case Builtin.Min | Builtin.Max:
                let a = self.expr(args[0].expr)
                let c = self.expr(args[1].expr)
                let mn = b == Builtin.Min
                match e.ty:
                    case Ty.Float(fk):
                        let suf = "f" if fk == FloatTy.F32 else ""
                        let nm = "min" if mn else "max"
                        return f"brine_f_f{nm}{suf}({a}, {c})"
                    case _:
                        let x = self.decl_scalar(e.ty, a)
                        let y = self.decl_scalar(e.ty, c)
                        let op = "<" if mn else ">"
                        return f"({x} {op} {y} ? {x} : {y})"
            case Builtin.Sqrt | Builtin.Sin | Builtin.Cos | Builtin.Tan | Builtin.Exp | Builtin.Log | Builtin.Floor | Builtin.Ceil | Builtin.Round:
                let v = self.expr(args[0].expr)
                var n = "round"
                match b:
                    case Builtin.Sqrt:
                        n = "sqrt"
                    case Builtin.Sin:
                        n = "sin"
                    case Builtin.Cos:
                        n = "cos"
                    case Builtin.Tan:
                        n = "tan"
                    case Builtin.Exp:
                        n = "exp"
                    case Builtin.Log:
                        n = "log"
                    case Builtin.Floor:
                        n = "floor"
                    case Builtin.Ceil:
                        n = "ceil"
                    case _:
                        n = "round"
                let suf = "f" if e.ty == Ty.Float(FloatTy.F32) else ""
                return f"brine_f_{n}{suf}({v})"
            case Builtin.Pow:
                let a = self.expr(args[0].expr)
                let c = self.expr(args[1].expr)
                return f"brine_f_pow({a}, {c})"
            case Builtin.Clock:
                return self.decl_scalar(float_ty(), "brine_clock()")
            case Builtin.Args:
                return self.decl_temp(e.ty, "brine_args()")
            case Builtin.Exit:
                let v = self.expr(args[0].expr)
                self.line(f"brine_exit({v});")
                return ""
            case Builtin.Panic:
                let v = self.expr(args[0].expr)
                self.line(f"brine_panic_str({loc}, {v});")
                return ""
            case Builtin.Push:
                let r = recv.unwrap()
                let el = r.ty.elem()
                let v = self.owned(args[0].expr)
                let et = self.cty(el)
                let t = self.fresh()
                self.line(f"{et} {t} = {v};")
                let lv = self.lvalue(r)
                self.line(f"brine_arr_push(&({lv}), &{t});")
                return ""
            case Builtin.Pop | Builtin.PopAt:
                let r = recv.unwrap()
                var idx: Option[str] = None
                if b == Builtin.PopAt:
                    idx = Some(self.expr(args[0].expr))
                let lv = self.lvalue(r)
                let t = self.fresh()
                let et = self.cty(e.ty)
                self.line(f"{et} {t};")
                match idx:
                    case Some(i):
                        self.line(f"brine_arr_pop_at(&({lv}), {i}, &{t}, {loc});")
                    case None:
                        self.line(f"brine_arr_pop(&({lv}), &{t}, {loc});")
                self.register(t, e.ty)
                return t
            case Builtin.Insert:
                let r = recv.unwrap()
                let i0 = self.expr(args[0].expr)
                let i = self.decl_scalar(int_ty(), i0)
                let v = self.owned(args[1].expr)
                let el = r.ty.elem()
                let t = self.decl_scalar(el, v)
                let lv = self.lvalue(r)
                self.line(f"brine_arr_insert(&({lv}), {i}, &{t}, {loc});")
                return ""
            case Builtin.Extend:
                let r = recv.unwrap()
                let v = self.expr(args[0].expr)
                let lv = self.lvalue(r)
                self.line(f"brine_arr_extend(&({lv}), {v});")
                return ""
            case Builtin.Reverse | Builtin.Clear | Builtin.Sort:
                let r = recv.unwrap()
                let lv = self.lvalue(r)
                if b == Builtin.Reverse:
                    self.line(f"brine_arr_reverse(&({lv}));")
                elif b == Builtin.Clear:
                    self.line(f"brine_arr_clear(&({lv}));")
                else:
                    let c = self.need_cmp(r.ty.elem())
                    self.line(f"brine_arr_sort(&({lv}), {c});")
                return ""
            case Builtin.IndexOf:
                let r = recv.unwrap()
                let el = r.ty.elem()
                let a = self.expr(r)
                let x0 = self.expr(args[0].expr)
                let x = self.decl_scalar(el, x0)
                let et = self.cty(el)
                let ix = self.decl_scalar(int_ty(), "-1")
                let i = self.fresh()
                let eq = self.eq_code(f"(({et} *)({a})->data)[{i}]", x, el)
                self.line(
                    f"for (int64_t {i} = 0; {i} < ({a})->len; {i}++) if ({eq}) \{ {ix} = {i}; break; \}"
                )
                return self.make_option(e.ty, f"{ix} >= 0", ix, int_ty())
            case Builtin.Str(m):
                let r = recv.unwrap()
                var vals = [self.expr(r)]
                for a in args:
                    vals.push(self.expr(a.expr))
                vals.push(loc)
                let call = m.c_name() + "(" + ", ".join(vals) + ")"
                if m == StrM.Find:
                    let ix = self.decl_scalar(int_ty(), call)
                    return self.make_option(e.ty, f"{ix} >= 0", ix, int_ty())
                if self.managed(e.ty):
                    return self.decl_temp(e.ty, call)
                return self.decl_scalar(e.ty, call)
            case Builtin.Enumerate:
                let a = self.expr(args[0].expr)
                let el = e.ty.elem()
                var x = Ty.Error
                match el:
                    case Ty.Tuple(ts):
                        x = ts[1]
                    case _:
                        pass
                let init = self.new_arr(el, f"({a})->len", loc)
                let t = self.decl_temp(e.ty, init)
                let ec = self.cty(el)
                let xc = self.cty(x)
                let i = self.fresh()
                let p = self.fresh()
                let rt = self.retain_code(f"{p}->f1", x)
                self.line(
                    f"for (int64_t {i} = 0; {i} < ({a})->len; {i}++) \{ {ec} *{p} = &(({ec} *){t}->data)[{i}]; {p}->f0 = {i}; {p}->f1 = (({xc} *)({a})->data)[{i}]; {rt} \}"
                )
                return t
            case Builtin.ReadFile:
                let p = self.expr(args[0].expr)
                let out = self.fresh()
                self.line(f"brine_str *{out} = NULL;")
                let ok = self.decl_scalar(Ty.Bool, f"brine_read_file({p}, &{out})")
                return self.make_result(e.ty, ok, out, out)
            case Builtin.WriteFile:
                let p = self.expr(args[0].expr)
                let t = self.expr(args[1].expr)
                let err = self.fresh()
                self.line(f"brine_str *{err} = NULL;")
                let ok = self.decl_scalar(Ty.Bool, f"brine_write_file({p}, {t}, &{err})")
                return self.make_result(e.ty, ok, "((brine_unit)0)", err)
            case Builtin.Run:
                let a = self.expr(args[0].expr)
                let code = self.fresh()
                let err = self.fresh()
                self.line(f"int64_t {code} = 0; brine_str *{err} = NULL;")
                let ok = self.decl_scalar(Ty.Bool, f"brine_run({a}, &{code}, &{err})")
                return self.make_result(e.ty, ok, code, err)
            case Builtin.FileExists:
                let p = self.expr(args[0].expr)
                return self.decl_scalar(Ty.Bool, f"brine_file_exists({p})")
            case Builtin.Embed:
                return self.expr(args[0].expr)
            case Builtin.Getenv:
                let n = self.expr(args[0].expr)
                let g = self.fresh()
                self.line(f"brine_str *{g} = brine_getenv({n});")
                let o = self.make_option(e.ty, f"{g} != NULL", g, Ty.Str)
                self.line(f"if ({g}) brine_str_release({g});")
                return o
            case Builtin.Ord:
                let v = self.expr(args[0].expr)
                return self.decl_scalar(int_ty(), f"brine_ord({v}, {loc})")
            case Builtin.Chr:
                let v = self.expr(args[0].expr)
                return self.decl_temp(Ty.Str, f"brine_chr({v}, {loc})")

    fn convert(ref self, target: Ty, a: Expr, e: Expr) -> str:
        let loc = self.loc(e.span)
        let v = self.expr(a)
        match (target, a.ty):
            case (Ty.Int(k), Ty.Int(j)):
                if k == j:
                    return v
                if widens(j, k):
                    return "((" + k.c_type() + ")(" + v + "))"
                let ks = k.suffix()
                if j.bits() == 128:
                    let js = j.suffix()
                    let jc = j.c_type()
                    return f"brine_conv_{ks}_from_{js}(({jc})({v}), {loc})"
                if j.signed():
                    return f"brine_conv_{ks}_from_i64((int64_t)({v}), {loc})"
                return f"brine_conv_{ks}_from_u64((uint64_t)({v}), {loc})"
            case (Ty.Int(k), Ty.Float(_)):
                let ks = k.suffix()
                return f"brine_conv_{ks}_from_f64((double)({v}), {loc})"
            case (Ty.Int(k), Ty.Bool):
                let kc = k.c_type()
                return f"(({kc})(({v}) ? 1 : 0))"
            case (Ty.Int(k), Ty.Str):
                let ks = k.suffix()
                match k:
                    case IntTy.I64:
                        return self.decl_scalar(int_ty(), f"brine_parse_i64({v}, {loc})")
                    case IntTy.I128 | IntTy.U128:
                        return self.decl_scalar(Ty.Int(k), f"brine_parse_{ks}({v}, {loc})")
                    # through 128 bits, so all of `u64` parses
                    case _:
                        let p = self.decl_scalar(
                            Ty.Int(IntTy.I128),
                            f"brine_parse_i128({v}, {loc})"
                        )
                        return f"brine_conv_{ks}_from_i128({p}, {loc})"
            case (Ty.Float(f), Ty.Str):
                let p = self.decl_scalar(float_ty(), f"brine_parse_f64({v}, {loc})")
                if f == FloatTy.F32:
                    return f"((float){p})"
                return p
            case (Ty.Float(f), _):
                let fc = "float" if f == FloatTy.F32 else "double"
                return f"(({fc})({v}))"
            case (Ty.Str, Ty.Str):
                return v
            case (Ty.Str, _):
                let sb = self.fresh()
                self.line(f"brine_sb {sb}; brine_sb_init(&{sb});")
                let c = self.fmt_code("&" + sb, v, a.ty, false)
                self.line(c)
                return self.decl_temp(Ty.Str, f"brine_sb_finish(&{sb})")
            case _:
                return v

    # `brine_os_<f>(args..., &out, &err)` returning success, made into a `Result`.
    # `out_decl` is the C type and initial value of the output, if there is one.
    fn os_with_err(ref self, f: str, out_decl: Option[(str, str)], a: [str], e: Expr) -> str:
        let err = self.fresh()
        self.line(f"brine_str *{err} = NULL;")
        var call_args = a
        var val = "((brine_unit)0)"
        match out_decl:
            case Some((ct, init)):
                let o = self.fresh()
                self.line(f"{ct} {o} = {init};")
                call_args.push("&" + o)
                val = o
            case None:
                pass
        call_args.push("&" + err)
        let ca = ", ".join(call_args)
        let ok = self.decl_scalar(Ty.Bool, f"brine_os_{f}({ca})")
        return self.make_result(e.ty, ok, val, err)

    # `os.f(...)`: plain runtime calls; failures come back as `Err` values.
    fn os(ref self, op: OsOp, args: [Arg], e: Expr) -> str:
        let loc = self.loc(e.span)
        var a: [str] = []
        for x in args:
            a.push(self.expr(x.expr))
        match op:
            case OsOp.ListDir:
                return self.os_with_err("list_dir", Some(("brine_arr *", "NULL")), a, e)
            case OsOp.FreePorts:
                return self.os_with_err("free_ports", Some(("brine_arr *", "NULL")), a, e)
            case OsOp.AbsPath:
                return self.os_with_err("abs_path", Some(("brine_str *", "NULL")), a, e)
            case OsOp.Spawn:
                return self.os_with_err("spawn", Some(("int64_t", "0")), a, e)
            case OsOp.MakeDir:
                return self.os_with_err("make_dir", None, a, e)
            case OsOp.RemoveFile:
                return self.os_with_err("remove_file", None, a, e)
            case OsOp.Rename:
                return self.os_with_err("rename", None, a, e)
            case OsOp.SetCwd:
                return self.os_with_err("set_cwd", None, a, e)
            case OsOp.WriteBytes:
                return self.os_with_err("write_bytes", None, a, e)
            case OsOp.ExePath:
                return self.decl_temp(Ty.Str, "brine_os_exe_path()")
            case OsOp.IsDir:
                return self.decl_scalar(Ty.Bool, f"brine_os_is_dir({a[0]})")
            case OsOp.IsFile:
                return self.decl_scalar(Ty.Bool, f"brine_os_is_file({a[0]})")
            case OsOp.IsTerminal:
                return self.decl_scalar(Ty.Bool, f"brine_os_is_terminal({a[0]})")
            case OsOp.Cwd:
                return self.decl_temp(Ty.Str, "brine_os_cwd()")
            case OsOp.TempDir:
                return self.decl_temp(Ty.Str, "brine_os_temp_dir()")
            case OsOp.Name:
                return self.decl_temp(Ty.Str, "brine_os_name()")
            case OsOp.Arch:
                return self.decl_temp(Ty.Str, "brine_os_arch()")
            case OsOp.Pid:
                return self.decl_scalar(int_ty(), "brine_os_pid()")
            case OsOp.CpuCount:
                return self.decl_scalar(int_ty(), "brine_os_cpu_count()")
            case OsOp.Wait:
                return self.decl_scalar(int_ty(), f"brine_os_wait({a[0]}, {loc})")
            case OsOp.Sleep:
                self.line(f"brine_os_sleep({a[0]});")
                return ""
            case OsOp.EnableAnsi:
                self.line("brine_os_enable_ansi();")
                return ""
            case OsOp.Kill:
                self.line(f"brine_os_kill({a[0]}, {loc});")
                return ""
            case OsOp.Poll:
                let code = self.fresh()
                self.line(f"int64_t {code} = 0;")
                let done = self.decl_scalar(Ty.Bool, f"brine_os_poll({a[0]}, &{code}, {loc})")
                return self.make_option(e.ty, done, code, int_ty())
            case OsOp.Output:
                let o = self.fresh()
                let er = self.fresh()
                self.line(f"brine_str *{o} = NULL, *{er} = NULL;")
                self.line(f"brine_os_output({a[0]}, &{o}, &{er}, {loc});")
                return self.decl_temp(e.ty, "{" + o + ", " + er + "}")

    fn world(ref self, op: WorldOp, args: [Arg], e: Expr) -> str:
        let loc = self.loc(e.span)
        match op:
            case WorldOp.Rank:
                return "brine_world_rank()"
            case WorldOp.Size:
                return "brine_world_size()"
            case WorldOp.Barrier:
                self.line("brine_world_barrier();")
                return ""
            case WorldOp.Shift:
                let v = self.expr(args[0].expr)
                let by = self.expr(args[1].expr)
                let su = world_suffix(e.ty)
                let de = world_desc(e.ty)
                return self.decl_temp(e.ty, f"brine_world_shift_{su}(\"{de}\", {v}, {by}, {loc})")
            case WorldOp.Exchange:
                let xs = self.expr(args[0].expr)
                let de = world_desc(e.ty.elem())
                return self.decl_temp(e.ty, f"brine_world_exchange(\"{de}\", {xs}, {loc})")
            case WorldOp.Broadcast:
                let r = self.expr(args[0].expr)
                let v = self.expr(args[1].expr)
                let su = world_suffix(e.ty)
                let de = world_desc(e.ty)
                return self.decl_temp(e.ty, f"brine_world_bcast_{su}(\"{de}\", {v}, {r}, {loc})")
            case WorldOp.Sum | WorldOp.Min | WorldOp.Max:
                let v = self.expr(args[0].expr)
                var code = 2
                if op == WorldOp.Sum:
                    code = 0
                elif op == WorldOp.Min:
                    code = 1
                let su = world_suffix(e.ty)
                return self.decl_temp(e.ty, f"brine_world_reduce_{su}({v}, {code}, {loc})")
            case WorldOp.GatherAll:
                let v = self.expr(args[0].expr)
                let t = args[0].expr.ty
                let su = world_suffix(t)
                let de = world_desc(t)
                return self.decl_temp(e.ty, f"brine_world_gather_{su}(\"{de}\", {v}, {loc})")

    # ============================================================ loops and comprehensions
    fn domain(ref self, iter: Expr, stmt: bool) -> Dom:
        let loc = self.loc(iter.span)
        match iter.kind:
            case ExprKind.Range(lo, hi, inclusive):
                var k = IntTy.I64
                match lo.ty:
                    case Ty.Int(x):
                        k = x
                    case _:
                        pass
                let l0 = self.expr(lo)
                let l = self.decl_scalar(lo.ty, l0)
                let h0 = self.expr(hi)
                let h = self.decl_scalar(hi.ty, h0)
                return Dom.Range(k, l, h, inclusive, None)
            case ExprKind.Call(_, args):
                if iter.cres == CallRes.Range:
                    let t = args[0].expr.ty
                    var k = IntTy.I64
                    match t:
                        case Ty.Int(x):
                            k = x
                        case _:
                            pass
                    var vals: [str] = []
                    for a in args:
                        let v = self.expr(a.expr)
                        vals.push(self.decl_scalar(t, v))
                    var lo = ""
                    var hi = ""
                    var step: Option[str] = None
                    if len(vals) == 1:
                        lo = "((" + k.c_type() + ")0)"
                        hi = vals[0]
                    elif len(vals) == 2:
                        lo = vals[0]
                        hi = vals[1]
                    else:
                        lo = vals[0]
                        hi = vals[1]
                        step = Some(vals[2])
                    match step:
                        case Some(s):
                            self.line(
                                f"if ({s} == 0) brine_panic_at({loc}, \"range() step must not be zero\");"
                            )
                        case None:
                            pass
                    return Dom.Range(k, lo, hi, false, step)
            case _:
                pass
        # a map loops over a snapshot of its keys, so the body may change the map
        var v = ""
        var ty = iter.ty
        var done = false
        if iter.ty == Ty.Str:
            let s = self.expr(iter)
            let t = self.fresh()
            self.line(f"brine_arr *{t} = brine_s_chars({s}, {loc});")
            v = t
            ty = Ty.Array(Ty.Str)
            done = true
        else:
            match iter.ty:
                case Ty.Map(kt, _):
                    let m = self.expr(iter)
                    let t = self.fresh()
                    self.line(f"brine_arr *{t} = brine_map_keys({m});")
                    v = t
                    ty = Ty.Array(kt)
                    done = true
                case _:
                    pass
        if not done:
            v = self.owned(iter)
            ty = iter.ty
        if stmt:
            self.add_local(v, ty)
        else:
            self.register(v, ty)
        return Dom.Arr(v, ty.elem())

    fn loop_open(ref self, dom: Dom, var_id: int):
        let v = self.local_c(var_id)
        match dom:
            case Dom.Range(ty, lo, hi, incl, step):
                let t = ty.c_type()
                match step:
                    case None:
                        if not incl:
                            self.line(f"for ({t} {v} = {lo}; {v} < {hi}; {v}++) \{")
                        else:
                            let d = self.fresh()
                            self.line(
                                f"if ({lo} <= {hi}) for ({t} {v} = {lo}, {d} = 0; !{d}; {d} = ({v} == {hi}), {v} += !{d}) \{"
                            )
                    case Some(s):
                        let g = self.fresh()
                        self.line(
                            f"for ({t} {v} = {lo}, {g} = ({s} > 0 ? {lo} < {hi} : {lo} > {hi}); {g}; {g} = ({s} > 0 ? ((uint64_t){hi} - (uint64_t){v} > (uint64_t){s}) : ((uint64_t){v} - (uint64_t){hi} > (uint64_t)0 - (uint64_t){s})), {v} = {g} ? ({t})({v} + {s}) : {v}) \{"
                        )
                self.cx.ind += 1
            case Dom.Arr(arr, elem):
                let k = self.fresh()
                let et = self.cty(elem)
                self.line(f"for (int64_t {k} = 0; {k} < ({arr})->len; {k}++) \{")
                self.cx.ind += 1
                self.line(f"{et} {v} = (({et} *)({arr})->data)[{k}];")

    fn loop_close(ref self):
        self.cx.ind -= 1
        self.line("}")

    # Number of iterations as an `int64_t` variable.
    fn dom_count(ref self, dom: Dom, loc: str) -> str:
        match dom:
            case Dom.Range(_, lo, hi, incl, step):
                let u = self.fresh()
                match step:
                    case None:
                        if not incl:
                            self.line(
                                f"uint64_t {u} = {lo} < {hi} ? (uint64_t){hi} - (uint64_t){lo} : 0;"
                            )
                        else:
                            self.line(
                                f"uint64_t {u} = {lo} <= {hi} ? (uint64_t){hi} - (uint64_t){lo} + 1 : 0;"
                            )
                            self.line(
                                f"if ({lo} <= {hi} && {u} == 0) brine_panic_at({loc}, \"range has too many elements\");"
                            )
                    case Some(s):
                        self.line(
                            f"uint64_t {u} = {s} > 0 ? ({lo} < {hi} ? ((uint64_t){hi} - (uint64_t){lo} - 1) / (uint64_t){s} + 1 : 0) : ({lo} > {hi} ? ((uint64_t){lo} - (uint64_t){hi} - 1) / ((uint64_t)0 - (uint64_t){s}) + 1 : 0);"
                        )
                self.line(
                    f"if ({u} > (uint64_t)INT64_MAX) brine_panic_at({loc}, \"range has too many elements\");"
                )
                return self.decl_scalar(int_ty(), "(int64_t)" + u)
            case Dom.Arr(arr, _):
                return self.decl_scalar(int_ty(), "(" + arr + ")->len")

    fn emit_filter(ref self, f: Expr):
        self.push_frame()
        let v = self.expr(f)
        let b = self.fresh()
        self.line(f"bool {b} = {v};")
        self.pop_frame()
        self.line(f"if (!{b}) continue;")

    fn seq_list(ref self, c: Comp, e: Expr) -> str:
        let loc = self.loc(e.span)
        let el = c.body.ty
        let et = self.cty(el)
        let dom = self.domain(c.iter, false)
        match c.filter:
            case None:
                let n = self.dom_count(dom, loc)
                let init = self.new_arr(el, n, loc)
                let res = self.decl_temp(e.ty, init)
                let k = self.fresh()
                self.line(f"int64_t {k} = 0;")
                self.loop_open(dom, e.local)
                self.push_frame()
                let v = self.owned(c.body)
                self.line(f"(({et} *){res}->data)[{k}++] = {v};")
                self.pop_frame()
                self.loop_close()
                return res
            case Some(flt):
                let init = self.new_arr(el, "0", loc)
                let res = self.decl_temp(e.ty, init)
                self.loop_open(dom, e.local)
                self.emit_filter(flt)
                self.push_frame()
                let v = self.owned(c.body)
                let t = self.fresh()
                self.line(f"{et} {t} = {v};")
                self.line(f"brine_arr_push(&{res}, &{t});")
                self.pop_frame()
                self.loop_close()
                return res

    fn reduce(ref self, r: Reducer, arg: Expr, e: Expr) -> str:
        match arg.kind:
            case ExprKind.Comp(c):
                if c.par:
                    return self.par_reduce(r, c, e, arg.local, arg.caps)
                let loc = self.loc(e.span)
                let (acc, has) = self.reduce_init(r, e.ty)
                let dom = self.domain(c.iter, false)
                self.loop_open(dom, arg.local)
                self.reduce_step(r, c, e.ty, acc, has, loc)
                self.loop_close()
                self.reduce_finish(r, has, loc)
                return acc
            case _:
                return "0"

    fn reduce_init(ref self, r: Reducer, ty: Ty) -> (str, str):
        let acc = self.fresh()
        let has = self.fresh()
        let ct = self.cty(ty)
        let zero = "0.0" if ty.is_float() else "0"
        let one = "1.0" if ty.is_float() else "1"
        var init = ""
        match r:
            case Reducer.Sum | Reducer.Min | Reducer.Max:
                init = "(" + ct + ")" + zero
            case Reducer.Product:
                init = "(" + ct + ")" + one
            case Reducer.Any:
                init = "false"
            case Reducer.All:
                init = "true"
        self.line(f"{ct} {acc} = {init};")
        self.line(f"bool {has} = false;")
        return (acc, has)

    fn reduce_step(ref self, r: Reducer, c: Comp, ty: Ty, acc: str, has: str, loc: str):
        match c.filter:
            case Some(f):
                self.emit_filter(f)
            case None:
                pass
        self.push_frame()
        let v0 = self.expr(c.body)
        let v = self.decl_scalar(c.body.ty, v0)
        self.pop_frame()
        match r:
            case Reducer.Sum:
                let s = self.arith(BinOp.Add, acc, v, ty, true, loc)
                self.line(f"{acc} = {s};")
            case Reducer.Product:
                let s = self.arith(BinOp.Mul, acc, v, ty, true, loc)
                self.line(f"{acc} = {s};")
            case Reducer.Min:
                self.line(f"if (!{has} || {v} < {acc}) {acc} = {v};")
            case Reducer.Max:
                self.line(f"if (!{has} || {v} > {acc}) {acc} = {v};")
            case Reducer.Any:
                self.line(f"if ({v}) \{ {acc} = true; {has} = true; break; \}")
            case Reducer.All:
                self.line(f"if (!{v}) \{ {acc} = false; {has} = true; break; \}")
        self.line(f"{has} = true;")

    fn reduce_finish(ref self, r: Reducer, has: str, loc: str):
        if r == Reducer.Min or r == Reducer.Max:
            let n = "min" if r == Reducer.Min else "max"
            self.line(f"if (!{has}) brine_panic_at({loc}, \"{n}() of an empty sequence\");")

    # ------------------------------------------------------------ parallel
    fn dom_fields(self, dom: Dom) -> [(str, str, Option[str])]:
        match dom:
            case Dom.Range(_, lo, _, _, step):
                var st = "1"
                match step:
                    case Some(s):
                        st = "(uint64_t)" + s
                    case None:
                        pass
                return [("uint64_t", "dlo", Some("(uint64_t)" + lo)), ("uint64_t", "dst", Some(st))]
            case Dom.Arr(arr, _):
                return [("brine_arr*", "darr", Some(arr))]

    fn dom_value(ref self, dom: Dom) -> (str, str):
        match dom:
            case Dom.Range(ty, _, _, _, _):
                let t = ty.c_type()
                return (t, "(" + t + ")(__ctx->dlo + (uint64_t)__k * __ctx->dst)")
            case Dom.Arr(_, elem):
                let et = self.cty(elem)
                return (et, "((" + et + " *)__ctx->darr->data)[__k]")

    # Emit the context struct for a lifted parallel body and initialize it.
    # Captured locals are copied by value: par bodies never assign them.
    fn par_ctx(ref self, captures: [int], extra: [(str, str, Option[str])]) -> (int, str):
        let id = self.nlift
        self.nlift += 1
        var def = "typedef struct {\n"
        var inits: [str] = []
        for c in captures:
            let t = self.flocals[c].ty
            let ct = self.cty(t)
            def += f"    {ct} c{c};\n"
            let lc = self.local_c(c)
            inits.push(f".c{c} = {lc}")
        for x in extra:
            def += f"    {x.0} {x.1};\n"
            match x.2:
                case Some(i):
                    inits.push(f".{x.1} = {i}")
                case None:
                    pass
        if len(captures) == 0 and len(extra) == 0:
            def += "    char _unused;\n"
        def += f"\} br_ctx_{id};\n"
        self.ctxdefs += def
        let cv = self.fresh()
        let init = "{0}" if len(inits) == 0 else "{" + ", ".join(inits) + "}"
        self.line(f"br_ctx_{id} {cv} = {init};")
        return (id, cv)

    fn lift_enter(ref self, header: str, id: int, captures: [int], par_writes: [int]) -> Ctx:
        let saved = self.cx
        self.cx = new_ctx()
        for w in par_writes:
            self.cx.par_writes[w] = true
        self.cx.out += header
        self.cx.out += " {\n"
        self.cx.ind = 1
        self.line(f"br_ctx_{id} *__ctx = (br_ctx_{id} *)__vctx;")
        for c in captures:
            let t = self.flocals[c].ty
            let ct = self.cty(t)
            let n = self.local_c(c)
            self.line(f"{ct} {n} = __ctx->c{c};")
        return saved

    fn lift_exit(ref self, saved: Ctx):
        self.cx.out += "}\n\n"
        let code = self.cx.out
        self.cx = saved
        self.lifted += code

    fn par_for(
        ref self,
        iter: Expr,
        local: int,
        captures: [int],
        par_writes: [int],
        body: Block,
        span: Span
    ):
        let loc = self.loc(span)
        self.line("{")
        self.cx.ind += 1
        self.push_scope()
        self.push_frame()
        let dom = self.domain(iter, true)
        self.pop_frame()
        let n = self.dom_count(dom, loc)
        for w in par_writes:
            let lv = self.local_c(w)
            self.line(f"brine_arr_unique(&({lv}));")
        let extra = self.dom_fields(dom)
        let (id, cv) = self.par_ctx(captures, extra)
        self.line(f"brine_par_run(0, {n}, brine_par_plan({n}), br_par_{id}, &{cv});")
        self.pop_scope()
        self.cx.ind -= 1
        self.line("}")

        let saved = self.lift_enter(chunk_header(id), id, captures, par_writes)
        self.line("(void)__chunk;")
        self.line("for (int64_t __k = __lo; __k < __hi; __k++) {")
        self.cx.ind += 1
        let (vt, vv) = self.dom_value(dom)
        let vn = self.local_c(local)
        self.line(f"{vt} {vn} = {vv};")
        let depth = len(self.cx.scopes)
        self.cx.loops.push(depth)
        self.block(body)
        self.cx.loops.pop()
        self.cx.ind -= 1
        self.line("}")
        self.lift_exit(saved)

    fn par_list(ref self, c: Comp, e: Expr) -> str:
        let loc = self.loc(e.span)
        let dom = self.domain(c.iter, false)
        let n = self.dom_count(dom, loc)
        let el = c.body.ty
        let init = self.new_arr(el, n, loc)
        let res = self.decl_temp(e.ty, init)
        var extra = self.dom_fields(dom)
        extra.push(("brine_arr*", "res", Some(res)))
        let (id, cv) = self.par_ctx(e.caps, extra)
        self.line(f"brine_par_run(0, {n}, brine_par_plan({n}), br_par_{id}, &{cv});")

        let saved = self.lift_enter(chunk_header(id), id, e.caps, [])
        self.line("(void)__chunk;")
        self.line("for (int64_t __k = __lo; __k < __hi; __k++) {")
        self.cx.ind += 1
        let (vt, vv) = self.dom_value(dom)
        let vn = self.local_c(e.local)
        self.line(f"{vt} {vn} = {vv};")
        self.push_frame()
        let v = self.owned(c.body)
        let et = self.cty(el)
        self.line(f"(({et} *)__ctx->res->data)[__k] = {v};")
        self.pop_frame()
        self.cx.ind -= 1
        self.line("}")
        self.lift_exit(saved)
        return res

    # `local` and `captures` are the comprehension's loop variable and captured locals.
    fn par_reduce(ref self, r: Reducer, c: Comp, e: Expr, local: int, captures: [int]) -> str:
        let loc = self.loc(e.span)
        let ty = e.ty
        let ct = self.cty(ty)
        let dom = self.domain(c.iter, false)
        let n = self.dom_count(dom, loc)
        let nc = self.decl_scalar(int_ty(), f"brine_par_plan({n})")
        let parts = self.fresh()
        let hasv = self.fresh()
        self.line(f"{ct} *{parts} = ({ct} *)brine_alloc({nc} * (int64_t)sizeof({ct}));")
        self.line(f"bool *{hasv} = (bool *)brine_alloc({nc});")
        var extra = self.dom_fields(dom)
        extra.push((ct + " *", "parts", Some(parts)))
        extra.push(("bool *", "has", Some(hasv)))
        let (id, cv) = self.par_ctx(captures, extra)
        self.line(f"brine_par_run(0, {n}, {nc}, br_par_{id}, &{cv});")
        let (acc, has) = self.reduce_init(r, ty)
        let k = self.fresh()
        self.line(f"for (int64_t {k} = 0; {k} < {nc}; {k}++) \{")
        self.cx.ind += 1
        self.line(f"if (!{hasv}[{k}]) continue;")
        let p = f"{parts}[{k}]"
        match r:
            case Reducer.Sum:
                let s = self.arith(BinOp.Add, acc, p, ty, true, loc)
                self.line(f"{acc} = {s};")
            case Reducer.Product:
                let s = self.arith(BinOp.Mul, acc, p, ty, true, loc)
                self.line(f"{acc} = {s};")
            case Reducer.Min:
                self.line(f"if (!{has} || {p} < {acc}) {acc} = {p};")
            case Reducer.Max:
                self.line(f"if (!{has} || {p} > {acc}) {acc} = {p};")
            case Reducer.Any:
                self.line(f"{acc} = {acc} || {p};")
            case Reducer.All:
                self.line(f"{acc} = {acc} && {p};")
        self.line(f"{has} = true;")
        self.cx.ind -= 1
        self.line("}")
        self.line(f"brine_free({parts}); brine_free({hasv});")
        self.reduce_finish(r, has, loc)

        let saved = self.lift_enter(chunk_header(id), id, captures, [])
        let (a2, h2) = self.reduce_init(r, ty)
        self.line("for (int64_t __k = __lo; __k < __hi; __k++) {")
        self.cx.ind += 1
        let (vt, vv) = self.dom_value(dom)
        let vn = self.local_c(local)
        self.line(f"{vt} {vn} = {vv};")
        self.reduce_step(r, c, ty, a2, h2, loc)
        self.cx.ind -= 1
        self.line("}")
        self.line(f"__ctx->parts[__chunk] = {a2}; __ctx->has[__chunk] = {h2};")
        self.lift_exit(saved)
        return acc

    fn par_tuple(ref self, elems: [Expr], captures: [int], e: Expr) -> str:
        var extra: [(str, str, Option[str])] = []
        for i, x in enumerate(elems):
            let ct = self.cty(x.ty)
            extra.push((ct, f"r{i}", None))
        let (id, cv) = self.par_ctx(captures, extra)
        self.line(f"brine_par_tasks({len(elems)}, br_task_{id}, &{cv});")
        let init = "{" + ", ".join([f"{cv}.r{i}" for i in 0..len(elems)]) + "}"
        let res = self.decl_temp(e.ty, init)

        let header = f"static void br_task_{id}(void *__vctx, int64_t __idx)"
        let saved = self.lift_enter(header, id, captures, [])
        self.line("switch (__idx) {")
        for i, x in enumerate(elems):
            self.line(f"case {i}: \{")
            self.cx.ind += 1
            self.push_frame()
            let v = self.owned(x)
            self.line(f"__ctx->r{i} = {v};")
            self.pop_frame()
            self.line("break;")
            self.cx.ind -= 1
            self.line("}")
        self.line("}")
        self.lift_exit(saved)
        return res

# `need_fmt`'s literal-append line.
fn fmt_lit(s: str) -> str:
    return f"    brine_sb_cat(sb, \"{c_escape(s)}\", {len(s)});\n"

# The repr of a finite f64 (as Rust's `{:?}` prints it): the shortest round-trip digits, scientific
# when the magnitude is below 1e-4 or at least 1e16 (`1e300`, `1.5e-7`),
# otherwise plain with at least one decimal (`1.0`). brine's own formatting
# picks the same digits and the same cut-offs, but writes the exponent C's
# way (`1e+300`, `1.5e-07`), so only that part is rewritten.
fn f64_repr(v: float) -> str:
    let s = f"{v}"
    var k = 0
    match s.find("e"):
        case Some(i):
            k = i
        case None:
            return s
    let mant = s[:k]
    var ex = s[k + 1:]
    var neg = false
    if ex.starts_with("+"):
        ex = ex[1:]
    elif ex.starts_with("-"):
        neg = true
        ex = ex[1:]
    while len(ex) > 1 and ex.starts_with("0"):
        ex = ex[1:]
    return mant + "e" + ("-" if neg else "") + ex

# The enum id of an enum type (0 for anything else).
fn cg_enum_id(t: Ty) -> int:
    match t:
        case Ty.Enum(x):
            return x
        case _:
            return 0

# Suffix of the runtime's `world` function for values of type `t`.
fn world_suffix(t: Ty) -> str:
    match t:
        case Ty.Int(_):
            return "i64"
        case Ty.Float(_):
            return "f64"
        case Ty.Bool:
            return "bool"
        case Ty.Str:
            return "str"
        case _:
            return "arr"

# message type description understood by the runtime's encoder
fn world_desc(t: Ty) -> str:
    match t:
        case Ty.Int(_):
            return "i"
        case Ty.Float(_):
            return "f"
        case Ty.Bool:
            return "b"
        case Ty.Str:
            return "s"
        case Ty.Array(e):
            return "a" + world_desc(e)
        case _:
            return "?"

fn chunk_header(id: int) -> str:
    return f"static void br_par_{id}(void *__vctx, int64_t __chunk, int64_t __lo, int64_t __hi)"
