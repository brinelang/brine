# The verifier: symbolic execution of every function body.
#
# * Explicit obligations (`requires` at call sites, `ensures` at returns,
#   loop `invariant`s, `prove`) must be proven or compilation fails.
# * Implicit obligations (array bounds, overflow, division by zero) are
#   proven when possible; proven checks are removed from the generated code,
#   the rest stay as runtime checks (they can never be turned off).
#
# Soundness: integers are modelled exactly (overflow traps, so any reached
# state has exact values). Anything the verifier can't model becomes a fresh
# unknown, and loops havoc every variable they modify. A fact is only assumed
# when it has been proven or is enforced by a runtime check.
from diag import Span, Diag, SourceMap
import diag
from types import Ty, IntTy, Res, CallRes, Builtin, NumM, StrM, Reducer, WorldOp, LocalInfo, int_ty
from ast import BinOp, CmpOp, UnOp, FSeg, Arg, Comp, Expr, ExprKind, LetPat, Pattern, PatKind, Case, Stmt, StmtKind, Block, FnDecl, Program
from ast import children, stmt_exprs, stmt_blocks, lvalue_root
from info import ProgramInfo, ConstVal
from solver import Lin, F, AtomSet, prove_, prove_full, counterexample, GAVE_UP, wrapping_abs, wrapping_neg, add_i128, mul_i128, neg_i128, ATOM_UNKNOWN, I64_BOUND

struct Report:
    diags: [Diag]
    # implicit checks that remain at runtime: (span, what)
    remaining: [(Span, str)]
    # implicit checks proven and removed
    proven: int

enum V:
    Int(l: Lin)
    Bool(f: F)
    Arr(c: int, len: Lin)
    Str(len: Lin)
    Agg(vs: [V])
    Opaque

enum Term:
    Sel(c: int, i: Lin)
    SelB(c: int, i: Lin)
    Mul(a: Lin, b: Lin)
    Div(a: Lin, b: Lin)
    Mod(a: Lin, b: Lin)
    Rank
    Size

struct St:
    env: {int: V}
    facts: [F]

struct LoopCx:
    invs: [Expr]
    # for range loops: (loop var, value it has in the next iteration)
    next: Option[(int, V)]
    breaks: [St]

# The state before code that runs on some paths only: its facts (`k` of
# them) and the number of atoms then (`na`; later ones are new).
struct Fork:
    base: St
    k: int
    na: int

# The facts added since `fk` that mention an atom created since.
fn new_facts(facts: [F], fk: Fork) -> [F]:
    var out: [F] = []
    for i in fk.k..len(facts):
        var s = AtomSet.new()
        facts[i].atoms(ref s)
        if any(a >= fk.na and a != ATOM_UNKNOWN for a in s.xs):
            out.push(facts[i])
    return out

struct FnSpec:
    name: str
    params: [int]
    requires: [Expr]
    ensures: [Expr]
    result: Option[int]

const TAG_ARITH = 0
# Largest disjunction (in formula nodes) a merge of two branches keeps. Past
# that the solver spends its time re-reading it; dropping it only loses facts.
const MERGE_MAX = 256
const TAG_INDEX = 1
const TAG_ASSERT = 2
# the overflow check of a compound assignment (`x += 1`), keyed by the statement
const TAG_COMPOUND = 3

fn key(span: Span, tag: int) -> (int, int, int, int):
    return (span.file, span.lo, span.hi, tag)

fn verify_program(ref prog: Program, info: ProgramInfo, sm: SourceMap) -> Report:
    var specs: [Option[FnSpec]] = [None] * len(info.fns)
    for m in prog.modules:
        for f in m.fns:
            if 0 <= f.id < len(specs):
                specs[f.id] = Some(
                    FnSpec(
                        name=f.name,
                        params=f.param_locals,
                        requires=f.requires,
                        ensures=f.ensures,
                        result=f.result_local
                    )
                )
    # functions are proven independently, so in parallel; the results are
    # applied in order, which keeps the output deterministic
    var fns: [FnDecl] = []
    for m in prog.modules:
        fns.extend(m.fns)
        fns.extend(m.tests)
    let fps = footprints(prog, info)
    let done = par [verify_fn(info, specs, fps, sm, f) for f in fns]
    # let go of the bodies, so rewriting them below doesn't copy them
    fns = []
    var report = Report(diags=[], remaining=[], proven=0)
    # `BRINE_TIMES=2`: the functions that take the prover long
    let slow_fns = getenv("BRINE_TIMES") == Some("2")
    var at = 0
    for mi in 0..len(prog.modules):
        let nf = len(prog.modules[mi].fns)
        let nt = len(prog.modules[mi].tests)
        for k in 0..nf + nt:
            let r = done[at]
            at += 1
            if slow_fns and r.time > 0.02:
                eprint(f"  verify {r.name}: {r.time:.3f}s")
            report.diags.extend(r.diags)
            report.remaining.extend(r.remaining)
            report.proven += len(r.proven)
            if len(r.proven) == 0:
                continue
            if k < nf:
                apply_block(ref prog.modules[mi].fns[k].body, r.proven)
            else:
                apply_block(ref prog.modules[mi].tests[k - nf].body, r.proven)
    # by position (stable), then without repeats
    var keys: [(int, int, int)] = []
    for i, r in enumerate(report.remaining):
        keys.push((r.0.file, r.0.lo, i))
    let order = sort_keys(keys)
    var out: [(Span, str)] = []
    for i in order:
        let r = report.remaining[i]
        if len(out) > 0:
            let p = out[len(out) - 1].0
            if p.file == r.0.file and p.lo == r.0.lo and p.hi == r.0.hi:
                continue
        out.push(r)
    report.remaining = out
    return report

struct FnResult:
    name: str
    diags: [Diag]
    remaining: [(Span, str)]
    # the checks proven everywhere they're reached
    proven: {(int, int, int, int): bool}
    time: float

fn verify_fn(
    info: ProgramInfo,
    specs: [Option[FnSpec]],
    fps: [[[[int]]]],
    sm: SourceMap,
    f: FnDecl
) -> FnResult:
    let t0 = clock()
    if f.is_extern:
        return FnResult(name=f.name, diags=[], remaining=[], proven={}, time=0.0)
    var v = new_vf(info, specs, fps, sm, f)
    v.run(f)
    var proven: {(int, int, int, int): bool} = {}
    for p in v.proven.keys():
        if p not in v.failed:
            proven[p] = true
    return FnResult(
        name=f.name,
        diags=v.diags,
        remaining=v.remaining,
        proven=proven,
        time=clock() - t0
    )

fn key_lt(a: (int, int, int), b: (int, int, int)) -> bool:
    if a.0 != b.0:
        return a.0 < b.0
    if a.1 != b.1:
        return a.1 < b.1
    return a.2 < b.2

# Indices of `keys` in sorted order (the last component breaks ties).
fn sort_keys(keys: [(int, int, int)]) -> [int]:
    return msort(keys, [i for i in 0..len(keys)])

fn msort(keys: [(int, int, int)], idx: [int]) -> [int]:
    if len(idx) <= 1:
        return idx
    let mid = len(idx) / 2
    let l = msort(keys, idx[:mid])
    let r = msort(keys, idx[mid:])
    var out: [int] = []
    var i = 0
    var j = 0
    while i < len(l) and j < len(r):
        if key_lt(keys[r[j]], keys[l[i]]):
            out.push(r[j])
            j += 1
        else:
            out.push(l[i])
            i += 1
    out.extend(l[i:])
    out.extend(r[j:])
    return out

# ================================================================ applying results

fn apply_block(ref b: Block, p: {(int, int, int, int): bool}):
    for i in 0..len(b.stmts):
        apply_stmt(ref b.stmts[i], p)

fn apply_opt(ref x: Option[Expr], p: {(int, int, int, int): bool}):
    match x:
        case Some(e):
            var e2 = e
            apply_expr(ref e2, p)
            x = Some(e2)
        case None:
            pass

fn apply_stmt(ref s: Stmt, p: {(int, int, int, int): bool}):
    match s.kind:
        case StmtKind.Let(mutable, pat, ty, init, is_ref):
            var x = init
            apply_expr(ref x, p)
            s.kind = StmtKind.Let(mutable, pat, ty, x, is_ref)
        case StmtKind.Assign(target, op, value):
            var t = target
            var v = value
            apply_expr(ref t, p)
            apply_expr(ref v, p)
            s.kind = StmtKind.Assign(t, op, v)
            if key(s.span, TAG_COMPOUND) in p:
                s.proven = true
        case StmtKind.ExprStmt(e):
            var x = e
            apply_expr(ref x, p)
            s.kind = StmtKind.ExprStmt(x)
        case StmtKind.Prove(e):
            var x = e
            apply_expr(ref x, p)
            s.kind = StmtKind.Prove(x)
        case StmtKind.Contract(k, e):
            var x = e
            apply_expr(ref x, p)
            s.kind = StmtKind.Contract(k, x)
        case StmtKind.Return(e):
            var x = e
            apply_opt(ref x, p)
            s.kind = StmtKind.Return(x)
        case StmtKind.Assert(cond, msg):
            var c = cond
            var m = msg
            apply_expr(ref c, p)
            apply_opt(ref m, p)
            s.kind = StmtKind.Assert(c, m)
            if key(s.span, TAG_ASSERT) in p:
                s.proven = true
        case StmtKind.If(branches, els):
            var bs = branches
            for i in 0..len(bs):
                apply_expr(ref bs[i].0, p)
                apply_block(ref bs[i].1, p)
            var e = els
            match e:
                case Some(b):
                    var b2 = b
                    apply_block(ref b2, p)
                    e = Some(b2)
                case None:
                    pass
            s.kind = StmtKind.If(bs, e)
        case StmtKind.While(cond, invs, body):
            var c = cond
            var b = body
            apply_expr(ref c, p)
            apply_block(ref b, p)
            s.kind = StmtKind.While(c, invs, b)
        case StmtKind.For(name, name_span, ty, iter, invs, body, is_par):
            var it = iter
            var b = body
            apply_expr(ref it, p)
            apply_block(ref b, p)
            s.kind = StmtKind.For(name, name_span, ty, it, invs, b, is_par)
        case StmtKind.Match(scrut, cases):
            var sc = scrut
            apply_expr(ref sc, p)
            var cs = cases
            for i in 0..len(cs):
                apply_opt(ref cs[i].guard, p)
                apply_block(ref cs[i].body, p)
            s.kind = StmtKind.Match(sc, cs)
        case _:
            pass

fn apply_exprs(ref xs: [Expr], p: {(int, int, int, int): bool}):
    for i in 0..len(xs):
        apply_expr(ref xs[i], p)

fn apply_args(ref args: [Arg], p: {(int, int, int, int): bool}):
    for i in 0..len(args):
        apply_expr(ref args[i].expr, p)

fn apply_expr(ref e: Expr, p: {(int, int, int, int): bool}):
    let span = e.span
    match e.kind:
        case ExprKind.Binary(op, l, r):
            if key(span, TAG_ARITH) in p:
                e.checked = false
            var a = l
            var b = r
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Binary(op, a, b)
        case ExprKind.Index(b, idx):
            if key(span, TAG_INDEX) in p:
                e.checked = false
            var x = b
            var i = idx
            apply_expr(ref x, p)
            apply_expr(ref i, p)
            e.kind = ExprKind.Index(x, i)
        case ExprKind.FStr(segs):
            var ss = segs
            for i in 0..len(ss):
                match ss[i]:
                    case FSeg.Part(x, spec):
                        var x2 = x
                        apply_expr(ref x2, p)
                        ss[i] = FSeg.Part(x2, spec)
                    case _:
                        pass
            e.kind = ExprKind.FStr(ss)
        case ExprKind.Unary(op, x):
            var x2 = x
            apply_expr(ref x2, p)
            e.kind = ExprKind.Unary(op, x2)
        case ExprKind.Field(x, name, ns):
            var x2 = x
            apply_expr(ref x2, p)
            e.kind = ExprKind.Field(x2, name, ns)
        case ExprKind.Try(x):
            var x2 = x
            apply_expr(ref x2, p)
            e.kind = ExprKind.Try(x2)
        case ExprKind.Compare(first, rest):
            var f = first
            apply_expr(ref f, p)
            var rs = rest
            for i in 0..len(rs):
                apply_expr(ref rs[i].1, p)
            e.kind = ExprKind.Compare(f, rs)
        case ExprKind.IfElse(cond, then, els):
            var c = cond
            var t = then
            var f = els
            apply_expr(ref c, p)
            apply_expr(ref t, p)
            apply_expr(ref f, p)
            e.kind = ExprKind.IfElse(c, t, f)
        case ExprKind.Call(callee, args):
            var c = callee
            var a = args
            apply_expr(ref c, p)
            apply_args(ref a, p)
            e.kind = ExprKind.Call(c, a)
        case ExprKind.MethodCall(recv, name, ns, args):
            var r = recv
            var a = args
            apply_expr(ref r, p)
            apply_args(ref a, p)
            e.kind = ExprKind.MethodCall(r, name, ns, a)
        case ExprKind.Array(xs):
            var ys = xs
            apply_exprs(ref ys, p)
            e.kind = ExprKind.Array(ys)
        case ExprKind.Tuple(xs):
            var ys = xs
            apply_exprs(ref ys, p)
            e.kind = ExprKind.Tuple(ys)
        case ExprKind.ParTuple(xs):
            var ys = xs
            apply_exprs(ref ys, p)
            e.kind = ExprKind.ParTuple(ys)
        case ExprKind.Repeat(elem, count):
            var a = elem
            var b = count
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Repeat(a, b)
        case ExprKind.Contains(item, coll, neg):
            var a = item
            var b = coll
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Contains(a, b, neg)
        case ExprKind.Map(kvs):
            var ys = kvs
            for i in 0..len(ys):
                apply_expr(ref ys[i].0, p)
                apply_expr(ref ys[i].1, p)
            e.kind = ExprKind.Map(ys)
        case ExprKind.Slice(b, lo, hi):
            if key(span, TAG_INDEX) in p:
                e.checked = false
            var x = b
            var l = lo
            var h = hi
            apply_expr(ref x, p)
            apply_opt(ref l, p)
            apply_opt(ref h, p)
            e.kind = ExprKind.Slice(x, l, h)
        case ExprKind.Range(lo, hi, inclusive):
            var a = lo
            var b = hi
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Range(a, b, inclusive)
        case ExprKind.Comp(c):
            var c2 = c
            apply_expr(ref c2.iter, p)
            apply_opt(ref c2.filter, p)
            apply_expr(ref c2.body, p)
            e.kind = ExprKind.Comp(c2)
        case _:
            pass

# ================================================================ modification analysis

# What a statement may change in a local: a path of field indices from the
# local down, ending in CONTENT at the first index (the elements of the array
# there, not its length). [] is the whole local.
const CONTENT = -1
# a longer path is cut short: changing its start covers the rest
const PATH_MAX = 8

# A change found in code: `root` at `path`, directly (callee < 0) or as the
# `ref` parameter `param` of the function `callee`, which may change what its
# footprint says.
struct Eff:
    root: int
    path: [int]
    callee: int
    param: int

# Whole: the variable may change. (For analyses that only ask whether.)
const MOD_WHOLE = 0

fn note_mod(ref out: {int: int}, id: int, m: int):
    out[id] = m

# The path from an lvalue's root local down to it.
fn lvalue_steps(e: Expr) -> [int]:
    var p: [int] = []
    match e.kind:
        case ExprKind.Field(x, _, _):
            p = lvalue_steps(x)
            if not ends_in_content(p) and e.idx >= 0:
                p.push(e.idx)
        case ExprKind.Index(x, _):
            p = lvalue_steps(x)
            if not ends_in_content(p):
                p.push(CONTENT)
        case _:
            pass
    if len(p) > PATH_MAX:
        return p[:PATH_MAX]
    return p

fn ends_in_content(p: [int]) -> bool:
    return len(p) > 0 and p[len(p) - 1] == CONTENT

# `p` then, below it, `q` (below an array's elements everything is content).
fn join_path(p: [int], q: [int]) -> [int]:
    if ends_in_content(p):
        return p
    var out = p
    out.extend(q)
    if len(out) > PATH_MAX:
        return out[:PATH_MAX]
    return out

fn is_prefix(p: [int], q: [int]) -> bool:
    if len(p) > len(q):
        return false
    for i in 0..len(p):
        if p[i] != q[i]:
            return false
    return true

# Add `p` to the paths of `id` that may change, keeping only the shortest.
fn note_path(ref out: {int: [[int]]}, id: int, p: [int]):
    let ps = out.get(id).unwrap_or([])
    for q in ps:
        if is_prefix(q, p):
            return
    var keep: [[int]] = [q2 for q2 in ps if not is_prefix(p, q2)]
    keep.push(p)
    out[id] = keep

fn same_paths(a: [[int]], b: [[int]]) -> bool:
    return len(a) == len(b) and all(p in b for p in a)

fn arg_eff(e: Expr, callee: int, param: int, ref out: [Eff]):
    match lvalue_root(e):
        case Some(r):
            out.push(Eff(root=r, path=lvalue_steps(e), callee=callee, param=param))
        case None:
            pass

fn effs_expr(e: Expr, info: ProgramInfo, ref out: [Eff]):
    match e.kind:
        case ExprKind.MethodCall(recv, _, _, args):
            var callee = -1
            match e.cres:
                case CallRes.Builtin(b):
                    if b.mutates_recv():
                        arg_eff(recv, -1, 0, ref out)
                case CallRes.Method(id):
                    if 0 <= id < len(info.fns) and len(info.fns[id].params) > 0:
                        callee = id
                        if info.fns[id].params[0].by_ref:
                            arg_eff(recv, id, 0, ref out)
                case _:
                    pass
            for i, a in enumerate(args):
                if a.by_ref:
                    arg_eff(a.expr, callee, i + 1 if callee >= 0 else 0, ref out)
        case ExprKind.Call(_, args):
            var callee = -1
            match e.cres:
                case CallRes.Fn(id):
                    callee = id
                case _:
                    pass
            for i, a in enumerate(args):
                if a.by_ref:
                    arg_eff(a.expr, callee, i, ref out)
        case _:
            pass
    for c in children(e):
        effs_expr(c, info, ref out)

fn effs_block(b: Block, info: ProgramInfo, ref out: [Eff]):
    for s in b.stmts:
        match s.kind:
            case StmtKind.Assign(target, _, _):
                arg_eff(target, -1, 0, ref out)
            case _:
                pass
        for e in stmt_exprs(s):
            effs_expr(e, info, ref out)
        for blk in stmt_blocks(s):
            effs_block(blk, info, ref out)

# The locals a block may change (for analyses that only ask which).
fn mods_block(b: Block, info: ProgramInfo, ref out: {int: int}):
    var effs: [Eff] = []
    effs_block(b, info, ref effs)
    for f in effs:
        note_mod(ref out, f.root, MOD_WHOLE)

# The locals `e` may change (for analyses that only ask which).
fn mods_expr(e: Expr, info: ProgramInfo, ref out: {int: int}):
    var effs: [Eff] = []
    effs_expr(e, info, ref effs)
    for f in effs:
        note_mod(ref out, f.root, MOD_WHOLE)

# What the parameter `param` of `id` may change in the caller's variable
# (everything, unless its body was looked at).
fn footprint(fps: [[[[int]]]], id: int, param: int) -> [[int]]:
    if 0 <= id < len(fps) and 0 <= param < len(fps[id]):
        return fps[id][param]
    return [[]]

# The paths `effs` may change, by local.
fn resolve_effs(effs: [Eff], fps: [[[[int]]]]) -> {int: [[int]]}:
    var out: {int: [[int]]} = {}
    for f in effs:
        if f.callee < 0:
            note_path(ref out, f.root, f.path)
        else:
            for q in footprint(fps, f.callee, f.param):
                note_path(ref out, f.root, join_path(f.path, q))
    return out

# Each function's footprint: for each `ref` parameter, what the function may
# change in it, directly or through the functions it calls. The least
# solution, found by iterating from nothing: every change happens through a
# finite chain of calls, and the paths are finitely many (field indices,
# cut at PATH_MAX). Functions without a body change all of their `ref`
# parameters.
fn footprints(prog: Program, info: ProgramInfo) -> [[[[int]]]]:
    let n = len(info.fns)
    var fps: [[[[int]]]] = []
    for i in 0..n:
        var ps: [[[int]]] = []
        for p in info.fns[i].params:
            ps.push([[]])
        fps.push(ps)
    var ids: [int] = []
    var locals: [[int]] = []
    var effs: [[Eff]] = []
    for m in prog.modules:
        for f in m.fns:
            if (
                f.is_extern
                or not (0 <= f.id < n)
                or len(f.param_locals) != len(info.fns[f.id].params)
            ):
                continue
            var es: [Eff] = []
            effs_block(f.body, info, ref es)
            for j, p in enumerate(info.fns[f.id].params):
                if p.by_ref:
                    fps[f.id][j] = []
            ids.push(f.id)
            locals.push(f.param_locals)
            effs.push(es)
    var changed = true
    var rounds = 0
    while changed:
        changed = false
        rounds += 1
        if rounds > 100:
            # not expected (the paths are finitely many); stay safe
            for id in ids:
                for j in 0..len(fps[id]):
                    fps[id][j] = [[]]
            break
        for k, id in enumerate(ids):
            let got = resolve_effs(effs[k], fps)
            for j, p in enumerate(info.fns[id].params):
                if p.by_ref:
                    let ps = got.get(locals[k][j]).unwrap_or([])
                    if not same_paths(ps, fps[id][j]):
                        fps[id][j] = ps
                        changed = true
    return fps

# Counters: the locals a loop body changes only by one `x += 1` outside its
# inner loops. Each iteration adds at most 1 to them, so at the start of the
# iteration `k` of `for k in lo..hi`, `x0 <= x <= x0 + (k - lo)`.
fn counters(b: Block, info: ProgramInfo) -> [int]:
    var incs: {int: int} = {}
    var other: {int: int} = {}
    count_incs(b, info, 0, ref incs, ref other)
    var out: [int] = []
    for id in incs:
        if incs[id] == 1 and id not in other:
            out.push(id)
    out.sort()
    return out

fn count_incs(b: Block, info: ProgramInfo, depth: int, ref incs: {int: int}, ref other: {int: int}):
    for s in b.stmts:
        var inner = depth
        match s.kind:
            case StmtKind.Assign(target, op, value):
                match lvalue_root(target):
                    case Some(r):
                        var inc = false
                        match (target.kind, op, value.kind):
                            case (ExprKind.Ident(_), Some(BinOp.Add), ExprKind.Int(v)):
                                inc = v == 1 and depth == 0
                            case _:
                                pass
                        if inc:
                            incs[r] = incs.get(r).unwrap_or(0) + 1
                        else:
                            note_mod(ref other, r, MOD_WHOLE)
                    case None:
                        pass
            case StmtKind.While(_, _, _) | StmtKind.For(_, _, _, _, _, _, _):
                inner = depth + 1
            case _:
                pass
        for e in stmt_exprs(s):
            mods_expr(e, info, ref other)
        for blk in stmt_blocks(s):
            count_incs(blk, info, inner, ref incs, ref other)

# Does evaluating `e` have no observable effects (so a proven `assert` can be removed)?
fn pure_expr(e: Expr) -> bool:
    var ok = true
    match e.kind:
        case ExprKind.Call(_, _) | ExprKind.MethodCall(_, _, _, _):
            match e.cres:
                case CallRes.Builtin(Builtin.Len) | CallRes.Builtin(
                    Builtin.Abs
                ) | CallRes.Builtin(Builtin.Min) | CallRes.Builtin(Builtin.Max):
                    ok = true
                case CallRes.Convert(_) | CallRes.Reduce(_):
                    ok = true
                case _:
                    ok = false
        case ExprKind.Comp(c):
            ok = not c.par
        case _:
            pass
    if not ok:
        return false
    for c in children(e):
        if not pure_expr(c):
            return false
    return true

# ================================================================ helpers

fn in_range(l: Lin, k: IntTy) -> F:
    if k.bits() == 128:
        # unknown: never proven, and dropped as a fact (see `int_range`)
        return F.B(ATOM_UNKNOWN, true)
    return F.and_([F.le(Lin.konst(k.min()), l), F.le(l, Lin.konst(k.max()))])

# The value range of `k` as known facts. The prover's arithmetic is 128-bit,
# too small to reason near the limits of `i128` and `u128`: it only knows
# that a `u128` isn't negative (the solver drops bounds at i128's edges),
# and leaves their overflow checks to run time.
fn int_range(k: IntTy) -> Option[(i128, i128)]:
    return Some((k.min(), k.max()))

# No array, string or map is longer than 2^60: every element takes at least a
# bit (a `[bool]`; anything else a byte), and no address space has 2^57 bytes.
const LEN_MAX: i128 = 1152921504606846976

fn nonneg_range() -> Option[(i128, i128)]:
    let z: i128 = 0
    return Some((z, I64_BOUND))

fn pos_range() -> Option[(i128, i128)]:
    let one: i128 = 1
    return Some((one, I64_BOUND))

# An ordering of `Lin`: by constant, then terms lexicographically.
fn lin_le(a: Lin, b: Lin) -> bool:
    if a.c != b.c:
        return a.c < b.c
    for i in 0..min(len(a.t), len(b.t)):
        if a.t[i].0 != b.t[i].0:
            return a.t[i].0 < b.t[i].0
        if a.t[i].1 != b.t[i].1:
            return a.t[i].1 < b.t[i].1
    return len(a.t) <= len(b.t)

fn lin_key(l: Lin) -> str:
    var s = f"{l.c}"
    for a, k in l.t:
        s += f";{a}*{k}"
    return s

fn term_key(t: Term) -> str:
    match t:
        case Term.Sel(c, i):
            return f"S{c}|" + lin_key(i)
        case Term.SelB(c, i):
            return f"B{c}|" + lin_key(i)
        case Term.Mul(a, b):
            return "M" + lin_key(a) + "|" + lin_key(b)
        case Term.Div(a, b):
            return "D" + lin_key(a) + "|" + lin_key(b)
        case Term.Mod(a, b):
            return "R" + lin_key(a) + "|" + lin_key(b)
        case Term.Rank:
            return "rank"
        case Term.Size:
            return "size"

# Facts with enormous constants are type-range bookkeeping; not worth showing.
fn huge(f: F) -> bool:
    let lim: i128 = 1 << 40
    match f:
        case F.Ge(l):
            return wrapping_abs(l.c) > lim
        case F.Eq(l):
            return wrapping_abs(l.c) > lim
        case F.Ne(l):
            return wrapping_abs(l.c) > lim
        case F.And(xs):
            return any(huge(x) for x in xs)
        case F.Or(xs):
            return any(huge(x) for x in xs)
        case _:
            return false

fn bool_eq(a: F, b: F) -> F:
    return F.or_([F.and_([a, b]), F.and_([a.not_(), b.not_()])])

fn split_ws(s: str) -> str:
    var parts: [str] = []
    var cur = ""
    for c in s.chars():
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == "\u{b}" or c == "\u{c}":
            if cur != "":
                parts.push(cur)
                cur = ""
        else:
            cur += c
    if cur != "":
        parts.push(cur)
    return " ".join(parts)

enum Step:
    Field(k: int)
    Index(i: Lin)

# the iteration domain of a `for` loop
enum D:
    Range(lo: Lin, hi: Lin, incl: bool)
    Stepped(lo: Lin, hi: Lin, step: Option[i128])
    Arr(c: int, len: Lin, elem: Ty)
    Other

# ================================================================ the symbolic executor

fn new_vf(
    info: ProgramInfo,
    specs: [Option[FnSpec]],
    fps: [[[[int]]]],
    sm: SourceMap,
    f: FnDecl
) -> Vf:
    return Vf(
        info=info,
        specs=specs,
        fps=fps,
        sm=sm,
        locals=f.locals,
        fn_name=f.name,
        ensures=f.ensures,
        result_local=f.result_local,
        atom_names=[],
        ranges=[],
        terms={},
        content_names=[],
        content_ranges=[],
        looped={},
        defs=[],
        st=St(env={}, facts=[]),
        live=false,
        loops=[],
        spec=false,
        alt_env=None,
        proven={},
        failed={},
        remaining=[],
        diags=[]
    )

struct Vf:
    info: ProgramInfo
    specs: [Option[FnSpec]]
    # what each function may change in its `ref` parameters (see `footprints`)
    fps: [[[[int]]]]
    sm: SourceMap
    locals: [LocalInfo]
    fn_name: str
    ensures: [Expr]
    result_local: Option[int]
    # per atom: its name (for messages) and value range
    atom_names: [str]
    ranges: [Option[(i128, i128)]]
    terms: {str: int}
    content_names: [str]
    # the range of every element of a content, when known (from a literal)
    content_ranges: [Option[(i128, i128)]]
    # the atoms a loop made for what it changes (for messages)
    looped: {int: bool}
    defs: [F]
    # the current state; `live` is false where execution can't reach
    st: St
    live: bool
    loops: [LoopCx]
    spec: bool
    alt_env: Option[{int: V}]
    proven: {(int, int, int, int): bool}
    failed: {(int, int, int, int): bool}
    remaining: [(Span, str)]
    diags: [Diag]

    # The state, leaving none behind.
    fn take(ref self) -> Option[St]:
        if not self.live:
            return None
        self.live = false
        return Some(self.st)

    fn put(ref self, s: Option[St]):
        match s:
            case Some(x):
                self.st = x
                self.live = true
            case None:
                self.live = false

    fn cur(self) -> Option[St]:
        return Some(self.st) if self.live else None

    fn local_name(self, id: int) -> str:
        return self.locals[id].name if 0 <= id < len(self.locals) else ""

    fn local_ty(self, id: int) -> Ty:
        return self.locals[id].ty if 0 <= id < len(self.locals) else Ty.Unknown

    fn run(ref self, f: FnDecl):
        var env: {int: V} = {}
        for i, id in enumerate(f.param_locals):
            let li = self.locals[id]
            let name = "old(" + f.params[i].name + ")" if f.params[i].mutable else f.params[i].name
            let v = self.fresh_val(li.ty, name)
            env[id] = v
        self.put(Some(St(env=env, facts=[])))
        for r in f.requires:
            let c = self.spec_cond(r)
            self.assume(c)
        self.block(f.body)
        if self.live:
            let end = Span(file=f.span.file, lo=f.span.hi, hi=f.span.hi)
            self.check_ensures(None, end)

    # ------------------------------------------------------------ atoms
    fn new_atom(ref self, name: str, range: Option[(i128, i128)]) -> int:
        self.atom_names.push(name)
        self.ranges.push(range)
        return len(self.atom_names) - 1

    fn fresh_int(ref self, name: str, k: IntTy) -> Lin:
        return Lin.atom(self.new_atom(name, int_range(k)))

    fn fresh_nonneg(ref self, name: str) -> Lin:
        return Lin.atom(self.new_atom(name, nonneg_range()))

    fn fresh_len(ref self, name: str) -> Lin:
        let z: i128 = 0
        return Lin.atom(self.new_atom(name, Some((z, LEN_MAX))))

    # A length an operation just produced: the memory for it was allocated.
    fn cap_len(ref self, l: Lin):
        self.assume(F.le(l, Lin.konst(LEN_MAX)))

    fn fresh_bool(ref self, name: str) -> F:
        return F.B(self.new_atom(name, None), true)

    fn fresh_content(ref self, name: str) -> int:
        self.content_names.push(name)
        self.content_ranges.push(None)
        return len(self.content_names) - 1

    # A content whose elements are all constants between `lo` and `hi`.
    fn ranged_content(ref self, name: str, vals: [V]) -> int:
        let c = self.fresh_content(name)
        var lo: Option[i128] = None
        var hi: Option[i128] = None
        for v in vals:
            match v:
                case V.Int(l):
                    match l.is_const():
                        case Some(x):
                            lo = Some(x if lo.is_none() else min(lo.unwrap(), x))
                            hi = Some(x if hi.is_none() else max(hi.unwrap(), x))
                        case None:
                            return c
                case _:
                    return c
        if lo.is_some():
            self.content_ranges[c] = Some((lo.unwrap(), hi.unwrap()))
        return c

    fn term(ref self, t: Term, range: Option[(i128, i128)]) -> int:
        let tk = term_key(t)
        match self.terms.get(tk):
            case Some(a):
                return a
            case None:
                pass
        var name = ""
        match t:
            case Term.Sel(c, i):
                name = self.content_names[c] + "[" + self.show_lin(i) + "]"
            case Term.SelB(c, i):
                name = self.content_names[c] + "[" + self.show_lin(i) + "]"
            case Term.Mul(a, b):
                name = self.show_lin_p(a) + " * " + self.show_lin_p(b)
            case Term.Div(a, b):
                name = self.show_lin_p(a) + " / " + self.show_lin_p(b)
            case Term.Mod(a, b):
                name = self.show_lin_p(a) + " % " + self.show_lin_p(b)
            case Term.Rank:
                name = "world.rank()"
            case Term.Size:
                name = "world.size()"
        let a = self.new_atom(name, range)
        self.terms[tk] = a
        match t:
            case Term.Rank:
                let s = self.term(Term.Size, pos_range())
                self.defs.push(F.ge(Lin.atom(a)))
                self.defs.push(F.lt(Lin.atom(a), Lin.atom(s)))
            case Term.Div(l, d):
                match d.is_const():
                    case Some(c):
                        # q = floor(l / c) for constant c > 0, i.e. l = c*q + r with 0 <= r < c
                        let q = Lin.atom(a)
                        match q.scale(c):
                            case Some(cq):
                                match l.sub(cq):
                                    case Some(r):
                                        let one: i128 = 1
                                        self.defs.push(
                                            F.and_([F.ge(r), F.le(r, Lin.konst(c - one))])
                                        )
                                    case None:
                                        pass
                            case None:
                                pass
                    case None:
                        pass
            case _:
                pass
        return a

    fn fresh_val(ref self, ty: Ty, name: str) -> V:
        match ty:
            case Ty.Int(k):
                return V.Int(self.fresh_int(name, k))
            case Ty.Bool:
                return V.Bool(self.fresh_bool(name))
            case Ty.Array(_):
                let c = self.fresh_content(name)
                return V.Arr(c, self.fresh_len("len(" + name + ")"))
            case Ty.Str:
                return V.Str(self.fresh_len("len(" + name + ")"))
            case Ty.Tuple(ts):
                var vs: [V] = []
                for i, t in enumerate(ts):
                    vs.push(self.fresh_val(t, f"{name}.{i}"))
                return V.Agg(vs)
            case Ty.Struct(sid):
                let fields = self.info.structs[sid].fields
                var vs: [V] = []
                for n, t in fields:
                    vs.push(self.fresh_val(t, name + "." + n))
                return V.Agg(vs)
            case _:
                return V.Opaque

    fn lin(ref self, l: Option[Lin], name: str) -> Lin:
        match l:
            case Some(x):
                return x
            case None:
                return Lin.atom(self.new_atom(name, None))

    fn as_int(ref self, v: V, ty: Ty) -> Lin:
        match v:
            case V.Int(l):
                return l
            case _:
                match ty:
                    case Ty.Int(k):
                        return self.fresh_int("?", k)
                    case _:
                        return Lin.atom(self.new_atom("?", None))

    fn as_bool(ref self, v: V) -> F:
        match v:
            case V.Bool(f):
                return f
            case _:
                return self.fresh_bool("?")

    fn sel(ref self, c: int, i: Lin, ety: Ty) -> V:
        match ety:
            case Ty.Int(k):
                var r = int_range(k)
                match self.content_ranges[c]:
                    case Some(cr):
                        r = Some((max(cr.0, k.min()), min(cr.1, k.max())))
                    case None:
                        pass
                return V.Int(Lin.atom(self.term(Term.Sel(c, i), r)))
            case Ty.Bool:
                return V.Bool(F.B(self.term(Term.SelB(c, i), None), true))
            case _:
                let n = self.content_names[c] + "[" + self.show_lin(i) + "]"
                return self.fresh_val(ety, n)

    # Fact: element `i` of content `c` equals `v`.
    fn define_sel(ref self, c: int, i: Lin, ety: Ty, v: V):
        let s = self.sel(c, i, ety)
        match val_eq(s, v):
            case Some(f):
                self.defs.push(f)
            case None:
                pass

    # ------------------------------------------------------------ facts and proofs
    fn assume(ref self, f: F):
        if self.live and f != F.True:
            self.st.facts.push(f)

    fn holds(self, goal: F) -> bool:
        if not self.live:
            return true
        var all = self.st.facts
        all.extend(self.defs)
        return prove_(all, goal, self.ranges)

    fn holds_with(ref self, extra: F, goal: F) -> bool:
        let n = len(self.st.facts) if self.live else 0
        self.assume(extra)
        let r = self.holds(goal)
        if self.live:
            self.st.facts = self.st.facts[:n]
        return r

    # Implicit (safety) obligation: proven => the runtime check is removed.
    # Either way the fact holds afterwards (it was proven or checked).
    fn implicit(ref self, span: Span, tag: int, goal: F, what: str):
        if self.spec or not self.live:
            return
        if self.holds(goal):
            self.proven[key(span, tag)] = true
        else:
            self.failed[key(span, tag)] = true
            self.remaining.push((span, what))
        self.assume(goal)

    # `x op= y`: the new value of `x`; the statement's check is proven or listed.
    fn compound(ref self, span: Span, op: BinOp, a: Lin, b: Lin, k: IntTy) -> V:
        let r = self.arith_val(op, a, b, k)
        let l = self.as_int(r, Ty.Int(k))
        let fits = in_range(l, k)
        match op:
            case BinOp.Add | BinOp.Sub | BinOp.Mul:
                self.implicit(span, TAG_COMPOUND, fits, "overflow check")
            case BinOp.Div:
                self.implicit(span, TAG_COMPOUND, div_goal(op, a, b, k), "division check")
            case BinOp.Mod:
                self.implicit(span, TAG_COMPOUND, div_goal(op, a, b, k), "remainder check")
            case BinOp.Shl | BinOp.Shr:
                self.implicit(span, TAG_COMPOUND, shift_goal(b, k), "shift check")
            case _:
                pass
        if not self.spec:
            self.assume(fits)
        return V.Int(l)

    # Start running with an extra temporary assumption; `end_assume` drops the facts added since.
    fn begin_assume(ref self, extra: F) -> (Option[St], int):
        let saved = self.cur()
        let n = len(self.st.facts) if self.live else 0
        self.assume(extra)
        return (saved, n)

    fn end_assume(ref self, saved: (Option[St], int)):
        if self.live:
            self.st.facts = self.st.facts[:saved.1]
        else:
            self.put(saved.0)

    # ------------------------------------------------------------ display
    fn atom_name(self, a: int) -> str:
        return self.atom_names[a] if 0 <= a < len(self.atom_names) else "?"

    fn show_lin(self, l: Lin) -> str:
        if len(l.t) == 0:
            return f"{l.c}"
        var s = ""
        for i, p in enumerate(l.t):
            let a = p.0
            let k = p.1
            let name = self.atom_name(a)
            let ak = wrapping_abs(k)
            if i == 0:
                if k < 0:
                    s += "-"
            else:
                s += " - " if k < 0 else " + "
            if ak != 1:
                s += f"{ak}*"
            # `4*(m / 4)`, `-(a - b)`: a name that is an expression
            if " " in name and (ak != 1 or k < 0):
                s += "(" + name + ")"
            else:
                s += name
        if l.c > 0:
            s += f" + {l.c}"
        elif l.c < 0:
            s += f" - {wrapping_neg(l.c)}"
        return s

    fn show_lin_p(self, l: Lin) -> str:
        let s = self.show_lin(l)
        let n = len(l.t) + (1 if l.c != 0 else 0)
        if n > 1:
            return "(" + s + ")"
        return s

    # Show `l op 0` as `lhs op rhs` with positive coefficients on both sides.
    fn show_rel(self, l: Lin, op0: str) -> str:
        let zero: i128 = 0
        let pos = Lin(c=zero, t=[p for p in l.t if p.1 > 0])
        var neg_t: [(int, i128)] = []
        for p in l.t:
            if p.1 < 0:
                neg_t.push((p.0, wrapping_neg(p.1)))
        if len(pos.t) == 0 and len(neg_t) > 0:
            # -t + c op 0: `t <= c` reads better than `0 >= t - c`
            let t = self.show_lin(Lin(c=zero, t=neg_t))
            if op0 == ">=":
                if l.c == -1:
                    return t + " < 0"
                return t + f" <= {l.c}"
            return t + " " + op0 + f" {l.c}"
        var rhs_c = wrapping_neg(l.c)
        var op = op0
        if op == ">=" and rhs_c == 1:
            op = ">"
            rhs_c = zero
        let lhs = "0" if len(pos.t) == 0 else self.show_lin(pos)
        let rhs = Lin(c=rhs_c, t=neg_t)
        return lhs + " " + op + " " + self.show_lin(rhs)

    fn show_f(self, f: F) -> str:
        match f:
            case F.True:
                return "true"
            case F.False:
                return "false"
            case F.Ge(l):
                return self.show_rel(l, ">=")
            case F.Eq(l):
                return self.show_rel(l, "==")
            case F.Ne(l):
                return self.show_rel(l, "!=")
            case F.B(a, p):
                let n = self.atom_name(a)
                return n if p else "not " + n
            case F.And(xs):
                return " and ".join([self.show_f(x) for x in xs])
            case F.Or(xs):
                return "(" + " or ".join([self.show_f(x) for x in xs]) + ")"

    fn known_facts_note(self, goal: F) -> [str]:
        if not self.live:
            return []
        var ga = AtomSet.new()
        goal.atoms(ref ga)
        # the newest value of each name in the goal: facts about older values
        # of the same variable (before a loop changed it) would only confuse
        var newest: {str: int} = {}
        for a0 in ga.xs:
            let n0 = self.atom_name(a0)
            if a0 > newest.get(n0).unwrap_or(-1):
                newest[n0] = a0
        var out: [str] = []
        var unlisted = false
        var mentioned = AtomSet.new()
        var facts: [F] = []
        for f0 in self.st.facts:
            conjuncts(f0, ref facts)
        for f in facts:
            var fa = AtomSet.new()
            f.atoms(ref fa)
            if not any(ga.contains(a) for a in fa.xs):
                continue
            # (bounds near the type's limits are noise: left out silently)
            if huge(f):
                continue
            if any(
                not ga.contains(a) and a < newest.get(self.atom_name(a)).unwrap_or(-1)
                for a in fa.xs
            ):
                continue
            for a1 in fa.xs:
                mentioned.insert(a1)
            if f.size() > 9 or any(self.atom_name(a) == "?" for a in fa.xs):
                unlisted = true
                continue
            let s = self.show_f(f)
            if s not in out:
                out.push(s)
        var notes: [str] = []
        if len(out) == 0:
            if unlisted:
                notes.push("what is known here about the values involved is too long to list")
            else:
                notes.push("nothing is known here about the values involved")
        else:
            if len(out) > 6:
                out = out[len(out) - 6:]
            notes.push("known facts here: " + ", ".join(out))
        for a2 in ga.xs:
            if a2 in self.looped and not mentioned.contains(a2):
                let n2 = self.atom_name(a2)
                notes.push(
                    f"`{n2}` is changed by a loop before this point whose invariants say nothing about it: add one there that says what is needed here"
                )
        return notes

    fn snippet(self, s: Span) -> str:
        return self.sm.snippet(s)

    # Values of the goal's names that satisfy every known fact but not the
    # goal, when the prover can find some: either the code is wrong for them,
    # or it needs a fact that rules them out.
    fn values_note(self, facts: [F], goal: F) -> Option[str]:
        let m = counterexample(facts, goal, self.ranges)?
        var ga = AtomSet.new()
        goal.atoms(ref ga)
        # the newest value of each name: older ones (before a loop changed
        # the variable) would read as the same name
        var newest: {str: int} = {}
        for a in ga.xs:
            let n = self.atom_name(a)
            if a != ATOM_UNKNOWN and n != "?" and a > newest.get(n).unwrap_or(-1):
                newest[n] = a
        var out: [str] = []
        for a2 in ga.xs:
            let n2 = self.atom_name(a2)
            if newest.get(n2) != Some(a2):
                continue
            match m.ints.get(a2):
                case Some(v):
                    out.push(f"{n2} = {v}")
                case None:
                    match m.bools.get(a2):
                        case Some(b):
                            out.push(n2 + " = " + ("true" if b else "false"))
                        case None:
                            pass
        if len(out) == 0:
            return None
        return Some("values the prover can't rule out: " + ", ".join(out))

    fn fail(ref self, d0: Diag, goal: F):
        var d = d0
        if goal == F.False:
            d = d.note("with the values used here, this is always false")
        else:
            # of a conjunction, show the parts that aren't proven
            var open = goal
            var rest_proven = false
            match goal:
                case F.And(xs):
                    if self.live:
                        let left = [x for x in xs if not self.holds(x)]
                        if 0 < len(left) < len(xs):
                            open = F.and_(left)
                            rest_proven = true
                case _:
                    pass
            for n in self.known_facts_note(open):
                d = d.note(n)
            if rest_proven:
                d = d.note("to prove: " + self.show_f(open) + " (the rest of it is proven)")
            else:
                d = d.note("to prove: " + self.show_f(goal))
            if self.live:
                var all = self.st.facts
                all.extend(self.defs)
                let gave_up = prove_full(all, goal, self.ranges) == GAVE_UP
                if not gave_up:
                    match self.values_note(all, open):
                        case Some(n):
                            d = d.note(n)
                        case None:
                            pass
                if gave_up:
                    d = d.note(
                        "the prover gave up: what it knows here splits into too many cases to check them all, so this may well be true"
                    )
                    # the usual advice (add facts) would only add cases
                    d.help = [
                        "check it with `assert` (at runtime) instead, or move the branches before this point into a function whose `ensures` states just what is needed here"
                    ]
        self.diags.push(d)

    # Name the values made since atom `na` and content `nc` after `to`
    # instead of the expression `from` (only in messages).
    fn rename_since(ref self, na: int, nc: int, from: str, to: str):
        if from == "" or from == to or "'" in to or from.ends_with("..."):
            return
        for a in na..len(self.atom_names):
            self.atom_names[a] = self.atom_names[a].replace(from, to)
        for c in nc..len(self.content_names):
            self.content_names[c] = self.content_names[c].replace(from, to)

    # Short source text for naming unknown values in messages.
    fn name_of(self, e: Expr) -> str:
        let s = split_ws(self.snippet(e.span))
        let cs = s.chars()
        if len(cs) > 32:
            return "".join(cs[:29]) + "..."
        return s

    # ------------------------------------------------------------ specs
    fn spec_cond(ref self, e: Expr) -> F:
        let was = self.spec
        self.spec = true
        let v = self.eval(e)
        self.spec = was
        return self.as_bool(v)

    fn spec_cond_in(ref self, env: {int: V}, e: Expr) -> F:
        let saved = self.alt_env
        self.alt_env = Some(env)
        let f = self.spec_cond(e)
        self.alt_env = saved
        return f

    fn check_ensures(ref self, ret: Option[V], span: Span):
        let ens = self.ensures
        if len(ens) == 0:
            return
        match (self.result_local, ret):
            case (Some(r), Some(v)):
                if self.live:
                    self.st.env[r] = v
            case _:
                pass
        for e in ens:
            let f = self.spec_cond(e)
            if not self.holds(f):
                let d = (
                    diag.error("E0602", f"cannot prove the postcondition of `{self.fn_name}`")
                    .label(
                        span,
                        "this might return without `" + self.snippet(e.span) + "` being true"
                    )
                    .label(e.span, "postcondition declared here")
                    .with_help(
                        "strengthen the function's `requires`, add a loop `invariant`, or check the claim with `assert` before returning"
                    )
                )
                self.fail(d, f)
            self.assume(f)

    # ------------------------------------------------------------ statements
    fn block(ref self, b: Block):
        for s in b.stmts:
            if not self.live:
                return
            self.stmt(s)

    fn lookup(ref self, id: int, ty: Ty) -> V:
        match self.alt_env:
            case Some(env):
                match env.get(id):
                    case Some(v):
                        return v
                    case None:
                        return self.fresh_val(ty, "?")
            case None:
                pass
        if self.live:
            match self.st.env.get(id):
                case Some(v):
                    return v
                case None:
                    pass
        let name = self.local_name(id)
        let v = self.fresh_val(ty, name)
        self.bind(id, v)
        return v

    fn bind(ref self, id: int, v: V):
        if self.live:
            self.st.env[id] = v

    fn stmt(ref self, s: Stmt):
        match s.kind:
            case StmtKind.Let(_, pat, _, init, _):
                let na = len(self.atom_names)
                let nc = len(self.content_names)
                let v = self.eval(init)
                # in messages, `let t = mk(n)` makes `len(t.xs)`, not `len(mk(n).xs)`
                let from = self.name_of(init)
                match pat:
                    case LetPat.Name(_, _):
                        self.rename_since(na, nc, from, self.local_name(s.locals[0]))
                        self.bind(s.locals[0], v)
                    case LetPat.Tuple(_):
                        # the last first: `.1` is the start of `.10`
                        var j = len(s.locals)
                        while j > 0:
                            j -= 1
                            self.rename_since(na, nc, f"{from}.{j}", self.local_name(s.locals[j]))
                        for i, id in enumerate(s.locals):
                            var x = V.Opaque
                            var have = false
                            match v:
                                case V.Agg(vs):
                                    if i < len(vs):
                                        x = vs[i]
                                        have = true
                                case _:
                                    pass
                            if not have:
                                x = self.fresh_val(self.local_ty(id), self.local_name(id))
                            self.bind(id, x)
            case StmtKind.Assign(target, op, value):
                let rhs = self.eval(value)
                match self.lvalue_path(target, op.is_none()):
                    case Some((root, steps)):
                        var new = rhs
                        match op:
                            case Some(o):
                                let cur = self.read_path(root, steps)
                                match (target.ty, cur, rhs):
                                    case (Ty.Int(k), _, _):
                                        let a = self.as_int(cur, target.ty)
                                        let b = self.as_int(rhs, value.ty)
                                        new = self.compound(s.span, o, a, b, k)
                                    case (Ty.Str, V.Str(a), V.Str(b)):
                                        new = V.Str(self.lin(a.add(b), "len(?)"))
                                    case _:
                                        new = self.fresh_val(target.ty, "?")
                            case None:
                                pass
                        let old = self.lookup(root, self.local_ty(root))
                        let nv = self.write_path(old, steps, new)
                        self.bind(root, nv)
                    case None:
                        pass
            case StmtKind.ExprStmt(e):
                self.eval(e)
                match e.kind:
                    case ExprKind.Call(_, _):
                        match e.cres:
                            case CallRes.Builtin(Builtin.Exit) | CallRes.Builtin(Builtin.Panic):
                                self.live = false
                            case _:
                                pass
                    case _:
                        pass
            case StmtKind.If(branches, els):
                self.if_chain(branches, els)
            case StmtKind.Match(scrut, cases):
                self.match_stmt(scrut, cases)
            case StmtKind.While(cond, invariants, body):
                self.while_loop(cond, invariants, body)
            case StmtKind.For(_, _, _, iter, invariants, body, _):
                self.for_loop(iter, invariants, body, s.local)
            case StmtKind.Return(value):
                var v: Option[V] = None
                match value:
                    case Some(e):
                        v = Some(self.eval(e))
                    case None:
                        pass
                if self.live:
                    self.check_ensures(v, s.span)
                self.live = false
            case StmtKind.Break:
                let st = self.take()
                match st:
                    case Some(x):
                        if len(self.loops) > 0:
                            self.loops[len(self.loops) - 1].breaks.push(x)
                    case None:
                        pass
            case StmtKind.Continue:
                self.check_preserved(s.span)
                self.live = false
            case StmtKind.Assert(cond, _):
                let r0 = len(self.remaining)
                let v = self.eval(cond)
                let c = self.as_bool(v)
                # removing the assert removes the checks in its condition too:
                # only when none of them stays
                if pure_expr(cond) and len(self.remaining) == r0 and self.holds(c):
                    self.proven[key(s.span, TAG_ASSERT)] = true
                else:
                    self.failed[key(s.span, TAG_ASSERT)] = true
                self.assume(c)
            case StmtKind.Prove(e):
                let f = self.spec_cond(e)
                if not self.holds(f):
                    let d = (
                        diag.error("E0605", "cannot prove this claim")
                        .label(e.span, "the prover could not show this is always true")
                        .with_help(
                            "add facts it can use (`requires`, `invariant`, or an `assert` before this line), or use `assert` to check it at runtime instead"
                        )
                    )
                    self.fail(d, f)
                self.assume(f)
            case _:
                pass

    fn merge(ref self, a0: Option[St], b0: Option[St], k0: int) -> Option[St]:
        if a0.is_none():
            return b0
        if b0.is_none():
            return a0
        let a = a0.unwrap()
        let b = b0.unwrap()
        let (env, ea, eb, hull) = self.merge_env(a.env, b.env)
        let k = min(k0, min(len(a.facts), len(b.facts)))
        var facts = a.facts[:k]
        var fa = a.facts[k:]
        fa.extend(ea)
        var fb = b.facts[k:]
        fb.extend(eb)
        let both = F.or_([F.and_(fa), F.and_(fb)])
        if both.size() <= MERGE_MAX:
            facts.push(both)
        else:
            # too big: keep what both branches agree on
            for f in fa:
                if f in fb:
                    facts.push(f)
        facts.extend(hull)
        return Some(St(env=env, facts=facts))

    # The variables of two paths' environments: a fresh value where they
    # differ, with what it equals on each path.
    fn merge_env(ref self, a: {int: V}, b: {int: V}) -> ({int: V}, [F], [F], [F]):
        var env: {int: V} = {}
        var ea: [F] = []
        var eb: [F] = []
        var hull: [F] = []
        # in a fixed order, so fresh atoms and facts are the same on every run
        var keys = [x for x in a.keys() if x in b]
        keys.sort()
        for id in keys:
            let va = a[id]
            let vb = b[id]
            env[id] = self.merge_val(
                va,
                vb,
                self.local_ty(id),
                self.local_name(id),
                ref ea,
                ref eb,
                ref hull
            )
        return (env, ea, eb, hull)

    # The value that is `va` on one path and `vb` on the other: the parts
    # they share stay; a fresh value replaces each part that differs, with
    # what it equals on each path (`ea`, `eb`) and on both (`hull`).
    fn merge_val(
        ref self,
        va: V,
        vb: V,
        ty: Ty,
        name: str,
        ref ea: [F],
        ref eb: [F],
        ref hull: [F]
    ) -> V:
        if va == vb:
            return va
        match (va, vb):
            case (V.Agg(xs), V.Agg(ys)):
                if len(xs) == len(ys) and all(self.field_of(ty, i).is_some() for i in 0..len(xs)):
                    var vs: [V] = []
                    for i in 0..len(xs):
                        let (fname, fty) = self.field_of(ty, i).unwrap()
                        vs.push(
                            self.merge_val(
                                xs[i],
                                ys[i],
                                fty,
                                name + "." + fname,
                                ref ea,
                                ref eb,
                                ref hull
                            )
                        )
                    return V.Agg(vs)
            case (V.Arr(ca, la), V.Arr(cb, lb)):
                # the same elements where both are in bounds: the same content
                let c = ca if ca == cb else self.fresh_content(name)
                if la == lb:
                    return V.Arr(c, la)
                let l = self.fresh_len("len(" + name + ")")
                ea.push(F.equal(l, la))
                eb.push(F.equal(l, lb))
                hull_lin(l, la, lb, ref hull)
                return V.Arr(c, l)
            case _:
                pass
        let nv = self.fresh_val(ty, name)
        match val_eq(nv, va):
            case Some(f):
                ea.push(f)
            case None:
                pass
        match val_eq(nv, vb):
            case Some(f):
                eb.push(f)
            case None:
                pass
        hull_facts(nv, va, vb, ref hull)
        return nv

    # The name and type of field `k` of a struct or tuple type.
    fn field_of(self, ty: Ty, k: int) -> Option[(str, Ty)]:
        match ty:
            case Ty.Struct(sid):
                let fields = self.info.structs[sid].fields
                if 0 <= k < len(fields):
                    return Some(fields[k])
            case Ty.Tuple(ts):
                if 0 <= k < len(ts):
                    return Some((f"{k}", ts[k]))
            case _:
                pass
        return None

    # Before code that runs on some paths only (`a if c else b`, the right
    # side of `and`/`or`, the later operands of `a < b < c`, a `match`
    # guard): its effects must stay on its path (see `join`). None in
    # specifications, which change nothing, and where nothing runs.
    fn fork(self) -> Option[Fork]:
        if self.spec or not self.live:
            return None
        return Some(Fork(base=self.st, k=len(self.st.facts), na=len(self.atom_names)))

    # The state after two paths from `fk`, taken when `ga` and `gb` hold. The
    # facts a path learned about values it created hold when its guard does
    # (the others, about older values, are dropped: they'd only slow the
    # solver down).
    fn join(ref self, fk: Fork, a0: Option[St], ga: F, b0: Option[St], gb: F) -> Option[St]:
        if a0.is_none():
            return b0
        if b0.is_none():
            return a0
        let a = a0.unwrap()
        let b = b0.unwrap()
        let (env, ea, eb, hull) = self.merge_env(a.env, b.env)
        var fa = new_facts(a.facts, fk)
        fa.extend(ea)
        var fb = new_facts(b.facts, fk)
        fb.extend(eb)
        var facts = fk.base.facts
        if len(fa) > 0 or len(fb) > 0:
            fa.push(ga)
            fb.push(gb)
            let both = F.or_([F.and_(fa), F.and_(fb)])
            if both.size() <= MERGE_MAX:
                facts.push(both)
        facts.extend(hull)
        return Some(St(env=env, facts=facts))

    # Evaluate `e` on the path where `guard` holds only; the other path runs nothing.
    fn eval_when(ref self, guard: F, e: Expr) -> V:
        match self.fork():
            case Some(fk):
                self.assume(guard)
                let v = self.eval(e)
                let s1 = self.take()
                var other = fk.base
                let ng = guard.not_()
                if ng != F.True:
                    other.facts.push(ng)
                let joined = self.join(fk, s1, guard, Some(other), ng)
                self.put(joined)
                return v
            case None:
                let s = self.begin_assume(guard)
                let v = self.eval(e)
                self.end_assume(s)
                return v

    fn if_chain(ref self, branches: [(Expr, Block)], els: Option[Block]):
        let c = self.cond(branches[0].0)
        let base0 = self.take()
        if base0.is_none():
            return
        let base = base0.unwrap()
        let k = len(base.facts)
        var t = base
        if c != F.True:
            t.facts.push(c)
        self.put(Some(t))
        self.block(branches[0].1)
        let s1 = self.take()
        var e = base
        let nc = c.not_()
        if nc != F.True:
            e.facts.push(nc)
        self.put(Some(e))
        if len(branches) > 1:
            self.if_chain(branches[1:], els)
        else:
            match els:
                case Some(b):
                    self.block(b)
                case None:
                    pass
        let s2 = self.take()
        let m = self.merge(s1, s2, k)
        self.put(m)

    # Cases are tried in order: each case sees the facts of its own pattern and
    # (when expressible) that the earlier patterns didn't match.
    fn match_stmt(ref self, scrut: Expr, cases: [Case]):
        let sv = self.eval(scrut)
        let base0 = self.take()
        if base0.is_none():
            return
        var cur = base0.unwrap()
        let k = len(cur.facts)
        var out: Option[St] = None
        for c in cases:
            let hit = self.pat_cond(c.pat, sv)
            var t = cur
            match hit:
                case Some(h):
                    if h != F.True:
                        t.facts.push(h)
                case None:
                    pass
            self.put(Some(t))
            self.bind_pattern(c.pat, sv, scrut.ty)
            var gcond = F.True
            # the state after a guard that changes something
            var after_guard: Option[St] = None
            match c.guard:
                case Some(g):
                    var gm: {int: int} = {}
                    mods_expr(g, self.info, ref gm)
                    gcond = self.cond(g)
                    if len(gm) > 0:
                        after_guard = self.cur()
                    self.assume(gcond)
                case None:
                    pass
            self.block(c.body)
            let s = self.take()
            out = self.merge(out, s, k)
            # later cases run only if this one didn't match
            match after_guard:
                case Some(ag0):
                    # either the pattern didn't match, or it did and the
                    # guard (and what it changed) was false
                    var miss = cur
                    match hit:
                        case Some(h):
                            let nh = h.not_()
                            if nh != F.True:
                                miss.facts.push(nh)
                        case None:
                            pass
                    var ag = ag0
                    let ng = gcond.not_()
                    if ng != F.True:
                        ag.facts.push(ng)
                    match self.merge(Some(miss), Some(ag), len(cur.facts)):
                        case Some(m):
                            cur = m
                        case None:
                            pass
                case None:
                    match hit:
                        case Some(h):
                            let n = F.and_([h, gcond]).not_()
                            if n != F.True:
                                cur.facts.push(n)
                        case None:
                            pass
        self.put(out)

    # Exact condition for `p` matching `v`, when it can be expressed.
    fn pat_cond(ref self, p: Pattern, v: V) -> Option[F]:
        match p.kind:
            case PatKind.Wild | PatKind.Bind(_):
                return Some(F.True)
            case PatKind.Int(n):
                match v:
                    case V.Int(l):
                        return Some(F.equal(l, Lin.konst(n)))
                    case _:
                        return None
            case PatKind.Bool(b):
                match v:
                    case V.Bool(f):
                        return Some(f if b else f.not_())
                    case _:
                        return None
            case PatKind.Or(alts):
                var fs: [F] = []
                for a in alts:
                    fs.push(self.pat_cond(a, v)?)
                return Some(F.or_(fs))
            case PatKind.Tuple(ps):
                match v:
                    case V.Agg(vs):
                        if len(ps) != len(vs):
                            return None
                        var fs: [F] = []
                        for i in 0..len(ps):
                            fs.push(self.pat_cond(ps[i], vs[i])?)
                        return Some(F.and_(fs))
                    case _:
                        return None
            case _:
                return None

    fn bind_pattern(ref self, p: Pattern, v: V, ty: Ty):
        match p.kind:
            case PatKind.Bind(_):
                self.bind(p.local, v)
            case PatKind.Tuple(ps):
                var ts: [Ty] = [Ty.Error] * len(ps)
                match ty:
                    case Ty.Tuple(xs):
                        ts = xs
                    case _:
                        pass
                for i, q in enumerate(ps):
                    let t = ts[i] if i < len(ts) else Ty.Error
                    var x = V.Opaque
                    var have = false
                    match v:
                        case V.Agg(vs):
                            if i < len(vs):
                                x = vs[i]
                                have = true
                        case _:
                            pass
                    if not have:
                        x = self.fresh_val(t, "?")
                    self.bind_pattern(q, x, t)
            case PatKind.Variant(_, _):
                match p.vres:
                    case Some((eid, vi)):
                        let fts = self.info.enums[eid].variants[vi].fields
                        for i in 0..min(len(p.fields), len(fts)):
                            let x = self.fresh_val(fts[i].1, fts[i].0)
                            self.bind_pattern(p.fields[i], x, fts[i].1)
                    case None:
                        pass
            case _:
                pass

    fn havoc(ref self, body: Block):
        var effs: [Eff] = []
        effs_block(body, self.info, ref effs)
        self.havoc_mods(resolve_effs(effs, self.fps))

    # Forget what code that runs an unknown number of times may change.
    fn havoc_mods(ref self, mods: {int: [[int]]}):
        let na = len(self.atom_names)
        self.havoc_paths(mods)
        for a in na..len(self.atom_names):
            self.looped[a] = true

    fn havoc_paths(ref self, mods: {int: [[int]]}):
        var ids = mods.keys()
        ids.sort()
        for id in ids:
            if not self.live:
                continue
            match self.st.env.get(id):
                case Some(cur):
                    var nv = cur
                    for p in mods[id]:
                        nv = self.havoc_at(nv, p, self.local_ty(id), self.local_name(id))
                    self.bind(id, nv)
                case None:
                    pass

    # `v` (of type `ty`) with the part at `path` forgotten.
    fn havoc_at(ref self, v: V, path: [int], ty: Ty, name: str) -> V:
        if len(path) == 0:
            return self.fresh_val(ty, name)
        if path[0] == CONTENT:
            match v:
                case V.Arr(_, l):
                    return V.Arr(self.fresh_content(name), l)
                case _:
                    return self.fresh_val(ty, name)
        match (v, self.field_of(ty, path[0])):
            case (V.Agg(vs0), Some((fname, fty))):
                if path[0] < len(vs0):
                    var vs = vs0
                    vs[path[0]] = self.havoc_at(vs0[path[0]], path[1:], fty, name + "." + fname)
                    return V.Agg(vs)
            case _:
                pass
        return self.fresh_val(ty, name)

    # The part of `v` at a path of fields (None past an index).
    fn at_path(self, v: V, path: [int], ty: Ty) -> Option[V]:
        if len(path) == 0:
            return Some(v)
        let (_, fty) = self.field_of(ty, path[0])?
        match v:
            case V.Agg(vs):
                if 0 <= path[0] < len(vs):
                    return self.at_path(vs[path[0]], path[1:], fty)
            case _:
                pass
        return None

    fn check_entry_invs(ref self, invs: [Expr], extra: F):
        for inv in invs:
            let f = self.spec_cond(inv)
            if not self.holds_with(extra, f):
                let d = (
                    diag.error("E0603", "loop invariant might not hold when the loop starts")
                    .label(inv.span, "might be false before the first iteration")
                    .with_help(
                        "establish it before the loop, e.g. by initializing variables so the claim holds"
                    )
                )
                self.fail(d, f)

    fn check_preserved(ref self, at: Span):
        if not self.live or len(self.loops) == 0:
            return
        let cx = self.loops[len(self.loops) - 1]
        let invs = cx.invs
        let next = cx.next
        var saved: Option[V] = None
        match next:
            case Some((id, v)):
                saved = self.st.env.get(id)
                self.bind(id, v)
            case None:
                pass
        for inv in invs:
            let f = self.spec_cond(inv)
            if not self.holds(f):
                let d = (
                    diag.error("E0604", "loop invariant might not be preserved by the loop body")
                    .label(inv.span, "might be false after an iteration")
                    .label(at, "at the end of this iteration")
                    .with_help(
                        "make sure every path through the loop body re-establishes the invariant"
                    )
                )
                self.fail(d, f)
                match next:
                    case Some((id, V.Int(l))):
                        let n = self.local_name(id)
                        let last = len(self.diags) - 1
                        self.diags[last] = self.diags[last].note(
                            f"it's checked for the next iteration, where `{n}` is {self.show_lin(l)}"
                        )
                    case _:
                        pass
        match (next, saved):
            case (Some((id, _)), Some(v)):
                self.bind(id, v)
            case _:
                pass

    # The entry values of the loop's monotone locals (see `monotone`).
    fn mono_starts(self, body: Block, cond: Option[Expr]) -> [(int, int, Lin)]:
        var out: [(int, int, Lin)] = []
        if not self.live:
            return out
        for id, d in monotone(body, cond, self.info):
            match self.st.env.get(id):
                case Some(V.Int(x0)):
                    out.push((id, d, x0))
                case _:
                    pass
        return out

    # After the havoc: each monotone local moved one way only.
    fn mono_facts(ref self, starts: [(int, int, Lin)]):
        for id, d, x0 in starts:
            match self.st.env.get(id):
                case Some(V.Int(x)):
                    self.assume(F.le(x0, x) if d > 0 else F.le(x, x0))
                case _:
                    pass

    fn while_loop(ref self, cond: Expr, invs: [Expr], body: Block):
        self.check_entry_invs(invs, F.True)
        if not self.live:
            return
        let k = len(self.st.facts)
        # the condition runs before every iteration too
        var effs: [Eff] = []
        effs_block(body, self.info, ref effs)
        effs_expr(cond, self.info, ref effs)
        let starts = self.mono_starts(body, Some(cond))
        self.havoc_mods(resolve_effs(effs, self.fps))
        self.mono_facts(starts)
        for inv in invs:
            let f = self.spec_cond(inv)
            self.assume(f)
        let c = self.cond(cond)
        let head0 = self.take()
        if head0.is_none():
            return
        let head = head0.unwrap()
        var exit = head
        exit.facts.push(c.not_())
        var b = head
        b.facts.push(c)
        self.put(Some(b))
        self.loops.push(LoopCx(invs=invs, next=None, breaks=[]))
        self.block(body)
        let end = body.stmts[len(body.stmts) - 1].span if len(body.stmts) > 0 else body.span
        self.check_preserved(end)
        let cx = self.loops.pop()
        var out: Option[St] = Some(exit)
        for br in cx.breaks:
            out = self.merge(out, Some(br), k)
        self.put(out)

    fn for_loop(ref self, iter: Expr, invs: [Expr], body: Block, var_id: int):
        let vname = self.local_name(var_id)
        let vty = self.local_ty(var_id)
        var dom = D.Other
        var done = false
        match iter.kind:
            case ExprKind.Range(lo, hi, inclusive):
                let av = self.eval(lo)
                let a = self.as_int(av, lo.ty)
                let bv = self.eval(hi)
                let b = self.as_int(bv, hi.ty)
                dom = D.Range(a, b, inclusive)
                done = true
            case ExprKind.Call(_, args):
                if iter.cres == CallRes.Range:
                    var vals: [Lin] = []
                    for a in args:
                        let v = self.eval(a.expr)
                        vals.push(self.as_int(v, a.expr.ty))
                    if len(vals) == 1:
                        dom = D.Range(Lin.konst(0), vals[0], false)
                    elif len(vals) == 2:
                        dom = D.Range(vals[0], vals[1], false)
                    else:
                        dom = D.Stepped(vals[0], vals[1], vals[2].is_const())
                    done = true
            case _:
                pass
        if not done:
            match self.eval(iter):
                case V.Arr(c, l):
                    dom = D.Arr(c, l, iter.ty.elem())
                case _:
                    dom = D.Other
        if not self.live:
            return
        let entry = self.st
        let k = len(entry.facts)
        # the counters' values before the loop
        var starts: [(int, Lin)] = []
        match dom:
            case D.Range(_, _, _):
                for c in counters(body, self.info):
                    match entry.env.get(c):
                        case Some(V.Int(c0)):
                            starts.push((c, c0))
                        case _:
                            pass
            case _:
                pass
        # invariants: entry, using the first value of the loop variable
        var nonempty = F.True
        var first: Option[V] = None
        var last: Option[V] = None
        match dom:
            case D.Range(lo, hi, incl):
                nonempty = F.le(lo, hi) if incl else F.lt(lo, hi)
                first = Some(V.Int(lo))
                if incl:
                    match hi.add_c(1):
                        case Some(h):
                            last = Some(V.Int(h))
                        case None:
                            pass
                else:
                    last = Some(V.Int(hi))
            case _:
                pass
        if len(invs) > 0:
            let saved = self.st.env.get(var_id) if self.live else None
            match first:
                case Some(v):
                    self.bind(var_id, v)
                case None:
                    pass
            # a range loop's invariant describes states between iterations
            # lo..=hi(+1); it need only hold initially when the range is a valid interval
            var valid = F.True
            match dom:
                case D.Range(lo, hi, incl):
                    if incl:
                        valid = F.le(lo, hi.add_c(1).unwrap_or(hi))
                    else:
                        valid = F.le(lo, hi)
                case _:
                    pass
            self.check_entry_invs(invs, valid)
            if self.live:
                self.st.env.remove(var_id)
                match saved:
                    case Some(v):
                        self.st.env[var_id] = v
                    case None:
                        pass
        let mono = self.mono_starts(body, None)
        self.havoc(body)
        self.mono_facts(mono)
        let head = self.cur()
        # bind the loop variable
        var v = V.Opaque
        var next: Option[V] = None
        match dom:
            case D.Range(lo, hi, incl):
                var ik = IntTy.I64
                match vty:
                    case Ty.Int(x):
                        ik = x
                    case _:
                        pass
                let i = self.fresh_int(vname, ik)
                self.assume(F.le(lo, i))
                self.assume(F.le(i, hi) if incl else F.lt(i, hi))
                match i.add_c(1):
                    case Some(n):
                        next = Some(V.Int(n))
                    case None:
                        pass
                v = V.Int(i)
                # x0 <= x and x + lo <= k + x0 (see `counters`)
                for c, c0 in starts:
                    match self.st.env.get(c):
                        case Some(V.Int(x)):
                            self.assume(F.le(c0, x))
                            match (x.add(lo), i.add(c0)):
                                case (Some(l), Some(r)):
                                    self.assume(F.le(l, r))
                                case _:
                                    pass
                        case _:
                            pass
            case D.Stepped(lo, hi, step):
                var ik = IntTy.I64
                match vty:
                    case Ty.Int(x):
                        ik = x
                    case _:
                        pass
                let i = self.fresh_int(vname, ik)
                match step:
                    case Some(s):
                        if s > 0:
                            self.assume(F.le(lo, i))
                            self.assume(F.lt(i, hi))
                        elif s < 0:
                            self.assume(F.lt(hi, i))
                            self.assume(F.le(i, lo))
                    case None:
                        pass
                v = V.Int(i)
            case D.Arr(c, l, elem):
                let kx = self.fresh_nonneg("index of " + vname)
                self.assume(F.lt(kx, l))
                v = self.sel(c, kx, elem)
            case D.Other:
                v = self.fresh_val(vty, vname)
        self.bind(var_id, v)
        for inv in invs:
            let f = self.spec_cond(inv)
            self.assume(f)
        var is_range = false
        match dom:
            case D.Range(_, _, _):
                is_range = true
            case _:
                pass
        var nx: Option[(int, V)] = None
        if is_range and next.is_some():
            nx = Some((var_id, next.unwrap()))
        elif len(invs) > 0:
            # the invariant must hold for whatever the next element is
            nx = Some((var_id, self.fresh_val(vty, vname)))
        self.loops.push(LoopCx(invs=invs, next=nx, breaks=[]))
        self.block(body)
        let end = body.stmts[len(body.stmts) - 1].span if len(body.stmts) > 0 else body.span
        self.check_preserved(end)
        let cx = self.loops.pop()
        # after the loop
        self.put(head)
        var out: Option[St] = None
        if len(invs) == 0:
            out = self.take()
        elif is_range:
            # either no iterations, or all of them ran and the invariant holds at the end
            var empty = entry
            empty.facts.push(nonempty.not_())
            match last:
                case Some(lv):
                    self.bind(var_id, lv)
                case None:
                    pass
            self.assume(nonempty)
            for inv in invs:
                let f = self.spec_cond(inv)
                self.assume(f)
            if self.live:
                self.st.env.remove(var_id)
            let full = self.take()
            out = self.merge(Some(empty), full, k)
        else:
            for inv in invs:
                let f = self.spec_cond(inv)
                self.assume(f)
            out = self.take()
        for br in cx.breaks:
            out = self.merge(out, Some(br), k)
        self.put(out)

    # ------------------------------------------------------------ lvalues
    # `insert`: `e` is assigned with `=`, so if it's `m[k]` the key needn't exist.
    fn lvalue_path(ref self, e: Expr, insert: bool) -> Option[(int, [(Step, Ty)])]:
        match e.kind:
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        return Some((id, []))
                    case _:
                        return None
            case ExprKind.Field(b, _, _):
                let (r, p0) = self.lvalue_path(b, false)?
                var p = p0
                p.push((Step.Field(e.idx), e.ty))
                return Some((r, p))
            case ExprKind.Index(b, idx):
                let iv = self.eval(idx)
                let i = self.as_int(iv, idx.ty)
                let (r, p0) = self.lvalue_path(b, false)?
                var p = p0
                let base = self.read_path(r, p)
                match base:
                    case V.Arr(_, l):
                        let g = F.and_([F.ge(i), F.lt(i, l)])
                        self.implicit(e.span, TAG_INDEX, g, "index bounds check")
                    case _:
                        if not insert:
                            self.map_key_check(b, e.span)
                p.push((Step.Index(i), e.ty))
                return Some((r, p))
            case _:
                return None

    fn read_path(ref self, root: int, steps: [(Step, Ty)]) -> V:
        var v = self.lookup(root, self.local_ty(root))
        for s, t in steps:
            var nv = V.Opaque
            var done = false
            match (s, v):
                case (Step.Field(k), V.Agg(vs)):
                    if k < len(vs):
                        nv = vs[k]
                        done = true
                case (Step.Index(i), V.Arr(c, _)):
                    nv = self.sel(c, i, t)
                    done = true
                case _:
                    pass
            if not done:
                nv = self.fresh_val(t, "?")
            v = nv
        return v

    fn write_path(ref self, old: V, steps: [(Step, Ty)], new: V) -> V:
        if len(steps) == 0:
            return new
        let s = steps[0].0
        let t = steps[0].1
        let rest = steps[1:]
        match (s, old):
            case (Step.Field(k), V.Agg(vs0)):
                if k < len(vs0):
                    var vs = vs0
                    let c = vs[k]
                    vs[k] = self.write_path(c, rest, new)
                    return V.Agg(vs)
                return V.Opaque
            case (Step.Index(i), V.Arr(c, l)):
                let cur = self.sel(c, i, t)
                let ne = self.write_path(cur, rest, new)
                let name = self.content_names[c]
                let c2 = self.fresh_content(name)
                self.define_sel(c2, i, t, ne)
                return V.Arr(c2, l)
            case _:
                return V.Opaque

    # ------------------------------------------------------------ expressions
    fn cond(ref self, e: Expr) -> F:
        let v = self.eval(e)
        return self.as_bool(v)

    # ------------------------------------------------------------ bounds
    # Constant bounds of `l` from the atoms' ranges and the facts here that
    # bound one atom alone: cheap, and enough for products and bit operations.
    fn bounds(self, l: Lin) -> (Option[i128], Option[i128]):
        var lo: Option[i128] = Some(l.c)
        var hi: Option[i128] = Some(l.c)
        for a, k in l.t:
            let ab = self.atom_bounds(a)
            if k > 0:
                lo = add_opt(lo, mul_opt(k, ab.0))
                hi = add_opt(hi, mul_opt(k, ab.1))
            else:
                lo = add_opt(lo, mul_opt(k, ab.1))
                hi = add_opt(hi, mul_opt(k, ab.0))
        if len(l.t) > 1:
            var b = (lo, hi)
            if self.live:
                for f in self.st.facts:
                    b = tighten_lin(f, l, b)
            for f in self.defs:
                b = tighten_lin(f, l, b)
            return b
        return (lo, hi)

    fn atom_bounds(self, a: int) -> (Option[i128], Option[i128]):
        var b: (Option[i128], Option[i128]) = (None, None)
        if a < len(self.ranges):
            match self.ranges[a]:
                case Some(r):
                    b = (Some(r.0), Some(r.1))
                case None:
                    pass
        if self.live:
            for f in self.st.facts:
                b = tighten(f, a, b)
        for f in self.defs:
            b = tighten(f, a, b)
        return b

    fn assume_bounds(ref self, l: Lin, b: (Option[i128], Option[i128])):
        match b.0:
            case Some(x):
                self.assume(F.le(Lin.konst(x), l))
            case None:
                pass
        match b.1:
            case Some(x):
                self.assume(F.le(l, Lin.konst(x)))
            case None:
                pass

    fn arith_val(ref self, op: BinOp, a: Lin, b: Lin, k: IntTy) -> V:
        var r: Option[Lin] = None
        let small = k.bits() <= 64
        match op:
            case BinOp.Add:
                r = a.add(b)
            case BinOp.Sub:
                r = a.sub(b)
            case BinOp.Mul:
                match a.is_const():
                    case Some(c):
                        r = b.scale(c)
                    case None:
                        match b.is_const():
                            case Some(c):
                                r = a.scale(c)
                            case None:
                                let t = Term.Mul(a, b) if lin_le(a, b) else Term.Mul(b, a)
                                let p = Lin.atom(self.term(t, None))
                                var pb = mul_bounds(self.bounds(a), self.bounds(b))
                                if lin_key(a) == lin_key(b) and not nonneg(pb):
                                    pb = (Some(0), pb.1)
                                self.assume_bounds(p, pb)
                                r = Some(p)
            case BinOp.Div | BinOp.Mod:
                var q: Option[Lin] = None
                match b.is_const():
                    case Some(c):
                        if c > 0:
                            q = Some(Lin.atom(self.term(Term.Div(a, Lin.konst(c)), None)))
                        elif c < 0 and wrapping_neg(c) > 0:
                            # floor(a / c) == floor(-a / -c)
                            match a.neg():
                                case Some(na):
                                    q = Some(
                                        Lin.atom(
                                            self.term(
                                                Term.Div(na, Lin.konst(wrapping_neg(c))),
                                                None
                                            )
                                        )
                                    )
                                case None:
                                    pass
                    case None:
                        pass
                match q:
                    case Some(qq):
                        if op == BinOp.Div:
                            r = Some(qq)
                        else:
                            match qq.scale(b.c):
                                case Some(bq):
                                    r = a.sub(bq)
                                case None:
                                    r = None
                    case None:
                        if b.is_const().is_none():
                            r = Some(self.div_var(op, a, b))
            case BinOp.BitAnd:
                if small:
                    for x, y in [(a, b), (b, a)]:
                        match y.is_const():
                            case Some(c):
                                if c == -1:
                                    return V.Int(x)
                                # in two's complement the low k bits are x mod 2^k
                                if c > 0 and log2_exact(c + 1) > 0:
                                    return self.arith_val(BinOp.Mod, x, Lin.konst(c + 1), k)
                                if c < 0 and log2_exact(-c) > 0:
                                    match self.arith_val(BinOp.Mod, x, Lin.konst(-c), k):
                                        case V.Int(ml):
                                            match x.sub(ml):
                                                case Some(d):
                                                    return V.Int(d)
                                                case None:
                                                    pass
                                        case _:
                                            pass
                            case None:
                                pass
                let v = Lin.atom(self.new_atom(self.op_name(" & ", a, b), int_range(k)))
                for x in [a, b]:
                    if nonneg(self.bounds(x)):
                        self.assume(F.ge(v))
                        self.assume(F.le(v, x))
                return V.Int(v)
            case BinOp.BitOr | BinOp.BitXor:
                let nm = self.op_name(" | " if op == BinOp.BitOr else " ^ ", a, b)
                let v = Lin.atom(self.new_atom(nm, int_range(k)))
                let ab = self.bounds(a)
                let bb = self.bounds(b)
                if nonneg(ab) and nonneg(bb):
                    self.assume(F.ge(v))
                    match a.add(b):
                        case Some(s):
                            self.assume(F.le(v, s))
                        case None:
                            pass
                    if op == BinOp.BitOr:
                        self.assume(F.le(a, v))
                        self.assume(F.le(b, v))
                    match (ab.1, bb.1):
                        case (Some(x), Some(y)):
                            if max(x, y) < 4611686018427387904:
                                self.assume(F.le(v, Lin.konst(ones_above(max(x, y)))))
                        case _:
                            pass
                return V.Int(v)
            case BinOp.Shr:
                match b.is_const():
                    case Some(c):
                        # an arithmetic shift is floor division
                        if small and 0 <= c < i128(k.bits()) and c <= 62:
                            if c == 0:
                                return V.Int(a)
                            let one: i128 = 1
                            return self.arith_val(BinOp.Div, a, Lin.konst(one << c), k)
                    case None:
                        pass
                let v = Lin.atom(self.new_atom(self.op_name(" >> ", a, b), int_range(k)))
                let ab = self.bounds(a)
                if nonneg(ab):
                    self.assume(F.ge(v))
                    self.assume(F.le(v, a))
                else:
                    match ab.1:
                        case Some(x):
                            if x < 0:
                                self.assume(F.le(a, v))
                                self.assume(F.lt(v, Lin.konst(0)))
                        case None:
                            pass
                return V.Int(v)
            case BinOp.Shl:
                match b.is_const():
                    case Some(c):
                        # it wraps: exact only when the product fits
                        if small and 0 <= c < i128(k.bits()) and c <= 62:
                            let one: i128 = 1
                            match a.scale(one << c):
                                case Some(p):
                                    let ab = self.bounds(a)
                                    let pb = (mul_opt(one << c, ab.0), mul_opt(one << c, ab.1))
                                    match (pb.0, pb.1):
                                        case (Some(x), Some(y)):
                                            if k.min() <= x and y <= k.max():
                                                return V.Int(p)
                                        case _:
                                            pass
                                case None:
                                    pass
                    case None:
                        pass
                return V.Int(Lin.atom(self.new_atom(self.op_name(" << ", a, b), int_range(k))))
            case _:
                return V.Int(self.fresh_int("?", k))
        return V.Int(self.lin(r, "?"))

    # `a / b` or `a % b` for a `b` that isn't a constant
    fn div_var(ref self, op: BinOp, a: Lin, b: Lin) -> Lin:
        let bb = self.bounds(b)
        var is_pos = bb.0.is_some() and bb.0.unwrap() >= 1
        var is_neg = bb.1.is_some() and bb.1.unwrap() <= -1
        if not is_pos and not is_neg:
            is_pos = self.holds(F.le(Lin.konst(1), b))
            if not is_pos:
                is_neg = self.holds(F.le(b, Lin.konst(-1)))
        if op == BinOp.Mod:
            let m = Lin.atom(self.term(Term.Mod(a, b), None))
            # `%` takes the sign of the divisor
            if is_pos:
                self.assume(F.ge(m))
                self.assume(F.lt(m, b))
            elif is_neg:
                self.assume(F.lt(b, m))
                self.assume(F.le(m, Lin.konst(0)))
            return m
        let q = Lin.atom(self.term(Term.Div(a, b), None))
        if is_pos:
            let ab = self.bounds(a)
            if nonneg(ab):
                self.assume(F.ge(q))
                self.assume(F.le(q, a))
            else:
                match ab.1:
                    case Some(x):
                        if x < 0:
                            self.assume(F.le(a, q))
                            self.assume(F.lt(q, Lin.konst(0)))
                    case None:
                        pass
        return q

    fn op_name(self, op: str, a: Lin, b: Lin) -> str:
        return self.show_lin_p(a) + op + self.show_lin_p(b)

    fn eval(ref self, e: Expr) -> V:
        match e.kind:
            case ExprKind.Int(v):
                match e.ty:
                    case Ty.Int(_):
                        return V.Int(Lin.konst(v))
                    case _:
                        return V.Opaque
            # the prover's numbers stop at the i128 range: past it, only the type's range is known
            case ExprKind.UInt(_):
                return V.Int(self.fresh_int("literal", IntTy.U128))
            case ExprKind.Float(_):
                return V.Opaque
            case ExprKind.Bool(b):
                return V.Bool(F.from_bool(b))
            case ExprKind.Str(s):
                return V.Str(Lin.konst(i128(len(s))))
            case ExprKind.FStr(segs):
                for s in segs:
                    match s:
                        case FSeg.Part(x, _):
                            self.eval(x)
                        case _:
                            pass
                return V.Str(self.fresh_len("len(f-string)"))
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        return self.lookup(id, e.ty)
                    case Res.Const(id):
                        return self.const_val(id)
                    case _:
                        return V.Opaque
            case ExprKind.Try(x):
                self.eval(x)
                # the path where `x` is `None`/`Err` returns here
                if self.live:
                    let saved = self.cur()
                    self.check_ensures(None, e.span)
                    self.put(saved)
                return self.fresh_val(e.ty, "?")
            case ExprKind.Unary(op, x):
                let v = self.eval(x)
                match (op, e.ty):
                    case (UnOp.Neg, Ty.Int(k)):
                        let l = self.as_int(v, x.ty)
                        let n = self.lin(l.neg(), "?")
                        self.kept(e.span, in_range(n, k), "overflow check")
                        return V.Int(n)
                    case (UnOp.Not, _):
                        let f = self.as_bool(v)
                        return V.Bool(f.not_())
                    case (UnOp.BitNot, Ty.Int(k)):
                        # two's complement: ~x is -x - 1, or 2^bits - 1 - x unsigned
                        let l = self.as_int(v, x.ty)
                        if k.bits() <= 64:
                            let top: i128 = -1 if k.signed() else k.max()
                            match Lin.konst(top).sub(l):
                                case Some(n):
                                    return V.Int(n)
                                case None:
                                    pass
                        return V.Int(self.fresh_int("~" + self.show_lin_p(l), k))
                    case _:
                        return V.Opaque
            case ExprKind.Binary(op, l, r):
                return self.binary(e, op, l, r)
            case ExprKind.Compare(first, rest):
                var prev = self.eval(first)
                var pt = first.ty
                var fs: [F] = []
                var forks: [(Fork, F)] = []
                for op, x in rest:
                    if len(fs) > 0:
                        # `x` runs only while the comparisons so far hold
                        let g = fs[len(fs) - 1]
                        match self.fork():
                            case Some(fk):
                                forks.push((fk, g))
                                self.assume(g)
                            case None:
                                pass
                    let v = self.eval(x)
                    var f = F.True
                    var done = false
                    match (prev, v):
                        case (V.Int(a), V.Int(b)):
                            match op:
                                case CmpOp.Eq:
                                    f = F.equal(a, b)
                                case CmpOp.Ne:
                                    f = F.equal(a, b).not_()
                                case CmpOp.Lt:
                                    f = F.lt(a, b)
                                case CmpOp.Le:
                                    f = F.le(a, b)
                                case CmpOp.Gt:
                                    f = F.lt(b, a)
                                case CmpOp.Ge:
                                    f = F.le(b, a)
                            done = true
                        case (V.Bool(a), V.Bool(b)):
                            if pt == Ty.Bool and (op == CmpOp.Eq or op == CmpOp.Ne):
                                let eq = bool_eq(a, b)
                                f = eq if op == CmpOp.Eq else eq.not_()
                                done = true
                        case _:
                            pass
                    if not done:
                        f = self.fresh_bool("?")
                    fs.push(f)
                    prev = v
                    pt = x.ty
                # the paths that stopped early, innermost first
                var j = len(forks)
                while j > 0:
                    j -= 1
                    let (fk, g) = forks[j]
                    let s1 = self.take()
                    var other = fk.base
                    let ng = g.not_()
                    if ng != F.True:
                        other.facts.push(ng)
                    let joined = self.join(fk, s1, g, Some(other), ng)
                    self.put(joined)
                return V.Bool(F.and_(fs))
            case ExprKind.IfElse(cond, then, els):
                let c = self.cond(cond)
                let nc = c.not_()
                match self.fork():
                    case Some(fk):
                        self.assume(c)
                        let a = self.eval(then)
                        let s1 = self.take()
                        var other = fk.base
                        if nc != F.True:
                            other.facts.push(nc)
                        self.put(Some(other))
                        let b = self.eval(els)
                        let s2 = self.take()
                        let joined = self.join(fk, s1, c, s2, nc)
                        self.put(joined)
                        return self.ite(c, a, b, e.ty)
                    case None:
                        let s1 = self.begin_assume(c)
                        let a = self.eval(then)
                        self.end_assume(s1)
                        let s2 = self.begin_assume(nc)
                        let b = self.eval(els)
                        self.end_assume(s2)
                        return self.ite(c, a, b, e.ty)
            case ExprKind.Call(_, args):
                match e.cres:
                    case CallRes.Fn(id):
                        return self.call_user(id, None, args, e)
                    case CallRes.Method(id):
                        return self.call_user(id, None, args, e)
                    case CallRes.Ctor(sid):
                        let fields = self.info.structs[sid].fields
                        var vals: [V] = [V.Opaque] * len(fields)
                        for i, a in enumerate(args):
                            let v = self.eval(a.expr)
                            var idx = i
                            match a.name:
                                case Some((n, _)):
                                    for j, fd in enumerate(fields):
                                        if fd.0 == n:
                                            idx = j
                                            break
                                case None:
                                    pass
                            if idx < len(vals):
                                vals[idx] = v
                        return V.Agg(vals)
                    case CallRes.Builtin(b):
                        return self.builtin(b, None, args, e)
                    case CallRes.Reduce(r):
                        return self.reduce(r, args[0].expr, e)
                    case CallRes.Convert(t):
                        return self.convert(t, args[0].expr, e)
                    case _:
                        for a in args:
                            self.eval(a.expr)
                        self.ref_args(args)
                        return self.fresh_val(e.ty, "?")
            case ExprKind.MethodCall(recv, _, _, args):
                match e.cres:
                    case CallRes.Fn(id):
                        return self.call_user(id, None, args, e)
                    case CallRes.Method(id):
                        return self.call_user(id, Some(recv), args, e)
                    case CallRes.Builtin(b):
                        return self.builtin(b, Some(recv), args, e)
                    case CallRes.World(op):
                        for a in args:
                            self.eval(a.expr)
                        match op:
                            case WorldOp.Rank:
                                return V.Int(Lin.atom(self.term(Term.Rank, nonneg_range())))
                            case WorldOp.Size:
                                return V.Int(Lin.atom(self.term(Term.Size, pos_range())))
                            # one element per rank
                            case WorldOp.GatherAll | WorldOp.Exchange:
                                let nm = self.name_of(e)
                                let c = self.fresh_content(nm)
                                return V.Arr(c, Lin.atom(self.term(Term.Size, pos_range())))
                            case _:
                                let nm = self.name_of(e)
                                return self.fresh_val(e.ty, nm)
                    # opaque: `os` itself is the receiver, only the arguments are evaluated
                    case CallRes.Os(_):
                        for a in args:
                            self.eval(a.expr)
                        let nm = self.name_of(e)
                        return self.fresh_val(e.ty, nm)
                    case _:
                        self.eval(recv)
                        for a in args:
                            self.eval(a.expr)
                        self.ref_args(args)
                        return self.fresh_val(e.ty, "?")
            case ExprKind.Field(b, _, _):
                match e.res:
                    case Res.Const(id):
                        return self.const_val(id)
                    case Res.Variant(_, _):
                        return V.Opaque
                    case _:
                        pass
                match self.eval(b):
                    case V.Agg(vs):
                        if e.idx < len(vs):
                            return vs[e.idx]
                    case _:
                        pass
                return self.fresh_val(e.ty, "?")
            case ExprKind.Index(b, idx):
                let bv = self.eval(b)
                let iv = self.eval(idx)
                let i = self.as_int(iv, idx.ty)
                match bv:
                    case V.Arr(c, l):
                        if not self.spec:
                            let g = F.and_([F.ge(i), F.lt(i, l)])
                            self.implicit(e.span, TAG_INDEX, g, "index bounds check")
                        return self.sel(c, i, e.ty)
                    case V.Str(l):
                        if not self.spec:
                            let g = F.and_([F.ge(i), F.lt(i, l)])
                            self.implicit(e.span, TAG_INDEX, g, "index bounds check")
                        return V.Str(Lin.konst(1))
                    case _:
                        self.map_key_check(b, e.span)
                        return self.fresh_val(e.ty, "?")
            case ExprKind.Slice(b, lo, hi):
                return self.slice(e, b, lo, hi)
            case ExprKind.Map(kvs):
                for k, v in kvs:
                    self.eval(k)
                    self.eval(v)
                return V.Opaque
            case ExprKind.Contains(item, coll, _):
                self.eval(item)
                self.eval(coll)
                return V.Bool(self.fresh_bool("in"))
            case ExprKind.Array(es):
                var vals: [V] = []
                for x in es:
                    vals.push(self.eval(x))
                let c = self.ranged_content("[...]", vals)
                let et = e.ty.elem()
                for i, v in enumerate(vals):
                    self.define_sel(c, Lin.konst(i128(i)), et, v)
                return V.Arr(c, Lin.konst(i128(len(es))))
            case ExprKind.Repeat(elem, count):
                let ev = self.eval(elem)
                let nv = self.eval(count)
                let n = self.as_int(nv, count.ty)
                self.kept(e.span, F.ge(n), "array length check")
                self.cap_len(n)
                return V.Arr(self.ranged_content("[...]", [ev]), n)
            case ExprKind.Tuple(es):
                return self.agg(es)
            case ExprKind.ParTuple(es):
                return self.agg(es)
            case ExprKind.Comp(c):
                let l = self.comp(c, e.local)
                return V.Arr(self.fresh_content("[...]"), l)
            case _:
                return V.Opaque

    fn agg(ref self, es: [Expr]) -> V:
        var vals: [V] = []
        for x in es:
            vals.push(self.eval(x))
        return V.Agg(vals)

    fn binary(ref self, e: Expr, op: BinOp, l: Expr, r: Expr) -> V:
        if op == BinOp.And or op == BinOp.Or:
            let a = self.cond(l)
            let and_ = op == BinOp.And
            let guard = a if and_ else a.not_()
            let bv = self.eval_when(guard, r)
            let b = self.as_bool(bv)
            return V.Bool(F.and_([a, b]) if and_ else F.or_([a, b]))
        let av = self.eval(l)
        let bv = self.eval(r)
        match e.ty:
            case Ty.Int(k):
                let a = self.as_int(av, l.ty)
                let b = self.as_int(bv, r.ty)
                if (op == BinOp.Div or op == BinOp.Mod) and e.checked:
                    let what = "division check" if op == BinOp.Div else "remainder check"
                    self.implicit(e.span, TAG_ARITH, div_goal(op, a, b, k), what)
                if (op == BinOp.Shl or op == BinOp.Shr) and e.checked:
                    self.implicit(e.span, TAG_ARITH, shift_goal(b, k), "shift check")
                let v = self.arith_val(op, a, b, k)
                match v:
                    case V.Int(res):
                        let f = in_range(res, k)
                        if (op == BinOp.Add or op == BinOp.Sub or op == BinOp.Mul) and e.checked:
                            self.implicit(e.span, TAG_ARITH, f, "overflow check")
                        elif not self.spec:
                            self.assume(f)
                    case _:
                        pass
                return v
            case Ty.Str:
                match (av, bv):
                    case (V.Str(x), V.Str(y)):
                        let n = self.lin(x.add(y), "len(?)")
                        self.cap_len(n)
                        return V.Str(n)
                    # `s * n`: the length is a product
                    case (V.Str(x), V.Int(c)):
                        self.kept(e.span, F.ge(c), "repeat count check")
                        return V.Str(self.repeat_len(x, c))
                    case _:
                        return V.Str(self.fresh_len("len(?)"))
            # `xs + ys`: new contents, the two lengths added
            case Ty.Array(_):
                match (av, bv):
                    case (V.Arr(_, x), V.Arr(_, y)):
                        let n = self.lin(x.add(y), "len(?)")
                        self.cap_len(n)
                        return V.Arr(self.fresh_content("?"), n)
                    case _:
                        return self.fresh_val(e.ty, "?")
            case _:
                return V.Opaque

    # The length of `n` copies of something `x` long (none when `n` < 0).
    fn repeat_len(ref self, x: Lin, n: Lin) -> Lin:
        let r = self.fresh_len("len(?)")
        match n.is_const():
            case Some(c):
                if c <= 0:
                    self.assume(F.equal(r, Lin.konst(0)))
                    return r
                match x.scale(c):
                    case Some(p):
                        self.assume(F.equal(r, p))
                    case None:
                        pass
            case None:
                pass
        return r

    fn slice(ref self, e: Expr, b: Expr, lo0: Option[Expr], hi0: Option[Expr]) -> V:
        let bv = self.eval(b)
        var lo = Lin.konst(0)
        match lo0:
            case Some(x):
                let v = self.eval(x)
                lo = self.as_int(v, int_ty())
            case None:
                pass
        var hi: Option[Lin] = None
        match hi0:
            case Some(x):
                let v = self.eval(x)
                hi = Some(self.as_int(v, int_ty()))
            case None:
                pass
        var l = Lin.konst(0)
        var is_str = false
        match bv:
            case V.Arr(_, x):
                l = x
            case V.Str(x):
                l = x
                is_str = true
            case _:
                return self.fresh_val(e.ty, "slice")
        let h = hi.unwrap_or(l)
        if not self.spec:
            let g = F.and_([F.ge(lo), F.le(lo, h), F.le(h, l)])
            self.implicit(e.span, TAG_INDEX, g, "slice bounds check")
        let n = self.lin(h.sub(lo), "len(slice)")
        if is_str:
            return V.Str(n)
        return V.Arr(self.fresh_content("slice"), n)

    fn const_val(ref self, id: int) -> V:
        let c = self.info.consts[id]
        match c.value:
            case ConstVal.Int(v):
                match c.ty:
                    case Ty.Int(_):
                        return V.Int(Lin.konst(v))
                    case _:
                        return V.Opaque
            case ConstVal.UInt(_):
                return V.Int(self.fresh_int(c.name, IntTy.U128))
            case ConstVal.Bool(b):
                return V.Bool(F.from_bool(b))
            case ConstVal.Str(s):
                return V.Str(Lin.konst(i128(len(s))))
            case ConstVal.Float(_):
                return V.Opaque

    fn ite(ref self, c: F, a: V, b: V, ty: Ty) -> V:
        if a == b:
            return a
        match (a, b):
            case (V.Bool(x), V.Bool(y)):
                return V.Bool(F.or_([F.and_([c, x]), F.and_([c.not_(), y])]))
            case (V.Agg(xs), V.Agg(ys)):
                if len(xs) == len(ys):
                    var tys: [Ty] = [Ty.Unknown] * len(xs)
                    match ty:
                        case Ty.Tuple(ts):
                            tys = ts
                        case Ty.Struct(sid):
                            tys = [f.1 for f in self.info.structs[sid].fields]
                        case _:
                            pass
                    var out: [V] = []
                    for i in 0..min(len(xs), len(tys)):
                        out.push(self.ite(c, xs[i], ys[i], tys[i]))
                    return V.Agg(out)
            case _:
                pass
        let r = self.fresh_val(ty, "?")
        match (val_eq(r, a), val_eq(r, b)):
            case (Some(fa), Some(fb)):
                self.defs.push(F.or_([F.and_([c, fa]), F.and_([c.not_(), fb])]))
            case _:
                pass
        return r

    # Analyze a comprehension's body; returns the length of the produced sequence.
    fn comp(ref self, c: Comp, local: int) -> Lin:
        let vname = self.local_name(local)
        let vty = self.local_ty(local)
        var ik = IntTy.I64
        match vty:
            case Ty.Int(x):
                ik = x
            case _:
                pass
        var extra: [F] = []
        var v = V.Opaque
        var count: Option[Lin] = None
        var done = false
        match c.iter.kind:
            case ExprKind.Range(lo, hi, inclusive):
                let av = self.eval(lo)
                let a = self.as_int(av, lo.ty)
                let bv = self.eval(hi)
                let b = self.as_int(bv, hi.ty)
                let i = self.fresh_int(vname, ik)
                extra.push(F.le(a, i))
                extra.push(F.le(i, b) if inclusive else F.lt(i, b))
                let n = self.fresh_nonneg("count")
                var span: Option[Lin] = None
                if inclusive:
                    match b.add_c(1):
                        case Some(b1):
                            span = b1.sub(a)
                        case None:
                            pass
                else:
                    span = b.sub(a)
                match span:
                    case Some(sp):
                        let ne = F.le(a, b) if inclusive else F.lt(a, b)
                        self.defs.push(
                            F.or_([F.and_([ne, F.equal(n, sp)]), F.and_([ne.not_(), F.eq(n)])])
                        )
                    case None:
                        pass
                v = V.Int(i)
                count = Some(n)
                done = true
            case ExprKind.Call(_, args):
                if c.iter.cres == CallRes.Range:
                    var vals: [Lin] = []
                    for a in args:
                        let x = self.eval(a.expr)
                        vals.push(self.as_int(x, a.expr.ty))
                    let i = self.fresh_int(vname, ik)
                    if len(vals) <= 2:
                        var lo = Lin.konst(0)
                        var hi = vals[0]
                        if len(vals) == 2:
                            lo = vals[0]
                            hi = vals[1]
                        extra.push(F.le(lo, i))
                        extra.push(F.lt(i, hi))
                    v = V.Int(i)
                    done = true
            case _:
                pass
        if not done:
            match self.eval(c.iter):
                case V.Arr(content, l):
                    let kx = self.fresh_nonneg("index of " + vname)
                    extra.push(F.lt(kx, l))
                    let et = c.iter.ty.elem()
                    v = self.sel(content, kx, et)
                    count = Some(l)
                case _:
                    v = self.fresh_val(vty, vname)
        # the body and filter run once per element, like a loop body: what
        # they change is unknown in each run and after the last
        var effs: [Eff] = []
        effs_expr(c.body, self.info, ref effs)
        match c.filter:
            case Some(fl):
                effs_expr(fl, self.info, ref effs)
            case None:
                pass
        self.havoc_mods(resolve_effs(effs, self.fps))
        let head = self.cur()
        let s = self.begin_assume(F.and_(extra))
        self.bind(local, v)
        match c.filter:
            case Some(fl):
                let fc = self.cond(fl)
                let s2 = self.begin_assume(fc)
                self.eval(c.body)
                self.end_assume(s2)
            case None:
                self.eval(c.body)
        self.end_assume(s)
        if len(effs) > 0 and head.is_some():
            self.put(head)
        match count:
            case Some(n):
                if c.filter.is_none():
                    return n
                let m = self.fresh_nonneg("count")
                self.defs.push(F.le(m, n))
                return m
            case None:
                return self.fresh_nonneg("count")

    fn reduce(ref self, r: Reducer, arg: Expr, e: Expr) -> V:
        match arg.kind:
            case ExprKind.Comp(c):
                self.comp(c, arg.local)
            case _:
                self.eval(arg)
        let nm = self.name_of(e)
        match r:
            case Reducer.Any | Reducer.All:
                return V.Bool(self.fresh_bool(nm))
            case _:
                return self.fresh_val(e.ty, nm)

    fn convert(ref self, target: Ty, a: Expr, whole: Expr) -> V:
        let v = self.eval(a)
        match (target, a.ty, v):
            case (Ty.Int(k), Ty.Int(src), V.Int(l)):
                # a narrowing conversion is checked
                let widens = k.signed() == src.signed() and k.bits() >= src.bits()
                if widens or (k.signed() and not src.signed() and k.bits() > src.bits()):
                    return V.Int(l)
                self.kept(whole.span, in_range(l, k), "conversion check")
                return V.Int(l)
            case (Ty.Int(_), Ty.Float(_), _):
                # in range and not NaN: checked
                if not self.spec and self.live:
                    self.remaining.push((whole.span, "conversion check"))
                return self.fresh_val(target, self.name_of(whole))
            case (Ty.Int(_), Ty.Bool, V.Bool(b)):
                let r = self.fresh_int("int(bool)", IntTy.I64)
                self.defs.push(
                    F.or_([F.and_([b, F.equal(r, Lin.konst(1))]), F.and_([b.not_(), F.eq(r)])])
                )
                return V.Int(r)
            case (Ty.Str, Ty.Str, _):
                return v
            case _:
                let nm = self.name_of(whole)
                return self.fresh_val(target, nm)

    fn builtin(ref self, b: Builtin, recv: Option[Expr], args: [Arg], e: Expr) -> V:
        if b == Builtin.Push or b == Builtin.Pop:
            if recv.is_none():
                return V.Opaque
            let r = recv.unwrap()
            if b == Builtin.Push:
                self.eval(args[0].expr)
            match self.lvalue_path(r, false):
                case None:
                    self.eval(r)
                    return self.fresh_val(e.ty, "?")
                case Some((root, steps)):
                    let cur = self.read_path(root, steps)
                    match cur:
                        case V.Arr(c, l):
                            let name = self.content_names[c]
                            var nlen = l
                            var out = V.Opaque
                            if b == Builtin.Push:
                                nlen = self.lin(l.add_c(1), "len(?)")
                                self.cap_len(nlen)
                            else:
                                self.kept(
                                    e.span,
                                    F.ge(l.add_c(-1).unwrap_or(l)),
                                    "empty array check"
                                )
                                nlen = self.lin(l.add_c(-1), "len(?)")
                                out = self.sel(c, nlen, e.ty)
                            let nv = V.Arr(self.fresh_content(name), nlen)
                            let old = self.lookup(root, self.local_ty(root))
                            let w = self.write_path(old, steps, nv)
                            self.bind(root, w)
                            return out
                        case _:
                            let nv = self.fresh_val(self.local_ty(root), self.local_name(root))
                            self.bind(root, nv)
                            return self.fresh_val(e.ty, "?")
        if b.mutates_recv() and recv.is_some():
            return self.mutate(b, recv.unwrap(), args, e)
        match recv:
            case Some(r):
                self.eval(r)
            case None:
                pass
        var vals: [V] = []
        for a in args:
            vals.push(self.eval(a.expr))
        self.ref_args(args)
        match b:
            case Builtin.Len:
                if len(vals) > 0:
                    match vals[0]:
                        case V.Arr(_, l):
                            return V.Int(l)
                        case V.Str(l):
                            return V.Int(l)
                        case _:
                            pass
                return V.Int(self.fresh_len("len(?)"))
            case Builtin.Abs:
                match e.ty:
                    case Ty.Int(k):
                        let a = self.as_int(vals[0], e.ty)
                        let nm = "abs(" + self.show_lin(a) + ")"
                        let r = Lin.atom(self.new_atom(nm, None))
                        match a.neg():
                            case Some(na):
                                self.defs.push(
                                    F.or_(
                                        [
                                            F.and_([F.ge(a), F.equal(r, a)]),
                                            F.and_([F.lt(a, Lin.konst(0)), F.equal(r, na)])
                                        ]
                                    )
                                )
                            case None:
                                pass
                        if k.signed():
                            self.kept(e.span, in_range(r, k), "overflow check")
                        elif not self.spec:
                            self.assume(in_range(r, k))
                        return V.Int(r)
                    case _:
                        return self.fresh_val(e.ty, "?")
            case Builtin.Min | Builtin.Max:
                match e.ty:
                    case Ty.Int(_):
                        let a = self.as_int(vals[0], e.ty)
                        let c = self.as_int(vals[1], e.ty)
                        let fname = "min" if b == Builtin.Min else "max"
                        let nm = fname + "(" + self.show_lin(a) + ", " + self.show_lin(c) + ")"
                        let r = Lin.atom(self.new_atom(nm, None))
                        let a_first = F.le(a, c) if b == Builtin.Min else F.le(c, a)
                        self.defs.push(
                            F.or_(
                                [
                                    F.and_([a_first, F.equal(r, a)]),
                                    F.and_([a_first.not_(), F.equal(r, c)])
                                ]
                            )
                        )
                        return V.Int(r)
                    case _:
                        return self.fresh_val(e.ty, "?")
            # the file contents, already in place of the path
            case Builtin.Embed:
                return vals[0] if len(vals) > 0 else V.Opaque
            case Builtin.Args:
                let c = self.fresh_content("args()")
                return V.Arr(c, self.fresh_len("len(args())"))
            case Builtin.Chr:
                if len(vals) > 0:
                    let n = self.as_int(vals[0], args[0].expr.ty)
                    let lo: i128 = 55295
                    let hi: i128 = 57344
                    let top: i128 = 1114111
                    let ok = F.or_(
                        [
                            F.and_([F.ge(n), F.le(n, Lin.konst(lo))]),
                            F.and_([F.le(Lin.konst(hi), n), F.le(n, Lin.konst(top))])
                        ]
                    )
                    self.kept(e.span, ok, "character check")
                return self.fresh_val(e.ty, self.name_of(e))
            case Builtin.Str(StrM.Repeat):
                if len(vals) > 0:
                    let n = self.as_int(vals[0], args[0].expr.ty)
                    self.kept(e.span, F.ge(n), "repeat count check")
                return self.fresh_val(e.ty, self.name_of(e))
            # a code point
            case Builtin.Ord:
                if len(vals) > 0:
                    match vals[0]:
                        case V.Str(l):
                            # one byte surely is one character; passing only says
                            # it was one UTF-8 character of 1 to 4 bytes
                            let one = F.equal(l, Lin.konst(1))
                            if not self.spec and self.live and not self.holds(one):
                                self.remaining.push((e.span, "character check"))
                            self.assume(
                                F.and_([F.ge(l.add_c(-1).unwrap_or(l)), F.le(l, Lin.konst(4))])
                            )
                        case _:
                            pass
                let r = self.fresh_nonneg("ord(...)")
                let top: i128 = 1114111
                self.assume(F.le(r, Lin.konst(top)))
                return V.Int(r)
            # a count of bits: between 0 and the receiver's width
            case Builtin.Num(
                NumM.CountOnes
            ) | Builtin.Num(NumM.LeadingZeros) | Builtin.Num(NumM.TrailingZeros):
                var w: i128 = 128
                match recv:
                    case Some(r):
                        match r.ty:
                            case Ty.Int(k):
                                w = i128(k.bits())
                            case _:
                                pass
                    case None:
                        pass
                let z: i128 = 0
                return V.Int(Lin.atom(self.new_atom(self.name_of(e), Some((z, w)))))
            case _:
                return self.fresh_val(e.ty, "?")

    # A method that changes its receiver in place (`clear`, `sort`, `pop(i)`, ...).
    fn mutate(ref self, b: Builtin, r: Expr, args: [Arg], e: Expr) -> V:
        var vals: [V] = []
        for a in args:
            vals.push(self.eval(a.expr))
        self.ref_args(args)
        var out = self.fresh_val(e.ty, "?")
        match self.lvalue_path(r, false):
            case None:
                # a temporary: nothing else sees the change
                self.eval(r)
                return out
            case Some((root, steps)):
                let cur = self.read_path(root, steps)
                var nv = V.Opaque
                match cur:
                    case V.Arr(c, l):
                        let name = self.content_names[c]
                        var nlen: Option[Lin] = Some(l)
                        match b:
                            case Builtin.Clear:
                                nlen = Some(Lin.konst(0))
                            case Builtin.PopAt:
                                let i = self.as_int(vals[0], args[0].expr.ty)
                                self.kept(
                                    e.span,
                                    F.and_([F.ge(i), F.lt(i, l)]),
                                    "index bounds check"
                                )
                                out = self.sel(c, i, e.ty)
                                nlen = l.add_c(-1)
                            case Builtin.Insert:
                                let i = self.as_int(vals[0], args[0].expr.ty)
                                self.kept(
                                    e.span,
                                    F.and_([F.ge(i), F.le(i, l)]),
                                    "insert index check"
                                )
                                nlen = l.add_c(1)
                            case Builtin.Extend:
                                match vals[0]:
                                    case V.Arr(_, m):
                                        nlen = l.add(m)
                                    case _:
                                        nlen = None
                            case _:
                                # sort, reverse: same length, other order
                                pass
                        var n = Lin.konst(0)
                        match nlen:
                            case Some(x):
                                n = x
                            case None:
                                n = self.fresh_len("len(" + name + ")")
                        self.cap_len(n)
                        nv = V.Arr(self.fresh_content(name), n)
                    case _:
                        nv = self.fresh_val(r.ty, self.name_of(r))
                let old = self.lookup(root, self.local_ty(root))
                let w = self.write_path(old, steps, nv)
                self.bind(root, w)
                return out

    # `ref` arguments of a call the prover doesn't follow may change arbitrarily.
    fn ref_args(ref self, args: [Arg]):
        for a in args:
            if a.by_ref:
                match lvalue_root(a.expr):
                    case Some(root):
                        let nv = self.fresh_val(self.local_ty(root), self.local_name(root))
                        self.bind(root, nv)
                    case None:
                        pass

    # `m[k]` on a map panics when the key is missing (the prover doesn't
    # follow maps' keys).
    fn map_key_check(ref self, m: Expr, span: Span):
        match m.ty:
            case Ty.Map(_, _):
                if not self.spec and self.live:
                    self.remaining.push((span, "map key check"))
            case _:
                pass

    # A runtime check that stays whether or not it's proven: listed in
    # `--report` unless proven; either way it holds afterwards.
    fn kept(ref self, span: Span, goal: F, what: str):
        if self.spec or not self.live:
            return
        if not self.holds(goal):
            self.remaining.push((span, what))
        self.assume(goal)

    fn call_user(ref self, id: int, recv: Option[Expr], args: [Arg], e: Expr) -> V:
        let sig = self.info.fns[id]
        let ret = sig.ret
        var exprs: [Expr] = []
        match recv:
            case Some(r):
                exprs.push(r)
            case None:
                pass
        for a in args:
            exprs.push(a.expr)
        var vals: [V] = []
        for x in exprs:
            vals.push(self.eval(x))
        # the callee sees a `ref` argument as the later arguments left it
        # (`head(ref xs, empty(ref xs))`): read those places again. An indexed
        # place can't change that way (E0405), and keeps the value it was read as.
        for i, p in enumerate(sig.params):
            if p.by_ref and i < len(exprs):
                let steps = lvalue_steps(exprs[i])
                if CONTENT in steps:
                    continue
                match lvalue_root(exprs[i]):
                    case Some(root):
                        let rty = self.local_ty(root)
                        let cur = self.lookup(root, rty)
                        match self.at_path(cur, steps, rty):
                            case Some(nv):
                                vals[i] = nv
                            case None:
                                vals[i] = self.fresh_val(p.ty, self.local_name(root))
                    case None:
                        pass
        let spec = self.specs[id] if 0 <= id < len(self.specs) else None
        var req_ok = true
        match spec:
            case Some(sp):
                var env: {int: V} = {}
                for i in 0..min(len(sp.params), len(vals)):
                    env[sp.params[i]] = vals[i]
                for r in sp.requires:
                    let f = self.spec_cond_in(env, r)
                    if not self.spec and self.live and not self.holds(f):
                        req_ok = false
                        let d = (
                            diag.error("E0601", f"cannot prove the precondition of `{sp.name}`")
                            .label(
                                e.span,
                                "this call might violate `requires " + self.snippet(r.span) + "`"
                            )
                            .label(r.span, "precondition declared here")
                            .with_help(
                                "add an `assert` before the call to check it at runtime, or a `requires` to this function so its callers must prove it"
                            )
                        )
                        self.fail(d, f)
            case None:
                pass
        # mutable arguments may change what the callee's footprint says,
        # arbitrarily (subject to its `ensures`)
        for i, p in enumerate(sig.params):
            if p.by_ref and i < len(exprs):
                match lvalue_root(exprs[i]):
                    case Some(root):
                        let name = self.local_name(root)
                        let rty = self.local_ty(root)
                        let pre = lvalue_steps(exprs[i])
                        var nr = self.lookup(root, rty)
                        for q in footprint(self.fps, id, i):
                            nr = self.havoc_at(nr, join_path(pre, q), rty, name)
                        self.bind(root, nr)
                        match self.at_path(nr, pre, rty):
                            case Some(nv):
                                vals[i] = nv
                            case None:
                                vals[i] = self.fresh_val(p.ty, name)
                    case None:
                        pass
        let nm = self.name_of(e)
        let result = self.fresh_val(ret, nm)
        match spec:
            case Some(sp):
                # after a failed precondition the postcondition may be contradictory;
                # don't let it hide later errors
                if len(sp.ensures) > 0 and req_ok:
                    var env: {int: V} = {}
                    for i in 0..min(len(sp.params), len(vals)):
                        env[sp.params[i]] = vals[i]
                    match sp.result:
                        case Some(r):
                            env[r] = result
                        case None:
                            pass
                    for en in sp.ensures:
                        let f = self.spec_cond_in(env, en)
                        if not self.spec:
                            self.assume(f)
            case None:
                pass
        return result

# `a / b` and `a % b` don't fail: no division by zero, nor `MIN / -1`.
fn div_goal(op: BinOp, a: Lin, b: Lin, k: IntTy) -> F:
    var g = [F.ne(b)]
    if op == BinOp.Div and k.signed():
        let am = a.sub(Lin.konst(k.min()))
        let b1 = b.add_c(1)
        g.push(F.or_([F.ne(am.unwrap_or(a)), F.ne(b1.unwrap_or(b))]))
        if am.is_none() or b1.is_none():
            g.push(F.B(ATOM_UNKNOWN, true))
    return F.and_(g)

# A shift by `b` of a `k` is in range: 0 <= b < bits.
fn shift_goal(b: Lin, k: IntTy) -> F:
    return F.and_([F.ge(b), F.lt(b, Lin.konst(i128(k.bits())))])

# Formula stating `a == b` (when expressible).
fn val_eq(a: V, b: V) -> Option[F]:
    match (a, b):
        case (V.Int(x), V.Int(y)):
            return Some(F.equal(x, y))
        case (V.Bool(x), V.Bool(y)):
            return Some(bool_eq(x, y))
        case (V.Arr(_, x), V.Arr(_, y)):
            return Some(F.equal(x, y))
        case (V.Str(x), V.Str(y)):
            return Some(F.equal(x, y))
        case (V.Agg(xs), V.Agg(ys)):
            if len(xs) != len(ys):
                return None
            var fs: [F] = []
            for i in 0..len(xs):
                match val_eq(xs[i], ys[i]):
                    case Some(f):
                        fs.push(f)
                    case None:
                        pass
            return Some(F.and_(fs))
        case _:
            return None

# ================================================================ bounds
# Constant bounds `(lo, hi)`; None is unbounded.

fn add_opt(a: Option[i128], b: Option[i128]) -> Option[i128]:
    match (a, b):
        case (Some(x), Some(y)):
            return add_i128(x, y)
        case _:
            return None

fn mul_opt(k: i128, a: Option[i128]) -> Option[i128]:
    match a:
        case Some(x):
            return mul_i128(k, x)
        case None:
            return None

# The bounds of `a` tightened by fact `f` when it bounds `a` alone.
fn tighten(f: F, a: int, b: (Option[i128], Option[i128])) -> (Option[i128], Option[i128]):
    var lo = b.0
    var hi = b.1
    match f:
        case F.Ge(l):
            if len(l.t) == 1 and l.t[0].0 == a:
                # k*a + c >= 0
                let k = l.t[0].1
                let c = l.c
                if k > 0:
                    match neg_i128(c / k):
                        case Some(v):
                            if lo.is_none() or v > lo.unwrap():
                                lo = Some(v)
                        case None:
                            pass
                else:
                    match neg_i128(k):
                        case Some(m):
                            let v = c / m
                            if hi.is_none() or v < hi.unwrap():
                                hi = Some(v)
                        case None:
                            pass
        case F.Eq(l):
            if len(l.t) == 1 and l.t[0].0 == a:
                let k = l.t[0].1
                let c = l.c
                if k != -1 and c % k == 0:
                    match neg_i128(c / k):
                        case Some(v):
                            lo = Some(v)
                            hi = Some(v)
                        case None:
                            pass
                elif k == -1:
                    lo = Some(c)
                    hi = Some(c)
        case F.And(xs):
            for x in xs:
                let t = tighten(x, a, (lo, hi))
                lo = t.0
                hi = t.1
        case _:
            pass
    return (lo, hi)

# The bounds of `x * y` for `x` in `a` and `y` in `b`.
fn mul_bounds(
    a: (Option[i128], Option[i128]),
    b: (Option[i128], Option[i128])
) -> (Option[i128], Option[i128]):
    match (a.0, a.1, b.0, b.1):
        case (Some(al), Some(ah), Some(bl), Some(bh)):
            let ps = [mul_i128(al, bl), mul_i128(al, bh), mul_i128(ah, bl), mul_i128(ah, bh)]
            if all(p.is_some() for p in ps):
                var lo = ps[0].unwrap()
                var hi = lo
                for p in ps:
                    lo = min(lo, p.unwrap())
                    hi = max(hi, p.unwrap())
                return (Some(lo), Some(hi))
        case _:
            pass
    match (a.0, b.0):
        case (Some(al), Some(bl)):
            if al >= 0 and bl >= 0:
                return (mul_i128(al, bl), None)
        case _:
            pass
    return (None, None)

fn nonneg(b: (Option[i128], Option[i128])) -> bool:
    match b.0:
        case Some(x):
            return x >= 0
        case None:
            return false

# 2^k - 1 for the smallest k with 2^k > x (0 <= x < 2^62)
fn ones_above(x: i128) -> i128:
    var p: i128 = 1
    while p <= x:
        p *= 2
    return p - 1

# k when c == 2^k (0 < k < 63), else -1
fn log2_exact(c: i128) -> int:
    var p: i128 = 2
    var k = 1
    while p < c and k < 62:
        p *= 2
        k += 1
    return k if p == c else -1

# Do `a`'s terms equal `s` times `b`'s?
fn same_terms(a: Lin, b: Lin, s: i128) -> bool:
    if len(a.t) != len(b.t):
        return false
    for i in 0..len(a.t):
        let k = b.t[i].1
        if a.t[i].0 != b.t[i].0 or wrapping_neg(k) == k:
            return false
        if a.t[i].1 != (k if s > 0 else -k):
            return false
    return true

# The bounds of `l` tightened by fact `f` when it bounds `l`'s terms as a whole.
fn tighten_lin(f: F, l: Lin, b: (Option[i128], Option[i128])) -> (Option[i128], Option[i128]):
    match f:
        case F.Ge(g):
            return tighten_by(g, false, l, b)
        case F.Eq(g):
            return tighten_by(g, true, l, b)
        case F.And(xs):
            var r = b
            for x in xs:
                r = tighten_lin(x, l, r)
            return r
        case _:
            return b

# `g >= 0` (or `g == 0` when `eq`) where `g`'s terms are plus or minus `l`'s
fn tighten_by(
    g: Lin,
    eq: bool,
    l: Lin,
    b: (Option[i128], Option[i128])
) -> (Option[i128], Option[i128]):
    var lo = b.0
    var hi = b.1
    if same_terms(g, l, 1):
        # l's terms >= -g.c
        match neg_i128(g.c):
            case Some(ng):
                match add_i128(l.c, ng):
                    case Some(v):
                        if lo.is_none() or v > lo.unwrap():
                            lo = Some(v)
                        if eq:
                            hi = Some(v)
                    case None:
                        pass
            case None:
                pass
    elif same_terms(g, l, -1):
        # l's terms <= g.c
        match add_i128(l.c, g.c):
            case Some(v):
                if hi.is_none() or v < hi.unwrap():
                    hi = Some(v)
                if eq:
                    lo = Some(v)
            case None:
                pass
    return (lo, hi)

# Monotone locals: those a loop changes only by `x += c` (or only by `x -= c`)
# with constants c >= 0, anywhere in its body. An overflow panics, so at the
# start of every iteration and after the loop `x >= x0` (`x <= x0`).
fn monotone(b: Block, cond: Option[Expr], info: ProgramInfo) -> [(int, int)]:
    var dirs: {int: int} = {}
    var other: {int: int} = {}
    match cond:
        case Some(c):
            mods_expr(c, info, ref other)
        case None:
            pass
    count_steps(b, info, ref dirs, ref other)
    var ids: [int] = []
    for id in dirs:
        if dirs[id] != 0 and id not in other:
            ids.push(id)
    ids.sort()
    return [(id, dirs[id]) for id in ids]

fn count_steps(b: Block, info: ProgramInfo, ref dirs: {int: int}, ref other: {int: int}):
    for s in b.stmts:
        match s.kind:
            case StmtKind.Assign(target, op, value):
                match lvalue_root(target):
                    case Some(r):
                        var d = 0
                        match (target.kind, op, value.kind):
                            case (ExprKind.Ident(_), Some(BinOp.Add), ExprKind.Int(v)):
                                if v >= 0:
                                    d = 1
                            case (ExprKind.Ident(_), Some(BinOp.Sub), ExprKind.Int(v)):
                                if v >= 0:
                                    d = -1
                            case _:
                                pass
                        let was = dirs.get(r).unwrap_or(d)
                        if d == 0 or was != d:
                            note_mod(ref other, r, MOD_WHOLE)
                        else:
                            dirs[r] = d
                    case None:
                        pass
            case _:
                pass
        for e in stmt_exprs(s):
            mods_expr(e, info, ref other)
        for blk in stmt_blocks(s):
            count_steps(blk, info, ref dirs, ref other)

# Facts that hold on both paths of a merge, for a value `nv` that is `va` on
# one and `vb` on the other: when they differ by a constant, `nv` is between
# them. Plain facts the solver uses without splitting on the paths.
fn hull_facts(nv: V, va: V, vb: V, ref out: [F]):
    match (nv, va, vb):
        case (V.Int(n), V.Int(x), V.Int(y)):
            hull_lin(n, x, y, ref out)
        case (V.Arr(_, n), V.Arr(_, x), V.Arr(_, y)):
            hull_lin(n, x, y, ref out)
        case (V.Str(n), V.Str(x), V.Str(y)):
            hull_lin(n, x, y, ref out)
        case (V.Agg(ns), V.Agg(xs), V.Agg(ys)):
            if len(ns) == len(xs) and len(xs) == len(ys):
                for i in 0..len(ns):
                    hull_facts(ns[i], xs[i], ys[i], ref out)
        case _:
            pass

fn hull_lin(n: Lin, x: Lin, y: Lin, ref out: [F]):
    match x.sub(y):
        case Some(d0):
            match d0.is_const():
                case Some(d):
                    let z: i128 = 0
                    match (y.add_c(min(z, d)), y.add_c(max(z, d))):
                        case (Some(lo), Some(hi)):
                            out.push(F.le(lo, n))
                            out.push(F.le(n, hi))
                        case _:
                            pass
                case None:
                    pass
        case None:
            pass

# `f` split at its top-level `and`s.
fn conjuncts(f: F, ref out: [F]):
    match f:
        case F.And(xs):
            for x in xs:
                conjuncts(x, ref out)
        case _:
            out.push(f)
