# The verifier: symbolic execution of every function body.
#
# * Explicit obligations (`requires` at call sites, `ensures` at returns,
#   loop `invariant`s, `prove`) must be proven or compilation fails.
# * Implicit obligations (array bounds, overflow, division by zero) are
#   proven when possible; proven checks are removed from the generated code,
#   the rest stay as runtime checks (they can never be turned off).
#
# Soundness: integers are modelled exactly (overflow traps, so any reached
# state has exact values). Anything the verifier can't model becomes a fresh
# unknown, and loops havoc every variable they modify. A fact is only assumed
# when it has been proven or is enforced by a runtime check.
from diag import Span, Diag, SourceMap
import diag
from types import Ty, IntTy, FloatTy, Res, CallRes, Builtin, NumM, StrM, Reducer, WorldOp, LocalInfo, LocalKind, int_ty
from ast import BinOp, CmpOp, UnOp, FSeg, Arg, Comp, Expr, ExprKind, LetPat, Pattern, PatKind, Case, Stmt, StmtKind, Block, FnDecl, Program
from ast import children, stmt_exprs, stmt_blocks, lvalue_root, local_of
from info import ProgramInfo, ConstVal, PRELUDE, RT
from rules import builtin_effect, os_effect
from solver import Lin, F, AtomSet, prove_work, near_facts, local_facts, counterexample, PROVED, GAVE_UP, wrapping_abs, wrapping_neg, add_i128, mul_i128, neg_i128, ATOM_UNKNOWN, I64_BOUND
from checks import Check, Stop, builtin_stops, reduce_stops, convert_stops, world_stops, os_stops

struct Report:
    diags: [Diag]
    # checks that remain at runtime, `assert`s outside tests included: (span, what)
    remaining: [(Span, str)]
    # implicit checks proven and removed
    proven: int
    # checks proven, that still run (the runtime function checks anyway)
    kept: [(Span, str)]
    # `assert`s that fail whenever they're reached (a check that does is E0614)
    always: [(Span, str)]

enum V:
    Int(l: Lin)
    Bool(f: F)
    Arr(c: int, len: Lin)
    Str(len: Lin)
    Agg(vs: [V])
    # a float: whether it's NaN, and what `int` of it would be (rounded toward
    # zero), between -FLOAT_BIG and FLOAT_BIG (an infinity is one of those).
    # Of a value less than this one, that is at most `below`; of one greater,
    # at least `above` (both `t`, but for some constants: `int(y) <= 2` when
    # `y < 3.0`). Comparisons give facts about `t`, so `int(x)` can be proven
    # after a range check.
    Flt(t: Lin, nan: F, below: Lin, above: Lin)
    Opaque

enum Term:
    Sel(c: int, i: Lin)
    SelB(c: int, i: Lin)
    Mul(a: Lin, b: Lin)
    Div(a: Lin, b: Lin)
    Mod(a: Lin, b: Lin)
    # `a op b` for a bit operation (` << `, ` & `, ...) of the type `ty`
    Bit(op: str, ty: str, a: Lin, b: Lin)
    Rank
    Size

struct St:
    env: {int: V}
    facts: [F]

struct LoopCx:
    invs: [Expr]
    # for range loops: (loop var, value it has in the next iteration)
    next: Option[(int, V)]
    breaks: [St]

# The state before code that runs on some paths only: its facts (`k` of
# them) and the number of atoms then (`na`; later ones are new).
struct Fork:
    base: St
    k: int
    na: int

# The facts added since `fk` that mention an atom created since.
fn new_facts(facts: [F], fk: Fork) -> [F]:
    var out: [F] = []
    for i in fk.k..len(facts):
        var s = AtomSet.new()
        facts[i].atoms(ref s)
        if any(a >= fk.na and a != ATOM_UNKNOWN for a in s.xs):
            out.push(facts[i])
    return out

struct FnSpec:
    name: str
    params: [int]
    requires: [Expr]
    ensures: [Expr]
    result: Option[int]

const TAG_ARITH = 0
# Limits for one function, so a long one can't take minutes or all memory to
# prove. `WORK_MAX`: the solver work (`solver.prove_work`) spent on it; past
# that, only proofs from the facts about the goal's own values (`near_facts`,
# when they weigh at most `NEAR_MAX`) are tried. `WEIGHT_MAX`, `ATOMS_MAX`:
# the size of what it knows (`weight`) and the number of values; past either,
# nothing more is proven. Either way the checks it gave up on stay at run time,
# and W0005 says so. Above what real functions need: the compiler's biggest
# use under 3M, the biggest in the v09 lab programs 44M (a 400-line decoder).
const WORK_MAX = 60000000
const NEAR_MAX = 4096
const WEIGHT_MAX = 5000000
const ATOMS_MAX = 1000000
# Below this many facts a proof uses them all at once.
const NEAR_MIN = 32
# `local_facts`: values in more facts than this aren't followed, and it gives
# up past this many facts
const HUB_MAX = 12
const LOCAL_MAX = 64
# Past WORK_MAX, these proofs may still do this much work in all: they are
# small, and often enough.
const EXTRA_MAX = 2000000
# Largest disjunction (in formula nodes) a merge of two branches keeps. Past
# that the solver spends its time re-reading it; dropping it only loses facts.
const MERGE_MAX = 256
const TAG_INDEX = 1
const TAG_ASSERT = 2
# the overflow check of a compound assignment (`x += 1`), keyed by the statement
const TAG_COMPOUND = 3
# the range check of a narrowing integer conversion (`u8(x)`)
const TAG_CONV = 4

fn key(span: Span, tag: int) -> (int, int, int, int):
    return (span.file, span.lo, span.hi, tag)

# `must_prove`: a runtime check the prover can't remove is an error (E0607),
# outside `test` blocks (`[check] proven = true`).
# `rules`: for each function, the rule that covers it ("" if none): nothing in
# it may stop the program. `stops`: the functions a covered call can't reach
# (`unwrap`, which stops the program on `None`).
fn verify_program(
    ref prog: Program,
    info: ProgramInfo,
    sm: SourceMap,
    must_prove: bool,
    rules: [str],
    stops: [bool]
) -> Report:
    var specs: [Option[FnSpec]] = [None] * len(info.fns)
    for m in prog.modules:
        for f in m.fns:
            if 0 <= f.id < len(specs):
                specs[f.id] = Some(
                    FnSpec(
                        name=f.name,
                        params=f.param_locals,
                        requires=f.requires,
                        ensures=f.ensures,
                        result=f.result_local
                    )
                )
    # functions are proven independently, so in parallel; the results are
    # applied in order, which keeps the output deterministic
    var fns: [FnDecl] = []
    var tests: [bool] = []
    var covers: [str] = []
    for m in prog.modules:
        # the runtime module is trusted code, with wrapping arithmetic
        if m.name == RT:
            continue
        fns.extend(m.fns)
        fns.extend(m.tests)
        tests.extend([false] * len(m.fns))
        for f in m.fns:
            covers.push(rules[f.id] if 0 <= f.id < len(rules) and m.name != PRELUDE else "")
        # a rule is proven like code: its `assert`s are runtime checks
        for t in m.tests:
            match t.rule:
                case Some(r):
                    tests.push(false)
                    covers.push(r.name)
                case None:
                    tests.push(true)
                    covers.push("")
    let fps = footprints(prog, info)
    let pure = pure_fns(prog, info)
    let done = par [
        verify_fn(
            info,
            specs,
            fps,
            sm,
            fns[i],
            tests[i],
            (must_prove and not tests[i]) or covers[i] != "",
            covers[i],
            stops,
            pure
        )
        for i in 0..len(fns)
    ]
    # let go of the bodies, so rewriting them below doesn't copy them
    fns = []
    var report = Report(diags=[], remaining=[], proven=0, kept=[], always=[])
    # `BRINE_TIMES=2`: the functions that take the prover long
    let slow_fns = getenv("BRINE_TIMES") == Some("2")
    var at = 0
    for mi in 0..len(prog.modules):
        if prog.modules[mi].name == RT:
            continue
        let nf = len(prog.modules[mi].fns)
        let nt = len(prog.modules[mi].tests)
        for k in 0..nf + nt:
            let r = done[at]
            at += 1
            if slow_fns and r.time > 0.02:
                eprint(
                    f"  verify {r.name}: {r.time:.3f}s (work {r.work}, weight {r.weight}, {r.atoms} values)"
                )
            report.diags.extend(r.diags)
            report.remaining.extend(r.remaining)
            report.kept.extend(r.kept)
            report.always.extend(r.always)
            report.proven += len(r.proven)
            if len(r.proven) == 0:
                continue
            if k < nf:
                apply_block(ref prog.modules[mi].fns[k].body, r.proven)
            else:
                apply_block(ref prog.modules[mi].tests[k - nf].body, r.proven)
    # by position (stable), then without repeats
    var keys: [(int, int, int)] = []
    for i, r in enumerate(report.remaining):
        keys.push((r.0.file, r.0.lo, i))
    let order = sort_keys(keys)
    var out: [(Span, str)] = []
    for i in order:
        let r = report.remaining[i]
        if len(out) > 0:
            let p = out[len(out) - 1].0
            if p.file == r.0.file and p.lo == r.0.lo and p.hi == r.0.hi:
                continue
        out.push(r)
    report.remaining = out
    report.kept = by_position(report.kept)
    report.always = by_position(report.always)
    # generic code is verified once per instance; report each problem once
    var seen: {(str, str, int, int, int): bool} = {}
    var kept: [Diag] = []
    for d in report.diags:
        var k = (d.code, d.msg, -1, 0, 0)
        if len(d.labels) > 0:
            let s = d.labels[0].span
            k = (d.code, d.msg, s.file, s.lo, s.hi)
        if k not in seen:
            seen[k] = true
            kept.push(d)
    report.diags = kept
    return report

# By position (stable), then without repeats.
fn by_position(xs: [(Span, str)]) -> [(Span, str)]:
    var keys: [(int, int, int)] = []
    for i, r in enumerate(xs):
        keys.push((r.0.file, r.0.lo, i))
    var out: [(Span, str)] = []
    for i in sort_keys(keys):
        let r = xs[i]
        if len(out) > 0:
            let p = out[len(out) - 1].0
            if p.file == r.0.file and p.lo == r.0.lo and p.hi == r.0.hi:
                continue
        out.push(r)
    return out

struct FnResult:
    name: str
    diags: [Diag]
    remaining: [(Span, str)]
    kept: [(Span, str)]
    always: [(Span, str)]
    # the checks proven everywhere they're reached
    proven: {(int, int, int, int): bool}
    time: float
    # what it used of the limits (see `WORK_MAX`)
    work: int
    weight: int
    atoms: int

fn verify_fn(
    info: ProgramInfo,
    specs: [Option[FnSpec]],
    fps: [[[[int]]]],
    sm: SourceMap,
    f: FnDecl,
    test: bool,
    must_prove: bool,
    rule: str,
    stops: [bool],
    pure: [bool]
) -> FnResult:
    let t0 = clock()
    if f.is_extern:
        return FnResult(
            name=f.name,
            diags=[],
            remaining=[],
            kept=[],
            always=[],
            proven={},
            time=0.0,
            work=0,
            weight=0,
            atoms=0
        )
    var v = new_vf(info, specs, fps, sm, f)
    v.test = test
    v.must_prove = must_prove
    v.rule = rule
    v.in_rule = f.rule.is_some()
    v.stops = stops
    v.pure = pure
    v.run(f)
    if v.given_up > 0:
        let n = v.given_up
        let s = "" if n == 1 else "s"
        let it = "the check it gave up on" if n == 1 else "the checks it gave up on"
        let verb = "s" if n == 1 else ""
        var why = "it does a limited amount of work per function, and ran out"
        if v.too_big:
            why = "what it knows about the function's values grew past its memory limit"
        v.diags.push(
            diag.warning(
                "W0005",
                f"gave up proving {n} runtime check{s} in `{f.name}`: the function is too long or complex for the prover"
            )
            .label(f.name_span, "in this function")
            .note(f"{why}; {it} stay{verb} at run time (`--report` lists the checks that remain)")
            .with_help(
                f"split `{f.name}` into smaller functions: each is proven on its own, so they don't share the limit"
            )
        )
    var proven: {(int, int, int, int): bool} = {}
    for p in v.proven.keys():
        if p not in v.failed:
            proven[p] = true
    return FnResult(
        name=f.name,
        diags=v.diags,
        remaining=v.remaining,
        kept=v.kept_proven,
        always=v.always,
        proven=proven,
        time=clock() - t0,
        work=v.work,
        weight=v.weight,
        atoms=len(v.atom_names)
    )

fn key_lt(a: (int, int, int), b: (int, int, int)) -> bool:
    if a.0 != b.0:
        return a.0 < b.0
    if a.1 != b.1:
        return a.1 < b.1
    return a.2 < b.2

# Indices of `keys` in sorted order (the last component breaks ties).
fn sort_keys(keys: [(int, int, int)]) -> [int]:
    return msort(keys, [i for i in 0..len(keys)])

fn msort(keys: [(int, int, int)], idx: [int]) -> [int]:
    if len(idx) <= 1:
        return idx
    let mid = len(idx) / 2
    let l = msort(keys, idx[:mid])
    let r = msort(keys, idx[mid:])
    var out: [int] = []
    var i = 0
    var j = 0
    while i < len(l) and j < len(r):
        if key_lt(keys[r[j]], keys[l[i]]):
            out.push(r[j])
            j += 1
        else:
            out.push(l[i])
            i += 1
    out.extend(l[i:])
    out.extend(r[j:])
    return out

# ================================================================ applying results

fn apply_block(ref b: Block, p: {(int, int, int, int): bool}):
    for i in 0..len(b.stmts):
        apply_stmt(ref b.stmts[i], p)

fn apply_opt(ref x: Option[Expr], p: {(int, int, int, int): bool}):
    match x:
        case Some(e):
            var e2 = e
            apply_expr(ref e2, p)
            x = Some(e2)
        case None:
            pass

fn apply_stmt(ref s: Stmt, p: {(int, int, int, int): bool}):
    match s.kind:
        case StmtKind.Let(mutable, pat, ty, init, is_ref):
            var x = init
            apply_expr(ref x, p)
            s.kind = StmtKind.Let(mutable, pat, ty, x, is_ref)
        case StmtKind.Assign(target, op, value):
            var t = target
            var v = value
            apply_expr(ref t, p)
            apply_expr(ref v, p)
            s.kind = StmtKind.Assign(t, op, v)
            if key(s.span, TAG_COMPOUND) in p:
                s.proven = true
        case StmtKind.ExprStmt(e):
            var x = e
            apply_expr(ref x, p)
            s.kind = StmtKind.ExprStmt(x)
        case StmtKind.Prove(e):
            var x = e
            apply_expr(ref x, p)
            s.kind = StmtKind.Prove(x)
        case StmtKind.Contract(k, e):
            var x = e
            apply_expr(ref x, p)
            s.kind = StmtKind.Contract(k, x)
        case StmtKind.Return(e):
            var x = e
            apply_opt(ref x, p)
            s.kind = StmtKind.Return(x)
        case StmtKind.Assert(cond, msg):
            var c = cond
            var m = msg
            apply_expr(ref c, p)
            apply_opt(ref m, p)
            s.kind = StmtKind.Assert(c, m)
            if key(s.span, TAG_ASSERT) in p:
                s.proven = true
        case StmtKind.If(branches, els):
            var bs = branches
            for i in 0..len(bs):
                apply_expr(ref bs[i].0, p)
                apply_block(ref bs[i].1, p)
            var e = els
            match e:
                case Some(b):
                    var b2 = b
                    apply_block(ref b2, p)
                    e = Some(b2)
                case None:
                    pass
            s.kind = StmtKind.If(bs, e)
        case StmtKind.While(cond, invs, body):
            var c = cond
            var b = body
            apply_expr(ref c, p)
            apply_block(ref b, p)
            s.kind = StmtKind.While(c, invs, b)
        case StmtKind.For(name, name_span, ty, iter, invs, body, is_par):
            var it = iter
            var b = body
            apply_expr(ref it, p)
            apply_block(ref b, p)
            s.kind = StmtKind.For(name, name_span, ty, it, invs, b, is_par)
        case StmtKind.Match(scrut, cases):
            var sc = scrut
            apply_expr(ref sc, p)
            var cs = cases
            for i in 0..len(cs):
                apply_opt(ref cs[i].guard, p)
                apply_block(ref cs[i].body, p)
            s.kind = StmtKind.Match(sc, cs)
        case _:
            pass

fn apply_exprs(ref xs: [Expr], p: {(int, int, int, int): bool}):
    for i in 0..len(xs):
        apply_expr(ref xs[i], p)

fn apply_args(ref args: [Arg], p: {(int, int, int, int): bool}):
    for i in 0..len(args):
        apply_expr(ref args[i].expr, p)

fn apply_expr(ref e: Expr, p: {(int, int, int, int): bool}):
    let span = e.span
    match e.kind:
        case ExprKind.Binary(op, l, r):
            if key(span, TAG_ARITH) in p:
                e.checked = false
            var a = l
            var b = r
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Binary(op, a, b)
        case ExprKind.Index(b, idx):
            if key(span, TAG_INDEX) in p:
                e.checked = false
            var x = b
            var i = idx
            apply_expr(ref x, p)
            apply_expr(ref i, p)
            e.kind = ExprKind.Index(x, i)
        case ExprKind.FStr(segs):
            var ss = segs
            for i in 0..len(ss):
                match ss[i]:
                    case FSeg.Part(x, spec):
                        var x2 = x
                        apply_expr(ref x2, p)
                        ss[i] = FSeg.Part(x2, spec)
                    case _:
                        pass
            e.kind = ExprKind.FStr(ss)
        case ExprKind.Unary(op, x):
            var x2 = x
            apply_expr(ref x2, p)
            e.kind = ExprKind.Unary(op, x2)
        case ExprKind.Field(x, name, ns):
            var x2 = x
            apply_expr(ref x2, p)
            e.kind = ExprKind.Field(x2, name, ns)
        case ExprKind.Try(x):
            var x2 = x
            apply_expr(ref x2, p)
            e.kind = ExprKind.Try(x2)
        case ExprKind.Compare(first, rest):
            var f = first
            apply_expr(ref f, p)
            var rs = rest
            for i in 0..len(rs):
                apply_expr(ref rs[i].1, p)
            e.kind = ExprKind.Compare(f, rs)
        case ExprKind.IfElse(cond, then, els):
            var c = cond
            var t = then
            var f = els
            apply_expr(ref c, p)
            apply_expr(ref t, p)
            apply_expr(ref f, p)
            e.kind = ExprKind.IfElse(c, t, f)
        case ExprKind.Call(callee, args):
            if key(span, TAG_CONV) in p:
                e.checked = false
            var c = callee
            var a = args
            apply_expr(ref c, p)
            apply_args(ref a, p)
            e.kind = ExprKind.Call(c, a)
        case ExprKind.MethodCall(recv, name, ns, args):
            var r = recv
            var a = args
            apply_expr(ref r, p)
            apply_args(ref a, p)
            e.kind = ExprKind.MethodCall(r, name, ns, a)
        case ExprKind.Array(xs):
            var ys = xs
            apply_exprs(ref ys, p)
            e.kind = ExprKind.Array(ys)
        case ExprKind.Tuple(xs):
            var ys = xs
            apply_exprs(ref ys, p)
            e.kind = ExprKind.Tuple(ys)
        case ExprKind.ParTuple(xs):
            var ys = xs
            apply_exprs(ref ys, p)
            e.kind = ExprKind.ParTuple(ys)
        case ExprKind.Repeat(elem, count):
            var a = elem
            var b = count
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Repeat(a, b)
        case ExprKind.Contains(item, coll, neg):
            var a = item
            var b = coll
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Contains(a, b, neg)
        case ExprKind.Map(kvs):
            var ys = kvs
            for i in 0..len(ys):
                apply_expr(ref ys[i].0, p)
                apply_expr(ref ys[i].1, p)
            e.kind = ExprKind.Map(ys)
        case ExprKind.Slice(b, lo, hi):
            if key(span, TAG_INDEX) in p:
                e.checked = false
            var x = b
            var l = lo
            var h = hi
            apply_expr(ref x, p)
            apply_opt(ref l, p)
            apply_opt(ref h, p)
            e.kind = ExprKind.Slice(x, l, h)
        case ExprKind.Range(lo, hi, inclusive):
            var a = lo
            var b = hi
            apply_expr(ref a, p)
            apply_expr(ref b, p)
            e.kind = ExprKind.Range(a, b, inclusive)
        case ExprKind.Comp(c):
            var c2 = c
            apply_expr(ref c2.iter, p)
            apply_opt(ref c2.filter, p)
            apply_expr(ref c2.body, p)
            e.kind = ExprKind.Comp(c2)
        case _:
            pass

# ================================================================ modification analysis

# What a statement may change in a local: a path of field indices from the
# local down, ending in CONTENT at the first index (the elements of the array
# there, not its length). [] is the whole local.
const CONTENT = -1
# a longer path is cut short: changing its start covers the rest
const PATH_MAX = 8

# A change found in code: `root` at `path`, directly (callee < 0) or as the
# `ref` parameter `param` of the function `callee`, which may change what its
# footprint says.
struct Eff:
    root: int
    path: [int]
    callee: int
    param: int

# Whole: the variable may change. (For analyses that only ask whether.)
const MOD_WHOLE = 0

fn note_mod(ref out: {int: int}, id: int, m: int):
    out[id] = m

# The path from an lvalue's root local down to it.
fn lvalue_steps(e: Expr) -> [int]:
    var p: [int] = []
    match e.kind:
        case ExprKind.Field(x, _, _):
            p = lvalue_steps(x)
            if not ends_in_content(p) and e.idx >= 0:
                p.push(e.idx)
        case ExprKind.Index(x, _):
            p = lvalue_steps(x)
            if not ends_in_content(p):
                p.push(CONTENT)
        case _:
            pass
    if len(p) > PATH_MAX:
        return p[:PATH_MAX]
    return p

fn ends_in_content(p: [int]) -> bool:
    return len(p) > 0 and p[len(p) - 1] == CONTENT

# `p` then, below it, `q` (below an array's elements everything is content).
fn join_path(p: [int], q: [int]) -> [int]:
    if ends_in_content(p):
        return p
    var out = p
    out.extend(q)
    if len(out) > PATH_MAX:
        return out[:PATH_MAX]
    return out

fn is_prefix(p: [int], q: [int]) -> bool:
    if len(p) > len(q):
        return false
    for i in 0..len(p):
        if p[i] != q[i]:
            return false
    return true

# Add `p` to the paths of `id` that may change, keeping only the shortest.
fn note_path(ref out: {int: [[int]]}, id: int, p: [int]):
    let ps = out.get(id).unwrap_or([])
    for q in ps:
        if is_prefix(q, p):
            return
    var keep: [[int]] = [q2 for q2 in ps if not is_prefix(p, q2)]
    keep.push(p)
    out[id] = keep

fn same_paths(a: [[int]], b: [[int]]) -> bool:
    return len(a) == len(b) and all(p in b for p in a)

fn arg_eff(e: Expr, callee: int, param: int, ref out: [Eff]):
    match lvalue_root(e):
        case Some(r):
            out.push(Eff(root=r, path=lvalue_steps(e), callee=callee, param=param))
        case None:
            pass

fn effs_expr(e: Expr, info: ProgramInfo, ref out: [Eff]):
    match e.kind:
        case ExprKind.MethodCall(recv, _, _, args):
            var callee = -1
            match e.cres:
                case CallRes.Builtin(b):
                    if b.mutates_recv():
                        arg_eff(recv, -1, 0, ref out)
                case CallRes.Method(id):
                    if 0 <= id < len(info.fns) and len(info.fns[id].params) > 0:
                        callee = id
                        if info.fns[id].params[0].by_ref:
                            arg_eff(recv, id, 0, ref out)
                case _:
                    pass
            for i, a in enumerate(args):
                if a.by_ref:
                    arg_eff(a.expr, callee, i + 1 if callee >= 0 else 0, ref out)
        case ExprKind.Call(_, args):
            var callee = -1
            match e.cres:
                case CallRes.Fn(id):
                    callee = id
                case _:
                    pass
            for i, a in enumerate(args):
                if a.by_ref:
                    arg_eff(a.expr, callee, i, ref out)
        case _:
            pass
    for c in children(e):
        effs_expr(c, info, ref out)

fn effs_block(b: Block, info: ProgramInfo, ref out: [Eff]):
    for s in b.stmts:
        match s.kind:
            case StmtKind.Assign(target, _, _):
                arg_eff(target, -1, 0, ref out)
            case _:
                pass
        for e in stmt_exprs(s):
            effs_expr(e, info, ref out)
        for blk in stmt_blocks(s):
            effs_block(blk, info, ref out)

# The locals a block may change (for analyses that only ask which).
fn mods_block(b: Block, info: ProgramInfo, ref out: {int: int}):
    var effs: [Eff] = []
    effs_block(b, info, ref effs)
    for f in effs:
        note_mod(ref out, f.root, MOD_WHOLE)

# The locals `e` may change (for analyses that only ask which).
fn mods_expr(e: Expr, info: ProgramInfo, ref out: {int: int}):
    var effs: [Eff] = []
    effs_expr(e, info, ref effs)
    for f in effs:
        note_mod(ref out, f.root, MOD_WHOLE)

# What the parameter `param` of `id` may change in the caller's variable
# (everything, unless its body was looked at).
fn footprint(fps: [[[[int]]]], id: int, param: int) -> [[int]]:
    if 0 <= id < len(fps) and 0 <= param < len(fps[id]):
        return fps[id][param]
    return [[]]

# The paths `effs` may change, by local.
fn resolve_effs(effs: [Eff], fps: [[[[int]]]]) -> {int: [[int]]}:
    var out: {int: [[int]]} = {}
    for f in effs:
        if f.callee < 0:
            note_path(ref out, f.root, f.path)
        else:
            for q in footprint(fps, f.callee, f.param):
                note_path(ref out, f.root, join_path(f.path, q))
    return out

# Each function's footprint: for each `ref` parameter, what the function may
# change in it, directly or through the functions it calls. The least
# solution, found by iterating from nothing: every change happens through a
# finite chain of calls, and the paths are finitely many (field indices,
# cut at PATH_MAX). Functions without a body change all of their `ref`
# parameters.
fn footprints(prog: Program, info: ProgramInfo) -> [[[[int]]]]:
    let n = len(info.fns)
    var fps: [[[[int]]]] = []
    for i in 0..n:
        var ps: [[[int]]] = []
        for p in info.fns[i].params:
            ps.push([[]])
        fps.push(ps)
    var ids: [int] = []
    var locals: [[int]] = []
    var effs: [[Eff]] = []
    for m in prog.modules:
        for f in m.fns:
            if (
                f.is_extern
                or not (0 <= f.id < n)
                or len(f.param_locals) != len(info.fns[f.id].params)
            ):
                continue
            var es: [Eff] = []
            effs_block(f.body, info, ref es)
            for j, p in enumerate(info.fns[f.id].params):
                if p.by_ref:
                    fps[f.id][j] = []
            ids.push(f.id)
            locals.push(f.param_locals)
            effs.push(es)
    var changed = true
    var rounds = 0
    while changed:
        changed = false
        rounds += 1
        if rounds > 100:
            # not expected (the paths are finitely many); stay safe
            for id in ids:
                for j in 0..len(fps[id]):
                    fps[id][j] = [[]]
            break
        for k, id in enumerate(ids):
            let got = resolve_effs(effs[k], fps)
            for j, p in enumerate(info.fns[id].params):
                if p.by_ref:
                    let ps = got.get(locals[k][j]).unwrap_or([])
                    if not same_paths(ps, fps[id][j]):
                        fps[id][j] = ps
                        changed = true
    return fps

# Counters: the locals a loop body changes only by one `x += 1` outside its
# inner loops. Each iteration adds at most 1 to them, so at the start of the
# iteration `k` of `for k in lo..hi`, `x0 <= x <= x0 + (k - lo)`.
fn counters(b: Block, info: ProgramInfo) -> [int]:
    var incs: {int: int} = {}
    var other: {int: int} = {}
    count_incs(b, info, 0, ref incs, ref other)
    var out: [int] = []
    for id in incs:
        if incs[id] == 1 and id not in other:
            out.push(id)
    out.sort()
    return out

fn count_incs(b: Block, info: ProgramInfo, depth: int, ref incs: {int: int}, ref other: {int: int}):
    for s in b.stmts:
        var inner = depth
        match s.kind:
            case StmtKind.Assign(target, op, value):
                match lvalue_root(target):
                    case Some(r):
                        var inc = false
                        match (target.kind, op, value.kind):
                            case (ExprKind.Ident(_), Some(BinOp.Add), ExprKind.Int(v)):
                                inc = v == 1 and depth == 0
                            case _:
                                pass
                        if inc:
                            incs[r] = incs.get(r).unwrap_or(0) + 1
                        else:
                            note_mod(ref other, r, MOD_WHOLE)
                    case None:
                        pass
            case StmtKind.While(_, _, _) | StmtKind.For(_, _, _, _, _, _, _):
                inner = depth + 1
            case _:
                pass
        for e in stmt_exprs(s):
            mods_expr(e, info, ref other)
        for blk in stmt_blocks(s):
            count_incs(blk, info, inner, ref incs, ref other)

# Does evaluating `e` have no observable effects (so a proven `assert` can be removed)?
fn pure_expr(e: Expr) -> bool:
    var ok = true
    match e.kind:
        case ExprKind.Call(_, _) | ExprKind.MethodCall(_, _, _, _):
            match e.cres:
                case CallRes.Builtin(Builtin.Len) | CallRes.Builtin(
                    Builtin.Abs
                ) | CallRes.Builtin(Builtin.Min) | CallRes.Builtin(Builtin.Max):
                    ok = true
                case CallRes.Convert(_) | CallRes.Reduce(_):
                    ok = true
                case _:
                    ok = false
        case ExprKind.Comp(c):
            ok = not c.par
        case _:
            pass
    if not ok:
        return false
    for c in children(e):
        if not pure_expr(c):
            return false
    return true

# ================================================================ helpers

fn in_range(l: Lin, k: IntTy) -> F:
    if k.bits() == 128:
        # unknown: never proven, and dropped as a fact (see `int_range`)
        return F.B(ATOM_UNKNOWN, true)
    return F.and_([F.le(Lin.konst(k.min()), l), F.le(l, Lin.konst(k.max()))])

# The value range of `k` as known facts. The prover's arithmetic is 128-bit,
# too small to reason near the limits of `i128` and `u128`: it only knows
# that a `u128` isn't negative (the solver drops bounds at i128's edges),
# and leaves their overflow checks to run time.
fn int_range(k: IntTy) -> Option[(i128, i128)]:
    return Some((k.min(), k.max()))

# No array, string or map is longer than 2^60: every element takes at least a
# bit (a `[bool]`; anything else a byte), and no address space has 2^57 bytes.
const LEN_MAX: i128 = 1152921504606846976

# floats: floors past 2^100 are 2^100 (or -2^100), infinities too
const FLOAT_BIG: i128 = 1267650600228229401496703205376

fn float_range() -> Option[(i128, i128)]:
    return Some((-FLOAT_BIG, FLOAT_BIG))

fn float_const(c: float) -> V:
    let big = 1267650600228229401496703205376.0
    if c >= big:
        let k = Lin.konst(FLOAT_BIG)
        return V.Flt(k, F.False, k, k)
    if c <= -big:
        let k = Lin.konst(-FLOAT_BIG)
        return V.Flt(k, F.False, k, k)
    # `int(c)`, rounded toward zero
    let t = i128(floor(c)) if c >= 0.0 else i128(ceil(c))
    let one: i128 = 1
    var below = t
    var above = t
    if c == floor(c):
        # `y < 3.0`: int(y) <= 2; `y > -3.0`: int(y) >= -2
        if c > 0.0:
            below = t - one
        elif c < 0.0:
            above = t + one
    return V.Flt(Lin.konst(t), F.False, Lin.konst(below), Lin.konst(above))

fn nonneg_range() -> Option[(i128, i128)]:
    let z: i128 = 0
    return Some((z, I64_BOUND))

fn pos_range() -> Option[(i128, i128)]:
    let one: i128 = 1
    return Some((one, I64_BOUND))

# An ordering of `Lin`: by constant, then terms lexicographically.
fn lin_le(a: Lin, b: Lin) -> bool:
    if a.c != b.c:
        return a.c < b.c
    for i in 0..min(len(a.t), len(b.t)):
        if a.t[i].0 != b.t[i].0:
            return a.t[i].0 < b.t[i].0
        if a.t[i].1 != b.t[i].1:
            return a.t[i].1 < b.t[i].1
    return len(a.t) <= len(b.t)

fn lin_key(l: Lin) -> str:
    var s = f"{l.c}"
    for a, k in l.t:
        s += f";{a}*{k}"
    return s

fn term_key(t: Term) -> str:
    match t:
        case Term.Sel(c, i):
            return f"S{c}|" + lin_key(i)
        case Term.SelB(c, i):
            return f"B{c}|" + lin_key(i)
        case Term.Mul(a, b):
            return "M" + lin_key(a) + "|" + lin_key(b)
        case Term.Div(a, b):
            return "D" + lin_key(a) + "|" + lin_key(b)
        case Term.Mod(a, b):
            return "R" + lin_key(a) + "|" + lin_key(b)
        case Term.Bit(op, ty, a, b):
            return "O" + op + ty + "|" + lin_key(a) + "|" + lin_key(b)
        case Term.Rank:
            return "rank"
        case Term.Size:
            return "size"

# The size of a fact: its nodes and the terms of its linear forms.
fn weight(f: F) -> int:
    match f:
        case F.Ge(l):
            return 1 + len(l.t)
        case F.Eq(l):
            return 1 + len(l.t)
        case F.Ne(l):
            return 1 + len(l.t)
        case F.And(xs):
            var n = 1
            for x in xs:
                n += weight(x)
            return n
        case F.Or(ys):
            var n = 1
            for y in ys:
                n += weight(y)
            return n
        case _:
            return 1

# Facts with enormous constants are type-range bookkeeping; not worth showing.
fn huge(f: F) -> bool:
    let lim: i128 = 1 << 40
    match f:
        case F.Ge(l):
            return wrapping_abs(l.c) > lim
        case F.Eq(l):
            return wrapping_abs(l.c) > lim
        case F.Ne(l):
            return wrapping_abs(l.c) > lim
        case F.And(xs):
            return any(huge(x) for x in xs)
        case F.Or(xs):
            return any(huge(x) for x in xs)
        case _:
            return false

fn bool_eq(a: F, b: F) -> F:
    return F.or_([F.and_([a, b]), F.and_([a.not_(), b.not_()])])

# The longest name (in chars) a value gets in messages. Names are built from
# the names of their parts: without a cap, each `acc = (acc + x) % m` line
# would double the name's length.
const NAME_MAX = 64

fn short_name(s: str) -> str:
    if len(s) <= NAME_MAX:
        return s
    let cs = s.chars()
    if len(cs) <= NAME_MAX:
        return s
    # the start and the end: the end of an expression is usually its operator
    return "".join(cs[:40]) + " ... " + "".join(cs[len(cs) - 19:])

fn split_ws(s: str) -> str:
    var parts: [str] = []
    var cur = ""
    for c in s.chars():
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == "\u{b}" or c == "\u{c}":
            if cur != "":
                parts.push(cur)
                cur = ""
        else:
            cur += c
    if cur != "":
        parts.push(cur)
    return " ".join(parts)

# The longest note: past it a note is cut short (a long one helps no one).
const NOTE_MAX = 400

fn cap_note(s: str) -> str:
    if len(s) <= NOTE_MAX:
        return s
    let cs = s.chars()
    if len(cs) <= NOTE_MAX:
        return s
    return "".join(cs[:NOTE_MAX - 1]) + "…"

# `s` with every `q` in it replaced by `to`, where `q` is a whole name: `x.1`
# is not the start of `x.10`.
fn replace_name(s: str, q: str, to: str) -> str:
    if q not in s:
        return s
    var out = ""
    var at = 0
    while at <= len(s):
        match s.find(q, at):
            case Some(i):
                let j = i + len(q)
                let d = s[j:j + 1] if j < len(s) else ""
                out += s[at:i]
                out += q if d != "" and d in "0123456789" else to
                at = j
            case None:
                out += s[at:]
                return out
    return out

enum Step:
    Field(k: int)
    Index(i: Lin)

# the iteration domain of a `for` loop
enum D:
    Range(lo: Lin, hi: Lin, incl: bool)
    Stepped(lo: Lin, hi: Lin, step: Option[i128])
    Arr(c: int, len: Lin, elem: Ty)
    Other

# ================================================================ the symbolic executor

fn new_vf(
    info: ProgramInfo,
    specs: [Option[FnSpec]],
    fps: [[[[int]]]],
    sm: SourceMap,
    f: FnDecl
) -> Vf:
    return Vf(
        info=info,
        specs=specs,
        fps=fps,
        sm=sm,
        locals=f.locals,
        fn_name=f.name,
        ensures=f.ensures,
        result_local=f.result_local,
        atom_names=[],
        ranges=[],
        terms={},
        content_names=[],
        content_ranges=[],
        looped={},
        dropped={},
        defs=[],
        st=St(env={}, facts=[]),
        live=false,
        loops=[],
        spec=false,
        alt_env=None,
        proven={},
        failed={},
        remaining=[],
        kept_proven=[],
        always=[],
        nobl=0,
        test=false,
        must_prove=false,
        diags=[],
        own_self=-1,
        own_sid=-1,
        own_ref=false,
        own_kept=false,
        skip_inv=false,
        rule="",
        in_rule=false,
        stops=[],
        work=0,
        weight=0,
        limited=false,
        too_big=false,
        given_up=0,
        extra=0,
        mods=[],
        hidden={},
        aliases={},
        chars={},
        one_char={},
        pure=[],
        memo={}
    )

struct Vf:
    info: ProgramInfo
    specs: [Option[FnSpec]]
    # what each function may change in its `ref` parameters (see `footprints`)
    fps: [[[[int]]]]
    sm: SourceMap
    locals: [LocalInfo]
    fn_name: str
    ensures: [Expr]
    result_local: Option[int]
    # per atom: its name (for messages) and value range
    atom_names: [str]
    ranges: [Option[(i128, i128)]]
    terms: {str: int}
    content_names: [str]
    # the range of every element of a content, when known (from a literal)
    content_ranges: [Option[(i128, i128)]]
    # the atoms a loop made for what it changes (for messages)
    looped: {int: bool}
    # values made at a merge whose facts were too many to keep (MERGE_MAX)
    dropped: {int: bool}
    defs: [F]
    # the current state; `live` is false where execution can't reach
    st: St
    live: bool
    loops: [LoopCx]
    spec: bool
    alt_env: Option[{int: V}]
    proven: {(int, int, int, int): bool}
    failed: {(int, int, int, int): bool}
    remaining: [(Span, str)]
    # checks proven, that still run
    kept_proven: [(Span, str)]
    # `assert`s that always fail
    always: [(Span, str)]
    # obligations stated so far (to see that an operation's check was)
    nobl: int
    # a `test` block: its `assert`s are its point, not checks to remove
    test: bool
    # every remaining runtime check is an error (E0607)
    must_prove: bool
    diags: [Diag]
    # in a method of a struct with an `invariant`: the `self` local, the
    # struct, and whether `self` is `ref`. `self` may break the invariant
    # in between: it is proven where `self` is used whole and on return.
    own_self: int
    own_sid: int
    own_ref: bool
    # a loop keeps the invariant of `self` (see `own_inv_kept`)
    own_kept: bool
    # `fresh_val` makes a value that may break its invariant (`self`, havocked)
    skip_inv: bool
    # the rule this code is, or that covers it ("" if none)
    rule: str
    # the body of a `rule` block
    in_rule: bool
    # functions that can stop the program, which covered code can't call
    stops: [bool]
    # the limits (see `WORK_MAX`): the work done, the size of what was assumed,
    # whether the last proof stopped at a limit, whether a size limit was hit,
    # and the runtime checks given up on
    work: int
    weight: int
    limited: bool
    too_big: bool
    given_up: int
    extra: int
    # the values `a % c` for a constant `c` (see `const_mod`), with their `a`
    mods: [(int, Lin)]
    # a hidden loop variable (`for k, v in ...` loops over `for'12`): the name
    # its value was given, which the `let` that unpacks it renames
    hidden: {int: str}
    # values a `let` named (by `lin_key`): `d0 * e` reads better than the
    # expression `d0` stands for, which grows with every `let` in a chain
    aliases: {str: str}
    # the contents of `s.chars()`, and the lengths (by `lin_key`) of their
    # elements: each is one character, whatever its length in bytes
    chars: {int: bool}
    one_char: {str: bool}
    # functions whose result depends on their arguments alone (`pure_fns`),
    # and the results of the calls to them so far, by callee and arguments:
    # `while ok(x): ... ok(x)` knows in the body what the condition said
    pure: [bool]
    memo: {str: V}

    # The state, leaving none behind.
    fn take(ref self) -> Option[St]:
        if not self.live:
            return None
        self.live = false
        return Some(self.st)

    fn put(ref self, s: Option[St]):
        match s:
            case Some(x):
                self.st = x
                self.live = true
            case None:
                self.live = false

    fn cur(self) -> Option[St]:
        return Some(self.st) if self.live else None

    fn local_name(self, id: int) -> str:
        return self.locals[id].name if 0 <= id < len(self.locals) else ""

    # A local's name in messages: a hidden one (`for'12`, `tup'12`) is shown
    # as the pattern it stands for.
    fn shown_local(self, id: int) -> str:
        let n = self.local_name(id)
        if "'" in n and 0 <= id < len(self.locals):
            return split_ws(self.snippet(self.locals[id].span))
        return n

    fn local_ty(self, id: int) -> Ty:
        return self.locals[id].ty if 0 <= id < len(self.locals) else Ty.Unknown

    fn run(ref self, f: FnDecl):
        if f.method_of.is_some() and len(f.params) > 0 and f.params[0].name == "self":
            let id = f.param_locals[0]
            match self.local_ty(id):
                case Ty.Struct(sid):
                    if len(self.info.structs[sid].invariants) > 0:
                        self.own_self = id
                        self.own_sid = sid
                        self.own_ref = self.locals[id].kind == LocalKind.RefParam
                case _:
                    pass
        # live first: the parameters' invariants are facts
        self.put(Some(St(env={}, facts=[])))
        for i, id in enumerate(f.param_locals):
            let li = self.locals[id]
            let name = "old(" + f.params[i].name + ")" if f.params[i].mutable else f.params[i].name
            let v = self.fresh_val(li.ty, name)
            self.bind(id, v)
        for r in f.requires:
            let c = self.spec_cond(r)
            self.assume(c)
        # preconditions that contradict each other make every proof in the body
        # trivially true, and no call can meet them
        if len(f.requires) > 0 and self.holds(F.False):
            let first = f.requires[0].span
            let last = f.requires[len(f.requires) - 1].span
            var what = f"`{f.name}`"
            match f.rule:
                case Some(r):
                    what = f"rule \"{r.name}\""
                case None:
                    pass
            var d = diag.error("E0608", f"the preconditions of {what} can never all hold")
            d = d.label(first.to(last), "no values meet all of these")
            d = d.note("everything the body claims is proven vacuously, and no call can prove them")
            self.diags.push(
                d.with_help(
                    "fix the `requires` that is wrong, or remove the function if it can't be called"
                )
            )
            return
        self.block(f.body)
        if self.live:
            let end = Span(file=f.span.file, lo=f.span.hi, hi=f.span.hi)
            self.check_own_inv(end)
            self.check_ensures(None, end)

    # ------------------------------------------------------------ atoms
    fn new_atom(ref self, name: str, range: Option[(i128, i128)]) -> int:
        self.atom_names.push(short_name(name))
        self.ranges.push(range)
        return len(self.atom_names) - 1

    fn fresh_int(ref self, name: str, k: IntTy) -> Lin:
        return Lin.atom(self.new_atom(name, int_range(k)))

    fn fresh_nonneg(ref self, name: str) -> Lin:
        return Lin.atom(self.new_atom(name, nonneg_range()))

    # A value equal to `v`, of new atoms: a branch keeps the facts it learns
    # about it (`join` keeps only the facts about atoms made in the branch).
    fn copy_val(ref self, v: V, name: str) -> V:
        if self.spec:
            return v
        match v:
            case V.Int(l):
                let a = Lin.atom(self.new_atom(name, None))
                self.assume(F.equal(a, l))
                return V.Int(a)
            case V.Bool(f):
                let b = self.fresh_bool(name)
                self.assume(bool_eq(b, f))
                return V.Bool(b)
            case V.Arr(c, l):
                let n = Lin.atom(self.new_atom("len(" + name + ")", None))
                self.assume(F.equal(n, l))
                return V.Arr(c, n)
            case V.Agg(vs):
                var out: [V] = []
                for x in vs:
                    out.push(self.copy_val(x, name))
                return V.Agg(out)
            case _:
                return v

    fn fresh_len(ref self, name: str) -> Lin:
        let z: i128 = 0
        return Lin.atom(self.new_atom(name, Some((z, LEN_MAX))))

    # A length an operation just produced: the memory for it was allocated.
    fn cap_len(ref self, l: Lin):
        self.assume(F.le(l, Lin.konst(LEN_MAX)))

    fn fresh_bool(ref self, name: str) -> F:
        return F.B(self.new_atom(name, None), true)

    fn fresh_content(ref self, name: str) -> int:
        self.content_names.push(short_name(name))
        self.content_ranges.push(None)
        return len(self.content_names) - 1

    # A content whose elements are all constants between `lo` and `hi`.
    fn ranged_content(ref self, name: str, vals: [V]) -> int:
        let c = self.fresh_content(name)
        var lo: Option[i128] = None
        var hi: Option[i128] = None
        for v in vals:
            match v:
                case V.Int(l):
                    match l.is_const():
                        case Some(x):
                            lo = Some(x if lo.is_none() else min(lo.unwrap(), x))
                            hi = Some(x if hi.is_none() else max(hi.unwrap(), x))
                        case None:
                            return c
                case _:
                    return c
        if lo.is_some():
            self.content_ranges[c] = Some((lo.unwrap(), hi.unwrap()))
        return c

    fn term(ref self, t: Term, range: Option[(i128, i128)]) -> int:
        let tk = term_key(t)
        match self.terms.get(tk):
            case Some(a):
                return a
            case None:
                pass
        var name = ""
        match t:
            case Term.Sel(c, i):
                name = self.content_names[c] + "[" + self.show_lin(i) + "]"
            case Term.SelB(c, i):
                name = self.content_names[c] + "[" + self.show_lin(i) + "]"
            case Term.Mul(a, b):
                name = self.show_lin_p(a) + " * " + self.show_lin_p(b)
            case Term.Div(a, b):
                name = self.show_lin_p(a) + " / " + self.show_lin_p(b)
            case Term.Mod(a, b):
                name = self.show_lin_p(a) + " % " + self.show_lin_p(b)
            case Term.Bit(op, _, a, b):
                name = self.show_lin_p(a) + op + self.show_lin_p(b)
            case Term.Rank:
                name = "world.rank()"
            case Term.Size:
                name = "world.size()"
        let a = self.new_atom(name, range)
        self.terms[tk] = a
        match t:
            case Term.Rank:
                let s = self.term(Term.Size, pos_range())
                self.defs.push(F.ge(Lin.atom(a)))
                self.defs.push(F.lt(Lin.atom(a), Lin.atom(s)))
            case Term.Div(l, d):
                match d.is_const():
                    case Some(c):
                        # q = floor(l / c) for constant c > 0, i.e. l = c*q + r with 0 <= r < c
                        let q = Lin.atom(a)
                        match q.scale(c):
                            case Some(cq):
                                match l.sub(cq):
                                    case Some(r):
                                        let one: i128 = 1
                                        self.defs.push(
                                            F.and_([F.ge(r), F.le(r, Lin.konst(c - one))])
                                        )
                                    case None:
                                        pass
                            case None:
                                pass
                    case None:
                        pass
            case _:
                pass
        return a

    fn fresh_val(ref self, ty: Ty, name: str) -> V:
        match ty:
            case Ty.Int(k):
                return V.Int(self.fresh_int(name, k))
            case Ty.Bool:
                return V.Bool(self.fresh_bool(name))
            case Ty.Float(_):
                let t = Lin.atom(self.new_atom("int(" + name + ")", float_range()))
                return V.Flt(t, self.fresh_bool(name + " is NaN"), t, t)
            case Ty.Array(_):
                let c = self.fresh_content(name)
                return V.Arr(c, self.fresh_len("len(" + name + ")"))
            case Ty.Str:
                return V.Str(self.fresh_len("len(" + name + ")"))
            case Ty.Tuple(ts):
                var vs: [V] = []
                for i, t in enumerate(ts):
                    vs.push(self.fresh_val(t, f"{name}.{i}"))
                return V.Agg(vs)
            case Ty.Struct(sid):
                let skip = self.skip_inv
                self.skip_inv = false
                let fields = self.info.structs[sid].fields
                var vs: [V] = []
                for n, t in fields:
                    vs.push(self.fresh_val(t, name + "." + n))
                let v = V.Agg(vs)
                # every value of the type keeps its invariant
                if not skip:
                    self.assume_inv(sid, v)
                return v
            case _:
                return V.Opaque

    fn lin(ref self, l: Option[Lin], name: str) -> Lin:
        match l:
            case Some(x):
                return x
            case None:
                return Lin.atom(self.new_atom(name, None))

    fn as_int(ref self, v: V, ty: Ty) -> Lin:
        match v:
            case V.Int(l):
                return l
            case _:
                match ty:
                    case Ty.Int(k):
                        return self.fresh_int("?", k)
                    case _:
                        return Lin.atom(self.new_atom("?", None))

    fn as_bool(ref self, v: V) -> F:
        match v:
            case V.Bool(f):
                return f
            case _:
                return self.fresh_bool("?")

    fn sel(ref self, c: int, i: Lin, ety: Ty) -> V:
        if c in self.chars and ety == Ty.Str:
            let z: i128 = 1
            let l = Lin.atom(
                self.new_atom(
                    "len(" + self.content_names[c] + "[" + self.show_lin(i) + "])",
                    Some((z, 4))
                )
            )
            self.one_char[lin_key(l)] = true
            return V.Str(l)
        match ety:
            case Ty.Int(k):
                var r = int_range(k)
                match self.content_ranges[c]:
                    case Some(cr):
                        r = Some((max(cr.0, k.min()), min(cr.1, k.max())))
                    case None:
                        pass
                return V.Int(Lin.atom(self.term(Term.Sel(c, i), r)))
            case Ty.Bool:
                return V.Bool(F.B(self.term(Term.SelB(c, i), None), true))
            case _:
                let n = self.content_names[c] + "[" + self.show_lin(i) + "]"
                return self.fresh_val(ety, n)

    # Fact: element `i` of content `c` equals `v`.
    fn define_sel(ref self, c: int, i: Lin, ety: Ty, v: V):
        let s = self.sel(c, i, ety)
        match val_eq(s, v):
            case Some(f):
                self.defs.push(f)
            case None:
                pass

    # ------------------------------------------------------------ facts and proofs
    fn assume(ref self, f: F):
        if self.live and f != F.True and not self.too_big:
            self.st.facts.push(f)
            self.weight += weight(f)

    fn holds(ref self, goal: F) -> bool:
        return self.decide(goal) == PROVED

    # `solver.prove_work` within the function's limits: first from the ranges
    # of the goal's values, then from the facts about them, then from all the
    # facts. `limited` says whether a limit made it give up.
    fn decide(ref self, goal: F) -> int:
        self.limited = false
        if not self.live:
            return PROVED
        if self.weight > WEIGHT_MAX or len(self.atom_names) > ATOMS_MAX:
            self.too_big = true
        if self.too_big:
            self.limited = true
            return GAVE_UP
        var all = self.st.facts
        all.extend(self.defs)
        let over = self.work > WORK_MAX
        # the ranges of its values are often enough (and the solver can lose
        # its way in bounds near the limits of 64-bit types)
        if self.by_ranges(goal):
            return PROVED
        if len(all) > NEAR_MIN:
            let near = near_facts(all, goal)
            var nw = 0
            for f in near:
                nw += weight(f)
            # (not when it's most of what is known: that would be the same work twice)
            if nw <= NEAR_MAX or (not over and 2 * len(near) <= len(all)):
                if prove_work(near, goal, self.ranges, ref self.work) == PROVED:
                    return PROVED
            # then what is linked to them, except through values most facts mention
            # (past the limit, only up to a small extra amount of work)
            if not over or self.extra < EXTRA_MAX:
                let w0 = self.work
                var r = GAVE_UP
                match local_facts(all, goal, HUB_MAX, LOCAL_MAX, ref self.work):
                    case Some(loc):
                        if len(near) < len(loc) < len(all):
                            r = prove_work(loc, goal, self.ranges, ref self.work)
                    case None:
                        pass
                if over:
                    self.extra += self.work - w0
                if r == PROVED:
                    return PROVED
        if over:
            self.limited = true
            return GAVE_UP
        return prove_work(all, goal, self.ranges, ref self.work)

    # `goal` follows from the ranges of its values or the facts about them
    # (all facts, in a short function): for what is seldom true, like a check
    # that always fails, whose proof would cost a long function the most.
    fn holds_near(ref self, goal: F) -> bool:
        if not self.live:
            return true
        if self.too_big:
            return false
        if self.by_ranges(goal):
            return true
        var all = self.st.facts
        all.extend(self.defs)
        if len(all) > NEAR_MIN:
            all = near_facts(all, goal)
        return prove_work(all, goal, self.ranges, ref self.work) == PROVED

    # `f` follows from the ranges of its values alone (interval arithmetic).
    fn by_ranges(self, f: F) -> bool:
        match f:
            case F.True:
                return true
            case F.Ge(l):
                match self.range_of(l).0:
                    case Some(lo):
                        return lo >= 0
                    case None:
                        return false
            case F.Eq(l):
                let r = self.range_of(l)
                return r.0 == Some(0) and r.1 == Some(0)
            case F.Ne(l):
                let r = self.range_of(l)
                match (r.0, r.1):
                    case (Some(lo), _):
                        if lo > 0:
                            return true
                    case _:
                        pass
                match r.1:
                    case Some(hi):
                        return hi < 0
                    case None:
                        return false
            case F.And(xs):
                return all(self.by_ranges(x) for x in xs)
            case F.Or(ys):
                return any(self.by_ranges(y) for y in ys)
            case _:
                return false

    fn holds_with(ref self, extra: F, goal: F) -> bool:
        let n = len(self.st.facts) if self.live else 0
        self.assume(extra)
        let r = self.holds(goal)
        if self.live:
            self.st.facts = self.st.facts[:n]
        return r

    # Implicit (safety) obligation: proven => the runtime check is removed.
    # Either way the fact holds afterwards (it was proven or checked).
    fn implicit(ref self, span: Span, tag: int, goal: F, what: str):
        if self.spec or not self.live:
            return
        self.nobl += 1
        if self.holds(goal):
            self.proven[key(span, tag)] = true
        else:
            let limited = self.limited
            if limited:
                self.given_up += 1
            self.failed[key(span, tag)] = true
            # (not when it gave up: showing it always fails would be harder)
            if not limited and self.refuted(span, what, goal):
                return
            self.remain(span, what, Some(goal))
        self.assume(goal)

    # A check whose goal is false in every state that reaches it stops the
    # program whenever it runs: an error (E0614), not a runtime check. The
    # goal must be exactly the condition the check tests, and the facts must
    # not contradict each other (code the prover sees can't run is fine).
    # Nothing is assumed after it, so what follows is still checked as if
    # it passed, instead of being proven from a contradiction.
    fn refuted(ref self, span: Span, what: str, goal: F) -> bool:
        if self.spec or not self.live or not self.holds_near(goal.not_()) or self.holds(F.False):
            return false
        var d = diag.error(
            "E0614",
            f"this {what} always fails"
        ).label(span, "this stops the program whenever it runs")
        if goal == F.False:
            d = d.note("with the values used here, it can never pass")
        else:
            for n in self.known_facts_note(goal):
                d = d.note(n)
            d = d.note("it passes only if " + self.show_f(goal) + ", which can't hold here")
        self.diags.push(
            d.with_help(
                "fix the values it uses; if this line really can't run, make that visible to the prover (return before it, or a `requires` that rules the case out)"
            )
        )
        return true

    # A check that stays at runtime: listed in `--report`, and an error where
    # everything must be proven. `goal`: what would remove it, if anything can.
    fn remain(ref self, span: Span, what: str, goal: Option[F]):
        self.remain_h(span, what, goal, "")

    # A check of the table in checks.br the prover can't state.
    fn remain_c(ref self, span: Span, c: Check):
        if not self.spec and self.live:
            self.remain_h(span, c.what(), None, c.help())

    # `help`: what removes it, when the general advice doesn't ("" for that).
    fn remain_h(ref self, span: Span, what: str, goal: Option[F], help: str):
        self.remaining.push((span, what))
        if not self.must_prove:
            return
        let is_assert = what == "assert"
        var d = (
            diag.error("E0607", "a runtime check is left in code that must be proven").label(
                span,
                "this `assert` is checked at runtime"
                if is_assert
                else f"the prover could not remove this {what}"
            )
        )
        d = d.note(self.why_proven())
        if help != "":
            d = d.with_help(help)
        elif is_assert:
            d = d.with_help(
                "give the prover the facts that make it true (`requires`, `invariant`), turn it into a `prove`, or handle the failing case with an `if`"
            )
        else:
            d = d.with_help(
                "give the prover the facts it needs (`requires`, `invariant`), or handle the failing case with an `if` before this point"
            )
        match goal:
            case Some(g):
                self.fail(d, g)
            case None:
                self.diags.push(d)

    # Why everything here must be proven.
    fn why_proven(self) -> str:
        if self.in_rule:
            return f"this is rule \"{self.rule}\": a failed check would stop the program instead of keeping the rule"
        if self.rule != "":
            return f"rule \"{self.rule}\" covers this function, so nothing it does may stop the program"
        return "`proven = true` under [check] in brine.toml (or `--proven`) makes every check the prover can't remove an error, outside `test` blocks"

    # A call that stops the program (`panic`, `exit`, `unwrap()`), in code that
    # must not stop: an error unless the prover shows it can't be reached.
    fn stop_call(ref self, span: Span, what: str, help: str):
        if not self.must_prove or self.test or not self.live or self.rule == "":
            return
        if self.holds(F.False):
            return
        self.diags.push(
            diag.error("E0611", f"{what} in code a rule covers")
            .label(span, "this can stop the program")
            .note(self.why_proven())
            .with_help(help)
        )

    # `x op= y`: the new value of `x`; the statement's check is proven or listed.
    fn compound(ref self, span: Span, op: BinOp, a: Lin, b: Lin, k: IntTy) -> V:
        let r = self.arith_val(op, a, b, k)
        let l = self.as_int(r, Ty.Int(k))
        let fits = in_range(l, k)
        match op:
            case BinOp.Add | BinOp.Sub | BinOp.Mul:
                self.implicit(span, TAG_COMPOUND, fits, "overflow check")
            case BinOp.Div:
                self.implicit(span, TAG_COMPOUND, div_goal(op, a, b, k), "division check")
            case BinOp.Mod:
                self.implicit(span, TAG_COMPOUND, div_goal(op, a, b, k), "remainder check")
            case BinOp.Shl | BinOp.Shr:
                self.implicit(span, TAG_COMPOUND, shift_goal(b, k), "shift check")
            case _:
                pass
        if not self.spec:
            self.assume(fits)
        return V.Int(l)

    # Start running with an extra temporary assumption; `end_assume` drops the facts added since.
    fn begin_assume(ref self, extra: F) -> (Option[St], int):
        let saved = self.cur()
        let n = len(self.st.facts) if self.live else 0
        self.assume(extra)
        return (saved, n)

    fn end_assume(ref self, saved: (Option[St], int)):
        if self.live:
            self.st.facts = self.st.facts[:saved.1]
        else:
            self.put(saved.0)

    # ------------------------------------------------------------ display
    fn atom_name(self, a: int) -> str:
        return self.atom_names[a] if 0 <= a < len(self.atom_names) else "?"

    fn show_lin(self, l: Lin) -> str:
        if len(l.t) == 0:
            return f"{l.c}"
        var s = ""
        for i, p in enumerate(l.t):
            let a = p.0
            let k = p.1
            let name = self.atom_name(a)
            let ak = wrapping_abs(k)
            if i == 0:
                if k < 0:
                    s += "-"
            else:
                s += " - " if k < 0 else " + "
            if ak != 1:
                s += f"{ak}*"
            # `4*(m / 4)`, `-(a - b)`: a name that is an expression
            if " " in name and (ak != 1 or k < 0):
                s += "(" + name + ")"
            else:
                s += name
        if l.c > 0:
            s += f" + {l.c}"
        elif l.c < 0:
            s += f" - {wrapping_neg(l.c)}"
        return s

    # `l` as an operand: in parentheses, or by the name a `let` gave it
    fn show_lin_p(self, l: Lin) -> str:
        let n = len(l.t) + (1 if l.c != 0 else 0)
        if n > 1:
            match self.aliases.get(lin_key(l)):
                case Some(a):
                    return a
                case None:
                    pass
            return "(" + self.show_lin(l) + ")"
        return self.show_lin(l)

    # Show `l op 0` as `lhs op rhs` with positive coefficients on both sides.
    fn show_rel(self, l: Lin, op0: str) -> str:
        let zero: i128 = 0
        let pos = Lin(c=zero, t=[p for p in l.t if p.1 > 0])
        var neg_t: [(int, i128)] = []
        for p in l.t:
            if p.1 < 0:
                neg_t.push((p.0, wrapping_neg(p.1)))
        if len(pos.t) == 0 and len(neg_t) > 0:
            # -t + c op 0: `t <= c` reads better than `0 >= t - c`
            let t = self.show_lin(Lin(c=zero, t=neg_t))
            if op0 == ">=":
                if l.c == -1:
                    return t + " < 0"
                return t + f" <= {l.c}"
            return t + " " + op0 + f" {l.c}"
        var rhs_c = wrapping_neg(l.c)
        var op = op0
        if op == ">=" and rhs_c == 1:
            op = ">"
            rhs_c = zero
        let lhs = "0" if len(pos.t) == 0 else self.show_lin(pos)
        let rhs = Lin(c=rhs_c, t=neg_t)
        return lhs + " " + op + " " + self.show_lin(rhs)

    fn show_f(self, f: F) -> str:
        match f:
            case F.True:
                return "true"
            case F.False:
                return "false"
            case F.Ge(l):
                return self.show_rel(l, ">=")
            case F.Eq(l):
                return self.show_rel(l, "==")
            case F.Ne(l):
                return self.show_rel(l, "!=")
            case F.B(a, p):
                let n = self.atom_name(a)
                if not p and n.ends_with(" is NaN"):
                    return n[:len(n) - 3] + "not NaN"
                return n if p else "not " + n
            case F.And(xs):
                return " and ".join([self.show_f(x) for x in xs])
            case F.Or(xs):
                return "(" + " or ".join([self.show_f(x) for x in xs]) + ")"

    fn known_facts_note(self, goal: F) -> [str]:
        if not self.live:
            return []
        var ga = AtomSet.new()
        goal.atoms(ref ga)
        # what is known about `x % c` is known about `x`
        for m, a in self.mods:
            if any(ga.contains(p.0) for p in a.t):
                ga.insert(m)
        # the newest value of each name in the goal: facts about older values
        # of the same variable (before a loop changed it) would only confuse
        var newest: {str: int} = {}
        for a0 in ga.xs:
            let n0 = self.atom_name(a0)
            if a0 > newest.get(n0).unwrap_or(-1):
                newest[n0] = a0
        var out: [str] = []
        var unlisted = false
        var mentioned = AtomSet.new()
        var facts: [F] = []
        for f0 in self.st.facts:
            conjuncts(f0, ref facts)
        for f in facts:
            var fa = AtomSet.new()
            f.atoms(ref fa)
            if not any(ga.contains(a) for a in fa.xs):
                continue
            # (bounds near the type's limits are noise: left out silently)
            if huge(f):
                continue
            if any(
                not ga.contains(a) and a < newest.get(self.atom_name(a)).unwrap_or(-1)
                for a in fa.xs
            ):
                continue
            for a1 in fa.xs:
                mentioned.insert(a1)
            if f.size() > 9 or any(self.atom_name(a) == "?" for a in fa.xs):
                unlisted = true
                continue
            let s = self.show_f(f)
            if s not in out:
                out.push(s)
        var notes: [str] = []
        var lost: [str] = []
        for a3 in ga.xs:
            if a3 in self.dropped:
                let n3 = f"`{self.atom_name(a3)}`"
                if n3 not in lost:
                    lost.push(n3)
        if len(lost) > 0:
            notes.push(
                "the prover gave up on what the branches before this point say about "
                + ", ".join(lost)
                + ": they have too many paths for it to keep track of"
            )
        if len(out) > 0:
            if len(out) > 6:
                out = out[len(out) - 6:]
            notes.push("known facts here: " + ", ".join(out))
        elif len(lost) == 0:
            if unlisted:
                notes.push("what is known here about the values involved is too long to list")
            else:
                notes.push("nothing is known here about the values involved")
        for a2 in ga.xs:
            if a2 in self.looped and not mentioned.contains(a2):
                let n2 = self.atom_name(a2)
                notes.push(
                    f"`{n2}` is changed by a loop before this point whose invariants say nothing about it: add one there that says what is needed here"
                )
        return notes

    fn snippet(self, s: Span) -> str:
        return self.sm.snippet(s)

    # Values of the goal's names that satisfy every known fact but not the
    # goal, when the prover can find some: either the code is wrong for them,
    # or it needs a fact that rules them out.
    fn values_note(self, facts: [F], goal: F) -> Option[str]:
        let m = counterexample(facts, goal, self.ranges)?
        var ga = AtomSet.new()
        goal.atoms(ref ga)
        # the newest value of each name: older ones (before a loop changed
        # the variable) would read as the same name
        var newest: {str: int} = {}
        for a in ga.xs:
            let n = self.atom_name(a)
            if a != ATOM_UNKNOWN and n != "?" and a > newest.get(n).unwrap_or(-1):
                newest[n] = a
        var out: [str] = []
        for a2 in ga.xs:
            let n2 = self.atom_name(a2)
            if newest.get(n2) != Some(a2):
                continue
            match m.ints.get(a2):
                case Some(v):
                    out.push(f"{n2} = {v}")
                case None:
                    match m.bools.get(a2):
                        case Some(b):
                            out.push(n2 + " = " + ("true" if b else "false"))
                        case None:
                            pass
        if len(out) == 0:
            return None
        return Some("values the prover can't rule out: " + ", ".join(out))

    fn fail(ref self, d0: Diag, goal: F):
        var d = d0
        # the proof just tried stopped at a limit of the function
        let limited = self.limited
        if goal == F.False:
            d = d.note("with the values used here, this is always false")
        else:
            # of a conjunction, show the parts that aren't proven
            var open = goal
            var rest_proven = false
            match goal:
                case F.And(xs):
                    if self.live and not limited:
                        var left: [F] = []
                        for x in xs:
                            if not self.holds(x):
                                left.push(x)
                        if 0 < len(left) < len(xs):
                            open = F.and_(left)
                            rest_proven = true
                case _:
                    pass
            for n in self.known_facts_note(open):
                d = d.note(cap_note(n))
            if rest_proven:
                d = d.note(
                    cap_note("to prove: " + self.show_f(open)) + " (the rest of it is proven)"
                )
            else:
                d = d.note(cap_note("to prove: " + self.show_f(goal)))
            if limited:
                d = d.note(
                    f"the prover gave up: `{self.fn_name}` is too long or complex for it (it does a limited amount of work per function), so this may well be true"
                )
                d.help = [
                    f"split `{self.fn_name}` into smaller functions (each is proven on its own), or check this with `assert` instead"
                ]
            elif self.live:
                var all = self.st.facts
                all.extend(self.defs)
                var w = 0
                let gave_up = prove_work(all, goal, self.ranges, ref w) == GAVE_UP
                if not gave_up:
                    match self.values_note(all, open):
                        case Some(n):
                            d = d.note(cap_note(n))
                        case None:
                            pass
                if gave_up:
                    d = d.note(
                        "the prover gave up: what it knows here splits into too many cases to check them all, so this may well be true"
                    )
                    # the usual advice (add facts) would only add cases
                    d.help = [
                        "check it with `assert` (at runtime) instead, or move the branches before this point into a function whose `ensures` states just what is needed here"
                    ]
        self.diags.push(d)

    # Name the values made since atom `na` and content `nc` after `to`
    # instead of the expression `from` (only in messages).
    fn rename_since(ref self, na: int, nc: int, from: str, to: str):
        if from == "" or from == to or "'" in to or from.ends_with("..."):
            return
        for a in na..len(self.atom_names):
            self.atom_names[a] = self.atom_names[a].replace(from, to)
        for c in nc..len(self.content_names):
            self.content_names[c] = self.content_names[c].replace(from, to)

    # `let (k, v) = for'12`, which unpacks a hidden loop variable: the parts
    # of its value are named after `k` and `v` from now on.
    fn unpack_hidden(ref self, init: Expr, ids: [int]):
        var base = ""
        match (init.kind, init.res):
            case (ExprKind.Ident(_), Res.Local(h)):
                base = self.hidden.get(h).unwrap_or("")
            case _:
                pass
        if base == "":
            return
        var j = len(ids)
        while j > 0:
            j -= 1
            let q = f"{base}.{j}"
            let to = self.local_name(ids[j])
            if "'" in to:
                # a nested pattern: unpacked by the next `let`
                self.hidden[ids[j]] = q
            elif to != "_" and to != "":
                for a in 0..len(self.atom_names):
                    self.atom_names[a] = replace_name(self.atom_names[a], q, to)
                for c in 0..len(self.content_names):
                    self.content_names[c] = replace_name(self.content_names[c], q, to)

    # Short source text for naming unknown values in messages.
    fn name_of(self, e: Expr) -> str:
        let s = split_ws(self.snippet(e.span))
        let cs = s.chars()
        if len(cs) > 32:
            return "".join(cs[:29]) + "..."
        return s

    # ------------------------------------------------------------ specs
    fn spec_cond(ref self, e: Expr) -> F:
        let was = self.spec
        self.spec = true
        let v = self.eval(e)
        self.spec = was
        return self.as_bool(v)

    fn spec_cond_in(ref self, env: {int: V}, e: Expr) -> F:
        let saved = self.alt_env
        self.alt_env = Some(env)
        let f = self.spec_cond(e)
        self.alt_env = saved
        return f

    # ------------------------------------------------------------ struct invariants
    fn inv_facts(ref self, sid: int, v: V) -> [F]:
        let si = self.info.structs[sid]
        var out: [F] = []
        for inv in si.invariants:
            out.push(self.spec_cond_in({si.inv_self: v}, inv))
        return out

    fn assume_inv(ref self, sid: int, v: V):
        if not self.live or len(self.info.structs[sid].invariants) == 0:
            return
        for f in self.inv_facts(sid, v):
            self.assume(f)

    # E0609 unless `v` keeps the invariant of struct `sid`
    fn check_inv(ref self, sid: int, v: V, span: Span, what: str, help: str):
        let si = self.info.structs[sid]
        if not self.live or len(si.invariants) == 0:
            return
        let fs = self.inv_facts(sid, v)
        for i, f in enumerate(fs):
            if not self.holds(f):
                let d = (
                    diag.error(
                        "E0609",
                        f"cannot prove the invariant of `{self.info.struct_names[sid]}`"
                    )
                    .label(span, what)
                    .label(si.invariants[i].span, "invariant declared here")
                    .with_help(help)
                )
                self.fail(d, f)
            self.assume(f)

    # A `ref self` method returns: `self` must keep its invariant again.
    fn check_own_inv(ref self, span: Span):
        if self.own_self < 0 or not self.own_ref or not self.live:
            return
        let v = self.lookup(self.own_self, self.local_ty(self.own_self))
        self.check_inv(
            self.own_sid,
            v,
            span,
            "`self` might break the invariant when the method returns here",
            "make every path through the method restore the invariant, or `assert` the fact it needs"
        )

    # `S(...)`: a new value, which must keep the invariant of `S`
    fn ctor(ref self, sid: int, args: [Arg], e: Expr) -> V:
        let fields = self.info.structs[sid].fields
        var vals: [V] = [V.Opaque] * len(fields)
        for i, a in enumerate(args):
            let v = self.eval(a.expr)
            var idx = i
            match a.name:
                case Some((n, _)):
                    for j, fd in enumerate(fields):
                        if fd.0 == n:
                            idx = j
                            break
                case None:
                    pass
            if idx < len(vals):
                vals[idx] = v
        let out = V.Agg(vals)
        if not self.spec:
            self.check_inv(
                sid,
                out,
                e.span,
                f"this `{self.info.struct_names[sid]}` might break its invariant",
                "check the values before building it, e.g. with an `if` that returns an error otherwise"
            )
        return out

    fn check_ensures(ref self, ret: Option[V], span: Span):
        let ens = self.ensures
        if len(ens) == 0:
            return
        match (self.result_local, ret):
            case (Some(r), Some(v)):
                if self.live:
                    self.st.env[r] = v
            case _:
                pass
        for e in ens:
            let f = self.spec_cond(e)
            if not self.holds(f):
                let d = (
                    diag.error("E0602", f"cannot prove the postcondition of `{self.fn_name}`")
                    .label(
                        span,
                        "this might return without `" + self.snippet(e.span) + "` being true"
                    )
                    .label(e.span, "postcondition declared here")
                    .with_help(
                        "strengthen the function's `requires`, add a loop `invariant`, or check the claim with `assert` before returning"
                    )
                )
                self.fail(d, f)
            self.assume(f)

    # ------------------------------------------------------------ statements
    fn block(ref self, b: Block):
        for s in b.stmts:
            if not self.live:
                return
            self.stmt(s)

    fn lookup(ref self, id: int, ty: Ty) -> V:
        match self.alt_env:
            case Some(env):
                match env.get(id):
                    case Some(v):
                        return v
                    case None:
                        return self.fresh_val(ty, self.local_name(id))
            case None:
                pass
        if self.live:
            match self.st.env.get(id):
                case Some(v):
                    return v
                case None:
                    pass
        let name = self.local_name(id)
        let v = self.fresh_val(ty, name)
        self.bind(id, v)
        return v

    fn bind(ref self, id: int, v: V):
        if self.live:
            self.st.env[id] = v

    fn stmt(ref self, s: Stmt):
        match s.kind:
            case StmtKind.Let(mutable, pat, _, init, _):
                let na = len(self.atom_names)
                let nc = len(self.content_names)
                let v = self.eval(init)
                # in messages, `let t = mk(n)` makes `len(t.xs)`, not `len(mk(n).xs)`
                let from = self.name_of(init)
                match pat:
                    case LetPat.Name(_, _):
                        let to = self.local_name(s.locals[0])
                        self.rename_since(na, nc, from, to)
                        self.bind(s.locals[0], v)
                        match v:
                            case V.Int(l):
                                if (
                                    not mutable
                                    and "'" not in to
                                    and len(l.t) + (1 if l.c != 0 else 0) > 1
                                ):
                                    self.aliases[lin_key(l)] = to
                            case _:
                                pass
                    case LetPat.Tuple(_):
                        # the last first: `.1` is the start of `.10`
                        var j = len(s.locals)
                        while j > 0:
                            j -= 1
                            self.rename_since(na, nc, f"{from}.{j}", self.local_name(s.locals[j]))
                        self.unpack_hidden(init, s.locals)
                        for i, id in enumerate(s.locals):
                            var x = V.Opaque
                            var have = false
                            match v:
                                case V.Agg(vs):
                                    if i < len(vs):
                                        x = vs[i]
                                        have = true
                                case _:
                                    pass
                            if not have:
                                x = self.fresh_val(self.local_ty(id), self.local_name(id))
                            self.bind(id, x)
            case StmtKind.Assign(target, op, value):
                let rhs = self.eval(value)
                match self.lvalue_path(target, op.is_none()):
                    case Some((root, steps)):
                        var new = rhs
                        match op:
                            case Some(o):
                                let cur = self.read_path(root, steps)
                                match (target.ty, cur, rhs):
                                    case (Ty.Int(k), _, _):
                                        let a = self.as_int(cur, target.ty)
                                        let b = self.as_int(rhs, value.ty)
                                        new = self.compound(s.span, o, a, b, k)
                                    case (Ty.Str, V.Str(a), V.Str(b)):
                                        let nm = "len(" + self.name_of(target) + ")"
                                        let n = self.lin(a.add(b), nm)
                                        self.cap_len(n)
                                        new = V.Str(n)
                                    case (Ty.Array(_), V.Arr(c, a), V.Arr(_, b)):
                                        # `xs += ys` is `xs = xs + ys`
                                        let nm = "len(" + self.name_of(target) + ")"
                                        let n = self.lin(a.add(b), nm)
                                        self.cap_len(n)
                                        new = V.Arr(self.fresh_content(self.content_names[c]), n)
                                    case _:
                                        new = self.fresh_val(target.ty, self.name_of(target))
                            case None:
                                pass
                        let old = self.lookup(root, self.local_ty(root))
                        let nv = self.write_path(old, steps, new)
                        self.bind(root, nv)
                    case None:
                        pass
            case StmtKind.ExprStmt(e):
                self.eval(e)
                match e.kind:
                    case ExprKind.Call(_, _):
                        match e.cres:
                            case CallRes.Builtin(Builtin.Exit):
                                self.stop_call(
                                    e.span,
                                    "`exit`",
                                    "return a value or a `Result` instead, so the caller decides what happens"
                                )
                                self.live = false
                            case CallRes.Builtin(Builtin.Panic):
                                self.stop_call(
                                    e.span,
                                    "`panic`",
                                    "if this can't happen, give the prover the facts that show it (`requires`, `invariant`); otherwise handle the case or return a `Result`"
                                )
                                self.live = false
                            case _:
                                pass
                    case _:
                        pass
            case StmtKind.If(branches, els):
                self.if_chain(branches, els)
            case StmtKind.Match(scrut, cases):
                self.match_stmt(scrut, cases)
            case StmtKind.While(cond, invariants, body):
                self.while_loop(cond, invariants, body)
            case StmtKind.For(_, _, _, iter, invariants, body, is_par):
                self.for_loop(iter, invariants, body, s.local, is_par)
            case StmtKind.Return(value):
                var v: Option[V] = None
                match value:
                    case Some(e):
                        v = Some(self.eval(e))
                    case None:
                        pass
                if self.live:
                    self.check_own_inv(s.span)
                    self.check_ensures(v, s.span)
                self.live = false
            case StmtKind.Break:
                let st = self.take()
                match st:
                    case Some(x):
                        if len(self.loops) > 0:
                            self.loops[len(self.loops) - 1].breaks.push(x)
                    case None:
                        pass
            case StmtKind.Continue:
                self.check_preserved(s.span)
                self.live = false
            case StmtKind.Assert(cond, _):
                let r0 = len(self.remaining)
                let v = self.eval(cond)
                let c = self.as_bool(v)
                # removing the assert removes the checks in its condition too:
                # only when none of them stays
                if pure_expr(cond) and len(self.remaining) == r0 and self.holds(c):
                    self.proven[key(s.span, TAG_ASSERT)] = true
                else:
                    self.failed[key(s.span, TAG_ASSERT)] = true
                    if not self.test and self.live:
                        self.remain(s.span, "assert", Some(c))
                        # one that always fails is written on purpose (`assert false`)
                        # or a bug: `--report` says which, and like `panic` it ends the path,
                        # so nothing after it is proven from a contradiction
                        if self.holds(c.not_()) and not self.holds(F.False):
                            self.always.push((s.span, "assert"))
                            self.live = false
                self.assume(c)
            case StmtKind.Prove(e):
                let f = self.spec_cond(e)
                if not self.holds(f):
                    var d = diag.error(
                        "E0605",
                        "cannot prove this claim"
                    ).label(e.span, "the prover could not show this is always true")
                    if self.in_rule:
                        d = d.note(f"rule \"{self.rule}\" isn't proven, so nothing is built").with_help(
                            "change the code the rule covers (or add `ensures`, `invariant` and `requires` lines there) until this follows; don't change the rule unless its owner agrees"
                        )
                    else:
                        d = d.with_help(
                            "add facts it can use (`requires`, `invariant`, or an `assert` before this line), or use `assert` to check it at runtime instead"
                        )
                    self.fail(d, f)
                self.assume(f)
            case _:
                pass

    fn merge(ref self, a0: Option[St], b0: Option[St], k0: int) -> Option[St]:
        if a0.is_none():
            return b0
        if b0.is_none():
            return a0
        let a = a0.unwrap()
        let b = b0.unwrap()
        let n0 = len(self.atom_names)
        let (env, ea, eb, hull) = self.merge_env(a.env, b.env)
        let k = min(k0, min(len(a.facts), len(b.facts)))
        var facts = a.facts[:k]
        var fa = a.facts[k:]
        fa.extend(ea)
        var fb = b.facts[k:]
        fb.extend(eb)
        let both = F.or_([F.and_(fa), F.and_(fb)])
        if both.size() <= MERGE_MAX:
            facts.push(both)
        else:
            # too big: keep what both branches agree on
            for f in fa:
                if f in fb:
                    facts.push(f)
            self.drop_from(n0)
        facts.extend(hull)
        return Some(St(env=env, facts=facts))

    fn has_dropped(self, v: V) -> bool:
        if len(self.dropped) == 0:
            return false
        match v:
            case V.Int(l):
                return any(p.0 in self.dropped for p in l.t)
            case V.Agg(vs):
                return any(self.has_dropped(x) for x in vs)
            case _:
                return false

    # The values made since atom `n0` lost what their paths said about them.
    fn drop_from(ref self, n0: int):
        for x in n0..len(self.atom_names):
            self.dropped[x] = true

    # The variables of two paths' environments: a fresh value where they
    # differ, with what it equals on each path.
    fn merge_env(ref self, a: {int: V}, b: {int: V}) -> ({int: V}, [F], [F], [F]):
        var env: {int: V} = {}
        var ea: [F] = []
        var eb: [F] = []
        var hull: [F] = []
        # in a fixed order, so fresh atoms and facts are the same on every run
        var keys = [x for x in a.keys() if x in b]
        keys.sort()
        for id in keys:
            let va = a[id]
            let vb = b[id]
            env[id] = self.merge_val(
                va,
                vb,
                self.local_ty(id),
                self.local_name(id),
                ref ea,
                ref eb,
                ref hull
            )
        return (env, ea, eb, hull)

    # The value that is `va` on one path and `vb` on the other: the parts
    # they share stay; a fresh value replaces each part that differs, with
    # what it equals on each path (`ea`, `eb`) and on both (`hull`).
    fn merge_val(
        ref self,
        va: V,
        vb: V,
        ty: Ty,
        name: str,
        ref ea: [F],
        ref eb: [F],
        ref hull: [F]
    ) -> V:
        if va == vb:
            return va
        match (va, vb):
            case (V.Agg(xs), V.Agg(ys)):
                if len(xs) == len(ys) and all(self.field_of(ty, i).is_some() for i in 0..len(xs)):
                    var vs: [V] = []
                    for i in 0..len(xs):
                        let (fname, fty) = self.field_of(ty, i).unwrap()
                        vs.push(
                            self.merge_val(
                                xs[i],
                                ys[i],
                                fty,
                                name + "." + fname,
                                ref ea,
                                ref eb,
                                ref hull
                            )
                        )
                    return V.Agg(vs)
            case (V.Arr(ca, la), V.Arr(cb, lb)):
                # the same elements where both are in bounds: the same content
                let c = ca if ca == cb else self.fresh_content(name)
                if la == lb:
                    return V.Arr(c, la)
                let l = self.fresh_len("len(" + name + ")")
                ea.push(F.equal(l, la))
                eb.push(F.equal(l, lb))
                hull_lin(l, la, lb, ref hull)
                return V.Arr(c, l)
            case _:
                pass
        let nv = self.fresh_val(ty, name)
        self.range_hull(nv, va, vb)
        # made from a value whose facts were dropped: so are some of its own
        if self.has_dropped(va) or self.has_dropped(vb):
            for a in fresh_atoms(nv):
                self.dropped[a] = true
        match val_eq(nv, va):
            case Some(f):
                ea.push(f)
            case None:
                pass
        match val_eq(nv, vb):
            case Some(f):
                eb.push(f)
            case None:
                pass
        hull_facts(nv, va, vb, ref hull)
        return nv

    # `nv` is `va` or `vb`: as an integer, it is between the least and the
    # greatest value their parts' ranges allow. Kept as its range (which always
    # holds), this bounds a variable that many `if`s change without a proof
    # having to go back through all of them.
    fn range_hull(ref self, nv: V, va: V, vb: V):
        match (nv, va, vb):
            case (V.Int(n), V.Int(x), V.Int(y)):
                if len(n.t) != 1 or n.c != 0 or n.t[0].1 != 1:
                    return
                let a = n.t[0].0
                if a >= len(self.ranges):
                    return
                let (rx, ry) = (self.range_of(x), self.range_of(y))
                match (self.ranges[a], rx.0, rx.1, ry.0, ry.1):
                    case (Some(r), Some(xl), Some(xh), Some(yl), Some(yh)):
                        let lo = max(r.0, min(xl, yl))
                        let hi = min(r.1, max(xh, yh))
                        if lo <= hi:
                            self.ranges[a] = Some((lo, hi))
                    case _:
                        pass
            case _:
                pass

    # The values `l` can have by its atoms' ranges alone.
    fn range_of(self, l: Lin) -> (Option[i128], Option[i128]):
        return lin_range(l, self.ranges)

    # Narrow the range of `a`, a value just made, to what `fs` (facts about it
    # that hold where it is made) imply by the ranges of the other values.
    # It is a fresh value, so no other path says anything about it: its range
    # holds everywhere, and proofs about it don't need to go back through `fs`
    # (a call's `ensures` with an `or`, whose cases would multiply).
    fn narrow(ref self, a: int, fs: [F]):
        if a >= len(self.ranges):
            return
        var b: (Option[i128], Option[i128]) = (None, None)
        match self.ranges[a]:
            case Some(r):
                b = (Some(r.0), Some(r.1))
            case None:
                pass
        for f in fs:
            b = meet(b, fact_bounds(f, a, self.ranges))
        match b:
            case (Some(lo), Some(hi)):
                if lo <= hi:
                    self.ranges[a] = Some((lo, hi))
            case _:
                pass

    # The name and type of field `k` of a struct or tuple type.
    fn field_of(self, ty: Ty, k: int) -> Option[(str, Ty)]:
        match ty:
            case Ty.Struct(sid):
                let fields = self.info.structs[sid].fields
                if 0 <= k < len(fields):
                    return Some(fields[k])
            case Ty.Tuple(ts):
                if 0 <= k < len(ts):
                    return Some((f"{k}", ts[k]))
            case _:
                pass
        return None

    # Before code that runs on some paths only (`a if c else b`, the right
    # side of `and`/`or`, the later operands of `a < b < c`, a `match`
    # guard): its effects must stay on its path (see `join`). None in
    # specifications, which change nothing, and where nothing runs.
    fn fork(self) -> Option[Fork]:
        if self.spec or not self.live:
            return None
        return Some(Fork(base=self.st, k=len(self.st.facts), na=len(self.atom_names)))

    # The state after two paths from `fk`, taken when `ga` and `gb` hold. The
    # facts a path learned about values it created hold when its guard does
    # (the others, about older values, are dropped: they'd only slow the
    # solver down).
    fn join(ref self, fk: Fork, a0: Option[St], ga: F, b0: Option[St], gb: F) -> Option[St]:
        if a0.is_none():
            return b0
        if b0.is_none():
            return a0
        let a = a0.unwrap()
        let b = b0.unwrap()
        let n0 = len(self.atom_names)
        let (env, ea, eb, hull) = self.merge_env(a.env, b.env)
        var fa = new_facts(a.facts, fk)
        fa.extend(ea)
        var fb = new_facts(b.facts, fk)
        fb.extend(eb)
        var facts = fk.base.facts
        if len(fa) > 0 or len(fb) > 0:
            fa.push(ga)
            fb.push(gb)
            let both = F.or_([F.and_(fa), F.and_(fb)])
            if both.size() <= MERGE_MAX:
                facts.push(both)
            else:
                self.drop_from(n0)
        facts.extend(hull)
        return Some(St(env=env, facts=facts))

    # Evaluate `e` on the path where `guard` holds only; the other path runs nothing.
    fn eval_when(ref self, guard: F, e: Expr) -> V:
        match self.fork():
            case Some(fk):
                self.assume(guard)
                let v = self.eval(e)
                let s1 = self.take()
                var other = fk.base
                let ng = guard.not_()
                if ng != F.True:
                    other.facts.push(ng)
                let joined = self.join(fk, s1, guard, Some(other), ng)
                self.put(joined)
                return v
            case None:
                let s = self.begin_assume(guard)
                let v = self.eval(e)
                self.end_assume(s)
                return v

    fn if_chain(ref self, branches: [(Expr, Block)], els: Option[Block]):
        let c = self.cond(branches[0].0)
        let base0 = self.take()
        if base0.is_none():
            return
        let base = base0.unwrap()
        let k = len(base.facts)
        var t = base
        if c != F.True:
            t.facts.push(c)
        self.put(Some(t))
        self.block(branches[0].1)
        let s1 = self.take()
        var e = base
        let nc = c.not_()
        if nc != F.True:
            e.facts.push(nc)
        self.put(Some(e))
        if len(branches) > 1:
            self.if_chain(branches[1:], els)
        else:
            match els:
                case Some(b):
                    self.block(b)
                case None:
                    pass
        let s2 = self.take()
        let m = self.merge(s1, s2, k)
        self.put(m)

    # Cases are tried in order: each case sees the facts of its own pattern and
    # (when expressible) that the earlier patterns didn't match.
    fn match_stmt(ref self, scrut: Expr, cases: [Case]):
        let sv = self.eval(scrut)
        let base0 = self.take()
        if base0.is_none():
            return
        var cur = base0.unwrap()
        let k = len(cur.facts)
        var out: Option[St] = None
        for c in cases:
            let hit = self.pat_cond(c.pat, sv)
            var t = cur
            match hit:
                case Some(h):
                    if h != F.True:
                        t.facts.push(h)
                case None:
                    pass
            self.put(Some(t))
            self.bind_pattern(c.pat, sv, scrut.ty)
            var gcond = F.True
            # the state after a guard that changes something
            var after_guard: Option[St] = None
            match c.guard:
                case Some(g):
                    var gm: {int: int} = {}
                    mods_expr(g, self.info, ref gm)
                    gcond = self.cond(g)
                    if len(gm) > 0:
                        after_guard = self.cur()
                    self.assume(gcond)
                case None:
                    pass
            self.block(c.body)
            let s = self.take()
            out = self.merge(out, s, k)
            # later cases run only if this one didn't match
            match after_guard:
                case Some(ag0):
                    # either the pattern didn't match, or it did and the
                    # guard (and what it changed) was false
                    var miss = cur
                    match hit:
                        case Some(h):
                            let nh = h.not_()
                            if nh != F.True:
                                miss.facts.push(nh)
                        case None:
                            pass
                    var ag = ag0
                    let ng = gcond.not_()
                    if ng != F.True:
                        ag.facts.push(ng)
                    match self.merge(Some(miss), Some(ag), len(cur.facts)):
                        case Some(m):
                            cur = m
                        case None:
                            pass
                case None:
                    match hit:
                        case Some(h):
                            let n = F.and_([h, gcond]).not_()
                            if n != F.True:
                                cur.facts.push(n)
                        case None:
                            pass
        self.put(out)

    # Exact condition for `p` matching `v`, when it can be expressed.
    fn pat_cond(ref self, p: Pattern, v: V) -> Option[F]:
        match p.kind:
            case PatKind.Wild | PatKind.Bind(_):
                return Some(F.True)
            case PatKind.Int(n):
                match v:
                    case V.Int(l):
                        return Some(F.equal(l, Lin.konst(n)))
                    case _:
                        return None
            case PatKind.Bool(b):
                match v:
                    case V.Bool(f):
                        return Some(f if b else f.not_())
                    case _:
                        return None
            case PatKind.Or(alts):
                var fs: [F] = []
                for a in alts:
                    fs.push(self.pat_cond(a, v)?)
                return Some(F.or_(fs))
            case PatKind.Tuple(ps):
                match v:
                    case V.Agg(vs):
                        if len(ps) != len(vs):
                            return None
                        var fs: [F] = []
                        for i in 0..len(ps):
                            fs.push(self.pat_cond(ps[i], vs[i])?)
                        return Some(F.and_(fs))
                    case _:
                        return None
            case _:
                return None

    fn bind_pattern(ref self, p: Pattern, v: V, ty: Ty):
        match p.kind:
            case PatKind.Bind(_):
                self.bind(p.local, v)
            case PatKind.Tuple(ps):
                var ts: [Ty] = [Ty.Error] * len(ps)
                match ty:
                    case Ty.Tuple(xs):
                        ts = xs
                    case _:
                        pass
                for i, q in enumerate(ps):
                    let t = ts[i] if i < len(ts) else Ty.Error
                    var x = V.Opaque
                    var have = false
                    match v:
                        case V.Agg(vs):
                            if i < len(vs):
                                x = vs[i]
                                have = true
                        case _:
                            pass
                    if not have:
                        x = self.fresh_val(t, split_ws(self.snippet(q.span)))
                    self.bind_pattern(q, x, t)
            case PatKind.Variant(_, _):
                match p.vres:
                    case Some((eid, vi)):
                        let fts = self.info.enums[eid].variants[vi].fields
                        for i in 0..min(len(p.fields), len(fts)):
                            let x = self.fresh_val(fts[i].1, fts[i].0)
                            self.bind_pattern(p.fields[i], x, fts[i].1)
                    case None:
                        pass
            case _:
                pass

    fn havoc(ref self, body: Block):
        var effs: [Eff] = []
        effs_block(body, self.info, ref effs)
        self.havoc_effs(effs)

    # Forget what code that runs an unknown number of times may change: `effs`.
    fn havoc_effs(ref self, effs: [Eff]):
        self.own_kept = self.own_inv_kept(effs)
        self.havoc_mods(resolve_effs(effs, self.fps))
        self.own_kept = false

    # Whether a loop that changes `self` (a method's, which may break its
    # invariant in between) only through `effs` keeps the invariant: it holds
    # before the loop, and each change keeps it. A call that takes `self`
    # whole by `ref` proves it when it returns; a field no invariant reads
    # can't break it.
    fn own_inv_kept(ref self, effs: [Eff]) -> bool:
        if self.own_self < 0 or not self.live:
            return false
        let si = self.info.structs[self.own_sid]
        var any = false
        for f in effs:
            if f.root != self.own_self:
                continue
            any = true
            if len(f.path) > 0:
                let k = f.path[0]
                if (
                    0 <= k < len(si.fields)
                    and not si.inv_all
                    and si.fields[k].0 not in si.inv_fields
                ):
                    continue
                return false
            if not (0 <= f.callee < len(self.info.fns)):
                return false
            let ps = self.info.fns[f.callee].params
            if not (0 <= f.param < len(ps)) or not ps[f.param].by_ref:
                return false
            if ps[f.param].ty != Ty.Struct(self.own_sid):
                return false
        if not any:
            return false
        let v = self.lookup(self.own_self, self.local_ty(self.own_self))
        for g in self.inv_facts(self.own_sid, v):
            if not self.holds(g):
                return false
        return true

    fn havoc_mods(ref self, mods: {int: [[int]]}):
        let na = len(self.atom_names)
        self.havoc_paths(mods)
        for a in na..len(self.atom_names):
            self.looped[a] = true

    fn havoc_paths(ref self, mods: {int: [[int]]}):
        var ids = mods.keys()
        ids.sort()
        for id in ids:
            if not self.live:
                continue
            match self.st.env.get(id):
                case Some(cur):
                    var nv = cur
                    for p in mods[id]:
                        self.skip_inv = id == self.own_self and len(p) == 0
                        nv = self.havoc_at(nv, p, self.local_ty(id), self.local_name(id))
                    self.skip_inv = false
                    # only a method's `self` breaks its invariant in between
                    if id != self.own_self or self.own_kept:
                        match self.local_ty(id):
                            case Ty.Struct(sid):
                                self.assume_inv(sid, nv)
                            case _:
                                pass
                    self.bind(id, nv)
                case None:
                    pass

    # `v` (of type `ty`) with the part at `path` forgotten.
    fn havoc_at(ref self, v: V, path: [int], ty: Ty, name: str) -> V:
        if len(path) == 0:
            return self.fresh_val(ty, name)
        if path[0] == CONTENT:
            match v:
                case V.Arr(_, l):
                    return V.Arr(self.fresh_content(name), l)
                case _:
                    return self.fresh_val(ty, name)
        match (v, self.field_of(ty, path[0])):
            case (V.Agg(vs0), Some((fname, fty))):
                if path[0] < len(vs0):
                    var vs = vs0
                    vs[path[0]] = self.havoc_at(vs0[path[0]], path[1:], fty, name + "." + fname)
                    return V.Agg(vs)
            case _:
                pass
        return self.fresh_val(ty, name)

    # The part of `v` at a path of fields (None past an index).
    fn at_path(self, v: V, path: [int], ty: Ty) -> Option[V]:
        if len(path) == 0:
            return Some(v)
        let (_, fty) = self.field_of(ty, path[0])?
        match v:
            case V.Agg(vs):
                if 0 <= path[0] < len(vs):
                    return self.at_path(vs[path[0]], path[1:], fty)
            case _:
                pass
        return None

    fn check_entry_invs(ref self, invs: [Expr], extra: F):
        for inv in invs:
            let f = self.spec_cond(inv)
            if not self.holds_with(extra, f):
                let d = (
                    diag.error("E0603", "loop invariant might not hold when the loop starts")
                    .label(inv.span, "might be false before the first iteration")
                    .with_help(
                        "establish it before the loop, e.g. by initializing variables so the claim holds"
                    )
                )
                self.fail(d, f)

    fn check_preserved(ref self, at: Span):
        if not self.live or len(self.loops) == 0:
            return
        let cx = self.loops[len(self.loops) - 1]
        let invs = cx.invs
        let next = cx.next
        var saved: Option[V] = None
        match next:
            case Some((id, v)):
                saved = self.st.env.get(id)
                self.bind(id, v)
            case None:
                pass
        for inv in invs:
            let f = self.spec_cond(inv)
            if not self.holds(f):
                let d = (
                    diag.error("E0604", "loop invariant might not be preserved by the loop body")
                    .label(inv.span, "might be false after an iteration")
                    .label(at, "at the end of this iteration")
                    .with_help(
                        "make sure every path through the loop body re-establishes the invariant"
                    )
                )
                self.fail(d, f)
                match next:
                    case Some((id, V.Int(l))):
                        let n = self.local_name(id)
                        let last = len(self.diags) - 1
                        self.diags[last] = self.diags[last].note(
                            f"it's checked for the next iteration, where `{n}` is {self.show_lin(l)}"
                        )
                    case _:
                        pass
        match (next, saved):
            case (Some((id, _)), Some(v)):
                self.bind(id, v)
            case _:
                pass

    # The entry values of the loop's monotone locals (see `monotone`).
    fn mono_starts(self, body: Block, cond: Option[Expr]) -> [(int, int, Lin)]:
        var out: [(int, int, Lin)] = []
        if not self.live:
            return out
        for id, d in monotone(body, cond, self.info):
            match self.st.env.get(id):
                case Some(V.Int(x0)):
                    out.push((id, d, x0))
                case _:
                    pass
        return out

    # After the havoc: each monotone local moved one way only.
    fn mono_facts(ref self, starts: [(int, int, Lin)]):
        for id, d, x0 in starts:
            match self.st.env.get(id):
                case Some(V.Int(x)):
                    self.assume(F.le(x0, x) if d > 0 else F.le(x, x0))
                case _:
                    pass

    fn while_loop(ref self, cond: Expr, invs: [Expr], body: Block):
        self.check_entry_invs(invs, F.True)
        if not self.live:
            return
        let k = len(self.st.facts)
        # the condition runs before every iteration too
        var effs: [Eff] = []
        effs_block(body, self.info, ref effs)
        effs_expr(cond, self.info, ref effs)
        let starts = self.mono_starts(body, Some(cond))
        self.havoc_effs(effs)
        self.mono_facts(starts)
        for inv in invs:
            let f = self.spec_cond(inv)
            self.assume(f)
        let c = self.cond(cond)
        let head0 = self.take()
        if head0.is_none():
            return
        let head = head0.unwrap()
        var exit = head
        exit.facts.push(c.not_())
        var b = head
        b.facts.push(c)
        self.put(Some(b))
        self.loops.push(LoopCx(invs=invs, next=None, breaks=[]))
        self.block(body)
        let end = body.stmts[len(body.stmts) - 1].span if len(body.stmts) > 0 else body.span
        self.check_preserved(end)
        let cx = self.loops.pop()
        var out: Option[St] = Some(exit)
        for br in cx.breaks:
            out = self.merge(out, Some(br), k)
        self.put(out)

    # `range(a, b, s)`: `s != 0`; `counted`: its elements are counted in an
    # int (a comprehension or a `par for`), so there can't be more than 2^63 - 1.
    fn range_checks(ref self, span: Span, vals: [Lin], counted: bool):
        if len(vals) == 3:
            self.kept(span, F.eq(vals[2]).not_(), "step check")
        if not counted:
            return
        if len(vals) == 1:
            self.range_size(span, Lin.konst(0), vals[0], false)
        elif len(vals) == 2:
            self.range_size(span, vals[0], vals[1], false)
        elif len(vals) == 3:
            # either way the distance is enough (if not exact)
            match (vals[1].sub(vals[0]), vals[0].sub(vals[1])):
                case (Some(up), Some(down)):
                    let m = Lin.konst(I64_BOUND)
                    self.kept_x(
                        span,
                        F.and_(
                            [
                                F.or_([F.le(vals[1], vals[0]), F.le(up, m)]),
                                F.or_([F.le(vals[0], vals[1]), F.le(down, m)])
                            ]
                        ),
                        "range size check",
                        false
                    )
                case _:
                    pass

    fn range_size(ref self, span: Span, a: Lin, b: Lin, inclusive: bool):
        let ne = F.le(a, b) if inclusive else F.lt(a, b)
        var d = b.sub(a)
        if inclusive:
            match d:
                case Some(x):
                    d = x.add_c(1)
                case None:
                    pass
        match d:
            case Some(sp):
                self.kept(
                    span,
                    F.or_([ne.not_(), F.le(sp, Lin.konst(I64_BOUND))]),
                    "range size check"
                )
            case None:
                pass

    fn for_loop(ref self, iter: Expr, invs: [Expr], body: Block, var_id: int, counted: bool):
        let vname = self.shown_local(var_id)
        let vty = self.local_ty(var_id)
        var dom = D.Other
        var done = false
        match iter.kind:
            case ExprKind.Range(lo, hi, inclusive):
                let av = self.eval(lo)
                let a = self.as_int(av, lo.ty)
                let bv = self.eval(hi)
                let b = self.as_int(bv, hi.ty)
                if counted:
                    self.range_size(iter.span, a, b, inclusive)
                dom = D.Range(a, b, inclusive)
                done = true
            case ExprKind.Call(_, args):
                if iter.cres == CallRes.Range:
                    var vals: [Lin] = []
                    for a in args:
                        let v = self.eval(a.expr)
                        vals.push(self.as_int(v, a.expr.ty))
                    self.range_checks(iter.span, vals, counted)
                    if len(vals) == 1:
                        dom = D.Range(Lin.konst(0), vals[0], false)
                    elif len(vals) == 2:
                        dom = D.Range(vals[0], vals[1], false)
                    else:
                        dom = D.Stepped(vals[0], vals[1], vals[2].is_const())
                    done = true
            case _:
                pass
        if not done:
            match self.eval(iter):
                case V.Arr(c, l):
                    dom = D.Arr(c, l, iter.ty.elem())
                case _:
                    dom = D.Other
        if not self.live:
            return
        let entry = self.st
        let k = len(entry.facts)
        # the counters' values before the loop
        var starts: [(int, Lin)] = []
        match dom:
            case D.Range(_, _, _):
                for c in counters(body, self.info):
                    match entry.env.get(c):
                        case Some(V.Int(c0)):
                            starts.push((c, c0))
                        case _:
                            pass
            case _:
                pass
        # invariants: entry, using the first value of the loop variable
        var nonempty = F.True
        var first: Option[V] = None
        var last: Option[V] = None
        match dom:
            case D.Range(lo, hi, incl):
                nonempty = F.le(lo, hi) if incl else F.lt(lo, hi)
                first = Some(V.Int(lo))
                if incl:
                    match hi.add_c(1):
                        case Some(h):
                            last = Some(V.Int(h))
                        case None:
                            pass
                else:
                    last = Some(V.Int(hi))
            case _:
                pass
        if len(invs) > 0:
            let saved = self.st.env.get(var_id) if self.live else None
            match first:
                case Some(v):
                    self.bind(var_id, v)
                case None:
                    pass
            # a range loop's invariant describes states between iterations
            # lo..=hi(+1); it need only hold initially when the range is a valid interval
            var valid = F.True
            match dom:
                case D.Range(lo, hi, incl):
                    if incl:
                        valid = F.le(lo, hi.add_c(1).unwrap_or(hi))
                    else:
                        valid = F.le(lo, hi)
                case _:
                    pass
            self.check_entry_invs(invs, valid)
            if self.live:
                self.st.env.remove(var_id)
                match saved:
                    case Some(v):
                        self.st.env[var_id] = v
                    case None:
                        pass
        let mono = self.mono_starts(body, None)
        self.havoc(body)
        self.mono_facts(mono)
        let head = self.cur()
        # bind the loop variable
        var v = V.Opaque
        var next: Option[V] = None
        match dom:
            case D.Range(lo, hi, incl):
                var ik = IntTy.I64
                match vty:
                    case Ty.Int(x):
                        ik = x
                    case _:
                        pass
                let i = self.fresh_int(vname, ik)
                self.assume(F.le(lo, i))
                self.assume(F.le(i, hi) if incl else F.lt(i, hi))
                match i.add_c(1):
                    case Some(n):
                        next = Some(V.Int(n))
                    case None:
                        pass
                v = V.Int(i)
                # x0 <= x and x + lo <= k + x0 (see `counters`)
                for c, c0 in starts:
                    match self.st.env.get(c):
                        case Some(V.Int(x)):
                            self.assume(F.le(c0, x))
                            match (x.add(lo), i.add(c0)):
                                case (Some(l), Some(r)):
                                    self.assume(F.le(l, r))
                                case _:
                                    pass
                        case _:
                            pass
            case D.Stepped(lo, hi, step):
                var ik = IntTy.I64
                match vty:
                    case Ty.Int(x):
                        ik = x
                    case _:
                        pass
                let i = self.fresh_int(vname, ik)
                match step:
                    case Some(s):
                        if s > 0:
                            self.assume(F.le(lo, i))
                            self.assume(F.lt(i, hi))
                        elif s < 0:
                            self.assume(F.lt(hi, i))
                            self.assume(F.le(i, lo))
                    case None:
                        pass
                v = V.Int(i)
            case D.Arr(c, l, elem):
                let kx = self.fresh_nonneg("index of " + vname)
                self.assume(F.lt(kx, l))
                v = self.sel(c, kx, elem)
            case D.Other:
                v = self.fresh_val(vty, vname)
        self.bind(var_id, v)
        if "'" in self.local_name(var_id):
            match dom:
                case D.Arr(c, _, _):
                    self.hidden[var_id] = self.content_names[c] + "[index of " + vname + "]"
                case _:
                    self.hidden[var_id] = vname
        for inv in invs:
            let f = self.spec_cond(inv)
            self.assume(f)
        var is_range = false
        match dom:
            case D.Range(_, _, _):
                is_range = true
            case _:
                pass
        var nx: Option[(int, V)] = None
        if is_range and next.is_some():
            nx = Some((var_id, next.unwrap()))
        elif len(invs) > 0:
            # the invariant must hold for whatever the next element is
            nx = Some((var_id, self.fresh_val(vty, vname)))
        self.loops.push(LoopCx(invs=invs, next=nx, breaks=[]))
        self.block(body)
        let end = body.stmts[len(body.stmts) - 1].span if len(body.stmts) > 0 else body.span
        self.check_preserved(end)
        let cx = self.loops.pop()
        # after the loop
        self.put(head)
        var out: Option[St] = None
        if len(invs) == 0:
            out = self.take()
        elif is_range:
            # either no iterations, or all of them ran and the invariant holds at the end
            var empty = entry
            empty.facts.push(nonempty.not_())
            match last:
                case Some(lv):
                    self.bind(var_id, lv)
                case None:
                    pass
            self.assume(nonempty)
            for inv in invs:
                let f = self.spec_cond(inv)
                self.assume(f)
            if self.live:
                self.st.env.remove(var_id)
            let full = self.take()
            out = self.merge(Some(empty), full, k)
        else:
            for inv in invs:
                let f = self.spec_cond(inv)
                self.assume(f)
            out = self.take()
        for br in cx.breaks:
            out = self.merge(out, Some(br), k)
        self.put(out)

    # ------------------------------------------------------------ lvalues
    # `insert`: `e` is assigned with `=`, so if it's `m[k]` the key needn't exist.
    fn lvalue_path(ref self, e: Expr, insert: bool) -> Option[(int, [(Step, Ty)])]:
        match e.kind:
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        return Some((id, []))
                    case _:
                        return None
            case ExprKind.Field(b, _, _):
                let (r, p0) = self.lvalue_path(b, false)?
                var p = p0
                p.push((Step.Field(e.idx), e.ty))
                return Some((r, p))
            case ExprKind.Index(b, idx):
                let iv = self.eval(idx)
                let i = self.as_int(iv, idx.ty)
                let (r, p0) = self.lvalue_path(b, false)?
                var p = p0
                let base = self.read_path(r, p)
                match base:
                    case V.Arr(_, l):
                        let g = F.and_([F.ge(i), F.lt(i, l)])
                        self.implicit(e.span, TAG_INDEX, g, "index bounds check")
                    case _:
                        if not insert:
                            self.map_key_check(b, e.span)
                p.push((Step.Index(i), e.ty))
                return Some((r, p))
            case _:
                return None

    fn read_path(ref self, root: int, steps: [(Step, Ty)]) -> V:
        var v = self.lookup(root, self.local_ty(root))
        for s, t in steps:
            var nv = V.Opaque
            var done = false
            match (s, v):
                case (Step.Field(k), V.Agg(vs)):
                    if k < len(vs):
                        nv = vs[k]
                        done = true
                case (Step.Index(i), V.Arr(c, _)):
                    nv = self.sel(c, i, t)
                    done = true
                case _:
                    pass
            if not done:
                nv = self.fresh_val(t, "?")
            v = nv
        return v

    fn write_path(ref self, old: V, steps: [(Step, Ty)], new: V) -> V:
        if len(steps) == 0:
            return new
        let s = steps[0].0
        let t = steps[0].1
        let rest = steps[1:]
        match (s, old):
            case (Step.Field(k), V.Agg(vs0)):
                if k < len(vs0):
                    var vs = vs0
                    let c = vs[k]
                    vs[k] = self.write_path(c, rest, new)
                    return V.Agg(vs)
                return V.Opaque
            case (Step.Index(i), V.Arr(c, l)):
                let cur = self.sel(c, i, t)
                let ne = self.write_path(cur, rest, new)
                let name = self.content_names[c]
                let c2 = self.fresh_content(name)
                self.define_sel(c2, i, t, ne)
                return V.Arr(c2, l)
            case _:
                return V.Opaque

    # ------------------------------------------------------------ expressions
    fn cond(ref self, e: Expr) -> F:
        let v = self.eval(e)
        return self.as_bool(v)

    # ------------------------------------------------------------ bounds
    # Constant bounds of `l` from the atoms' ranges and the facts here that
    # bound one atom alone: cheap, and enough for products and bit operations.
    fn bounds(self, l: Lin) -> (Option[i128], Option[i128]):
        var lo: Option[i128] = Some(l.c)
        var hi: Option[i128] = Some(l.c)
        for a, k in l.t:
            let ab = self.atom_bounds(a)
            if k > 0:
                lo = add_opt(lo, mul_opt(k, ab.0))
                hi = add_opt(hi, mul_opt(k, ab.1))
            else:
                lo = add_opt(lo, mul_opt(k, ab.1))
                hi = add_opt(hi, mul_opt(k, ab.0))
        if len(l.t) > 1:
            var b = (lo, hi)
            if self.live:
                for f in self.st.facts:
                    b = tighten_lin(f, l, b)
            for f in self.defs:
                b = tighten_lin(f, l, b)
            return b
        return (lo, hi)

    fn atom_bounds(self, a: int) -> (Option[i128], Option[i128]):
        var b: (Option[i128], Option[i128]) = (None, None)
        if a < len(self.ranges):
            match self.ranges[a]:
                case Some(r):
                    b = (Some(r.0), Some(r.1))
                case None:
                    pass
        if self.live:
            for f in self.st.facts:
                b = tighten(f, a, b)
        for f in self.defs:
            b = tighten(f, a, b)
        return b

    fn assume_bounds(ref self, l: Lin, b: (Option[i128], Option[i128])):
        match b.0:
            case Some(x):
                self.assume(F.le(Lin.konst(x), l))
            case None:
                pass
        match b.1:
            case Some(x):
                self.assume(F.le(l, Lin.konst(x)))
            case None:
                pass

    fn arith_val(ref self, op: BinOp, a: Lin, b: Lin, k: IntTy) -> V:
        var r: Option[Lin] = None
        let small = k.bits() <= 64
        match op:
            case BinOp.Add:
                r = a.add(b)
            case BinOp.Sub:
                r = a.sub(b)
            case BinOp.Mul:
                match a.is_const():
                    case Some(c):
                        r = b.scale(c)
                    case None:
                        match b.is_const():
                            case Some(c):
                                r = a.scale(c)
                            case None:
                                let t = Term.Mul(a, b) if lin_le(a, b) else Term.Mul(b, a)
                                let p = Lin.atom(self.term(t, None))
                                var pb = mul_bounds(self.bounds(a), self.bounds(b))
                                if lin_key(a) == lin_key(b) and not nonneg(pb):
                                    pb = (Some(0), pb.1)
                                self.assume_bounds(p, pb)
                                r = Some(p)
            case BinOp.Div | BinOp.Mod:
                var q: Option[Lin] = None
                match b.is_const():
                    case Some(c):
                        if c > 0:
                            q = Some(
                                Lin.atom(self.term(Term.Div(a, Lin.konst(c)), self.div_range(a, c)))
                            )
                        elif c < 0 and wrapping_neg(c) > 0:
                            # floor(a / c) == floor(-a / -c)
                            match a.neg():
                                case Some(na):
                                    let nc = wrapping_neg(c)
                                    q = Some(
                                        Lin.atom(
                                            self.term(
                                                Term.Div(na, Lin.konst(nc)),
                                                self.div_range(na, nc)
                                            )
                                        )
                                    )
                                case None:
                                    pass
                    case None:
                        pass
                match q:
                    case Some(qq):
                        if op == BinOp.Div:
                            r = Some(qq)
                        else:
                            match qq.scale(b.c):
                                case Some(bq):
                                    r = self.const_mod(a, b, a.sub(bq))
                                case None:
                                    r = None
                    case None:
                        if b.is_const().is_none():
                            r = Some(self.div_var(op, a, b))
            case BinOp.BitAnd:
                if small:
                    for x, y in [(a, b), (b, a)]:
                        match y.is_const():
                            case Some(c):
                                if c == -1:
                                    return V.Int(x)
                                # in two's complement the low k bits are x mod 2^k
                                if c > 0 and log2_exact(c + 1) > 0:
                                    return self.arith_val(BinOp.Mod, x, Lin.konst(c + 1), k)
                                if c < 0 and log2_exact(-c) > 0:
                                    match self.arith_val(BinOp.Mod, x, Lin.konst(-c), k):
                                        case V.Int(ml):
                                            match x.sub(ml):
                                                case Some(d):
                                                    return V.Int(d)
                                                case None:
                                                    pass
                                        case _:
                                            pass
                            case None:
                                pass
                let v = self.bit_term(" & ", k, a, b)
                for x in [a, b]:
                    if nonneg(self.bounds(x)):
                        self.assume(F.ge(v))
                        self.assume(F.le(v, x))
                return V.Int(v)
            case BinOp.BitOr | BinOp.BitXor:
                let v = self.bit_term(" | " if op == BinOp.BitOr else " ^ ", k, a, b)
                let ab = self.bounds(a)
                let bb = self.bounds(b)
                if nonneg(ab) and nonneg(bb):
                    self.assume(F.ge(v))
                    match a.add(b):
                        case Some(s):
                            self.assume(F.le(v, s))
                        case None:
                            pass
                    if op == BinOp.BitOr:
                        self.assume(F.le(a, v))
                        self.assume(F.le(b, v))
                    match (ab.1, bb.1):
                        case (Some(x), Some(y)):
                            if max(x, y) < 4611686018427387904:
                                self.assume(F.le(v, Lin.konst(ones_above(max(x, y)))))
                        case _:
                            pass
                return V.Int(v)
            case BinOp.Shr:
                match b.is_const():
                    case Some(c):
                        # an arithmetic shift is floor division
                        if small and 0 <= c < i128(k.bits()) and c <= 62:
                            if c == 0:
                                return V.Int(a)
                            let one: i128 = 1
                            return self.arith_val(BinOp.Div, a, Lin.konst(one << c), k)
                    case None:
                        pass
                let v = self.bit_term(" >> ", k, a, b)
                let ab = self.bounds(a)
                if nonneg(ab):
                    self.assume(F.ge(v))
                    self.assume(F.le(v, a))
                else:
                    match ab.1:
                        case Some(x):
                            if x < 0:
                                self.assume(F.le(a, v))
                                self.assume(F.lt(v, Lin.konst(0)))
                        case None:
                            pass
                return V.Int(v)
            case BinOp.Shl:
                match b.is_const():
                    case Some(c):
                        # it wraps: exact only when the product fits
                        if small and 0 <= c < i128(k.bits()) and c <= 62:
                            let one: i128 = 1
                            match a.scale(one << c):
                                case Some(p):
                                    let ab = self.bounds(a)
                                    let pb = (mul_opt(one << c, ab.0), mul_opt(one << c, ab.1))
                                    match (pb.0, pb.1):
                                        case (Some(x), Some(y)):
                                            if k.min() <= x and y <= k.max():
                                                return V.Int(p)
                                        case _:
                                            pass
                                case None:
                                    pass
                    case None:
                        pass
                return V.Int(self.bit_term(" << ", k, a, b))
            case _:
                return V.Int(self.fresh_int(self.op_name(" " + op.sym() + " ", a, b), k))
        return V.Int(self.lin(r, self.op_name(" " + op.sym() + " ", a, b)))

    # `a % c` for a constant `c`, which is `rest` (`a - c*(a / c)`): a value of
    # its own, between 0 and c (its range), equal to `rest`. As `rest` itself,
    # `acc = (acc + x) % m` lines would make each new value a sum over the
    # quotients of all the lines before, and every proof about it read them all.
    # The range of `a / c` for a constant `c > 0`, from the range of `a`
    # (`/` rounds down, so it keeps the order).
    fn div_range(self, a: Lin, c: i128) -> Option[(i128, i128)]:
        match self.range_of(a):
            case (Some(lo), Some(hi)):
                return Some((lo / c, hi / c))
            case _:
                return None

    fn const_mod(ref self, a: Lin, b: Lin, rest: Option[Lin]) -> Option[Lin]:
        let l = rest?
        let c = b.is_const()?
        let z: i128 = 0
        let one: i128 = 1
        let range = (z, c - one) if c > 0 else (c + one, z)
        let t = Term.Mod(a, b)
        let fresh = term_key(t) not in self.terms
        let m = Lin.atom(self.term(t, Some(range)))
        if fresh:
            self.defs.push(F.equal(m, l))
            self.mods.push((m.t[0].0, a))
        return Some(m)

    # `a / b` or `a % b` for a `b` that isn't a constant
    fn div_var(ref self, op: BinOp, a: Lin, b: Lin) -> Lin:
        let bb = self.bounds(b)
        var is_pos = bb.0.is_some() and bb.0.unwrap() >= 1
        var is_neg = bb.1.is_some() and bb.1.unwrap() <= -1
        if not is_pos and not is_neg:
            is_pos = self.holds(F.le(Lin.konst(1), b))
            if not is_pos:
                is_neg = self.holds(F.le(b, Lin.konst(-1)))
        if op == BinOp.Mod:
            let m = Lin.atom(self.term(Term.Mod(a, b), None))
            # `%` takes the sign of the divisor
            if is_pos:
                self.assume(F.ge(m))
                self.assume(F.lt(m, b))
            elif is_neg:
                self.assume(F.lt(b, m))
                self.assume(F.le(m, Lin.konst(0)))
            return m
        let q = Lin.atom(self.term(Term.Div(a, b), None))
        if is_pos:
            let ab = self.bounds(a)
            if nonneg(ab):
                self.assume(F.ge(q))
                self.assume(F.le(q, a))
            else:
                match ab.1:
                    case Some(x):
                        if x < 0:
                            self.assume(F.le(a, q))
                            self.assume(F.lt(q, Lin.konst(0)))
                    case None:
                        pass
        return q

    # `a op b` for a bit operation the prover doesn't model: unknown, but
    # the same each time (`1 << n` in a check and in a later claim).
    fn bit_term(ref self, op: str, k: IntTy, a: Lin, b: Lin) -> Lin:
        let ty = f"{k.bits()}" + ("i" if k.signed() else "u")
        return Lin.atom(self.term(Term.Bit(op, ty, a, b), int_range(k)))

    fn op_name(self, op: str, a: Lin, b: Lin) -> str:
        return self.show_lin_p(a) + op + self.show_lin_p(b)

    fn eval(ref self, e: Expr) -> V:
        let v = self.eval_(e)
        # what isn't modelled is still a number or a truth value, named after
        # the source in messages
        if v == V.Opaque:
            match e.ty:
                case Ty.Int(_) | Ty.Bool | Ty.Float(_):
                    return self.fresh_val(e.ty, self.name_of(e))
                case _:
                    pass
        return v

    fn eval_(ref self, e: Expr) -> V:
        match e.kind:
            case ExprKind.Int(v):
                match e.ty:
                    case Ty.Int(_):
                        return V.Int(Lin.konst(v))
                    case _:
                        return V.Opaque
            # the prover's numbers stop at the i128 range: past it, only the type's range is known
            case ExprKind.UInt(_):
                return V.Int(self.fresh_int("literal", IntTy.U128))
            case ExprKind.Float(x):
                if e.ty == Ty.Float(FloatTy.F64):
                    return float_const(x)
                return self.fresh_val(e.ty, self.name_of(e))
            case ExprKind.Bool(b):
                return V.Bool(F.from_bool(b))
            case ExprKind.Str(s):
                return V.Str(Lin.konst(i128(len(s))))
            case ExprKind.FStr(segs):
                for s in segs:
                    match s:
                        case FSeg.Part(x, _):
                            self.eval(x)
                        case _:
                            pass
                return V.Str(self.fresh_len("len(f-string)"))
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        let v = self.lookup(id, e.ty)
                        # `self` leaves the method here (copied, passed, returned)
                        if id == self.own_self and not self.spec:
                            self.check_inv(
                                self.own_sid,
                                v,
                                e.span,
                                "`self` is used here, where it might break the invariant",
                                "restore the invariant before using `self` whole"
                            )
                        return v
                    case Res.Const(id):
                        return self.const_val(id)
                    case _:
                        return V.Opaque
            case ExprKind.Try(x):
                self.eval(x)
                # the path where `x` is `None`/`Err` returns here
                if self.live:
                    let saved = self.cur()
                    self.check_own_inv(e.span)
                    self.check_ensures(None, e.span)
                    self.put(saved)
                return self.fresh_val(e.ty, self.name_of(e))
            case ExprKind.Unary(op, x):
                let v = self.eval(x)
                match (op, e.ty):
                    case (UnOp.Neg, Ty.Int(k)):
                        let l = self.as_int(v, x.ty)
                        let n = self.lin(l.neg(), self.name_of(e))
                        self.kept(e.span, in_range(n, k), "overflow check")
                        return V.Int(n)
                    case (UnOp.Neg, Ty.Float(_)):
                        # exact: `below` and `above` trade places
                        match v:
                            case V.Flt(t, nan, below, above):
                                match (t.neg(), below.neg(), above.neg()):
                                    case (Some(nt), Some(nb), Some(na)):
                                        return V.Flt(nt, nan, na, nb)
                                    case _:
                                        pass
                            case _:
                                pass
                        return self.fresh_val(e.ty, self.name_of(e))
                    case (UnOp.Not, _):
                        let f = self.as_bool(v)
                        return V.Bool(f.not_())
                    case (UnOp.BitNot, Ty.Int(k)):
                        # two's complement: ~x is -x - 1, or 2^bits - 1 - x unsigned
                        let l = self.as_int(v, x.ty)
                        if k.bits() <= 64:
                            let top: i128 = -1 if k.signed() else k.max()
                            match Lin.konst(top).sub(l):
                                case Some(n):
                                    return V.Int(n)
                                case None:
                                    pass
                        return V.Int(self.fresh_int("~" + self.show_lin_p(l), k))
                    case _:
                        return V.Opaque
            case ExprKind.Binary(op, l, r):
                return self.binary(e, op, l, r)
            case ExprKind.Compare(first, rest):
                var prev = self.eval(first)
                var pt = first.ty
                var fs: [F] = []
                var forks: [(Fork, F)] = []
                for op, x in rest:
                    if len(fs) > 0:
                        # `x` runs only while the comparisons so far hold
                        let g = fs[len(fs) - 1]
                        match self.fork():
                            case Some(fk):
                                forks.push((fk, g))
                                self.assume(g)
                            case None:
                                pass
                    let v = self.eval(x)
                    var f = F.True
                    var done = false
                    match (prev, v):
                        case (V.Int(a), V.Int(b)):
                            match op:
                                case CmpOp.Eq:
                                    f = F.equal(a, b)
                                case CmpOp.Ne:
                                    f = F.equal(a, b).not_()
                                case CmpOp.Lt:
                                    f = F.lt(a, b)
                                case CmpOp.Le:
                                    f = F.le(a, b)
                                case CmpOp.Gt:
                                    f = F.lt(b, a)
                                case CmpOp.Ge:
                                    f = F.le(b, a)
                            done = true
                        case (V.Bool(a), V.Bool(b)):
                            if pt == Ty.Bool and (op == CmpOp.Eq or op == CmpOp.Ne):
                                let eq = bool_eq(a, b)
                                f = eq if op == CmpOp.Eq else eq.not_()
                                done = true
                        case (V.Flt(_, _, _, _), V.Flt(_, _, _, _)):
                            f = self.float_cmp(op, prev, v, self.name_of(e))
                            done = true
                        case _:
                            pass
                    if not done:
                        f = self.fresh_bool(self.name_of(e))
                    fs.push(f)
                    prev = v
                    pt = x.ty
                # the paths that stopped early, innermost first
                var j = len(forks)
                while j > 0:
                    j -= 1
                    let (fk, g) = forks[j]
                    let s1 = self.take()
                    var other = fk.base
                    let ng = g.not_()
                    if ng != F.True:
                        other.facts.push(ng)
                    let joined = self.join(fk, s1, g, Some(other), ng)
                    self.put(joined)
                return V.Bool(F.and_(fs))
            case ExprKind.IfElse(cond, then, els):
                let c = self.cond(cond)
                let nc = c.not_()
                match self.fork():
                    case Some(fk):
                        self.assume(c)
                        let a = self.eval(then)
                        let s1 = self.take()
                        var other = fk.base
                        if nc != F.True:
                            other.facts.push(nc)
                        self.put(Some(other))
                        let b = self.eval(els)
                        let s2 = self.take()
                        let joined = self.join(fk, s1, c, s2, nc)
                        self.put(joined)
                        return self.ite(c, a, b, e.ty, self.name_of(e))
                    case None:
                        let s1 = self.begin_assume(c)
                        let a = self.eval(then)
                        self.end_assume(s1)
                        let s2 = self.begin_assume(nc)
                        let b = self.eval(els)
                        self.end_assume(s2)
                        return self.ite(c, a, b, e.ty, self.name_of(e))
            case ExprKind.Call(_, args):
                match e.cres:
                    case CallRes.Fn(id):
                        return self.call_user(id, None, args, e)
                    case CallRes.Method(id):
                        return self.call_user(id, None, args, e)
                    case CallRes.Ctor(sid):
                        return self.ctor(sid, args, e)
                    case CallRes.Builtin(b):
                        return self.builtin(b, None, args, e)
                    case CallRes.Reduce(r):
                        return self.reduce(r, args[0].expr, e)
                    case CallRes.Convert(t):
                        return self.convert(t, args[0].expr, e)
                    case _:
                        for a in args:
                            self.eval(a.expr)
                        self.ref_args(args)
                        return self.fresh_val(e.ty, self.name_of(e))
            case ExprKind.MethodCall(recv, _, _, args):
                match e.cres:
                    case CallRes.Ctor(sid):
                        return self.ctor(sid, args, e)
                    case CallRes.Fn(id):
                        return self.call_user(id, None, args, e)
                    case CallRes.Method(id):
                        return self.call_user(id, Some(recv), args, e)
                    case CallRes.Builtin(b):
                        return self.builtin(b, Some(recv), args, e)
                    case CallRes.World(op):
                        var vals: [V] = []
                        for a in args:
                            vals.push(self.eval(a.expr))
                        let n0 = self.nobl
                        let size = Lin.atom(self.term(Term.Size, pos_range()))
                        var arr = false
                        var elem = Ty.Unknown
                        if len(args) > 0:
                            match args[0].expr.ty:
                                case Ty.Array(t):
                                    arr = true
                                    elem = t
                                case t:
                                    elem = t
                        # `world.broadcast(root, x)`
                        if op == WorldOp.Broadcast and len(vals) > 1:
                            let root = self.as_int(vals[0], args[0].expr.ty)
                            self.kept(e.span, F.and_([F.ge(root), F.lt(root, size)]), "rank check")
                        if op == WorldOp.Exchange and len(vals) > 0:
                            match vals[0]:
                                case V.Arr(_, l):
                                    self.kept(e.span, F.equal(l, size), "length check")
                                case _:
                                    pass
                        self.table_checks(e.span, world_stops(op, elem, arr), n0)
                        match op:
                            case WorldOp.Rank:
                                return V.Int(Lin.atom(self.term(Term.Rank, nonneg_range())))
                            case WorldOp.Size:
                                return V.Int(Lin.atom(self.term(Term.Size, pos_range())))
                            # one element per rank
                            case WorldOp.GatherAll | WorldOp.Exchange:
                                let nm = self.name_of(e)
                                let c = self.fresh_content(nm)
                                return V.Arr(c, Lin.atom(self.term(Term.Size, pos_range())))
                            case _:
                                let nm = self.name_of(e)
                                return self.fresh_val(e.ty, nm)
                    # opaque: `os` itself is the receiver, only the arguments are evaluated
                    case CallRes.Os(op):
                        let n0 = self.nobl
                        for a in args:
                            self.eval(a.expr)
                        self.table_checks(e.span, os_stops(op), n0)
                        let nm = self.name_of(e)
                        return self.fresh_val(e.ty, nm)
                    case _:
                        self.eval(recv)
                        for a in args:
                            self.eval(a.expr)
                        self.ref_args(args)
                        return self.fresh_val(e.ty, self.name_of(e))
            case ExprKind.Field(b, _, _):
                match e.res:
                    case Res.Const(id):
                        return self.const_val(id)
                    case Res.Variant(_, _):
                        return V.Opaque
                    case _:
                        pass
                # a field of `self` is not a use of `self` whole
                var bv = V.Opaque
                if self.own_self >= 0 and local_of(b) == Some(self.own_self):
                    bv = self.lookup(self.own_self, b.ty)
                else:
                    bv = self.eval(b)
                match bv:
                    case V.Agg(vs):
                        if e.idx < len(vs):
                            return vs[e.idx]
                    case _:
                        pass
                return self.fresh_val(e.ty, self.name_of(e))
            case ExprKind.Index(b, idx):
                let bv = self.eval(b)
                let iv = self.eval(idx)
                let i = self.as_int(iv, idx.ty)
                match bv:
                    case V.Arr(c, l):
                        if not self.spec:
                            let g = F.and_([F.ge(i), F.lt(i, l)])
                            self.implicit(e.span, TAG_INDEX, g, "index bounds check")
                        return self.sel(c, i, e.ty)
                    case V.Str(l):
                        if not self.spec:
                            let g = F.and_([F.ge(i), F.lt(i, l)])
                            self.implicit(e.span, TAG_INDEX, g, "index bounds check")
                        return V.Str(Lin.konst(1))
                    case _:
                        self.map_key_check(b, e.span)
                        return self.fresh_val(e.ty, self.name_of(e))
            case ExprKind.Slice(b, lo, hi):
                return self.slice(e, b, lo, hi)
            case ExprKind.Map(kvs):
                for k, v in kvs:
                    self.eval(k)
                    self.eval(v)
                return V.Opaque
            case ExprKind.Contains(item, coll, _):
                self.eval(item)
                self.eval(coll)
                return V.Bool(self.fresh_bool("in"))
            case ExprKind.Array(es):
                var vals: [V] = []
                for x in es:
                    vals.push(self.eval(x))
                let c = self.ranged_content("[...]", vals)
                let et = e.ty.elem()
                for i, v in enumerate(vals):
                    self.define_sel(c, Lin.konst(i128(i)), et, v)
                return V.Arr(c, Lin.konst(i128(len(es))))
            case ExprKind.Repeat(elem, count):
                let ev = self.eval(elem)
                let nv = self.eval(count)
                let n = self.as_int(nv, count.ty)
                self.kept(e.span, F.ge(n), "array length check")
                self.cap_len(n)
                return V.Arr(self.ranged_content("[...]", [ev]), n)
            case ExprKind.Tuple(es):
                return self.agg(es)
            case ExprKind.ParTuple(es):
                return self.agg(es)
            case ExprKind.Comp(c):
                let l = self.comp(c, e.local)
                return V.Arr(self.fresh_content("[...]"), l)
            case _:
                return V.Opaque

    fn agg(ref self, es: [Expr]) -> V:
        var vals: [V] = []
        for x in es:
            vals.push(self.eval(x))
        return V.Agg(vals)

    fn binary(ref self, e: Expr, op: BinOp, l: Expr, r: Expr) -> V:
        if op == BinOp.And or op == BinOp.Or:
            let a = self.cond(l)
            let and_ = op == BinOp.And
            let guard = a if and_ else a.not_()
            let bv = self.eval_when(guard, r)
            let b = self.as_bool(bv)
            return V.Bool(F.and_([a, b]) if and_ else F.or_([a, b]))
        let av = self.eval(l)
        let bv = self.eval(r)
        match e.ty:
            case Ty.Int(k):
                let a = self.as_int(av, l.ty)
                let b = self.as_int(bv, r.ty)
                if (op == BinOp.Div or op == BinOp.Mod) and e.checked:
                    let what = "division check" if op == BinOp.Div else "remainder check"
                    self.implicit(e.span, TAG_ARITH, div_goal(op, a, b, k), what)
                if (op == BinOp.Shl or op == BinOp.Shr) and e.checked:
                    self.implicit(e.span, TAG_ARITH, shift_goal(b, k), "shift check")
                let v = self.arith_val(op, a, b, k)
                match v:
                    case V.Int(res):
                        let f = in_range(res, k)
                        if (op == BinOp.Add or op == BinOp.Sub or op == BinOp.Mul) and e.checked:
                            self.implicit(e.span, TAG_ARITH, f, "overflow check")
                        elif not self.spec:
                            self.assume(f)
                    case _:
                        pass
                return v
            case Ty.Str:
                match (av, bv):
                    case (V.Str(x), V.Str(y)):
                        let n = self.lin(x.add(y), "len(" + self.name_of(e) + ")")
                        self.cap_len(n)
                        return V.Str(n)
                    # `s * n`: the length is a product
                    case (V.Str(x), V.Int(c)):
                        self.kept(e.span, F.ge(c), "repeat count check")
                        return V.Str(self.repeat_len(x, c, self.name_of(e)))
                    case _:
                        return V.Str(self.fresh_len("len(" + self.name_of(e) + ")"))
            # `xs + ys`: new contents, the two lengths added
            case Ty.Array(_):
                match (av, bv):
                    case (V.Arr(_, x), V.Arr(_, y)):
                        let nm = self.name_of(e)
                        let n = self.lin(x.add(y), "len(" + nm + ")")
                        self.cap_len(n)
                        return V.Arr(self.fresh_content(nm), n)
                    case _:
                        return self.fresh_val(e.ty, self.name_of(e))
            case _:
                return V.Opaque

    # The length of `n` copies of something `x` long (none when `n` < 0).
    fn repeat_len(ref self, x: Lin, n: Lin, name: str) -> Lin:
        let r = self.fresh_len("len(" + name + ")")
        match n.is_const():
            case Some(c):
                if c <= 0:
                    self.assume(F.equal(r, Lin.konst(0)))
                    return r
                match x.scale(c):
                    case Some(p):
                        self.assume(F.equal(r, p))
                    case None:
                        pass
            case None:
                pass
        return r

    fn slice(ref self, e: Expr, b: Expr, lo0: Option[Expr], hi0: Option[Expr]) -> V:
        let bv = self.eval(b)
        var lo = Lin.konst(0)
        match lo0:
            case Some(x):
                let v = self.eval(x)
                lo = self.as_int(v, int_ty())
            case None:
                pass
        var hi: Option[Lin] = None
        match hi0:
            case Some(x):
                let v = self.eval(x)
                hi = Some(self.as_int(v, int_ty()))
            case None:
                pass
        var l = Lin.konst(0)
        var is_str = false
        match bv:
            case V.Arr(_, x):
                l = x
            case V.Str(x):
                l = x
                is_str = true
            case _:
                return self.fresh_val(e.ty, "slice")
        let h = hi.unwrap_or(l)
        if not self.spec:
            # the runtime function checks the bounds whether or not they're proven
            let g = F.and_([F.ge(lo), F.le(lo, h), F.le(h, l)])
            self.kept(e.span, g, "slice bounds check")
        # and that a string's ends are character boundaries, which the prover
        # knows only of its first and last byte
        if is_str and not self.spec and self.live:
            self.nobl += 1
            let edges = F.and_([F.or_([F.eq(lo), F.equal(lo, l)]), F.or_([F.eq(h), F.equal(h, l)])])
            if self.holds(edges):
                self.kept_proven.push((e.span, Check.CharBoundary.what()))
            else:
                self.remain_c(e.span, Check.CharBoundary)
        let n = self.lin(h.sub(lo), "len(slice)")
        if is_str:
            return V.Str(n)
        return V.Arr(self.fresh_content("slice"), n)

    fn const_val(ref self, id: int) -> V:
        let c = self.info.consts[id]
        match c.value:
            case ConstVal.Int(v):
                match c.ty:
                    case Ty.Int(_):
                        return V.Int(Lin.konst(v))
                    case _:
                        return V.Opaque
            case ConstVal.UInt(_):
                return V.Int(self.fresh_int(c.name, IntTy.U128))
            case ConstVal.Bool(b):
                return V.Bool(F.from_bool(b))
            case ConstVal.Str(s):
                return V.Str(Lin.konst(i128(len(s))))
            case ConstVal.Float(x):
                if c.ty == Ty.Float(FloatTy.F64):
                    return float_const(x)
                return self.fresh_val(c.ty, c.name)

    # `a if c else b`, called `name` in messages
    fn ite(ref self, c: F, a: V, b: V, ty: Ty, name: str) -> V:
        if a == b:
            return a
        match (a, b):
            case (V.Bool(x), V.Bool(y)):
                return V.Bool(F.or_([F.and_([c, x]), F.and_([c.not_(), y])]))
            case (V.Agg(xs), V.Agg(ys)):
                if len(xs) == len(ys):
                    var tys: [Ty] = [Ty.Unknown] * len(xs)
                    var names: [str] = [f"{name}.{i}" for i in 0..len(xs)]
                    match ty:
                        case Ty.Tuple(ts):
                            tys = ts
                        case Ty.Struct(sid):
                            tys = [f.1 for f in self.info.structs[sid].fields]
                            names = [name + "." + f.0 for f in self.info.structs[sid].fields]
                        case _:
                            pass
                    var out: [V] = []
                    for i in 0..min(len(xs), len(tys)):
                        out.push(self.ite(c, xs[i], ys[i], tys[i], names[i]))
                    return V.Agg(out)
            case _:
                pass
        let r = self.fresh_val(ty, name)
        self.range_hull(r, a, b)
        match (val_eq(r, a), val_eq(r, b)):
            case (Some(fa), Some(fb)):
                self.defs.push(F.or_([F.and_([c, fa]), F.and_([c.not_(), fb])]))
            case _:
                pass
        # the range of both, which products and bit operations use
        match (r, a, b):
            case (V.Int(n), V.Int(x), V.Int(y)):
                let bx = self.bounds(x)
                let by = self.bounds(y)
                var lo: Option[i128] = None
                var hi: Option[i128] = None
                if bx.0.is_some() and by.0.is_some():
                    lo = Some(min(bx.0.unwrap(), by.0.unwrap()))
                if bx.1.is_some() and by.1.is_some():
                    hi = Some(max(bx.1.unwrap(), by.1.unwrap()))
                self.assume_bounds(n, (lo, hi))
            case (V.Arr(rc, _), V.Arr(xc, _), V.Arr(yc, _)):
                match (self.content_ranges[xc], self.content_ranges[yc]):
                    case (Some(p), Some(q)):
                        self.content_ranges[rc] = Some((min(p.0, q.0), max(p.1, q.1)))
                    case _:
                        pass
            case _:
                pass
        var hull: [F] = []
        hull_facts(r, a, b, ref hull)
        for f in hull:
            self.assume(f)
        return r

    # `a op b` for floats: a truth value of its own, which says what it can
    # about `int` of both when it's true and when it's false (rounding toward
    # zero keeps the order).
    fn float_cmp(ref self, op: CmpOp, a: V, b: V, name: str) -> F:
        match (a, b):
            case (V.Flt(x, na, xb, xa), V.Flt(y, nb, yb, ya)):
                let r = self.fresh_bool(name)
                # a NaN makes every comparison false but `!=`
                let ok = F.and_([na.not_(), nb.not_()])
                # `a < b`, `b < a`
                let lt = F.and_([F.le(x, yb), F.le(xa, y)])
                let gt = F.and_([F.le(y, xb), F.le(ya, x)])
                var yes = F.True
                var no = F.True
                match op:
                    case CmpOp.Ge:
                        yes = F.le(y, x)
                        no = lt
                    case CmpOp.Gt:
                        yes = gt
                        no = F.le(x, y)
                    case CmpOp.Lt:
                        yes = lt
                        no = F.le(y, x)
                    case CmpOp.Le:
                        yes = F.le(x, y)
                        no = gt
                    case CmpOp.Eq:
                        yes = F.equal(x, y)
                    case CmpOp.Ne:
                        pass
                if op == CmpOp.Ne:
                    # not `!=`: equal, and neither is NaN
                    self.defs.push(F.or_([r, F.and_([ok, F.equal(x, y)])]))
                    return r
                self.defs.push(F.or_([r.not_(), F.and_([ok, yes])]))
                self.defs.push(F.or_([r, ok.not_(), no]))
                return r
            case _:
                return self.fresh_bool(name)

    # Analyze a comprehension's body; returns the length of the produced sequence.
    fn comp(ref self, c: Comp, local: int) -> Lin:
        let vname = self.shown_local(local)
        let vty = self.local_ty(local)
        var ik = IntTy.I64
        match vty:
            case Ty.Int(x):
                ik = x
            case _:
                pass
        var extra: [F] = []
        var v = V.Opaque
        var count: Option[Lin] = None
        var done = false
        match c.iter.kind:
            case ExprKind.Range(lo, hi, inclusive):
                let av = self.eval(lo)
                let a = self.as_int(av, lo.ty)
                let bv = self.eval(hi)
                let b = self.as_int(bv, hi.ty)
                let i = self.fresh_int(vname, ik)
                extra.push(F.le(a, i))
                extra.push(F.le(i, b) if inclusive else F.lt(i, b))
                let n = self.fresh_nonneg("count")
                var span: Option[Lin] = None
                if inclusive:
                    match b.add_c(1):
                        case Some(b1):
                            span = b1.sub(a)
                        case None:
                            pass
                else:
                    span = b.sub(a)
                match span:
                    case Some(sp):
                        let ne = F.le(a, b) if inclusive else F.lt(a, b)
                        self.defs.push(
                            F.or_([F.and_([ne, F.equal(n, sp)]), F.and_([ne.not_(), F.eq(n)])])
                        )
                        # its elements are counted, in an int
                        self.kept(
                            c.iter.span,
                            F.or_([ne.not_(), F.le(sp, Lin.konst(I64_BOUND))]),
                            "range size check"
                        )
                    case None:
                        pass
                v = V.Int(i)
                count = Some(n)
                done = true
            case ExprKind.Call(_, args):
                if c.iter.cres == CallRes.Range:
                    var vals: [Lin] = []
                    for a in args:
                        let x = self.eval(a.expr)
                        vals.push(self.as_int(x, a.expr.ty))
                    let i = self.fresh_int(vname, ik)
                    self.range_checks(c.iter.span, vals, true)
                    if len(vals) <= 2:
                        var lo = Lin.konst(0)
                        var hi = vals[0]
                        if len(vals) == 2:
                            lo = vals[0]
                            hi = vals[1]
                        extra.push(F.le(lo, i))
                        extra.push(F.lt(i, hi))
                    v = V.Int(i)
                    done = true
            case _:
                pass
        if not done:
            match self.eval(c.iter):
                case V.Arr(content, l):
                    let kx = self.fresh_nonneg("index of " + vname)
                    extra.push(F.lt(kx, l))
                    let et = c.iter.ty.elem()
                    v = self.sel(content, kx, et)
                    count = Some(l)
                case _:
                    v = self.fresh_val(vty, vname)
        # the body and filter run once per element, like a loop body: what
        # they change is unknown in each run and after the last
        var effs: [Eff] = []
        effs_expr(c.body, self.info, ref effs)
        match c.filter:
            case Some(fl):
                effs_expr(fl, self.info, ref effs)
            case None:
                pass
        self.havoc_effs(effs)
        let head = self.cur()
        let s = self.begin_assume(F.and_(extra))
        self.bind(local, v)
        match c.filter:
            case Some(fl):
                let fc = self.cond(fl)
                let s2 = self.begin_assume(fc)
                self.eval(c.body)
                self.end_assume(s2)
            case None:
                self.eval(c.body)
        self.end_assume(s)
        if len(effs) > 0 and head.is_some():
            self.put(head)
        match count:
            case Some(n):
                if c.filter.is_none():
                    return n
                let m = self.fresh_nonneg("count")
                self.defs.push(F.le(m, n))
                return m
            case None:
                return self.fresh_nonneg("count")

    fn reduce(ref self, r: Reducer, arg: Expr, e: Expr) -> V:
        let n0 = self.nobl
        var count: Option[Lin] = None
        match arg.kind:
            case ExprKind.Comp(c):
                count = Some(self.comp(c, arg.local))
            case _:
                match self.eval(arg):
                    case V.Arr(_, l):
                        count = Some(l)
                    case _:
                        pass
        if r == Reducer.Min or r == Reducer.Max:
            match count:
                case Some(n):
                    self.kept(e.span, F.ge(n.add_c(-1).unwrap_or(n)), "empty sequence check")
                case None:
                    pass
        self.table_checks(e.span, reduce_stops(r, e.ty), n0)
        let nm = self.name_of(e)
        match r:
            case Reducer.Any | Reducer.All:
                return V.Bool(self.fresh_bool(nm))
            case _:
                return self.fresh_val(e.ty, nm)

    fn convert(ref self, target: Ty, a: Expr, whole: Expr) -> V:
        let v = self.eval(a)
        let n0 = self.nobl
        let r = self.convert_val(target, a, whole, v)
        self.table_checks(whole.span, convert_stops(target, a.ty), n0)
        return r

    fn convert_val(ref self, target: Ty, a: Expr, whole: Expr, v: V) -> V:
        match (target, a.ty, v):
            case (Ty.Int(k), Ty.Int(src), V.Int(l)):
                # a narrowing conversion is checked
                let widens = k.signed() == src.signed() and k.bits() >= src.bits()
                if widens or (k.signed() and not src.signed() and k.bits() > src.bits()):
                    return V.Int(l)
                self.implicit(whole.span, TAG_CONV, in_range(l, k), "conversion check")
                return V.Int(l)
            case (Ty.Int(k), Ty.Float(_), V.Flt(t, nan, _, _)):
                # in range and not NaN: checked (past 64 bits, always at
                # runtime: the table says so)
                if k.bits() > 64:
                    return self.fresh_val(target, self.name_of(whole))
                let fits = F.and_([nan.not_(), in_range(t, k)])
                self.kept_h(whole.span, fits, "conversion check", true, Check.FloatToInt.help())
                return V.Int(t)
            # exact up to 2^53
            case (Ty.Float(FloatTy.F64), Ty.Int(_), V.Int(l)):
                let b = self.bounds(l)
                let m: i128 = 9007199254740992
                if b.0.is_some() and b.1.is_some() and -m <= b.0.unwrap() and b.1.unwrap() <= m:
                    # an integer: `y < float(n)` for n >= 1 means int(y) <= n - 1
                    let below = l.add_c(-1).unwrap_or(l) if b.0.unwrap() >= 1 else l
                    let above = l.add_c(1).unwrap_or(l) if b.1.unwrap() <= -1 else l
                    return V.Flt(l, F.False, below, above)
                return self.fresh_val(target, self.name_of(whole))
            case (Ty.Int(_), Ty.Float(_), _):
                return self.fresh_val(target, self.name_of(whole))
            case (Ty.Int(_), Ty.Bool, V.Bool(b)):
                let r = self.fresh_int("int(bool)", IntTy.I64)
                self.defs.push(
                    F.or_([F.and_([b, F.equal(r, Lin.konst(1))]), F.and_([b.not_(), F.eq(r)])])
                )
                return V.Int(r)
            case (Ty.Str, Ty.Str, _):
                return v
            case _:
                let nm = self.name_of(whole)
                return self.fresh_val(target, nm)

    fn builtin(ref self, b: Builtin, recv: Option[Expr], args: [Arg], e: Expr) -> V:
        let n0 = self.nobl
        let v = self.builtin_val(b, recv, args, e)
        var rt = Ty.Unknown
        match recv:
            case Some(r):
                rt = r.ty
            case None:
                if len(args) > 0:
                    rt = args[0].expr.ty
        self.table_checks(e.span, builtin_stops(b, rt, len(args)), n0)
        return v

    fn builtin_val(ref self, b: Builtin, recv: Option[Expr], args: [Arg], e: Expr) -> V:
        if b == Builtin.Push or b == Builtin.Pop:
            if recv.is_none():
                return V.Opaque
            let r = recv.unwrap()
            if b == Builtin.Push:
                self.eval(args[0].expr)
            match self.lvalue_path(r, false):
                case None:
                    self.eval(r)
                    return self.fresh_val(e.ty, self.name_of(e))
                case Some((root, steps)):
                    let cur = self.read_path(root, steps)
                    match cur:
                        case V.Arr(c, l):
                            let name = self.content_names[c]
                            var nlen = l
                            var out = V.Opaque
                            if b == Builtin.Push:
                                nlen = self.lin(l.add_c(1), "len(" + name + ")")
                                self.cap_len(nlen)
                            else:
                                self.kept(
                                    e.span,
                                    F.ge(l.add_c(-1).unwrap_or(l)),
                                    "empty array check"
                                )
                                nlen = self.lin(l.add_c(-1), "len(" + name + ")")
                                out = self.sel(c, nlen, e.ty)
                            let nv = V.Arr(self.fresh_content(name), nlen)
                            let old = self.lookup(root, self.local_ty(root))
                            let w = self.write_path(old, steps, nv)
                            self.bind(root, w)
                            return out
                        case _:
                            let nv = self.fresh_val(self.local_ty(root), self.local_name(root))
                            self.bind(root, nv)
                            return self.fresh_val(e.ty, self.name_of(e))
        if b.mutates_recv() and recv.is_some():
            return self.mutate(b, recv.unwrap(), args, e)
        var rv = V.Opaque
        match recv:
            case Some(r):
                rv = self.eval(r)
            case None:
                pass
        var vals: [V] = []
        for a in args:
            vals.push(self.eval(a.expr))
        self.ref_args(args)
        match b:
            # `xs.index(x, start)`, `s.find(t, start)`: 0 <= start <= len
            case Builtin.IndexFrom | Builtin.Str(StrM.FindFrom):
                var l: Option[Lin] = None
                match rv:
                    case V.Arr(_, x):
                        l = Some(x)
                    case V.Str(x):
                        l = Some(x)
                    case _:
                        pass
                if len(vals) > 1 and l.is_some():
                    let k = self.as_int(vals[1], args[1].expr.ty)
                    self.kept(e.span, F.and_([F.ge(k), F.le(k, l.unwrap())]), "start check")
                return self.fresh_val(e.ty, self.name_of(e))
            # an empty pattern is an error
            case Builtin.Str(StrM.Split) | Builtin.Str(StrM.Replace) | Builtin.Str(StrM.Count):
                if len(vals) > 0:
                    match vals[0]:
                        case V.Str(pl):
                            self.kept(
                                e.span,
                                F.ge(pl.add_c(-1).unwrap_or(pl)),
                                "empty pattern check"
                            )
                        case _:
                            pass
                return self.fresh_val(e.ty, self.name_of(e))
            # one byte per byte
            case Builtin.Str(StrM.Bytes):
                match rv:
                    case V.Str(l):
                        return V.Arr(self.fresh_content(self.name_of(e)), l)
                    case _:
                        return self.fresh_val(e.ty, self.name_of(e))
            # one to four bytes per character, each a character
            case Builtin.Str(StrM.Chars):
                match rv:
                    case V.Str(l):
                        let nm = self.name_of(e)
                        let c = self.fresh_content(nm)
                        self.chars[c] = true
                        let n = self.fresh_len("len(" + nm + ")")
                        self.assume(F.le(n, l))
                        match n.scale(4):
                            case Some(n4):
                                self.assume(F.le(l, n4))
                            case None:
                                pass
                        return V.Arr(c, n)
                    case _:
                        return self.fresh_val(e.ty, self.name_of(e))
            # true: at least as long as the prefix
            case Builtin.Str(StrM.StartsWith) | Builtin.Str(StrM.EndsWith):
                let r = self.fresh_bool(self.name_of(e))
                if len(vals) == 1:
                    match (rv, vals[0]):
                        case (V.Str(l), V.Str(p)):
                            self.defs.push(F.or_([r.not_(), F.le(p, l)]))
                        case _:
                            pass
                return V.Bool(r)
            case Builtin.Len:
                if len(vals) > 0:
                    match vals[0]:
                        case V.Arr(_, l):
                            return V.Int(l)
                        case V.Str(l):
                            return V.Int(l)
                        case _:
                            pass
                return V.Int(self.fresh_len(self.name_of(e)))
            case Builtin.Abs:
                match e.ty:
                    case Ty.Int(k):
                        let a = self.as_int(vals[0], e.ty)
                        let nm = "abs(" + self.show_lin(a) + ")"
                        let r = Lin.atom(self.new_atom(nm, None))
                        match a.neg():
                            case Some(na):
                                self.defs.push(
                                    F.or_(
                                        [
                                            F.and_([F.ge(a), F.equal(r, a)]),
                                            F.and_([F.lt(a, Lin.konst(0)), F.equal(r, na)])
                                        ]
                                    )
                                )
                            case None:
                                pass
                        if k.signed():
                            self.kept(e.span, in_range(r, k), "overflow check")
                        elif not self.spec:
                            self.assume(in_range(r, k))
                        return V.Int(r)
                    case _:
                        return self.fresh_val(e.ty, self.name_of(e))
            case Builtin.Min | Builtin.Max:
                match e.ty:
                    case Ty.Int(_):
                        let a = self.as_int(vals[0], e.ty)
                        let c = self.as_int(vals[1], e.ty)
                        let fname = "min" if b == Builtin.Min else "max"
                        let nm = fname + "(" + self.show_lin(a) + ", " + self.show_lin(c) + ")"
                        # between the smaller and the larger argument
                        let (ra, rc) = (self.range_of(a), self.range_of(c))
                        var range: Option[(i128, i128)] = None
                        match (ra.0, ra.1, rc.0, rc.1):
                            case (Some(al), Some(ah), Some(cl), Some(ch)):
                                if b == Builtin.Min:
                                    range = Some((min(al, cl), min(ah, ch)))
                                else:
                                    range = Some((max(al, cl), max(ah, ch)))
                            case _:
                                pass
                        let r = Lin.atom(self.new_atom(nm, range))
                        let a_first = F.le(a, c) if b == Builtin.Min else F.le(c, a)
                        self.defs.push(
                            F.or_(
                                [
                                    F.and_([a_first, F.equal(r, a)]),
                                    F.and_([a_first.not_(), F.equal(r, c)])
                                ]
                            )
                        )
                        return V.Int(r)
                    case _:
                        return self.fresh_val(e.ty, self.name_of(e))
            # the file contents, already in place of the path
            case Builtin.Embed:
                return vals[0] if len(vals) > 0 else V.Opaque
            case Builtin.Args:
                let c = self.fresh_content("args()")
                return V.Arr(c, self.fresh_len("len(args())"))
            case Builtin.Chr:
                if len(vals) > 0:
                    let n = self.as_int(vals[0], args[0].expr.ty)
                    let lo: i128 = 55295
                    let hi: i128 = 57344
                    let top: i128 = 1114111
                    let ok = F.or_(
                        [
                            F.and_([F.ge(n), F.le(n, Lin.konst(lo))]),
                            F.and_([F.le(Lin.konst(hi), n), F.le(n, Lin.konst(top))])
                        ]
                    )
                    self.kept(e.span, ok, "character check")
                return self.fresh_val(e.ty, self.name_of(e))
            case Builtin.Str(StrM.Repeat):
                if len(vals) > 0:
                    let n = self.as_int(vals[0], args[0].expr.ty)
                    self.kept(e.span, F.ge(n), "repeat count check")
                return self.fresh_val(e.ty, self.name_of(e))
            # a code point
            case Builtin.Ord:
                if len(vals) > 0:
                    match vals[0]:
                        case V.Str(l):
                            # one byte surely is one character; passing only says
                            # it was one UTF-8 character of 1 to 4 bytes
                            let one = F.equal(l, Lin.konst(1))
                            # enough, not necessary ("é" passes): never refuted
                            if not self.spec and self.live:
                                self.nobl += 1
                                if lin_key(l) in self.one_char or self.holds(one):
                                    self.kept_proven.push((e.span, "character check"))
                                else:
                                    self.remain(e.span, "character check", Some(one))
                            self.assume(
                                F.and_([F.ge(l.add_c(-1).unwrap_or(l)), F.le(l, Lin.konst(4))])
                            )
                        case _:
                            pass
                let r = self.fresh_nonneg("ord(...)")
                let top: i128 = 1114111
                self.assume(F.le(r, Lin.konst(top)))
                return V.Int(r)
            # a count of bits: between 0 and the receiver's width
            case Builtin.Num(
                NumM.CountOnes
            ) | Builtin.Num(NumM.LeadingZeros) | Builtin.Num(NumM.TrailingZeros):
                var w: i128 = 128
                match recv:
                    case Some(r):
                        match r.ty:
                            case Ty.Int(k):
                                w = i128(k.bits())
                            case _:
                                pass
                    case None:
                        pass
                let z: i128 = 0
                return V.Int(Lin.atom(self.new_atom(self.name_of(e), Some((z, w)))))
            case _:
                return self.fresh_val(e.ty, self.name_of(e))

    # A method that changes its receiver in place (`clear`, `sort`, `pop(i)`, ...).
    fn mutate(ref self, b: Builtin, r: Expr, args: [Arg], e: Expr) -> V:
        var vals: [V] = []
        for a in args:
            vals.push(self.eval(a.expr))
        self.ref_args(args)
        var out = self.fresh_val(e.ty, self.name_of(e))
        match self.lvalue_path(r, false):
            case None:
                # a temporary: nothing else sees the change
                self.eval(r)
                return out
            case Some((root, steps)):
                let cur = self.read_path(root, steps)
                var nv = V.Opaque
                match cur:
                    case V.Arr(c, l):
                        let name = self.content_names[c]
                        var nlen: Option[Lin] = Some(l)
                        match b:
                            case Builtin.Clear:
                                nlen = Some(Lin.konst(0))
                            case Builtin.PopAt:
                                let i = self.as_int(vals[0], args[0].expr.ty)
                                self.kept(
                                    e.span,
                                    F.and_([F.ge(i), F.lt(i, l)]),
                                    "index bounds check"
                                )
                                out = self.sel(c, i, e.ty)
                                nlen = l.add_c(-1)
                            case Builtin.Insert:
                                let i = self.as_int(vals[0], args[0].expr.ty)
                                self.kept(
                                    e.span,
                                    F.and_([F.ge(i), F.le(i, l)]),
                                    "insert index check"
                                )
                                nlen = l.add_c(1)
                            case Builtin.Extend:
                                match vals[0]:
                                    case V.Arr(_, m):
                                        nlen = l.add(m)
                                    case _:
                                        nlen = None
                            case _:
                                # sort, reverse: same length, other order
                                pass
                        var n = Lin.konst(0)
                        match nlen:
                            case Some(x):
                                n = x
                            case None:
                                n = self.fresh_len("len(" + name + ")")
                        self.cap_len(n)
                        nv = V.Arr(self.fresh_content(name), n)
                    case _:
                        nv = self.fresh_val(r.ty, self.name_of(r))
                let old = self.lookup(root, self.local_ty(root))
                let w = self.write_path(old, steps, nv)
                self.bind(root, w)
                return out

    # `ref` arguments of a call the prover doesn't follow may change arbitrarily.
    fn ref_args(ref self, args: [Arg]):
        for a in args:
            if a.by_ref:
                match lvalue_root(a.expr):
                    case Some(root):
                        let nv = self.fresh_val(self.local_ty(root), self.local_name(root))
                        self.bind(root, nv)
                    case None:
                        pass

    # `m[k]` on a map panics when the key is missing (the prover doesn't
    # follow maps' keys).
    fn map_key_check(ref self, m: Expr, span: Span):
        match m.ty:
            case Ty.Map(_, _):
                self.remain_c(span, Check.MapKey)
            case _:
                pass

    # A runtime check that stays whether or not it's proven: listed in
    # `--report` unless proven; either way it holds afterwards.
    fn kept(ref self, span: Span, goal: F, what: str):
        self.kept_x(span, goal, what, true)

    # `exact`: the goal is just what the check tests (not merely enough for
    # it), so failing it everywhere means the check always fails.
    fn kept_x(ref self, span: Span, goal: F, what: str, exact: bool):
        self.kept_h(span, goal, what, exact, "")

    # `help`: as for `remain_h`.
    fn kept_h(ref self, span: Span, goal: F, what: str, exact: bool, help: str):
        if self.spec or not self.live:
            return
        self.nobl += 1
        if self.holds(goal):
            self.kept_proven.push((span, what))
        else:
            if exact and self.refuted(span, what, goal):
                return
            self.remain_h(span, what, Some(goal), help)
        self.assume(goal)

    # The checks the table in checks.br lists for an operation, after the
    # verifier has stated the goals it can (`n0`: `nobl` before it did). A
    # goal it didn't state stays as a runtime check, so an operation that
    # can fail is never taken as one that can't.
    fn table_checks(ref self, span: Span, stops: [Stop], n0: int):
        if self.spec or not self.live:
            return
        for st in stops:
            match st:
                case Stop.Always(c):
                    self.remain_c(span, c)
                case Stop.Goal(c):
                    if self.nobl == n0:
                        self.remain_c(span, c)
                case Stop.Outside(_):
                    pass

    fn call_user(ref self, id: int, recv: Option[Expr], args: [Arg], e: Expr) -> V:
        let sig = self.info.fns[id]
        let ret = sig.ret
        var exprs: [Expr] = []
        match recv:
            case Some(r):
                exprs.push(r)
            case None:
                pass
        for a in args:
            exprs.push(a.expr)
        var vals: [V] = []
        for x in exprs:
            vals.push(self.eval(x))
        # the callee sees a `ref` argument as the later arguments left it
        # (`head(ref xs, empty(ref xs))`): read those places again. An indexed
        # place can't change that way (E0405), and keeps the value it was read as.
        for i, p in enumerate(sig.params):
            if p.by_ref and i < len(exprs):
                let steps = lvalue_steps(exprs[i])
                if CONTENT in steps:
                    continue
                match lvalue_root(exprs[i]):
                    case Some(root):
                        let rty = self.local_ty(root)
                        let cur = self.lookup(root, rty)
                        match self.at_path(cur, steps, rty):
                            case Some(nv):
                                vals[i] = nv
                            case None:
                                vals[i] = self.fresh_val(p.ty, self.local_name(root))
                    case None:
                        pass
        let spec = self.specs[id] if 0 <= id < len(self.specs) else None
        var req_ok = true
        match spec:
            case Some(sp):
                var env: {int: V} = {}
                for i in 0..min(len(sp.params), len(vals)):
                    env[sp.params[i]] = vals[i]
                for r in sp.requires:
                    let f = self.spec_cond_in(env, r)
                    if not self.spec and self.live and not self.holds(f):
                        req_ok = false
                        let d = (
                            diag.error("E0601", f"cannot prove the precondition of `{sp.name}`")
                            .label(
                                e.span,
                                "this call might violate `requires " + self.snippet(r.span) + "`"
                            )
                            .label(r.span, "precondition declared here")
                            .with_help(
                                "check the arguments with an `if` before the call (the prover follows it) and handle the other values, add an `assert` to check it at runtime, or add a `requires` to this function so its callers must prove it"
                            )
                        )
                        self.fail(d, f)
            case None:
                pass
        if 0 <= id < len(self.stops) and self.stops[id]:
            if self.rule != "":
                self.stop_call(
                    e.span,
                    f"`{sig.name}()`",
                    f"`{sig.name}()` stops the program when there's no value: `match` on it and handle every case"
                )
            else:
                # a check like any other (the prover doesn't follow which
                # variant a value is)
                self.remain_c(e.span, Check.Unwrap)
        # a `str` for C is NUL-terminated: one with a NUL byte inside stops the program
        if sig.is_extern and any(p.ty == Ty.Str for p in sig.params):
            self.remain_c(e.span, Check.NulByte)
        # mutable arguments may change what the callee's footprint says,
        # arbitrarily (subject to its `ensures`)
        for i, p in enumerate(sig.params):
            if p.by_ref and i < len(exprs):
                match lvalue_root(exprs[i]):
                    case Some(root):
                        let name = self.local_name(root)
                        let rty = self.local_ty(root)
                        let pre = lvalue_steps(exprs[i])
                        var nr = self.lookup(root, rty)
                        for q in footprint(self.fps, id, i):
                            nr = self.havoc_at(nr, join_path(pre, q), rty, name)
                        self.bind(root, nr)
                        match self.at_path(nr, pre, rty):
                            case Some(nv):
                                vals[i] = nv
                            case None:
                                vals[i] = self.fresh_val(p.ty, name)
                        # the callee keeps the invariant of what it changes
                        match p.ty:
                            case Ty.Struct(sid):
                                self.assume_inv(sid, vals[i])
                            case _:
                                pass
                    case None:
                        pass
        let nm = self.name_of(e)
        var key: Option[str] = None
        if 0 <= id < len(self.pure) and self.pure[id]:
            var k = f"{id}:" + self.info.ty_name(ret)
            for i, x in enumerate(exprs):
                match val_key(vals[i]):
                    case Some(vk):
                        k += "|" + self.info.ty_name(x.ty) + "=" + vk
                    case None:
                        k = ""
                        break
            if k != "":
                key = Some(k)
        var result = V.Opaque
        match key:
            case Some(k):
                match self.memo.get(k):
                    case Some(r):
                        result = self.copy_val(r, nm)
                    case None:
                        result = self.fresh_val(ret, nm)
                        self.memo[k] = result
            case None:
                result = self.fresh_val(ret, nm)
        match spec:
            case Some(sp):
                # after a failed precondition the postcondition may be contradictory;
                # don't let it hide later errors
                if len(sp.ensures) > 0 and req_ok:
                    var env: {int: V} = {}
                    for i in 0..min(len(sp.params), len(vals)):
                        env[sp.params[i]] = vals[i]
                    match sp.result:
                        case Some(r):
                            env[r] = result
                        case None:
                            pass
                    var fs: [F] = []
                    for en in sp.ensures:
                        let f = self.spec_cond_in(env, en)
                        if not self.spec:
                            self.assume(f)
                            fs.push(f)
                    for a in fresh_atoms(result):
                        self.narrow(a, fs)
            case None:
                pass
        return result

# The functions whose result depends only on their arguments: nothing they
# reach has effects (files, the console, the clock, `world`, extern code...),
# and they have no `ref` parameters. There are no globals to change and no
# function values, so the call graph is all there is.
fn pure_fns(prog: Program, info: ProgramInfo) -> [bool]:
    let n = len(info.fns)
    var fns: [FnDecl] = []
    for m in prog.modules:
        # the runtime's memory operations are effects too
        if m.name != RT:
            fns.extend(m.fns)
    let scans = par [scan_pure(fns[i], info) for i in 0..len(fns)]
    # no body seen: not pure
    var bad: [bool] = [true] * n
    var callers: [[int]] = [[]] * n
    for i, f in enumerate(fns):
        if not (0 <= f.id < n):
            continue
        let (ok, calls) = scans[i]
        bad[f.id] = not ok
        for c in calls:
            if 0 <= c < n:
                callers[c].push(f.id)
            else:
                bad[f.id] = true
    # whatever calls one that isn't pure isn't either
    var todo: [int] = []
    for id in 0..n:
        if bad[id]:
            todo.push(id)
    var i = 0
    while i < len(todo):
        let c = todo[i]
        i += 1
        for id in callers[c]:
            if not bad[id]:
                bad[id] = true
                todo.push(id)
    var out: [bool] = [false] * n
    for id in 0..n:
        var by_ref = false
        for q in info.fns[id].params:
            by_ref = by_ref or q.by_ref
        out[id] = not bad[id] and not by_ref
    return out

# Whether `f` itself has no effects, and the functions it calls.
fn scan_pure(f: FnDecl, info: ProgramInfo) -> (bool, [int]):
    var calls: [int] = []
    if f.is_extern:
        return (false, calls)
    var ok = true
    effs_free_block(f.body, ref ok, ref calls)
    return (ok, calls)

fn effs_free_block(b: Block, ref ok: bool, ref calls: [int]):
    for s in b.stmts:
        for e in stmt_exprs(s):
            effs_free_expr(e, ref ok, ref calls)
        for sb in stmt_blocks(s):
            effs_free_block(sb, ref ok, ref calls)

fn effs_free_expr(e: Expr, ref ok: bool, ref calls: [int]):
    match e.cres:
        case CallRes.Builtin(b):
            if builtin_effect(b) != "":
                ok = false
        case CallRes.Os(op):
            if os_effect(op) != "":
                ok = false
        case CallRes.World(_) | CallRes.Prim(_):
            ok = false
        case CallRes.Fn(id) | CallRes.Method(id):
            calls.push(id)
        case _:
            pass
    for c in children(e):
        effs_free_expr(c, ref ok, ref calls)

# A key that is the same only for values that are surely the same (a string
# is known only by its length, a float only roughly: none).
fn val_key(v: V) -> Option[str]:
    match v:
        case V.Int(l):
            return Some("i" + lin_key(l))
        case V.Bool(f):
            return f_key(f)
        case V.Arr(c, l):
            return Some(f"a{c}," + lin_key(l))
        case V.Agg(vs):
            var k = "("
            for x in vs:
                match val_key(x):
                    case Some(xk):
                        k += xk + ","
                    case None:
                        return None
            return Some(k + ")")
        case _:
            return None

fn f_key(f: F) -> Option[str]:
    match f:
        case F.True:
            return Some("T")
        case F.False:
            return Some("F")
        case F.B(a, p):
            return Some(f"b{a}" + ("+" if p else "-"))
        case _:
            return None

# `a / b` and `a % b` don't fail: no division by zero, nor `MIN / -1`.
fn div_goal(op: BinOp, a: Lin, b: Lin, k: IntTy) -> F:
    var g = [F.ne(b)]
    if op == BinOp.Div and k.signed():
        let am = a.sub(Lin.konst(k.min()))
        let b1 = b.add_c(1)
        g.push(F.or_([F.ne(am.unwrap_or(a)), F.ne(b1.unwrap_or(b))]))
        if am.is_none() or b1.is_none():
            g.push(F.B(ATOM_UNKNOWN, true))
    return F.and_(g)

# A shift by `b` of a `k` is in range: 0 <= b < bits.
fn shift_goal(b: Lin, k: IntTy) -> F:
    return F.and_([F.ge(b), F.lt(b, Lin.konst(i128(k.bits())))])

# Formula stating `a == b` (when expressible).
fn val_eq(a: V, b: V) -> Option[F]:
    match (a, b):
        case (V.Int(x), V.Int(y)):
            return Some(F.equal(x, y))
        case (V.Bool(x), V.Bool(y)):
            return Some(bool_eq(x, y))
        case (V.Arr(_, x), V.Arr(_, y)):
            return Some(F.equal(x, y))
        case (V.Str(x), V.Str(y)):
            return Some(F.equal(x, y))
        case (V.Flt(x, nx, bx, ax), V.Flt(y, ny, by, ay)):
            return Some(F.and_([F.equal(x, y), F.equal(bx, by), F.equal(ax, ay), bool_eq(nx, ny)]))
        case (V.Agg(xs), V.Agg(ys)):
            if len(xs) != len(ys):
                return None
            var fs: [F] = []
            for i in 0..len(xs):
                match val_eq(xs[i], ys[i]):
                    case Some(f):
                        fs.push(f)
                    case None:
                        pass
            return Some(F.and_(fs))
        case _:
            return None

# ================================================================ bounds
# Constant bounds `(lo, hi)`; None is unbounded.

fn add_opt(a: Option[i128], b: Option[i128]) -> Option[i128]:
    match (a, b):
        case (Some(x), Some(y)):
            return add_i128(x, y)
        case _:
            return None

fn mul_opt(k: i128, a: Option[i128]) -> Option[i128]:
    match a:
        case Some(x):
            return mul_i128(k, x)
        case None:
            return None

# The bounds of `a` tightened by fact `f` when it bounds `a` alone.
fn tighten(f: F, a: int, b: (Option[i128], Option[i128])) -> (Option[i128], Option[i128]):
    var lo = b.0
    var hi = b.1
    match f:
        case F.Ge(l):
            if len(l.t) == 1 and l.t[0].0 == a:
                # k*a + c >= 0
                let k = l.t[0].1
                let c = l.c
                if k > 0:
                    match neg_i128(c / k):
                        case Some(v):
                            if lo.is_none() or v > lo.unwrap():
                                lo = Some(v)
                        case None:
                            pass
                else:
                    match neg_i128(k):
                        case Some(m):
                            let v = c / m
                            if hi.is_none() or v < hi.unwrap():
                                hi = Some(v)
                        case None:
                            pass
        case F.Eq(l):
            if len(l.t) == 1 and l.t[0].0 == a:
                let k = l.t[0].1
                let c = l.c
                if k != -1 and c % k == 0:
                    match neg_i128(c / k):
                        case Some(v):
                            lo = Some(v)
                            hi = Some(v)
                        case None:
                            pass
                elif k == -1:
                    lo = Some(c)
                    hi = Some(c)
        case F.And(xs):
            for x in xs:
                let t = tighten(x, a, (lo, hi))
                lo = t.0
                hi = t.1
        case _:
            pass
    return (lo, hi)

# The values `l` can have by its atoms' ranges alone.
fn lin_range(l: Lin, ranges: [Option[(i128, i128)]]) -> (Option[i128], Option[i128]):
    var lo: Option[i128] = Some(l.c)
    var hi: Option[i128] = Some(l.c)
    for a, k in l.t:
        var ab: (Option[i128], Option[i128]) = (None, None)
        if a < len(ranges):
            match ranges[a]:
                case Some(r):
                    ab = (Some(r.0), Some(r.1))
                case None:
                    pass
        if k > 0:
            lo = add_opt(lo, mul_opt(k, ab.0))
            hi = add_opt(hi, mul_opt(k, ab.1))
        else:
            lo = add_opt(lo, mul_opt(k, ab.1))
            hi = add_opt(hi, mul_opt(k, ab.0))
    return (lo, hi)

# Both bounds (None: no bound on that side).
fn meet(
    a: (Option[i128], Option[i128]),
    b: (Option[i128], Option[i128])
) -> (Option[i128], Option[i128]):
    var lo = a.0
    var hi = a.1
    match b.0:
        case Some(x):
            if lo.is_none() or x > lo.unwrap():
                lo = Some(x)
        case None:
            pass
    match b.1:
        case Some(y):
            if hi.is_none() or y < hi.unwrap():
                hi = Some(y)
        case None:
            pass
    return (lo, hi)

# Either bounds.
fn join_bounds(
    a: (Option[i128], Option[i128]),
    b: (Option[i128], Option[i128])
) -> (Option[i128], Option[i128]):
    var lo: Option[i128] = None
    var hi: Option[i128] = None
    match (a.0, b.0):
        case (Some(x), Some(y)):
            lo = Some(min(x, y))
        case _:
            pass
    match (a.1, b.1):
        case (Some(x), Some(y)):
            hi = Some(max(x, y))
        case _:
            pass
    return (lo, hi)

# The bounds of atom `a` that `f` implies, with the other atoms in their ranges.
fn fact_bounds(f: F, a: int, ranges: [Option[(i128, i128)]]) -> (Option[i128], Option[i128]):
    match f:
        case F.Ge(l):
            return ge_bounds(l, a, ranges)
        case F.Eq(l):
            match l.neg():
                case Some(n):
                    return meet(ge_bounds(l, a, ranges), ge_bounds(n, a, ranges))
                case None:
                    return (None, None)
        case F.And(xs):
            var b: (Option[i128], Option[i128]) = (None, None)
            for x in xs:
                b = meet(b, fact_bounds(x, a, ranges))
            return b
        case F.Or(ys):
            if len(ys) == 0:
                return (None, None)
            var b = fact_bounds(ys[0], a, ranges)
            for y in ys[1:]:
                b = join_bounds(b, fact_bounds(y, a, ranges))
            return b
        case _:
            return (None, None)

# The bound of `a` that `l >= 0` implies: k*a + rest >= 0, rest at most its
# range's top, so k*a >= -top.
fn ge_bounds(l: Lin, a: int, ranges: [Option[(i128, i128)]]) -> (Option[i128], Option[i128]):
    let k = l.coef(a)
    if k == 0:
        return (None, None)
    let rest = Lin(c=l.c, t=[p for p in l.t if p.0 != a])
    match lin_range(rest, ranges).1:
        case Some(top):
            # a huge bound helps nobody, and its arithmetic could overflow
            let lim: i128 = 1 << 100
            if wrapping_abs(top) > lim or wrapping_abs(k) > lim:
                return (None, None)
            if k > 0:
                # a >= ceil(-top / k); brine's `/` rounds down
                return (Some(-(top / k)), None)
            return (None, Some(top / -k))
        case None:
            return (None, None)

# The bounds of `x * y` for `x` in `a` and `y` in `b`.
fn mul_bounds(
    a: (Option[i128], Option[i128]),
    b: (Option[i128], Option[i128])
) -> (Option[i128], Option[i128]):
    match (a.0, a.1, b.0, b.1):
        case (Some(al), Some(ah), Some(bl), Some(bh)):
            let ps = [mul_i128(al, bl), mul_i128(al, bh), mul_i128(ah, bl), mul_i128(ah, bh)]
            if all(p.is_some() for p in ps):
                var lo = ps[0].unwrap()
                var hi = lo
                for p in ps:
                    lo = min(lo, p.unwrap())
                    hi = max(hi, p.unwrap())
                return (Some(lo), Some(hi))
        case _:
            pass
    match (a.0, b.0):
        case (Some(al), Some(bl)):
            if al >= 0 and bl >= 0:
                return (mul_i128(al, bl), None)
        case _:
            pass
    return (None, None)

fn nonneg(b: (Option[i128], Option[i128])) -> bool:
    match b.0:
        case Some(x):
            return x >= 0
        case None:
            return false

# 2^k - 1 for the smallest k with 2^k > x (0 <= x < 2^62)
fn ones_above(x: i128) -> i128:
    var p: i128 = 1
    while p <= x:
        p *= 2
    return p - 1

# k when c == 2^k (0 < k < 63), else -1
fn log2_exact(c: i128) -> int:
    var p: i128 = 2
    var k = 1
    while p < c and k < 62:
        p *= 2
        k += 1
    return k if p == c else -1

# Do `a`'s terms equal `s` times `b`'s?
fn same_terms(a: Lin, b: Lin, s: i128) -> bool:
    if len(a.t) != len(b.t):
        return false
    for i in 0..len(a.t):
        let k = b.t[i].1
        if a.t[i].0 != b.t[i].0 or wrapping_neg(k) == k:
            return false
        if a.t[i].1 != (k if s > 0 else -k):
            return false
    return true

# The bounds of `l` tightened by fact `f` when it bounds `l`'s terms as a whole.
fn tighten_lin(f: F, l: Lin, b: (Option[i128], Option[i128])) -> (Option[i128], Option[i128]):
    match f:
        case F.Ge(g):
            return tighten_by(g, false, l, b)
        case F.Eq(g):
            return tighten_by(g, true, l, b)
        case F.And(xs):
            var r = b
            for x in xs:
                r = tighten_lin(x, l, r)
            return r
        case _:
            return b

# `g >= 0` (or `g == 0` when `eq`) where `g`'s terms are plus or minus `l`'s
fn tighten_by(
    g: Lin,
    eq: bool,
    l: Lin,
    b: (Option[i128], Option[i128])
) -> (Option[i128], Option[i128]):
    var lo = b.0
    var hi = b.1
    if same_terms(g, l, 1):
        # l's terms >= -g.c
        match neg_i128(g.c):
            case Some(ng):
                match add_i128(l.c, ng):
                    case Some(v):
                        if lo.is_none() or v > lo.unwrap():
                            lo = Some(v)
                        if eq:
                            hi = Some(v)
                    case None:
                        pass
            case None:
                pass
    elif same_terms(g, l, -1):
        # l's terms <= g.c
        match add_i128(l.c, g.c):
            case Some(v):
                if hi.is_none() or v < hi.unwrap():
                    hi = Some(v)
                if eq:
                    lo = Some(v)
            case None:
                pass
    return (lo, hi)

# Monotone locals: those a loop changes only by `x += c` (or only by `x -= c`)
# with constants c >= 0, anywhere in its body. An overflow panics, so at the
# start of every iteration and after the loop `x >= x0` (`x <= x0`).
fn monotone(b: Block, cond: Option[Expr], info: ProgramInfo) -> [(int, int)]:
    var dirs: {int: int} = {}
    var other: {int: int} = {}
    match cond:
        case Some(c):
            mods_expr(c, info, ref other)
        case None:
            pass
    count_steps(b, info, ref dirs, ref other)
    var ids: [int] = []
    for id in dirs:
        if dirs[id] != 0 and id not in other:
            ids.push(id)
    ids.sort()
    return [(id, dirs[id]) for id in ids]

fn count_steps(b: Block, info: ProgramInfo, ref dirs: {int: int}, ref other: {int: int}):
    for s in b.stmts:
        match s.kind:
            case StmtKind.Assign(target, op, value):
                match lvalue_root(target):
                    case Some(r):
                        var d = 0
                        match (target.kind, op, value.kind):
                            case (ExprKind.Ident(_), Some(BinOp.Add), ExprKind.Int(v)):
                                if v >= 0:
                                    d = 1
                            case (ExprKind.Ident(_), Some(BinOp.Sub), ExprKind.Int(v)):
                                if v >= 0:
                                    d = -1
                            case _:
                                pass
                        let was = dirs.get(r).unwrap_or(d)
                        if d == 0 or was != d:
                            note_mod(ref other, r, MOD_WHOLE)
                        else:
                            dirs[r] = d
                    case None:
                        pass
            case _:
                pass
        for e in stmt_exprs(s):
            mods_expr(e, info, ref other)
        for blk in stmt_blocks(s):
            count_steps(blk, info, ref dirs, ref other)

# The atoms that are the integer parts of `v`, a value just made by `fresh_val`.
fn fresh_atoms(v: V) -> [int]:
    match v:
        case V.Int(l):
            if len(l.t) == 1 and l.c == 0 and l.t[0].1 == 1:
                return [l.t[0].0]
        case V.Agg(vs):
            var out: [int] = []
            for x in vs:
                out.extend(fresh_atoms(x))
            return out
        case _:
            pass
    return []

# Facts that hold on both paths of a merge, for a value `nv` that is `va` on
# one and `vb` on the other: when they differ by a constant, `nv` is between
# them. Plain facts the solver uses without splitting on the paths.
fn hull_facts(nv: V, va: V, vb: V, ref out: [F]):
    match (nv, va, vb):
        case (V.Int(n), V.Int(x), V.Int(y)):
            hull_lin(n, x, y, ref out)
        case (V.Arr(_, n), V.Arr(_, x), V.Arr(_, y)):
            hull_lin(n, x, y, ref out)
        case (V.Str(n), V.Str(x), V.Str(y)):
            hull_lin(n, x, y, ref out)
        case (V.Agg(ns), V.Agg(xs), V.Agg(ys)):
            if len(ns) == len(xs) and len(xs) == len(ys):
                for i in 0..len(ns):
                    hull_facts(ns[i], xs[i], ys[i], ref out)
        case _:
            pass

fn hull_lin(n: Lin, x: Lin, y: Lin, ref out: [F]):
    match x.sub(y):
        case Some(d0):
            match d0.is_const():
                case Some(d):
                    let z: i128 = 0
                    match (y.add_c(min(z, d)), y.add_c(max(z, d))):
                        case (Some(lo), Some(hi)):
                            out.push(F.le(lo, n))
                            out.push(F.le(n, hi))
                        case _:
                            pass
                case None:
                    pass
        case None:
            pass

# `f` split at its top-level `and`s.
fn conjuncts(f: F, ref out: [F]):
    match f:
        case F.And(xs):
            for x in xs:
                conjuncts(x, ref out)
        case _:
            out.push(f)
