# x86-64 machine code for the brine IR: instruction selection, encoding and
# the Win64 / System V calling conventions. `emit_object` turns a Module into
# the bytes of a relocatable object file (COFF or ELF64, see obj.br).
#
# The approach is simple and fast to compile: every vreg lives in a stack
# slot ([rbp - k]) in canonical form (integers narrower than 64 bits sign- or
# zero-extended to 64 by their kind, Bool 0/1, F32 in the low 4 bytes); each
# instruction loads its operands into scratch registers (rax rcx rdx r10 r11
# xmm0 xmm1, caller-saved in both ABIs), computes, and stores the result.
# Vregs assigned exactly once by a Const, SlotAddr or Global get no slot: their
# uses become immediates and rbp- or rip-relative addresses. A comparison whose
# only use is the branch right after it becomes a compare-and-jump.
# Overflow and index checks jump to cold stubs after the function body.
# Every function gets unwind tables (.pdata / .xdata on Windows, .eh_frame on
# Linux) so that debuggers, profilers and Windows' longjmp can walk the stack.
#
# Debug builds (`emit_obj_debug`) also get DWARF line and variable info
# (dwarf.br). They keep every vreg in its slot and drop the optimizations that
# keep values in registers across instructions, so whenever a debugger stops
# at a line, variables are in memory where the debug info says.

from ir import K, Op, Inst, Func, Module, KFunc, KOp
from ir import KO_MOV, KO_LD, KO_LDP, KO_LDH, KO_ST, KO_STH, KO_OP, KO_SQRT, KO_SHUF
from ir import KO_CONST, KO_CONST2, KO_SPILL, KO_FILL, KO_ARG, KO_CHK, PFX_PD, PFX_SD
from ir import KPath, KV_BCF, KV_BCI, KV_J, KV_JINC, KV_LD, KV_ST, KV_MOV, KV_FOP, KV_IOP, KV_SHI
from ir import KV_CVT, KV_RLD, KV_RED, KV_RST
from ir import KL_LD, KL_ST, KL_MOV, KL_OP, KL_CMP, KL_SEL, KL_NOT, KL_ANY
from ir import KW_LD, KW_LDH, KW_LDD, KW_LDP, KW_LDV, KW_INS, KW_BC, KW_BCA, KW_OP, KW_SQRT
from ir import KW_PERM, KW_LDK, KW_ALIGN, KW_ST, KW_STH, KW_SPILL, KW_FILL, KW_MOV, KW_ARG
from opt import promote, reads, switches, inline_small, const_arrs, arr_data, prune_rt
import ssa
import ra
from dwarf import Dwarf, DFn, DRow, DLocal, new_dwarf, loc_breg, loc_deref, write_dwarf
from obj import ObjFile, OSym, ORel, new_obj, write_coff, write_elf, put16, put32, put64, set32, uleb, sleb, log2
from obj import SEC_UNDEF, SEC_TEXT, SEC_DATA, SEC_RODATA, SEC_UNWIND, R_PC32, R_CALL, R_ABS64, R_GOT, R_RVA32

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
const R12 = 12
const R13 = 13
const R14 = 14
const R15 = 15
# memory operand base: rip-relative to a symbol
const RIP = 16

# condition codes
const CC_O = 0
const CC_B = 2
const CC_AE = 3
const CC_E = 4
const CC_NE = 5
const CC_BE = 6
const CC_A = 7
const CC_S = 8
const CC_P = 10
const CC_NP = 11
const CC_L = 12
const CC_GE = 13
const CC_LE = 14
const CC_G = 15
# float equality needs two flags (ZF and PF)
const CC_FEQ = 100
const CC_FNE = 101

# ALU opcode extensions
const ADD = 0
const OR = 1
const ADC = 2
const SBB = 3
const AND = 4
const SUB = 5
const XOR = 6
const CMP = 7

# shift opcode extensions
const SHL = 4
const SHR = 5
const SAR = 7

# how a vreg is folded away
const F_NONE = 0
const F_CONST = 1
const F_SLOT = 2
const F_GLOBAL = 3
# an element address used only by loads and stores just after it, which
# address [a + b * n] themselves (fval: the Elem's index in the code)
const F_ELEM = 4
# a float constant, read from .rodata where it is used (fval: its symbol)
const F_FCONST = 5

# call argument sources
const A_VAL = 0
const A_ADDR = 1
const A_IMM = 2
const A_SYM = 3
const A_FRAME = 4
const A_REG = 5

# argument locations: integer register i, xmm register 100 + i, stack 1000 + i
const L_XMM = 100
const L_STACK = 1000
# (par_fmoves: an argument saved in rax to break a cycle of moves)
const F_IN_RAX = -2

# panic stubs
const S_ADD = 0
const S_SUB = 1
const S_MUL = 2
const S_IDX = 3

const TWO63_F64 = 4890909195324358656
const TWO63_F32 = 1593835520

struct Mem:
    base: int
    # -1: no index
    index: int
    scale: int
    disp: int
    # with base RIP: the symbol (the address is sym + disp)
    sym: int

struct CArg:
    how: int
    v: int
    # 0: integer class, 1: f64, 2: f32
    fl: int

struct Stub:
    # the rel32 of the jump to the stub
    at: int
    kind: int
    a: int
    b: int
    c: int

# What the unwind tables say about a function: where (offsets in .text) each
# step of its prologue ends, and its epilogues.
struct Unw:
    start: int
    # after the push of each callee-saved register (in X.saved order)
    pushes: [int]
    # after `sub rsp, 8` keeping rbp 16-byte aligned (-1: none)
    pad: int
    # after rbp is set
    fp: int
    # after the frame is allocated, and its size
    alloc: int
    grow: int
    # the end of the prologue
    pro_end: int
    # after the `leave` / `pop rbp` of each epilogue (`ret` follows)
    epis: [int]

fn fits8(v: int) -> bool:
    return v >= -128 and v <= 127

fn fits32(v: int) -> bool:
    return v >= -2147483648 and v <= 2147483647

fn mrb(disp: int) -> Mem:
    return Mem(base=RBP, index=-1, scale=1, disp=disp, sym=-1)

fn mreg(r: int, disp: int) -> Mem:
    return Mem(base=r, index=-1, scale=1, disp=disp, sym=-1)

fn mrip(sym: int, disp: int) -> Mem:
    return Mem(base=RIP, index=-1, scale=1, disp=disp, sym=sym)

fn moff(m: Mem, d: int) -> Mem:
    return Mem(base=m.base, index=m.index, scale=m.scale, disp=m.disp + d, sym=m.sym)

fn fl_of(k: K) -> int:
    if k == K.F64:
        return 1
    if k == K.F32:
        return 2
    return 0

fn align_up(v: int, a: int) -> int:
    return (v + a - 1) / a * a

# `n` as a value of kind k in canonical form
fn canon(n: int, k: K) -> int:
    match k:
        case K.I8:
            return ((n & 255) ^ 128) - 128
        case K.U8:
            return n & 255
        case K.I16:
            return ((n & 65535) ^ 32768) - 32768
        case K.U16:
            return n & 65535
        case K.I32:
            return ((n & 4294967295) ^ 2147483648) - 2147483648
        case K.U32:
            return n & 4294967295
        case K.Bool:
            return 0 if n == 0 else 1
        case _:
            return n

fn scale_bits(s: int) -> int:
    if s == 8:
        return 3
    if s == 4:
        return 2
    if s == 2:
        return 1
    return 0

fn w128(k: K) -> str:
    return "i128" if k == K.I128 else "u128"

# DWARF's number for register r
fn dwarf_reg(r: int) -> int:
    if r < 8:
        return [0, 2, 1, 3, 7, 6, 4, 5][r]
    return r

# The runtime helpers (calls with b = 1) whose brine_x_ twins write a 128-bit
# result through a pointer (see brine_rt.c), by their IR names.
fn wide_rt_helpers() -> {str: bool}:
    var m: {str: bool} = {}
    for w in ["i128", "u128"]:
        for op in ["add", "sub", "mul", "shl", "shr", "fdiv", "fmod", "div", "mod", "abs", "parse"]:
            m[f"brine_{op}_{w}"] = true
        for src in ["i64", "u64", "i128", "u128", "f64"]:
            m[f"brine_conv_{w}_from_{src}"] = true
    m["brine_neg_i128"] = true
    return m

# Runtime calls compiled inline that fall back to the call itself (and so read
# their arguments a second time)
fn slow_call(n: str) -> bool:
    return n == "brine_bytes_rotl" or n == "brine_bytes_copy" or ra.int_div_rt(n)

const TWO64: i128 = 18446744073709551616

# (m, p) with x / c == (x * m) >> p for every x below 2^nbits, m below 2^64 (as
# an int: its bits) and p from 64 on, so that the product's high half shifted
# right by p - 64 is the quotient; p = 0 when there's no such m. With
# m = ceil(2^p / c) = (2^p + e) / c that holds when x * e < 2^p.
fn div_magic(c: int, nbits: int) -> (int, int):
    var l = 0
    while (1 << l) < c:
        l += 1
    let top: i128 = (i128(1) << nbits) - 1
    let ci = i128(c)
    for p in 64..65 + l:
        let tp: i128 = i128(1) << p
        let m = (tp + ci - 1) / ci
        if m < TWO64 and (m * ci - tp) * top < tp:
            if m >= TWO64 / 2:
                return (int(m - TWO64), p)
            return (int(m), p)
    return (0, 0)

# The CIE of .eh_frame, shared by every FDE: on entry the CFA is rsp + 8 and
# the return address is at CFA - 8; FDEs give their code range pc-relative.
fn elf_cie(ref out: [u8]):
    put32(ref out, 0)
    put32(ref out, 0)
    # version 1, augmentation "zR"
    out.extend([1, 122, 82, 0])
    # code alignment 1, data alignment -8, return address register 16
    uleb(ref out, 1)
    sleb(ref out, -8)
    uleb(ref out, 16)
    # augmentation data: FDE addresses are DW_EH_PE_pcrel | DW_EH_PE_sdata4
    uleb(ref out, 1)
    out.push(27)
    # DW_CFA_def_cfa rsp, 8; DW_CFA_offset r16, 1
    out.extend([12, 7, 8, 144, 1])
    while len(out) % 8 != 0:
        out.push(0)
    set32(ref out, 0, len(out) - 4)

struct X:
    win: bool
    o: ObjFile
    syms: {str: int}
    # module functions with a 128-bit result
    wide_ret: {str: bool}
    # runtime helpers (calls with b = 1) with a 128-bit result
    wide_rt: {str: bool}
    # local symbols at the start of .text and .xdata, for the unwind tables
    text_sym: int
    xdata_sym: int
    # symbols of the overflow panic texts ("addition", ...), -1 until used
    ovf: [int]
    # .rodata symbols of float constants, by their bits (and 1 << 64 for f32)
    fpool: {i128: int}
    # 16-byte constants (vector kernels), by "lo,hi"
    vpool: {str: int}
    # the .data byte where loop kernels keep the CPU level (0: not known
    # yet, 1: SSE2, 3: AVX2 too, 7: AVX-512 F and DQ too), -1 until used
    cpu_sym: int
    # the function being compiled
    code: [Inst]
    # code[i] can't be reached: a block no jump goes to, after a jump
    dead: [bool]
    # how many jumps go to each label
    lrefs: [int]
    vk: [K]
    nparams: int
    home: [int]
    # the register holding the vreg (see ra.br), or -1
    reg: [int]
    # callee-saved registers the function uses (pushed after rbp)
    saved: [int]
    # the xmm register holding a float vreg, or -1
    freg: [int]
    # Windows: the xmm registers used (callee-saved there) and where the
    # prologue saves them
    fsaved: [int]
    fsave_at: [int]
    # per instruction, the vregs live across the call it makes in registers
    # that call changes, saved around it (ra.br)
    keep: [[int]]
    # the functions whose calls are slow paths (Module.cold)
    cold: {str: bool}
    fold: [int]
    fval: [int]
    nuse: [int]
    # slot s is at [slot_base[s] + slot_off[s]]: rbp-relative, or rsp-relative
    # when aligned to more than 16 bytes (rsp is aligned for it)
    slot_off: [int]
    slot_base: [int]
    ploc: [int]
    lpos: [int]
    jat: [int]
    jlab: [int]
    # jump table entries: where, the label, and the table's start
    tat: [int]
    tlab: [int]
    tbase: [int]
    stubs: [Stub]
    # home of the hidden pointer to a 128-bit result (0: none)
    retp: int
    # see `cached`
    creg: int
    cv: int
    cpos: int
    # where the store that filled the cache starts (-1: it was a load), and
    # in which instruction
    cstore: int
    cinst: int
    # the instruction being compiled
    cur: int
    # vregs read only once, by an instruction that reads them only once: if
    # that read finds the value in a register, the store to the slot can go
    once: [bool]
    # a 16-byte frame slot for ignored 128-bit results
    scratch: int
    has_ret: bool
    ret: K
    u: Unw
    # debug builds: the debug info so far, the start of each instruction of
    # the function being compiled, and its line rows
    dbg: bool
    dw: Dwarf
    ipos: [int]
    rows: [DRow]
    # the C entry point goes with brine's `main`, and where it is
    entry_main: bool
    entry: (int, int)

    # ------------------------------------------------------------ bytes
    fn b(ref self, v: int):
        self.o.text.push(u8(v & 255))

    fn b16(ref self, v: int):
        self.o.text.push(u8(v & 255))
        self.o.text.push(u8((v >> 8) & 255))

    fn b32(ref self, v: int):
        put32(ref self.o.text, v)

    fn b64(ref self, v: int):
        put64(ref self.o.text, v)

    fn pos(self) -> int:
        return len(self.o.text)

    fn opc(ref self, op: int):
        if op > 65535:
            self.b(op >> 16)
        if op > 255:
            self.b(op >> 8)
        self.b(op)

    fn reloc(ref self, kind: int, sym: int, add: int):
        self.o.trel.push(ORel(off=self.pos(), sym=sym, kind=kind, add=add))

    # ------------------------------------------------------------ symbols
    fn sym_ref(ref self, name: str) -> int:
        match self.syms.get(name):
            case Some(i):
                return i
            case None:
                let i = len(self.o.syms)
                self.o.syms.push(OSym(name=name, sec=SEC_UNDEF, off=0, global=false, func=false))
                self.syms[name] = i
                return i

    fn sym_def(ref self, name: str, sec: int, off: int, global: bool, func: bool) -> int:
        let i = self.sym_ref(name)
        self.o.syms[i] = OSym(name=name, sec=sec, off=off, global=global, func=func)
        return i

    # Can code address the symbol rip-relative? (ELF: only if it's defined
    # here or in the runtime, which every program links in; other external
    # ones go through the GOT, which PIE links need.)
    fn direct(self, s: int) -> bool:
        return (
            self.win or self.o.syms[s].sec != SEC_UNDEF or self.o.syms[s].name.starts_with("brine_")
        )

    # The symbol of 8 bytes of .rodata holding a float constant's bits (an f32
    # in the low 4, zero above, as the canonical form of a vreg has it)
    fn fconst_sym(ref self, bits: int, k: K) -> int:
        var b = bits
        var key = i128(bits)
        if k == K.F32:
            b = bits & 4294967295
            key = i128(b) + (i128(1) << 64)
        match self.fpool.get(key):
            case Some(s):
                return s
            case None:
                pass
        while len(self.o.rodata) % 8 != 0:
            self.o.rodata.push(0)
        self.o.rodata_align = max(self.o.rodata_align, 8)
        let off = len(self.o.rodata)
        put64(ref self.o.rodata, b)
        let s = self.sym_def(f"__brx_f{len(self.fpool)}", SEC_RODATA, off, false, false)
        self.fpool[key] = s
        return s

    fn ovf_sym(ref self, kind: int) -> int:
        if self.ovf[kind] < 0:
            let names = ["addition", "subtraction", "multiplication"]
            let off = len(self.o.rodata)
            for c in names[kind].bytes():
                self.o.rodata.push(u8(c))
            self.o.rodata.push(0)
            self.ovf[kind] = self.sym_def(f"__brx_ovf_{names[kind]}", SEC_RODATA, off, false, false)
        return self.ovf[kind]

    # ------------------------------------------------------------ encoding
    fn modrm(ref self, reg: int, m: Mem, immlen: int):
        let r = (reg & 7) << 3
        if m.base == RIP:
            self.b(5 | r)
            self.reloc(R_PC32, m.sym, m.disp - 4 - immlen)
            self.b32(0)
            return
        let base = m.base & 7
        var mode = 2
        if m.disp == 0 and base != 5:
            mode = 0
        elif fits8(m.disp):
            mode = 1
        if m.index < 0 and base != 4:
            self.b((mode << 6) | r | base)
        else:
            self.b((mode << 6) | r | 4)
            let idx = (m.index & 7) if m.index >= 0 else 4
            self.b((scale_bits(m.scale) << 6) | (idx << 3) | base)
        if mode == 1:
            self.b(m.disp)
        elif mode == 2:
            self.b32(m.disp)

    fn rex_m(self, w: int, reg: int, m: Mem) -> int:
        var x = 64 | (w << 3) | ((reg >> 3) << 2)
        if m.base != RIP:
            x = x | (m.base >> 3)
            if m.index >= 0:
                x = x | ((m.index >> 3) << 1)
        return x

    # op reg, [m]: pfx is a mandatory prefix (0x66, 0xF2, 0xF3) or 0, w REX.W,
    # immlen the bytes of immediate after the operand
    fn rm(ref self, pfx: int, w: int, op: int, reg: int, m: Mem, immlen: int):
        if pfx != 0:
            self.b(pfx)
        let x = self.rex_m(w, reg, m)
        if x != 64:
            self.b(x)
        self.opc(op)
        self.modrm(reg, m, immlen)

    # same with an 8-bit register operand (spl..dil need a REX)
    fn rm8(ref self, op: int, reg: int, m: Mem, immlen: int):
        let x = self.rex_m(0, reg, m)
        if x != 64 or (reg >= 4 and reg < 8):
            self.b(x)
        self.opc(op)
        self.modrm(reg, m, immlen)

    fn rr(ref self, pfx: int, w: int, op: int, reg: int, r: int):
        if pfx != 0:
            self.b(pfx)
        let x = 64 | (w << 3) | ((reg >> 3) << 2) | (r >> 3)
        if x != 64:
            self.b(x)
        self.opc(op)
        self.b(192 | ((reg & 7) << 3) | (r & 7))

    # VEX (three-byte form) op reg, v, [m]: map 1 is 0F, 2 is 0F38; pp 1 is
    # 66; l 1 is 256 bits. v 0 when unused.
    fn vex_m(ref self, map: int, pp: int, l: int, op: int, reg: int, v: int, m: Mem):
        let x = self.rex_m(0, reg, m)
        self.b(196)
        self.b(
            ((((x >> 2) & 1) ^ 1) << 7) | ((((x >> 1) & 1) ^ 1) << 6) | (((x & 1) ^ 1) << 5) | map
        )
        self.b(((15 - v) << 3) | (l << 2) | pp)
        self.b(op)
        self.modrm(reg, m, 0)

    fn vex_r(ref self, map: int, pp: int, l: int, op: int, reg: int, v: int, r: int):
        self.b(196)
        self.b((((reg >> 3) ^ 1) << 7) | 64 | (((r >> 3) ^ 1) << 5) | map)
        self.b(((15 - v) << 3) | (l << 2) | pp)
        self.b(op)
        self.b(192 | ((reg & 7) << 3) | (r & 7))

    # EVEX op reg, v, rm (no masks, registers 0..31): map and pp as for VEX,
    # w EVEX.W, l 2 for 512 bits. `n`: what a one-byte displacement counts
    # in (the memory operand's size).
    fn evex_m(
        ref self,
        map: int,
        pp: int,
        w: int,
        l: int,
        op: int,
        reg: int,
        v: int,
        m: Mem,
        n: int
    ):
        let x = self.rex_m(0, reg, m)
        self.b(98)
        self.b(
            ((((x >> 2) & 1) ^ 1) << 7)
            | ((((x >> 1) & 1) ^ 1) << 6)
            | (((x & 1) ^ 1) << 5)
            | ((((reg >> 4) & 1) ^ 1) << 4)
            | map
        )
        self.b((w << 7) | ((15 - (v & 15)) << 3) | 4 | pp)
        self.b((l << 5) | ((((v >> 4) & 1) ^ 1) << 3))
        self.b(op)
        if m.base == RIP:
            self.modrm(reg, m, 0)
            return
        # modrm with the displacement in units of n
        let r = (reg & 7) << 3
        let base = m.base & 7
        var mode = 2
        if m.disp == 0 and base != 5:
            mode = 0
        elif m.disp % n == 0 and fits8(m.disp / n):
            mode = 1
        if m.index < 0 and base != 4:
            self.b((mode << 6) | r | base)
        else:
            self.b((mode << 6) | r | 4)
            let idx = (m.index & 7) if m.index >= 0 else 4
            self.b((scale_bits(m.scale) << 6) | (idx << 3) | base)
        if mode == 1:
            self.b(m.disp / n)
        elif mode == 2:
            self.b32(m.disp)

    fn evex_r(ref self, map: int, pp: int, w: int, l: int, op: int, reg: int, v: int, r: int):
        self.b(98)
        self.b(
            ((((reg >> 3) & 1) ^ 1) << 7)
            | ((((r >> 4) & 1) ^ 1) << 6)
            | ((((r >> 3) & 1) ^ 1) << 5)
            | ((((reg >> 4) & 1) ^ 1) << 4)
            | map
        )
        self.b((w << 7) | ((15 - (v & 15)) << 3) | 4 | pp)
        self.b((l << 5) | ((((v >> 4) & 1) ^ 1) << 3))
        self.b(op)
        self.b(192 | ((reg & 7) << 3) | (r & 7))

    fn rr8(ref self, op: int, reg: int, r: int):
        let x = 64 | ((reg >> 3) << 2) | (r >> 3)
        if x != 64 or (reg >= 4 and reg < 8) or (r >= 4 and r < 8):
            self.b(x)
        self.opc(op)
        self.b(192 | ((reg & 7) << 3) | (r & 7))

    # ------------------------------------------------------------ instructions
    fn mov_rm(ref self, r: int, m: Mem):
        self.rm(0, 1, 139, r, m, 0)

    fn mov_mr(ref self, m: Mem, r: int):
        self.rm(0, 1, 137, r, m, 0)

    fn mov_rr(ref self, d: int, s: int):
        if d != s:
            self.rr(0, 1, 137, s, d)

    # Does x emit no code? (A label, a line, a move within one register.)
    fn no_code(self, x: Inst) -> bool:
        if x.op == Op.Label or x.op == Op.Line:
            return true
        if x.op != Op.Mov or x.d < 0 or x.a < 0 or self.fold[x.a] != F_NONE:
            return x.op == Op.Mov and x.d == x.a
        if self.reg[x.d] >= 0:
            return self.reg[x.d] == self.reg[x.a]
        return self.freg[x.d] >= 0 and self.freg[x.d] == self.freg[x.a]

    fn lea(ref self, r: int, m: Mem):
        self.rm(0, 1, 141, r, m, 0)

    fn mov_ri(ref self, r: int, v: int):
        if v == 0:
            self.rr(0, 0, 49, r, r)
        elif v > 0 and v <= 4294967295:
            if r >= 8:
                self.b(65)
            self.b(184 + (r & 7))
            self.b32(v)
        elif fits32(v):
            self.rr(0, 1, 199, 0, r)
            self.b32(v)
        else:
            self.b(72 | (r >> 3))
            self.b(184 + (r & 7))
            self.b64(v)

    fn alu_rr(ref self, op: int, d: int, s: int):
        self.rr(0, 1, (op << 3) | 1, s, d)

    fn alu_rm(ref self, op: int, r: int, m: Mem):
        self.rm(0, 1, (op << 3) | 3, r, m, 0)

    fn alu_ri(ref self, op: int, r: int, v: int):
        if fits8(v):
            self.rr(0, 1, 131, op, r)
            self.b(v)
        else:
            self.rr(0, 1, 129, op, r)
            self.b32(v)

    # mov [m], imm of `size` bytes (8: a sign-extended imm32)
    fn mov_mi(ref self, m: Mem, v: int, size: int):
        if size == 1:
            self.rm(0, 0, 198, 0, m, 1)
            self.b(v)
        elif size == 2:
            self.rm(102, 0, 199, 0, m, 2)
            self.b16(v)
        elif size == 4:
            self.rm(0, 0, 199, 0, m, 4)
            self.b32(v)
        else:
            self.rm(0, 1, 199, 0, m, 4)
            self.b32(v)

    fn store_sz(ref self, m: Mem, r: int, size: int):
        if size == 1:
            self.rm8(136, r, m, 0)
        elif size == 2:
            self.rm(102, 0, 137, r, m, 0)
        elif size == 4:
            self.rm(0, 0, 137, r, m, 0)
        else:
            self.rm(0, 1, 137, r, m, 0)

    # r = [m] as kind k, in canonical form
    fn load_k(ref self, r: int, m: Mem, k: K):
        match k:
            case K.I8:
                self.rm(0, 1, 4030, r, m, 0)
            case K.U8 | K.Bool:
                self.rm(0, 0, 4022, r, m, 0)
            case K.I16:
                self.rm(0, 1, 4031, r, m, 0)
            case K.U16:
                self.rm(0, 0, 4023, r, m, 0)
            case K.I32:
                self.rm(0, 1, 99, r, m, 0)
            case K.U32 | K.F32:
                self.rm(0, 0, 139, r, m, 0)
            case _:
                self.rm(0, 1, 139, r, m, 0)

    # brings the low bits of r into canonical form for kind k
    fn norm(ref self, r: int, k: K):
        match k:
            case K.I8:
                self.rr(0, 1, 4030, r, r)
            case K.U8 | K.Bool:
                self.rr8(4022, r, r)
            case K.I16:
                self.rr(0, 1, 4031, r, r)
            case K.U16:
                self.rr(0, 0, 4023, r, r)
            case K.I32:
                self.rr(0, 1, 99, r, r)
            case K.U32:
                self.rr(0, 0, 137, r, r)
            case _:
                pass

    fn setcc(ref self, cc: int, r: int):
        self.rr8(3984 + cc, 0, r)

    fn shift_cl(ref self, ext: int, r: int):
        self.rr(0, 1, 211, ext, r)

    fn shift_i(ref self, ext: int, r: int, n: int):
        self.rr(0, 1, 193, ext, r)
        self.b(n)

    # movsd / movss xmm, [m]
    fn fload(ref self, fl: int, x: int, m: Mem):
        self.rm(242 if fl == 1 else 243, 0, 3856, x, m, 0)

    fn fstore(ref self, fl: int, m: Mem, x: int):
        self.rm(242 if fl == 1 else 243, 0, 3857, x, m, 0)

    # xmm x = float vreg v
    fn fld(ref self, fl: int, x: int, v: int):
        let r = self.freg[v]
        if r < 0:
            self.fload(fl, x, self.vm(v))
        elif r != x:
            # movaps
            self.rr(0, 0, 3880, x, r)

    # float vreg v = xmm x
    fn fst(ref self, fl: int, v: int, x: int):
        let r = self.freg[v]
        if r < 0:
            self.fstore(fl, self.vm(v), x)
        elif r != x:
            self.rr(0, 0, 3880, r, x)

    # an SSE instruction `op xmm x, v` (pfx: its mandatory prefix)
    # xorps x, x: cvtsi2sd, cvtss2sd and sqrtsd keep x's upper bits, so without
    # it each one waits for whatever last wrote x (a dependency across loop
    # iterations)
    # The runtime module's atomics (`atomic_add` etc. in check.br), on the
    # 8 bytes at args[0]: rax, rcx and rdx hold no vregs. A locked or xchg
    # instruction is a full barrier, so each is sequentially consistent.
    fn atomic(ref self, x: Inst):
        let n = x.s[13:]
        if x.s == "brine_cpu_relax":
            # pause
            self.b(0xF3)
            self.b(0x90)
            return
        self.ld(RCX, x.args[0])
        if n == "load":
            # mov rax, [rcx]
            self.b(0x48)
            self.b(0x8B)
            self.b(0x01)
        elif n == "cas":
            self.ld(RAX, x.args[1])
            self.ld(RDX, x.args[2])
            # lock cmpxchg [rcx], rdx
            self.b(0xF0)
            self.b(0x48)
            self.b(0x0F)
            self.b(0xB1)
            self.b(0x11)
        else:
            self.ld(RAX, x.args[1])
            if n == "add":
                # lock xadd [rcx], rax
                self.b(0xF0)
                self.b(0x48)
                self.b(0x0F)
                self.b(0xC1)
                self.b(0x01)
            else:
                # xchg [rcx], rax (store and xchg)
                self.b(0x48)
                self.b(0x87)
                self.b(0x01)
        if x.d >= 0:
            self.st(RAX, x.d)

    fn xzero(ref self, x: int):
        self.rr(0, 0, 3927, x, x)

    fn fop(ref self, pfx: int, op: int, x: int, v: int):
        let r = self.freg[v]
        if r < 0:
            self.rm(pfx, 0, op, x, self.vm(v), 0)
        else:
            self.rr(pfx, 0, op, x, r)

    # movups [m], xmm x / movups xmm x, [m]
    fn xsave(ref self, m: Mem, x: int):
        self.rm(0, 0, 3857, x, m, 0)

    fn xrestore(ref self, x: int, m: Mem):
        self.rm(0, 0, 3856, x, m, 0)

    # rel8 jumps inside one instruction's expansion
    fn j8(ref self, cc: int) -> int:
        self.b(112 + cc)
        self.b(0)
        return self.pos() - 1

    fn jmp8(ref self) -> int:
        self.b(235)
        self.b(0)
        return self.pos() - 1

    fn here8(ref self, at: int):
        let d = self.pos() - at - 1
        assert fits8(d), "a short jump over more than 127 bytes"
        self.o.text[at] = u8(d & 255)
        self.cpos = -1

    # A jump over code of any length, such as a call (which saves floats on
    # System V): jcc rel32, patched by here32.
    fn j32(ref self, cc: int) -> int:
        self.b(15)
        self.b(128 + cc)
        self.b32(0)
        return self.pos() - 4

    fn here32(ref self, at: int):
        set32(ref self.o.text, at, self.pos() - at - 4)
        self.cpos = -1

    fn jcc_label(ref self, cc: int, l: int):
        let p = self.lpos[l]
        if p >= 0 and fits8(p - (self.pos() + 2)):
            self.b(112 + cc)
            self.b(p - self.pos() - 1)
            return
        self.b(15)
        self.b(128 + cc)
        self.jfix(l)

    fn jmp_label(ref self, l: int):
        let p = self.lpos[l]
        if p >= 0 and fits8(p - (self.pos() + 2)):
            self.b(235)
            self.b(p - self.pos() - 1)
            return
        self.b(233)
        self.jfix(l)

    fn jfix(ref self, l: int):
        let p = self.lpos[l]
        if p >= 0:
            self.b32(p - (self.pos() + 4))
        else:
            self.jat.push(self.pos())
            self.jlab.push(l)
            self.b32(0)

    fn jcc_stub(ref self, cc: int, kind: int, a: int, b: int, c: int):
        self.b(15)
        self.b(128 + cc)
        self.stubs.push(Stub(at=self.pos(), kind=kind, a=a, b=b, c=c))
        self.b32(0)

    # ------------------------------------------------------------ vregs
    fn vm(self, v: int) -> Mem:
        if self.fold[v] == F_FCONST:
            return mrip(self.fval[v], 0)
        return mrb(self.home[v])

    # the memory n bytes into slot s
    fn smem(self, s: int, n: int) -> Mem:
        return mreg(self.slot_base[s], self.slot_off[s] + n)

    fn imm(self, v: int) -> bool:
        return self.fold[v] == F_CONST and fits32(self.fval[v])

    fn ld_sym(ref self, r: int, s: int):
        if self.direct(s):
            self.lea(r, mrip(s, 0))
        else:
            # mov r, [rip + s@GOTPCREL]
            self.b(72 | ((r >> 3) << 2))
            self.b(139)
            self.b(5 | ((r & 7) << 3))
            self.reloc(R_GOT, s, -4)
            self.b32(0)

    # Is v in its stack slot (not folded, not in a register)?
    fn inmem(self, v: int) -> bool:
        return self.fold[v] == F_NONE and self.reg[v] < 0 and self.freg[v] < 0

    # Does register creg hold v's slot? (Yes right after a store or load of
    # it, until more code is emitted or a jump can land here.)
    fn cached(self, v: int) -> bool:
        return self.cv == v and self.cpos == self.pos()

    # Like `cached`, for a read of v: if that is v's only read, the store
    # just emitted is dead, so it's taken back.
    fn hit(ref self, v: int) -> bool:
        if not self.cached(v):
            return false
        if self.cstore >= 0 and self.once[v] and self.cinst != self.cur:
            while self.pos() > self.cstore:
                self.o.text.pop()
        return true

    fn cache(ref self, r: int, v: int):
        self.creg = r
        self.cv = v
        self.cpos = self.pos()
        self.cstore = -1

    # r = the value of v (64 bits, canonical; the low half of a 128-bit vreg)
    fn ld(ref self, r: int, v: int):
        let f = self.fold[v]
        if f == F_NONE:
            if self.reg[v] >= 0:
                self.mov_rr(r, self.reg[v])
            elif self.freg[v] >= 0:
                # movq r, xmm
                self.rr(102, 1, 3966, self.freg[v], r)
            elif self.hit(v):
                self.mov_rr(r, self.creg)
            else:
                self.mov_rm(r, self.vm(v))
                self.cache(r, v)
        elif f == F_CONST:
            self.mov_ri(r, self.fval[v])
        elif f == F_SLOT:
            self.lea(r, self.smem(self.fval[v], 0))
        elif f == F_FCONST:
            self.mov_rm(r, self.vm(v))
        else:
            self.ld_sym(r, self.fval[v])

    fn st(ref self, r: int, d: int):
        if self.reg[d] >= 0:
            self.mov_rr(self.reg[d], r)
        elif self.freg[d] >= 0:
            # movq xmm, r
            self.rr(102, 1, 3950, self.freg[d], r)
        else:
            let at = self.pos()
            self.mov_mr(self.vm(d), r)
            self.cache(r, d)
            self.cstore = at
            self.cinst = self.cur

    # a register holding v: its own, or r after loading it there
    fn use(ref self, r: int, v: int) -> int:
        if self.fold[v] == F_NONE and self.reg[v] >= 0:
            return self.reg[v]
        self.ld(r, v)
        return r

    # the register to compute d in: its own, or rax
    fn dst(self, d: int) -> int:
        if self.reg[d] >= 0:
            return self.reg[d]
        return RAX

    # d = v (both 64-bit slots)
    fn set_v(ref self, d: int, v: int):
        if self.reg[d] >= 0:
            self.ld(self.reg[d], v)
        elif self.imm(v):
            self.mov_mi(self.vm(d), self.fval[v], 8)
        else:
            let r = self.use(RAX, v)
            self.st(r, d)

    # op r, v (r is never rcx)
    fn alu_v(ref self, op: int, r: int, v: int):
        if op == CMP and self.imm(v) and self.fval[v] == 0:
            # test r, r: the same flags
            self.rr(0, 1, 133, r, r)
        elif self.imm(v):
            self.alu_ri(op, r, self.fval[v])
        elif self.fold[v] == F_NONE and self.reg[v] >= 0:
            self.alu_rr(op, r, self.reg[v])
        elif self.fold[v] == F_NONE and self.hit(v):
            self.alu_rr(op, r, self.creg)
        elif self.inmem(v):
            self.alu_rm(op, r, self.vm(v))
        else:
            self.ld(RCX, v)
            self.alu_rr(op, r, RCX)

    # The memory at pointer vreg p plus n; may load p into r.
    fn addr(ref self, p: int, n: int, r: int) -> Mem:
        return self.addr2(p, n, r, R11)

    # Same, with ri for the index (Load and Store use rdx and rcx, leaving
    # r10 and r11 to vregs: see ra.br)
    fn addr2(ref self, p: int, n: int, r: int, ri: int) -> Mem:
        let f = self.fold[p]
        if f == F_ELEM:
            let e = self.code[self.fval[p]]
            let base = self.use(r, e.a)
            let ix = self.use(ri, e.b)
            return Mem(base=base, index=ix, scale=e.n, disp=n, sym=-1)
        if f == F_SLOT:
            return self.smem(self.fval[p], n)
        if f == F_GLOBAL and self.direct(self.fval[p]):
            return mrip(self.fval[p], n)
        let b = self.use(r, p)
        return mreg(b, n)

    fn copy16(ref self, dst: Mem, src: Mem):
        self.mov_rm(RAX, src)
        self.mov_mr(dst, RAX)
        self.mov_rm(RAX, moff(src, 8))
        self.mov_mr(moff(dst, 8), RAX)

    # ------------------------------------------------------------ calls
    fn arg_locs(self, fls: [int]) -> [int]:
        var out: [int] = []
        if self.win:
            for i, fl in enumerate(fls):
                if i >= 4:
                    out.push(L_STACK + i - 4)
                elif fl != 0:
                    out.push(L_XMM + i)
                else:
                    out.push(i)
            return out
        var ni = 0
        var nf = 0
        var ns = 0
        for fl in fls:
            if fl != 0 and nf < 8:
                out.push(L_XMM + nf)
                nf += 1
            elif fl == 0 and ni < 6:
                out.push(ni)
                ni += 1
            else:
                out.push(L_STACK + ns)
                ns += 1
        return out

    fn int_reg(self, i: int) -> int:
        if self.win:
            return [RCX, RDX, R8, R9][i]
        return [RDI, RSI, RDX, RCX, R8, R9][i]

    # offset of outgoing stack argument s from rsp
    fn stack_off(self, s: int) -> int:
        return (32 if self.win else 0) + 8 * s

    fn arg_int(ref self, r: int, a: CArg):
        match a.how:
            case 0:
                self.ld(r, a.v)
            case 1:
                self.lea(r, self.vm(a.v))
            case 2:
                self.mov_ri(r, a.v)
            case 3:
                self.ld_sym(r, a.v)
            case 4:
                self.lea(r, mrb(a.v))
            case _:
                self.mov_rr(r, a.v)

    # calls symbol `sym` (or, with sym < 0, the pointer in vreg fp)
    fn do_call(ref self, sym: int, fp: int, args: [CArg]):
        # what the call changes and is live across it goes to its home and
        # back (before the arguments: they may go to those registers)
        var keep: [int] = []
        if self.cur >= 0 and self.cur < len(self.keep):
            keep = self.keep[self.cur]
        for v in keep:
            if self.freg[v] >= 0:
                self.fstore(fl_of(self.vk[v]), self.vm(v), self.freg[v])
            else:
                self.mov_mr(self.vm(v), self.reg[v])
        # (before the arguments: fp may be in one of their registers)
        if sym < 0:
            self.ld(R11, fp)
        var fls: [int] = []
        for a in args:
            fls.push(a.fl)
        let locs = self.arg_locs(fls)
        for i, a in enumerate(args):
            if locs[i] >= L_STACK:
                self.arg_int(RAX, a)
                self.mov_mr(mreg(RSP, self.stack_off(locs[i] - L_STACK)), RAX)
        var todo: [int] = []
        var src: [int] = []
        var regs: [CArg] = args
        var ftodo: [int] = []
        var fsrc: [int] = []
        for i, a in enumerate(args):
            let l = locs[i]
            src.push(-1)
            fsrc.push(-1)
            if l >= L_STACK:
                pass
            elif l >= L_XMM:
                ftodo.push(i)
                if a.how == A_VAL and self.fold[a.v] == F_NONE and self.freg[a.v] >= 0:
                    fsrc[i] = self.freg[a.v]
            else:
                todo.push(i)
                if a.how == A_REG:
                    src[i] = a.v
                elif a.how == A_VAL and self.fold[a.v] == F_NONE and self.reg[a.v] >= 0:
                    src[i] = self.reg[a.v]
        # an argument register is set once no argument left to set is in it
        # (they can be in any register: ra.br), in order when none is; a
        # cycle goes through rax. Float ones first, then integer ones.
        self.par_fmoves(ftodo, locs, fsrc, args)
        while len(todo) > 0:
            var at = -1
            for t, i in enumerate(todo):
                let r = self.int_reg(locs[i])
                if not any(j != i and src[j] == r for j in todo):
                    at = t
                    break
            if at < 0:
                let r = self.int_reg(locs[todo[0]])
                self.mov_rr(RAX, r)
                for j in todo:
                    if src[j] == r:
                        regs[j] = CArg(how=A_REG, v=RAX, fl=0)
                        src[j] = RAX
                continue
            let i = todo[at]
            self.arg_int(self.int_reg(locs[i]), regs[i])
            todo.pop(at)
        if sym >= 0:
            self.b(232)
            self.reloc(R_CALL, sym, -4)
            self.b32(0)
        else:
            self.rr(0, 0, 255, 2, R11)
        for v in keep:
            if self.freg[v] >= 0:
                self.fload(fl_of(self.vk[v]), self.freg[v], self.vm(v))
            else:
                self.mov_rm(self.reg[v], self.vm(v))

    # xmm argument registers locs[i] = args[i] for i in todo, fsrc[i] the xmm
    # register args[i] is in (-1: memory or a constant), in an order that
    # reads each register before it is changed; a cycle goes through rax
    fn par_fmoves(ref self, todo0: [int], locs: [int], fsrc0: [int], args: [CArg]):
        var todo = todo0
        var fsrc = fsrc0
        while len(todo) > 0:
            var at = -1
            for t, i in enumerate(todo):
                let r = locs[i] - L_XMM
                if not any(j != i and fsrc[j] == r for j in todo):
                    at = t
                    break
            if at < 0:
                let r = locs[todo[0]] - L_XMM
                # movq rax, xmm r
                self.rr(102, 1, 3966, r, RAX)
                for j in todo:
                    if fsrc[j] == r:
                        fsrc[j] = F_IN_RAX
                continue
            let i = todo[at]
            let d = locs[i] - L_XMM
            if fsrc[i] == F_IN_RAX:
                # movq xmm d, rax
                self.rr(102, 1, 3950, d, RAX)
            elif fsrc[i] >= 0:
                if fsrc[i] != d:
                    self.rr(0, 0, 3880, d, fsrc[i])
            else:
                self.fld(args[i].fl, d, args[i].v)
            todo.pop(at)

    fn call_rt(ref self, name: str, args: [CArg]):
        let s = self.sym_ref(name)
        self.do_call(s, -1, args)

    # stores the result of a call (in rax / xmm0) to d
    fn store_ret(ref self, d: int):
        let k = self.vk[d]
        if k.is_float():
            self.fst(fl_of(k), d, 0)
        elif not k.is_wide():
            self.norm(RAX, k)
            self.st(RAX, d)

    # Does the call return a 128-bit value (through a hidden first argument)?
    # Without a destination the IR doesn't say, so this knows only module
    # functions (called directly or through a pointer that folds to one) and
    # runtime helpers.
    fn wide_call(self, x: Inst) -> bool:
        if x.d >= 0:
            return self.vk[x.d].is_wide()
        if x.op == Op.CallInd:
            return self.fold[x.a] == F_GLOBAL and self.o.syms[self.fval[x.a]].name in self.wide_ret
        if x.b == 1:
            return x.s in self.wide_rt
        return x.s in self.wide_ret

    # Reference counting is by far the most frequent runtime call, so it's
    # done inline and only freeing calls out. Same semantics as brine_rt.h:
    # a negative count is immortal, and lock inc / dec (when other threads
    # are running) are full barriers.
    fn inline_rc(ref self, x: Inst) -> bool:
        let n = x.s
        let retain = (
            n == "brine_str_retain"
            or n == "brine_arr_retain"
            or n == "brine_map_retain"
            or n == "brine_box_retain"
        )
        var free = ""
        if n == "brine_str_release":
            free = "brine_str_free"
        elif n == "brine_arr_release":
            free = "brine_arr_free"
        elif n == "brine_map_release":
            free = "brine_map_free"
        elif not retain and n != "brine_box_dec":
            return false
        let p = x.args[0]
        if free != "":
            # the call to free reads p again
            self.once[p] = false
        let m = self.addr(p, 0, RCX)
        if n == "brine_box_dec":
            self.mov_ri(RAX, 0)
        var skip = -1
        if (
            n == "brine_str_retain"
            or n == "brine_str_release"
            or n == "brine_box_retain"
            or n == "brine_box_dec"
        ):
            self.rm(0, 1, 131, CMP, m, 1)
            self.b(0)
            skip = self.j32(CC_L)
        # a plain inc / dec unless other threads may hold the value
        # (`brine_mt`, see brine_rt.h)
        let mt = self.sym_ref("brine_mt")
        var mm = mrip(mt, 0)
        if not self.direct(mt):
            # (p can be in r11: a call's arguments can be in any register)
            let t = RCX if self.fold[p] == F_NONE and self.reg[p] == R11 else R11
            self.ld_sym(t, mt)
            mm = mreg(t, 0)
        self.rm(0, 0, 131, CMP, mm, 1)
        self.b(0)
        let shared = self.j8(CC_NE)
        let k = 0 if retain else 1
        self.rm(0, 1, 255, k, m, 0)
        let done = self.jmp8()
        self.here8(shared)
        self.rm(240, 1, 255, k, m, 0)
        self.here8(done)
        if n == "brine_box_dec":
            self.setcc(CC_E, RAX)
        elif not retain:
            let live = self.j32(CC_NE)
            self.call_rt(free, [CArg(how=A_VAL, v=p, fl=0)])
            self.here32(live)
        if skip >= 0:
            self.here32(skip)
        if x.d >= 0:
            self.st(RAX, x.d)
        return true

    # brine_arr_push_in as brine_rt.h has it, inline: when the array is this
    # variable's alone and has room, the element is stored straight in;
    # otherwise brine_arr_push.
    fn inline_push(ref self, x: Inst) -> bool:
        let lp = x.args[0]
        let tp = x.args[1]
        let n = self.fval[x.args[2]]
        if self.fold[x.args[2]] != F_CONST or n <= 0 or n > 64:
            return false
        for v in [lp, tp]:
            let f = self.fold[v]
            if f != F_NONE and f != F_SLOT and f != F_GLOBAL:
                return false
        # both are read again by the call
        self.once[lp] = false
        self.once[tp] = false
        # pa and elem stay where they are (the call reads them); the rest
        # of the caller-saved registers are free, as for any call
        var er = -1
        var pr = -1
        if self.fold[tp] == F_NONE and self.reg[tp] >= 0:
            er = self.reg[tp]
            pr = self.use(RAX if er != RAX else RCX, lp)
        else:
            pr = self.use(RAX, lp)
            er = self.use(RCX if pr != RCX else RDX, tp)
        var free: [int] = []
        for r in [RAX, RCX, RDX, R8, R9, R10, R11]:
            if r != pr and r != er:
                free.push(r)
        let a = free[0]
        let c = free[1]
        let t = free[2]
        self.mov_rm(a, mreg(pr, 0))
        self.mov_rm(c, mreg(a, 8))
        self.alu_rm(CMP, c, mreg(a, 16))
        let full = self.j32(CC_GE)
        self.rm(0, 1, 131, CMP, mreg(a, 0), 1)
        self.b(1)
        let shared = self.j32(CC_NE)
        # len += 1, then c = data + old len * n
        self.rm(0, 1, 255, 0, mreg(a, 8), 0)
        if (n & (n - 1)) == 0:
            if n > 1:
                # shl c, log2 n
                self.rr(0, 1, 193, 4, c)
                self.b(n.trailing_zeros())
        else:
            # imul c, c, n
            self.rr(0, 1, 105, c, c)
            self.b32(n)
        self.alu_rm(ADD, c, mreg(a, 48))
        var i = 0
        while i + 8 <= n:
            self.mov_rm(t, mreg(er, i))
            self.mov_mr(mreg(c, i), t)
            i += 8
        if i + 4 <= n:
            self.rm(0, 0, 139, t, mreg(er, i), 0)
            self.store_sz(mreg(c, i), t, 4)
            i += 4
        if i + 2 <= n:
            self.rm(0, 0, 4023, t, mreg(er, i), 0)
            self.store_sz(mreg(c, i), t, 2)
            i += 2
        if i < n:
            self.rm(0, 0, 4022, t, mreg(er, i), 0)
            self.store_sz(mreg(c, i), t, 1)
        let done = self.jmp32()
        self.here32(full)
        self.here32(shared)
        self.call_rt("brine_arr_push", [CArg(how=A_VAL, v=lp, fl=0), CArg(how=A_VAL, v=tp, fl=0)])
        self.here32(done)
        return true

    fn ir_call(ref self, x: Inst):
        if x.op == Op.Call and x.b == 1 and self.inline_rc(x):
            return
        if x.op == Op.Call and x.b == 1 and x.s == "brine_arr_push_in" and self.inline_push(x):
            return
        if (
            x.op == Op.Call
            and x.b == 1
            and (x.s == "brine_f_sqrt" or x.s == "brine_f_sqrtf")
            and x.d >= 0
        ):
            # sqrtsd / sqrtss, into d's own register if it has one
            let fl = fl_of(self.vk[x.d])
            let r = max(self.freg[x.d], 0)
            if self.freg[x.args[0]] != r:
                self.xzero(r)
            self.fop(242 if fl == 1 else 243, 3921, r, x.args[0])
            self.fst(fl, x.d, r)
            return
        # (atomic_store and cpu_relax have no result)
        if (
            x.op == Op.Call
            and x.b == 1
            and (x.s.starts_with("brine_atomic_") or x.s == "brine_cpu_relax")
        ):
            self.atomic(x)
            return
        if x.op == Op.Call and x.b == 1 and x.d >= 0:
            if x.s == "brine_bytes_rev":
                self.bytes_rev(x, -1)
                return
            if x.s == "brine_bytes_rev0":
                self.bytes_rev0(x, -1)
                return
            if x.s == "brine_bytes_rotl":
                self.bytes_rotl(x)
                return
            if x.s == "brine_bytes_copy":
                self.bytes_copy(x)
                return
            if x.s == "brine_neg_i128":
                # neg rax; adc rdx, 0; neg rdx. The runtime (to panic) when
                # that overflows, and also for -(2^127 - n): rare, and right
                let ma = self.vm(x.args[0])
                self.mov_rm(RAX, ma)
                self.mov_rm(RDX, moff(ma, 8))
                self.rr(0, 1, 247, 3, RAX)
                self.alu_ri(ADC, RDX, 0)
                self.rr(0, 1, 247, 3, RDX)
                let j = self.j32(CC_O)
                self.st(RAX, x.d)
                self.mov_mr(moff(self.vm(x.d), 8), RDX)
                let e = self.jmp32()
                self.here32(j)
                self.call_rt(
                    "brine_x_neg_i128",
                    [
                        CArg(how=A_ADDR, v=x.d, fl=0),
                        CArg(how=A_ADDR, v=x.args[0], fl=0),
                        CArg(how=A_VAL, v=x.args[1], fl=0)
                    ]
                )
                self.here32(e)
                return
            if x.s == "brine_abs_i128" and x.d >= 0:
                # negated when negative, as above; the runtime panics for
                # the one that overflows
                let ma = self.vm(x.args[0])
                self.mov_rm(RAX, ma)
                self.mov_rm(RDX, moff(ma, 8))
                self.rr(0, 1, 133, RDX, RDX)
                let pos = self.j8(CC_S ^ 1)
                self.rr(0, 1, 247, 3, RAX)
                self.alu_ri(ADC, RDX, 0)
                self.rr(0, 1, 247, 3, RDX)
                let j = self.j32(CC_O)
                self.here8(pos)
                self.st(RAX, x.d)
                self.mov_mr(moff(self.vm(x.d), 8), RDX)
                let e = self.jmp32()
                self.here32(j)
                self.call_rt(
                    "brine_x_abs_i128",
                    [
                        CArg(how=A_ADDR, v=x.d, fl=0),
                        CArg(how=A_ADDR, v=x.args[0], fl=0),
                        CArg(how=A_VAL, v=x.args[1], fl=0)
                    ]
                )
                self.here32(e)
                return
            if x.s == "brine_bswap_u64":
                self.ld(RAX, x.args[0])
                self.bswap(RAX)
                self.st(RAX, x.d)
                return
            if x.s == "brine_umulh_u64" and x.d >= 0:
                # mul rcx: rdx:rax = rax * rcx
                self.ld(RAX, x.args[0])
                self.ld(RCX, x.args[1])
                self.rr(0, 1, 247, 4, RCX)
                self.st(RDX, x.d)
                return
            if x.s == "brine_divlu_u64" and x.d >= 0:
                # div rcx: rax = rdx:rax / rcx
                self.ld(RDX, x.args[0])
                self.ld(RAX, x.args[1])
                self.ld(RCX, x.args[2])
                self.rr(0, 1, 247, 6, RCX)
                self.st(RAX, x.d)
                return
            if x.s == "brine_clz_u64" or x.s == "brine_ctz_u64":
                # bsr / bsf leave ZF for 0, which counts 64: 127 ^ 63 for clz
                let clz = x.s == "brine_clz_u64"
                self.ld(RAX, x.args[0])
                # mov ecx, 127 / 64
                self.b(0xB9)
                self.b32(127 if clz else 64)
                # bsr / bsf rax, rax
                self.b(0x48)
                self.b(0x0F)
                self.b(0xBD if clz else 0xBC)
                self.b(0xC0)
                # cmovz rax, rcx
                self.b(0x48)
                self.b(0x0F)
                self.b(0x44)
                self.b(0xC1)
                if clz:
                    # xor rax, 63
                    self.b(0x48)
                    self.b(0x83)
                    self.b(0xF0)
                    self.b(0x3F)
                self.st(RAX, x.d)
                return
            if x.s == "brine_thread_ptr":
                # mov rax, fs:[0] (Linux: the thread pointer) or gs:[0x30]
                # (Windows: the thread's TEB)
                self.b(0x65 if self.win else 0x64)
                self.b(0x48)
                self.b(0x8B)
                self.b(0x04)
                self.b(0x25)
                self.b32(0x30 if self.win else 0)
                self.st(RAX, x.d)
                return
            if ra.int_div_rt(x.s) and not self.vk[x.d].is_wide():
                self.int_div(x)
                return
        var args: [CArg] = []
        let ind = x.op == Op.CallInd
        var name = x.s
        if not ind and x.b == 1:
            name = "brine_x_" + x.s[6:]
        if self.wide_call(x):
            if x.d >= 0:
                args.push(CArg(how=A_ADDR, v=x.d, fl=0))
            else:
                # an ignored result goes to the frame's scratch slot
                args.push(CArg(how=A_FRAME, v=self.scratch, fl=0))
        for a in x.args:
            let k = self.vk[a]
            if k.is_wide():
                args.push(CArg(how=A_ADDR, v=a, fl=0))
            else:
                args.push(CArg(how=A_VAL, v=a, fl=fl_of(k)))
        if not ind:
            let s = self.sym_ref(name)
            self.do_call(s, -1, args)
        elif self.fold[x.a] == F_GLOBAL:
            self.do_call(self.fval[x.a], -1, args)
        else:
            self.do_call(-1, x.a, args)
        if x.d >= 0:
            self.store_ret(x.d)

    # Jumps to a block that only jumps on (an edge's copies all went away in
    # register allocation) go straight to its target; the blocks nothing
    # jumps to any more are then left out.
    fn thread_jumps(ref self, nlabels: int):
        let n = len(self.code)
        var fwd = [-1] * nlabels
        for i, x in enumerate(self.code):
            if x.op == Op.Label:
                var j = i + 1
                while j < n and self.no_code(self.code[j]):
                    j += 1
                if j < n and self.code[j].op == Op.Jmp:
                    fwd[x.n] = self.code[j].n
        var refs = [0] * nlabels
        for i in 0..n:
            var x = self.code[i]
            if x.op == Op.Jmp or x.op == Op.Br or x.op == Op.BrNot:
                var hops = 0
                while fwd[x.n] >= 0 and fwd[x.n] != x.n and hops < 8:
                    x.n = fwd[x.n]
                    hops += 1
                self.code[i] = x
                refs[x.n] += 1
            elif x.op == Op.Switch:
                for l in x.args:
                    refs[l] += 1
        self.lrefs = refs
        self.dead = [false] * n
        var gone = false
        for i, x in enumerate(self.code):
            if x.op == Op.Label:
                gone = gone and refs[x.n] == 0
            self.dead[i] = gone
            if not gone and (
                x.op == Op.Jmp or x.op == Op.Ret or x.op == Op.Unreachable or x.op == Op.Switch
            ):
                gone = true

    # Does control fall from code[j] on to label l, with no code between?
    fn falls_to(self, j: int, l: int) -> bool:
        var k = j
        while k < len(self.code):
            let x = self.code[k]
            if x.op == Op.Label and x.n == l:
                return true
            if not self.dead[k] and not self.no_code(x):
                return false
            k += 1
        return false

    # [m] = [m] & ~(1 << b) (or | 1 << b) on 64 bits: the mask in rax, then
    # one and (or) to memory. Returns how many instructions that took, or 0.
    fn bit_rmw(ref self, i: int) -> int:
        let x = self.code[i]
        let k = self.vk[x.d]
        if (
            i + 3 >= len(self.code)
            or k.size() != 8
            or k.is_float()
            or k.is_wide()
            or self.nuse[x.d] != 1
            or self.fold[x.d] != F_NONE
        ):
            return 0
        let s = self.code[i + 1]
        if (
            s.op != Op.Shl
            or self.vk[s.d].size() != 8
            or self.fold[s.a] != F_CONST
            or self.fval[s.a] != 1
            or self.nuse[s.d] != 1
            or s.b == x.d
        ):
            return 0
        var m = s.d
        var j = i + 2
        var op = 9
        if self.code[j].op == Op.Not and self.code[j].a == m:
            if self.nuse[self.code[j].d] != 1 or self.fold[self.code[j].d] != F_NONE:
                return 0
            m = self.code[j].d
            j += 1
            op = 33
        if j + 1 >= len(self.code):
            return 0
        let y = self.code[j]
        if (
            y.op != (Op.And if op == 33 else Op.Or)
            or y.d < 0
            or self.nuse[y.d] != 1
            or self.fold[y.d] != F_NONE
            or y.a == y.b
            or not ((y.a == x.d and y.b == m) or (y.b == x.d and y.a == m))
        ):
            return 0
        let st = self.code[j + 1]
        if st.op != Op.Store or st.b != y.d or st.a != x.a or st.n != x.n:
            return 0
        self.ld(RCX, s.b)
        self.mov_ri(RAX, 1)
        self.shift_cl(SHL, RAX)
        if op == 33:
            # not rax
            self.rr(0, 1, 247, 2, RAX)
        self.rm(0, 1, op, RAX, self.addr2(x.a, x.n, RDX, RCX), 0)
        return j + 2 - i

    # branch on (w >> b) & 1 (compared with 0) on 64 bits: bt w, b, then jc
    # or jnc. Returns the next instruction's index, or 0.
    fn bit_test(ref self, i: int) -> int:
        let x = self.code[i]
        let k = self.vk[x.d]
        if (
            i + 3 >= len(self.code)
            or k.size() != 8
            or k.is_float()
            or k.is_wide()
            or self.nuse[x.d] != 1
            or self.fold[x.d] != F_NONE
            or self.fold[x.a] != F_NONE
        ):
            return 0
        let t = self.code[i + 1]
        if (
            t.op != Op.And
            or t.a != x.d
            or self.fold[t.b] != F_CONST
            or self.fval[t.b] != 1
            or self.nuse[t.d] != 1
            or self.fold[t.d] != F_NONE
        ):
            return 0
        let c = self.code[i + 2]
        if (
            (c.op != Op.Ne and c.op != Op.Eq)
            or c.a != t.d
            or self.fold[c.b] != F_CONST
            or self.fval[c.b] != 0
            or self.nuse[c.d] != 1
        ):
            return 0
        let br = self.code[i + 3]
        if (br.op != Op.Br and br.op != Op.BrNot) or br.a != c.d:
            return 0
        let rw = self.use(RAX, x.a)
        let rb = self.use(RCX, x.b)
        self.rr(0, 1, 4003, rb, rw)
        # `if bit: v += 1` (the branch skips just that add): adc v, 0
        var at = i + 4
        while (
            at < len(self.code)
            and self.no_code(self.code[at])
            and not (self.code[at].op == Op.Label and self.lrefs[self.code[at].n] > 0)
        ):
            at += 1
        let a = self.code[min(at, len(self.code) - 1)]
        if (
            at + 1 < len(self.code)
            and a.op == Op.Add
            and a.d >= 0
            and self.reg[a.d] >= 0
            and self.fold[a.a] == F_NONE
            and self.reg[a.a] == self.reg[a.d]
            and self.fold[a.b] == F_CONST
            and self.fval[a.b] == 1
            and not self.vk[a.d].is_wide()
            and self.vk[a.d].size() == 8
        ):
            var j = at + 1
            while (
                j < len(self.code)
                and self.no_code(self.code[j])
                and not (
                    self.code[j].op == Op.Label
                    and (self.code[j].n == br.n or self.lrefs[self.code[j].n] > 0)
                )
            ):
                j += 1
            if j < len(self.code) and self.code[j].op == Op.Label and self.code[j].n == br.n:
                if (c.op == Op.Ne) == (br.op == Op.BrNot):
                    # adc r, 0
                    self.rr(0, 1, 131, 2, self.reg[a.d])
                    self.b(0)
                else:
                    # sbb r, -1
                    self.rr(0, 1, 131, 3, self.reg[a.d])
                    self.b(255)
                return j
        return self.cond_jump(i + 3, CC_B if c.op == Op.Ne else CC_AE, br.op == Op.Br, br.n)

    # brine_arr_unique(p) only when the array *p is shared (its count isn't
    # 1), as br_arr_mine in brine_rt.h does
    fn arr_unique(ref self, x: Inst):
        let p = x.args[0]
        # the call reads p again
        self.once[p] = false
        self.mov_rm(RAX, self.addr(p, 0, RCX))
        self.rm(0, 1, 131, CMP, mreg(RAX, 0), 1)
        self.b(1)
        let skip = self.j32(CC_E)
        self.ir_call(x)
        self.here32(skip)

    # stack argument slots a call needs
    fn call_stack(self, x: Inst) -> int:
        var fls: [int] = []
        if self.wide_call(x):
            fls.push(0)
        for a in x.args:
            fls.push(fl_of(self.vk[a]))
        var n = 0
        for l in self.arg_locs(fls):
            if l >= L_STACK:
                n += 1
        return n

    # ------------------------------------------------------------ functions
    fn func(ref self, f: Func):
        let nv = len(f.vk)
        self.code = f.code
        self.vk = f.vk
        self.nparams = f.nparams
        self.has_ret = f.has_ret
        self.ret = f.ret
        self.fold = [0] * nv
        self.fval = [0] * nv
        self.home = [0] * nv
        self.nuse = [0] * nv
        self.lpos = [-1] * f.nlabels
        self.jat = []
        self.jlab = []
        self.tat = []
        self.tlab = []
        self.tbase = []
        self.stubs = []
        var ndef = [0] * nv
        var dpos = [0] * nv
        for i in 0..f.nparams:
            ndef[i] = 1
        let ncode = len(f.code)
        for i in 0..ncode:
            let x = f.code[i]
            if x.d >= 0:
                ndef[x.d] += 1
                dpos[x.d] = i
            if x.a >= 0 and x.a < nv:
                self.nuse[x.a] += 1
            if x.b >= 0 and x.b < nv:
                self.nuse[x.b] += 1
            if x.c >= 0 and x.c < nv:
                self.nuse[x.c] += 1
            if x.op == Op.Call or x.op == Op.CallInd:
                for a in x.args:
                    self.nuse[a] += 1
        self.once = [false] * nv
        # (not in debug builds: the value would only be in a register)
        let fold_once = not self.dbg
        for v in f.nparams..nv:
            let k = f.vk[v]
            self.once[v] = fold_once and self.nuse[v] == 1 and not k.is_float() and not k.is_wide()
        # the panic stubs read these again
        for x in f.code:
            if x.op == Op.IdxChk:
                self.once[x.a] = false
                self.once[x.b] = false
                self.once[x.c] = false
            elif x.op == Op.AddO or x.op == Op.SubO or x.op == Op.MulO:
                self.once[x.c] = false
            elif x.op == Op.Call and x.b == 1 and slow_call(x.s):
                # so does the runtime call the inline code falls back to
                for a in x.args:
                    self.once[a] = false
        for v in f.nparams..nv:
            if ndef[v] == 1:
                let x = f.code[dpos[v]]
                let k = f.vk[v]
                if x.op == Op.Const and not k.is_float() and not k.is_wide():
                    self.fold[v] = F_CONST
                    self.fval[v] = canon(x.n, k)
                elif x.op == Op.SlotAddr:
                    self.fold[v] = F_SLOT
                    self.fval[v] = x.a
                elif x.op == Op.Global:
                    self.fold[v] = F_GLOBAL
                    self.fval[v] = self.sym_ref(x.s)
                elif x.op == Op.FConst and not self.dbg:
                    self.fold[v] = F_FCONST
                    self.fval[v] = self.fconst_sym(x.n, k)
        if not self.dbg:
            self.fold_elems(f, ndef)
        # (after the folding: it tells which indirect calls return 128 bits)
        var nstack = 0
        for x in f.code:
            if x.op == Op.Call or x.op == Op.CallInd:
                nstack = max(nstack, self.call_stack(x))
        self.freg = [-1] * nv
        self.fsaved = []
        self.fsave_at = []
        self.keep = []
        if self.dbg:
            self.reg = [-1] * nv
            self.saved = []
        else:
            self.alloc(f, ndef)
        # incoming parameters (the hidden 128-bit result pointer first)
        let hidden = f.has_ret and f.ret.is_wide()
        var fls: [int] = []
        if hidden:
            fls.push(0)
        for i in 0..f.nparams:
            let k = f.vk[i]
            fls.push(0 if k.is_wide() else fl_of(k))
        self.ploc = self.arg_locs(fls)
        let h = 1 if hidden else 0
        # frame layout: rbp-relative homes below the saved registers, padded to
        # an even number (see the prologue)
        let nsaved = len(self.saved)
        let nfp = nsaved + nsaved % 2
        var off = 8 * nfp
        var has_home = [false] * nv
        self.retp = 0
        if hidden:
            if self.win:
                self.retp = 16
            else:
                off += 8
                self.retp = -off
        for i in 0..f.nparams:
            let l = self.ploc[i + h]
            if f.vk[i].is_wide():
                continue
            if l >= L_STACK:
                self.home[i] = 16 + self.stack_off(l - L_STACK)
                has_home[i] = true
            elif self.win:
                self.home[i] = 16 + 8 * (i + h)
                has_home[i] = true
        # (a register saved around a call goes to its vreg's home)
        var kept = [false] * nv
        for ks in self.keep:
            for v in ks:
                kept[v] = true
        for v in 0..nv:
            if (
                has_home[v]
                or self.fold[v] != F_NONE
                or (self.reg[v] >= 0 and not kept[v])
                or (ndef[v] == 0 and self.nuse[v] == 0)
            ):
                continue
            if f.vk[v].is_wide():
                off = align_up(off + 16, 16)
            else:
                off += 8
            self.home[v] = -off
        var outgoing = 8 * nstack
        if self.win:
            outgoing += 32
        # slots aligned to more than 16 bytes go above the outgoing arguments,
        # rsp-relative, and the prologue aligns rsp to the largest alignment
        var high = outgoing
        var realign = 16
        self.slot_off = []
        self.slot_base = []
        for s in f.slots:
            let a = 1 << log2(max(s.align, 1))
            if a <= 16:
                off = align_up(off + s.size, a)
                self.slot_off.push(-off)
                self.slot_base.push(RBP)
            else:
                high = align_up(high, a)
                self.slot_off.push(high)
                self.slot_base.push(RSP)
                high += s.size
                realign = max(realign, a)
        # the callee-saved xmm registers the body uses (Windows)
        for _ in self.fsaved:
            off = align_up(off + 16, 16)
            self.fsave_at.push(-off)
        off = align_up(off + 16, 16)
        self.scratch = -off
        let frame = align_up(off + high, 16)
        # aligning rsp (rounding it up) takes up to realign - 16 more bytes
        let grow = frame - 8 * nfp + realign - 16
        # prologue
        while len(self.o.text) % 16 != 0:
            self.o.text.push(204)
        self.sym_def(f.name, SEC_TEXT, self.pos(), f.public or f.export, true)
        self.u = Unw(
            start=self.pos(),
            pushes=[],
            pad=-1,
            fp=0,
            alloc=0,
            grow=grow,
            pro_end=0,
            epis=[]
        )
        # Push rbp and the saved registers, then point rbp at the saved rbp.
        # With rbp set last and 16-byte aligned, the Windows unwinder finds the
        # saved registers from rbp alone, whatever the rest does to rsp.
        self.b(85)
        for r in self.saved:
            self.push_pop(80, r)
            self.u.pushes.push(self.pos())
        if nfp > nsaved:
            self.alu_ri(SUB, RSP, 8)
            self.u.pad = self.pos()
        if nfp == 0:
            self.mov_rr(RBP, RSP)
        else:
            self.lea(RBP, mreg(RSP, 8 * nfp))
        self.u.fp = self.pos()
        var rest = grow
        if grow >= 4096:
            # touch each page in order (the Windows guard page; stack clash on Linux)
            self.mov_ri(RAX, grow / 4096)
            let top = self.pos()
            self.alu_ri(SUB, RSP, 4096)
            self.rm(0, 0, 133, RSP, mreg(RSP, 0), 0)
            # dec eax; jnz top
            self.b(255)
            self.b(200)
            self.b(117)
            self.b(top - self.pos() - 1)
            rest = grow % 4096
        if rest > 0:
            self.alu_ri(SUB, RSP, rest)
        self.u.alloc = self.pos()
        if realign > 16:
            # round rsp up to a multiple of realign, inside the allocation
            self.alu_ri(ADD, RSP, realign - 16)
            self.alu_ri(AND, RSP, -realign)
        self.u.pro_end = self.pos()
        # Saved after the prologue, with no unwind codes: they would need
        # offsets from the frame base, which is above this allocation. Unwinding
        # through brine code only happens in debuggers and profilers, which
        # don't need these registers back.
        for i, x in enumerate(self.fsaved):
            self.xsave(mrb(self.fsave_at[i]), x)
        self.store_params(f)
        # body
        self.ipos = [-1] * (ncode + 1)
        self.rows = []
        if self.dbg and f.dline > 0 and not f.dfile.starts_with("<"):
            let fi = self.dw.file(f.dfile)
            self.rows.push(DRow(pc=self.u.start, file=fi, line=f.dline))
        self.thread_jumps(f.nlabels)
        var i = 0
        while i < ncode:
            self.cur = i
            self.ipos[i] = self.pos()
            if self.dead[i]:
                i += 1
            else:
                i = self.inst(i)
        self.ipos[ncode] = self.pos()
        if ncode == 0 or not (
            f.code[ncode - 1].op == Op.Ret
            or f.code[ncode - 1].op == Op.Jmp
            or f.code[ncode - 1].op == Op.Unreachable
        ):
            # falling off the end returns
            self.epilogue()
        # cold stubs (the operands go through scratch registers first, since
        # they may be in argument registers; nothing is kept around the calls)
        self.cur = -1
        for s in self.stubs:
            set32(ref self.o.text, s.at, self.pos() - (s.at + 4))
            self.cpos = -1
            if s.kind == S_IDX:
                self.ld(RAX, s.a)
                # (b or c may be in r10 or r11 themselves)
                let bi = self.fold[s.b] == F_NONE and self.reg[s.b] == R11
                let cj = self.fold[s.c] == F_NONE and self.reg[s.c] == R10
                if bi and cj:
                    # xchg r10, r11
                    self.rr(0, 1, 135, R10, R11)
                elif cj:
                    self.ld(R11, s.c)
                    self.ld(R10, s.b)
                else:
                    self.ld(R10, s.b)
                    self.ld(R11, s.c)
                self.call_rt(
                    "brine_panic_idx",
                    [
                        CArg(how=A_REG, v=RAX, fl=0),
                        CArg(how=A_REG, v=R10, fl=0),
                        CArg(how=A_REG, v=R11, fl=0)
                    ]
                )
            else:
                let msg = self.ovf_sym(s.kind)
                self.ld(R11, s.c)
                self.call_rt(
                    "brine_panic_ovf",
                    [CArg(how=A_SYM, v=msg, fl=0), CArg(how=A_REG, v=R11, fl=0)]
                )
        for j in 0..len(self.jat):
            set32(ref self.o.text, self.jat[j], self.lpos[self.jlab[j]] - (self.jat[j] + 4))
        for j in 0..len(self.tat):
            set32(ref self.o.text, self.tat[j], self.lpos[self.tlab[j]] - self.tbase[j])
        if self.win:
            self.unwind_coff()
        else:
            self.unwind_elf()
        if self.dbg:
            self.debug_func(f)

    # push r (op 80) / pop r (op 88)
    fn push_pop(ref self, op: int, r: int):
        if r >= 8:
            self.b(65)
        self.b(op + (r & 7))

    fn epilogue(ref self):
        for i, x in enumerate(self.fsaved):
            self.xrestore(x, mrb(self.fsave_at[i]))
        if len(self.saved) == 0:
            # leave
            self.b(201)
        else:
            self.lea(RSP, mrb(-8 * len(self.saved)))
            var j = len(self.saved) - 1
            while j >= 0:
                self.push_pop(88, self.saved[j])
                j -= 1
            self.b(93)
        self.u.epis.push(self.pos())
        self.b(195)

    # The symbol of 16 bytes of .rodata: lo, then hi.
    fn vconst_sym(ref self, lo: int, hi: int) -> int:
        let key = f"{lo},{hi}"
        match self.vpool.get(key):
            case Some(s):
                return s
            case None:
                pass
        while len(self.o.rodata) % 16 != 0:
            self.o.rodata.push(0)
        self.o.rodata_align = max(self.o.rodata_align, 16)
        let off = len(self.o.rodata)
        put64(ref self.o.rodata, lo)
        put64(ref self.o.rodata, hi)
        let s = self.sym_def(f"__brx_v{len(self.vpool)}", SEC_RODATA, off, false, false)
        self.vpool[key] = s
        return s

    # The symbol of 64 bytes of .rodata: the 8 integers a, a + b, a + 2b, ...
    fn zconst_sym(ref self, a: int, b: int) -> int:
        let key = f"z{a},{b}"
        match self.vpool.get(key):
            case Some(s):
                return s
            case None:
                pass
        while len(self.o.rodata) % 64 != 0:
            self.o.rodata.push(0)
        self.o.rodata_align = max(self.o.rodata_align, 64)
        let off = len(self.o.rodata)
        for i in 0..8:
            put64(ref self.o.rodata, a + b * i)
        let s = self.sym_def(f"__brx_v{len(self.vpool)}", SEC_RODATA, off, false, false)
        self.vpool[key] = s
        return s

    # The symbol of 64 bytes of .rodata: the 8 integers ls.
    fn wconst_sym(ref self, ls: [int]) -> int:
        var key = "w"
        for x in ls:
            key += f"{x},"
        match self.vpool.get(key):
            case Some(s):
                return s
            case None:
                pass
        while len(self.o.rodata) % 64 != 0:
            self.o.rodata.push(0)
        self.o.rodata_align = max(self.o.rodata_align, 64)
        let off = len(self.o.rodata)
        for x in ls:
            put64(ref self.o.rodata, x)
        let s = self.sym_def(f"__brx_v{len(self.vpool)}", SEC_RODATA, off, false, false)
        self.vpool[key] = s
        return s

    # ------------------------------------------------------------ kernels
    # A vector kernel (xkern.br): its array pointers stay in their argument
    # registers, its xmm registers are the ones xkern.br chose. The frame is
    # rbp-based like a function's, with no general registers saved, then the
    # callee-saved xmm registers it writes (Windows) and its 16-byte slots.
    # One with an AVX-512 version is that, under the kernel's name, and the
    # SSE2 version it jumps to when the CPU lacks AVX-512: each saves only
    # the registers it writes.
    fn kernel(ref self, k: KFunc):
        if len(k.wide) == 0:
            self.kernel_fn(k, k.name, false, -1)
            return
        let sse = self.kernel_fn(k, k.name + "_sse2", false, -1)
        self.kernel_fn(k, k.name, true, sse)

    # One version of a kernel, at the position it returns: `wide` the
    # AVX-512 one, which jumps to `sse` on other CPUs.
    fn kernel_fn(ref self, k: KFunc, name: str, wide: bool, sse: int) -> int:
        let gp = [RCX, RDX, R8, R9] if self.win else [RDI, RSI, RDX, RCX]
        self.saved = []
        self.fsaved = []
        self.fsave_at = []
        var regs = k.regs
        if wide:
            regs = []
            for o in k.wide:
                if o.op != KW_ST and o.op != KW_STH and o.op != KW_SPILL and o.a not in regs:
                    regs.push(o.a)
        if self.win:
            for r in regs:
                if r >= 6 and r < 16:
                    self.fsaved.push(r)
        var off = 0
        for _ in self.fsaved:
            off += 16
            self.fsave_at.push(-off)
        let slots = off
        off += 64 * k.wslots if wide else 16 * k.nslots
        if k.loop or k.lanes or wide:
            # rbx, rcx and rdx around cpuid, then 128 bytes that hold 64
            # aligned ones for the lanes of sums
            off += 32 + 128
        let grow = align_up(off, 16)
        while len(self.o.text) % 16 != 0:
            self.o.text.push(204)
        let start = self.pos()
        self.sym_def(name, SEC_TEXT, start, false, true)
        self.u = Unw(
            start=self.pos(),
            pushes=[],
            pad=-1,
            fp=0,
            alloc=0,
            grow=grow,
            pro_end=0,
            epis=[]
        )
        self.b(85)
        self.mov_rr(RBP, RSP)
        self.u.fp = self.pos()
        if grow > 0:
            self.alu_ri(SUB, RSP, grow)
        self.u.alloc = self.pos()
        self.u.pro_end = self.pos()
        for i, x in enumerate(self.fsaved):
            self.xsave(mrb(self.fsave_at[i]), x)
        if k.loop:
            self.kernel_loop(k, gp, slots)
        elif k.lanes:
            self.kernel_lanes(k, gp[0], slots)
        elif wide:
            self.cpu_level(slots)
            self.alu_ri(CMP, RAX, 7)
            let have = self.j32(CC_AE)
            # no AVX-512: the SSE2 version, with this frame gone
            for i, x in enumerate(self.fsaved):
                self.xrestore(x, mrb(self.fsave_at[i]))
            # leave; jmp sse
            self.b(201)
            self.b(233)
            self.b32(sse - (self.pos() + 4))
            self.here32(have)
            for o in k.wide:
                self.kw(o, gp, slots, k)
            # vzeroupper
            self.b(197)
            self.b(248)
            self.b(119)
        else:
            for o in k.ops:
                self.kop(o, gp, slots)
        self.epilogue()
        if self.win:
            self.unwind_coff()
        else:
            self.unwind_elf()
        return start

    # A loop kernel (vloop.br). Its parameter, the block, stays in gp[0]; the
    # arrays' addresses go in `arr` registers. It runs the first of its paths
    # the CPU can.
    fn kernel_loop(ref self, k: KFunc, gp: [int], slots: int):
        let p = gp[0]
        let arr = [RDX, R8, R9] if self.win else [RSI, RDX, R8]
        self.rr(0, 0, 49, RAX, RAX)
        for i in 0..k.narr:
            self.mov_rm(arr[i], mreg(p, 8 * i))
        var outs: [int] = []
        for o in k.ops:
            # KO_CHK: out when 0 < (b + n) - a < 8m: r11 = that - 1, unsigned
            self.lea(R11, mreg(arr[o.b], o.n - 1))
            self.alu_rr(SUB, R11, arr[o.a])
            self.alu_ri(CMP, R11, 8 * o.m - 2)
            outs.push(self.j32(CC_BE))
        let last = k.paths[len(k.paths) - 1]
        if k.paths[0].w > 2:
            self.cpu_level(slots)
        for i, t in enumerate(k.paths):
            var next = -1
            if t.w > 2:
                self.alu_ri(CMP, RAX, 7 if t.w == 8 else 3)
                next = self.j32(CC_B)
            self.path(t, p, arr, k.narr, -slots - 160)
            if i < len(k.paths) - 1 or next >= 0:
                self.b(233)
                self.b32(0)
                outs.push(self.pos() - 4)
            if next >= 0:
                self.here32(next)
        if last.w > 2:
            # no path for this CPU: none done
            self.rr(0, 0, 49, RAX, RAX)
        for at in outs:
            self.here32(at)

    # One path: rax counts the elements done, r10 is the count rounded down
    # to a multiple of the lanes, r11 points at 64 aligned bytes for sums'
    # lanes (in the 128 at rbp + `scratch`).
    fn path(ref self, t: KPath, p: int, arr: [int], narr: int, scratch: int):
        self.rr(0, 0, 49, RAX, RAX)
        if any(o.op == KV_RED for o in t.body):
            self.lea(R11, mrb(scratch + 64))
            self.alu_ri(AND, R11, -64)
        for o in t.pre:
            self.kv(o, t.w, p, arr)
        self.mov_rm(R10, mreg(p, 8 * narr))
        self.alu_ri(AND, R10, -t.w)
        let skip = self.j32(CC_LE)
        let top = self.pos()
        for o in t.body:
            self.kv(o, t.w, p, arr)
        self.alu_ri(ADD, RAX, t.w)
        self.alu_rr(CMP, RAX, R10)
        # jl top
        self.b(15)
        self.b(128 + CC_L)
        self.b32(top - (self.pos() + 4))
        self.here32(skip)
        for o in t.post:
            self.kv(o, t.w, p, arr)
        if t.w > 2:
            # vzeroupper, so SSE code after runs at full speed
            self.b(197)
            self.b(248)
            self.b(119)

    # One operation of a path w lanes wide: SSE2 (w = 2), AVX2 (VEX, 4) or
    # AVX-512 (EVEX, 8). p holds the block.
    fn kv(ref self, o: KOp, w: int, p: int, arr: [int]):
        match o.op:
            case KV_BCF:
                let m = mreg(p, 8 * o.n)
                if w == 2:
                    # movsd, unpcklpd
                    self.rm(PFX_SD, 0, 3856, o.a, m, 0)
                    self.rr(PFX_PD, 0, 3860, o.a, o.a)
                elif w == 4:
                    # vbroadcastsd
                    self.vex_m(2, 1, 1, 25, o.a, 0, m)
                else:
                    self.evex_m(2, 1, 1, 2, 25, o.a, 0, m, 8)
            case KV_BCI:
                # vpbroadcastq
                self.evex_m(2, 1, 1, 2, 89, o.a, 0, mreg(p, 8 * o.n), 8)
            case KV_J:
                # j in every lane, plus 0, 1, ... (vpaddq)
                self.evex_m(2, 1, 1, 2, 89, o.a, 0, mreg(p, 8 * o.n), 8)
                self.evex_m(1, 1, 1, 2, 212, o.a, o.a, mrip(self.zconst_sym(0, 1), 0), 64)
            case KV_JINC:
                self.evex_m(1, 1, 1, 2, 212, o.a, o.a, mrip(self.zconst_sym(8, 0), 0), 64)
            case KV_LD | KV_ST:
                let m = Mem(base=arr[o.b], index=RAX, scale=8, disp=o.n, sym=-1)
                # movupd / vmovupd
                let op = 16 if o.op == KV_LD else 17
                if w == 2:
                    self.rm(PFX_PD, 0, 3840 + op, o.a, m, 0)
                elif w == 4:
                    self.vex_m(1, 1, 1, op, o.a, 0, m)
                else:
                    self.evex_m(1, 1, 1, 2, op, o.a, 0, m, 64)
            case KV_MOV:
                # movapd
                self.rr(PFX_PD, 0, 3880, o.a, o.b)
            case KV_FOP:
                if w == 2:
                    self.rr(PFX_PD, 0, 3840 + o.n, o.a, o.m)
                elif w == 4:
                    self.vex_r(1, 1, 1, o.n, o.a, o.b, o.m)
                else:
                    self.evex_r(1, 1, 1, 2, o.n, o.a, o.b, o.m)
            case KV_IOP:
                self.evex_r(o.n >> 8, 1, 1, 2, o.n & 255, o.a, o.b, o.m)
            case KV_SHI:
                # vpsraq / vpsllq a, b, m: the operation in modrm.reg, a in vvvv
                self.evex_r(1, 1, 1, 2, 114 if o.n == 4 else 115, o.n, o.a, o.b)
                self.b(o.m)
            case KV_CVT:
                # vcvtqq2pd
                self.evex_r(1, 2, 1, 2, 230, o.a, 0, o.b)
            case KV_RLD | KV_RST:
                let m = mreg(p, 8 * o.n)
                # movsd / vmovsd
                let op = 16 if o.op == KV_RLD else 17
                if w == 2:
                    self.rm(PFX_SD, 0, 3840 + op, o.a, m, 0)
                else:
                    self.vex_m(1, 3, 0, op, o.a, 0, m)
            case _:
                # KV_RED: the lanes to [r11], then into a one at a time, in order
                let sc = mreg(R11, 0)
                if w == 2:
                    self.rm(PFX_PD, 0, 3857, o.b, sc, 0)
                elif w == 4:
                    self.vex_m(1, 1, 1, 17, o.b, 0, sc)
                else:
                    self.evex_m(1, 1, 1, 2, 17, o.b, 0, sc, 64)
                for i in 0..w:
                    if w == 2:
                        self.rm(PFX_SD, 0, 3840 + o.n, o.a, mreg(R11, 8 * i), 0)
                    else:
                        self.vex_m(1, 3, 0, o.n, o.a, o.a, mreg(R11, 8 * i))

    # A lane loop kernel (vlane.br), with AVX2; p holds the block.
    fn kernel_lanes(ref self, k: KFunc, p: int, slots: int):
        let t = k.paths[0]
        self.cpu_level(slots)
        self.alu_ri(CMP, RAX, 3)
        let none = self.j32(CC_B)
        for o in t.pre:
            self.kl(o, p)
        let top = self.pos()
        var outs: [int] = []
        for o in t.body:
            if o.op == KL_ANY:
                # vmovmskpd eax, a; test eax, eax; jz out
                self.vex_r(1, 1, 1, 80, RAX, 0, o.a)
                self.rr(0, 0, 133, RAX, RAX)
                outs.push(self.j32(CC_E))
            else:
                self.kl(o, p)
        # jmp top
        self.b(233)
        self.b32(top - (self.pos() + 4))
        for at in outs:
            self.here32(at)
        for o in t.post:
            self.kl(o, p)
        # vzeroupper
        self.b(197)
        self.b(248)
        self.b(119)
        self.here32(none)

    # One operation of a lane loop kernel: 256-bit VEX, 66 prefix.
    fn kl(ref self, o: KOp, p: int):
        match o.op:
            case KL_LD | KL_ST:
                # vmovupd
                self.vex_m(1, 1, 1, 16 if o.op == KL_LD else 17, o.a, 0, mreg(p, 8 * o.n))
            case KL_MOV:
                # vmovapd
                self.vex_r(1, 1, 1, 40, o.a, 0, o.b)
            case KL_NOT:
                # vpxor with all ones
                self.vex_m(1, 1, 1, 239, o.a, o.b, mrip(self.zconst_sym(-1, 0), 0))
            case KL_OP:
                self.vex_rm(o.n >> 8, o.n & 255, o.a, o.b, o.m, p)
            case KL_CMP:
                # vcmppd a, b, m, n
                self.vex_rm(1, 194, o.a, o.b, o.m, p)
                self.b(o.n)
            case _:
                # KL_SEL: vblendvpd a, b, m, n
                self.vex_rm(3, 75, o.a, o.b, o.m, p)
                self.b(o.n << 4)

    # VEX.256.66 op a, b, m, with m a ymm register, or 16 + the word of the
    # block at p it is
    fn vex_rm(ref self, map: int, op: int, a: int, b: int, m: int, p: int):
        if m >= 16:
            self.vex_m(map, 1, 1, op, a, b, mreg(p, 8 * (m - 16)))
        else:
            self.vex_r(map, 1, 1, op, a, b, m)

    # rax = the CPU level (see cpu_sym), found with cpuid the first time.
    # rbx, rcx and rdx are kept in the 24 bytes below `slots`.
    fn cpu_level(ref self, slots: int):
        if self.cpu_sym < 0:
            let off = len(self.o.data)
            self.o.data.push(0)
            self.cpu_sym = self.sym_def("__brx_cpu", SEC_DATA, off, false, false)
        let lvl = mrip(self.cpu_sym, 0)
        # movzx eax, byte [lvl]; test eax, eax
        self.rm(0, 0, 4022, RAX, lvl, 0)
        self.rr(0, 0, 133, RAX, RAX)
        let have = self.j32(CC_NE)
        let keep = [RBX, RCX, RDX]
        for i, r in enumerate(keep):
            self.mov_mr(mrb(-slots - 8 * (i + 1)), r)
        self.mov_ri(R10, 1)
        var no: [int] = []
        # AVX and OSXSAVE (cpuid 1, ecx bits 28 and 27)
        self.mov_ri(RAX, 1)
        self.cpuid()
        self.mov_ri(R11, 402653184)
        self.alu_rr(AND, RCX, R11)
        self.alu_rr(CMP, RCX, R11)
        no.push(self.j32(CC_NE))
        # the OS saves the xmm and ymm registers (xgetbv 0, bits 1 and 2)
        self.rr(0, 0, 49, RCX, RCX)
        self.b(15)
        self.b(1)
        self.b(208)
        self.mov_rr(R11, RAX)
        self.alu_ri(AND, RAX, 6)
        self.alu_ri(CMP, RAX, 6)
        no.push(self.j32(CC_NE))
        # AVX2 (cpuid 7, ebx bit 5)
        self.mov_ri(RAX, 7)
        self.rr(0, 0, 49, RCX, RCX)
        self.cpuid()
        self.mov_rr(RAX, RBX)
        self.alu_ri(AND, RAX, 32)
        no.push(self.j32(CC_E))
        self.mov_ri(R10, 3)
        # AVX-512 F and DQ (ebx bits 16 and 17), and the OS saves the mask
        # and upper zmm registers (xgetbv bits 5, 6 and 7)
        self.alu_ri(AND, RBX, 196608)
        self.alu_ri(CMP, RBX, 196608)
        no.push(self.j32(CC_NE))
        self.alu_ri(AND, R11, 224)
        self.alu_ri(CMP, R11, 224)
        no.push(self.j32(CC_NE))
        self.mov_ri(R10, 7)
        for at in no:
            self.here32(at)
        # mov [lvl], r10b
        self.rm8(136, R10, lvl, 0)
        for i, r in enumerate(keep):
            self.mov_rm(r, mrb(-slots - 8 * (i + 1)))
        self.mov_rr(RAX, R10)
        self.here32(have)

    fn cpuid(ref self):
        self.b(15)
        self.b(162)

    # One kernel operation. Stack slots start `slots` bytes below rbp.
    fn kop(ref self, o: KOp, gp: [int], slots: int):
        var m = mrb(0)
        if o.op == KO_LD or o.op == KO_LDP or o.op == KO_LDH or o.op == KO_ST or o.op == KO_STH:
            m = mreg(gp[o.b], o.n)
        match o.op:
            case KO_MOV:
                # movapd
                self.rr(PFX_PD, 0, 3880, o.a, o.b)
            case KO_LD:
                # movsd
                self.rm(PFX_SD, 0, 3856, o.a, m, 0)
            case KO_LDP:
                # movupd
                self.rm(PFX_PD, 0, 3856, o.a, m, 0)
            case KO_LDH:
                # movhpd xmm, m64
                self.rm(PFX_PD, 0, 3862, o.a, m, 0)
            case KO_ST:
                self.rm(PFX_SD, 0, 3857, o.a, m, 0)
            case KO_STH:
                # movhpd m64, xmm
                self.rm(PFX_PD, 0, 3863, o.a, m, 0)
            case KO_OP | KO_SQRT:
                self.rr(o.m, 0, o.n, o.a, o.b)
            case KO_SHUF:
                # shufpd
                self.rr(PFX_PD, 0, 4038, o.a, o.b)
                self.b(o.n)
            case KO_CONST:
                self.rm(PFX_SD, 0, 3856, o.a, mrip(self.fconst_sym(o.n, K.F64), 0), 0)
            case KO_CONST2:
                self.rm(PFX_PD, 0, 3856, o.a, mrip(self.vconst_sym(o.n, o.m), 0), 0)
            case KO_SPILL:
                # movapd m128, xmm
                self.rm(PFX_PD, 0, 3881, o.a, mrb(-slots - 16 * (o.n + 1)), 0)
            case KO_FILL:
                self.rm(PFX_PD, 0, 3880, o.a, mrb(-slots - 16 * (o.n + 1)), 0)
            case _:
                # KO_ARG
                self.rm(PFX_SD, 0, 3856, o.a, mrb(o.n), 0)

    # One operation of a kernel's AVX-512 version (xwide.br): EVEX, packed
    # operations k.wl long (1 ymm, 2 zmm). Stack slots start `slots` bytes
    # below rbp.
    fn kw(ref self, o: KOp, gp: [int], slots: int, k: KFunc):
        let l = k.wl
        let vn = 16 << l
        var m = mrb(0)
        if o.op <= KW_LDV or o.op == KW_ST or o.op == KW_STH:
            m = mreg(gp[o.b], o.n)
        match o.op:
            case KW_LD:
                # vmovsd xmm, m64
                self.evex_m(1, 3, 1, 0, 16, o.a, 0, m, 8)
            case KW_LDH:
                # vmovhpd xmm, xmm, m64
                self.evex_m(1, 1, 1, 0, 22, o.a, o.a, m, 8)
            case KW_LDD:
                # vmovddup xmm, m64
                self.evex_m(1, 3, 1, 0, 18, o.a, 0, m, 8)
            case KW_LDP:
                # vmovupd xmm, m128
                self.evex_m(1, 1, 1, 0, 16, o.a, 0, m, 16)
            case KW_LDV:
                self.evex_m(1, 1, 1, l, 16, o.a, 0, m, vn)
            case KW_INS:
                if o.m == 1:
                    # vinsertf32x4 ymm, ymm, xmm, 1
                    self.evex_r(3, 1, 0, 1, 24, o.a, o.a, o.b)
                else:
                    # vinsertf64x4 zmm, zmm, ymm, 1
                    self.evex_r(3, 1, 1, 2, 26, o.a, o.a, o.b)
                self.b(1)
            case KW_BC:
                # vbroadcastsd
                self.evex_r(2, 1, 1, l, 25, o.a, 0, o.b)
            case KW_BCA:
                self.evex_m(2, 1, 1, l, 25, o.a, 0, mrb(o.n), 8)
            case KW_OP:
                let op = o.m & 255
                let scalar = o.m >= 256
                # scalar ops are the F2 ones, on the low lane; xor has only
                # a packed one (on all of xmm)
                let pp = 3 if scalar and op != 87 else 1
                let ll = 0 if scalar else l
                let n = 8 if scalar and op != 87 else (16 if scalar else vn)
                if o.n >= 1000:
                    let ks = mrip(self.wconst_sym(k.wk[o.n - 1000]), 0)
                    self.evex_m(1, pp, 1, ll, op, o.a, o.b, ks, n)
                else:
                    self.evex_r(1, pp, 1, ll, op, o.a, o.b, o.n)
            case KW_SQRT:
                if o.m == 1:
                    # vsqrtsd a, b, b
                    self.evex_r(1, 3, 1, 0, 81, o.a, o.b, o.b)
                else:
                    self.evex_r(1, 1, 1, l, 81, o.a, 0, o.b)
            case KW_PERM:
                # the index, then vpermi2pd a, b, n
                self.evex_m(1, 1, 1, l, 16, o.a, 0, mrip(self.wconst_sym(k.wk[o.m]), 0), vn)
                self.evex_r(2, 1, 1, l, 119, o.a, o.b, o.n)
            case KW_LDK:
                self.evex_m(1, 1, 1, l, 16, o.a, 0, mrip(self.wconst_sym(k.wk[o.n]), 0), vn)
            case KW_ALIGN:
                # valignq a, b, b, n
                self.evex_r(3, 1, 1, l, 3, o.a, o.b, o.b)
                self.b(o.n)
            case KW_ST:
                # vmovsd m64, xmm
                self.evex_m(1, 3, 1, 0, 17, o.a, 0, m, 8)
            case KW_STH:
                # vmovhpd m64, xmm
                self.evex_m(1, 1, 1, 0, 23, o.a, 0, m, 8)
            case KW_SPILL:
                self.evex_m(1, 1, 1, l, 17, o.a, 0, mrb(-slots - 64 * (o.n + 1)), vn)
            case KW_FILL:
                self.evex_m(1, 1, 1, l, 16, o.a, 0, mrb(-slots - 64 * (o.n + 1)), vn)
            case KW_MOV:
                # vmovapd
                self.evex_r(1, 1, 1, l, 40, o.a, 0, o.b)
            case _:
                # KW_ARG: vmovsd xmm, [rbp + n]
                self.evex_m(1, 3, 1, 0, 16, o.a, 0, mrb(o.n), 8)

    # ------------------------------------------------------------ unwind tables
    # Windows: the function's UNWIND_INFO in .xdata and its RUNTIME_FUNCTION in
    # .pdata. The codes undo the prologue backwards; from the body on, the
    # frame pointer gives rsp back, then the pushes are popped.
    fn unwind_coff(ref self):
        let u = self.u
        let s = u.start
        # UNWIND_CODEs: prologue offset | operation << 8 | info << 12
        var codes: [int] = []
        if u.grow > 0:
            let at = u.alloc - s
            if u.grow <= 128:
                # UWOP_ALLOC_SMALL
                codes.push(at | (2 << 8) | ((u.grow / 8 - 1) << 12))
            elif u.grow <= 524280:
                # UWOP_ALLOC_LARGE, size / 8 in the next slot
                codes.push(at | (1 << 8))
                codes.push(u.grow / 8)
            else:
                # UWOP_ALLOC_LARGE, the size in the next two
                codes.push(at | (1 << 8) | (1 << 12))
                codes.push(u.grow & 65535)
                codes.push(u.grow >> 16)
        # UWOP_SET_FPREG
        codes.push((u.fp - s) | (3 << 8))
        if u.pad >= 0:
            codes.push((u.pad - s) | (2 << 8))
        var j = len(u.pushes) - 1
        while j >= 0:
            # UWOP_PUSH_NONVOL
            codes.push((u.pushes[j] - s) | (self.saved[j] << 12))
            j -= 1
        codes.push(1 | (RBP << 12))
        let at = len(self.o.unwind)
        let nfp = len(u.pushes) + (1 if u.pad >= 0 else 0)
        # version 1, no handler; frame register rbp = rsp + 16 * (nfp / 2)
        self.o.unwind.push(1)
        self.o.unwind.push(u8(u.pro_end - s))
        self.o.unwind.push(u8(len(codes)))
        self.o.unwind.push(u8(RBP | ((nfp / 2) << 4)))
        for c in codes:
            put16(ref self.o.unwind, c)
        if len(codes) % 2 == 1:
            put16(ref self.o.unwind, 0)
        # RUNTIME_FUNCTION: start, end, UNWIND_INFO
        self.rva(self.text_sym, s)
        self.rva(self.text_sym, self.pos())
        self.rva(self.xdata_sym, at)

    # an image-relative address in .pdata
    fn rva(ref self, sym: int, add: int):
        self.o.prel.push(ORel(off=len(self.o.pdata), sym=sym, kind=R_RVA32, add=add))
        put32(ref self.o.pdata, 0)

    # ELF: the function's FDE in .eh_frame (the CIE is at its start)
    fn unwind_elf(ref self):
        let u = self.u
        let at = len(self.o.unwind)
        put32(ref self.o.unwind, 0)
        # back to the CIE
        put32(ref self.o.unwind, at + 4)
        self.o.urel.push(ORel(off=len(self.o.unwind), sym=self.text_sym, kind=R_PC32, add=u.start))
        put32(ref self.o.unwind, 0)
        put32(ref self.o.unwind, self.pos() - u.start)
        # no augmentation data
        self.o.unwind.push(0)
        # CFA = rsp + 16 + 8 * (registers pushed), each saved at its push
        var loc = self.cfi_at(u.start, u.start + 1)
        self.cfi_cfa_off(16)
        self.cfi_saved(RBP, 2)
        for i, r in enumerate(self.saved):
            loc = self.cfi_at(loc, u.pushes[i])
            self.cfi_cfa_off(16 + 8 * (i + 1))
            self.cfi_saved(r, i + 3)
        if u.pad >= 0:
            loc = self.cfi_at(loc, u.pad)
            self.cfi_cfa_off(24 + 8 * len(self.saved))
        # then CFA = rbp + 16, except between an epilogue's `pop rbp` and `ret`
        loc = self.cfi_at(loc, u.fp)
        self.cfi_def_cfa(RBP, 16)
        for e in u.epis:
            loc = self.cfi_at(loc, e)
            # DW_CFA_remember_state
            self.o.unwind.push(10)
            self.cfi_def_cfa(RSP, 8)
            loc = self.cfi_at(loc, e + 1)
            # DW_CFA_restore_state
            self.o.unwind.push(11)
        # DW_CFA_nop up to a multiple of 8
        while len(self.o.unwind) % 8 != 0:
            self.o.unwind.push(0)
        set32(ref self.o.unwind, at, len(self.o.unwind) - at - 4)

    # DW_CFA_advance_loc from code offset `loc` to `to`; returns `to`
    fn cfi_at(ref self, loc: int, to: int) -> int:
        let d = to - loc
        if d == 0:
            return to
        if d < 64:
            self.o.unwind.push(u8(64 | d))
        elif d < 256:
            self.o.unwind.push(2)
            self.o.unwind.push(u8(d))
        elif d < 65536:
            self.o.unwind.push(3)
            put16(ref self.o.unwind, d)
        else:
            self.o.unwind.push(4)
            put32(ref self.o.unwind, d)
        return to

    # DW_CFA_def_cfa_offset
    fn cfi_cfa_off(ref self, n: int):
        self.o.unwind.push(14)
        uleb(ref self.o.unwind, n)

    # DW_CFA_def_cfa
    fn cfi_def_cfa(ref self, r: int, n: int):
        self.o.unwind.push(12)
        uleb(ref self.o.unwind, dwarf_reg(r))
        uleb(ref self.o.unwind, n)

    # DW_CFA_offset: r is saved at CFA - 8 * n
    fn cfi_saved(ref self, r: int, n: int):
        self.o.unwind.push(u8(128 | dwarf_reg(r)))
        uleb(ref self.o.unwind, n)

    # ------------------------------------------------------------ debug info
    # A line row where the code of source line x.n starts. A debugger may
    # change variables here, so no value cached in a register is used past it.
    fn line_row(ref self, x: Inst):
        self.cpos = -1
        if x.s.starts_with("<"):
            return
        let fi = self.dw.file(x.s)
        let row = DRow(pc=self.pos(), file=fi, line=x.n)
        let n = len(self.rows)
        if n > 0:
            let last = self.rows[n - 1]
            if last.line == x.n and last.file == fi:
                return
            if last.pc == row.pc:
                # the line before has no code of its own
                self.rows[n - 1] = row
                return
        self.rows.push(row)

    # A variable is visible from the line after its declaration (the
    # first line row after `pc`, at most `hi`): on the declaration's own line
    # it is not set yet.
    fn next_row(self, pc: int, hi: int) -> int:
        for r in self.rows:
            if r.pc > pc:
                return min(r.pc, hi)
        return hi

    fn slot_loc(self, s: int) -> [u8]:
        return loc_breg(dwarf_reg(self.slot_base[s]), self.slot_off[s])

    # The function's entry in the debug info: its range, lines and variables.
    fn debug_func(ref self, f: Func):
        let end = self.pos()
        for j in 1..len(self.ipos):
            if self.ipos[j] < 0:
                # the second instruction of a fused compare-and-branch
                self.ipos[j] = self.ipos[j - 1]
        var file = -1
        var line = 0
        if f.dline > 0 and not f.dfile.starts_with("<"):
            file = self.dw.file(f.dfile)
            line = f.dline
        var locals: [DLocal] = []
        for v in f.dvars:
            var loc: [u8] = []
            if v.slot >= 0:
                loc = self.slot_loc(v.slot)
            elif self.fold[v.ptr] == F_SLOT:
                loc = self.slot_loc(self.fval[v.ptr])
            elif self.fold[v.ptr] == F_NONE and self.reg[v.ptr] < 0:
                loc = loc_deref(loc_breg(dwarf_reg(RBP), self.home[v.ptr]))
            else:
                continue
            var lo = -1
            var hi = end
            if not v.param:
                if v.hi >= 0:
                    hi = self.ipos[v.hi]
                lo = self.next_row(self.ipos[v.lo], hi)
            locals.push(DLocal(name=v.name, ty=v.ty, param=v.param, loc=loc, lo=lo, hi=hi))
        if f.public and f.dname == "" and self.entry_main:
            # The C entry point that calls brine's `main` comes right before
            # it (see `emit_order`) and is described as a second range of it:
            # then gdb finds one place for `break main`, not two.
            self.entry = (self.u.start, end)
            return
        let name = f.name if f.dname == "" else f.dname
        var d = DFn(
            name=name,
            lo=self.u.start,
            hi=end,
            lo2=-1,
            hi2=-1,
            ret=f.dret,
            file=file,
            line=line,
            rows=self.rows,
            locals=locals
        )
        if f.name == "main__main" and self.entry.0 >= 0:
            d.lo2 = self.entry.0
            d.hi2 = self.entry.1
        self.dw.fns.push(d)

    # Keeps the most used integer vregs (uses in loops count more) in
    # callee-saved registers for the whole function.
    # Elems that become F_ELEM: scale 1, 2, 4 or 8, every use the address of
    # a load or store in the same block soon after, with no write to the
    # Elem's operands in between.
    fn fold_elems(ref self, f: Func, ndef: [int]):
        let ncode = len(f.code)
        let nv = len(f.vk)
        for i in 0..ncode:
            let x = f.code[i]
            if x.op != Op.Elem or x.d < 0 or ndef[x.d] != 1 or self.fold[x.d] != F_NONE:
                continue
            if not (x.n == 1 or x.n == 2 or x.n == 4 or x.n == 8):
                continue
            if self.fold[x.a] != F_NONE or self.fold[x.b] != F_NONE or self.vk[x.b].is_wide():
                continue
            var need = self.nuse[x.d]
            var ok = need > 0
            var j = i + 1
            while ok and need > 0:
                if j >= ncode or j > i + 64:
                    ok = false
                    break
                let y = f.code[j]
                for u in reads(y, nv):
                    if u != x.d:
                        continue
                    if (y.op == Op.Load or y.op == Op.Store) and y.a == x.d and y.b != x.d:
                        need -= 1
                    else:
                        ok = false
                if need > 0 and (
                    y.op == Op.Label
                    or y.op == Op.Jmp
                    or y.op == Op.Br
                    or y.op == Op.BrNot
                    or y.op == Op.Switch
                    or y.op == Op.Ret
                    or y.d == x.a
                    or y.d == x.b
                ):
                    ok = false
                j += 1
            if ok:
                self.fold[x.d] = F_ELEM
                self.fval[x.d] = i
                # read again at each use
                self.once[x.a] = false
                self.once[x.b] = false

    fn alloc(ref self, f: Func, ndef: [int]):
        let nv = len(f.vk)
        var ok = [false] * nv
        for v in 0..nv:
            ok[v] = (
                self.fold[v] == F_NONE
                and not f.vk[v].is_wide()
                and (ndef[v] > 0 or v < f.nparams or self.nuse[v] > 0)
            )
        # a compare fused into the branch right after it never lives anywhere
        for i in 1..len(f.code):
            let x = f.code[i - 1]
            let y = f.code[i]
            if (
                (y.op == Op.Br or y.op == Op.BrNot)
                and x.d >= 0
                and y.a == x.d
                and self.nuse[x.d] == 1
                and (
                    x.op == Op.Eq
                    or x.op == Op.Ne
                    or x.op == Op.Lt
                    or x.op == Op.Le
                    or x.op == Op.Gt
                    or x.op == Op.Ge
                )
            ):
                ok[x.d] = false
        # reads of an F_ELEM vreg read its Elem's operands
        var ea = [-1] * nv
        var eb = [-1] * nv
        for v in 0..nv:
            if self.fold[v] == F_ELEM:
                let e = f.code[self.fval[v]]
                ea[v] = e.a
                eb[v] = e.b
        let r = ra.allocate(f, ok, ea, eb, self.win, self.cold)
        # (stubs and the templates rely on these not holding vregs)
        for v in 0..nv:
            if r.reg[v] == RAX or r.reg[v] == RCX or r.reg[v] == RDX:
                panic("x64: a vreg in a scratch register")
        self.reg = r.reg
        self.freg = r.freg
        self.saved = r.saved
        self.fsaved = r.fsaved
        self.keep = r.keep

    # An integer parameter can be in any register, an argument register too
    # (ra.br), so the ones in registers are set last, in an order that reads
    # each argument register before it is changed (a cycle goes through rax),
    # and the ones passed on the stack after that.
    fn store_params(ref self, f: Func):
        let h = 1 if f.has_ret and f.ret.is_wide() else 0
        if h == 1:
            self.mov_mr(mrb(self.retp), self.int_reg(self.ploc[0]))
        var todo: [int] = []
        var ftodo: [int] = []
        var src = [-1] * f.nparams
        for i in 0..f.nparams:
            let k = f.vk[i]
            let l = self.ploc[i + h]
            if not k.is_wide() and l < L_XMM and self.reg[i] >= 0:
                src[i] = self.int_reg(l)
                self.norm(src[i], k)
                if src[i] != self.reg[i]:
                    todo.push(i)
                continue
            if k.is_wide():
                var r = R11
                if l >= L_STACK:
                    self.mov_rm(R11, mrb(16 + self.stack_off(l - L_STACK)))
                else:
                    r = self.int_reg(l)
                self.copy16(self.vm(i), mreg(r, 0))
            elif l >= L_STACK:
                pass
            elif l >= L_XMM:
                if self.freg[i] >= 0:
                    ftodo.push(i)
                else:
                    self.fst(fl_of(k), i, l - L_XMM)
            else:
                let r = self.int_reg(l)
                self.norm(r, k)
                self.st(r, i)
        # a float parameter can be in another's argument register (ra.br): the
        # same as the integer ones, with movaps
        var fsrc = [-1] * f.nparams
        for i in ftodo:
            fsrc[i] = self.ploc[i + h] - L_XMM
        while len(ftodo) > 0:
            var at = -1
            for t, i in enumerate(ftodo):
                if not any(j != i and fsrc[j] == self.freg[i] for j in ftodo):
                    at = t
                    break
            if at < 0:
                let r = self.freg[ftodo[0]]
                # movq rax, xmm r
                self.rr(102, 1, 3966, r, RAX)
                for j in ftodo:
                    if fsrc[j] == r:
                        fsrc[j] = F_IN_RAX
                continue
            let i = ftodo[at]
            if fsrc[i] == F_IN_RAX:
                # movq xmm, rax
                self.rr(102, 1, 3950, self.freg[i], RAX)
            elif self.freg[i] != fsrc[i]:
                self.rr(0, 0, 3880, self.freg[i], fsrc[i])
            ftodo.pop(at)
        while len(todo) > 0:
            var at = -1
            for t, i in enumerate(todo):
                if not any(j != i and src[j] == self.reg[i] for j in todo):
                    at = t
                    break
            if at < 0:
                let r = self.reg[todo[0]]
                self.mov_rr(RAX, r)
                for j in todo:
                    if src[j] == r:
                        src[j] = RAX
                continue
            let i = todo[at]
            self.mov_rr(self.reg[i], src[i])
            todo.pop(at)
        for i in 0..f.nparams:
            let k = f.vk[i]
            if k.is_wide() or self.ploc[i + h] < L_STACK:
                continue
            if self.reg[i] >= 0:
                self.load_k(self.reg[i], self.vm(i), k)
            elif self.freg[i] >= 0:
                self.fload(fl_of(k), self.freg[i], self.vm(i))
            elif k.size() < 8 and not k.is_float():
                self.load_k(RAX, self.vm(i), k)
                self.st(RAX, i)

    # ------------------------------------------------------------ instructions
    # Compiles the instruction at i; returns the index of the next one.
    fn inst(ref self, i: int) -> int:
        let x = self.code[i]
        if x.d >= 0 and self.fold[x.d] != F_NONE:
            return i + 1
        if x.op == Op.Load:
            let n = self.bit_rmw(i)
            if n > 0:
                return i + n
        if x.op == Op.Shr:
            let n = self.bit_test(i)
            if n > 0:
                return n
        # a reversal whose result only decides the branch right after it
        if (
            x.op == Op.Call
            and x.b == 1
            and x.d >= 0
            and x.s == "brine_bytes_rev"
            and i + 1 < len(self.code)
            and self.code[i + 1].op == Op.BrNot
            and self.code[i + 1].a == x.d
            and self.nuse[x.d] == 1
        ):
            self.bytes_rev(x, self.code[i + 1].n)
            return i + 2
        # one whose result is only compared with 0 by the branch after that
        if (
            x.op == Op.Call
            and x.b == 1
            and x.d >= 0
            and x.s == "brine_bytes_rev0"
            and i + 2 < len(self.code)
            and self.code[i + 1].op == Op.Ge
            and self.code[i + 1].a == x.d
            and self.fold[self.code[i + 1].b] == F_CONST
            and self.fval[self.code[i + 1].b] == 0
            and self.code[i + 2].op == Op.BrNot
            and self.code[i + 2].a == self.code[i + 1].d
            and self.nuse[self.code[i + 1].d] == 1
        ):
            self.bytes_rev0(x, self.code[i + 2].n)
            return i + 3
        match x.op:
            case Op.Const:
                self.op_const(x)
            case Op.FConst:
                let k = self.vk[x.d]
                if k == K.F32:
                    self.mov_ri(RAX, x.n & 4294967295)
                else:
                    self.mov_ri(RAX, x.n)
                self.st(RAX, x.d)
            case Op.Mov:
                if x.d != x.a:
                    let k = self.vk[x.d]
                    if k.is_wide():
                        self.copy16(self.vm(x.d), self.vm(x.a))
                    elif self.freg[x.d] >= 0:
                        self.fld(fl_of(k), self.freg[x.d], x.a)
                    elif self.freg[x.a] >= 0:
                        self.fst(fl_of(k), x.d, self.freg[x.a])
                    else:
                        self.set_v(x.d, x.a)
            case Op.Add | Op.Sub | Op.Mul | Op.Div | Op.Rem | Op.And | Op.Or | Op.Xor | Op.Shl | Op.Shr:
                let k = self.vk[x.d]
                if k.is_wide():
                    self.wide_bin(x)
                elif k.is_float():
                    self.float_bin(x)
                else:
                    self.int_bin(x)
            case Op.Neg | Op.Not:
                self.unary(x)
            case Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge:
                return self.compare(i, x)
            case Op.Conv:
                self.conv(x)
            case Op.Bits:
                # movq between an xmm register and a general one
                if self.vk[x.d].is_float():
                    self.st(self.use(RAX, x.a), x.d)
                else:
                    let r = self.dst(x.d)
                    self.ld(r, x.a)
                    self.norm(r, self.vk[x.d])
                    self.st(r, x.d)
            case Op.AddO | Op.SubO | Op.MulO:
                self.checked(x)
            case Op.IdxChk:
                let r = self.use(RAX, x.a)
                self.alu_v(CMP, r, x.b)
                self.jcc_stub(CC_AE, S_IDX, x.a, x.b, x.c)
                self.st(r, x.d)
            case Op.SlotAddr:
                self.lea(RAX, self.smem(x.a, 0))
                self.st(RAX, x.d)
            case Op.Global:
                let s = self.sym_ref(x.s)
                self.ld_sym(RAX, s)
                self.st(RAX, x.d)
            case Op.Load:
                let k = self.vk[x.d]
                let m = self.addr2(x.a, x.n, RDX, RCX)
                if k.is_wide():
                    self.copy16(self.vm(x.d), m)
                elif self.freg[x.d] >= 0:
                    self.fload(fl_of(k), self.freg[x.d], m)
                else:
                    let r = self.dst(x.d)
                    self.load_k(r, m, k)
                    if r == RAX:
                        self.st(RAX, x.d)
            case Op.Store:
                let k = self.vk[x.b]
                let m = self.addr2(x.a, x.n, RDX, RCX)
                if k.is_wide():
                    self.copy16(m, self.vm(x.b))
                elif self.freg[x.b] >= 0:
                    self.fstore(fl_of(k), m, self.freg[x.b])
                elif self.imm(x.b):
                    self.mov_mi(m, self.fval[x.b], k.size())
                else:
                    let r = self.use(RAX, x.b)
                    self.store_sz(m, r, k.size())
            case Op.Elem:
                self.elem(x)
            case Op.Copy:
                self.copy_mem(x.a, x.b, x.n)
            case Op.Zero:
                self.zero_mem(x.a, x.n)
            case Op.Call | Op.CallInd:
                if x.op == Op.Call and x.s == "brine_arr_unique" and len(x.args) == 1:
                    self.arr_unique(x)
                else:
                    self.ir_call(x)
            case Op.Label:
                self.lpos[x.n] = self.pos()
                self.cpos = -1
            case Op.Jmp:
                # no jump to the next instruction
                if not self.falls_to(i + 1, x.n):
                    self.jmp_label(x.n)
            case Op.Br | Op.BrNot:
                let want = x.op == Op.Br
                if self.fold[x.a] == F_CONST:
                    if (self.fval[x.a] != 0) == want:
                        self.jmp_label(x.n)
                else:
                    if self.reg[x.a] >= 0:
                        # test r8, r8
                        self.rr8(132, self.reg[x.a], self.reg[x.a])
                    elif self.hit(x.a):
                        self.rr8(132, self.creg, self.creg)
                    else:
                        # cmp byte [a], 0
                        self.rm(0, 0, 128, 7, self.vm(x.a), 1)
                        self.b(0)
                    return self.cond_jump(i, CC_NE, want, x.n)
            case Op.Switch:
                self.switch(x)
            case Op.Ret:
                self.op_ret(x)
            case Op.Unreachable:
                self.call_rt("brine_unreachable", [])
            case Op.Phi:
                panic("x64: phis only exist inside ssa.br")
            case Op.Line:
                if self.dbg:
                    self.line_row(x)
        return i + 1

    # A jump table in .text after the jump: 32-bit offsets from its start.
    fn switch(ref self, x: Inst):
        self.ld(RAX, x.a)
        if x.n != 0:
            self.alu_ri(SUB, RAX, x.n)
        self.alu_ri(CMP, RAX, len(x.args) - 1)
        self.jcc_label(CC_AE, x.args[0])
        # lea r11, [rip + table]
        self.b(76)
        self.b(141)
        self.b(29)
        let at = self.pos()
        self.b32(0)
        # movsxd rax, dword [r11 + rax * 4]; add rax, r11; jmp rax
        self.b(73)
        self.b(99)
        self.b(4)
        self.b(131)
        self.alu_rr(ADD, RAX, R11)
        self.b(255)
        self.b(224)
        while self.pos() % 4 != 0:
            self.b(204)
        let base = self.pos()
        set32(ref self.o.text, at, base - (at + 4))
        for l in x.args[1:]:
            self.tat.push(self.pos())
            self.tlab.push(l)
            self.tbase.push(base)
            self.b32(0)
        self.cpos = -1

    fn op_const(ref self, x: Inst):
        let k = self.vk[x.d]
        if k.is_wide():
            self.mov_ri(RAX, x.n)
            self.st(RAX, x.d)
            self.mov_ri(RAX, x.c)
            self.mov_mr(moff(self.vm(x.d), 8), RAX)
        elif k.is_float():
            self.mov_ri(RAX, x.n)
            self.rr(242 if k == K.F64 else 243, 1, 3882, 0, RAX)
            self.fst(fl_of(k), x.d, 0)
        else:
            let v = canon(x.n, k)
            if self.reg[x.d] >= 0:
                self.mov_ri(self.reg[x.d], v)
            elif fits32(v):
                self.mov_mi(self.vm(x.d), v, 8)
            else:
                self.mov_ri(RAX, v)
                self.st(RAX, x.d)

    fn op_ret(ref self, x: Inst):
        if x.a >= 0 and self.has_ret:
            let k = self.vk[x.a]
            if k.is_wide():
                self.mov_rm(R11, mrb(self.retp))
                self.copy16(mreg(R11, 0), self.vm(x.a))
                self.mov_rr(RAX, R11)
            elif k.is_float():
                self.fld(fl_of(k), 0, x.a)
            else:
                self.ld(RAX, x.a)
        self.epilogue()

    fn int_bin(ref self, x: Inst):
        let k = self.vk[x.d]
        match x.op:
            case Op.Add | Op.Sub | Op.And | Op.Or | Op.Xor:
                # b just computed (in the cache register) goes first when the
                # order doesn't matter: then its store can go
                # (d may share a's register, never b's)
                let ra = self.reg[x.a] if self.fold[x.a] == F_NONE else -1
                if (
                    x.op != Op.Sub
                    and self.cached(x.b)
                    and not self.cached(x.a)
                    and ra != self.dst(x.d)
                    and x.a != x.d
                ):
                    var y = x
                    y.a = x.b
                    y.b = x.a
                    self.int_bin(y)
                    return
                # compute in d's own register unless that would clobber b
                var r = self.dst(x.d)
                if x.b == x.d:
                    r = RAX
                self.ld(r, x.a)
                var op = ADD
                if x.op == Op.Sub:
                    op = SUB
                elif x.op == Op.And:
                    op = AND
                elif x.op == Op.Or:
                    op = OR
                elif x.op == Op.Xor:
                    op = XOR
                self.alu_v(op, r, x.b)
                if op == ADD or op == SUB:
                    self.norm(r, k)
                if r != RAX:
                    return
            case Op.Mul:
                # in d's own register unless that would clobber b
                var r = self.dst(x.d)
                if x.b == x.d:
                    r = RAX
                self.mul_in(r, x.a, x.b)
                self.norm(r, k)
                if r != RAX:
                    return
            case Op.Div | Op.Rem:
                if not k.is_signed() and self.const_div(x.op == Op.Rem, x.a, x.b, k, false):
                    self.st(RAX, x.d)
                    return
                self.ld(RAX, x.a)
                let ext = 7 if k.is_signed() else 6
                if k.is_signed():
                    # cqo
                    self.b(72)
                    self.b(153)
                else:
                    self.rr(0, 0, 49, RDX, RDX)
                if self.inmem(x.b):
                    self.rm(0, 1, 247, ext, self.vm(x.b), 0)
                else:
                    let s = self.use(RCX, x.b)
                    self.rr(0, 1, 247, ext, s)
                if x.op == Op.Rem:
                    self.st(RDX, x.d)
                    return
            case _:
                var r = self.dst(x.d)
                var ext = SHL
                if x.op == Op.Shr:
                    ext = SAR if k.is_signed() else SHR
                if self.fold[x.b] == F_CONST:
                    # (just the next shift's count: straight into rcx)
                    let n = self.cur + 1
                    if (
                        r == RAX
                        and self.nuse[x.d] == 1
                        and n < len(self.code)
                        and (self.code[n].op == Op.Shl or self.code[n].op == Op.Shr)
                        and self.code[n].b == x.d
                        and self.code[n].a != x.d
                    ):
                        r = RCX
                    self.ld(r, x.a)
                    self.shift_i(ext, r, self.fval[x.b] & 63)
                    if r == RCX:
                        self.st(RCX, x.d)
                        return
                else:
                    # the count first: b may live in d's register
                    self.ld(RCX, x.b)
                    self.ld(r, x.a)
                    self.shift_cl(ext, r)
                if ext == SHL:
                    self.norm(r, k)
                if r != RAX:
                    return
        self.st(RAX, x.d)

    # rax = a * b (low 64 bits)
    fn mul_rax(ref self, a: int, b: int):
        self.mul_in(RAX, a, b)

    # r = a * b (low 64 bits; r isn't b's register)
    fn mul_in(ref self, r: int, a: int, b: int):
        if self.imm(b):
            if self.inmem(a):
                self.rm(0, 1, 105, r, self.vm(a), 4)
            else:
                let s = self.use(r, a)
                self.rr(0, 1, 105, r, s)
            self.b32(self.fval[b])
            return
        self.ld(r, a)
        if self.inmem(b):
            self.rm(0, 1, 4015, r, self.vm(b), 0)
        else:
            let s = self.use(RCX, b)
            self.rr(0, 1, 4015, r, s)

    fn float_bin(ref self, x: Inst):
        let k = self.vk[x.d]
        let fl = fl_of(k)
        if x.op == Op.Rem:
            let name = "brine_x_f_fmod" if fl == 1 else "brine_x_f_fmodf"
            self.call_rt(name, [CArg(how=A_VAL, v=x.a, fl=fl), CArg(how=A_VAL, v=x.b, fl=fl)])
            self.store_ret(x.d)
            return
        var op = 88
        if x.op == Op.Sub:
            op = 92
        elif x.op == Op.Mul:
            op = 89
        elif x.op == Op.Div:
            op = 94
        let pfx = 242 if fl == 1 else 243
        # in d's own register unless that is b's
        var r = self.freg[x.d]
        if r < 0 or x.b == x.d:
            r = 0
        self.fld(fl, r, x.a)
        self.fop(pfx, 3840 + op, r, x.b)
        self.fst(fl, x.d, r)

    fn wide_bin(ref self, x: Inst):
        let k = self.vk[x.d]
        match x.op:
            case Op.Add | Op.Sub | Op.And | Op.Or | Op.Xor:
                var lo = ADD
                var hi = ADC
                if x.op == Op.Sub:
                    lo = SUB
                    hi = SBB
                elif x.op == Op.And:
                    lo = AND
                    hi = AND
                elif x.op == Op.Or:
                    lo = OR
                    hi = OR
                elif x.op == Op.Xor:
                    lo = XOR
                    hi = XOR
                let ma = self.vm(x.a)
                let mb = self.vm(x.b)
                self.mov_rm(RAX, ma)
                self.mov_rm(RDX, moff(ma, 8))
                self.alu_rm(lo, RAX, mb)
                self.alu_rm(hi, RDX, moff(mb, 8))
                self.st(RAX, x.d)
                self.mov_mr(moff(self.vm(x.d), 8), RDX)
            case Op.Mul:
                # the low 128 bits (signed or not): a.lo * b.lo, plus the
                # cross products in the high half
                let ma = self.vm(x.a)
                let mb = self.vm(x.b)
                self.mov_rm(RCX, moff(ma, 8))
                self.rm(0, 1, 4015, RCX, mb, 0)
                self.mov_rm(RAX, moff(mb, 8))
                self.rm(0, 1, 4015, RAX, ma, 0)
                self.alu_rr(ADD, RCX, RAX)
                self.mov_rm(RAX, ma)
                # mul qword [b]
                self.rm(0, 1, 247, 4, mb, 0)
                self.alu_rr(ADD, RDX, RCX)
                self.st(RAX, x.d)
                self.mov_mr(moff(self.vm(x.d), 8), RDX)
            case Op.Shl | Op.Shr:
                # shld / shrd by cl, then (cl >= 64: the shifts above use
                # cl mod 64) one half moves to the other
                let ma = self.vm(x.a)
                self.ld(RCX, x.b)
                self.mov_rm(RAX, ma)
                self.mov_rm(RDX, moff(ma, 8))
                if x.op == Op.Shl:
                    # shld rdx, rax, cl; shl rax, cl
                    self.rr(0, 1, 4005, RAX, RDX)
                    self.rr(0, 1, 211, SHL, RAX)
                else:
                    # shrd rax, rdx, cl; shr / sar rdx, cl
                    self.rr(0, 1, 4013, RDX, RAX)
                    self.rr(0, 1, 211, SAR if k.is_signed() else SHR, RDX)
                # test cl, 64
                self.rr(0, 0, 246, 0, RCX)
                self.b(64)
                let small = self.j8(CC_E)
                if x.op == Op.Shl:
                    self.mov_rr(RDX, RAX)
                    self.rr(0, 0, 49, RAX, RAX)
                else:
                    self.mov_rr(RAX, RDX)
                    if k.is_signed():
                        self.shift_i(SAR, RDX, 63)
                    else:
                        self.rr(0, 0, 49, RDX, RDX)
                self.here8(small)
                self.st(RAX, x.d)
                self.mov_mr(moff(self.vm(x.d), 8), RDX)
            case _:
                var nm = "mul"
                if x.op == Op.Div:
                    nm = "div"
                elif x.op == Op.Rem:
                    nm = "rem"
                self.call_rt(
                    f"brine_x_{w128(k)}_{nm}",
                    [
                        CArg(how=A_ADDR, v=x.d, fl=0),
                        CArg(how=A_ADDR, v=x.a, fl=0),
                        CArg(how=A_ADDR, v=x.b, fl=0)
                    ]
                )

    fn unary(ref self, x: Inst):
        let k = self.vk[x.d]
        if k.is_wide():
            let ma = self.vm(x.a)
            self.mov_rm(RAX, ma)
            self.mov_rm(RDX, moff(ma, 8))
            if x.op == Op.Not:
                self.rr(0, 1, 247, 2, RAX)
                self.rr(0, 1, 247, 2, RDX)
            else:
                # neg rax; adc rdx, 0; neg rdx
                self.rr(0, 1, 247, 3, RAX)
                self.alu_ri(ADC, RDX, 0)
                self.rr(0, 1, 247, 3, RDX)
            self.st(RAX, x.d)
            self.mov_mr(moff(self.vm(x.d), 8), RDX)
            return
        if not k.is_float():
            let r = self.dst(x.d)
            self.ld(r, x.a)
            if x.op == Op.Neg:
                self.rr(0, 1, 247, 3, r)
                self.norm(r, k)
            elif k == K.Bool:
                self.rr(0, 0, 131, XOR, r)
                self.b(1)
            else:
                self.rr(0, 1, 247, 2, r)
                self.norm(r, k)
            if r == RAX:
                self.st(RAX, x.d)
            return
        self.ld(RAX, x.a)
        # a float's negation flips the sign bit: btc rax, 63 / btc eax, 31
        if k == K.F64:
            self.rr(0, 1, 4026, 7, RAX)
            self.b(63)
        else:
            self.rr(0, 0, 4026, 7, RAX)
            self.b(31)
        self.st(RAX, x.d)

    # Sets the flags for a comparison; returns the condition that means true.
    fn cmp_flags(ref self, x: Inst) -> int:
        let k = self.vk[x.a]
        let signed = k.is_signed()
        if k.is_float():
            let fl = fl_of(k)
            var p = x.a
            var q = x.b
            if x.op == Op.Lt or x.op == Op.Le:
                p = x.b
                q = x.a
            var r = self.freg[p]
            if r < 0:
                r = 0
                self.fld(fl, 0, p)
            # ucomisd / ucomiss r, q
            self.fop(102 if fl == 1 else 0, 3886, r, q)
            match x.op:
                case Op.Eq:
                    return CC_FEQ
                case Op.Ne:
                    return CC_FNE
                case Op.Lt | Op.Gt:
                    return CC_A
                case _:
                    return CC_AE
        if k.is_wide():
            let ma = self.vm(x.a)
            let mb = self.vm(x.b)
            if x.op == Op.Eq or x.op == Op.Ne:
                self.mov_rm(RAX, ma)
                self.mov_rm(RDX, moff(ma, 8))
                self.alu_rm(XOR, RAX, mb)
                self.alu_rm(XOR, RDX, moff(mb, 8))
                self.alu_rr(OR, RAX, RDX)
                return CC_E if x.op == Op.Eq else CC_NE
            # p < q via cmp/sbb
            var p = ma
            var q = mb
            if x.op == Op.Gt or x.op == Op.Le:
                p = mb
                q = ma
            self.mov_rm(RAX, p)
            self.mov_rm(RDX, moff(p, 8))
            self.alu_rm(CMP, RAX, q)
            self.alu_rm(SBB, RDX, moff(q, 8))
            if x.op == Op.Lt or x.op == Op.Gt:
                return CC_L if signed else CC_B
            return CC_GE if signed else CC_AE
        let r = self.use(RAX, x.a)
        self.alu_v(CMP, r, x.b)
        match x.op:
            case Op.Eq:
                return CC_E
            case Op.Ne:
                return CC_NE
            case Op.Lt:
                return CC_L if signed else CC_B
            case Op.Le:
                return CC_LE if signed else CC_BE
            case Op.Gt:
                return CC_G if signed else CC_A
            case _:
                return CC_GE if signed else CC_AE

    fn compare(ref self, i: int, x: Inst) -> int:
        let cc = self.cmp_flags(x)
        # fuse with a branch right after that is the only use
        if i + 1 < len(self.code) and self.nuse[x.d] == 1:
            let y = self.code[i + 1]
            if (y.op == Op.Br or y.op == Op.BrNot) and y.a == x.d:
                return self.cond_jump(i + 1, cc, y.op == Op.Br, y.n)
        if cc == CC_FEQ:
            self.setcc(CC_E, RAX)
            self.setcc(CC_NP, RCX)
            self.rr8(32, RCX, RAX)
        elif cc == CC_FNE:
            self.setcc(CC_NE, RAX)
            self.setcc(CC_P, RCX)
            self.rr8(8, RCX, RAX)
        else:
            self.setcc(cc, RAX)
        self.rr8(4022, RAX, RAX)
        self.st(RAX, x.d)
        return i + 1

    # The branch code[i] on flags cc; when a jump follows it and its own
    # target comes right after, the condition is flipped and goes to the
    # jump's target instead. Returns the next instruction's index.
    # Likewise when the jump goes back (a loop's next iteration) and the branch
    # forward (out of it): the branch goes back, and the jump out.
    fn cond_jump(ref self, i: int, cc: int, want: bool, l: int) -> int:
        if i + 1 < len(self.code) and self.code[i + 1].op == Op.Jmp and not self.dead[i + 1]:
            let j = self.code[i + 1].n
            if self.falls_to(i + 2, l):
                self.branch_cc(cc, not want, j)
                return i + 2
            if self.lpos[j] >= 0 and self.lpos[l] < 0 and not self.falls_to(i + 2, j):
                self.branch_cc(cc, not want, j)
                self.jmp_label(l)
                return i + 2
        self.branch_cc(cc, want, l)
        return i + 1

    # jumps to label l when the condition is `want`
    fn branch_cc(ref self, cc: int, want: bool, l: int):
        if cc == CC_FEQ or cc == CC_FNE:
            # jump on "equal and ordered" or on "not equal or unordered"
            if (cc == CC_FEQ) == want:
                let skip = self.j8(CC_P)
                self.jcc_label(CC_E, l)
                self.here8(skip)
            else:
                self.jcc_label(CC_P, l)
                self.jcc_label(CC_NE, l)
            return
        self.jcc_label(cc if want else cc ^ 1, l)

    fn checked(ref self, x: Inst):
        let k = self.vk[x.d]
        var kind = S_ADD
        if x.op == Op.SubO:
            kind = S_SUB
        elif x.op == Op.MulO:
            kind = S_MUL
        if k.is_wide():
            let nm = ["add", "sub", "mul"][kind]
            # add and subtract inline, calling the runtime (to panic) only
            # when they overflow
            var e = -1
            if kind != S_MUL:
                let ma = self.vm(x.a)
                let mb = self.vm(x.b)
                self.mov_rm(RAX, ma)
                self.mov_rm(RDX, moff(ma, 8))
                self.alu_rm(ADD if kind == S_ADD else SUB, RAX, mb)
                self.alu_rm(ADC if kind == S_ADD else SBB, RDX, moff(mb, 8))
                let j = self.j32(CC_O if k.is_signed() else CC_B)
                self.st(RAX, x.d)
                self.mov_mr(moff(self.vm(x.d), 8), RDX)
                e = self.jmp32()
                self.here32(j)
            else:
                # a and b both fit in 64 bits: one widening multiply, which
                # can't overflow 128
                let ma = self.vm(x.a)
                let mb = self.vm(x.b)
                var j1 = -1
                var j2 = -1
                if k.is_signed():
                    # cqo: each high half is its low half's sign
                    self.mov_rm(RAX, mb)
                    self.b(72)
                    self.b(153)
                    self.alu_rm(CMP, RDX, moff(mb, 8))
                    j1 = self.j32(CC_NE)
                    self.mov_rm(RAX, ma)
                    self.b(72)
                    self.b(153)
                    self.alu_rm(CMP, RDX, moff(ma, 8))
                    j2 = self.j32(CC_NE)
                    # imul qword [b]
                    self.rm(0, 1, 247, 5, mb, 0)
                else:
                    self.mov_rm(RDX, moff(ma, 8))
                    self.alu_rm(OR, RDX, moff(mb, 8))
                    j1 = self.j32(CC_NE)
                    self.mov_rm(RAX, ma)
                    # mul qword [b]
                    self.rm(0, 1, 247, 4, mb, 0)
                self.st(RAX, x.d)
                self.mov_mr(moff(self.vm(x.d), 8), RDX)
                e = self.jmp32()
                self.here32(j1)
                if j2 >= 0:
                    self.here32(j2)
            self.call_rt(
                f"brine_x_{nm}_{w128(k)}",
                [
                    CArg(how=A_ADDR, v=x.d, fl=0),
                    CArg(how=A_ADDR, v=x.a, fl=0),
                    CArg(how=A_ADDR, v=x.b, fl=0),
                    CArg(how=A_VAL, v=x.c, fl=0)
                ]
            )
            if e >= 0:
                self.here32(e)
            return
        let signed = k.is_signed()
        # in d's register, when that isn't b's or the panic's location's
        var r = self.dst(x.d)
        if (
            (self.fold[x.b] == F_NONE and self.reg[x.b] == r)
            or (self.fold[x.c] == F_NONE and self.reg[x.c] == r)
            or x.b == x.d
        ):
            r = RAX
        if k.size() == 8 and signed and (kind != S_MUL or self.imm(x.b)):
            if kind == S_MUL:
                if self.inmem(x.a):
                    self.rm(0, 1, 105, r, self.vm(x.a), 4)
                else:
                    let s = self.use(r, x.a)
                    self.rr(0, 1, 105, r, s)
                self.b32(self.fval[x.b])
            else:
                self.ld(r, x.a)
                self.alu_v(ADD if kind == S_ADD else SUB, r, x.b)
            self.jcc_stub(CC_O, kind, x.a, x.b, x.c)
            self.st(r, x.d)
            return
        if k.size() == 8:
            if kind == S_MUL and not signed:
                self.ld(RAX, x.a)
                if self.inmem(x.b):
                    self.rm(0, 1, 247, 4, self.vm(x.b), 0)
                else:
                    let s = self.use(RCX, x.b)
                    self.rr(0, 1, 247, 4, s)
                self.jcc_stub(CC_O, kind, x.a, x.b, x.c)
            elif kind == S_MUL:
                self.mul_rax(x.a, x.b)
                self.jcc_stub(CC_O, kind, x.a, x.b, x.c)
            else:
                self.ld(RAX, x.a)
                self.alu_v(ADD if kind == S_ADD else SUB, RAX, x.b)
                self.jcc_stub(CC_O if signed else CC_B, kind, x.a, x.b, x.c)
        else:
            # exact in 64 bits; overflow iff the result isn't canonical
            if kind == S_MUL:
                self.mul_rax(x.a, x.b)
            else:
                self.ld(RAX, x.a)
                self.alu_v(ADD if kind == S_ADD else SUB, RAX, x.b)
            self.mov_rr(RCX, RAX)
            self.norm(RCX, k)
            self.alu_rr(CMP, RCX, RAX)
            self.jcc_stub(CC_NE, kind, x.a, x.b, x.c)
        self.st(RAX, x.d)

    fn elem(ref self, x: Inst):
        let n = x.n
        if n == 0:
            self.set_v(x.d, x.a)
            return
        if (
            self.fold[x.b] == F_CONST
            and fits32(self.fval[x.b])
            and fits32(n)
            and fits32(self.fval[x.b] * n)
        ):
            let off = self.fval[x.b] * n
            let r = self.dst(x.d)
            if self.fold[x.a] == F_SLOT and fits32(self.slot_off[self.fval[x.a]] + off):
                self.lea(r, self.smem(self.fval[x.a], off))
            else:
                let ra = self.use(RAX, x.a)
                if off != 0:
                    self.lea(r, mreg(ra, off))
                else:
                    self.mov_rr(r, ra)
            if r == RAX:
                self.st(RAX, x.d)
            return
        if n == 1 or n == 2 or n == 4 or n == 8:
            let ra = self.use(RAX, x.a)
            let rb = self.use(RCX, x.b)
            let r = self.dst(x.d)
            self.lea(r, Mem(base=ra, index=rb, scale=n, disp=0, sym=-1))
            if r != RAX:
                return
        elif fits32(n):
            # imul r, b, n; add r, a (through rcx when r is a's register)
            let r = self.dst(x.d)
            let t = RCX if self.fold[x.a] == F_NONE and self.reg[x.a] == r else r
            if self.inmem(x.b):
                self.rm(0, 1, 105, t, self.vm(x.b), 4)
            else:
                let s = self.use(RCX, x.b)
                self.rr(0, 1, 105, t, s)
            self.b32(n)
            if t == RCX:
                self.alu_rr(ADD, r, RCX)
            else:
                self.alu_v(ADD, r, x.a)
            if r != RAX:
                return
        else:
            self.ld(RAX, x.a)
            self.ld(RCX, x.b)
            self.mov_ri(RDX, n)
            self.rr(0, 1, 4015, RCX, RDX)
            self.alu_rr(ADD, RAX, RCX)
        self.st(RAX, x.d)

    fn copy_mem(ref self, dst: int, src: int, n: int):
        if n > 256:
            self.call_rt(
                "memcpy",
                [
                    CArg(how=A_VAL, v=dst, fl=0),
                    CArg(how=A_VAL, v=src, fl=0),
                    CArg(how=A_IMM, v=n, fl=0)
                ]
            )
            return
        let md = self.addr(dst, 0, R10)
        let ms = self.addr(src, 0, R11)
        var i = 0
        # (a big one 16 bytes at a time, through xmm0: ra.br gives it no vreg)
        while n > 64 and i + 16 <= n:
            self.xrestore(0, moff(ms, i))
            self.xsave(moff(md, i), 0)
            i += 16
        while i + 8 <= n:
            self.mov_rm(RAX, moff(ms, i))
            self.mov_mr(moff(md, i), RAX)
            i += 8
        if i + 4 <= n:
            self.rm(0, 0, 139, RAX, moff(ms, i), 0)
            self.store_sz(moff(md, i), RAX, 4)
            i += 4
        if i + 2 <= n:
            self.rm(0, 0, 4023, RAX, moff(ms, i), 0)
            self.store_sz(moff(md, i), RAX, 2)
            i += 2
        if i < n:
            self.rm(0, 0, 4022, RAX, moff(ms, i), 0)
            self.store_sz(moff(md, i), RAX, 1)

    fn zero_mem(ref self, dst: int, n: int):
        if n > 256:
            self.call_rt(
                "memset",
                [
                    CArg(how=A_VAL, v=dst, fl=0),
                    CArg(how=A_IMM, v=0, fl=0),
                    CArg(how=A_IMM, v=n, fl=0)
                ]
            )
            return
        let md = self.addr(dst, 0, R10)
        self.rr(0, 0, 49, RAX, RAX)
        var i = 0
        if n > 64:
            self.xzero(0)
        while n > 64 and i + 16 <= n:
            self.xsave(moff(md, i), 0)
            i += 16
        while i + 8 <= n:
            self.mov_mr(moff(md, i), RAX)
            i += 8
        if i + 4 <= n:
            self.store_sz(moff(md, i), RAX, 4)
            i += 4
        if i + 2 <= n:
            self.store_sz(moff(md, i), RAX, 2)
            i += 2
        if i < n:
            self.store_sz(moff(md, i), RAX, 1)

    # ------------------------------------------------------------ byte idioms
    # The loop idioms on arrays kept as bytes, as brine_rt.h does them: 16
    # bytes in two registers, stored 8 at a time so that the loads after get
    # the stores forwarded. Byte arrays have 16 spare bytes at the end.

    fn jmp32(ref self) -> int:
        self.b(233)
        self.b32(0)
        return self.pos() - 4

    fn bswap(ref self, r: int):
        self.b(72 | (r >> 3))
        self.b(15)
        self.b(200 + (r & 7))

    fn not_r(ref self, r: int):
        self.rr(0, 1, 247, 2, r)

    # op [m], r (op: an ALU extension)
    fn alu_mr(ref self, op: int, m: Mem, r: int):
        self.rm(0, 1, (op << 3) | 1, r, m, 0)

    # brine_bytes_rev(d, n, i, j): bytes i..j reversed when they're in bounds
    # and at most 16; true then, or when i >= j. Without branches on k (it
    # varies from call to call), in the scratch registers alone. With `fail`
    # (a label), it jumps there instead of returning false and falls through
    # instead of returning true.
    fn bytes_rev(ref self, x: Inst, fail: int):
        # i is often a constant 0 (a reversal of a prefix)
        let zero = self.fold[x.args[2]] == F_CONST and self.fval[x.args[2]] == 0
        self.ld(RDX, x.args[3])
        self.ld(R10, x.args[0])
        self.ld(R11, x.args[1])
        var done = 0
        var f1 = -1
        if zero:
            self.rr(0, 1, 133, RDX, RDX)
            done = self.j32(CC_LE)
        else:
            self.ld(RCX, x.args[2])
            self.alu_rr(CMP, RCX, RDX)
            done = self.j32(CC_GE)
            self.rr(0, 1, 133, RCX, RCX)
            f1 = self.j32(CC_S)
        self.alu_rr(CMP, RDX, R11)
        let f2 = self.j32(CC_GE)
        # k = j - i, p = d + i
        if not zero:
            self.alu_rr(SUB, RDX, RCX)
        self.alu_ri(CMP, RDX, 16)
        let f3 = self.j32(CC_GE)
        if not zero:
            self.alu_rr(ADD, R10, RCX)
        self.rev16(false)
        var fails = [f2, f3]
        if f1 >= 0:
            fails.push(f1)
        if fail < 0:
            self.idiom_end(x, [done], fails)
            return
        self.here32(done)
        for j in fails:
            self.j32_to(j, fail)

    # Bytes 0..k (k = rdx, below 16) of the 16 at r10 reversed, the rest kept;
    # with `first`, ecx is the new byte 0.
    fn rev16(ref self, first: bool):
        # the 16 bytes byte-swapped, shifted down cl = 8 * (15 - k) bits, are
        # the new bytes 0..k; m (r11 + 16) has the low k + 1 bytes set, from a
        # table: computing it takes a chain of shifts the loads would wait on
        self.mov_rr(RCX, RDX)
        self.shift_i(SHL, RCX, 3)
        self.alu_ri(XOR, RCX, 120)
        self.shift_i(SHL, RDX, 4)
        self.lea(R11, mrip(self.lowtab_sym(), 0))
        self.alu_rr(ADD, R11, RDX)
        self.mov_rm(RAX, mreg(R10, 8))
        self.bswap(RAX)
        self.mov_rm(RDX, mreg(R10, 0))
        self.bswap(RDX)
        # Below 64, shrd(rax, rdx, cl) is the low half and rdx >> cl the high
        # one; from 64 on, rdx >> cl is the low half and m keeps the high one.
        self.rr(0, 1, 4013, RDX, RAX)
        self.shift_cl(SHR, RDX)
        self.test_cl64()
        self.cmov(CC_NE, RAX, RDX)
        if first:
            # movzx ecx, al
            self.rr8(4022, RCX, RAX)
        # each half: x ^ ((x ^ y) & m)
        self.alu_rm(XOR, RAX, mreg(R10, 0))
        self.alu_rm(AND, RAX, mreg(R11, 16))
        self.alu_mr(XOR, mreg(R10, 0), RAX)
        self.alu_rm(XOR, RDX, mreg(R10, 8))
        self.alu_rm(AND, RDX, mreg(R11, 24))
        self.alu_mr(XOR, mreg(R10, 8), RDX)

    # brine_bytes_rev0(d, n, j): bytes 0..j reversed and the new d[0] when j
    # is in 0..min(n, 16), else -1, having done nothing. With `fail` (a label),
    # it jumps there instead of returning -1.
    fn bytes_rev0(ref self, x: Inst, fail: int):
        self.ld(RDX, x.args[2])
        self.ld(R10, x.args[0])
        self.ld(R11, x.args[1])
        self.alu_rr(CMP, RDX, R11)
        let f1 = self.j32(CC_GE)
        # unsigned: j < 0 fails too
        self.alu_ri(CMP, RDX, 16)
        let f2 = self.j32(CC_AE)
        self.rev16(true)
        if fail >= 0:
            self.st(RCX, x.d)
            self.j32_to(f1, fail)
            self.j32_to(f2, fail)
            return
        let e = self.jmp8()
        self.here32(f1)
        self.here32(f2)
        self.mov_ri(RCX, -1)
        self.here8(e)
        self.st(RCX, x.d)

    # points the rel32 jump at `at` (from j32) to label l
    fn j32_to(ref self, at: int, l: int):
        let p = self.lpos[l]
        if p >= 0:
            set32(ref self.o.text, at, p - at - 4)
        else:
            self.jat.push(at)
            self.jlab.push(l)

    # The symbol of the 17 pairs of words with the low 0, 1, ..., 16 bytes set.
    fn lowtab_sym(ref self) -> int:
        match self.vpool.get("lowtab"):
            case Some(s):
                return s
            case None:
                pass
        while len(self.o.rodata) % 16 != 0:
            self.o.rodata.push(0)
        self.o.rodata_align = max(self.o.rodata_align, 16)
        let off = len(self.o.rodata)
        for n in 0..17:
            let lo = -1 if n >= 8 else (1 << (8 * n)) - 1
            let hi = -1 if n == 16 else (0 if n <= 8 else (1 << (8 * (n - 8))) - 1)
            put64(ref self.o.rodata, lo)
            put64(ref self.o.rodata, hi)
        let s = self.sym_def(f"__brx_v{len(self.vpool)}", SEC_RODATA, off, false, false)
        self.vpool["lowtab"] = s
        return s

    # test cl, 64: is a 128-bit shift by cl one of 64 or more?
    fn test_cl64(ref self):
        self.b(246)
        self.b(193)
        self.b(64)

    fn cmov(ref self, cc: int, d: int, s: int):
        self.rr(0, 1, 3904 + cc, d, s)

    # d = 1 after the (rel32) jumps in `ok`, 0 after those in `fail`
    fn idiom_end(ref self, x: Inst, ok: [int], fail: [int]):
        for j in ok:
            self.here32(j)
        self.mov_ri(RAX, 1)
        let e = self.jmp8()
        for j in fail:
            self.here32(j)
        self.mov_ri(RAX, 0)
        self.here8(e)
        self.st(RAX, x.d)

    # the runtime's version, for what the inline code doesn't do
    fn idiom_call(ref self, x: Inst):
        var args: [CArg] = []
        for v in x.args:
            args.push(CArg(how=A_VAL, v=v, fl=0))
        self.call_rt("brine_x_" + x.s[6:], args)
        self.store_ret(x.d)

    # brine_bytes_rotl(d, n, lo, hi): t = d[lo]; d[lo..hi] = d[lo + 1..=hi];
    # d[hi] = t. Also a call to ra.br.
    fn bytes_rotl(ref self, x: Inst):
        self.ld(R10, x.args[0])
        self.ld(R11, x.args[1])
        self.ld(RAX, x.args[2])
        self.ld(RDX, x.args[3])
        self.alu_rr(CMP, RAX, RDX)
        let f1 = self.j32(CC_G)
        self.rr(0, 1, 133, RAX, RAX)
        let f2 = self.j32(CC_S)
        self.alu_rr(CMP, RDX, R11)
        let f3 = self.j32(CC_GE)
        # k = hi - lo, p = d + lo
        self.alu_rr(SUB, RDX, RAX)
        self.alu_ri(CMP, RDX, 16)
        let slow = self.j32(CC_GE)
        self.alu_rr(ADD, R10, RAX)
        self.mov_rr(RCX, RDX)
        # rdx:rax = the 16 bytes; r9:r8 = them ^ them shifted down a byte
        self.mov_rm(RAX, mreg(R10, 0))
        self.mov_rm(RDX, mreg(R10, 8))
        self.mov_rr(R8, RAX)
        # shrd r8, rdx, 8
        self.rr(0, 1, 4012, RDX, R8)
        self.b(8)
        self.alu_rr(XOR, R8, RAX)
        self.mov_rr(R9, RDX)
        self.shift_i(SHR, R9, 8)
        self.alu_rr(XOR, R9, RDX)
        # rax = (p[k] ^ p[0]) << (cl = 8k), what turns byte k into p[0]
        self.rm(0, 0, 4022, RAX, Mem(base=R10, index=RCX, scale=1, disp=0, sym=-1), 0)
        self.rm(0, 0, 4022, RDX, mreg(R10, 0), 0)
        self.alu_rr(XOR, RAX, RDX)
        self.shift_i(SHL, RCX, 3)
        self.shift_cl(SHL, RAX)
        # r11 = the mask of bytes below k in its half
        self.mov_ri(R11, 1)
        self.shift_cl(SHL, R11)
        self.alu_ri(SUB, R11, 1)
        # k >= 8: the low half changes by r8, the high by r9 & r11 | rax;
        # else the low by r8 & r11 | rax, the high not at all
        self.alu_rr(AND, R9, R11)
        self.alu_rr(OR, R9, RAX)
        self.alu_rr(AND, R11, R8)
        self.alu_rr(OR, R11, RAX)
        self.rr(0, 0, 49, RDX, RDX)
        self.test_cl64()
        self.cmov(CC_E, R8, R11)
        self.cmov(CC_E, R9, RDX)
        self.alu_mr(XOR, mreg(R10, 0), R8)
        self.alu_mr(XOR, mreg(R10, 8), R9)
        self.idiom_end(x, [], [f1, f2, f3])
        let e = self.jmp32()
        self.here32(slow)
        self.idiom_call(x)
        self.here32(e)

    # brine_bytes_copy(db, nb, da, na, lo, hi): b[lo..hi] = a[lo..hi], inline
    # when that runs to b's end and is at most 16 bytes
    fn bytes_copy(ref self, x: Inst):
        self.ld(RAX, x.args[4])
        self.ld(RDX, x.args[5])
        self.alu_rr(CMP, RAX, RDX)
        let done = self.j32(CC_GE)
        self.rr(0, 1, 133, RAX, RAX)
        let f1 = self.j32(CC_S)
        self.ld(R11, x.args[3])
        self.alu_rr(CMP, RDX, R11)
        let f2 = self.j32(CC_G)
        self.ld(R11, x.args[1])
        self.alu_rr(CMP, RDX, R11)
        let f3 = self.j32(CC_G)
        let s1 = self.j32(CC_NE)
        self.mov_rr(RCX, RDX)
        self.alu_rr(SUB, RCX, RAX)
        self.alu_ri(CMP, RCX, 16)
        let s2 = self.j32(CC_G)
        self.ld(R10, x.args[2])
        self.ld(R11, x.args[0])
        let ma = Mem(base=R10, index=RAX, scale=1, disp=0, sym=-1)
        let mb = Mem(base=R11, index=RAX, scale=1, disp=0, sym=-1)
        self.mov_rm(RCX, ma)
        self.mov_mr(mb, RCX)
        self.mov_rm(RCX, moff(ma, 8))
        self.mov_mr(moff(mb, 8), RCX)
        self.idiom_end(x, [done], [f1, f2, f3])
        let e = self.jmp32()
        self.here32(s1)
        self.here32(s2)
        self.idiom_call(x)
        self.here32(e)

    # ------------------------------------------------------------ integer division
    # The runtime's integer division (see int_div_rt) inline: `/` rounds down
    # and `%` takes the sign of the divisor. A constant divisor becomes a
    # multiplication; otherwise idiv, then a branchless fix for the rounding.
    # Only the checked ones call the runtime, to panic.
    fn int_div(ref self, x: Inst):
        let k = self.vk[x.d]
        let rem = x.s.starts_with("brine_fmod_") or x.s.starts_with("brine_mod_")
        let checked = len(x.args) == 3
        if self.const_div(rem, x.args[0], x.args[1], k, k.is_signed()):
            self.st(RAX, x.d)
            return
        self.ld(RCX, x.args[1])
        self.ld(RAX, x.args[0])
        var slow: [int] = []
        if checked:
            self.rr(0, 1, 133, RCX, RCX)
            slow.push(self.j32(CC_E))
        if not k.is_signed():
            self.rr(0, 0, 49, RDX, RDX)
            self.rr(0, 1, 247, 6, RCX)
            if rem:
                self.mov_rr(RAX, RDX)
        else:
            # b = -1: idiv faults on the smallest a; the quotient is -a (the
            # checked version panics on that a), the remainder 0
            self.alu_ri(CMP, RCX, -1)
            var m1 = -1
            if checked and not rem:
                slow.push(self.j32(CC_E))
            else:
                m1 = self.j8(CC_E)
            # cqo; idiv rcx
            self.b(72)
            self.b(153)
            self.rr(0, 1, 247, 7, RCX)
            # r10 = -1 when the remainder is nonzero and its sign isn't b's:
            # then q - 1 and r + b
            self.mov_rr(R10, RDX)
            self.alu_rr(XOR, R10, RCX)
            self.shift_i(SAR, R10, 63)
            self.rr(0, 1, 133, RDX, RDX)
            self.cmov(CC_E, R10, RDX)
            if rem:
                self.alu_rr(AND, R10, RCX)
                self.alu_rr(ADD, RDX, R10)
                self.mov_rr(RAX, RDX)
            else:
                self.alu_rr(ADD, RAX, R10)
            if m1 >= 0:
                let e = self.jmp8()
                self.here8(m1)
                if rem:
                    self.rr(0, 0, 49, RAX, RAX)
                else:
                    # neg rax
                    self.rr(0, 1, 247, 3, RAX)
                self.here8(e)
        if len(slow) == 0:
            self.st(RAX, x.d)
            return
        self.st(RAX, x.d)
        let e = self.jmp32()
        for j in slow:
            self.here32(j)
        self.idiom_call(x)
        self.here32(e)

    # rax = a / c or a % c (rem) for a constant c > 1, if it's one, by a
    # multiplication: floor(n / c) = (n * m) >> p. A signed a below 0 divides
    # as ~a, which isn't: floor(a / c) = ~floor(~a / c) for c > 0.
    fn const_div(ref self, rem: bool, a: int, b: int, k: K, signed: bool) -> bool:
        if self.fold[b] != F_CONST:
            return false
        let c = self.fval[b]
        if c < 2 or c >= 1 << 61:
            return false
        let bits = 8 * k.size()
        let mp = div_magic(c, bits - 1 if signed else bits)
        if mp.1 == 0:
            return false
        self.ld(RAX, a)
        if c & (c - 1) == 0 and not signed:
            if rem:
                if fits32(c - 1):
                    self.alu_ri(AND, RAX, c - 1)
                    return true
                self.mov_ri(RCX, c - 1)
                self.alu_rr(AND, RAX, RCX)
            else:
                self.shift_i(SHR, RAX, c.trailing_zeros())
            return true
        if signed:
            self.mov_rr(R10, RAX)
            self.shift_i(SAR, R10, 63)
            self.alu_rr(XOR, RAX, R10)
        self.mov_ri(RCX, mp.0)
        # mul rcx: rdx = the high half of rax * rcx
        self.rr(0, 1, 247, 4, RCX)
        if mp.1 > 64:
            self.shift_i(SHR, RDX, mp.1 - 64)
        if signed:
            self.alu_rr(XOR, RDX, R10)
        if not rem:
            self.mov_rr(RAX, RDX)
            return true
        # a - q * c
        if fits32(c):
            self.rr(0, 1, 105, RDX, RDX)
            self.b32(c)
        else:
            self.mov_ri(RCX, c)
            self.rr(0, 1, 4015, RDX, RCX)
        self.ld(RAX, a)
        self.alu_rr(SUB, RAX, RDX)
        return true

    # ------------------------------------------------------------ conversions
    fn conv(ref self, x: Inst):
        let ks = self.vk[x.a]
        let kd = self.vk[x.d]
        if ks == kd:
            if kd.is_wide():
                self.copy16(self.vm(x.d), self.vm(x.a))
            else:
                self.set_v(x.d, x.a)
            return
        if ks.is_float() and kd.is_float():
            # cvtss2sd / cvtsd2ss
            self.xzero(0)
            self.fop(243 if ks == K.F32 else 242, 3930, 0, x.a)
            self.fst(fl_of(kd), x.d, 0)
            return
        if ks.is_wide():
            if kd.is_wide():
                self.copy16(self.vm(x.d), self.vm(x.a))
            elif kd.is_float():
                let nm = "f64" if kd == K.F64 else "f32"
                self.call_rt(f"brine_x_{w128(ks)}_to_{nm}", [CArg(how=A_ADDR, v=x.a, fl=0)])
                self.store_ret(x.d)
            else:
                self.mov_rm(RAX, self.vm(x.a))
                if kd == K.Bool:
                    self.alu_rm(OR, RAX, moff(self.vm(x.a), 8))
                    self.setcc(CC_NE, RAX)
                self.norm(RAX, kd)
                self.st(RAX, x.d)
            return
        if kd.is_wide():
            if ks.is_float():
                let nm = "f64" if ks == K.F64 else "f32"
                self.call_rt(
                    f"brine_x_{w128(kd)}_from_{nm}",
                    [CArg(how=A_ADDR, v=x.d, fl=0), CArg(how=A_VAL, v=x.a, fl=fl_of(ks))]
                )
            else:
                self.ld(RAX, x.a)
                self.st(RAX, x.d)
                if ks.is_signed():
                    self.shift_i(SAR, RAX, 63)
                else:
                    self.rr(0, 0, 49, RAX, RAX)
                self.mov_mr(moff(self.vm(x.d), 8), RAX)
            return
        if kd.is_float():
            let pfx = 242 if kd == K.F64 else 243
            self.xzero(0)
            if ks == K.U64 or ks == K.Ptr:
                # u64 to float: halve (keeping the low bit) when the top bit is set
                self.ld(RAX, x.a)
                self.rr(0, 1, 133, RAX, RAX)
                let big = self.j8(CC_S)
                self.rr(pfx, 1, 3882, 0, RAX)
                let done = self.jmp8()
                self.here8(big)
                self.mov_rr(RCX, RAX)
                self.shift_i(SHR, RCX, 1)
                self.rr(0, 0, 131, AND, RAX)
                self.b(1)
                self.alu_rr(OR, RCX, RAX)
                self.rr(pfx, 1, 3882, 0, RCX)
                self.rr(pfx, 0, 3928, 0, 0)
                self.here8(done)
            elif self.inmem(x.a):
                self.rm(pfx, 1, 3882, 0, self.vm(x.a), 0)
            else:
                self.ld(RAX, x.a)
                self.rr(pfx, 1, 3882, 0, RAX)
            self.fst(fl_of(kd), x.d, 0)
            return
        if ks.is_float():
            let pfx = 242 if ks == K.F64 else 243
            if kd == K.U64 or kd == K.Ptr:
                self.fld(fl_of(ks), 0, x.a)
                if ks == K.F64:
                    self.mov_ri(RAX, TWO63_F64)
                    self.rr(102, 1, 3950, 1, RAX)
                else:
                    self.mov_ri(RAX, TWO63_F32)
                    self.rr(102, 0, 3950, 1, RAX)
                self.rr(102 if ks == K.F64 else 0, 0, 3886, 0, 1)
                let big = self.j8(CC_AE)
                self.rr(pfx, 1, 3884, RAX, 0)
                let done = self.jmp8()
                self.here8(big)
                self.rr(pfx, 0, 3932, 0, 1)
                self.rr(pfx, 1, 3884, RAX, 0)
                self.rr(0, 1, 4026, 7, RAX)
                self.b(63)
                self.here8(done)
            elif self.freg[x.a] >= 0:
                self.rr(pfx, 1, 3884, RAX, self.freg[x.a])
                self.norm(RAX, kd)
            else:
                self.rm(pfx, 1, 3884, RAX, self.vm(x.a), 0)
                self.norm(RAX, kd)
            self.st(RAX, x.d)
            return
        # integer to integer (in d's register, but for a bool)
        let r = RAX if kd == K.Bool else self.dst(x.d)
        self.ld(r, x.a)
        if kd == K.Bool:
            self.rr(0, 1, 133, RAX, RAX)
            self.setcc(CC_NE, RAX)
        self.norm(r, kd)
        self.st(r, x.d)

# ================================================================ module

# Debug builds put the C entry point `main` right before brine's `main` (see
# `X.debug_func`).
fn emit_order(fs: [Func], dbg: bool) -> [Func]:
    if not dbg:
        return fs
    var entry = -1
    var bmain = -1
    for i, f in enumerate(fs):
        if f.public and f.dname == "":
            entry = i
        elif f.name == "main__main":
            bmain = i
    if entry < 0 or bmain < 0:
        return fs
    var out: [Func] = []
    for i, f in enumerate(fs):
        if i == bmain:
            out.push(fs[entry])
        if i != entry:
            out.push(f)
    return out

# The module as non-debug native code gets it: small functions inlined,
# slots promoted to vregs, jump tables, and in release builds the SSA
# optimizations (ssa.br).
fn optimized(m0: Module, release: bool) -> Module:
    let m = prune_rt(m0)
    var out = m
    let on = use_ssa(release)
    out.funcs = []
    let vw = vloop_width()
    let arrs = const_arrs(m)
    for f in inline_small(m.funcs):
        let (g, ks) = opt_func(f, arrs, on, vw)
        out.funcs.push(g)
        out.kernels.extend(ks)
    return out

# Release builds only, since it takes longer: `BRINE_SSA=1` or `=0` overrides.
fn use_ssa(release: bool) -> bool:
    match getenv("BRINE_SSA"):
        case Some(v):
            return v != "0"
        case None:
            return release

# The most lanes loop kernels have: eight (AVX-512); `BRINE_VLOOP=sse2` or
# `=avx2` caps them at two or four (for tests on machines with more).
fn vloop_width() -> int:
    match getenv("BRINE_VLOOP"):
        case Some(v):
            if v == "sse2":
                return 2
            if v == "avx2":
                return 4
            return 8
        case None:
            return 8

fn opt_func(f0: Func, arrs: {str: bool}, on: bool, vw: int) -> (Func, [KFunc]):
    let f = arr_data(f0, arrs)
    if on:
        let (g, ks) = ssa.optimize(promote(f), vw)
        return (switches(g), ks)
    return (switches(promote(f)), [])

fn emit_object(m: Module, windows: bool, release: bool) -> [u8]:
    return write_obj(emit(m, windows, false, use_ssa(release), "", "", ""), windows)

# The object in memory, for brine's own linker (link.br).
fn emit_obj(m: Module, windows: bool, release: bool) -> ObjFile:
    return emit(m, windows, false, use_ssa(release), "", "", "")

# The same with DWARF debug info. `src` is the main source file, `comp_dir`
# the directory relative source paths start from.
fn emit_obj_debug(m: Module, windows: bool, src: str, comp_dir: str, producer: str) -> ObjFile:
    return emit(m, windows, true, false, src, comp_dir, producer)

fn write_obj(o0: ObjFile, windows: bool) -> [u8]:
    var o = o0
    if windows:
        return write_coff(ref o)
    return write_elf(ref o)

fn emit(
    m0: Module,
    windows: bool,
    dbg: bool,
    on: bool,
    src: str,
    comp_dir: str,
    producer: str
) -> ObjFile:
    let m = prune_rt(m0)
    var x = X(
        win=windows,
        o=new_obj(),
        syms={},
        wide_ret={},
        wide_rt=wide_rt_helpers(),
        text_sym=0,
        xdata_sym=0,
        ovf=[-1, -1, -1],
        fpool={},
        vpool={},
        cpu_sym=-1,
        code=[],
        dead=[],
        lrefs=[],
        vk=[],
        nparams=0,
        home=[],
        reg=[],
        saved=[],
        freg=[],
        fsaved=[],
        fsave_at=[],
        keep=[],
        cold={},
        fold=[],
        fval=[],
        nuse=[],
        slot_off=[],
        slot_base=[],
        ploc=[],
        lpos=[],
        jat=[],
        jlab=[],
        tat=[],
        tlab=[],
        tbase=[],
        stubs=[],
        retp=0,
        creg=0,
        cv=-1,
        cpos=-1,
        cstore=-1,
        cinst=-1,
        cur=0,
        once=[],
        scratch=0,
        has_ret=false,
        ret=K.I64,
        u=Unw(start=0, pushes=[], pad=-1, fp=0, alloc=0, grow=0, pro_end=0, epis=[]),
        dbg=dbg,
        dw=new_dwarf(),
        ipos=[],
        rows=[],
        entry_main=false,
        entry=(-1, -1)
    )
    for n in m.cold:
        x.cold[n] = true
    x.text_sym = x.sym_def("__brx_text", SEC_TEXT, 0, false, false)
    if windows:
        x.xdata_sym = x.sym_def("__brx_xdata", SEC_UNWIND, 0, false, false)
    else:
        elf_cie(ref x.o.unwind)
    for f in m.funcs:
        x.sym_def(f.name, SEC_TEXT, 0, f.public or f.export, true)
        if f.has_ret and f.ret.is_wide():
            x.wide_ret[f.name] = true
    for d in m.data:
        # ELF: read-only data with addresses in it goes to .data (PIE)
        let ro = d.readonly and (windows or len(d.relocs) == 0)
        let a = max(d.align, 1)
        var base = 0
        if ro:
            while len(x.o.rodata) % a != 0:
                x.o.rodata.push(0)
            x.o.rodata_align = max(x.o.rodata_align, a)
            base = len(x.o.rodata)
            x.sym_def(d.name, SEC_RODATA, base, false, false)
            x.o.rodata.extend(d.bytes)
        else:
            while len(x.o.data) % a != 0:
                x.o.data.push(0)
            x.o.data_align = max(x.o.data_align, a)
            base = len(x.o.data)
            # (the runtime's variables C reads too)
            x.sym_def(d.name, SEC_DATA, base, d.name.starts_with("brine_"), false)
            x.o.data.extend(d.bytes)
        for r in d.relocs:
            let rel = ORel(off=base + r.off, sym=x.sym_ref(r.sym), kind=R_ABS64, add=r.add)
            if ro:
                x.o.rrel.push(rel)
            else:
                x.o.drel.push(rel)
    x.entry_main = dbg and any(f.name == "main__main" for f in m.funcs)
    var ks = m.kernels
    let vw = vloop_width()
    if dbg:
        for f in emit_order(m.funcs, dbg):
            x.func(f)
    else:
        # each function is optimized on its own, so all at once
        let fs = inline_small(m.funcs)
        let arrs = const_arrs(m)
        let done = par [opt_func(f, arrs, on, vw) for f in fs]
        for (g, fks) in done:
            x.func(g)
            ks.extend(fks)
    for k in ks:
        x.kernel(k)
    # references inside .text need no relocation
    var keep: [ORel] = []
    for r in x.o.trel:
        let s = x.o.syms[r.sym]
        if s.sec == SEC_TEXT:
            set32(ref x.o.text, r.off, s.off + r.add - r.off)
        else:
            keep.push(r)
    x.o.trel = keep
    if dbg:
        write_dwarf(ref x.o, x.dw, m.dtypes, x.text_sym, src, comp_dir, producer)
    return x.o
