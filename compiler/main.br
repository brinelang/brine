# brine — the brine language toolchain, written in brine.
#
# Hidden commands, for looking at (and testing) each stage:
#   brine lex [--comments] <file>       tokens
#   brine parse <file>                  syntax tree
#   brine emit-c [--tests] [--debug] <file> -o <out.c>   generated C
#   brine emit-ir [--tests] [--release] [--opt] <file> [-o <out>]   the IR (--opt: as the native backend gets it)
import diag
from diag import Diag, Colors, SourceMap, json_str, best_match
import lexer
import parser
import astdump
import driver
from driver import FrontOpts, Frontend, Profile, Platform, display_path, VERSION
import verify
import project
import fmt
import explain
import specdiff
from info import builtin_module
import rules

const GUIDE = embed("../docs/QUICKREF.md")

fn help_text() -> str:
    return "\n".join(
        [
            "brine — a verified, natively parallel systems language",
            "",
            "Usage: brine <command> [options]",
            "",
            "Project:",
            "  new <name>            Create a new project in ./<name>",
            "  init                  Create a project in the current directory",
            "",
            "Build and run:",
            "  run [file] [-- args]  Build and run (default: the current project)",
            "      --release           optimize more",
            "      --threads <n>       worker threads for `par` (default: all cores)",
            "      --ranks <n>         run <n> cooperating processes (the `world` module)",
            "      --target wasm       build WebAssembly and run it with Node.js",
            "  build [file]          Build a native executable",
            "      --release | --debug   optimization profile (default: dev)",
            "      -o <path>             output path",
            "      --emit-c              also write the generated C next to the output",
            "      --target <t>          host (default), wasm (a .wasm module) or web (a page)",
            "  check [file]          Type-check and verify without building (fastest)",
            "      --report              list every runtime check the prover could not remove",
            "  rules [file]          Show which rules in RULES.br are proven (every build proves them)",
            "      approve               record that the rules' owner approves them (RULES.lock)",
            "      --explain             the rules in plain English",
            "      --receipt             a summary for a pull request (Markdown)",
            "      --base <rev>          also list the approvals made since a git revision",
            "  test [file] [filter]  Run `test \"...\":` blocks in parallel (also --target wasm)",
            "      --timeout <s>       stop a test after <s> seconds (default 300; 0: no limit)",
            "  debug [file] [-- args]  Debug build, then launch gdb or lldb",
            "",
            "Tools:",
            "  fmt [files] [--check] Format source files (default: the whole project)",
            "  spec-diff [file]      Show how the specs changed since a git revision",
            "      --base <rev>          the revision to compare with (default: HEAD)",
            "  explain <code>        Explain an error code, e.g. `brine explain E0601`",
            "  guide                 Print the language quick reference",
            "  doctor                Check that your toolchain works",
            "  version               Print the version",
            "",
            "Global options:",
            "  --json                Machine-readable output (one JSON object per line)",
            "  --color <when>        auto | always | never",
            "  -q, --quiet           Only print errors",
            "",
            "`brine <command> --help` describes one command."
        ]
    )

const GLOBAL_OPTS = "Global options: --json (one JSON object per line), --color auto|always|never, -q/--quiet"

# `brine <command> --help` and `brine help <command>`.
fn usage(cmd: str) -> Option[str]:
    var ls: [str] = []
    if cmd == "new":
        ls = [
            "Usage: brine new <name>",
            "",
            "Create a project in ./<name>: brine.toml, src/main.br, RULES.br (what the",
            "program promises, proven on every build; it starts with no rules),",
            "AGENTS.md, README.md and .gitignore, and a git repository unless it is",
            "inside one already."
        ]
    elif cmd == "init":
        ls = [
            "Usage: brine init",
            "",
            "Create a project in the current directory, named after it. A main.br",
            "there stays the main file, and an existing .gitignore gets `/target`."
        ]
    elif cmd == "run":
        ls = [
            "Usage: brine run [file | folder] [options] [-- program arguments]",
            "",
            "Build and run a program (default: the current project).",
            "",
            "Options:",
            "  --release           optimize more",
            "  --debug             no optimization, with debug info",
            "  --threads <n>       worker threads for `par` (default: all cores)",
            "  --ranks <n>         run <n> cooperating processes (the `world` module)",
            "  --target wasm       build WebAssembly and run it with Node.js",
            "  --typed             require a written type on every variable",
            "  --proven            make every runtime check the prover can't remove an error"
        ]
    elif cmd == "build":
        ls = [
            "Usage: brine build [file | folder] [options]",
            "",
            "Build an executable (default: the current project, into target/<profile>/).",
            "",
            "Options:",
            "  --release | --debug   optimization profile (default: dev)",
            "  -o <path>             output path",
            "  --emit-c              also write the generated C next to the output",
            "  --target <t>          host (default), wasm (a .wasm module) or web (a page)",
            "  --typed               require a written type on every variable",
            "  --proven              make every runtime check the prover can't remove an error"
        ]
    elif cmd == "check":
        ls = [
            "Usage: brine check [file | folder] [options]",
            "",
            "Type-check and verify without building (fastest). In a project, every .br",
            "file next to the main file and below is checked, imported or not, and the",
            "main file needs a `main`, as for `brine run`. A lone file without `main` is",
            "checked as a module.",
            "",
            "Options:",
            "  --report            list every runtime check the prover could not remove",
            "  --typed             require a written type on every variable",
            "  --proven            make every runtime check the prover can't remove an error"
        ]
    elif cmd == "rules":
        ls = [
            "Usage: brine rules [approve] [file | folder] [options]",
            "",
            "Report on RULES.br: each rule is proven or not, and approved by its owner",
            "or not. Every build, run, test and check already proves the rules and fails",
            "if one isn't; this command shows them all at once. Exits 1 unless every rule",
            "is proven and approved.",
            "",
            "`brine rules approve` records that the rules' owner agrees with RULES.br and",
            "the vocabulary in rules/, in RULES.lock. A rule or vocabulary file that",
            "changes, or goes away, after approval stops the build until it is approved",
            "again; a new rule only warns. Put RULES.br, rules/ and RULES.lock under",
            "CODEOWNERS, so only the owner can approve.",
            "",
            "Options:",
            "  --explain           the rules in plain English, rendered from their code",
            "  --receipt           a one-page summary for a pull request (Markdown)",
            "  --base <rev>        also list what was approved since a git revision",
            "  --typed             require a written type on every variable",
            "  --proven            make every runtime check the prover can't remove an error"
        ]
    elif cmd == "spec-diff":
        ls = [
            "Usage: brine spec-diff [file | folder] [--base <rev>]",
            "",
            "Compare every `requires`, `ensures` and struct `invariant` with the same",
            "file in a git revision (default: HEAD), asking the prover whether each",
            "promise got weaker or stronger, and count the runtime checks left before",
            "and after. Fails (exit 1) when a function promises less (an `ensures` or",
            "`invariant` lost) or asks more of its callers (a new `requires`): run it in",
            "CI against the base branch to catch a change that makes proofs pass by",
            "weakening what they prove.",
            "",
            "Options:",
            "  --base <rev>        the git revision to compare with (default: HEAD)"
        ]
    elif cmd == "test":
        ls = [
            "Usage: brine test [file | folder] [filter] [options]",
            "",
            "Run the `test \"...\":` blocks whose name contains <filter>, each in its own",
            "process, in parallel.",
            "",
            "Options:",
            "  --release           optimize more",
            "  --target wasm       build WebAssembly and run the tests with Node.js",
            "  --timeout <s>       stop a test after <s> seconds (default 300; 0: no limit)",
            "  --typed             require a written type on every variable",
            "  --proven            make every runtime check the prover can't remove an error"
        ]
    elif cmd == "debug":
        ls = [
            "Usage: brine debug [file | folder] [-- program arguments]",
            "",
            "Make a debug build and start it under gdb or lldb."
        ]
    elif cmd == "fmt":
        ls = [
            "Usage: brine fmt [files or folders] [--check]",
            "",
            "Format source files in place (default: the whole project). Lines between",
            "`# fmt: off` and `# fmt: on` comments are left as they are, and so are",
            "lists of numbers written in rows.",
            "",
            "Options:",
            "  --check             change nothing; list the files that need formatting",
            "                      and fail if there are any"
        ]
    elif cmd == "explain":
        ls = [
            "Usage: brine explain <code>",
            "",
            "Explain an error code, e.g. `brine explain E0601`."
        ]
    elif cmd == "guide":
        ls = ["Usage: brine guide", "", "Print the language quick reference."]
    elif cmd == "doctor":
        ls = ["Usage: brine doctor", "", "Check that the toolchain (and the optional tools) work."]
    elif cmd == "version":
        ls = ["Usage: brine version", "", "Print the version."]
    elif cmd == "help":
        ls = ["Usage: brine help [command]", "", "Describe brine, or one command."]
    else:
        return None
    ls.extend(["", GLOBAL_OPTS])
    return Some("\n".join(ls))

# Print text that already ends with a newline (`print` adds one).
fn out_text(s: str):
    if s.ends_with("\n"):
        print(s[:len(s) - 1])
    elif s != "":
        print(s)

# Text a command prints, or with `--json` one object `{"<key>": "<text>"}`.
fn text_or_json(g: G, key: str, s: str):
    if g.json:
        print("{" + json_str(key) + ":" + json_str(s) + "}")
    else:
        out_text(s)

fn err_text(s: str):
    if s.ends_with("\n"):
        eprint(s[:len(s) - 1])
    elif s != "":
        eprint(s)

fn plural(n: int) -> str:
    return "" if n == 1 else "s"

# Why a program stopped, when its exit code is not one it could return:
# Windows reports a crash as an NTSTATUS code (0xC00000FD, ...), negative
# as a 32-bit number.
fn crash_reason(code: int) -> Option[str]:
    let c = code & 0xFFFFFFFF
    # only an NTSTATUS error (or a breakpoint) is a crash: any other code is
    # the program's own, like `exit(300)` or `exit(-1)`
    if (c < 0xC0000000 and c != 0x80000003) or c == 0xFFFFFFFF:
        return None
    let names = [
        (0xC0000005, "access violation: a bad pointer or a native stack overflow"),
        (0xC00000FD, "stack overflow: recursion too deep?"),
        (0xC0000094, "integer division by zero"),
        (0xC0000095, "integer overflow"),
        (0xC000001D, "illegal instruction: built for a newer CPU?"),
        (0xC0000409, "the program aborted"),
        (0xC0000374, "heap corruption"),
        (0xC000013A, "interrupted (Ctrl+C)"),
        (0x80000003, "breakpoint")
    ]
    for k, what in names:
        if c == k:
            return Some(f"exit code 0x{c:08x}, {what}")
    return Some(f"exit code 0x{c:08x}")

# The exit code `brine` returns for a program's: a crash is a failure, as
# on Unix, where a program killed by a signal reports 101.
fn exit_status(code: int) -> int:
    return 101 if crash_reason(code).is_some() else code

# ================================================================ output

# The code of an error the command line reports without a diagnostic of its
# own: E0709 when a program couldn't be started or crashed, E0708 for the
# rest (an unknown command or option, a bad value, a missing file).
fn cli_code(msg: str) -> str:
    let run = ["could not start", "cannot reserve local ports", "could not list the tests"]
    if any(msg.starts_with(p) for p in run) or msg.starts_with("the program crashed"):
        return "E0709"
    return "E0708"

struct G:
    json: bool
    color: bool
    quiet: bool

    fn c(self) -> Colors:
        return Colors(on=self.color)

    fn status(self, verb: str, msg: str):
        if self.quiet or self.json:
            return
        let c = self.c()
        eprint(f"{c.bold()}{c.green()}{verb:>10}{c.reset()} {msg}")

    fn error(self, msg: str):
        if self.json:
            print(diag.report_json(true, cli_code(msg), msg, [], [], [], ""))
        else:
            let c = self.c()
            eprint(f"{c.bold()}{c.red()}error{c.reset()}{c.bold()}: {msg}{c.reset()}")

    fn diags(self, fe: Frontend):
        self.diag_list(fe.diags, fe.sm)

    fn diag_list(self, ds: [Diag], sm: SourceMap):
        for d in ds:
            if self.quiet and not d.is_error():
                continue
            if self.json:
                print(diag.to_json(d, sm))
            else:
                err_text(diag.render(d, sm, self.color))
        if not self.json:
            var errs = 0
            for d in ds:
                if d.is_error():
                    errs += 1
            let warns = len(ds) - errs
            if errs > 0:
                let c = self.c()
                let w = f" and {warns} warning{plural(warns)}" if warns > 0 else ""
                eprint(
                    f"{c.bold()}{c.red()}error{c.reset()}{c.bold()}: could not compile due to {errs} error{plural(errs)}{w}{c.reset()}"
                )

# ================================================================ arguments

struct Args:
    pos: [str]
    flags: [(str, Option[str])]
    rest: [str]

    fn has(self, f: str) -> bool:
        return any(k.0 == f for k in self.flags)

    fn val(self, f: str) -> Option[str]:
        var i = len(self.flags) - 1
        while i >= 0:
            if self.flags[i].0 == f:
                return self.flags[i].1
            i -= 1
        return None

    fn check_flags(self, allowed: [str]) -> Result[(), str]:
        let global = ["--json", "--color", "-q", "--quiet"]
        for kv in self.flags:
            let k = kv.0
            if k in allowed or k in global:
                no_value(k, kv.1)?
            else:
                var all = allowed
                all.extend(global)
                var hint = ""
                match best_match(k, all):
                    case Some(m):
                        hint = f" (did you mean `{m}`?)"
                    case None:
                        pass
                return Err(f"unknown option `{k}`{hint}")
        return Ok(())

# The options that take a value (`-o out`, `--target=wasm`).
const VALUE_FLAGS = ["--ranks", "--threads", "-o", "--color", "--target", "--timeout", "--base"]

# An option that is on or off has no value: `--json=false` would turn it on.
fn no_value(k: str, v: Option[str]) -> Result[(), str]:
    match v:
        case Some(x):
            if k not in VALUE_FLAGS:
                return Err(
                    f"`{k}` takes no value (`{k}={x}`): write `{k}` to turn it on, or leave it out"
                )
        case None:
            pass
    return Ok(())

fn parse_args(raw: [str]) -> Result[Args, str]:
    let value_flags = VALUE_FLAGS
    var a = Args(pos=[], flags=[], rest=[])
    var i = 0
    while i < len(raw):
        let s = raw[i]
        if s == "--":
            a.rest = raw[i + 1:]
            break
        if s.starts_with("-") and len(s) > 1:
            match s.find("="):
                case Some(eq):
                    a.flags.push((s[:eq], Some(s[eq + 1:])))
                case None:
                    if s in value_flags:
                        if i + 1 >= len(raw):
                            return Err(f"`{s}` needs a value")
                        # `-o --json` is a forgotten value, not a file named `--json`
                        let v = raw[i + 1]
                        if v.starts_with("-") and len(v) > 1 and v != "--":
                            return Err(f"`{s}` needs a value, but `{v}` follows it")
                        a.flags.push((s, Some(raw[i + 1])))
                        i += 1
                    else:
                        a.flags.push((s, None))
        else:
            a.pos.push(s)
        i += 1
    return Ok(a)

fn main() -> int:
    match without_gpu_log():
        case Some(code):
            return code
        case None:
            pass
    var a = Args(pos=[], flags=[], rest=[])
    let raw = args()
    var bad = ""
    match parse_args(raw):
        case Ok(x):
            a = x
            for f in ["--json", "-q", "--quiet"]:
                match no_value(f, a.val(f)):
                    case Err(e):
                        bad = e
                    case Ok(_):
                        pass
        case Err(e):
            bad = e
    if bad != "":
        let jg = G(json="--json" in raw, color=false, quiet=false)
        jg.error(bad)
        return 2
    var color = false
    match a.val("--color"):
        case Some("always"):
            color = true
        case Some("never"):
            color = false
        case _:
            color = getenv("NO_COLOR").is_none() and os.is_terminal(2)
    if color:
        os.enable_ansi()
    let g = G(json=a.has("--json"), color=color, quiet=a.has("-q") or a.has("--quiet"))
    if len(a.pos) == 0:
        if a.has("--version") or a.has("-V"):
            if g.json:
                print("{\"version\":" + json_str(VERSION) + "}")
            else:
                print(f"brine {VERSION}")
        else:
            text_or_json(g, "help", help_text())
        return 0
    let cmd = a.pos[0]
    let rest = Args(pos=a.pos[1:], flags=a.flags, rest=a.rest)
    # `brine <command> --help`, `brine help <command>`
    var about = cmd if a.has("--help") or a.has("-h") else ""
    if cmd == "help" and len(rest.pos) > 0:
        about = rest.pos[0]
    if about != "":
        match usage(about):
            case Some(u):
                text_or_json(g, "help", u)
                return 0
            case None:
                match hidden_usage(about):
                    case Some(u):
                        text_or_json(g, "help", u)
                        return 0
                    case None:
                        pass
                if cmd == "help":
                    g.error(f"unknown command `{about}` (see `brine help`)")
                    return 2
    var r: Result[int, str] = Ok(0)
    if cmd == "new":
        r = cmd_new(g, rest)
    elif cmd == "init":
        r = cmd_init(g, rest)
    elif cmd == "run":
        r = cmd_run(g, rest)
    elif cmd == "build":
        r = cmd_build(g, rest)
    elif cmd == "check":
        r = cmd_check(g, rest)
    elif cmd == "test":
        r = cmd_test(g, rest)
    elif cmd == "debug":
        r = cmd_debug(g, rest)
    elif cmd == "fmt":
        r = cmd_fmt(g, rest)
    elif cmd == "spec-diff":
        r = cmd_spec_diff(g, rest)
    elif cmd == "rules":
        r = cmd_rules(g, rest)
    elif cmd == "explain":
        r = explain.explain_cmd(first_pos(rest), g.json)
    elif cmd == "guide":
        text_or_json(g, "guide", GUIDE)
    elif cmd == "doctor":
        r = cmd_doctor(g)
    elif cmd == "lex":
        r = cmd_lex(rest)
    elif cmd == "parse":
        r = cmd_parse(rest)
    elif cmd == "emit-c":
        r = cmd_emit_c(g, rest)
    elif cmd == "emit-ir":
        r = cmd_emit_ir(g, rest)
    elif cmd == "version" or cmd == "--version" or cmd == "-V":
        if g.json:
            print("{\"version\":" + json_str(VERSION) + "}")
        else:
            print(f"brine {VERSION}")
    elif cmd == "help" or cmd == "--help" or cmd == "-h":
        text_or_json(g, "help", help_text())
    else:
        let cmds = [
            "new",
            "init",
            "run",
            "build",
            "check",
            "rules",
            "test",
            "debug",
            "fmt",
            "spec-diff",
            "explain",
            "guide",
            "doctor",
            "version",
            "help"
        ]
        var hint = ""
        match best_match(cmd, cmds):
            case Some(m):
                hint = f"; did you mean `brine {m}`?"
            case None:
                pass
        r = Err(f"unknown command `{cmd}`{hint} (see `brine help`)")
    match r:
        case Ok(code):
            return exit_status(code)
        case Err(e):
            g.error(e)
            return 2

# ================================================================ targets

struct Target:
    entry: str
    name: str
    # project root, if any
    root: Option[str]
    # project version, if any
    version: Option[str]
    # every variable needs a written type
    typed: bool
    # every runtime check must be proven away
    proven: bool

    # `--typed` and `--proven` ask for those even outside such a project.
    fn typed_if(self, a: Args) -> Target:
        var t = self
        t.typed = t.typed or a.has("--typed")
        t.proven = t.proven or a.has("--proven")
        return t

    fn cache_dir(self) -> str:
        match self.root:
            case Some(r):
                return project.join(project.join(r, "target"), "cache")
            case None:
                return project.join(os.temp_dir(), "brine-cache")

    fn out_dir(self, p: Profile, plat: Platform) -> str:
        match self.root:
            case Some(r):
                return project.join(project.join(r, "target"), driver.out_name(p, plat))
            case None:
                let abs = os.abs_path(self.entry).unwrap_or(self.entry)
                let base = project.join(os.temp_dir(), "brine-cache")
                return project.join(
                    project.join(base, driver.hex16(driver.fnv(abs))),
                    driver.out_name(p, plat)
                )

# W0004: keys and sections in brine.toml that brine doesn't read (typos, mostly).
fn toml_warnings(g: G, pr: project.Project):
    if len(pr.unknown) == 0:
        return
    var sm = SourceMap.new()
    let f = sm.add(display_path(project.join(pr.root, "brine.toml")), pr.toml)
    var ds: [Diag] = []
    for lo, hi, msg, help in pr.unknown:
        ds.push(
            diag.warning("W0004", msg)
            .label(diag.Span(file=f, lo=lo, hi=hi), "not read")
            .note("brine ignores it, so it changes nothing")
            .with_help(help)
        )
    g.diag_list(ds, sm)

fn resolve(g: G, file: Option[str]) -> Result[Target, str]:
    match file:
        case Some(f):
            if os.is_dir(f):
                # a plain folder of .br files: run its main.br
                if (
                    not file_exists(project.join(f, "brine.toml"))
                    and os.is_file(project.join(f, "main.br"))
                ):
                    var name = "main"
                    match os.abs_path(f):
                        case Ok(abs):
                            name = project.file_name(abs).unwrap_or("main")
                        case Err(_):
                            pass
                    return Ok(
                        Target(
                            entry=project.join(f, "main.br"),
                            name=name,
                            root=None,
                            version=None,
                            typed=false,
                            proven=false
                        )
                    )
                match project.find(f):
                    case Some(Ok(pr)):
                        toml_warnings(g, pr)
                        return Ok(
                            Target(
                                entry=pr.main,
                                name=pr.name,
                                root=Some(pr.root),
                                version=Some(pr.version),
                                typed=pr.typed,
                                proven=pr.proven
                            )
                        )
                    case Some(Err(e)):
                        return Err(e)
                    case None:
                        return Err(f"`{f}` is not a brine project (no brine.toml or main.br)")
            if not file_exists(f):
                var hint = ""
                if not f.ends_with(".br") and file_exists(f + ".br"):
                    hint = f"; did you mean `{f}.br`?"
                return Err(f"file `{f}` not found{hint}")
            var stem = driver.file_stem(f)
            if stem == "":
                stem = "main"
            return Ok(
                Target(entry=f, name=stem, root=None, version=None, typed=false, proven=false)
            )
        case None:
            pass
    let cwd = os.cwd()
    match project.find(cwd):
        case Some(Ok(pr)):
            toml_warnings(g, pr)
            if not file_exists(pr.main):
                return Err("the project's main file `" + display_path(pr.main) + "` does not exist")
            var entry = pr.main
            let n = len(cwd)
            if len(entry) > n and entry.starts_with(cwd) and project.sep_at(entry, n):
                entry = entry[n + 1:]
            return Ok(
                Target(
                    entry=entry,
                    name=pr.name,
                    root=Some(pr.root),
                    version=Some(pr.version),
                    typed=pr.typed,
                    proven=pr.proven
                )
            )
        case Some(Err(e)):
            return Err(e)
        case None:
            return Err(
                "no brine.toml found in this directory or any parent; pass a file (`brine run hello.br`) or create a project with `brine new <name>`"
            )

fn profile_of(a: Args) -> Profile:
    if a.has("--release"):
        return Profile.Release
    if a.has("--debug"):
        return Profile.Debug
    return Profile.Dev

# `--target host|wasm|web` (default: host).
fn platform_of(a: Args) -> Result[Platform, str]:
    match a.val("--target"):
        case Some(v):
            match driver.parse_platform(v):
                case Some(p):
                    return Ok(p)
                case None:
                    return Err(f"unknown target `{v}` (use host, wasm or web)")
        case None:
            return Ok(Platform.Host)

fn first_pos(a: Args) -> Option[str]:
    return Some(a.pos[0]) if len(a.pos) > 0 else None

fn build(
    g: G,
    t: Target,
    profile: Profile,
    tests: bool,
    out: Option[str],
    emit_c: bool,
    plat: Platform
) -> Result[Option[str], str]:
    let t0 = clock()
    # the tests of a project are in all its files, as `check` sees them
    let fe = driver.frontend_at(
        t.entry,
        FrontOpts(
            verify=true,
            need_main=not tests,
            check_main=not tests,
            typed=t.typed,
            proven=t.proven,
            strict_rules=driver.strict_rules(profile == Profile.Release)
        ),
        whole_project(t) if tests else driver.on_disk()
    )
    g.diags(fe)
    if fe.has_errors():
        return Ok(None)
    rules_line(g, fe)
    let code = driver.gen_code(fe, profile, tests, plat)
    let stem = t.name + "-tests" if tests else t.name
    var exe = ""
    match out:
        case Some(o):
            exe = o
        case None:
            exe = project.join(t.out_dir(profile, plat), driver.out_file(stem, plat))
    if emit_c:
        let cp = driver.with_extension(exe, "c")
        match project.parent(cp):
            case Some(d):
                if d != "":
                    match os.make_dir(d):
                        case _:
                            pass
            case None:
                pass
        write_file(cp, driver.gen_c(fe, profile, tests, plat))?
        g.status("Wrote", display_path(cp))
    # its cache entries stay pinned until the caller has started the program
    # (`release`): a prune in between would delete it (v091#3)
    let cache = t.cache_dir()
    driver.cache_start(cache, exe)
    let built = driver.compile(code, exe, cache, profile, plat)
    if built.is_err():
        driver.cache_done(cache, exe)
    match built:
        case Ok(ran):
            if ran or not tests:
                var what = t.name
                if tests:
                    what = "tests"
                else:
                    match t.version:
                        case Some(v):
                            what = f"{t.name} v{v}"
                        case None:
                            pass
                let verb = "Built" if ran else "Fresh"
                let kind = (
                    profile.name() if plat == Platform.Host else f"{profile.name()}, {plat.name()}"
                )
                g.status(verb, f"{what} [{kind}] in {clock() - t0:.2f}s")
            return Ok(Some(exe))
        case Err(d):
            g.diag_list([d], fe.sm)
            return Ok(None)

# Unpins what `build` made, once its program has started, and prunes the cache.
fn release(t: Target, exe: str):
    driver.cache_done(t.cache_dir(), exe)

# ================================================================ commands

fn cmd_new(g: G, a: Args) -> Result[int, str]:
    a.check_flags([])?
    if len(a.pos) == 0:
        return Err("usage: brine new <name>")
    let name = a.pos[0]
    if not project.valid_name(name):
        return Err(f"`{name}` {project.NAME_RULE}")
    if file_exists(name):
        return Err(f"`{name}` already exists")
    project.create(name, name)?
    if g.json:
        print("{\"created\":" + json_str(name) + "}")
    else:
        g.status("Created", f"project `{name}`")
        if not g.quiet:
            eprint(f"\n    cd {name}\n    brine run\n")
    return Ok(0)

fn cmd_init(g: G, a: Args) -> Result[int, str]:
    a.check_flags([])?
    let cwd = os.cwd()
    let raw = project.file_name(cwd).unwrap_or("app")
    var mapped = ""
    for c in raw.chars():
        if project.is_ascii_alpha(c) or project.is_ascii_digit(c) or c == "_" or c == "-":
            mapped += c
        else:
            mapped += "_"
    let name = mapped if project.valid_name(mapped) else "app_" + mapped
    let made = project.create(cwd, name)?
    let list = ", ".join(made)
    g.status("Created", f"project `{name}` ({list})")
    return Ok(0)

fn cmd_build(g: G, a: Args) -> Result[int, str]:
    a.check_flags(["--release", "--debug", "-o", "--emit-c", "--typed", "--proven", "--target"])?
    let plat = platform_of(a)?
    let t = resolve(g, first_pos(a))?.typed_if(a)
    var out: Option[str] = None
    # `-o /dev/null` (Git Bash hands Windows programs `nul`): build, keep nothing
    var discard = false
    match a.val("-o"):
        case Some(o):
            var p = o
            let n = project.file_name(p).unwrap_or("")
            if o.lower() in ["/dev/null", "nul", "nul:", "\\\\.\\nul"]:
                discard = true
            elif driver.file_stem(p) == n and project.is_windows() and plat == Platform.Host:
                p = p + ".exe"
            if not discard:
                out = Some(p)
        case None:
            # single files build next to where you are, like a C compiler would
            if t.root.is_none():
                out = Some(driver.out_file(t.name, plat))
    match build(g, t, profile_of(a), false, out, a.has("--emit-c"), plat)?:
        case Some(exe):
            release(t, exe)
            if discard:
                if g.json:
                    print("{\"built\":null}")
                return Ok(0)
            if g.json:
                print("{\"built\":" + json_str(display_path(exe)) + "}")
            else:
                g.status("Output", display_path(exe))
                if plat == Platform.Web and not g.quiet:
                    let d = display_path(exe)
                    eprint(
                        f"\nOpen its index.html over HTTP, e.g. `python3 -m http.server -d {d}` and http://localhost:8000"
                    )
            return Ok(0)
        case None:
            return Ok(1)

# `BRINE_GPU_LOG` is for the program being run, not for the compiler's own
# `par` constructs. The runtime reads it at startup, so when it's set the
# compiler runs itself again with it off and hands it on to the programs it
# starts.
const GPU_LOG_KEPT = "BRINE_GPU_LOG_PROGRAM"

fn without_gpu_log() -> Option[int]:
    match getenv("BRINE_GPU_LOG"):
        case Some(v):
            if v == "" or v == "0":
                return None
            var cmd = [os.exe_path()]
            cmd.extend(args())
            match os.spawn(cmd, {"BRINE_GPU_LOG": "0", GPU_LOG_KEPT: v}, false, true):
                case Ok(p):
                    return Some(exit_status(os.wait(p)))
                case Err(_):
                    return None
        case None:
            return None

fn spawn_env(threads: Option[str]) -> {str: str}:
    var env: {str: str} = {}
    match getenv(GPU_LOG_KEPT):
        case Some(v):
            env["BRINE_GPU_LOG"] = v
        case None:
            pass
    match threads:
        case Some(t):
            env["BRINE_THREADS"] = t
        case None:
            pass
    return env

# Why `path` didn't start (as `what`): when it is gone, say that it is.
fn start_error(what: str, path: str, e: str) -> str:
    if ("/" in path or "\\" in path) and not file_exists(path):
        return f"could not start {what}: `{path}` does not exist"
    return f"could not start {what}: {e}"

# `launch` is the program (or the WebAssembly runner and the module).
# `panics`, if not "": where a rank writes its panic (`panic_file`).
# Once it has started, `t`'s cache entries for `exe` are released.
fn run_exe(
    launch: [str],
    argv: [str],
    threads: Option[str],
    ranks: int,
    panics: str,
    t: Target,
    exe: str
) -> Result[int, str]:
    var cmd = launch
    cmd.extend(argv)
    if ranks <= 1:
        var env = spawn_env(threads)
        if panics != "":
            env["BRINE_PANIC_FILE"] = panic_file(panics, 0, 1)
        let sp = os.spawn(cmd, env, false, true)
        release(t, exe)
        match sp:
            case Ok(p):
                return Ok(os.wait(p))
            case Err(e):
                return Err(start_error(launch[0], launch[0], e))
    # the ranks share the machine: by default, each gets its share of the cores
    var th = threads
    if th.is_none() and getenv("BRINE_THREADS").is_none():
        th = Some(f"{max(1, os.cpu_count() / ranks)}")
    var ports: [int] = []
    match os.free_ports(ranks):
        case Ok(ps):
            ports = ps
        case Err(e):
            release(t, exe)
            return Err(f"cannot reserve local ports: {e}")
    let peers = ",".join([f"127.0.0.1:{p}" for p in ports])
    # a rank that calls `exit` with an error code waits there for the others,
    # so it writes the code to its file: that counts as failing
    let exits = project.join(os.temp_dir(), f"brine-exit-{os.pid()}")
    var kids: [int] = []
    for r in 0..ranks:
        var env = spawn_env(th)
        env["BRINE_RANK"] = f"{r}"
        env["BRINE_WORLD_SIZE"] = f"{ranks}"
        env["BRINE_PEERS"] = peers
        env["BRINE_EXIT_FILE"] = f"{exits}.{r}"
        match os.remove_file(f"{exits}.{r}"):
            case _:
                pass
        if panics != "":
            env["BRINE_PANIC_FILE"] = panic_file(panics, r, ranks)
        match os.spawn(cmd, env, false, r == 0):
            case Ok(p):
                kids.push(p)
            case Err(e):
                for k in kids:
                    os.kill(k)
                    os.wait(k)
                release(t, exe)
                return Err(start_error(f"rank {r} ({launch[0]})", launch[0], e))
    release(t, exe)
    var codes: [Option[int]] = [None] * ranks
    # the first rank that failed: usually the cause, the others only lost it
    var first = -1
    var first_code = 0
    var failed_at = -1.0
    var stopped = false
    var tick = 0
    while true:
        for i in 0..ranks:
            if codes[i].is_none():
                match os.poll(kids[i]):
                    case Some(c):
                        codes[i] = Some(c)
                        if c != 0 and first < 0:
                            first = i
                            first_code = c
                            failed_at = clock()
                    case None:
                        # (every 50 ms)
                        if first < 0 and tick % 10 == 0:
                            match read_file(f"{exits}.{i}"):
                                case Ok(text):
                                    match parse_int(text.strip()):
                                        case Some(c):
                                            if c != 0:
                                                first = i
                                                first_code = c
                                                failed_at = clock()
                                        case None:
                                            pass
                                case Err(_):
                                    pass
        tick += 1
        if all(c.is_some() for c in codes):
            break
        # if one rank failed, the others would wait for it forever: stop them
        if first >= 0 and clock() - failed_at > 0.5:
            for i in 0..ranks:
                if codes[i].is_none():
                    os.kill(kids[i])
                    os.wait(kids[i])
                    codes[i] = Some(0)
                    stopped = true
            break
        os.sleep(0.005)
    for r in 0..ranks:
        match os.remove_file(f"{exits}.{r}"):
            case _:
                pass
    if first < 0:
        return Ok(0)
    let code = first_code
    if stopped:
        eprint(f"error: rank {first} failed (exit code {code}), so the other ranks were stopped")
    # an exit code the shell can show (a crash on Windows is a large number)
    return Ok(code if 1 <= code <= 255 else 1)

fn cmd_run(g: G, a: Args) -> Result[int, str]:
    a.check_flags(
        ["--release", "--debug", "--threads", "--ranks", "--typed", "--proven", "--target"]
    )?
    let plat = platform_of(a)?
    if plat == Platform.Web:
        return Err(
            "a web build runs in a browser: build it with `brine build --target web` and open its index.html"
        )
    let t = resolve(g, first_pos(a))?.typed_if(a)
    var ranks = 1
    match a.val("--ranks"):
        case Some(v):
            match parse_int(v):
                case Some(n):
                    if n < 1 or n > 1024:
                        return Err("`--ranks` must be a number from 1 to 1024")
                    ranks = n
                case None:
                    return Err("`--ranks` must be a number from 1 to 1024")
        case None:
            pass
    match a.val("--threads"):
        case Some(th):
            match parse_int(th):
                case Some(n):
                    if n < 1 or n > 4294967295:
                        return Err("`--threads` must be a positive number")
                case None:
                    return Err("`--threads` must be a positive number")
        case None:
            pass
    if ranks > 1 and plat.is_wasm():
        return Err("`--ranks` needs native processes; WebAssembly programs run as one rank")
    var exe = ""
    match build(g, t, profile_of(a), false, None, false, plat)?:
        case Some(x):
            exe = x
        case None:
            return Ok(1)
    var launch = [exe]
    if plat.is_wasm():
        match driver.wasm_command(exe, t.cache_dir()):
            case Ok(l):
                launch = l
            case Err(e):
                release(t, exe)
                return Err(e)
    var argv = a.pos[1:] if len(a.pos) > 0 else []
    argv.extend(a.rest)
    if not g.quiet and not g.json:
        let c = g.c()
        let extra = f" ({ranks} ranks)" if ranks > 1 else ""
        let verb = "Running"
        eprint(f"{c.bold()}{c.green()}{verb:>10}{c.reset()} {display_path(exe)}{extra}")
    # with --json, a panic is reported as a diagnostic too
    let panics = panic_base(t) if g.json and not plat.is_wasm() else ""
    let code = run_exe(launch, argv, a.val("--threads"), ranks, panics, t, exe)?
    if panics != "":
        for r in 0..ranks:
            let f = panic_file(panics, r, ranks)
            match read_file(f):
                case Ok(rec):
                    let (d, sm) = panic_diag(rec, r if ranks > 1 else -1)
                    print(diag.to_json(d, sm))
                    match os.remove_file(f):
                        case _:
                            pass
                case Err(_):
                    pass
    match crash_reason(code):
        case Some(why):
            g.error(f"the program crashed ({why})")
        case None:
            pass
    # the last line: how the program ended, as `brine` exits
    if g.json:
        print(f"{{\"exit\":{exit_status(code)}}}")
    return Ok(code)

fn panic_file(base: str, rank: int, ranks: int) -> str:
    return base if ranks <= 1 else f"{base}.{rank}"

# The panic a program wrote (runtime/rt.br, `panic_record`: the location, a
# NUL, the message, a NUL, the call chain, a NUL, then the help) as a
# diagnostic, its primary span where it happened when that file can be read.
fn panic_diag(rec: str, rank: int) -> (Diag, SourceMap):
    let parts = rec.split("\0")
    let loc = parts[0] if len(parts) > 0 else ""
    # an assertion's own message is on the lines after the first
    let msg = (parts[1] if len(parts) > 1 else "the program panicked").lines()
    var d = diag.error("", msg[0] if len(msg) > 0 else "the program panicked")
    for m in msg[1:]:
        d = d.note(m.strip())
    var sm = SourceMap.new()
    # `file:line:column` (the file may have colons too)
    let bits = loc.split(":")
    let n = len(bits)
    if n >= 3:
        let path = ":".join(bits[:n - 2])
        match (parse_int(bits[n - 2]), parse_int(bits[n - 1]), read_file(path)):
            case (Some(line), Some(col), Ok(text)):
                let fi = sm.add(path, text)
                let off = sm.files[fi].offset_of(line, col)
                d = d.label(diag.Span(file=fi, lo=off, hi=off), "panicked here")
            case _:
                pass
    if rank >= 0:
        d = d.note(f"on rank {rank}")
    if len(parts) > 2:
        for l in parts[2].lines():
            if l.strip() != "":
                d = d.note(l.strip())
    if len(parts) > 3 and parts[3] != "":
        d = d.with_help(parts[3])
    return (d, sm)

# A plain unsigned decimal number (no sign, no spaces).
fn parse_int(s: str) -> Option[int]:
    if s == "" or len(s) > 18:
        return None
    var n = 0
    for c in s.chars():
        if not ("0" <= c <= "9"):
            return None
        n = n * 10 + (ord(c) - 48)
    return Some(n)

# gdb pretty-printers for brine values, written next to debug builds
const GDB_PY = embed("../runtime/brine_gdb.py")

fn find_debugger() -> Option[str]:
    for d in ["gdb", "lldb"]:
        if driver.runs_ok([d, "--version"]):
            return Some(d)
    return None

fn cmd_debug(g: G, a: Args) -> Result[int, str]:
    a.check_flags([])?
    let t = resolve(g, first_pos(a))?
    var exe = ""
    match build(g, t, Profile.Debug, false, None, false, Platform.Host)?:
        case Some(x):
            exe = x
        case None:
            return Ok(1)
    var dbg = ""
    match find_debugger():
        case Some(d):
            dbg = d
        case None:
            release(t, exe)
            return Err(
                "no debugger found (install gdb or lldb); the debug build is at " + display_path(
                    exe
                )
            )
    var cmd = [dbg]
    if dbg == "gdb":
        cmd.push("-q")
        # the pretty-printers need a gdb with Python; without it brine
        # values print as their C layout
        let dir = driver.dir_of(exe)
        let py = (dir if dir != "" else ".") + "/brine-gdb.py"
        let has_py = driver.runs_ok(["gdb", "-nx", "-batch", "-ex", "python import gdb"])
        if has_py and write_file(py, GDB_PY).is_ok():
            cmd.extend(["-x", py])
        else:
            cmd.extend(["-ex", "skip -gfi */brine_rt.c", "-ex", "skip -gfi */brine_rt.h"])
        # stop at a panic, once it is printed, with the frames that led to it
        cmd.extend(["-ex", "break panic_stop", "--args", exe])
    else:
        # don't step into the C runtime
        let avoid = "settings set target.process.thread.step-avoid-regexp ^(brine_|br_)"
        cmd.extend(["-O", avoid, "-O", "breakpoint set -n panic_stop", "--", exe])
    cmd.extend(a.rest)
    let sp = os.spawn(cmd, {}, false, true)
    match sp:
        case Ok(p):
            let code = os.wait(p)
            release(t, exe)
            return Ok(code)
        case Err(e):
            release(t, exe)
            return Err(e)

fn cmd_spec_diff(g: G, a: Args) -> Result[int, str]:
    a.check_flags(["--base"])?
    let t = resolve(g, first_pos(a))?
    let base = a.val("--base").unwrap_or("HEAD")
    let t0 = clock()
    let o = specdiff.run(t.entry, base)?
    var errors = 0
    match o.fe:
        case Some(fe):
            errors = len([d for d in fe.diags if d.is_error()])
        case None:
            pass
    var weaker = 0
    var stronger = 0
    var notes = 0
    let c = g.c()
    for bad in [true, false]:
        for f in o.findings:
            if f.bad != bad:
                continue
            var what = "note"
            if f.bad:
                what = "weaker"
                weaker += 1
            elif f.kind in ["stronger", "widened"]:
                what = "stronger"
                stronger += 1
            else:
                notes += 1
            if g.json:
                print(
                    "{\"change\":"
                    + json_str(what)
                    + ",\"kind\":"
                    + json_str(f.kind)
                    + ",\"item\":"
                    + json_str(f.subject)
                    + ",\"clause\":"
                    + json_str(f.clause)
                    + ",\"spans\":[{"
                    + f.at.span
                    + ",\"label\":"
                    + json_str(what)
                    + ",\"primary\":true}],\"revision\":"
                    + (json_str(f.at.rev) if f.at.rev != "" else "null")
                    + ",\"message\":"
                    + json_str(f.message())
                    + (",\"note\":" + json_str(f.note) if f.note != "" else "")
                    + "}"
                )
            else:
                let col = c.red() if f.bad else (c.green() if what == "stronger" else "")
                print(f"{f.at.loc}: {c.bold()}{col}{what}{c.reset()}: {f.message()}")
                if f.note != "":
                    print(f"{f.at.loc}: {c.bold()}note{c.reset()}: {f.note}")
    var before = -1
    var after = -1
    var kinds = ""
    match (o.checks_before, o.checks_after):
        case (Some(b), Some(n)):
            before = 0
            after = 0
            var names: [str] = []
            for k, v in b.items():
                before += v
                names.push(k)
            for k, v in n.items():
                after += v
                if k not in b:
                    names.push(k)
            var parts: [str] = []
            for k in names:
                let d = n.get(k).unwrap_or(0) - b.get(k).unwrap_or(0)
                if d != 0:
                    parts.push(("+" if d > 0 else "") + f"{d} {k}")
            kinds = " (" + ", ".join(parts) + ")" if len(parts) > 0 else ""
        case _:
            pass
    # after the diff, which is most wanted when a weaker spec broke the build
    match o.fe:
        case Some(fe):
            if errors > 0:
                g.diag_list([d for d in fe.diags if d.is_error()], fe.sm)
        case None:
            pass
    if g.json:
        print(
            "{\"ok\":"
            + ("false" if weaker > 0 or errors > 0 else "true")
            + ",\"weaker\":"
            + f"{weaker}"
            + ",\"stronger\":"
            + f"{stronger}"
            + ",\"notes\":"
            + f"{notes}"
            + ",\"checks_before\":"
            + (f"{before}" if before >= 0 else "null")
            + ",\"checks_after\":"
            + (f"{after}" if after >= 0 else "null")
            + f",\"errors\":{errors}"
            + "}"
        )
    else:
        if before >= 0 and not g.quiet and errors == 0:
            print(f"runtime checks left: {before} → {after}{kinds}")
        var ch = (
            "no spec changes" if len(o.findings) == 0 else f"{weaker} weaker, {stronger} stronger"
        )
        if errors > 0:
            ch += f"; the new code has {errors} error{plural(errors)}"
        g.status("Compared", f"{t.name} with {base} in {clock() - t0:.2f}s — {ch}")
    return Ok(1 if weaker > 0 or errors > 0 else 0)

# The .br files under `dir` as import paths (`a/b.br`: ["a", "b"]), but
# not those whose names can't be imported.
fn module_paths(dir: str, prefix: [str], ref out: [[str]]):
    var names: [str] = []
    match os.list_dir(dir):
        case Ok(ns):
            names = ns
        case Err(_):
            return
    for name in names:
        let p = project.join(dir, name)
        var seg = name
        let file = not os.is_dir(p)
        if file:
            if not name.ends_with(".br"):
                continue
            seg = name[:len(name) - 3]
        elif skip_dir(p, name):
            continue
        if seg == "" or seg[0].is_digit() or not all(lexer.is_ident_char(c) for c in seg.chars()):
            continue
        var path = prefix
        path.push(seg)
        if file:
            out.push(path)
        else:
            module_paths(p, path, ref out)

# A project's files, imported or not: its main file and every file next to it
# and below, which `check` and `test` cover (v091#5). Only what the main file
# imports for a lone file.
fn whole_project(t: Target) -> driver.Source:
    var at = driver.on_disk()
    if t.root.is_none():
        return at
    var paths: [[str]] = []
    module_paths(driver.dir_of(t.entry), [], ref paths)
    let main_name = driver.file_stem(t.entry)
    for p in paths:
        if p == [main_name] or p == [rules.MODULE] or p[0] == rules.VOCAB:
            continue
        at.also.push(p)
    return at

fn cmd_check(g: G, a: Args) -> Result[int, str]:
    a.check_flags(["--report", "--typed", "--proven"])?
    let t = resolve(g, first_pos(a))?.typed_if(a)
    let t0 = clock()
    # A project's main file starts a program, as for `brine run`, and every
    # file next to it and below is checked, imported or not. A lone file may
    # be a module, but a `main` it has must be able to start a program.
    let whole = t.root.is_some()
    let at = whole_project(t)
    let fe = driver.frontend_at(
        t.entry,
        FrontOpts(
            verify=true,
            need_main=whole,
            check_main=true,
            typed=t.typed,
            proven=t.proven,
            strict_rules=driver.in_ci()
        ),
        at
    )
    g.diags(fe)
    if fe.has_errors():
        return Ok(1)
    var files = 0
    for f in fe.sm.files:
        if f.path.ends_with(".br"):
            files += 1
    var has_main = true
    match fe.prog:
        case Some(prog):
            has_main = any(
                f.name == "main" and f.method_of.is_none()
                for f in prog.modules[prog.main_module].fns
            )
        case None:
            pass
    rules_line(g, fe)
    var proven = 0
    var remaining: [(diag.Span, str)] = []
    var kept: [(diag.Span, str)] = []
    var always: [(diag.Span, str)] = []
    match fe.report:
        case Some(r):
            proven = r.proven + len(r.kept)
            remaining = r.remaining
            kept = r.kept
            always = r.always
        case None:
            pass
    if a.has("--report"):
        # the checks that can fail, then the proven ones that still run
        var rows: [(diag.Span, str, str)] = []
        var fails: {(int, int, int): bool} = {}
        for span, _ in always:
            fails[(span.file, span.lo, span.hi)] = true
        for span, what in remaining:
            let st = "always fails" if (span.file, span.lo, span.hi) in fails else "might fail"
            rows.push((span, what, st))
        for span, what in kept:
            rows.push((span, what, "proven, still runs"))
        for span, what, st in rows:
            let loc = fe.sm.loc(span)
            let src = fe.sm.snippet(span)
            if g.json:
                print(
                    "{\"runtime_check\":"
                    + json_str(what)
                    + ",\"location\":"
                    + json_str(loc)
                    + ",\"spans\":["
                    + diag.span_entry(fe.sm, span, what, true)
                    + "]"
                    + ",\"code\":"
                    + json_str(src)
                    + ",\"status\":"
                    + json_str(st)
                    + "}"
                )
            else:
                let note = "" if st == "might fail" else f" ({st})"
                print(loc + ": " + what + " `" + verify.split_ws(src) + "`" + note)
    if g.json:
        print(
            "{\"ok\":true,\"checks_proven\":"
            + f"{proven}"
            + ",\"checks_proven_still_run\":"
            + f"{len(kept)}"
            + ",\"checks_remaining\":"
            + f"{len(remaining)}"
            + ",\"checks_always_fail\":"
            + f"{len(always)}"
            + f",\"files\":{files},\"has_main\":{has_main}"
            + "}"
        )
    else:
        let see = "" if a.has("--report") or len(remaining) == 0 else " (see --report)"
        var run = ""
        if len(kept) > 0:
            run = (
                " ("
                + ("1 of them still runs" if len(kept) == 1 else f"{len(kept)} of them still run")
                + ")"
            )
        var left = f"{len(remaining)} remain"
        if len(always) > 0:
            left += ", " + (
                "1 of them always fails"
                if len(always) == 1
                else f"{len(always)} of them always fail"
            )
        let what = f"{t.name} ({files} files)" if files > 1 else t.name
        g.status(
            "Checked",
            f"{what} in {clock() - t0:.2f}s — {proven} runtime check{plural(proven)} proven unnecessary{run}, {left}{see}"
        )
        if not has_main:
            g.status(
                "Note",
                f"{display_path(t.entry)} has no `main`: checked as a module, which `brine run` can't start"
            )
    return Ok(0)

# ================================================================ rules

# `Proven 3 rules` after a build or check that proved them.
fn rules_line(g: G, fe: Frontend):
    match fe.rules:
        case Some(rl):
            var n = 0
            for r in rl.rules:
                if r.applies:
                    n += 1
            let away = len(rl.rules) - n
            if rl.present and len(rl.rules) > 0:
                var fns = 0
                for id in 0..len(rl.covered):
                    if rl.covered[id] != "":
                        fns += 1
                var more = ""
                if fns == 1:
                    more = "; the function they cover can't stop the program"
                elif fns > 1:
                    more = f"; the {fns} functions they cover can't stop the program"
                let them = "it is" if away == 1 else "they are"
                let unused = f"not checked: {them} about modules this program doesn't use"
                # which RULES.br: it can be the project's, above the main file
                let from = display_path(project.join(rl.dir, rules.FILE))
                if n == 0:
                    g.status("Rules", f"{away} rule{plural(away)} from {from} {unused}")
                    return
                if away > 0:
                    more += f" ({away} other{plural(away)} {unused})"
                g.status("Proven", f"{n} rule{plural(n)} from {from}{more}")
        case None:
            pass

fn cmd_rules(g: G, a: Args) -> Result[int, str]:
    a.check_flags(["--explain", "--receipt", "--base", "--typed", "--proven"])?
    var pos = a.pos
    let approve = len(pos) > 0 and pos[0] == "approve"
    if approve:
        pos = pos[1:]
    var file: Option[str] = Some(pos[0]) if len(pos) > 0 else None
    if file.is_none() and project.find(os.cwd()).is_none():
        # RULES.br next to a main file, outside a project, as `brine check main.br` finds it
        if approve and driver.has_rules("."):
            return rules_approve(g, ".", rules.FILE)
        if os.is_file("main.br"):
            file = Some(".")
    let t = resolve(g, file)?.typed_if(a)
    let dir = driver.rules_at(t.entry).dir
    if dir == "":
        return Err(
            f"no RULES.br applies to `{display_path(t.entry)}`: a project's RULES.br is for the main files in its source folder (`src/`), and otherwise one next to the main file is (see `brine guide`, \"Rules\")"
        )
    let path = project.join(dir, rules.FILE)
    if approve:
        return rules_approve(g, dir, path)
    if a.has("--explain"):
        let src = read_file(path)?
        let (m, ds) = parser.parse_module(src, 0, rules.MODULE)
        if any(d.is_error() for d in ds):
            var sm = SourceMap.new()
            sm.add(display_path(path), src)
            g.diag_list(ds, sm)
            return Ok(1)
        let lines = rules.explain(src, m)
        if g.json:
            print("{\"explain\":" + json_str("\n".join(lines)) + "}")
        else:
            out_text("\n".join(lines))
        return Ok(0)
    let fe = driver.frontend(
        t.entry,
        FrontOpts(
            verify=true,
            need_main=false,
            check_main=false,
            typed=t.typed,
            proven=t.proven,
            strict_rules=true
        )
    )
    if not g.json:
        g.diags(fe)
    match fe.rules:
        case Some(rl):
            let base = rules_base(dir, a.val("--base"))?
            if a.has("--receipt"):
                text_or_json(g, "receipt", receipt(fe, rl, base))
                return Ok(0 if rules_done(fe) else 1)
            return Ok(rules_report(g, fe, rl, base))
        case None:
            if g.json:
                for d in fe.diags:
                    print(diag.to_json(d, fe.sm))
                print("{\"rules\":null,\"done\":false}")
            else:
                g.error("the program has errors, so its rules couldn't be checked")
            return Ok(1)

# The approved rules and files in RULES.lock at git revision `rev`, if asked for.
fn rules_base(dir: str, rev: Option[str]) -> Result[Option[(str, [rules.Entry])], str]:
    match rev:
        case Some(r):
            match driver.read_at(project.join(dir, rules.LOCK), Some(r)):
                case Ok(t):
                    return Ok(Some((r, rules.parse_lock(t))))
                case Err(_):
                    return Ok(Some((r, [])))
        case None:
            return Ok(None)

# Every rule proven, nothing else wrong, and the lock up to date.
fn rules_done(fe: Frontend) -> bool:
    return fe.report.is_some() and not fe.has_errors()

fn rule_status(fe: Frontend, r: rules.RuleSummary, probs: [int]) -> str:
    if not r.applies:
        return "not used"
    if fe.report.is_none():
        return "unchecked"
    return "proven" if len(probs) == 0 else "not proven"

# What `--base` says about the approvals this change makes.
fn base_changes(rl: rules.Rules, dir: str, base: Option[(str, [rules.Entry])]) -> [str]:
    var out: [str] = []
    match base:
        case Some(b):
            let (rev, old) = b
            var now: [rules.Entry] = []
            match read_file(project.join(dir, rules.LOCK)):
                case Ok(t):
                    now = rules.parse_lock(t)
                case Err(_):
                    pass
            for e in now:
                let what = "rule" if e.kind == "rule" else "vocabulary"
                match rules.find_entry(old, e.kind, e.name):
                    case Some(o):
                        if o.hash != e.hash:
                            out.push(f"changed  {what} \"{e.name}\" (approved again since {rev})")
                    case None:
                        out.push(f"new      {what} \"{e.name}\" (approved since {rev})")
            for o in old:
                if rules.find_entry(now, o.kind, o.name).is_none():
                    let what = "rule" if o.kind == "rule" else "vocabulary"
                    out.push(f"removed  {what} \"{o.name}\" (approved at {rev}, no longer)")
            if len(out) == 0:
                out.push(f"no approvals changed since {rev}")
        case None:
            pass
    return out

fn rules_report(g: G, fe: Frontend, rl: rules.Rules, base: Option[(str, [rules.Entry])]) -> int:
    let probs = rules.problems(rl, fe.diags)
    var proven = 0
    for ri in 0..len(rl.rules):
        if rule_status(fe, rl.rules[ri], probs[ri]) == "proven":
            proven += 1
    var attributed: {int: bool} = {}
    for ps in probs:
        for i in ps:
            attributed[i] = true
    var other = 0
    for di, d in enumerate(fe.diags):
        if d.is_error() and d.code != "E0613" and di not in attributed:
            other += 1
    let done = rules_done(fe)
    let changes = base_changes(rl, rl.dir, base)
    if g.json:
        var rs: [str] = []
        for ri, r in enumerate(rl.rules):
            let ds = [diag.to_json(fe.diags[i], fe.sm) for i in probs[ri]]
            rs.push(
                "{\"name\":"
                + json_str(r.name)
                + ",\"status\":"
                + json_str(rule_status(fe, rl.rules[ri], probs[ri]))
                + ",\"approval\":"
                + json_str(r.approval)
                + ",\"location\":"
                + json_str(fe.sm.loc(r.head))
                + ",\"spans\":["
                + diag.span_entry(fe.sm, r.head, "the rule", true)
                + "]"
                + f",\"covers\":{len(r.covers)}"
                + ",\"problems\":["
                + ",".join(ds)
                + "]}"
            )
        let removed = ",".join([json_str(x) for x in rl.removed])
        let vocab = ",".join(
            ["{\"file\":" + json_str(p) + ",\"approval\":" + json_str(s) + "}" for p, s in rl.vocab]
        )
        let others = ",".join(
            [
                diag.to_json(d, fe.sm) for di,
                d in enumerate(fe.diags) if d.is_error() and di not in attributed
            ]
        )
        let ch = ",".join([json_str(x) for x in changes])
        print(
            "{\"rules\":["
            + ",".join(rs)
            + "],\"removed\":["
            + removed
            + "],\"vocabulary\":["
            + vocab
            + "],\"locked\":"
            + ("true" if rl.locked else "false")
            + ",\"other_errors\":["
            + others
            + "],\"since_base\":["
            + ch
            + "],\"done\":"
            + ("true" if done else "false")
            + "}"
        )
        return 0 if done else 1
    let c = g.c()
    let n = len(rl.rules)
    print(f"{rules.FILE}: {n} rule{plural(n)}, {proven} proven")
    for ri, r in enumerate(rl.rules):
        let st = rule_status(fe, rl.rules[ri], probs[ri])
        var mark = f"{c.green()}✓ proven     {c.reset()}"
        if st == "not proven":
            mark = f"{c.red()}✗ not proven {c.reset()}"
        elif st == "unchecked":
            mark = f"{c.yellow()}? unchecked  {c.reset()}"
        elif st == "not used":
            mark = f"{c.yellow()}- not used   {c.reset()}"
        var tag = ""
        if r.approval == "new":
            tag = f"  {c.yellow()}(not approved yet){c.reset()}"
        elif r.approval == "changed":
            tag = f"  {c.red()}(changed since approval){c.reset()}"
        print(f"  {mark} {r.name}{tag}")
        for i in probs[ri]:
            let d = fe.diags[i]
            print(f"                 {fe.sm.loc(d.labels[0].span)}  {d.code} {d.msg}")
    for x in rl.removed:
        print(
            f"  {c.red()}✗ removed    {c.reset()} {x}  {c.red()}(approved, no longer in {rules.FILE}){c.reset()}"
        )
    for p, s in rl.vocab:
        if s == "changed" or s == "removed":
            print(f"  {c.red()}! vocabulary {c.reset()} {p} {s} since approval")
    if n == 0:
        print("  no rules yet: write the first one in RULES.br (`brine guide`, \"Rules\")")
    if not rl.locked and n > 0:
        print(
            f"  no {rules.LOCK} yet: the rules' owner runs `brine rules approve` once they agree with them"
        )
    if len(changes) > 0:
        print("since the base:")
        for x in changes:
            print("  " + x)
    print(
        "also guaranteed by brine: memory safety, no data races, no silent overflow, deterministic `par`, no deadlocks in `world`"
    )
    if other > 0:
        print(f"{other} other error{plural(other)} (above), outside the rules")
    if done and any(not r.applies for r in rl.rules):
        print("done: yes, every rule this program uses is proven")
    elif done:
        print("done: yes, every rule is proven")
    elif fe.report.is_none():
        print("done: no, the program has errors, so the rules weren't proven")
    elif any(d.code == "E0613" for d in fe.diags):
        print(
            "done: no, the rules changed since their owner approved them, so release builds and CI fail"
        )
    else:
        print("done: no, so `brine build` fails")
    return 0 if done else 1

# One page of Markdown for a pull request.
fn receipt(fe: Frontend, rl: rules.Rules, base: Option[(str, [rules.Entry])]) -> str:
    let probs = rules.problems(rl, fe.diags)
    var proven = 0
    for ri in 0..len(rl.rules):
        if rule_status(fe, rl.rules[ri], probs[ri]) == "proven":
            proven += 1
    let n = len(rl.rules)
    var o: [str] = []
    o.push(f"## Rules: {proven} of {n} proven")
    o.push("")
    o.push("| rule | status | approval |")
    o.push("|---|---|---|")
    for ri, r in enumerate(rl.rules):
        let name = r.name.replace("|", "\\|")
        o.push(f"| {name} | {rule_status(fe, rl.rules[ri], probs[ri])} | {r.approval} |")
    for x in rl.removed:
        o.push(f"| {x} | removed | was approved |")
    o.push("")
    let changes = base_changes(rl, rl.dir, base)
    if len(changes) > 0:
        o.push("**Approvals since the base:**")
        for x in changes:
            o.push("- " + x)
        o.push("")
    var vocab: [str] = []
    for p, s in rl.vocab:
        vocab.push(f"`{p}` ({s})")
    if len(vocab) > 0:
        o.push("**Vocabulary** (locked with the rules): " + ", ".join(vocab))
    var fns = 0
    var ext: [str] = []
    for id in 0..len(rl.covered):
        if rl.covered[id] != "":
            fns += 1
    for r in rl.rules:
        for x in r.externs:
            if x not in ext:
                ext.push(x)
    o.push(
        f"**Covered code:** {fns} function{plural(fns)}, none of which can stop the program on the rules' inputs."
    )
    let trusted = "none reached" if len(ext) == 0 else ", ".join([f"`{x}`" for x in ext])
    let tools = " and its runtime" if not driver.needs_cc() else ", its runtime and the C compiler"
    o.push(f"**Trusted:** brine {VERSION}{tools}; extern C code: {trusted}.")
    o.push(
        "**Limits:** a rule holds whenever the code it runs returns; brine doesn't prove yet that loops and recursion end, or that memory and stack suffice."
    )
    o.push(
        "**Also guaranteed by brine:** memory safety, no data races, no silent overflow, deterministic `par`, no deadlocks in `world`."
    )
    var tests = 0
    var hashes: [str] = []
    match fe.prog:
        case Some(p):
            for m in p.modules:
                for tt in m.tests:
                    if tt.rule.is_none():
                        tests += 1
                if not builtin_module(m.name):
                    hashes.push(fe.sm.file(m.file).text)
        case None:
            pass
    o.push(f"**Tested, not guaranteed:** {tests} `test` block{plural(tests)} (`brine test`).")
    let src_hash = rules.fnv_hex("".join(hashes))
    o.push(f"**Sources:** {src_hash}")
    return "\n".join(o) + "\n"

# For the rules (or the vocabulary files) in the lock: how many there are now,
# and how many are new, changed, removed and unchanged.
fn approve_counts(now: [rules.Entry], old: [rules.Entry], rule: bool) -> [int]:
    var c = [0, 0, 0, 0, 0]
    for e in now:
        if (e.kind == "rule") != rule:
            continue
        c[0] += 1
        match rules.find_entry(old, e.kind, e.name):
            case Some(o):
                if o.hash == e.hash:
                    c[4] += 1
                else:
                    c[2] += 1
            case None:
                c[1] += 1
    for o in old:
        if (o.kind == "rule") == rule and rules.find_entry(now, o.kind, o.name).is_none():
            c[3] += 1
    return c

# "2 rules (1 new, 1 unchanged)", "1 vocabulary file (unchanged)"
fn approve_part(c: [int], what: str) -> str:
    var parts: [str] = []
    for i, w in [(1, "new"), (2, "changed"), (3, "removed")]:
        if c[i] > 0:
            parts.push(f"{c[i]} {w}")
    if c[4] > 0:
        parts.push("unchanged" if len(parts) == 0 else f"{c[4]} unchanged")
    let s = f"{c[0]} {what}{plural(c[0])}"
    return s + " (" + ", ".join(parts) + ")" if len(parts) > 0 else s

fn rules_approve(g: G, dir: str, path: str) -> Result[int, str]:
    let src = read_file(path)?
    let (m, ds) = parser.parse_module(src, 0, rules.MODULE)
    if any(d.is_error() for d in ds):
        var sm = SourceMap.new()
        sm.add(display_path(path), src)
        g.diag_list(ds, sm)
        return Ok(1)
    let now = rules.entries(src, m, dir)
    let lp = project.join(dir, rules.LOCK)
    var old: [rules.Entry] = []
    match read_file(lp):
        case Ok(t):
            old = rules.parse_lock(t)
        case Err(_):
            pass
    write_file(lp, rules.lock_text(now))?
    # counted apart: a removed rule isn't a removed file
    let rc = approve_counts(now, old, true)
    let fc = approve_counts(now, old, false)
    let nrules = rc[0]
    let fresh = rc[1] + fc[1]
    let changed = rc[2] + fc[2]
    let removed = rc[3] + fc[3]
    if g.json:
        print(
            "{\"approved\":"
            + f"{nrules},\"new\":{fresh},\"changed\":{changed},\"removed\":{removed},\"lock\":"
            + json_str(display_path(lp))
            + "}"
        )
    else:
        g.status(
            "Approved",
            approve_part(rc, "rule") + " and " + approve_part(fc, "vocabulary file")
        )
        g.status(
            "Wrote",
            display_path(lp) + ": commit it; CI and CODEOWNERS make sure only an owner changes it"
        )
    return Ok(0)

# Seconds a test may run before `brine test` stops it.
const TEST_TIMEOUT = 300

# What a failed test's output doesn't say: that it crashed, or that it
# stopped without a word.
fn exit_note(code: int, out: str) -> str:
    match crash_reason(code):
        case Some(why):
            return f"the test crashed ({why})"
        case None:
            pass
    if code != 0 and out.strip() == "":
        return f"the test exited with code {code} and printed nothing"
    return ""

fn with_note(out: str, note: str) -> str:
    if note == "":
        return out
    let o = out.rstrip()
    return note if o == "" else o + "\n" + note

struct Running:
    k: int
    name: str
    handle: int
    start: float

struct TestResult:
    k: int
    name: str
    ok: bool
    text: str
    secs: float

fn cmd_test(g: G, a: Args) -> Result[int, str]:
    a.check_flags(["--release", "--typed", "--proven", "--target", "--timeout"])?
    let plat = platform_of(a)?
    if plat == Platform.Web:
        return Err("tests run with `--target wasm` (Node.js), not in a browser")
    # a test that never finishes would hang the whole run
    var timeout = TEST_TIMEOUT
    match a.val("--timeout"):
        case Some(v):
            match parse_int(v):
                case Some(n):
                    timeout = n
                case None:
                    return Err("`--timeout` must be a number of seconds (0: no limit)")
        case None:
            pass
    # `brine test foo.br [filter]` or `brine test [filter]` inside a project
    var file: Option[str] = None
    var filters = a.pos
    if len(a.pos) > 0:
        let f = a.pos[0]
        if f.ends_with(".br") or os.is_dir(f):
            file = Some(f)
            filters = a.pos[1:]
            # a folder that is neither a project nor holds a main.br: `brine
            # test tests` would otherwise test the project around it
            if (
                os.is_dir(f)
                and not file_exists(project.join(f, "brine.toml"))
                and not os.is_file(project.join(f, "main.br"))
            ):
                return Err(
                    f"`{f}` is a folder, not a brine project (no brine.toml or main.br in it): `brine test` takes a project, a .br file, or a test name filter"
                )
    if len(filters) > 1:
        let shown = ", ".join([f"`{x}`" for x in filters])
        return Err(
            f"`brine test` takes one name filter, but got {len(filters)}: {shown} (run it once per filter, or use a part of the name they share)"
        )
    let filter: Option[str] = Some(filters[0]) if len(filters) == 1 else None
    let t = resolve(g, file)?.typed_if(a)
    let profile = Profile.Release if a.has("--release") else Profile.Dev
    var exe = ""
    match build(g, t, profile, true, None, false, plat)?:
        case Some(x):
            exe = x
        case None:
            return Ok(1)
    let r = run_tests(g, t, exe, plat, filter, timeout)
    release(t, exe)
    return r

# Where a run's panic record goes (with --json), or "" if there's nowhere to
# put it: a project's cache folder only exists once something was cached.
fn panic_base(t: Target) -> str:
    match driver.make_dirs(t.cache_dir()):
        case Ok(_):
            return project.join(t.cache_dir(), f"panic-{os.pid()}")
        case Err(_):
            return ""

# (index, module, name) of each test in a test executable, by `--list`.
fn list_tests(launch: [str]) -> Result[[(str, str, str)], str]:
    var list_cmd = launch
    list_cmd.push("--list")
    var lp = 0
    match os.spawn(list_cmd, {}, true, false):
        case Ok(p):
            lp = p
        case Err(e):
            return Err(start_error(launch[0], launch[0], e))
    let lrc = os.wait(lp)
    let (list, lerr) = os.output(lp)
    # (a WebAssembly runner can fail before the program starts)
    if lrc != 0:
        return Err(f"could not list the tests (exit code {lrc}):\n{lerr}{list}".strip())
    var tests: [(str, str, str)] = []
    for l in list.lines():
        let parts = l.split("\t")
        if len(parts) >= 3:
            tests.push((parts[0], parts[1], "\t".join(parts[2:])))
    return Ok(tests)

# Why a run found no test, when there are none at all: in which files it
# looked, and the .br files next to a lone file that have tests but that it
# doesn't import (so they weren't built).
fn no_tests_hint(t: Target) -> str:
    let how = "add one with `test \"name\":`"
    match t.root:
        case Some(_):
            let n = len(whole_project(t).also) + 1
            return f"no tests in the {n} file{plural(n)} of `{t.name}`; {how} in any of them"
        case None:
            pass
    let others = untested_neighbors(t, {})
    let me = display_path(t.entry)
    if len(others) == 1:
        let o = display_path(others[0])
        return f"no tests in `{me}` or the modules it imports; `{o}` has tests, but `{me}` doesn't import it: `brine test {o}` runs them"
    if len(others) > 1:
        let list = ", ".join([f"`{display_path(o)}`" for o in others])
        return f"no tests in `{me}` or the modules it imports; {list} have tests, but `{me}` doesn't import them: run `brine test <file>` for each"
    return f"no tests in `{me}` or the modules it imports; {how}"

# The .br files next to a lone file that look like they have tests and that
# its build didn't include (`have`: the modules it has tests from).
fn untested_neighbors(t: Target, have: {str: bool}) -> [str]:
    var out: [str] = []
    let dir = driver.dir_of(t.entry)
    let d = dir if dir != "" else "."
    for name in os.list_dir(d).unwrap_or([]):
        let p = project.join(dir, name) if dir != "" else name
        let stem = driver.file_stem(name)
        if not name.ends_with(".br") or stem == driver.file_stem(t.entry) or stem in have:
            continue
        match read_file(p):
            case Ok(text):
                if any(l.starts_with("test \"") for l in text.lines()):
                    out.push(p)
            case Err(_):
                pass
    return out

fn run_tests(
    g: G,
    t: Target,
    exe: str,
    plat: Platform,
    filter: Option[str],
    timeout: int
) -> Result[int, str]:
    var launch = [exe]
    if plat.is_wasm():
        launch = driver.wasm_command(exe, t.cache_dir())?
    let listed = list_tests(launch)?
    var tests: [(str, str)] = []
    var modules: {str: bool} = {}
    for idx, m, name in listed:
        match filter:
            case Some(fl):
                if fl not in name:
                    continue
            case None:
                pass
        tests.push((idx, name))
        modules[m] = true
    let n = len(tests)
    let files = len(modules)
    # a filter that matches nothing ran nothing: that is a mistake, not a pass
    match filter:
        case Some(fl):
            if n == 0 and len(listed) == 0:
                return Err(f"no test name contains `{fl}`: {no_tests_hint(t)}")
            if n == 0:
                let names = ", ".join([f"`{x.2}`" for x in listed[:min(5, len(listed))]])
                let more = f", and {len(listed) - 5} more" if len(listed) > 5 else ""
                return Err(
                    f"no test name contains `{fl}`; the {len(listed)} test{plural(len(listed))}: {names}{more}"
                )
        case None:
            pass
    if not g.json and not g.quiet and n > 0:
        print(f"running {n} test{plural(n)} in {files} file{plural(files)}")
    let me = os.exe_path()
    let t0 = clock()
    let workers = min(os.cpu_count(), max(n, 1))
    # with --json a failed test's panic is a diagnostic: each test writes it here
    let panics = panic_base(t) if g.json and not plat.is_wasm() else ""
    # workers take jobs from the end of the queue; results are reported in order anyway
    var queue = [i for i in 0..n]
    var running: [Running] = []
    var results: [TestResult] = [TestResult(k=0, name="", ok=false, text="", secs=0.0)] * n
    while len(queue) > 0 or len(running) > 0:
        while len(running) < workers and len(queue) > 0:
            let k = queue.pop()
            let (idx, name) = tests[k]
            let start = clock()
            # each test runs in its own process with one worker thread pool
            var cmd = launch
            cmd.extend(["--run", idx])
            var env = spawn_env(Some("2"))
            env["BRINE"] = me
            if panics != "":
                env["BRINE_PANIC_FILE"] = f"{panics}.{k}"
            match os.spawn(cmd, env, true, false):
                case Ok(p):
                    running.push(Running(k=k, name=name, handle=p, start=start))
                case Err(e):
                    results[k] = TestResult(
                        k=k,
                        name=name,
                        ok=false,
                        text=start_error(launch[0], launch[0], e),
                        secs=clock() - start
                    )
        var still: [Running] = []
        var finished = false
        for r in running:
            match os.poll(r.handle):
                case Some(code):
                    let (o, e) = os.output(r.handle)
                    let text = with_note(o + e, exit_note(code, o + e))
                    results[r.k] = TestResult(
                        k=r.k,
                        name=r.name,
                        ok=code == 0,
                        text=text,
                        secs=clock() - r.start
                    )
                    finished = true
                case None:
                    let secs = clock() - r.start
                    if timeout > 0 and secs > float(timeout):
                        os.kill(r.handle)
                        os.wait(r.handle)
                        let (o, e) = os.output(r.handle)
                        let note = f"timed out after {timeout}s and was stopped (`brine test --timeout <seconds>` changes the limit; 0: none)"
                        results[r.k] = TestResult(
                            k=r.k,
                            name=r.name,
                            ok=false,
                            text=with_note(o + e, note),
                            secs=secs
                        )
                        finished = true
                    else:
                        still.push(r)
        running = still
        if not finished and len(running) > 0:
            os.sleep(0.002)
    let c = g.c()
    var failed: [(str, str)] = []
    for r in results:
        if g.json:
            print(
                "{\"test\":"
                + json_str(r.name)
                + f",\"ok\":{r.ok},\"seconds\":{r.secs:.3f},\"output\":"
                + json_str(r.text)
                + "}"
            )
            if not r.ok:
                let (d, sm) = test_diag(r, f"{panics}.{r.k}" if panics != "" else "")
                print(diag.to_json(d, sm))
        elif not g.quiet or not r.ok:
            let st = (
                f"{c.green()}ok{c.reset()}" if r.ok else f"{c.bold()}{c.red()}FAILED{c.reset()}"
            )
            print(f"test {r.name} ... {st}")
        if not r.ok:
            failed.push((r.name, r.text))
    let passed = n - len(failed)
    let secs = clock() - t0
    if g.json:
        print(
            f"{{\"tests\":{n},\"files\":{files},\"passed\":{passed},\"failed\":{len(failed)},\"filtered_out\":{len(listed) - n},\"seconds\":{secs:.3f}}}"
        )
    else:
        for name, text in failed:
            print(f"\n---- {name} ----\n{text.rstrip()}")
        let res = (
            f"{c.green()}ok{c.reset()}"
            if len(failed) == 0
            else f"{c.bold()}{c.red()}FAILED{c.reset()}"
        )
        let out = f"; {len(listed) - n} filtered out" if len(listed) > n else ""
        print(
            f"\ntest result: {res}. {passed} passed; {len(failed)} failed{out}; finished in {secs:.2f}s"
        )
        if len(listed) == 0:
            print(f"({no_tests_hint(t)})")
        elif t.root.is_none():
            var have: {str: bool} = {}
            for _, m, _ in listed:
                have[m] = true
            let others = untested_neighbors(t, have)
            if len(others) > 0:
                let list = ", ".join([display_path(o) for o in others])
                g.status(
                    "Note",
                    f"not run: the tests in {list}, which {display_path(t.entry)} doesn't import (`brine test <file>` runs them)"
                )
    return Ok(0 if len(failed) == 0 else 1)

# A failed test as a diagnostic: its panic (from `panic_file`, with its place
# and call chain) when it panicked, else what it printed.
fn test_diag(r: TestResult, panic_file: str) -> (Diag, SourceMap):
    if panic_file != "":
        match read_file(panic_file):
            case Ok(rec):
                match os.remove_file(panic_file):
                    case _:
                        pass
                let (d, sm) = panic_diag(rec, -1)
                var d2 = d
                d2.msg = f"test `{r.name}` failed: {d.msg}"
                return (d2, sm)
            case Err(_):
                pass
    var d = diag.error("", f"test `{r.name}` failed")
    let ls = r.text.rstrip().lines()
    for l in ls[max(0, len(ls) - 20):]:
        if l.strip() != "":
            d = d.note(l.rstrip())
    return (d, SourceMap.new())

fn source_files(dir: str, ref out: [str]):
    var names: [str] = []
    match os.list_dir(dir):
        case Ok(ns):
            names = ns
        case Err(_):
            return
    for name in names:
        let p = project.join(dir, name)
        if os.is_dir(p):
            if not skip_dir(p, name):
                source_files(p, ref out)
        elif name.ends_with(".br"):
            out.push(p)

# Folders that aren't the project's own source: build output, hidden ones
# (.git), node_modules, and projects of their own (with a brine.toml).
fn skip_dir(p: str, name: str) -> bool:
    return (
        name == "target"
        or name == "node_modules"
        or name.starts_with(".")
        or file_exists(project.join(p, "brine.toml"))
    )

fn cmd_fmt(g: G, a: Args) -> Result[int, str]:
    a.check_flags(["--check"])?
    var files: [str] = []
    if len(a.pos) == 0:
        let cwd = os.cwd()
        var root = cwd
        match project.find(cwd):
            case Some(Ok(p)):
                root = p.root
            case _:
                pass
        source_files(root, ref files)
    else:
        for f in a.pos:
            if os.is_dir(f):
                source_files(f, ref files)
            else:
                files.push(f)
    let check = a.has("--check")
    var changed = 0
    var errors = 0
    for f in files:
        # CRLF line endings are kept, but a byte order mark is dropped
        var raw = ""
        match read_file(f):
            case Ok(t):
                raw = t.replace("\r\n", "\n")
            case Err(e):
                # one file brine can't read doesn't stop the others
                errors += 1
                g.error(e + driver.bad_utf8_at(f))
                continue
        let text = driver.strip_bom(raw)
        match fmt.format(text):
            case Ok(out):
                if out != raw:
                    changed += 1
                    if check:
                        if g.json:
                            print("{\"unformatted\":" + json_str(display_path(f)) + "}")
                        else:
                            print("would reformat " + display_path(f))
                    else:
                        write_file(f, out)?
                        g.status("Formatted", display_path(f))
            case Err(ds):
                errors += 1
                var sm = SourceMap.new()
                sm.add(display_path(f), text)
                g.diag_list(ds, sm)
    if g.json:
        # (so a run that changed nothing still says what it did)
        let key = "unformatted" if check else "reformatted"
        print(f"{{\"checked\":{len(files)},\"{key}\":{changed},\"errors\":{errors}}}")
    elif not g.quiet:
        let verb = "need formatting" if check else "reformatted"
        eprint(f"{len(files)} file{plural(len(files))} checked, {changed} {verb}")
    return Ok(1 if errors > 0 or (check and changed > 0) else 0)

fn doctor_line(g: G, good: bool, what: str, detail: str) -> bool:
    if g.json:
        print(
            "{\"check\":" + json_str(what) + f",\"ok\":{good},\"detail\":" + json_str(detail) + "}"
        )
    else:
        let c = g.c()
        let mark = f"{c.green()}✓{c.reset()}" if good else f"{c.red()}✗{c.reset()}"
        print(f"  {mark} {what:<16} {detail}")
    return good

fn cmd_doctor(g: G) -> Result[int, str]:
    let c = g.c()
    var ok = true
    ok = doctor_line(g, true, "brine", f"{VERSION} ({os.name()} {os.arch()})") and ok
    # where brine makes native code, a C compiler is only for `BRINE_BACKEND=c`
    let want_cc = driver.needs_cc() or getenv("BRINE_BACKEND").unwrap_or("") == "c"
    var cc: Option[str] = None
    if want_cc:
        cc = driver.find_cc()
        match cc:
            case Some(x):
                let v = driver.cc_version(x).unwrap_or("")
                ok = doctor_line(g, true, "C compiler", f"{x} — {v}") and ok
            case None:
                ok = (
                    doctor_line(
                        g,
                        false,
                        "C compiler",
                        "not found — install clang or gcc, or set BRINE_CC"
                    )
                    and ok
                )
    else:
        doctor_line(g, true, "native code", "brine makes executables itself: no C compiler needed")
    ok = doctor_line(g, true, "parallelism", f"{os.cpu_count()} hardware threads") and ok
    ok = (
        doctor_line(g, os.free_ports(1).is_ok(), "local sockets", "needed for `brine run --ranks`")
        and ok
    )
    if cc.is_some() or not want_cc:
        let dir = project.join(os.temp_dir(), "brine-doctor")
        match os.make_dir(dir):
            case _:
                pass
        let src = project.join(dir, "doctor.br")
        match write_file(
            src,
            "fn main():\n    let n = par sum(i for i in 0..1000)\n    print(n)\n"
        ):
            case _:
                pass
        let t = Target(entry=src, name="doctor", root=None, version=None, typed=false, proven=false)
        let quiet = G(json=false, color=false, quiet=true)
        var built: Option[str] = None
        match build(
            quiet,
            t,
            Profile.Dev,
            false,
            Some(project.join(dir, driver.exe_name("doctor"))),
            false,
            Platform.Host
        ):
            case Ok(Some(exe)):
                built = Some(exe)
            case _:
                pass
        match built:
            case Some(exe):
                var good = false
                match os.spawn([exe], {}, true, false):
                    case Ok(p):
                        os.wait(p)
                        let (out, _) = os.output(p)
                        good = out.strip() == "499500"
                    case Err(_):
                        pass
                release(t, exe)
                let detail = (
                    "compiled and ran a parallel program"
                    if good
                    else "the test program gave the wrong output"
                )
                ok = doctor_line(g, good, "build + run", detail) and ok
            case None:
                ok = (
                    doctor_line(
                        g,
                        false,
                        "build + run",
                        "could not build a test program (see errors above)"
                    )
                    and ok
                )
    # where builds go, and how full that is (a project has its own, in target/)
    let cdir = project.join(os.temp_dir(), "brine-cache")
    let cap = driver.cache_cap()
    let limit = (
        "no limit (BRINE_CACHE_SIZE=0)"
        if cap == 0
        else f"limit {driver.human_size(cap)} (BRINE_CACHE_SIZE)"
    )
    doctor_line(
        g,
        true,
        "build cache",
        f"{display_path(cdir)}: {driver.human_size(driver.cache_used(cdir))} used, {limit}"
    )
    let dbg = find_debugger()
    let wasi = driver.find_wasi_cc()
    if g.json:
        # optional: a missing one doesn't fail the doctor
        for what, found, none in [
            ("debugger", dbg, "none (optional, for `brine debug`)"),
            ("WebAssembly", wasi, "no wasi-sdk (optional, for `--target wasm`; set WASI_SDK_PATH)")
        ]:
            let detail = json_str(found.unwrap_or(none))
            print(
                "{\"check\":"
                + json_str(what)
                + f",\"ok\":{found.is_some()},\"optional\":true,\"detail\":{detail}}}"
            )
    else:
        let mark = f"{c.green()}✓{c.reset()}" if dbg.is_some() else f"{c.yellow()}-{c.reset()}"
        let what = "debugger"
        let detail = dbg.unwrap_or("none (optional, for `brine debug`)")
        print(f"  {mark} {what:<16} {detail}")
        let wmark = f"{c.green()}✓{c.reset()}" if wasi.is_some() else f"{c.yellow()}-{c.reset()}"
        let wwhat = "WebAssembly"
        let wdetail = wasi.unwrap_or(
            "no wasi-sdk (optional, for `--target wasm`; set WASI_SDK_PATH)"
        )
        print(f"  {wmark} {wwhat:<16} {wdetail}")
    return Ok(0 if ok else 1)

# The usage of a hidden command, which `--help` prints like any other's.
fn hidden_usage(cmd: str) -> Option[str]:
    for c, u in [
        ("lex", "[--comments] <file>"),
        ("parse", "<file>"),
        ("emit-c", "[--tests] [--debug] <file> -o <out.c>"),
        ("emit-ir", "[--tests] [--release] [--opt] <file> [-o <out>]")
    ]:
        if c == cmd:
            return Some(f"Usage: brine {c} {u}")
    return None

# `brine lex [--comments] <file>` (hidden): one line per token, then one per error.
fn cmd_lex(a: Args) -> Result[int, str]:
    if len(a.pos) == 0:
        return Err(hidden_usage("lex").unwrap())
    let path = a.pos[0]
    var text = ""
    match read_file(path):
        case Ok(t):
            text = t
        case Err(e):
            return Err(e)
    let (toks, diags) = lexer.lex(text, 0, 0, a.has("--comments"), true)
    var lines: [str] = []
    for t in toks:
        lines.push(f"{t.lo} {t.hi} {lexer.dump_tok(t.tok, text[t.lo:t.hi])}")
    for d in diags:
        lines.extend(diag.dump(d))
    if len(lines) > 0:
        print("\n".join(lines))
    return Ok(0)

# `brine parse <file>` (hidden): the parsed AST and the errors, as text.
fn cmd_parse(a: Args) -> Result[int, str]:
    if len(a.pos) == 0:
        return Err(hidden_usage("parse").unwrap())
    let path = a.pos[0]
    var text = ""
    match read_file(path):
        case Ok(t):
            text = t
        case Err(e):
            return Err(e)
    let (m, diags) = parser.parse_module(text, 0, "main")
    var lines = astdump.dump_module(m, text)
    for d in diags:
        lines.extend(diag.dump(d))
    if len(lines) > 0:
        print("\n".join(lines))
    return Ok(0)

# `brine emit-c [--tests] [--debug] <file> -o <out.c>` (hidden): the generated C.
fn cmd_emit_c(g: G, a: Args) -> Result[int, str]:
    if len(a.pos) == 0:
        return Err(hidden_usage("emit-c").unwrap())
    let tests = a.has("--tests")
    let fe = driver.frontend(
        a.pos[0],
        FrontOpts(
            verify=true,
            need_main=not tests,
            check_main=not tests,
            typed=false,
            proven=false,
            strict_rules=driver.strict_rules(a.has("--release"))
        )
    )
    g.diags(fe)
    if fe.has_errors():
        return Ok(1)
    let c = driver.gen_c(fe, profile_of(a), tests, platform_of(a)?)
    match a.val("-o"):
        case Some(out):
            write_file(out, c)?
        case None:
            text_or_json(g, "c", c)
    return Ok(0)

fn cmd_emit_ir(g: G, a: Args) -> Result[int, str]:
    if len(a.pos) == 0:
        return Err(hidden_usage("emit-ir").unwrap())
    let tests = a.has("--tests")
    let fe = driver.frontend(
        a.pos[0],
        FrontOpts(
            verify=true,
            need_main=not tests,
            check_main=not tests,
            typed=false,
            proven=false,
            strict_rules=driver.strict_rules(a.has("--release"))
        )
    )
    g.diags(fe)
    if fe.has_errors():
        return Ok(1)
    let t = driver.gen_ir(fe, profile_of(a), tests, platform_of(a)?, a.has("--opt"))
    match a.val("-o"):
        case Some(out):
            write_file(out, t)?
        case None:
            text_or_json(g, "ir", t)
    return Ok(0)
