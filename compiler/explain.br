# Long-form explanations for `brine explain <code>`. Every error code has one.
from checks import every_check

# Every (code, title, explanation), in the order `brine explain` lists them.
fn all() -> [(str, str, str)]:
    var t: [(str, str, str)] = []
    var s = ""

    s = "A number or string literal couldn't be read: the integer is too large to\n"
    s += "represent, or a string contains an unknown escape such as `\\q`. The largest\n"
    s += "integer literal is 340282366920938463463374607431768211455, the maximum of\n"
    s += "`u128` (literals above the `i128` range need a `u128` type).\n"
    s += "\n"
    s += "Supported escapes: \\n \\t \\r \\0 \\\\ \\\" \\' \\{ \\} and \\u{XXXX}. There is no `\\xNN`:\n"
    s += "a `str` is UTF-8, so write the character's code point; raw bytes go in a `[u8]`.\n"
    s += "\n"
    s += "    print(\"caf\\xe9\")              # error: no `\\x` escape\n"
    s += "    print(\"caf\\u{e9}\")            # ok: café\n"
    s += "    let raw: [u8] = [0xe9, 0x00]   # ok: bytes\n"
    s += "\n"
    s += "Integers may use `_` separators and the 0x, 0o and 0b prefixes: 1_000_000, 0xff.\n"
    s += "\n"
    s += "The same code marks a character that can't start anything in brine. The\n"
    s += "message names it by its code point, which helps when it can't be seen: a\n"
    s += "zero-width space or a no-break space pasted from a web page, or curly quotes\n"
    s += "(`“` `”`) and dashes (`–`) that an editor or a chat put in place of `\"` and `-`.\n"
    s += "Delete it, or write the plain ASCII character instead. (A byte order mark at\n"
    s += "the very start of a file is skipped, and `brine fmt` removes it.)\n"
    t.push(("E0101", "invalid literal or character", s))

    s = "A string or f-string literal isn't closed on the same line, or an f-string\n"
    s += "has an unbalanced brace:\n"
    s += "\n"
    s += "    print(\"total: )               # error: the closing quote is missing\n"
    s += "\n"
    s += "Text over several lines goes between `\"\"\"` quotes\n"
    s += "(a line break right after the opening quotes is dropped, and so is the\n"
    s += "indentation all the lines share):\n"
    s += "\n"
    s += "    const USAGE = \"\"\"\n"
    s += "        usage: tool [--verbose] FILE\n"
    s += "        \"\"\"\n"
    s += "\n"
    s += "In f-strings, `{expr}` interpolates and `{{` / `}}` write literal braces:\n"
    s += "\n"
    s += "    print(f\"{name} has {{braces}}, {d[\"key\"]}\")\n"
    t.push(("E0102", "unterminated string", s))

    s = "brine uses indentation (like Python) to group statements. A block must be\n"
    s += "indented after a line ending in `:`, and nothing else may be indented.\n"
    s += "\n"
    s += "    let x = 1\n"
    s += "        print(x)                   # error: no `:` line above it\n"
    s += "\n"
    s += "Indent the lines of a block by 4 spaces more than the line that opens it:\n"
    s += "\n"
    s += "    fn main():\n"
    s += "        print(\"indented by 4 spaces\")\n"
    t.push(("E0103", "bad indentation", s))

    s = "Indentation must use spaces. Tabs look different in every editor, so they\n"
    s += "are not allowed. `brine fmt` replaces them, with 4 spaces per level:\n"
    s += "\n"
    s += "    brine fmt app.br\n"
    t.push(("E0104", "tab in indentation", s))

    s = "brine spells logical operators as words and has no `++`/`--`:\n"
    s += "\n"
    s += "    a and b      (not a && b)\n"
    s += "    a or b       (not a || b)\n"
    s += "    not a        (not !a)\n"
    s += "    x += 1       (not x++)\n"
    s += "\n"
    s += "For example:\n"
    s += "\n"
    s += "    let ready = true\n"
    s += "    if ready && len(args()) > 0:   # error: write `and`\n"
    s += "        print(\"go\")\n"
    t.push(("E0105", "operator from another language", s))

    s = "Blocks are written with `:` and indentation, and statements end at the end\n"
    s += "of the line. Remove `{ }` and `;`:\n"
    s += "\n"
    s += "    let x = 1;                     # error: drop the `;`\n"
    t.push(("E0106", "braces or semicolons", s))

    s = "The parser expected something else here. The message says what it expected.\n"
    s += "Common causes: a missing `:` at the end of `if`/`for`/`fn` lines, a missing\n"
    s += "type on a function parameter (`fn f(x: int)`), a bracket that is never\n"
    s += "closed (the error points at the opening one), or a misspelled keyword.\n"
    s += "Constructs from other languages (`def`, `try`, `impl`, ...) are E0115.\n"
    s += "\n"
    s += "    fn area(w, h: float) -> float:   # error: `w` needs a type\n"
    s += "        return w * h\n"
    s += "\n"
    s += "Run `brine guide` for the full syntax.\n"
    t.push(("E0110", "syntax error", s))

    s = "A value was expected here (a number, a variable, a call, ...), but the parser\n"
    s += "found something else, such as a keyword or a closing bracket.\n"
    s += "\n"
    s += "    let total = 1 + )              # error: `+` needs a value after it\n"
    t.push(("E0111", "expected an expression", s))

    s = "`requires` and `ensures` must be the first lines of a function body, and\n"
    s += "`invariant` must be the first lines of a `while` or `for` body:\n"
    s += "\n"
    s += "    fn g(x: int) -> int:\n"
    s += "        let y = x + 1\n"
    s += "        requires x > 0             # error: after another line\n"
    s += "        return y\n"
    s += "\n"
    s += "Put them first:\n"
    s += "\n"
    s += "    fn f(x: int) -> int:\n"
    s += "        requires x > 0\n"
    s += "        ensures result > x\n"
    s += "        return x + 1\n"
    t.push(("E0112", "contract in the wrong place", s))

    s = "`par` comes in these forms:\n"
    s += "\n"
    s += "    par for i in 0..n:            # parallel loop\n"
    s += "    par [f(x) for x in xs]        # parallel map\n"
    s += "    par sum(x * x for x in xs)    # parallel reduction (sum/product/min/max/any/all)\n"
    s += "    par first(Some(i) if ok(i) else None for i in 0..n)   # parallel search\n"
    s += "    par(f(a), g(b))               # run two or more expressions in parallel\n"
    s += "\n"
    s += "Other loops can't be parallel:\n"
    s += "\n"
    s += "    var i = 0\n"
    s += "    par while i < 10:             # error: write `par for i in 0..10:`\n"
    s += "        i += 1\n"
    t.push(("E0113", "misused `par`", s))

    s = "brine writes `elif` (like Python):\n"
    s += "\n"
    s += "    let x = len(args())\n"
    s += "    if x == 0:\n"
    s += "        print(\"none\")\n"
    s += "    else if x == 1:                # error: write `elif x == 1:`\n"
    s += "        print(\"one\")\n"
    s += "\n"
    s += "The whole form:\n"
    s += "\n"
    s += "    if x < 0:\n"
    s += "        ...\n"
    s += "    elif x == 0:\n"
    s += "        ...\n"
    s += "    else:\n"
    s += "        ...\n"
    t.push(("E0114", "`else if`", s))

    s = "The code uses a construct from another language that brine doesn't have.\n"
    s += "The message names it and the help says what brine writes instead:\n"
    s += "\n"
    s += "    def f(x):                 fn f(x: int) -> int:\n"
    s += "    class P: / impl P:        struct P: with the methods inside it\n"
    s += "    try: / raise              a Result: return Err(...), handle it with match or ?\n"
    s += "    lambda x: ... / |x|       a named fn, called in a comprehension\n"
    s += "    let Some(x) = opt         match opt: with case Some(x): and case _:\n"
    s += "    f(&mut xs)                f(ref xs), with a ref parameter\n"
    s += "    println!(...)             print(...)\n"
    s += "    Vec<int>, fn f<T>         [int], fn f[T]\n"
    s += "\n"
    s += "For example:\n"
    s += "\n"
    s += "    def double(x: int) -> int:     # error: write `fn double(x: int) -> int:`\n"
    s += "        return x * 2\n"
    s += "\n"
    s += "Many of these errors carry a fix, listed by `--json`.\n"
    t.push(("E0115", "construct from another language", s))

    s = "A variable, function, type, or module name isn't defined where it's used.\n"
    s += "The message often suggests the closest existing name. Variables are only\n"
    s += "visible after their `let`/`var` line and inside the block that declares them.\n"
    s += "\n"
    s += "    let total = 10\n"
    s += "    print(totl)                    # error: did you mean `total`?\n"
    t.push(("E0201", "name not found", s))

    s = "Two items, fields, methods, or parameters share a name in the same scope.\n"
    s += "Rename one of them.\n"
    s += "\n"
    s += "    struct Point:\n"
    s += "        x: int\n"
    s += "        x: float                   # error: `x` again\n"
    t.push(("E0202", "defined twice", s))

    s = "The type name isn't a built-in type, struct or enum in scope.\n"
    s += "\n"
    s += "    let n: integer = 1             # error: write `int`\n"
    s += "\n"
    s += "Built-in types: int (i64), i8, i16, i32, i128, u8, u16, u32, u64, u128,\n"
    s += "float (f64), f32, bool, str, arrays [T], maps {K: V}, tuples (A, B),\n"
    s += "Option[T] and Result[T, E].\n"
    s += "Types from another module are written `module.Name`.\n"
    t.push(("E0203", "unknown type", s))

    s = "The struct, tuple or enum variant doesn't have this field. Tuple fields are\n"
    s += "numbered: `pair.0`, `pair.1`.\n"
    s += "\n"
    s += "    let pair = (1, \"one\")\n"
    s += "    print(pair.first)              # error: write `pair.0`\n"
    s += "\n"
    s += "Enum values have no fields of their own; read the data of a variant with\n"
    s += "`match`:\n"
    s += "\n"
    s += "    match shape:\n"
    s += "        case Shape.Circle(r):\n"
    s += "            print(r)\n"
    s += "        case _:\n"
    s += "            pass\n"
    t.push(("E0205", "no such field", s))

    s = "The type doesn't have this method. Arrays have `push`, `pop`, `insert`,\n"
    s += "`extend`, `sort`, `reverse`, `clear`, `index` and `contains`; `len(xs)` is a\n"
    s += "function. `brine guide` lists the methods of each built-in type.\n"
    s += "\n"
    s += "    var xs = [3, 1]\n"
    s += "    xs.append(2)                   # error: write `xs.push(2)`\n"
    s += "\n"
    s += "Methods are defined inside a struct or enum body; methods with `self` are\n"
    s += "called on a value (`p.norm()`), methods without `self` on the type\n"
    s += "(`Point.origin()`).\n"
    t.push(("E0206", "no such method", s))

    s = "brine doesn't allow a second variable with the same name while the first\n"
    s += "is in scope, even in an inner block. This avoids a classic source of bugs.\n"
    s += "Pick a new name, or use `var` and assign to the existing variable.\n"
    s += "\n"
    s += "    let n = len(args())\n"
    s += "    if n > 0:\n"
    s += "        let n = 2                  # error: the outer `n` is still in scope\n"
    s += "\n"
    s += "Names in blocks that don't overlap don't clash: the arms of an `if`, two\n"
    s += "loops one after the other (`for i in ...` twice), and code after a block may\n"
    s += "reuse a name declared inside it.\n"
    t.push(("E0207", "shadowing", s))

    s = "A value has a different type than the one required here:\n"
    s += "\n"
    s += "    let n = 3\n"
    s += "    let half: float = n / 2        # error: an int; write float(n) / 2.0\n"
    s += "\n"
    s += "brine never converts implicitly; convert explicitly instead:\n"
    s += "\n"
    s += "    float(i)     int(x)     str(n)     i32(n)     int(\"42\")\n"
    s += "\n"
    s += "Numeric literals adapt to context, so `let x: f32 = 1` and `let y: u8 = 200`\n"
    s += "work without conversions.\n"
    t.push(("E0301", "type mismatch", s))

    s = "A call has the wrong number of arguments or bad keyword arguments.\n"
    s += "\n"
    s += "    fn add(a: int, b: int) -> int:\n"
    s += "        return a + b\n"
    s += "    print(add(1))                  # error: `b` is missing\n"
    s += "\n"
    s += "Struct constructors take every field, positionally or by name:\n"
    s += "\n"
    s += "    Point(1, 2)\n"
    s += "    Point(x=1, y=2)\n"
    t.push(("E0302", "wrong arguments", s))

    s = "Only functions, methods, struct names, and built-ins can be called.\n"
    s += "\n"
    s += "    let n = 3\n"
    s += "    print(n(2))                    # error: `n` is an int; write `n * 2`?\n"
    t.push(("E0303", "not callable", s))

    s = "Arrays and strings are indexed with an integer (`xs[i]`, `xs[1:3]`), and maps\n"
    s += "with a key of their key type (`m[k]`). Other values can't be indexed.\n"
    s += "\n"
    s += "    let n = 1234\n"
    s += "    print(n[0])                    # error: write str(n)[0] for the first digit\n"
    s += "\n"
    s += "There are no negative indexes: `xs[-1]` fails (E0614 when it always does);\n"
    s += "the last element is `xs[len(xs) - 1]`.\n"
    t.push(("E0304", "bad indexing", s))

    s = "The operator doesn't work on these types. Arithmetic needs two numbers of the\n"
    s += "same type; `and`/`or`/`not` need `bool`; `+` also joins two strings or two\n"
    s += "arrays, and `*` repeats a string or an array (`\"ab\" * 3`, `[0] * n`). Arrays,\n"
    s += "tuples and structs support `==` and `!=`. `<`, `<=`, `>` and `>=` work on\n"
    s += "numbers, strings, enums without data (in declaration order), and tuples and\n"
    s += "structs whose parts all support them (compared part by part, in field order).\n"
    s += "The same types work with `sort`, `min` and `max`.\n"
    s += "\n"
    s += "    let n = 5\n"
    s += "    print(\"n = \" + n)              # error: write \"n = \" + str(n), or f\"n = {n}\"\n"
    t.push(("E0305", "bad operands", s))

    s = "Some path through a function with a return type reaches the end without a\n"
    s += "`return`. Add a `return` at the end (or make every branch of a final\n"
    s += "`if/elif/else` return).\n"
    s += "\n"
    s += "    fn sign(x: int) -> int:        # error: nothing is returned when x <= 0\n"
    s += "        if x > 0:\n"
    s += "            return 1\n"
    t.push(("E0306", "missing return", s))

    s = "`if`, `elif` and `while` need a `bool`. brine has no \"truthiness\":\n"
    s += "\n"
    s += "    let xs = [1]\n"
    s += "    if len(xs):                    # error: write `if len(xs) > 0:`\n"
    s += "        print(xs)\n"
    t.push(("E0307", "condition isn't bool", s))

    s = "The compiler can't tell the type from the expression alone:\n"
    s += "\n"
    s += "    var xs = []                    # error: an array of what?\n"
    s += "\n"
    s += "Add an annotation:\n"
    s += "\n"
    s += "    var xs: [int] = []\n"
    s += "    var seen: {str: int} = {}\n"
    s += "\n"
    s += "(`let none = None` is E0332: the type argument of `Option` is missing.)\n"
    t.push(("E0308", "can't infer type", s))

    s = "A struct can't contain itself directly (it would be infinitely large):\n"
    s += "\n"
    s += "    struct Node:\n"
    s += "        value: int\n"
    s += "        next: Node                 # error\n"
    s += "\n"
    s += "Use an enum for recursive data: a recursive enum is stored behind a pointer,\n"
    s += "so a variant may contain the enum itself.\n"
    s += "\n"
    s += "    enum Tree:\n"
    s += "        Leaf(value: int)\n"
    s += "        Node(left: Tree, right: Tree)\n"
    s += "\n"
    s += "An array of the struct also works: `children: [Node]`.\n"
    t.push(("E0309", "recursive struct", s))

    s = "Types, modules and functions can't be stored in variables or passed around\n"
    s += "(first-class functions are planned).\n"
    s += "\n"
    s += "    fn double(x: int) -> int:\n"
    s += "        return x * 2\n"
    s += "    let f = double                 # error: call it instead: double(x)\n"
    t.push(("E0310", "not a value", s))

    s = "`extern fn` declares a C function. Extern functions may take integers, floats,\n"
    s += "bools and strings, and return integers, floats, bools or nothing.\n"
    s += "\n"
    s += "A `str` argument reaches C as a NUL-terminated `const char *` copy that is\n"
    s += "valid until the call returns (a string holding a NUL byte panics):\n"
    s += "\n"
    s += "    extern fn puts(s: str) -> i32\n"
    s += "\n"
    s += "Strings can't be returned: brine can't tell whether a returned `char *` may\n"
    s += "be NULL, who frees it or how long it stays valid. Wrap such a function in C.\n"
    s += "\n"
    s += "    extern fn getenv(name: str) -> str   # error: use brine's `getenv`\n"
    s += "\n"
    s += "`ref` and `mut` parameters, structs, arrays and maps can't cross either.\n"
    t.push(("E0311", "unsupported extern signature", s))

    s = "Ranges (`a..b`, `a..=b`, `range(...)`) are only allowed as the iterable of a\n"
    s += "`for` loop or comprehension. To make an array of a range use\n"
    s += "`[i for i in 0..n]`.\n"
    s += "\n"
    s += "    let r = 0..10                  # error: write [i for i in 0..10]\n"
    t.push(("E0312", "range outside a loop", s))

    s = "`break` and `continue` only work inside `for` and `while` loops.\n"
    s += "\n"
    s += "    fn stop():\n"
    s += "        break                      # error: not in a loop; `return`?\n"
    t.push(("E0313", "break/continue outside a loop", s))

    s = "`for` can iterate over ranges (`0..n`), arrays, strings (their characters)\n"
    s += "and maps (their keys).\n"
    s += "\n"
    s += "    let n = 3\n"
    s += "    for i in n:                    # error: write `for i in 0..n:`\n"
    s += "        print(i)\n"
    t.push(("E0314", "not iterable", s))

    s = "The literal doesn't fit the type it's used as, also in a conversion:\n"
    s += "\n"
    s += "    let x: u8 = 300                # error: a u8 holds 0 to 255\n"
    s += "    let y = u8(300)                # error\n"
    t.push(("E0315", "literal out of range", s))

    s = "`x for x in xs` (without brackets) is a generator. It can only be passed to\n"
    s += "sum, product, min, max, any, all or first. Use `[x for x in xs]` to build an array.\n"
    s += "\n"
    s += "    let xs = [1, 2]\n"
    s += "    print(x * 2 for x in xs)       # error: write [x * 2 for x in xs]\n"
    t.push(("E0316", "generator outside a reduction", s))

    s = "`const` values must be computable at compile time from literals and other\n"
    s += "constants, using arithmetic, comparisons, logic and conversions (`u8(3)`,\n"
    s += "`f32(1) / f32(255)`), or be arrays of such values (`const BASE = [3, 4, 5]`,\n"
    s += "`const ZEROS = [0] * 64`). Calls to functions aren't evaluated at compile\n"
    s += "time; build such a table in a function. A constant is computed as the program\n"
    s += "would compute it, so a conversion of another constant out of range, an\n"
    s += "overflow of its type or a division by zero is this error (a literal that\n"
    s += "doesn't fit, as in `u8(300)`, is E0315):\n"
    s += "\n"
    s += "    const BIG = 300\n"
    s += "    const SMALL = u8(BIG)          # error: 300 doesn't fit in a u8\n"
    s += "\n"
    s += "A constant can use constants defined later or imported, but not itself\n"
    s += "(`const A = B + 1` with `const B = A`).\n"
    t.push(("E0317", "constant not computable", s))

    s = "Format specs in f-strings follow `{value:[<|>][0][width][,][.precision][kind]}`,\n"
    s += "as in Python:\n"
    s += "\n"
    s += "    f\"{x:.3f}\"     3 decimals          f\"{n:8}\"    8 characters wide\n"
    s += "    f\"{x:e}\"       scientific          f\"{s:>8}\"   right-align (`<8`: left)\n"
    s += "    f\"{x:g}\"       the shorter one     f\"{n:05}\"   zero-pad to 5\n"
    s += "    f\"{n:,}\"       1,234,567           f\"{n:x}\"    hexadecimal (also `b` for binary)\n"
    s += "\n"
    s += "Without `<` or `>`, numbers align right and everything else left.\n"
    s += "\n"
    s += "    let x = 2.5\n"
    s += "    print(f\"{x:.2d}\")              # error: write {x:.2f}\n"
    t.push(("E0318", "bad format spec", s))

    s = "This operation only works on certain types. `world` messages can be integers\n"
    s += "and floats of any width (`u8`, `i32`, `f32`, ...: they travel at that width),\n"
    s += "bool, str, and arrays of those, nested as deep as needed (`[u8]`, `[[float]]`).\n"
    s += "Structs, tuples, enums and maps can't be sent yet: send their fields.\n"
    s += "\n"
    s += "`world.sum`, `min` and `max` work on `int`, `float`, `[int]` and `[float]`\n"
    s += "(arrays element by element; they must have the same length on every rank).\n"
    s += "`world.any` and `world.all` work on `bool`.\n"
    s += "\n"
    s += "    let total = world.sum(\"3\")     # error: sum an int or a float\n"
    t.push(("E0319", "unsupported type for this operation", s))

    s = "Variables declared with `let` (and loop variables) can't change:\n"
    s += "\n"
    s += "    let count = 0\n"
    s += "    count += 1                     # error: `count` is a `let`\n"
    s += "\n"
    s += "Declare the variable with `var` if it needs to change:\n"
    s += "\n"
    s += "    var total = 0\n"
    s += "    total += 1\n"
    t.push(("E0401", "assigning to an immutable binding", s))

    s = "Arguments are passed by value. When a function takes `ref x: T`, it can\n"
    s += "change the caller's variable, and the caller must say so explicitly:\n"
    s += "`f(ref xs)`. Without `ref` in the parameter list, the argument may not be\n"
    s += "marked `ref`. This makes every change to a caller's variable visible at the\n"
    s += "call site. Methods that change their receiver are declared with `ref self`\n"
    s += "and called normally: `p.move_by(1.0)`.\n"
    s += "\n"
    s += "    fn fill(ref xs: [int]):\n"
    s += "        xs.push(0)\n"
    s += "    var data = [1]\n"
    s += "    fill(data)                     # error: write fill(ref data)\n"
    t.push(("E0402", "`ref` mismatch at a call", s))

    s = "Parameters are read-only:\n"
    s += "\n"
    s += "    fn halve(n: int) -> int:\n"
    s += "        n /= 2                     # error: `n` is a parameter\n"
    s += "        return n\n"
    s += "\n"
    s += "To change a local copy, declare the parameter `mut`; to change the caller's\n"
    s += "variable, declare it `ref`:\n"
    s += "\n"
    s += "    fn countdown(mut n: int):        # local copy\n"
    s += "        while n > 0:\n"
    s += "            n -= 1\n"
    s += "\n"
    s += "    fn fill(ref xs: [int], v: int):  # caller's variable: call as fill(ref data, 0)\n"
    s += "        for i in 0..len(xs):\n"
    s += "            xs[i] = v\n"
    s += "\n"
    s += "A method that changes its value takes `ref self` (`fn step(ref self):`), not\n"
    s += "`mut self`.\n"
    t.push(("E0403", "modifying a parameter", s))

    s = "Only variables, their fields and their elements can be assigned:\n"
    s += "`x = 1`, `p.x = 1`, `xs[i] = 1`.\n"
    s += "\n"
    s += "References are made with `let r = ref x`, where `x` is a variable, or with\n"
    s += "`let r = ref self.board`, a field of one (fields of fields too). `r` is then\n"
    s += "another name for that place for the rest of the block. A reference is always\n"
    s += "declared with `let` (it can't be re-pointed). It can't name an element or a\n"
    s += "function's result; use the index or a variable instead:\n"
    s += "\n"
    s += "    var xs = [1, 2]\n"
    s += "    let first = ref xs[0]          # error: write xs[0] where it's used\n"
    s += "\n"
    s += "Passing an element to a `ref` parameter is fine: `bump(ref xs[0])`.\n"
    t.push(("E0404", "not assignable", s))

    s = "An expression that changes a variable in place (`xs.pop()`, `m.remove(k)`,\n"
    s += "a `ref self` method, a `ref` argument) can't also read that variable somewhere\n"
    s += "else, or change it a second time, because the result would depend on the\n"
    s += "order of evaluation:\n"
    s += "\n"
    s += "    var xs = [1, 2, 3]\n"
    s += "    print(xs, xs.pop())         # error: read and changed\n"
    s += "    print(xs.pop(), xs.pop())   # error: changed twice\n"
    s += "    let last = xs.pop()         # ok: change first,\n"
    s += "    print(xs, last)             # then read\n"
    s += "\n"
    s += "Reading the variable in the changing call's own receiver and arguments is\n"
    s += "fine: they are evaluated before the call (as in Rust and Swift), and a\n"
    s += "by-value argument keeps that value even while the call changes the variable:\n"
    s += "\n"
    s += "    append_twice(ref v, v)      # ok: the second argument is v before the call\n"
    s += "    xs.push(len(xs))            # ok\n"
    s += "\n"
    s += "A call inside another call's arguments runs first, so the two changes have an\n"
    s += "order when the outer call's variable is a plain variable or a field path:\n"
    s += "\n"
    s += "    t.add(t.leaf(1), 2)         # ok: `t.leaf` runs, then `t.add`\n"
    s += "    xs.push(xs.pop() * 2)       # ok\n"
    s += "\n"
    s += "but not when it is an element, which the inner call may move:\n"
    s += "\n"
    s += "    var xss = [[1], [2]]\n"
    s += "    xss[0].push(xss.pop()[0])   # error\n"
    s += "\n"
    s += "Different fields of a variable are different places: `self.a` and `self.b`\n"
    s += "may be changed and read in one expression, and passed as `ref` together:\n"
    s += "\n"
    s += "    both(ref self.a, ref self.b)          # ok\n"
    s += "    self.items[self.rng.below(n)]         # ok\n"
    s += "\n"
    s += "The two sides of `and`/`or`, and the parts of `a if cond else b`, run one\n"
    s += "after the other, so they may change and read the same variable:\n"
    s += "\n"
    s += "    if not self.eat(Tok.Comma) or self.at(Tok.RBracket):   # ok\n"
    s += "\n"
    s += "The same place can't be passed as `ref` twice in one call (two names for one\n"
    s += "variable inside the function): `f(ref s, ref s.a)` is an error. Pass it once\n"
    s += "and reach the part through it, or pass separate fields.\n"
    s += "\n"
    s += "In `a, b = ...` a variable or field can't be assigned twice, and an index\n"
    s += "can't read a variable the same assignment changes:\n"
    s += "\n"
    s += "    var i = 0\n"
    s += "    var xs = [0, 0]\n"
    s += "    i, xs[i] = 1, 5             # error: which `i` picks the element?\n"
    s += "\n"
    s += "Write it in two steps: `i = 1`, then `xs[i] = 5`. (Two elements of an array\n"
    s += "may be the same one, as in `xs[i], xs[j] = 1, 2` with `i == j`: the stores\n"
    s += "run left to right, so the last one wins.)\n"
    t.push(("E0405", "a variable is changed and used again in one expression", s))

    s = "A struct with an `invariant` keeps it in every value of the type, so only\n"
    s += "its own methods may change the fields the invariants read, through `self`:\n"
    s += "the invariants are proven when they return (E0609), and code everywhere\n"
    s += "else may rely on them. Elsewhere, call one of its `ref self` methods, or\n"
    s += "assign a whole new value (`r = Range(lo=0, hi=1)`), which is proven when it\n"
    s += "is built. What no invariant reads can be changed anywhere: other fields,\n"
    s += "and the elements of an array whose length is all an invariant reads:\n"
    s += "\n"
    s += "    struct Buf:\n"
    s += "        n: int\n"
    s += "        data: [u8]\n"
    s += "        name: str\n"
    s += "        invariant self.n <= len(self.data)\n"
    s += "\n"
    s += "    var b = Buf(n=0, data=[], name=\"\")\n"
    s += "    b.name = \"out\"       # ok: no invariant reads `name`\n"
    s += "    b.data[0] = u8(1)    # ok: storing an element keeps the length\n"
    s += "    b.n += 1             # error: write a `ref self` method that checks it\n"
    s += "    b.data.push(u8(1))   # error: changes the length\n"
    s += "\n"
    s += "Inside a method, only `self` itself may change them: a copy (`var s =\n"
    s += "self`) is a value of its own, which nothing proves the invariant of when\n"
    s += "the method returns. Change `self`, or build the new value whole.\n"
    t.push(("E0406", "a field of a struct with an invariant changed outside its methods", s))

    s = "`x?` unwraps an `Option` or a `Result`: it gives the value inside `Some`/`Ok`,\n"
    s += "or returns `None`/`Err` from the current function right away.\n"
    s += "\n"
    s += "    let n = parse(s)?          # parse returns Result[int, str]\n"
    s += "\n"
    s += "Other values have nothing to unwrap, so `?` doesn't apply to them.\n"
    s += "\n"
    s += "    fn next(x: int) -> Option[int]:\n"
    s += "        return Some(x? + 1)        # error: `x` is an int\n"
    t.push(("E0340", "`?` on a value that isn't an `Option` or `Result`", s))

    s = "`?` returns early with the `None` or `Err` it found, so the function has to be\n"
    s += "able to return that:\n"
    s += "\n"
    s += "* `opt?` needs the function to return `Option[...]`;\n"
    s += "* `res?` needs it to return `Result[..., E]` with the same error type `E`.\n"
    s += "\n"
    s += "    fn position(xs: [int]) -> int:\n"
    s += "        return xs.index(3)?        # error: `position` returns an int\n"
    s += "\n"
    s += "With the right return type it works:\n"
    s += "\n"
    s += "    fn total(parts: [str]) -> Result[int, str]:\n"
    s += "        var sum = 0\n"
    s += "        for p in parts:\n"
    s += "            sum += parse_int(p)?     # an Err(str) is returned as is\n"
    s += "        return Ok(sum)\n"
    s += "\n"
    s += "There are no automatic conversions between error types; use `match` to turn\n"
    s += "one error into another. In `main`, return `Result[(), str]` to use `?`.\n"
    t.push(("E0341", "`?` in a function that can't return its failure", s))

    s = "A comprehension or `par` body isn't a function you can return from early, so\n"
    s += "`?` can't be used inside it:\n"
    s += "\n"
    s += "    fn parse_int(s: str) -> Result[int, str]:\n"
    s += "        return Ok(len(s))\n"
    s += "    fn parse_all(parts: [str]) -> Result[[int], str]:\n"
    s += "        return Ok([parse_int(p)? for p in parts])   # error\n"
    s += "\n"
    s += "Write a `for` loop instead:\n"
    s += "\n"
    s += "    var out: [int] = []\n"
    s += "    for s in parts:\n"
    s += "        out.push(parse_int(s)?)\n"
    t.push(("E0342", "`?` inside a comprehension or `par` body", s))

    s = "This project asks for a written type on every variable: its brine.toml has\n"
    s += "\n"
    s += "    [check]\n"
    s += "    typed = true\n"
    s += "\n"
    s += "(or the command was given `--typed`).\n"
    s += "\n"
    s += "    let count = 0                  # error: write `let count: int = 0`\n"
    s += "\n"
    s += "Types are written after the name:\n"
    s += "\n"
    s += "    let count: int = 0\n"
    s += "    var names: [str] = []\n"
    s += "    let (q, r): (int, int) = (17 / 5, 17 % 5)\n"
    s += "    for i: int in 0..n:\n"
    s += "    for name: str, age: int in ages.items():\n"
    s += "\n"
    s += "Comprehension variables (`[x * x for x in xs]`), `match` bindings and `_`\n"
    s += "don't need one: their types come from the code right next to them. Without\n"
    s += "`typed = true`, writing types is optional everywhere.\n"
    t.push(("E0337", "a variable without a written type", s))

    s = "Iterations of `par` code run at the same time. To rule out data races, a\n"
    s += "`par` body may not assign variables from outside it, call functions that\n"
    s += "mutate them, or push/pop them.\n"
    s += "\n"
    s += "    var total = 0\n"
    s += "    par for i in 0..10:\n"
    s += "        total += i                 # error: write par sum(i for i in 0..10)\n"
    s += "\n"
    s += "The one exception: in a `par for` over a range, arrays from outside may be\n"
    s += "written at the loop variable's index:\n"
    s += "\n"
    s += "    var out = [0.0] * n\n"
    s += "    par for i in 0..n:\n"
    s += "        out[i] = f(i)        # OK: each iteration writes its own slot\n"
    s += "\n"
    s += "Strided writes work too: `out[k * i + c]` with integer constants k >= 1\n"
    s += "and c, as long as all writes of `out` in the loop use the same k and offsets\n"
    s += "c that aren't a multiple of k apart (`out[2 * i]` and `out[2 * i + 1]`, not\n"
    s += "`out[2 * i]` and `out[2 * i + 2]`: iterations 1 and 0 would both write\n"
    s += "`out[2]`).\n"
    s += "\n"
    s += "A `par for` over an array's elements (`par for x in xs`) can't write outer\n"
    s += "arrays: the elements may repeat. Loop over the indexes instead.\n"
    s += "\n"
    s += "To combine results, use a reduction instead: `par sum(f(i) for i in 0..n)`.\n"
    t.push(("E0501", "writing shared state in `par`", s))

    s = "An array written as `out[i]` inside a `par for` may only be accessed as\n"
    s += "`out[i]` in that loop (with exactly the loop variable as the index), since\n"
    s += "any other index might belong to an iteration running at the same time.\n"
    s += "\n"
    s += "    var out = [0] * 10\n"
    s += "    par for i in 0..9:\n"
    s += "        out[i] = out[i + 1]        # error: iteration i + 1 writes that one\n"
    s += "\n"
    s += "With strided writes, `out[k * i + c]`, the loop may also read the elements\n"
    s += "no iteration writes:\n"
    s += "\n"
    s += "    par for i in 0..n:\n"
    s += "        a[2 * i + 1] = a[2 * i] + a[2 * i + 2]     # OK: evens are only read\n"
    t.push(("E0502", "par write array accessed elsewhere", s))

    s = "`exit` and `world` communication would be non-deterministic inside parallel\n"
    s += "code, and so would `write_file`, `run` and the `os` functions that change\n"
    s += "things outside the program (`os.spawn`, `os.wait`, `os.poll`, `os.kill`,\n"
    s += "`os.make_dir`, `os.remove_file`, `os.rename`, `os.set_cwd`, `os.sleep`,\n"
    s += "`os.enable_ansi`). The same goes for `append_file`, `input`, `read_stdin`,\n"
    s += "`os.write_bytes` and `os.append_bytes`, and for calling a function that does\n"
    s += "any of these, directly or through other calls. Do them before or after the\n"
    s += "`par` construct.\n"
    s += "\n"
    s += "    fn save(i: int):\n"
    s += "        write_file(f\"part{i}.txt\", \"x\")\n"
    s += "    par for i in 0..4:\n"
    s += "        save(i)                    # error: `save` writes a file\n"
    t.push(("E0503", "side effect not allowed in `par`", s))

    s = "`return` and `break` can't leave a `par` body: other iterations are running\n"
    s += "at the same time. `continue` is fine (it ends the current iteration).\n"
    s += "\n"
    s += "    par for i in 0..10:\n"
    s += "        if i == 5:\n"
    s += "            break                  # error: use `par first(...)` to search\n"
    t.push(("E0505", "control flow out of `par`", s))

    s = "Invariants describe the state between iterations, which doesn't exist for a\n"
    s += "`par for`. Stepped ranges don't support invariants yet; rewrite the loop as a\n"
    s += "`while` loop with an invariant.\n"
    s += "\n"
    s += "    var total = 0\n"
    s += "    for i in range(0, 10, 2):\n"
    s += "        invariant total >= 0       # error: write a `while` loop\n"
    s += "        total += i\n"
    t.push(("E0507", "unsupported invariant", s))

    s = "Parallel comprehensions need a known output size. Filter afterwards, or use\n"
    s += "a sequential comprehension: `[x for x in xs if x > 0]`.\n"
    s += "\n"
    s += "    let xs = [1, -2, 3]\n"
    s += "    let ys = par [x * 2 for x in xs if x > 0]   # error\n"
    t.push(("E0508", "filter in `par [...]`", s))

    s = "`world` communication is collective: every rank takes part in every call,\n"
    s += "and all ranks must make the same calls in the same order. If some ranks skip\n"
    s += "a call that others make, the others would wait forever. brine rules this out\n"
    s += "at compile time.\n"
    s += "\n"
    s += "A call is rejected when the condition that leads to it may differ between\n"
    s += "ranks: anything computed from `world.rank()`, `clock()`, values received with\n"
    s += "`world.shift`/`world.exchange`, files, processes, `os` functions (except\n"
    s += "`os.name()` and `os.arch()`), or C functions. Early `return`, `break` and\n"
    s += "`continue` under such a condition count too, as do `and`/`or`, `x if c else y`,\n"
    s += "comprehension filters, `match` arms and `?` on a rank-dependent result. So does\n"
    s += "`exit` (also inside a called function): ranks that leave can't take part. And\n"
    s += "a call inside an `assert` message only runs on the ranks where it fails.\n"
    s += "\n"
    s += "    if world.rank() == 0:\n"
    s += "        world.barrier()          # error: only rank 0 gets here\n"
    s += "\n"
    s += "Compute the rank-specific part first, then communicate on every rank:\n"
    s += "\n"
    s += "    let mine = 1 if world.rank() == 0 else 0\n"
    s += "    let total = world.sum(mine)  # every rank calls this\n"
    s += "\n"
    s += "Results of `world.sum`, `min`, `max`, `any`, `all`, `broadcast` and\n"
    s += "`gather_all` are the same on every rank, and so is the length of what\n"
    s += "`world.exchange` returns, so they can be used in conditions freely:\n"
    s += "\n"
    s += "    while world.max(err) > 1e-6:\n"
    s += "        ...\n"
    s += "\n"
    s += "Values are tracked separately for each variable, struct field, tuple element\n"
    s += "and array length, and at each point of the program: a variable that becomes\n"
    s += "rank-dependent later can still decide a call before that.\n"
    s += "\n"
    s += "Branches that make the same calls in the same order, with arguments of the\n"
    s += "same types (and the same `broadcast` root and `shift` distance), are fine:\n"
    s += "\n"
    s += "    if world.rank() == 0:\n"
    s += "        t = world.sum(10)\n"
    s += "    else:\n"
    s += "        t = world.sum(1)         # ok: every rank calls `world.sum` once\n"
    s += "\n"
    s += "Code that only runs with one rank (under `if world.size() == 1:`, or the\n"
    s += "`else` of `if world.size() > 1:`) isn't checked: no other rank can disagree.\n"
    t.push(("E0510", "communication not reached by every rank", s))

    s = "Some arguments must have the same value on every rank: the root of\n"
    s += "`world.broadcast`, the distance of `world.shift`, and parameters that decide\n"
    s += "whether a function communicates (for example a loop count around a\n"
    s += "`world.sum`). Compute them from values that are the same everywhere:\n"
    s += "constants, `world.size()`, `args()`, or results of `world.broadcast`/`sum`.\n"
    s += "\n"
    s += "    let root = world.rank()\n"
    s += "    let v = world.broadcast(root, 1)   # error: each rank names itself\n"
    t.push(("E0511", "value must be the same on every rank", s))

    s = "brine has no unmatched `send`/`recv`, because a receive without a matching\n"
    s += "send hangs forever.\n"
    s += "\n"
    s += "    world.send(1, \"hello\")         # error\n"
    s += "\n"
    s += "Every communication is collective instead:\n"
    s += "\n"
    s += "    world.shift(v, 1)        # send v to rank + 1, receive from rank - 1 (wraps around)\n"
    s += "    world.shift(v, 1, edge)  # the same without wrapping around: rank 0 gets edge\n"
    s += "    world.exchange(xs)       # send xs[j] to rank j; returns what each rank sent you\n"
    s += "    world.broadcast(root, v) # everyone gets root's value\n"
    s += "    world.gather_all(v)      # everyone gets [v from rank 0, v from rank 1, ...]\n"
    s += "\n"
    s += "For example, \"rank 0 sends a message to rank 1\":\n"
    s += "\n"
    s += "    var outbox = [\"\"] * world.size()\n"
    s += "    if world.rank() == 0 and world.size() > 1:\n"
    s += "        outbox[1] = \"hello\"\n"
    s += "    let inbox = world.exchange(outbox)\n"
    s += "    # on rank 1, inbox[0] == \"hello\"\n"
    t.push(("E0512", "no `send`/`recv`", s))

    s = "The function's `requires` clause must hold at every call, and the compiler\n"
    s += "must be able to prove it from what it knows at the call site. Rules can't be\n"
    s += "broken, so an unproven claim is an error, not a runtime check.\n"
    s += "\n"
    s += "    fn get(xs: [int], i: int) -> int:\n"
    s += "        requires 0 <= i < len(xs)\n"
    s += "        return xs[i]\n"
    s += "    let i = len(args())\n"
    s += "    print(get([1, 2], i))          # error: `i` may be 2 or more\n"
    s += "\n"
    s += "Fix it by giving the prover the facts it needs, for example:\n"
    s += "\n"
    s += "    if 0 <= i and i < len(xs):     # the call is only made when it's safe\n"
    s += "        print(get(xs, i))\n"
    s += "\n"
    s += "    assert 0 <= i < len(xs)        # checked at runtime, then known to the prover\n"
    s += "    print(get(xs, i))\n"
    s += "\n"
    s += "or by adding a `requires` to the calling function, which moves the obligation\n"
    s += "to its callers. The error lists the facts the prover knew and the claim it\n"
    s += "needed.\n"
    t.push(("E0601", "precondition not proven", s))

    s = "An `ensures` clause must hold on every `return`. The prover reasons about\n"
    s += "each path through the function:\n"
    s += "\n"
    s += "    fn half(x: int) -> int:\n"
    s += "        ensures result >= 0\n"
    s += "        return x / 2               # error: negative when x is\n"
    s += "\n"
    s += "If it can't show the claim on some path, add a `requires` the claim depends\n"
    s += "on (`requires x >= 0`), an `invariant` to loops before the return, or an\n"
    s += "`assert` (runtime check) before the return. If the values it shows are ones\n"
    s += "the function really returns, the `ensures` itself is wrong: fix the claim.\n"
    t.push(("E0602", "postcondition not proven", s))

    s = "A loop `invariant` must hold before the first iteration. For `for i in a..b`\n"
    s += "loops, invariants may mention `i`; on entry they're checked with `i = a`.\n"
    s += "Initialize variables so the invariant holds, or weaken the invariant.\n"
    s += "\n"
    s += "    var i = 5\n"
    s += "    while i < 10:\n"
    s += "        invariant i >= 6           # error: i is 5 on entry\n"
    s += "        i += 1\n"
    t.push(("E0603", "invariant false on entry", s))

    s = "Assuming the invariant (and the loop condition) at the start of an\n"
    s += "iteration, the prover couldn't show it holds again at the end. For\n"
    s += "`for i in a..b`, the invariant is checked at the end of the iteration with\n"
    s += "`i + 1`.\n"
    s += "\n"
    s += "    var i = 0\n"
    s += "    var s = 0\n"
    s += "    while i < 10:\n"
    s += "        invariant s == i           # error: s grows by 2, i by 1\n"
    s += "        s += 2\n"
    s += "        i += 1\n"
    s += "\n"
    s += "The prover only knows what the invariant says about what the loop changes\n"
    s += "(the variables, fields and array elements it writes, also through calls),\n"
    s += "so invariants often need to carry bounds such as `0 <= i <= n`.\n"
    t.push(("E0604", "invariant not preserved", s))

    s = "`prove e` asks the compiler to show `e` is always true at that point. Unlike\n"
    s += "`assert`, it generates no runtime code, so it must be provable. Use `assert`\n"
    s += "if a runtime check is acceptable.\n"
    s += "\n"
    s += "    let n = len(args())\n"
    s += "    prove n > 0                    # error: there may be no arguments\n"
    s += "\n"
    s += "The prover splits facts with `or` (and `!=`) into cases and checks each one,\n"
    s += "up to a fixed amount of work. When the error says it gave up, the claim may\n"
    s += "well be true but needs too many cases: check it with `assert`, or move the\n"
    s += "work before it into a function whose `ensures` states just what is needed.\n"
    t.push(("E0605", "claim not proven", s))

    s = "Contracts (`requires`, `ensures`, `invariant`, `prove`) are pure logical\n"
    s += "statements. They may use arithmetic, comparisons, `and`/`or`/`not`, `len`,\n"
    s += "`abs`, `min`, `max`, fields, indexing, constants, and `result` (in `ensures`).\n"
    s += "Function calls and other side effects aren't allowed.\n"
    s += "\n"
    s += "    fn square(x: int) -> int:\n"
    s += "        return x * x\n"
    s += "    fn quad(x: int) -> int:\n"
    s += "        ensures result == square(square(x))   # error: a call\n"
    s += "        return square(square(x))\n"
    s += "\n"
    s += "Say it with arithmetic, or give the called function an `ensures` and let\n"
    s += "the prover use that. The prover also knows nothing about map contents, so\n"
    s += "`k in m` in a spec can't be proven.\n"
    t.push(("E0606", "not allowed in a specification", s))

    s = "With `proven = true` under [check] in brine.toml (or `--proven`), the\n"
    s += "program may not depend on runtime checks: every check the language makes\n"
    s += "(index bounds, overflow, division by zero, conversions, map keys, ...) and\n"
    s += "every `assert` must be proven by the compiler, so the program can't panic\n"
    s += "on them. `test` blocks are exempt: their asserts are their point.\n"
    s += "\n"
    s += "    fn at(xs: [int], i: int) -> int:\n"
    s += "        return xs[i]               # error: `i` may be out of range\n"
    s += "\n"
    s += "Give the prover the facts it needs: a `requires` that callers must meet,\n"
    s += "an `invariant` on the loop, or an `if` that handles the failing case\n"
    s += "before the check. The note shows values the prover can't rule out: if they\n"
    s += "can happen, the code is wrong for them; if not, add the fact that says so.\n"
    s += "Map reads `m[k]` are always checked: use `m.get(k)`. So are `int(s)` and\n"
    s += "`float(s)` on text (use `s.to_int()`), `unwrap()` (match on the value) and\n"
    s += "string slices the prover can't show start and end on a character (slice\n"
    s += "`s.bytes()`). A float-to-int conversion is proven once the float is compared\n"
    s += "with the range (`if -1.0e18 < x < 1.0e18:`, which also rules out NaN); to\n"
    s += "`i128` or `u128` it always stays a runtime check.\n"
    s += "`brine check --report` lists every check that remains.\n"
    s += "\n"
    s += wrap("The checks: " + check_names() + ".", 76)
    t.push(("E0607", "runtime check in proven code", s))

    s = "A function's `requires` contradict each other, or the ranges of the\n"
    s += "parameter types (`requires n > 0` and `requires n < 0`, or `requires\n"
    s += "len(xs) < 0`). No call can meet them, and inside the function anything\n"
    s += "follows from a contradiction, so every claim in its body would be proven\n"
    s += "without saying anything. Fix the `requires` that is wrong.\n"
    s += "\n"
    s += "    fn f(n: int) -> int:\n"
    s += "        requires n > 10\n"
    s += "        requires n < 5             # error: no `n` is both\n"
    s += "        return n\n"
    t.push(("E0608", "preconditions that can never hold", s))

    s = "An `invariant` in a struct is a fact about `self` that every value of the\n"
    s += "type keeps:\n"
    s += "\n"
    s += "    struct Range:\n"
    s += "        lo: int\n"
    s += "        hi: int\n"
    s += "        invariant self.lo <= self.hi\n"
    s += "\n"
    s += "    fn span(a: int, b: int) -> Range:\n"
    s += "        return Range(lo=a, hi=b)   # error: `a` may be more than `b`\n"
    s += "\n"
    s += "It is proven where a value is built (`Range(lo=a, hi=b)`), and where a\n"
    s += "`ref self` method returns or uses `self` whole (passes, copies or returns\n"
    s += "it): in between, a method may break it. Everywhere else it is a known\n"
    s += "fact, so functions that take a `Range` don't need a `requires` for it.\n"
    s += "Check the values before building one (an `if` that returns an error is\n"
    s += "the usual way to parse untrusted input into it), or restore the invariant\n"
    s += "on every path through the method:\n"
    s += "\n"
    s += "    fn span_checked(a: int, b: int) -> Option[Range]:\n"
    s += "        if a > b:\n"
    s += "            return None\n"
    s += "        return Some(Range(lo=a, hi=b))   # ok\n"
    t.push(("E0609", "struct invariant not proven", s))

    s = "RULES.br says what a program promises: a project's (next to brine.toml)\n"
    s += "is for the main files in src/, otherwise one next to the main file is.\n"
    s += "A `rule` block is written like a test whose inputs can be anything of\n"
    s += "their types:\n"
    s += "\n"
    s += "    from bank import Account, withdraw\n"
    s += "\n"
    s += "    rule \"a withdrawal never overdraws\" for a: Account, amount: int:\n"
    s += "        requires amount > 0\n"
    s += "        let b = withdraw(a, amount)\n"
    s += "        prove b.balance >= 0\n"
    s += "\n"
    s += "    rule \"pricing never touches files, the clock or other processes\":\n"
    s += "        effects pricing: none\n"
    s += "\n"
    s += "    rule \"a request can never crash the server\":\n"
    s += "        proven server.handle\n"
    s += "\n"
    s += "This error is about the shape of the rules: a `rule` outside RULES.br, a\n"
    s += "rule without a one-line name or with another rule's name, a rule that says\n"
    s += "nothing, an `effects` or `proven` line naming a module or function that\n"
    s += "doesn't exist, an effect that isn't one of files, console, processes, clock,\n"
    s += "environment, network, world or extern, or a module importing RULES.br (rules\n"
    s += "are proven, never called; shared definitions go in rules/).\n"
    t.push(("E0610", "malformed rule", s))

    s = "Code a rule covers is everything the rule's body and its `proven` lines\n"
    s += "call, directly or not. For the rule to hold, that code must return for\n"
    s += "every input the rule allows instead of stopping the program, so it can't\n"
    s += "reach `panic` or `exit`, or call `unwrap()`, unless the prover shows that\n"
    s += "line can't be reached. Handle the case instead: `match` on the `Option` or\n"
    s += "`Result`, return an error, or give the prover the facts (`requires`,\n"
    s += "`invariant`) that rule the case out. Runtime checks left in covered code\n"
    s += "are errors too (E0607).\n"
    s += "\n"
    s += "    # RULES.br\n"
    s += "    rule \"a bad header never crashes the reader\":\n"
    s += "        proven reader.parse_header\n"
    s += "\n"
    s += "    # reader.br\n"
    s += "    fn parse_header(line: str) -> int:\n"
    s += "        return line.to_int().unwrap()      # error: `unwrap` stops on bad input\n"
    s += "\n"
    s += "Return the failure instead:\n"
    s += "\n"
    s += "    fn parse_header(line: str) -> Result[int, str]:\n"
    s += "        match line.to_int():               # ok: the caller decides\n"
    s += "            case Some(n):\n"
    s += "                return Ok(n)\n"
    s += "            case None:\n"
    s += "                return Err(f\"bad header: {line}\")\n"
    t.push(("E0611", "code a rule covers can stop the program", s))

    s = "`effects m: none` in a rule says module `m`, and everything it calls,\n"
    s += "never uses files, the console, other processes, the clock, the environment\n"
    s += "(arguments, environment variables, the machine), the network, `world`\n"
    s += "messages or extern C code. `effects m: console, clock` allows those two\n"
    s += "and nothing else. The note shows the chain of calls that reaches the\n"
    s += "effect. Move that call out of the module, for example by passing its\n"
    s += "result in as a parameter (read the clock in `main` and pass the time in),\n"
    s += "or ask the rule's owner whether the module may do it. When the module is\n"
    s += "`main`, nothing can pass the value in: only the owner can allow the effect,\n"
    s += "by adding it to the rule.\n"
    s += "\n"
    s += "    # RULES.br\n"
    s += "    rule \"pricing is a pure calculation\":\n"
    s += "        effects pricing: none\n"
    s += "\n"
    s += "    # pricing.br\n"
    s += "    fn price(base: int) -> int:\n"
    s += "        print(base)                        # error: `console`\n"
    s += "        return base * 2\n"
    t.push(("E0612", "effect a rule doesn't allow", s))

    s = "RULES.lock records the rules, and the vocabulary they use (RULES.br's own\n"
    s += "definitions and every file in rules/), that the rules' owner approved with\n"
    s += "`brine rules approve`. When an approved rule or vocabulary file changes or\n"
    s += "goes away, release builds (`--release`), `brine rules` and CI stop until it\n"
    s += "is approved again: a rule that says less would let wrong code through. Dev\n"
    s += "builds, `brine check` and `brine test` only warn, so the owner can draft a\n"
    s += "rule without approving every step. CI is detected by the `CI` environment\n"
    s += "variable (set to anything but \"\", \"0\" or \"false\"), which GitHub\n"
    s += "Actions, GitLab and most other CI services set. New rules only warn\n"
    s += "(W0003), since they ask more of the code.\n"
    s += "\n"
    s += "If the owner agrees with the change, they run `brine rules approve` and\n"
    s += "commit RULES.lock; otherwise undo the change:\n"
    s += "\n"
    s += "    brine rules --explain          # what the rules say now, in plain English\n"
    s += "    brine rules approve            # only when the owner agrees\n"
    s += "    git add RULES.lock\n"
    s += "\n"
    s += "Put RULES.br, rules/ and RULES.lock under CODEOWNERS so changing them\n"
    s += "needs the owner's review, and run `brine rules --base main` in CI to list\n"
    s += "what a change approved.\n"
    t.push(("E0613", "rules changed since approval", s))

    s = "A runtime check (index bounds, overflow, division by zero, a conversion,\n"
    s += "...) that the prover shows fails every time the line runs, for example:\n"
    s += "\n"
    s += "    let xs = [1, 2]\n"
    s += "    print(xs[5])          # error: len(xs) is 2, so this always panics\n"
    s += "    print(xs[-1])         # error: no negative indexes; write xs[len(xs) - 1]\n"
    s += "\n"
    s += "The error shows the values (\"the index is 5 and the length is 2\") and\n"
    s += "what that kind of check needs. Indexes are never negative: `xs[-1]` is\n"
    s += "always out of bounds, and the last element is `xs[len(xs) - 1]`. Also\n"
    s += "reported: `int(\"abc\")`, a key a map literal doesn't have\n"
    s += "(`{\"a\": 1}[\"b\"]`), and `unwrap()` of a `let` that is `None`.\n"
    s += "\n"
    s += "A check that can only fail isn't a runtime check, it's a bug, and nothing\n"
    s += "after it could run. Fix the values it uses (there are no negative indexes:\n"
    s += "the last element is `xs[len(xs) - 1]`). If the line really can't be\n"
    s += "reached, show the prover why: return before it, or add a `requires` that\n"
    s += "rules the case out. Code the prover already sees can't run (after\n"
    s += "`panic(...)`, or in a branch whose condition is false) is never reported.\n"
    s += "An `assert` that always fails is allowed (`assert false` on purpose), and\n"
    s += "`brine check --report` marks it \"always fails\".\n"
    t.push(("E0614", "a check that always fails", s))

    s = "`import a.b` loads `a/b.br` relative to the directory of the main file, in\n"
    s += "every module. Each leading `..` goes one directory up: `import ..lib` loads\n"
    s += "`lib.br` from the directory above. Check the file name and location; the\n"
    s += "error says where brine looked, and suggests `..` when the file is above.\n"
    s += "\n"
    s += "    app/main.br:      import util.text    # loads app/util/text.br\n"
    s += "    app/main.br:      import ..shared     # loads shared.br, next to app/\n"
    t.push(("E0701", "module not found", s))

    s = "On x86-64 (Windows, Linux, macOS) and arm64 (Linux, macOS) brine makes\n"
    s += "executables itself and needs no C compiler. It needs one (clang or gcc) to\n"
    s += "build through C: with `BRINE_BACKEND=c`, or on other platforms. Unset\n"
    s += "BRINE_BACKEND to build native code, or install a C compiler, or point\n"
    s += "BRINE_CC at one. `brine doctor` checks your setup.\n"
    s += "\n"
    s += "    brine doctor                           # what brine found\n"
    s += "    BRINE_CC=clang BRINE_BACKEND=c brine build app.br\n"
    s += "\n"
    s += "WebAssembly (`--target wasm` or `web`) takes the clang and C library of\n"
    s += "wasi-sdk instead: download it from\n"
    s += "https://github.com/WebAssembly/wasi-sdk/releases and set WASI_SDK_PATH to\n"
    s += "its folder (or unpack it to /opt/wasi-sdk).\n"
    t.push(("E0702", "no C compiler", s))

    s = "A program starts at `fn main():` in its main file. `main` may also return an\n"
    s += "`int`, which becomes the process exit code. (Libraries and test-only files\n"
    s += "can be checked with `brine check` and tested with `brine test`.)\n"
    s += "\n"
    s += "    fn main():\n"
    s += "        print(\"hello\")\n"
    t.push(("E0703", "no main function", s))

    s = "`main` takes no parameters (command-line arguments come from `args()`) and\n"
    s += "returns one of:\n"
    s += "\n"
    s += "    fn main():                      # exit code 0\n"
    s += "    fn main() -> int:               # the exit code\n"
    s += "    fn main() -> Result[(), str]:   # Err(e) prints \"error: e\" and exits with 1\n"
    s += "    fn main() -> Result[int, str]:  # Ok(n): exit code n; Err(e) as above\n"
    s += "\n"
    s += "`Err(e)` goes to stderr. Anything else is an error:\n"
    s += "\n"
    s += "    fn main(argv: [str]):           # error: use args() inside main\n"
    s += "        print(argv)\n"
    s += "\n"
    s += "The `Result` form lets `main` use `?`:\n"
    s += "\n"
    s += "    fn main() -> Result[(), str]:\n"
    s += "        let text = read_file(\"config.txt\")?\n"
    s += "        print(len(text))\n"
    s += "        return Ok(())\n"
    t.push(("E0706", "invalid `main` signature", s))

    s = "`embed(path)` puts a file's text into the program when it is compiled, so\n"
    s += "the file must exist then, be UTF-8 text, and its path must be a string literal\n"
    s += "(not a variable or an f-string). The path is relative to the directory of the\n"
    s += "`.br` file that contains the call; \"\\r\\n\" line endings become \"\\n\".\n"
    s += "\n"
    s += "    let name = \"help.txt\"\n"
    s += "    print(embed(name))                  # error: not a string literal\n"
    s += "\n"
    s += "    const HELP = embed(\"help.txt\")      # help.txt next to this file\n"
    s += "    fn main():\n"
    s += "        print(HELP)\n"
    s += "\n"
    s += "To read a file while the program runs instead, use `read_file(path)`.\n"
    t.push(("E0707", "cannot embed a file", s))

    s = "The command line asks for something brine can't do: an unknown command or\n"
    s += "option, an option without its value or with one out of range, or a file\n"
    s += "or project that isn't there. The message says which; `brine help` lists\n"
    s += "the commands and `brine <command> --help` the options of one.\n"
    s += "\n"
    s += "    brine buidl app.br             # unknown command: `build`\n"
    s += "    brine test --timeout           # `--timeout` needs a number of seconds\n"
    t.push(("E0708", "invalid command line", s))

    s = "brine built the program but couldn't run it to the end: starting it failed\n"
    s += "(the executable is missing or blocked, or local ports for `--ranks` ran\n"
    s += "out), or it crashed. A crash names its cause, such as an access violation\n"
    s += "or an abort. Programs written in brine panic with a message instead, so a\n"
    s += "crash usually comes from an `extern fn` or from the system.\n"
    s += "\n"
    s += "    extern fn abort()\n"
    s += "    fn main():\n"
    s += "        abort()                    # `brine run`: the program crashed\n"
    t.push(("E0709", "the program could not be run", s))

    s = "The compiler couldn't create its output or cache files. Check permissions\n"
    s += "and free disk space for the `target/` directory. On Windows a program can't\n"
    s += "be replaced while it runs, so brine moves it to `<name>.old` first; when an\n"
    s += "older one still runs as `<name>.old` too, stop one of them (or build\n"
    s += "somewhere else with `-o`) and build again. When the C linker can't read a\n"
    s += "file of the build cache, another brine building at the same time was\n"
    s += "most likely changing it: build again, and if it keeps happening, delete\n"
    s += "the cache folder the error names (brine fills it again).\n"
    s += "\n"
    s += "    brine build app.br -o build/app2       # build somewhere else\n"
    t.push(("E0704", "cannot write build files", s))

    s = "The generated code didn't compile or link. Check these first:\n"
    s += "\n"
    s += "* the linker names a missing `extern fn` of your program: link the library\n"
    s += "  that has it, or remove the declaration;\n"
    s += "* `BRINE_CC` is set (or `BRINE_BACKEND=c`): the note says the C compiler\n"
    s += "  couldn't run, or failed. Point BRINE_CC at a working clang or gcc, or\n"
    s += "  unset it; `brine doctor` shows what brine found.\n"
    s += "\n"
    s += "    BRINE_CC=nosuchcc BRINE_BACKEND=c brine build app.br   # E0705\n"
    s += "    BRINE_BACKEND=native brine build app.br                # no C compiler needed\n"
    s += "\n"
    s += "Otherwise it's a bug in brine, not in your program. Please report it with\n"
    s += "the source file and the output of `brine doctor`. Building with\n"
    s += "`BRINE_BACKEND=c` (or `=native`) tries the other backend.\n"
    t.push(("E0705", "building the generated code failed", s))

    s = "Every `match` must handle every possible value, so a new enum variant can\n"
    s += "never slip through unnoticed. The error shows an example value that no case\n"
    s += "handles.\n"
    s += "\n"
    s += "    enum Color:\n"
    s += "        Red\n"
    s += "        Green\n"
    s += "    let c = Color.Red\n"
    s += "    match c:                       # error: `Color.Green` isn't handled\n"
    s += "        case Color.Red:\n"
    s += "            print(\"red\")\n"
    s += "\n"
    s += "Add a case for it, or end with a catch-all:\n"
    s += "\n"
    s += "    match shape:\n"
    s += "        case Shape.Circle(r):\n"
    s += "            return 3.14 * r * r\n"
    s += "        case _:\n"
    s += "            return 0.0\n"
    s += "\n"
    s += "Cases with an `if` guard don't count toward this, because the guard may be\n"
    s += "false. Integers and strings have too many values to list, so matching on them\n"
    s += "always needs `case _:` (or a plain name, which also matches everything).\n"
    t.push(("E0320", "`match` doesn't handle every value", s))

    s = "In `case A | B:` either alternative may match, so each one must bind the\n"
    s += "same names, with the same types; otherwise a name might have no value:\n"
    s += "\n"
    s += "    enum Step:\n"
    s += "        Add(c: [int])\n"
    s += "        Delete(c: [int])\n"
    s += "        Skip\n"
    s += "    let s = Step.Skip\n"
    s += "    match s:\n"
    s += "        case Step.Add(c) | Step.Skip:      # error: `Step.Skip` doesn't bind `c`\n"
    s += "            print(c)\n"
    s += "        case Step.Delete(c):\n"
    s += "            print(c)\n"
    s += "\n"
    s += "`case Step.Add(c) | Step.Delete(c):` is fine: both bind `c: [int]`.\n"
    s += "Use `_` for values you don't need, or write a separate `case` for each\n"
    s += "alternative.\n"
    t.push(("E0321", "alternatives of `|` bind different names", s))

    s = "A constant in a pattern matches the value it stands for, like the literal\n"
    s += "would (`case OP_ADD:`). Only integer, string and bool constants can: there\n"
    s += "are no float or array patterns.\n"
    s += "\n"
    s += "    const SCALE = 2.5\n"
    s += "    let x = 2.5\n"
    s += "    match x:\n"
    s += "        case SCALE:                # error: a float\n"
    s += "            print(\"scale\")\n"
    s += "        case _:\n"
    s += "            pass\n"
    s += "\n"
    s += "Compare with a guard instead:\n"
    s += "\n"
    s += "    match x:\n"
    s += "        case v if v == SCALE:\n"
    s += "            ...\n"
    t.push(("E0322", "constant that can't be a pattern", s))

    s = "A method can have type parameters of its own, and a method of a generic\n"
    s += "type can also use the type's parameters. The two can't share a name, since\n"
    s += "`T` would then mean two things inside the method:\n"
    s += "\n"
    s += "    struct Box[T]:\n"
    s += "        v: T\n"
    s += "\n"
    s += "        fn pair[T](self, x: T) -> (T, T):    # error: `T` is already Box's\n"
    s += "            return (self.v, x)\n"
    s += "\n"
    s += "Give it a name of its own:\n"
    s += "\n"
    s += "        fn pair[U](self, x: U) -> (T, U):    # ok\n"
    s += "            return (self.v, x)\n"
    s += "\n"
    s += "Type arguments of a method are inferred from its arguments, or written after\n"
    s += "the method name: `b.pair[str](\"x\")`.\n"
    t.push(("E0331", "a method's type parameter repeats its type's", s))

    s = "The compiler works out type arguments from the arguments and from the type\n"
    s += "the result must have.\n"
    s += "\n"
    s += "    fn make[T]() -> [T]:\n"
    s += "        return []\n"
    s += "    let xs = make()                  # error: an array of what?\n"
    s += "    let o = None                     # error: an Option of what?\n"
    s += "\n"
    s += "When neither says what a type parameter is, write it:\n"
    s += "\n"
    s += "    let xs = make[int]()             # explicit type argument\n"
    s += "    let o: Option[str] = None        # or annotate the variable\n"
    s += "    let p = Pair[int, str](a=1, b=\"x\")\n"
    t.push(("E0332", "can't infer a type argument", s))

    s = "Each combination of type arguments makes a separate copy of a generic function\n"
    s += "or type. A function that calls itself with an ever larger type, like `f[[T]]`\n"
    s += "inside `f[T]`, would need infinitely many. Restructure the recursion so the\n"
    s += "type arguments stay the same.\n"
    s += "\n"
    s += "    fn depth[T](x: T, n: int) -> int:\n"
    s += "        if n == 0:\n"
    s += "            return 0\n"
    s += "        return 1 + depth([x], n - 1)     # error: T, [T], [[T]], ...\n"
    s += "    print(depth(1, 3))\n"
    t.push(("E0333", "too many generic instances", s))

    s = "Generic types need one type argument per parameter: `Option[int]`,\n"
    s += "`Result[int, str]`, `Pair[A, B]`. Types that aren't generic take none.\n"
    s += "\n"
    s += "    fn size(r: Result[int]) -> int:     # error: write Result[int, str]\n"
    s += "        return 0\n"
    t.push(("E0334", "wrong type arguments", s))

    s = "Map keys must be compared with `==` reliably, so they can be integers,\n"
    s += "`bool`, `str`, enums, or arrays, tuples and structs made of those.\n"
    s += "Floats are not allowed because `nan != nan`; maps can't be keys either.\n"
    s += "\n"
    s += "    var by_id: {int: str} = {}         # ok\n"
    s += "    var cells: {(int, int): bool} = {} # ok\n"
    s += "    var bad: {float: str} = {}         # error\n"
    t.push(("E0335", "invalid map key type", s))

    s = "The same constant key appears twice in one `{...}` literal, so the\n"
    s += "first value would be silently replaced. Remove one of them.\n"
    s += "\n"
    s += "    let ages = {\"ann\": 31, \"ann\": 32}   # error\n"
    t.push(("E0336", "duplicate key in a map literal", s))

    s = "A comparison on its own line does nothing. Did you mean `=` (assignment) or\n"
    s += "`assert` / `prove`?\n"
    s += "\n"
    s += "    var x = 1\n"
    s += "    x == 2                         # warning: write `x = 2`?\n"
    t.push(("W0001", "unused comparison", s))

    s = "An earlier `case` (`_` or a plain name, without a guard) already matches every\n"
    s += "value, so this case can never run. Remove it or move it before the catch-all.\n"
    s += "\n"
    s += "    let n = len(args())\n"
    s += "    match n:\n"
    s += "        case _:\n"
    s += "            print(\"some\")\n"
    s += "        case 0:                    # warning: `_` already took it\n"
    s += "            print(\"none\")\n"
    t.push(("W0002", "unreachable case", s))

    s = "These rules aren't in RULES.lock yet. They are proven like every other rule;\n"
    s += "approving them records that the rules' owner agrees with what they say.\n"
    s += "`brine rules --explain` puts them in plain English for the owner to read,\n"
    s += "and `brine rules approve` approves them (see E0613):\n"
    s += "\n"
    s += "    brine rules --explain          # for the owner to read\n"
    s += "    brine rules approve            # once they agree\n"
    t.push(("W0003", "rules not approved yet", s))

    s = "brine.toml has a key or a section that brine doesn't read, so it changes\n"
    s += "nothing; usually it's a typo (`provn = true` leaves `proven` off). brine reads:\n"
    s += "\n"
    s += "    [package]\n"
    s += "    name = \"app\"          # letters, digits, `_` and `-`\n"
    s += "    version = \"0.1.0\"\n"
    s += "\n"
    s += "    [build]\n"
    s += "    main = \"src/main.br\"  # the default\n"
    s += "\n"
    s += "    [check]\n"
    s += "    typed = false\n"
    s += "    proven = false\n"
    t.push(("W0004", "brine.toml has a key brine doesn't read", s))

    s = "The prover does a limited amount of work on each function, and keeps a limit\n"
    s += "on how much it remembers about its values, so that one long or tangled\n"
    s += "function can't take minutes or all the memory to check. This function went\n"
    s += "past a limit, so the prover stopped trying the harder proofs in it: the\n"
    s += "runtime checks it gave up on stay in the program (they are still checked, so\n"
    s += "nothing unsafe gets through). The warning names the first few, and\n"
    s += "`brine check --report` marks each \"prover gave up\". What follows from the\n"
    s += "ranges of the values involved, or from the facts about those values alone,\n"
    s += "is still proven past the limits.\n"
    s += "\n"
    s += "A claim it gives up on (a call's `requires`, an `invariant`, an `ensures`, a\n"
    s += "`prove`) is an error, not a runtime check: it is a promise the code makes.\n"
    s += "A function shows the first few of these errors, and counts the rest.\n"
    s += "`BRINE_TIMES=2 brine check` prints the work, size and time of each function\n"
    s += "that takes the prover long.\n"
    s += "\n"
    s += "Split the function into smaller ones. Each function is proven on its own,\n"
    s += "with its own limit, and a function's `ensures` tells its callers what they\n"
    s += "need without the prover going through its body again:\n"
    s += "\n"
    s += "    fn step(acc: int, x: int) -> int:\n"
    s += "        requires 0 <= acc < 1000003\n"
    s += "        ensures 0 <= result < 1000003\n"
    s += "        return (acc + x % 1000) % 1000003\n"
    s += "\n"
    s += "In code that must be proven (`proven = true`, or a rule), a check given up on\n"
    s += "is an error (E0607), like any other check that remains.\n"
    t.push(("W0005", "the prover gave up on a function", s))

    s = "A plain name in a `case` is a new variable: it matches every value and binds\n"
    s += "it. It never compares with a constant or a variant of the same name that\n"
    s += "lives elsewhere, so this case runs for everything and the cases after it\n"
    s += "never do:\n"
    s += "\n"
    s += "    import limits\n"
    s += "\n"
    s += "    match code:\n"
    s += "        case MAX:          # captures `code` as `MAX`\n"
    s += "            ...\n"
    s += "\n"
    s += "The same with a variant:\n"
    s += "\n"
    s += "    enum Color:\n"
    s += "        Red\n"
    s += "        Green\n"
    s += "\n"
    s += "    fn is_red(c: Color) -> bool:\n"
    s += "        match c:\n"
    s += "            case Red:          # warning: binds `Red`, true for every color\n"
    s += "                return true\n"
    s += "\n"
    s += "Name the constant with its module, `case limits.MAX:`, and a variant with\n"
    s += "its enum, `case Color.Red:`. To capture on purpose, use a name that isn't\n"
    s += "one of theirs, or `_` when the value isn't needed.\n"
    t.push(("W0006", "a `case` name captures every value", s))
    return t

# What each check is called (E0607 and `--report` use these names), from the
# table, so the list can't fall behind it.
fn check_names() -> str:
    var seen: [str] = []
    for c in every_check():
        if c.what() not in seen:
            seen.push(c.what())
    return ", ".join(seen)

# `s` in lines of at most `width` characters, each ending in a newline.
fn wrap(s: str, width: int) -> str:
    var out = ""
    var line = ""
    for w in s.split(" "):
        if line != "" and len(line) + 1 + len(w) > width:
            out += line + "\n"
            line = w
        elif line == "":
            line = w
        else:
            line += " " + w
    if line != "":
        out += line + "\n"
    return out

# A quoted JSON string (the same escaping as `diag.json_str`).
fn json_escape(s: str) -> str:
    let hex = "0123456789abcdef"
    var o = "\""
    for c in s:
        if c == "\"":
            o += "\\\""
        elif c == "\\":
            o += "\\\\"
        elif c == "\n":
            o += "\\n"
        elif c == "\r":
            o += "\\r"
        elif c == "\t":
            o += "\\t"
        elif len(c) == 1 and ord(c) < 32:
            let n = ord(c)
            o += "\\u00" + hex[n / 16] + hex[n % 16]
        else:
            o += c
    return o + "\""

# `brine explain [code]`: list every code, or print one explanation.
# An unknown code is an Err whose message
# the caller reports (as `error: ...`, exit 2).
fn explain_cmd(code: Option[str], json: bool) -> Result[int, str]:
    let table = all()
    match code:
        case None:
            if json:
                for e in table:
                    let (c, title, _) = e
                    print("{\"code\":" + json_escape(c) + ",\"title\":" + json_escape(title) + "}")
            else:
                print("Error codes (run `brine explain <code>` for details):\n")
                for e2 in table:
                    let (c2, title2, _) = e2
                    print("  " + c2 + "  " + title2)
            return Ok(0)
        case Some(raw):
            var want = raw.upper()
            var digits = true
            for ch in want:
                if not ch.is_digit():
                    digits = false
            if digits:
                var pad = want
                while len(pad) < 4:
                    pad = "0" + pad
                want = "E" + pad
            for e3 in table:
                let (c3, title3, body) = e3
                if c3 == want:
                    if json:
                        print(
                            "{\"code\":"
                            + json_escape(c3)
                            + ",\"title\":"
                            + json_escape(title3)
                            + ",\"explanation\":"
                            + json_escape(body)
                            + "}"
                        )
                    else:
                        print(c3 + ": " + title3 + "\n\n" + body.rstrip())
                    return Ok(0)
            return Err("no explanation for `" + want + "` (run `brine explain` to list all codes)")
