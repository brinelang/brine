# Tests for brine's own linker (link.br): objects written by hand, linked into
# executables for this machine, run.
#
#     brine test compiler/dev_link.br

from obj import ObjFile, OSym, ORel, new_obj, SEC_UNDEF, SEC_TEXT, SEC_DATA, SEC_RODATA, R_PC32, R_CALL, R_ABS64, R_GOT, R_A64_CALL26, R_A64_PAGE, R_A64_LO12, R_A64_GOT_PAGE, R_A64_GOT_LO12, ARCH_A64, put32
from link import link_pe, link_elf, link_macho, sha256, PE_DLLS, ELF_LIBS
from ir import str_bytes

const DIR = "target/link"

fn sym(ref o: ObjFile, name: str, sec: int, off: int, func: bool) -> int:
    o.syms.push(OSym(name=name, sec=sec, off=off, global=func, func=func))
    return len(o.syms) - 1

# Appends an instruction whose last four bytes are a 32-bit field relocated
# against `s` (none if `s` < 0).
fn ins(ref o: ObjFile, bytes: [u8], s: int, kind: int):
    o.text.extend(bytes)
    if s >= 0:
        o.trel.push(ORel(off=len(o.text) - 4, sym=s, kind=kind, add=-4))

# Appends an AArch64 instruction, relocated against `s` (none if `s` < 0).
fn w(ref o: ObjFile, word: int, s: int, kind: int):
    if s >= 0:
        o.trel.push(ORel(off=len(o.text), sym=s, kind=kind, add=0))
    put32(ref o.text, word)

const MSG = "hello from brine's linker"

# Read-only strings, a pointer to one and a pointer to `puts` in data.
fn base_obj() -> (ObjFile, int, int, int, int, int):
    var o = new_obj()
    str_bytes(ref o.rodata, MSG)
    o.rodata.push(0)
    let msg2_at = len(o.rodata)
    str_bytes(ref o.rodata, "via data")
    o.rodata.push(0)
    let msg = sym(ref o, "msg", SEC_RODATA, 0, false)
    let msg2 = sym(ref o, "msg2", SEC_RODATA, msg2_at, false)
    let ptr = sym(ref o, "ptr", SEC_DATA, 0, false)
    let fp = sym(ref o, "fp", SEC_DATA, 8, false)
    let puts = sym(ref o, "puts", SEC_UNDEF, 0, false)
    for _ in 0..16:
        o.data.push(0)
    o.drel.push(ORel(off=0, sym=msg2, kind=R_ABS64, add=0))
    o.drel.push(ORel(off=8, sym=puts, kind=R_ABS64, add=0))
    return (o, msg, msg2, ptr, fp, puts)

struct Ran:
    code: int
    out: str

fn run_exe(path: str) -> Ran:
    match os.spawn([path], {}, true, false):
        case Ok(h):
            let code = os.wait(h)
            let (out, err) = os.output(h)
            return Ran(code=code, out=out.replace("\r\n", "\n") + err)
        case Err(e):
            return Ran(code=-1, out=e)

fn write_exe(bytes: [u8], name: str) -> str:
    assert os.make_dir(DIR).is_ok()
    let path = DIR + "/" + name
    match os.write_bytes(path, bytes):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    if os.name() != "windows":
        # (no builtin sets the mode bits yet)
        match os.spawn(["chmod", "+x", path], {}, true, false):
            case Ok(h):
                assert os.wait(h) == 0
            case Err(e):
                panic(e)
    return path

const WANT = "hello from brine's linker\nvia data\nhello from brine's linker\n"

test "a Windows image calls DLLs, through code and through data":
    if os.name() != "windows" or os.arch() != "x86_64":
        return
    var (o, msg, msg2, ptr, fp, puts) = base_obj()
    let ex = sym(ref o, "exit", SEC_UNDEF, 0, false)
    sym(ref o, "start", SEC_TEXT, 0, true)
    # sub rsp, 40
    ins(ref o, [72, 131, 236, 40], -1, 0)
    # lea rcx, [rip + msg]; call puts
    ins(ref o, [72, 141, 13, 0, 0, 0, 0], msg, R_PC32)
    ins(ref o, [232, 0, 0, 0, 0], puts, R_CALL)
    # mov rcx, [rip + ptr]; call puts
    ins(ref o, [72, 139, 13, 0, 0, 0, 0], ptr, R_PC32)
    ins(ref o, [232, 0, 0, 0, 0], puts, R_CALL)
    # lea rcx, [rip + msg]; call [rip + fp]
    ins(ref o, [72, 141, 13, 0, 0, 0, 0], msg, R_PC32)
    ins(ref o, [255, 21, 0, 0, 0, 0], fp, R_PC32)
    # exit(7)
    ins(ref o, [185, 7, 0, 0, 0], -1, 0)
    ins(ref o, [232, 0, 0, 0, 0], ex, R_CALL)
    o.text.push(204)
    assert msg2 >= 0
    match link_pe(o, "start", PE_DLLS):
        case Ok(b):
            let r = run_exe(write_exe(b, "t1.exe"))
            assert r.code == 7, f"exit code {r.code}: {r.out}"
            assert r.out == WANT, r.out
        case Err(e):
            panic(e)

test "a missing import is an error":
    if os.name() != "windows":
        return
    var (o, msg, msg2, ptr, fp, puts) = base_obj()
    let nope = sym(ref o, "no_such_function_anywhere", SEC_UNDEF, 0, false)
    sym(ref o, "start", SEC_TEXT, 0, true)
    ins(ref o, [232, 0, 0, 0, 0], nope, R_CALL)
    assert msg + msg2 + ptr + fp + puts >= 0
    match link_pe(o, "start", PE_DLLS):
        case Ok(_):
            panic("linked")
        case Err(e):
            assert "no_such_function_anywhere" in e, e

# A SysV x86-64 main that prints WANT through `puts` and returns 7.
fn x64_main() -> ObjFile:
    var (o, msg, msg2, ptr, fp, puts) = base_obj()
    sym(ref o, "main", SEC_TEXT, 0, true)
    # push rbx
    ins(ref o, [83], -1, 0)
    # lea rdi, [rip + msg]; call puts
    ins(ref o, [72, 141, 61, 0, 0, 0, 0], msg, R_PC32)
    ins(ref o, [232, 0, 0, 0, 0], puts, R_CALL)
    # mov rdi, [rip + ptr]; call puts
    ins(ref o, [72, 139, 61, 0, 0, 0, 0], ptr, R_PC32)
    ins(ref o, [232, 0, 0, 0, 0], puts, R_CALL)
    # lea rdi, [rip + msg]; call [rip + fp]
    ins(ref o, [72, 141, 61, 0, 0, 0, 0], msg, R_PC32)
    ins(ref o, [255, 21, 0, 0, 0, 0], fp, R_PC32)
    # mov rax, [rip + puts@GOT]; lea rdi, [rip + msg]; call rax (not printed: checks it links)
    ins(ref o, [72, 139, 5, 0, 0, 0, 0], puts, R_GOT)
    # mov eax, 7; pop rbx; ret
    ins(ref o, [184, 7, 0, 0, 0, 91, 195], -1, 0)
    assert msg2 >= 0
    return o

test "a Linux executable starts through libc and calls it":
    if os.name() != "linux" or os.arch() != "x86_64":
        return
    match link_elf(x64_main(), "main", ELF_LIBS):
        case Ok(b):
            let r = run_exe(write_exe(b, "t1"))
            assert r.code == 7, f"exit code {r.code}: {r.out}"
            assert r.out == WANT, r.out
        case Err(e):
            panic(e)

# The same for AArch64.
fn a64_main() -> ObjFile:
    var (o, msg, msg2, ptr, fp, puts) = base_obj()
    o.arch = ARCH_A64
    sym(ref o, "main", SEC_TEXT, 0, true)
    # stp x29, x30, [sp, #-16]!; mov x29, sp
    w(ref o, 0xA9BF7BFD, -1, 0)
    w(ref o, 0x910003FD, -1, 0)
    # x0 = msg; bl puts
    w(ref o, 0x90000000, msg, R_A64_PAGE)
    w(ref o, 0x91000000, msg, R_A64_LO12)
    w(ref o, 0x94000000, puts, R_A64_CALL26)
    # x0 = *ptr; bl puts
    w(ref o, 0x90000000, ptr, R_A64_PAGE)
    w(ref o, 0x91000000, ptr, R_A64_LO12)
    w(ref o, 0xF9400000, -1, 0)
    w(ref o, 0x94000000, puts, R_A64_CALL26)
    # x0 = msg; x1 = *fp; blr x1
    w(ref o, 0x90000000, msg, R_A64_PAGE)
    w(ref o, 0x91000000, msg, R_A64_LO12)
    w(ref o, 0x90000001, fp, R_A64_PAGE)
    w(ref o, 0x91000021, fp, R_A64_LO12)
    w(ref o, 0xF9400021, -1, 0)
    w(ref o, 0xD63F0020, -1, 0)
    # x2 = puts from the GOT (not called: checks it links)
    w(ref o, 0x90000002, puts, R_A64_GOT_PAGE)
    w(ref o, 0xF9400042, puts, R_A64_GOT_LO12)
    # return 7
    w(ref o, 0x528000E0, -1, 0)
    w(ref o, 0xA8C17BFD, -1, 0)
    w(ref o, 0xD65F03C0, -1, 0)
    assert msg2 >= 0
    return o

# (linked everywhere, so its machine code can be inspected; run on AArch64)
test "an AArch64 Linux executable starts through libc and calls it":
    match link_elf(a64_main(), "main", ELF_LIBS):
        case Ok(b):
            let path = write_exe(b, "t2")
            if os.name() != "linux" or os.arch() != "aarch64":
                return
            let r = run_exe(path)
            assert r.code == 7, f"exit code {r.code}: {r.out}"
            assert r.out == WANT, r.out
        case Err(e):
            panic(e)

fn hex(b: [u8]) -> str:
    var s = ""
    for x in b:
        s += f"{int(x):02x}"
    return s

test "SHA-256 of the standard test messages":
    var abc: [u8] = []
    str_bytes(ref abc, "abc")
    assert hex(sha256(abc)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    assert hex(sha256([])) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    var two: [u8] = []
    str_bytes(ref two, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    assert hex(sha256(two)) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
    var mil = [u8(97)] * 1000000
    assert hex(sha256(mil)) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"

# (linked everywhere; run on macOS)
test "a macOS executable starts through dyld and calls libSystem":
    for a64 in [false, true]:
        let o = a64_main() if a64 else x64_main()
        match link_macho(o, "main", "t3"):
            case Ok(b):
                let path = write_exe(b, "t3-a64" if a64 else "t3-x64")
                if os.name() != "macos" or (os.arch() == "aarch64") != a64:
                    continue
                let r = run_exe(path)
                assert r.code == 7, f"exit code {r.code}: {r.out}"
                assert r.out == WANT, r.out
            case Err(e):
                panic(e)
