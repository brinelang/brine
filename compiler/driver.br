# The compilation pipeline: load the modules, check, verify, generate code
# and link.
from diag import Span, Diag, SourceMap
import diag
from ast import Module, Program, module_name
from parser import parse_module
from types import Ty, IntTy
from info import ProgramInfo, TryKind, try_kind, PRELUDE, RT
from check import new_checker
import project
import uniform
import pareffects
import verify
import lower
import ir
import ir_c
import irverify
import x64
import a64
from obj import ObjFile
from link import link_pe, link_elf, link_macho, PE_DLLS, ELF_LIBS
from verify import Report
import rules
from rules import Rules

const PRELUDE_SRC = embed("../runtime/prelude.br")
const RT_SRC = embed("../runtime/rt.br")
const RT_H = embed("../runtime/brine_rt.h")
const RT_C = embed("../runtime/brine_rt.c")
# the math library, which brine_rt.c includes
const RT_M = embed("../runtime/brine_math.c")
const CPU_C = embed("../runtime/brine_cpu.c")
# runs a WebAssembly build under Node.js (`brine run --target wasm`)
const WASI_NODE = embed("../runtime/brine_wasi.mjs")
# the browser side of `--target web`
const WEB_JS = embed("../runtime/brine_web.js")
const WEB_HTML = embed("../runtime/brine_web.html")
# The one place the version is set (semantic versioning; see AGENTS.md).
const VERSION = "0.9.2"

struct Frontend:
    sm: SourceMap
    diags: [Diag]
    prog: Option[Program]
    info: Option[ProgramInfo]
    report: Option[Report]
    # what RULES.br promises, once the program is checked
    rules: Option[Rules]

    fn has_errors(self) -> bool:
        return any(d.is_error() for d in self.diags)

fn has_errors(ds: [Diag]) -> bool:
    return any(d.is_error() for d in ds)

# Reads a source file with line endings normalized and without a byte order
# mark, so spans and output are the same on every OS and in every editor.
fn read_source(path: str) -> Result[str, str]:
    match read_file(path):
        case Ok(text):
            return Ok(strip_bom(text.replace("\r\n", "\n")))
        case Err(e):
            # read_file's message already names the file
            return Err(e + bad_utf8_at(path))

# Where a file stops being UTF-8 (RFC 3629), for read_file's "not valid UTF-8
# text": `, at line 3, column 9 (byte 0xff)`, or "" if it is valid or unreadable.
fn bad_utf8_at(path: str) -> str:
    var b: [u8] = []
    match os.read_bytes(path):
        case Ok(x):
            b = x
        case Err(_):
            return ""
    let n = len(b)
    var i = 0
    var line = 1
    var col = 1
    while i < n:
        let c = int(b[i])
        var need = 0
        var lo = 0x80
        var hi = 0xBF
        if c < 0x80:
            need = 0
        elif 0xC2 <= c <= 0xDF:
            need = 1
        elif 0xE0 <= c <= 0xEF:
            need = 2
            if c == 0xE0:
                lo = 0xA0
            elif c == 0xED:
                hi = 0x9F
        elif 0xF0 <= c <= 0xF4:
            need = 3
            if c == 0xF0:
                lo = 0x90
            elif c == 0xF4:
                hi = 0x8F
        else:
            need = -1
        var ok = need >= 0 and i + need < n
        var k = 1
        while ok and k <= need:
            let d = int(b[i + k])
            ok = (lo <= d <= hi) if k == 1 else (0x80 <= d <= 0xBF)
            k += 1
        if not ok:
            return f", at line {line}, column {col} (byte 0x{c:02x})"
        if c == 10:
            line += 1
            col = 1
        else:
            col += 1
        i += need + 1
    return ""

# Notepad and others may start a UTF-8 file with a byte order mark
fn strip_bom(text: str) -> str:
    return text[3:] if text.starts_with("\u{FEFF}") else text

# Where `load` reads a program from: the files on disk, or (`rev`) the files
# as they are in a git revision. `extra` is more source for a module, by module
# name: `brine spec-diff` adds functions to a program this way. `also` are
# more modules (import paths) to load as if the main file imported them:
# `brine check` checks a project's every file this way.
struct Source:
    rev: Option[str]
    extra: {str: str}
    also: [[str]]

fn on_disk() -> Source:
    return Source(rev=None, extra={}, also=[])

fn read_at(path: str, rev: Option[str]) -> Result[str, str]:
    match rev:
        case None:
            return read_source(path)
        case Some(r):
            let dir = dir_of(path)
            let name = project.file_name(path).unwrap_or(path)
            let cmd = ["git", "-C", dir if dir != "" else ".", "show", r + ":./" + name]
            match os.spawn(cmd, {}, true, false):
                case Ok(p):
                    let code = os.wait(p)
                    let (out, err) = os.output(p)
                    if code != 0:
                        var why = err.strip().split("\n")[0].replace("fatal: ", "")
                        if why.starts_with("invalid object name"):
                            why = (
                                "the repository has no commits yet: commit once, or pass `--base <rev>`"
                                if r == "HEAD"
                                else f"there is no revision `{r}` in this repository"
                            )
                        return Err(
                            f"could not read `{display_path(path)}` from git revision `{r}`: {why}"
                        )
                    return Ok(strip_bom(out.replace("\r\n", "\n")))
                case Err(e):
                    return Err(f"could not run git: {e}")

# Path for messages: relative to the current directory when it's inside it.
fn display_path(p: str) -> str:
    var s = p
    if project.is_absolute(p):
        let cwd = os.cwd()
        let n = len(cwd)
        if n > 0 and len(p) > n and p.starts_with(cwd) and project.sep_at(p, n):
            s = p[n + 1:]
    s = s.replace("\\", "/")
    if s.starts_with("./"):
        return s[2:]
    return s

# The directory above `d`.
fn up_dir(d: str) -> str:
    if d == "." or d == "":
        return ".."
    match project.file_name(d):
        case Some(_):
            match project.parent(d):
                case Some(up):
                    return up if up != "" else "."
                case None:
                    pass
        case None:
            pass
    return project.join(d, "..")

# The file `import <path>` loads, from directory `root`.
fn module_file(root: str, path: [str]) -> str:
    var p = root
    for seg in path:
        if seg == "..":
            p = up_dir(p)
        else:
            p = project.join(p, seg)
    return p + ".br"

fn dir_of(p: str) -> str:
    match project.parent(p):
        case Some(d):
            return d
        case None:
            return ""

# Parses the entry file and every module it (transitively) imports.
# `import a.b` loads `<root>/a/b.br`, where root is the entry file's directory.
# An imported module: its source, or None when the file is missing.
struct Found:
    name: str
    src: Option[str]
    file: int

fn parse_found(f: Found) -> (Module, [Diag]):
    match f.src:
        case Some(src):
            return parse_module(src, f.file, f.name)
        case None:
            return (
                Module(
                    name=f.name,
                    file=f.file,
                    imports=[],
                    fns=[],
                    structs=[],
                    enums=[],
                    consts=[],
                    tests=[]
                ),
                []
            )

fn load(entry: str, ref sm: SourceMap, ref diags: [Diag]) -> Option[Program]:
    return load_from(entry, on_disk(), ref sm, ref diags)

# The rules that apply to a program.
struct RulesAt:
    # RULES.br's directory, "" if no rules apply
    dir: str
    # the program's main file is the one the rules call `main`
    is_main: bool

# Which rules apply to the program whose main file is `entry`. A project's
# RULES.br (next to brine.toml) applies to the programs in its source folder,
# the main file's (`src/`): their modules are the ones it names. Otherwise a
# RULES.br next to the main file applies. A file elsewhere (`repros/`, `tools/`)
# is a program of its own. A RULES.lock counts, so deleting RULES.br doesn't drop
# the approved rules.
fn rules_at(entry: str) -> RulesAt:
    let d = dir_or_dot(dir_of(entry))
    match project_from(d):
        case Some(rm):
            let root = rm.0
            if has_rules(root):
                if same_dir(d, dir_or_dot(dir_of(rm.1))):
                    return RulesAt(dir=root, is_main=is_rules_main(entry, rm.1))
                if same_dir(d, root):
                    # a file at the root of a project whose code is elsewhere
                    return RulesAt(dir="", is_main=false)
        case None:
            pass
    if has_rules(d):
        return RulesAt(dir=d, is_main=is_rules_main(entry, project.join(d, "main.br")))
    return RulesAt(dir="", is_main=false)

# Why no rules apply to `entry` although its project has a RULES.br (a main
# file outside the source folder), or "" when that isn't so: said on every
# build, so that nobody takes the program for one the rules cover.
fn rules_skipped(entry: str) -> str:
    if rules_at(entry).dir != "":
        return ""
    match project_from(dir_or_dot(dir_of(entry))):
        case Some(rm):
            let p = project.join(rm.0, rules.FILE)
            if not file_exists(p):
                return ""
            let src = display_path(dir_or_dot(dir_of(rm.1)))
            return f"none apply to {display_path(entry)}: {display_path(p)} covers the main files in `{src}/`, and a program elsewhere is one of its own"
        case None:
            return ""

# The project `d` is in: its root and its main file, written from `d` (`..`).
fn project_from(d: str) -> Option[(str, str)]:
    # (found from the absolute path, so that `..` works from inside `src/`)
    match project.find(os.abs_path(d).unwrap_or(d)):
        case Some(Ok(pr)):
            let root = relative_to(d, dir_or_dot(pr.root))
            # the main file from `root` too: a `\\?\` path can't mix separators
            var main = pr.main
            if main.starts_with(pr.root):
                var i = len(pr.root)
                while i < len(main) and (main[i] == "/" or main[i] == "\\"):
                    i += 1
                main = project.join(root, main[i:])
            return Some((root, main))
        case _:
            return None

# `main` in RULES.br is `main_file`'s module; any main file is, when there's
# no such file.
fn is_rules_main(entry: str, main_file: str) -> bool:
    return not os.is_file(main_file) or same_dir(entry, main_file)

# `root`, a directory above `d`, written from `d` (`..`) when it can be.
fn relative_to(d: str, root: str) -> str:
    var x = d
    for _ in 0..32:
        if same_dir(x, root):
            return x
        x = up_dir(x)
    return root

fn dir_or_dot(d: str) -> str:
    return d if d != "" else "."

# The same file or directory, however it's written.
fn same_dir(a: str, b: str) -> bool:
    let x = os.abs_path(a).unwrap_or(a)
    let y = os.abs_path(b).unwrap_or(b)
    return trim_sep(plain_path(x)) == trim_sep(plain_path(y))

fn trim_sep(p: str) -> str:
    let b = p.bytes()
    var n = len(b)
    while n > 1 and (b[n - 1] == 92 or b[n - 1] == 47):
        n -= 1
    return p[:n]

fn has_rules(d: str) -> bool:
    return file_exists(project.join(d, rules.FILE)) or file_exists(project.join(d, rules.LOCK))

fn load_from(entry: str, at: Source, ref sm: SourceMap, ref diags: [Diag]) -> Option[Program]:
    var root = dir_of(entry)
    if root == "":
        root = "."
    # RULES.br, and its vocabulary in rules/ (also when other modules import it)
    let rdir = rules_at(entry).dir
    var text = ""
    match read_at(entry, at.rev):
        case Ok(t):
            text = t
        case Err(e):
            diags.push(diag.error("E0701", e))
            return None
    var prog = Program(modules=[], main_module=0, import_targets=[])
    var by_name: {str: int} = {}
    # the same file is one module, whatever path imports it: RULES.br can
    # import the file being checked
    var by_file: {str: int} = {}
    # modules whose file is missing (an empty module stands in)
    var missing: {int: bool} = {}
    # each module's directory, as an import path from `root`; None for those
    # whose imports aren't found from there (RULES.br, rules/)
    var dirs: [Option[[str]]] = []
    let fid = sm.add(display_path(entry), text)
    let (m, d) = parse_module(text, fid, "main")
    diags.extend(d)
    by_name["main"] = 0
    by_file[file_key(entry)] = 0
    prog.modules.push(m)
    dirs.push(Some([]))
    if rdir != "":
        let rp = project.join(rdir, rules.FILE)
        match read_at(rp, at.rev):
            case Ok(rt):
                let rf = sm.add(display_path(rp), rt)
                let (rm, rd) = parse_module(rt, rf, rules.MODULE)
                diags.extend(rd)
                by_name[rules.MODULE] = len(prog.modules)
                prog.modules.push(rm)
                dirs.push(None)
            case Err(_):
                pass
    # Breadth first, a wave at a time: scanning the modules found so far
    # numbers the new imports in the order they're seen, then the new files
    # are parsed in parallel and appended in that order, so the numbering
    # doesn't depend on the parallelism.
    var i = 0
    while i < len(prog.modules):
        let first_new = len(prog.modules)
        var found: [Found] = []
        var found_dirs: [Option[[str]]] = []
        while i < first_new:
            var targets: [int] = []
            for imp in prog.modules[i].imports:
                var path = imp.path
                var name = module_name(path)
                let vocab = rdir != "" and path[0] == rules.VOCAB
                # a module in another directory than the main file's also finds
                # its neighbours: `q`, the import from its own directory
                var q: [str] = []
                var here = ""
                match dirs[i]:
                    case Some(ds):
                        if not vocab and len(ds) > 0:
                            q = ds
                            q.extend(path)
                            q = plain_import(q)
                            here = module_file(root, ds)
                            here = here[:len(here) - 3]
                    case None:
                        pass
                match by_name.get(name):
                    case Some(t):
                        # (missing from the main file's directory: try here)
                        if t not in missing or len(q) == 0:
                            targets.push(t)
                            continue
                    case None:
                        pass
                let base = rdir if vocab else root
                var p = module_file(base, path)
                var got = read_at(p, at.rev)
                if got.is_err() and len(q) > 0:
                    # from the main file's directory first, so that what
                    # compiled before means the same; then from here
                    path = q
                    name = module_name(q)
                    let p2 = module_file(root, q)
                    match read_at(p2, at.rev):
                        case Ok(s2):
                            p = p2
                            got = Ok(s2)
                        case Err(_):
                            pass
                    match by_name.get(name):
                        case Some(t):
                            targets.push(t)
                            continue
                        case None:
                            pass
                let key = file_key(p)
                match by_file.get(key):
                    case Some(t):
                        by_name[name] = t
                        targets.push(t)
                        continue
                    case None:
                        pass
                let idx = first_new + len(found)
                by_name[name] = idx
                by_file[key] = idx
                targets.push(idx)
                let np = plain_import(path)
                found_dirs.push(None if vocab else Some(np[:len(np) - 1]))
                match got:
                    case Ok(src):
                        found.push(
                            Found(name=name, src=Some(src), file=sm.add(display_path(p), src))
                        )
                    case Err(_):
                        missing[idx] = true
                        diags.push(not_found(name, imp.path, imp.span, root, p, here))
                        # keeps the numbering: an empty module
                        found.push(Found(name=name, src=None, file=prog.modules[i].file))
            prog.import_targets.push(targets)
            i += 1
            if i == 1:
                # after the main file's own imports, so they keep their numbers
                for path in at.also:
                    let name = module_name(path)
                    if name in by_name:
                        continue
                    let p = module_file(root, path)
                    let key = file_key(p)
                    if key in by_file:
                        continue
                    match read_at(p, at.rev):
                        case Ok(src):
                            by_name[name] = first_new + len(found)
                            by_file[key] = first_new + len(found)
                            let np = plain_import(path)
                            found_dirs.push(Some(np[:len(np) - 1]))
                            found.push(
                                Found(name=name, src=Some(src), file=sm.add(display_path(p), src))
                            )
                        case Err(e):
                            diags.push(diag.error("E0701", e))
        let parsed = par [parse_found(f) for f in found]
        dirs.extend(found_dirs)
        for pm in parsed:
            diags.extend(pm.1)
            prog.modules.push(pm.0)
    # the prelude (`Option`, `Result`) is part of every program
    if PRELUDE not in by_name:
        let f = sm.add("<prelude>", PRELUDE_SRC)
        let (pm, pd) = parse_module(PRELUDE_SRC, f, PRELUDE)
        diags.extend(pd)
        prog.modules.push(pm)
        prog.import_targets.push([])
    if RT not in by_name:
        let f = sm.add("<runtime>", RT_SRC)
        let (pm, pd) = parse_module(RT_SRC, f, RT)
        diags.extend(pd)
        prog.modules.push(pm)
        prog.import_targets.push([])
    for mi in 0..len(prog.modules):
        let name = prog.modules[mi].name
        match at.extra.get(name):
            case Some(more):
                let f = sm.add(f"<spec-diff {name}>", more)
                let (em, ed) = parse_module(more, f, name)
                diags.extend(ed)
                prog.modules[mi].fns.extend(em.fns)
            case None:
                pass
    prog.main_module = 0
    return Some(prog)

# E0701, with the directory above where the module is, if it is in one.
fn not_found(name: str, path: [str], span: Span, root: str, p: str, here: str) -> Diag:
    var d = diag.error(
        "E0701",
        f"module `{name}` not found"
    ).label(span, "expected a file at `" + display_path(p) + "`")
    let shown = display_path(root) if root != "." else "."
    var where = f"modules are found from `{shown}`, the main file's directory"
    if here != "":
        where += f", then from `{display_path(here)}`, the importing file's"
    var up = path
    for _ in 0..8:
        up.insert(0, "..")
        let q = module_file(root, up)
        if os.is_file(q):
            let fixed = module_name(up)
            return d.note(
                where
            ).with_help(f"`{display_path(q)}` exists: import it with `import {fixed}`")
    return d.note(where).with_help(
        "`import a.b` loads `a/b.br` there, and `import ..a` loads `a.br` from the directory above"
    )

# One key per file, however its path is written.
fn file_key(p: str) -> str:
    var s = os.abs_path(p).unwrap_or(p).replace("\\", "/")
    if s.starts_with("//?/"):
        s = s[4:]
    return s.lower() if project.is_windows() else s

# An import path with `a/..` taken out: `bin.(..).util` is `util`.
fn plain_import(path: [str]) -> [str]:
    var out: [str] = []
    for seg in path:
        if seg == ".." and len(out) > 0 and out[len(out) - 1] != "..":
            out.pop()
        else:
            out.push(seg)
    return out

struct FrontOpts:
    verify: bool
    # E0703 without a `main`
    need_main: bool
    # E0706 for a `main` that can't start a program
    check_main: bool
    # require a written type on every variable
    typed: bool
    # every runtime check must be proven away (E0607)
    proven: bool
    # rule changes nobody approved are errors (E0613), not warnings: release
    # builds, CI and `brine rules`
    strict_rules: bool

# Running in CI: `CI` is set to anything but "", "0" or "false" (GitHub
# Actions, GitLab, CircleCI, Travis and Buildkite all set `CI=true`).
fn in_ci() -> bool:
    match getenv("CI"):
        case Some(v):
            let x = v.strip().lower()
            return x != "" and x != "0" and x != "false"
        case None:
            return false

# Whether unapproved rule changes stop a build with this profile.
fn strict_rules(release: bool) -> bool:
    return release or in_ci()

fn main_ok(info: ProgramInfo, id: int) -> bool:
    if id < 0 or id >= len(info.fns):
        return false
    let sig = info.fns[id]
    if len(sig.params) > 0:
        return false
    match sig.ret:
        case Ty.Unit | Ty.Int(IntTy.I64):
            return true
        case _:
            match try_kind(info, sig.ret):
                case Some(TryKind.Res(_, _, ok, _)):
                    return ok == Ty.Unit or ok == Ty.Int(IntTy.I64)
                case _:
                    return false

# `BRINE_TIMES=1` prints how long each phase takes.
fn phase_time(t0: float, what: str) -> float:
    let now = clock()
    if getenv("BRINE_TIMES").is_some():
        eprint(f"  {what:<10} {now - t0:.3f}s")
    return now

fn frontend(entry: str, opts: FrontOpts) -> Frontend:
    return frontend_at(entry, opts, on_disk())

fn frontend_at(entry: str, opts: FrontOpts, at: Source) -> Frontend:
    var sm = SourceMap.new()
    var diags: [Diag] = []
    var t = clock()
    let loaded = load_from(entry, at, ref sm, ref diags)
    t = phase_time(t, "parse")
    if loaded.is_none() or has_errors(diags):
        return Frontend(sm=sm, diags=diags, prog=loaded, info=None, report=None, rules=None)
    var prog = loaded.unwrap()
    var ck = new_checker()
    ck.typed = opts.typed
    # `embed("x")` reads `x` next to the file that contains the call
    for m in prog.modules:
        ck.src_dirs[m.file] = dir_of(sm.file(m.file).path)
    ck.check_program(ref prog)
    diags.extend(ck.diags)
    t = phase_time(t, "check")
    let info = ck.info
    if (opts.need_main or opts.check_main) and not has_errors(diags):
        let m = prog.modules[prog.main_module]
        var found = -1
        for i, f in enumerate(m.fns):
            if f.name == "main" and f.method_of.is_none():
                found = i
                break
        if found < 0 and opts.need_main:
            diags.push(
                diag.error("E0703", "this program has no `main` function")
                .label(Span(file=m.file, lo=0, hi=0), "add `fn main():` here")
                .with_help("every program starts at `fn main():` in its main file")
            )
        elif found >= 0:
            let f = m.fns[found]
            if len(f.tparams) > 0 or not main_ok(info, f.id):
                diags.push(
                    diag.error(
                        "E0706",
                        "`main` must take no parameters and return nothing, an `int` exit code, or `Result[(), E]` / `Result[int, E]`"
                    )
                    .label(f.name_span, "this `main`")
                    .with_help(
                        "command-line arguments come from `args()`; return `Result[(), str]` to use `?` in `main`"
                    )
                )
    if not has_errors(diags):
        # deadlock freedom: every rank makes the same `world` calls
        diags.extend(uniform.check(prog, info))
        # nothing reached from a `par` body writes files or reads input
        diags.extend(pareffects.check(prog, info))
        t = phase_time(t, "uniform")
    # what the rules cover, which must not be able to stop the program
    var rl: Option[Rules] = None
    var covered: [str] = []
    var stops: [bool] = []
    if not has_errors(diags):
        let main_dir = dir_of(entry)
        let ra = rules_at(entry)
        let r = rules.analyze(
            prog,
            info,
            sm,
            ra.dir,
            ra.is_main,
            main_dir,
            at.rev.is_none(),
            opts.strict_rules
        )
        covered = r.covered
        stops = r.stops
        rl = Some(r)
    var report: Option[Report] = None
    if opts.verify and not has_errors(diags):
        let r = verify.verify_program(ref prog, info, sm, opts.proven, covered, stops)
        diags.extend(r.diags)
        report = Some(r)
        t = phase_time(t, "verify")
    # after verifying, so a rule problem doesn't hide what the prover found
    match rl:
        case Some(r):
            diags.extend(r.diags)
        case None:
            pass
    sort_diags(ref diags)
    return Frontend(sm=sm, diags=diags, prog=Some(prog), info=Some(info), report=report, rules=rl)

# Deterministic order: by file, then position, then code (stable).
fn sort_diags(ref ds: [Diag]):
    var keys: [(int, int, str)] = []
    for d in ds:
        if len(d.labels) > 0:
            let s = d.labels[0].span
            keys.push((s.file, s.lo, d.code))
        else:
            keys.push((4294967295, 0, d.code))
    let order = merge_sort(keys, [i for i in 0..len(ds)])
    ds = [ds[i] for i in order]

fn key_less(a: (int, int, str), b: (int, int, str)) -> bool:
    if a.0 != b.0:
        return a.0 < b.0
    if a.1 != b.1:
        return a.1 < b.1
    return a.2 < b.2

# Stable: equal keys keep their order.
fn merge_sort(keys: [(int, int, str)], idx: [int]) -> [int]:
    if len(idx) <= 1:
        return idx
    let mid = len(idx) / 2
    let l = merge_sort(keys, idx[:mid])
    let r = merge_sort(keys, idx[mid:])
    var out: [int] = []
    var i = 0
    var j = 0
    while i < len(l) and j < len(r):
        if key_less(keys[r[j]], keys[l[i]]):
            out.push(r[j])
            j += 1
        else:
            out.push(l[i])
            i += 1
    out.extend(l[i:])
    out.extend(r[j:])
    return out

# ================================================================ C toolchain

enum Profile:
    Dev
    Release
    Debug

    fn name(self) -> str:
        match self:
            case Profile.Dev:
                return "dev"
            case Profile.Release:
                return "release"
            case Profile.Debug:
                return "debug"

    fn cflags(self) -> [str]:
        match self:
            case Profile.Dev:
                return ["-O2"]
            case Profile.Release:
                return ["-O3"]
            case Profile.Debug:
                return ["-O0", "-g"]

# What a build makes.
enum Platform:
    # an executable for this machine
    Host
    # a WebAssembly module for WASI (Node.js, wasmtime, ...)
    Wasm
    # a folder with a web page that runs the program in a browser
    Web

    fn name(self) -> str:
        match self:
            case Platform.Host:
                return "host"
            case Platform.Wasm:
                return "wasm"
            case Platform.Web:
                return "web"

    fn is_wasm(self) -> bool:
        return self != Platform.Host

fn parse_platform(s: str) -> Option[Platform]:
    if s == "host" or s == "native":
        return Some(Platform.Host)
    if s == "wasm" or s == "wasm32" or s == "wasi":
        return Some(Platform.Wasm)
    if s == "web":
        return Some(Platform.Web)
    return None

# Does `cmd` start and exit successfully?
fn runs_ok(cmd: [str]) -> bool:
    match os.spawn(cmd, {}, true, false):
        case Ok(p):
            return os.wait(p) == 0
        case Err(_):
            return false

fn find_cc() -> Option[str]:
    for var_name in ["BRINE_CC", "CC"]:
        match getenv(var_name):
            case Some(v):
                if v.strip() != "":
                    return Some(v)
            case None:
                pass
    for cand in ["clang", "gcc", "cc"]:
        if runs_ok([cand, "--version"]):
            return Some(cand)
    return None

# The clang of a wasi-sdk (https://github.com/WebAssembly/wasi-sdk): it
# brings the C library for WebAssembly. Found through WASI_SDK_PATH, or in
# /opt/wasi-sdk.
fn find_wasi_cc() -> Option[str]:
    var dirs: [str] = []
    match getenv("WASI_SDK_PATH"):
        case Some(v):
            if v.strip() != "":
                dirs.push(v.strip())
        case None:
            pass
    dirs.push("/opt/wasi-sdk")
    for d in dirs:
        let cc = project.join(project.join(d, "bin"), exe_name("clang"))
        if file_exists(cc):
            return Some(cc)
    return None

fn no_wasi_cc_diag() -> Diag:
    return (
        diag.error("E0702", "no WebAssembly C toolchain found")
        .note("brine builds WebAssembly with the clang and C library of wasi-sdk")
        .with_help(
            "download wasi-sdk from https://github.com/WebAssembly/wasi-sdk/releases and set WASI_SDK_PATH to its folder"
        )
    )

fn cc_version(cc: str) -> Option[str]:
    match os.spawn([cc, "--version"], {}, true, false):
        case Ok(p):
            os.wait(p)
            let (out, _) = os.output(p)
            let ls = out.lines()
            if len(ls) == 0:
                return None
            return Some(ls[0].strip())
        case Err(_):
            return None

fn no_cc_diag() -> Diag:
    var hint = "install clang or gcc with your package manager, or set BRINE_CC"
    if project.is_windows():
        hint = "install one with `winget install LLVM.LLVM` or `scoop install mingw-winlibs`, or set BRINE_CC"
    elif os.name() == "macos":
        hint = "install one with `xcode-select --install`, or set BRINE_CC"
    if getenv("BRINE_BACKEND").unwrap_or("") == "c" and native_host():
        # the C backend was asked for: brine needs no C compiler without it
        return (
            diag.error("E0702", "no C compiler found")
            .note("`BRINE_BACKEND=c` builds through C, with the system C compiler")
            .with_help(
                "unset BRINE_BACKEND to build native code, which needs no C compiler here; or "
                + hint
            )
        )
    return (
        diag.error("E0702", "no C compiler found").note(
            f"brine makes native code itself only on x86-64 and arm64; on {os.name()} {os.arch()} it builds through C"
        ).with_help(hint)
    )

# 64-bit FNV-1a.
fn fnv(data: str) -> u64:
    let mask: u128 = 18446744073709551615
    let prime: u128 = 1099511628211
    var h: u128 = 14695981039346656037
    for b in data.bytes():
        h = h ^ u128(b)
        h = (h * prime) & mask
    return u64(h)

fn fnv_bytes(data: [u8]) -> u64:
    var h: u128 = 14695981039346656037
    for b in data:
        h = ((h ^ u128(b)) * 1099511628211) & 18446744073709551615
    return u64(h)

fn hex16(h: u64) -> str:
    return f"{h:016x}"

fn exe_name(stem: str) -> str:
    if project.is_windows():
        return stem + ".exe"
    return stem

# The file (or, for the web, folder) a build writes.
fn out_file(stem: str, plat: Platform) -> str:
    match plat:
        case Platform.Host:
            return exe_name(stem)
        case Platform.Wasm:
            return stem + ".wasm"
        case Platform.Web:
            return stem + "-web"

fn link_libs() -> [str]:
    if project.is_windows():
        return ["-lws2_32", "-lshell32"]
    return ["-lm", "-lpthread", "-ldl"]

fn run_cc(cmd: [str]) -> Result[(), str]:
    var p = 0
    match os.spawn(cmd, {}, true, false):
        case Ok(h):
            p = h
        case Err(e):
            return Err(f"could not run the C compiler: {e}")
    let code = os.wait(p)
    let (out, err) = os.output(p)
    if code == 0:
        return Ok(())
    return Err(err + out)

# The file name without its extension.
fn file_stem(p: str) -> str:
    let n = project.file_name(p).unwrap_or("")
    let b = n.bytes()
    var i = len(b) - 1
    while i > 0:
        if b[i] == 46:
            return n[:i]
        i -= 1
    return n

# `p` with its extension replaced (or added).
fn with_extension(p: str, ext: str) -> str:
    let n = project.file_name(p).unwrap_or("")
    let base = p[:len(p) - len(n)]
    return base + file_stem(p) + "." + ext

fn io_diag(e: str) -> Diag:
    return diag.error("E0704", f"cannot write build files: {e}")

# Generated code, ready for the system toolchain.
enum Code:
    # C translation units, compiled in parallel and cached one by one;
    # `once` are compiled a single time even when `units` are compiled for
    # several CPU levels (the big data blocks)
    C(units: [str], once: [str])
    # a native object that brine links itself (link.br)
    Native(o: ObjFile)

fn make_dirs(d: str) -> Result[(), Diag]:
    match os.make_dir(d):
        case Ok(_):
            return Ok(())
        case Err(e):
            return Err(diag.error("E0704", f"cannot create `{d}`: {e}"))

# Windows can't overwrite a running executable, but it can rename one, so an
# old build (a program still running, or brine rebuilding itself) is moved to
# `<out>.old` first. True if it was moved.
fn move_aside(out: str) -> bool:
    if os.name() != "windows" or not file_exists(out):
        return false
    let old = out + ".old"
    # (an older one that is still running stays; then so does this one, and
    # writing it fails as before)
    match os.remove_file(old):
        case _:
            pass
    return os.rename(out, old).is_ok()

# A file to write `out` as before renaming it over `out`: in its folder, with
# its extension (a C compiler adds `.exe` to a name without one on Windows).
fn tmp_beside(out: str) -> str:
    let n = project.file_name(out).unwrap_or(out)
    return out[:len(out) - len(n)] + f".{os.pid()}.{n}"

# Renames `tmp` over `out`, and removes `tmp` either way. With `before` (the
# hash `out` had when this build started; "" if it didn't exist), a build of
# the same program by another brine wins: `out` is kept when it has the same
# bytes already, or when it changed since and can't be replaced (Windows: it
# runs). A C linker stamps the time into a program, so two builds differ.
fn place(tmp: str, out: str, before: Option[str]) -> Result[(), Diag]:
    if before.is_some() and file_exists(out) and file_hash(out) == file_hash(tmp):
        match os.remove_file(tmp):
            case _:
                pass
        return Ok(())
    # the `.old` an earlier build moved aside goes once it no longer runs
    # (Windows: it stays while it does)
    if os.name() == "windows" and file_exists(out + ".old"):
        match os.remove_file(out + ".old"):
            case _:
                pass
    # (Windows: another brine building it at the same time may hold it a
    # moment, reading it or moving its own copy in place, so try again)
    var e = ""
    for attempt in 0..5:
        if attempt > 0:
            os.sleep(0.05 * float(attempt))
        if os.rename(tmp, out).is_ok():
            return Ok(())
        # (Windows can't replace a running program, but it can move it away)
        let moved = move_aside(out)
        match os.rename(tmp, out):
            case Ok(_):
                return Ok(())
            case Err(x):
                e = x
        move_back(out, moved)
        match before:
            case Some(h):
                if file_exists(out) and file_hash(out) != h:
                    match os.remove_file(tmp):
                        case _:
                            pass
                    return Ok(())
            case None:
                pass
        if os.name() != "windows":
            break
    match os.remove_file(tmp):
        case _:
            pass
    return Err(
        diag.error("E0704", f"cannot write `{display_path(out)}`").note(e).with_help(
            "is the program still running? Stop it and build again, or build somewhere else with `-o`"
        )
    )

# A link that failed puts the old build back.
fn move_back(out: str, moved: bool):
    if moved and not file_exists(out):
        match os.rename(out + ".old", out):
            case _:
                pass

# (abs_path's Windows paths start with `\\?\`)
fn plain_path(p: str) -> str:
    let s = p.replace("/", "\\").lower()
    return s[4:] if s.starts_with("\\\\?\\") else s

# The input of a link that the linker says it couldn't open or find ("" if
# none): `ld: cannot find <path>: Permission denied`, `cannot open <path>`.
fn unreadable_input(e: str, inputs: [str]) -> str:
    for l in e.lower().replace("\\", "/").lines():
        if not any(
            p in l for p in ["permission denied", "no such file", "not found", "cannot open"]
        ):
            continue
        for p in inputs:
            if p.lower().replace("\\", "/") in l:
                return p
    return ""

# A link that failed on a file of the build cache: not a bug in brine's
# generated code, so not E0705.
fn cache_file_diag(bad: str, e: str, dir: str) -> Diag:
    let ls = e.strip().lines()
    return (
        diag.error("E0704", f"cannot read the build cache file `{display_path(bad)}`")
        .note(ls[0] if len(ls) > 0 else e)
        .note("another brine building at the same time was most likely changing it")
        .with_help(
            f"build again; if it keeps happening, delete the cache folder `{display_path(dir)}` (brine fills it again)"
        )
    )

fn cc_failed(what: str, e: str, out: str) -> Diag:
    let ls = e.strip().lines()
    let first = "\n".join(ls[:min(30, len(ls))])
    let low = e.lower()
    # the linker can't replace an executable that is running (Windows), or
    # the folder isn't writable
    let name = project.file_name(out).unwrap_or("")
    let busy = any(
        p in low for p in ["permission denied", "text file busy", "device or resource busy"]
    )
    if out != "" and ("output file" in low or (busy and name != "" and name in e)):
        return diag.error("E0704", f"cannot write `{display_path(out)}`").note(first).with_help(
            "is the program still running? Stop it and build again, or build somewhere else with `-o`"
        )
    if any(
        p in low for p in [
            "no space left on device",
            "out of memory",
            "cannot allocate memory",
            "virtual memory exhausted"
        ]
    ):
        return (
            diag.error("E0704", what)
            .note(first)
            .with_help("the C compiler ran out of disk space or memory")
        )
    if any(p in low for p in ["undefined reference to", "undefined symbol", "unresolved external"]):
        return diag.error("E0705", what).note(first).note(
            "if the missing name is an `extern fn` of your program, it isn't in the C libraries brine links; otherwise this is a bug in brine — please report it"
        )
    return (
        diag.error("E0705", what)
        .note("this is a bug in the brine compiler, not in your program — please report it")
        .note(first)
    )

fn write_or_diag(path: str, text: str) -> Result[(), Diag]:
    match write_file(path, text):
        case Ok(_):
            return Ok(())
        case Err(e):
            return Err(io_diag(e))

# The runtime as an object file, cached by runtime source + C compiler + flags.
# Returns its directory (it has brine_rt.h) and the object's path.
fn runtime_object(cc: str, flags: [str], key: str, dir: str) -> Result[(str, str), Diag]:
    let rt_dir = project.join(dir, "rt-" + hex16(fnv(RT_H + RT_C + RT_M + key)))
    let rt_obj = project.join(rt_dir, "brine_rt.o")
    if file_exists(rt_obj):
        return Ok((rt_dir, rt_obj))
    make_dirs(rt_dir)?
    # the directory name is a hash of the contents, so existing files are already right
    # (and rewriting them could collide with a concurrent build reading them)
    for name, text in [("brine_rt.h", RT_H), ("brine_rt.c", RT_C), ("brine_math.c", RT_M)]:
        let f = project.join(rt_dir, name)
        var same = false
        var there = false
        match read_file(f):
            case Ok(t):
                there = true
                same = len(t) == len(text)
            case Err(_):
                pass
        if not same:
            # written beside it and moved in: a build compiling with it
            # never reads it half-written
            let tmp = project.join(rt_dir, f"{name}.{os.pid()}.tmp")
            write_or_diag(tmp, text)?
            if there:
                settle(tmp, f, true)
            else:
                settle_all(dir, [(tmp, f)])
    let tmp = project.join(rt_dir, f"brine_rt.{os.pid()}.o")
    var cmd = [cc]
    cmd.extend(flags)
    cmd.extend(["-c", project.join(rt_dir, "brine_rt.c"), "-o", tmp])
    match run_cc(cmd):
        case Ok(_):
            pass
        case Err(e):
            return Err(
                diag.error("E0705", "the C compiler failed on the brine runtime").note(e.strip())
            )
    settle_all(dir, [(tmp, rt_obj)])
    return Ok((rt_dir, rt_obj))

# Moves a finished cache file `tmp` (an object, a runtime source) to `path`,
# unless `path` exists already: it is named by a hash of its contents, so it
# has the same bytes. Not renamed over it, because on Windows that holds it
# for deletion a moment, and a linker opening it then fails with "Permission
# denied" (v091#3: concurrent builds of one program). `replace`: it exists
# but is wrong (cut short), so it is replaced.
fn settle(tmp: str, path: str, replace: bool):
    if not replace and file_exists(path):
        match os.remove_file(tmp):
            case _:
                pass
        return
    match os.rename(tmp, path):
        case Ok(_):
            pass
        case Err(_):
            match os.remove_file(tmp):
                case _:
                    pass

# `settle` for several files of the cache `dir`. Two builds that both find
# one missing would both move theirs in, the second over the first, so that
# is done under the cache's lock (taken only when one is missing: on a
# first build).
fn settle_all(dir: str, moves: [(str, str)]):
    var lock: Option[str] = None
    if any(not file_exists(path) for _, path in moves):
        lock = cache_lock(dir)
    for tmp, path in moves:
        settle(tmp, path, false)
    cache_unlock(lock)

# The x86-64 levels an optimized program is compiled for, as the extra C
# compiler flags of each: plain x86-64, then x86-64-v3 (AVX2) and x86-64-v4
# (AVX-512). runtime/brine_cpu.c picks one when the program starts, so the
# executable runs anywhere and still uses the vector units of newer CPUs.
# None (one plain build) for other profiles and targets.
fn cpu_levels(profile: Profile, plat: Platform, units: int) -> [[str]]:
    if profile != Profile.Release or plat != Platform.Host or os.arch() != "x86_64" or units != 1:
        return []
    return [
        ["-DBRINE_MAIN=brine_main_base"],
        ["-DBRINE_MAIN=brine_main_v3", "-march=x86-64-v3"],
        ["-DBRINE_MAIN=brine_main_v4", "-march=x86-64-v4"]
    ]

# Compile generated code to an executable. `dir` is a cache directory for
# intermediate files. Returns Ok(true) if the C compiler actually ran.
fn compile(code: Code, dest: str, dir: str, profile: Profile, plat: Platform) -> Result[bool, Diag]:
    match code:
        case Code.Native(o):
            return link_native(o, dest)
        case _:
            pass
    match compile_levels(code, dest, dir, profile, plat, true):
        case Ok(ran):
            return Ok(ran)
        case Err(d):
            # a C compiler too old for x86-64-v3 and v4 (gcc < 11, clang < 12)
            # still makes a plain build
            if len(cpu_levels(profile, plat, 1)) == 0:
                return Err(d)
            match compile_levels(code, dest, dir, profile, plat, false):
                case Ok(ran):
                    return Ok(ran)
                case Err(_):
                    return Err(d)

fn compile_levels(
    code: Code,
    dest: str,
    dir: str,
    profile: Profile,
    plat: Platform,
    levels: bool
) -> Result[bool, Diag]:
    var cc = ""
    # no fused multiply-adds: a*b+c rounds twice everywhere, so floats come out
    # the same on every CPU and target (clang fuses by default)
    var flags = ["-std=c11", "-fno-strict-aliasing", "-ffp-contract=off", "-w"]
    var libs = link_libs()
    if plat.is_wasm():
        match find_wasi_cc():
            case Some(x):
                cc = x
            case None:
                return Err(no_wasi_cc_diag())
        flags.insert(0, "--target=wasm32-wasip1")
        # 128-bit vectors: in every current browser, Node.js and wasmtime.
        # Not for straight-line code: packing pairs of floats (a complex
        # number's two halves) made a Mandelbrot loop 1.7x slower in V8.
        flags.insert(1, "-msimd128")
        flags.insert(2, "-fno-slp-vectorize")
        # brine code recurses like native code does: give it a main thread's
        # stack (the shadow stack in linear memory; the Node runner gives
        # WebAssembly's own a big one)
        libs = ["-Wl,-z,stack-size=8388608"]
        # wasi-sdk's C library carries DWARF: without this, 85% of a small module
        if profile != Profile.Debug:
            libs.push("-Wl,--strip-debug")
    else:
        match find_cc():
            case Some(x):
                cc = x
            case None:
                return Err(no_cc_diag())
    make_dirs(dir)?
    flags.extend(profile.cflags())
    # the web build is a folder; the module in it is the linker's output
    let out_exe = project.join(dest, "program.wasm") if plat == Platform.Web else dest
    let key = cc + "|" + " ".join(flags) + "|" + VERSION
    let (rt_dir, rt_obj) = runtime_object(cc, flags, key, dir)?

    # objects are named by a hash of what they're made from, the runtime
    # header included: its inline functions end up in them
    let ukey = key + "|" + hex16(fnv(RT_H))
    # C files with the extra flags each is compiled with
    var units: [(str, [str])] = []
    var hashes: [str] = []
    match code:
        case Code.C(us, once):
            let lv = cpu_levels(profile, plat, len(us)) if levels else []
            # gcc on Windows can't align its stack to 32 bytes, so it spills
            # AVX registers to unaligned slots with aligned moves (gcc bug
            # 54412); the assembler can make every such move unaligned
            let fix_align = os.name() == "windows" and "clang" not in cc
            # with AVX-512's extra registers, gcc keeps 128-bit integers in
            # vector registers around BMI2's `mulx`: u128 loops run 2x slower
            # (other code loses at most a few percent without BMI2)
            let no_bmi2 = "clang" not in cc
            for u in us:
                if len(lv) == 0:
                    units.push((u, []))
                for i, extra in enumerate(lv):
                    var e = extra
                    if i > 0 and fix_align:
                        e.push("-Wa,-muse-unaligned-vector-move")
                    if i == 2 and no_bmi2:
                        e.push("-mno-bmi2")
                    units.push((u, e))
            for u in once:
                units.push((u, []))
            if len(lv) > 0:
                units.push((CPU_C, []))
            for u, extra in units:
                hashes.push(hex16(fnv(u + ukey + " ".join(extra))))
        case Code.Native(_):
            panic("compile links native objects itself")
    let prog_hash = fnv(" ".join(hashes) + rt_obj)
    let stamp = stamp_path(out_exe, dir)
    if file_exists(out_exe):
        match read_file(stamp):
            case Ok(st):
                if st.strip() == f"{hex16(prog_hash)} {file_hash(out_exe)}":
                    if plat == Platform.Web:
                        web_files(dest)?
                    return Ok(false)
            case Err(_):
                pass
    # one directory per output, so pruning never touches another build's objects
    let obj_dir = project.join(dir, "obj-" + hex16(fnv(out_exe)))
    make_dirs(obj_dir)?
    var objs: [str] = []
    var jobs: [(int, str, str, str)] = []
    for i, (u, extra) in enumerate(units):
        let obj = project.join(obj_dir, hashes[i] + ".o")
        # identical units (empty ones) are one object
        if obj in objs:
            continue
        objs.push(obj)
        if file_exists(obj) or reuse_object(dir, obj_dir, hashes[i]):
            continue
        let c_path = project.join(obj_dir, f"{hashes[i]}.{os.pid()}.c")
        write_or_diag(c_path, u)?
        let tmp = project.join(obj_dir, f"{hashes[i]}.{os.pid()}.o")
        var cmd = [cc]
        cmd.extend(flags)
        cmd.extend(extra)
        cmd.extend(["-I", rt_dir, "-c", c_path, "-o", tmp])
        match os.spawn(cmd, {}, true, false):
            case Ok(h):
                jobs.push((h, c_path, tmp, obj))
            case Err(e):
                return Err(diag.error("E0705", f"could not run the C compiler: {e}"))
    var t = clock()
    var failure = ""
    var made: [(str, str)] = []
    for h, c_path, tmp, obj in jobs:
        let rc = os.wait(h)
        let (out, err) = os.output(h)
        if rc != 0:
            if failure == "":
                failure = err + out
        else:
            made.push((tmp, obj))
            match os.remove_file(c_path):
                case _:
                    pass
    settle_all(dir, made)
    prune(obj_dir, objs)
    if len(units) > 0:
        t = phase_time(t, f"cc ({len(jobs)}/{len(units)})")
    if failure != "":
        return Err(cc_failed("the C compiler rejected the generated code", failure, ""))
    match project.parent(out_exe):
        case Some(d):
            if d != "":
                make_dirs(d)?
        case None:
            pass
    # linked next to it and renamed over it, as a native link is: brines
    # building the same program at once each start the one they made
    # (v091#3: they wrote one file together and ran it half-written)
    let tmp = tmp_beside(out_exe)
    let before = file_hash(out_exe) if file_exists(out_exe) else ""
    var link = [cc]
    if plat.is_wasm():
        link.push(flags[0])
    link.extend(objs)
    link.extend([rt_obj, "-o", tmp])
    link.extend(libs)
    var inputs = objs
    inputs.push(rt_obj)
    var tries = 0
    var failed = ""
    while tries < 5:
        tries += 1
        match run_cc(link):
            case Ok(_):
                failed = ""
            case Err(e):
                failed = e
        # the linker couldn't open one of the cached objects: another brine
        # may be moving it in place or pruning it (Windows holds a file a
        # moment for that), so try again shortly
        if failed == "" or tries == 5 or unreadable_input(failed, inputs) == "":
            break
        os.sleep(0.05 * float(tries))
    if failed != "":
        match os.remove_file(tmp):
            case _:
                pass
        let bad = unreadable_input(failed, inputs)
        if bad != "":
            return Err(cache_file_diag(bad, failed, dir))
        return Err(cc_failed("linking the program failed", failed, out_exe))
    place(tmp, out_exe, Some(before))?
    phase_time(t, "link")
    if plat == Platform.Web:
        web_files(dest)?
    match write_file(stamp, f"{hex16(prog_hash)} {file_hash(out_exe)}"):
        case _:
            pass
    return Ok(true)

# Where the hash of what an executable was built from is kept, to skip an
# unchanged link: in the cache directory, not next to the executable, which
# `-o` can put anywhere (and a web folder is what gets deployed). It holds the
# hash of the executable too, since another brine may have replaced it since.
fn stamp_path(out_exe: str, dir: str) -> str:
    let abs = os.abs_path(out_exe).unwrap_or(out_exe)
    return project.join(dir, f"out-{hex16(fnv(abs))}.brine-hash")

fn file_hash(p: str) -> str:
    match os.read_bytes(p):
        case Ok(b):
            return hex16(fnv_bytes(b))
        case Err(_):
            return "none"

# Links a native object into an executable with brine's own linker: no C
# compiler involved. Ok(true) if the executable changed.
fn link_native(o: ObjFile, out_exe: str) -> Result[bool, Diag]:
    let t = clock()
    var r: Result[[u8], str] = Err("")
    if os.name() == "windows":
        r = link_pe(o, "brine_x_start", PE_DLLS)
    elif os.name() == "macos":
        r = link_macho(o, "main", project.file_name(out_exe).unwrap_or(""))
    else:
        r = link_elf(o, "main", ELF_LIBS)
    var b: [u8] = []
    match r:
        case Ok(x):
            b = x
        case Err(e):
            return Err(cc_failed("linking the program failed", e, ""))
    # an executable that already has these bytes is left alone (and keeps its
    # time), whoever wrote it
    if file_exists(out_exe) and file_hash(out_exe) == hex16(fnv_bytes(b)):
        return Ok(false)
    match project.parent(out_exe):
        case Some(d):
            if d != "":
                make_dirs(d)?
        case None:
            pass
    # written next to it and renamed over it: Linux can't write over a
    # program that is running, but it can replace it
    let tmp = f"{out_exe}.{os.pid()}.tmp"
    match os.write_bytes(tmp, b):
        case Ok(_):
            pass
        case Err(e):
            return Err(io_diag(e))
    if os.name() != "windows" and not runs_ok(["chmod", "+x", tmp]):
        return Err(diag.error("E0704", f"cannot make `{display_path(out_exe)}` executable"))
    place(tmp, out_exe, None)?
    phase_time(t, "link")
    return Ok(true)

# The loader is ours and always current; the page is a starting point that
# a demo replaces, so it's only written when missing.
fn web_files(dest: str) -> Result[(), Diag]:
    write_or_diag(project.join(dest, "brine.js"), WEB_JS)?
    let page = project.join(dest, "index.html")
    if not file_exists(page):
        write_or_diag(page, WEB_HTML)?
    return Ok(())

# An object is named by a hash of its C, flags, compiler and version, so one
# that another output already compiled is the same file: copy it instead of
# compiling it again (a compiler building itself compiles the same C twice).
fn reuse_object(dir: str, obj_dir: str, hash: str) -> bool:
    let obj = project.join(obj_dir, hash + ".o")
    for d in os.list_dir(dir).unwrap_or([]):
        let src = project.join(project.join(dir, d), hash + ".o")
        if not d.starts_with("obj-") or src == obj or not file_exists(src):
            continue
        # another build may prune it meanwhile: then look on, or compile
        match os.read_bytes(src):
            case Ok(b):
                let tmp = project.join(obj_dir, f"{hash}.{os.pid()}.o")
                if os.write_bytes(tmp, b).is_ok():
                    settle_all(dir, [(tmp, obj)])
                    if file_exists(obj):
                        return true
            case Err(_):
                pass
    return false

# Every edit leaves an object behind: past a limit, keep only this build's.
fn prune(obj_dir: str, keep: [str]):
    let fs = os.list_dir(obj_dir).unwrap_or([])
    if len(fs) < 4 * len(keep) + 64:
        return
    for f in fs:
        let p = project.join(obj_dir, f)
        # finished objects only (`<hash>.o`), not another build's work in progress
        if len(f) == 18 and f.ends_with(".o") and p not in keep:
            match os.remove_file(p):
                case _:
                    pass

# ---------------------------------------------------------------- the cache

# A cache directory (brine-cache in the temp directory for files outside a
# project, a project's target/cache) keeps what every build made, so it is
# pruned (v09#25). Each build adds lines to its `uses.log`: `<entry> - <t>
# <pid>` when it starts using an entry (a pin) and `<entry> <bytes> <t> <pid>`
# when it is done with it, after the program it built has started (v091#3: a
# prune between the build and the start deleted the program). An entry stays
# while any build's pin is unreleased: several can use one at once. `<t>` is
# `clock()`, which counts from the machine's start in every process, so the
# pin of a brine that died expires. When the entries listed add up to more than
# BRINE_CACHE_SIZE, the least recently used that no one pins lose their files
# (brine can't remove folders; empty ones cost nothing). What the log doesn't
# list, such as what an older brine made, stays. The log is only read or
# written under `cache_lock`.
const CACHE_LOG = "uses.log"

const CACHE_DEFAULT = 2 * 1024 * 1024 * 1024

# lines added between rewrites of the log, which keep one line per entry
const CACHE_SLACK = 256

# seconds after which a pin no longer counts (its brine died)
const PIN_MAX = 6.0 * 3600.0

# BRINE_CACHE_SIZE in bytes: `500M`, `2G`, `1T` or a number of bytes; 0 (or
# `off`) for no limit. Unset or unreadable: 2G.
fn cache_cap() -> int:
    match getenv("BRINE_CACHE_SIZE"):
        case Some(v):
            return parse_size(v).unwrap_or(CACHE_DEFAULT)
        case None:
            return CACHE_DEFAULT

fn parse_size(v: str) -> Option[int]:
    var s = v.strip().upper()
    if s == "OFF":
        return Some(0)
    if s.ends_with("B"):
        s = s[:len(s) - 1]
    var mult = 1
    for suffix, m in [("K", 1 << 10), ("M", 1 << 20), ("G", 1 << 30), ("T", 1 << 40)]:
        if s.ends_with(suffix):
            mult = m
            s = s[:len(s) - 1]
    match s.to_int():
        case Some(n):
            if n >= 0 and n <= (1 << 62) / mult:
                return Some(n * mult)
            return None
        case None:
            return None

# The entries of `dir` a build of `exe` uses: its output folder when that is
# in the cache (`<hash>/dev`), and its C objects (`obj-<hash>`).
fn cache_entries(dir: str, exe: str) -> [str]:
    var es: [str] = []
    match project.parent(exe):
        case Some(p):
            let pre = dir + "/"
            let q = p.replace("\\", "/")
            if q.starts_with(pre.replace("\\", "/")):
                es.push(q[len(pre):])
        case None:
            pass
    # (a web build's objects are named after its .wasm)
    es.push("obj-" + hex16(fnv(exe)))
    es.push("obj-" + hex16(fnv(project.join(exe, "program.wasm"))))
    return es

fn tree_size(p: str) -> int:
    if os.is_file(p):
        return len(os.read_bytes(p).unwrap_or([]))
    var n = 0
    for f in os.list_dir(p).unwrap_or([]):
        n += tree_size(project.join(p, f))
    return n

fn tree_clear(p: str):
    if os.is_file(p):
        match os.remove_file(p):
            case _:
                pass
        return
    for f in os.list_dir(p).unwrap_or([]):
        tree_clear(project.join(p, f))

# The lock on a cache's log. Appending isn't atomic everywhere (Windows' C
# library seeks to the end, then writes), and a prune reads, decides, deletes
# and rewrites, so every use of the log takes it. It is one token file in
# `uses.lock`, renamed from `free` to `held-<pid>-<n>-<t>`: a rename is
# atomic, so one process gets it. A holder that died is taken over after
# LOCK_STALE seconds; two tokens (two first builds made one each) are noticed
# by their holders, who drop theirs. None if it couldn't be had in 10 s: the
# caller goes on without it (appending) or does nothing (pruning).
const LOCK_DIR = "uses.lock"

const LOCK_STALE = 60.0

fn cache_lock(dir: str) -> Option[str]:
    let ld = project.join(dir, LOCK_DIR)
    if os.make_dir(ld).is_err():
        return None
    let free = project.join(ld, "free")
    let t0 = clock()
    var n = 0
    while clock() - t0 < 10.0:
        n += 1
        let name = f"held-{os.pid()}-{n}-{int(clock())}"
        let mine = project.join(ld, name)
        var got = os.rename(free, mine).is_ok()
        var held = false
        for f in os.list_dir(ld).unwrap_or([]):
            if not f.starts_with("held-") or f == name:
                continue
            let parts = f.split("-")
            let age = clock() - float(parts[len(parts) - 1].to_int().unwrap_or(0))
            if not got and (age > LOCK_STALE or age < -1.0):
                # its holder died (or the machine restarted since)
                got = os.rename(project.join(ld, f), mine).is_ok()
            else:
                held = true
        if got and not held:
            return Some(mine)
        if got:
            # someone else holds a second token: drop this one
            match os.remove_file(mine):
                case _:
                    pass
        elif not held and not file_exists(free):
            match write_file(free, ""):
                case _:
                    pass
        os.sleep(0.001 * float(min(n, 20)))
    return None

fn cache_unlock(lock: Option[str]):
    match lock:
        case Some(mine):
            match project.parent(mine):
                case Some(ld):
                    match os.rename(mine, project.join(ld, "free")):
                        case _:
                            pass
                case None:
                    pass
        case None:
            pass

fn log_lines(dir: str, lines: [str]):
    if len(lines) == 0:
        return
    match make_dirs(dir):
        case _:
            pass
    let lock = cache_lock(dir)
    match os.append_bytes(project.join(dir, CACHE_LOG), ("\n".join(lines) + "\n").bytes()):
        case _:
            pass
    cache_unlock(lock)

fn now_mark() -> str:
    return f"{int(clock())}"

# Before a build: pin its entries, so a prune doesn't take them. All of
# them, those it hasn't made yet too: a C build's objects, a first build's
# folder (a prune by another build would clear them while this one writes
# them).
fn cache_start(dir: str, exe: str):
    var lines: [str] = []
    for e in cache_entries(dir, exe):
        lines.push(f"{e} - {now_mark()} {os.pid()}")
    log_lines(dir, lines)

# Once a build is done with them (its program has started, or `build` wrote
# it): record the sizes of its entries, which unpins them, then prune if needed.
fn cache_done(dir: str, exe: str):
    var lines: [str] = []
    let mine = cache_entries(dir, exe)
    for e in mine:
        let p = project.join(dir, e)
        # (one it never made is released too, with no bytes)
        let n = tree_size(p) if os.is_dir(p) else 0
        lines.push(f"{e} {n} {now_mark()} {os.pid()}")
    log_lines(dir, lines)
    prune_cache(dir, mine, cache_cap())

# The bytes the entries `dir`'s log lists hold, by their latest sizes (what
# pruning counts; what an older brine left isn't listed).
fn cache_used(dir: str) -> int:
    var size: {str: int} = {}
    for l in read_file(project.join(dir, CACHE_LOG)).unwrap_or("").lines():
        let parts = l.split(" ")
        if len(parts) >= 2 and parts[0] != "#":
            match parts[1].to_int():
                case Some(n):
                    size[parts[0]] = n
                case None:
                    pass
    var total = 0
    for _, n in size.items():
        total += n
    return total

# `1.5 GiB`, `300 MiB`, `12 KiB`, `80 bytes`
fn human_size(n: int) -> str:
    for unit, name in [(1 << 40, "TiB"), (1 << 30, "GiB"), (1 << 20, "MiB"), (1 << 10, "KiB")]:
        if n >= unit:
            let tenths = n / (unit / 10)
            return (
                f"{tenths / 10} {name}"
                if tenths % 10 == 0
                else f"{tenths / 10}.{tenths % 10} {name}"
            )
    return f"{n} bytes"

# The log is a header line `# <n>` (the entries when it was last rewritten)
# then `<entry> <bytes or -> <t>` lines, oldest first (an older brine wrote
# no `<t>`).
fn prune_cache(dir: str, mine: [str], cap: int):
    let log = project.join(dir, CACHE_LOG)
    if not file_exists(log):
        return
    let lock = cache_lock(dir)
    if lock.is_none():
        return
    prune_locked(dir, log, mine, cap)
    cache_unlock(lock)

fn prune_locked(dir: str, log: str, mine: [str], cap: int):
    var text = ""
    match read_file(log):
        case Ok(t):
            text = t
        case Err(_):
            return
    let ls = text.lines()
    var base = 0
    if len(ls) > 0 and ls[0].starts_with("# "):
        base = ls[0][2:].to_int().unwrap_or(0)
    let now = clock()
    # newest first: each entry's latest size, and the pins on it that are
    # still held: no later line of the same brine released them, and recent
    var order: [str] = []
    var size: {str: int} = {}
    var since: {str: str} = {}
    var pins: {str: [str]} = {}
    # (entry, owner) pairs that a later line released
    var released: {str: bool} = {}
    var i = len(ls) - 1
    while i >= 0:
        let line = ls[i]
        let parts = line.split(" ")
        i -= 1
        if len(parts) < 2 or len(parts) > 4 or parts[0] == "#" or ".." in parts[0]:
            continue
        let name = parts[0]
        let first = name not in pins
        if first:
            order.push(name)
            pins[name] = []
        let owner = parts[3] if len(parts) == 4 else ""
        if parts[1] != "-":
            if name not in size:
                match parts[1].to_int():
                    case Some(n):
                        size[name] = n
                        if len(parts) >= 3:
                            since[name] = parts[2]
                    case None:
                        pass
            released[f"{name} {owner}"] = true
        elif len(parts) == 2:
            # an older brine's mark: it counts while it is the latest, and recent
            if first and i >= len(ls) - 1 - 2 * CACHE_SLACK:
                pins[name].push(line)
        elif f"{name} {owner}" not in released:
            let age = now - float(parts[2].to_int().unwrap_or(0))
            if -1.0 <= age <= PIN_MAX:
                pins[name].push(line)
            released[f"{name} {owner}"] = true
    var total = 0
    for name in order:
        total += size.get(name).unwrap_or(0)
    let over = cap > 0 and total > cap
    if not over and len(ls) <= base + CACHE_SLACK:
        return
    # oldest first, until what is left fits
    var gone: {str: bool} = {}
    var j = len(order) - 1
    while over and j >= 0 and total > cap:
        let name = order[j]
        j -= 1
        if len(pins[name]) > 0 or name in mine:
            continue
        tree_clear(project.join(dir, name))
        total -= size.get(name).unwrap_or(0)
        gone[name] = true
    # rewrite the log with one line per entry left, oldest first
    var out = [""]
    var k = len(order) - 1
    while k >= 0:
        let name = order[k]
        k -= 1
        # (an entry a build pins but hasn't made yet stays, with its pins)
        if name in gone or (len(pins[name]) == 0 and not os.is_dir(project.join(dir, name))):
            continue
        let t = " " + since[name] if name in since else ""
        match size.get(name):
            case Some(n):
                out.push(f"{name} {n}{t}")
            case None:
                pass
        # (the builds that still pin it keep their pins, oldest first)
        var q = len(pins[name]) - 1
        while q >= 0:
            out.push(pins[name][q])
            q -= 1
        if len(pins[name]) == 0 and name not in size:
            out.push(f"{name} -{t}")
    out[0] = f"# {len(out) - 1}"
    let tmp = f"{log}.{os.pid()}.tmp"
    if write_file(tmp, "\n".join(out) + "\n").is_ok():
        match os.rename(tmp, log):
            case _:
                pass

# How many C translation units for a build: several for quick parallel dev
# builds, one when the optimizer should see the whole program.
fn unit_count(profile: Profile) -> int:
    if profile == Profile.Release:
        return 1
    return min(max(os.cpu_count(), 1), 16)

# `native`: for x64.br or a64.br (else for C).
fn lowered(
    fe: Frontend,
    tests: bool,
    profile: Profile,
    plat: Platform,
    native: bool
) -> lower.Lowered:
    return lower.lower(
        fe.prog.unwrap(),
        fe.info.unwrap(),
        fe.sm,
        lower.Options(
            tests=tests,
            debug=profile == Profile.Debug,
            gpu=not plat.is_wasm(),
            fast=profile == Profile.Release,
            vec=profile == Profile.Release and not plat.is_wasm() and not native,
            nvec=profile == Profile.Release and native,
            x86=os.arch() == "x86_64",
            win=os.name() == "windows",
            native=native
        )
    )

# Native code where x64.br or a64.br knows the platform; C elsewhere.
# `BRINE_BACKEND=c` or `=native` overrides.
fn use_native(profile: Profile) -> bool:
    match getenv("BRINE_BACKEND"):
        case Some(b):
            if b == "c":
                return false
            if b == "native":
                return native_host()
        case None:
            pass
    return default_native(profile)

fn default_native(profile: Profile) -> bool:
    return native_host()

# Whether builds here can need the system C compiler (with the default
# backends; wasm needs wasi-sdk either way).
fn needs_cc() -> bool:
    return not native_host()

fn native_host() -> bool:
    if os.arch() == "aarch64":
        return os.name() == "linux" or os.name() == "macos"
    return os.arch() == "x86_64" and os.name() in ["windows", "linux", "macos"]

# The folder a profile's executables go in. A build with `BRINE_BACKEND` set
# gets its own, even when it picks the default backend, so it can't replace a
# default build's executable while that one runs.
fn out_name(profile: Profile, plat: Platform) -> str:
    if plat.is_wasm():
        return profile.name() + "-" + plat.name()
    if getenv("BRINE_BACKEND").is_none():
        return profile.name()
    return profile.name() + ("-native" if use_native(profile) else "-c")

# The program as a native object; a debug build's carries DWARF for `src`.
fn native_obj(m: ir.Module, profile: Profile, win: bool, arm: bool, src: str) -> ObjFile:
    let dbg = profile == Profile.Debug
    let prod = "brine " + VERSION
    if arm:
        return a64.emit_obj(m, dbg, profile == Profile.Release, src, os.cwd(), prod)
    if dbg:
        return x64.emit_obj_debug(m, win, src, os.cwd(), prod)
    return x64.emit_obj(m, win, profile == Profile.Release)

fn gen_code(fe: Frontend, profile: Profile, tests: bool, plat: Platform) -> Code:
    var t = clock()
    let native = use_native(profile) and not plat.is_wasm()
    let l = lowered(fe, tests, profile, plat, native)
    t = phase_time(t, "lower")
    verify_ir(l.m, native, profile == Profile.Release)
    if native:
        let win = os.name() == "windows"
        let arm = os.arch() == "aarch64"
        let o = native_obj(l.m, profile, win, arm, fe.sm.file(0).path)
        phase_time(t, "aarch64" if arm else "x86-64")
        return Code.Native(o)
    let n = unit_count(profile)
    if n > 1:
        let units = ir_c.emit_units(l, n)
        phase_time(t, "emit C")
        return Code.C(units, [])
    # one unit, maybe compiled once per CPU level: big data goes in its own
    let (unit, data) = ir_c.emit_c_shared(l, 4096 if len(cpu_levels(profile, plat, 1)) > 0 else -1)
    phase_time(t, "emit C")
    return Code.C([unit], [data] if data != "" else [])

# `BRINE_VERIFY_IR=1` (for the compiler's tests): check the IR the lowering
# made and, for native code the SSA optimizer runs on (release, or
# `BRINE_SSA=1`), what it makes of it (irverify.br). (Without SSA,
# opt.promote can store a vreg not set yet back to the slot it stands for,
# before a call fills that slot: harmless, but not definitely assigned.)
fn verify_ir(m: ir.Module, native: bool, release: bool):
    match getenv("BRINE_VERIFY_IR"):
        case Some(v):
            if v == "" or v == "0":
                return
        case None:
            return
    var errs = irverify.verify(m)
    var stage = "the lowering"
    if len(errs) == 0 and native and x64.use_ssa(release):
        errs = irverify.verify(x64.optimized(m, release))
        stage = "the optimizer"
    if len(errs) == 0:
        return
    for e in errs:
        eprint(f"  {e}")
    panic(f"BRINE_VERIFY_IR: the IR from {stage} is wrong ({len(errs)} problems above)")

# The program's IR as text (`brine emit-ir`); with `opt`, after the IR
# optimizations the native backend runs.
fn gen_ir(fe: Frontend, profile: Profile, tests: bool, plat: Platform, opt: bool) -> str:
    let l = lowered(fe, tests, profile, plat, use_native(profile) and not plat.is_wasm())
    if not opt:
        return ir.dump(l.m)
    return ir.dump(x64.optimized(l.m, profile == Profile.Release))

# The program as one C file (`brine emit-c`).
fn gen_c(fe: Frontend, profile: Profile, tests: bool, plat: Platform) -> str:
    return ir_c.emit_c(lowered(fe, tests, profile, plat, false))

# The command that runs a WebAssembly build: BRINE_WASM_RUNNER (say
# `wasmtime run --dir=.`) or Node.js with the runner script, which is written
# to `dir`.
fn wasm_command(wasm: str, dir: str) -> Result[[str], str]:
    match getenv("BRINE_WASM_RUNNER"):
        case Some(r):
            if r.strip() != "":
                var cmd = r.split()
                cmd.push(wasm)
                return Ok(cmd)
        case None:
            pass
    if not runs_ok(["node", "--version"]):
        return Err(
            "running WebAssembly needs Node.js (https://nodejs.org) or a WASI runtime in BRINE_WASM_RUNNER (say `wasmtime run --dir=.`)"
        )
    match os.make_dir(dir):
        case _:
            pass
    let js = project.join(dir, "brine-wasi-" + hex16(fnv(WASI_NODE)) + ".mjs")
    if not file_exists(js):
        write_file(js, WASI_NODE)?
    return Ok(["node", "--no-warnings", js, wasm])
