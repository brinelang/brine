# The checker: name resolution, type checking, mutability and race-freedom
# rules. It annotates the syntax tree in place (types, resolutions, locals).
from diag import Span, Diag, best_match
import diag
from types import Ty, IntTy, FloatTy, Res, CallRes, Builtin, StrM, Reducer, WorldOp, OsOp, LocalKind, LocalInfo
from types import int_ty, float_ty, builtins, world_ops, os_ops
from ast import TypeExpr, BinOp, CmpOp, UnOp, FSeg, Arg, CompKind, Comp, Expr, ExprKind, mk
from ast import LetPat, Pattern, PatKind, Case, Stmt, StmtKind, Block, stmt, pattern
from ast import children, stmt_exprs, stmt_blocks, local_of, lvalue_root, parse_fmt_spec
from ast import Param, FnDecl, FieldDecl, StructDecl, EnumDecl, Module, Program
from info import StructInfo, VariantInfo, EnumInfo, ParamSig, FnSig, ConstVal, ConstInfo, ProgramInfo
from info import TryKind, try_kind, new_info, mangle_module, PRELUDE
import num

# Upper bound on instances. Stops runaway recursion like `f[T]` calling `f[[T]]`.
const MAX_INSTANCES = 5000

enum Item:
    Fn(id: int)
    Struct(id: int)
    Enum(id: int)
    Const(id: int)
    Module(id: int)
    # generic templates
    GenType(id: int)
    GenFn(id: int)
    # variant of a prelude enum, named on its own: `Some`, `None`
    GenVariant(tid: int, vi: int)

struct ParCx:
    level: int
    is_for: bool
    loop_var: Option[int]
    captures: [int]
    writes: [int]

struct GenType:
    name: str
    module: int
    tparams: [str]
    sdecl: Option[StructDecl]
    edecl: Option[EnumDecl]
    # method name -> index in `gfns`
    methods: {str: int}
    # variants are named without the enum (`Some(x)`, `None`)
    bare: bool
    insts: {[Ty]: int}

struct GenFn:
    module: int
    tparams: [str]
    decl: FnDecl
    # generic type this is a method of; its type parameters come first in `tparams`
    owner: Option[int]
    # how many of `tparams` are the owner type's (the rest are the method's own)
    n_owner: int
    insts: {[Ty]: int}

# An instance whose body still has to be checked.
struct Pending:
    module: int
    env: {str: Ty}
    decl: FnDecl
    # e.g. "`first` with T = int"
    what: str

fn type_names() -> [str]:
    return [
        "int",
        "i8",
        "i16",
        "i32",
        "i64",
        "i128",
        "u8",
        "u16",
        "u32",
        "u64",
        "u128",
        "float",
        "f32",
        "f64",
        "bool",
        "str"
    ]

fn prim_type(name: str) -> Option[Ty]:
    match name:
        case "int" | "i64":
            return Some(Ty.Int(IntTy.I64))
        case "i8":
            return Some(Ty.Int(IntTy.I8))
        case "i16":
            return Some(Ty.Int(IntTy.I16))
        case "i32":
            return Some(Ty.Int(IntTy.I32))
        case "u8":
            return Some(Ty.Int(IntTy.U8))
        case "u16":
            return Some(Ty.Int(IntTy.U16))
        case "u32":
            return Some(Ty.Int(IntTy.U32))
        case "u64":
            return Some(Ty.Int(IntTy.U64))
        case "i128":
            return Some(Ty.Int(IntTy.I128))
        case "u128":
            return Some(Ty.Int(IntTy.U128))
        case "float" | "f64":
            return Some(Ty.Float(FloatTy.F64))
        case "f32":
            return Some(Ty.Float(FloatTy.F32))
        case "bool":
            return Some(Ty.Bool)
        case "str":
            return Some(Ty.Str)
        case _:
            return None

fn reducer_by_name(n: str) -> Option[Reducer]:
    match n:
        case "sum":
            return Some(Reducer.Sum)
        case "product":
            return Some(Reducer.Product)
        case "min":
            return Some(Reducer.Min)
        case "max":
            return Some(Reducer.Max)
        case "any":
            return Some(Reducer.Any)
        case "all":
            return Some(Reducer.All)
        case _:
            return None

fn builtin_by_name(n: str) -> Option[Builtin]:
    for name, b in builtins():
        if name == n:
            return Some(b)
    return None

fn is_messageable(t: Ty) -> bool:
    match t:
        case Ty.Int(_) | Ty.Float(_) | Ty.Bool | Ty.Str:
            return true
        case Ty.Array(e):
            return is_messageable(e)
        case _:
            return false

fn plural(n: int) -> str:
    return "" if n == 1 else "s"

fn int_names(xs: [str]) -> str:
    return ", ".join(["int" for _ in xs])

# `s` as a string literal: in double quotes, with `"`, `\` and control
# characters escaped.
fn debug_str(s: str) -> str:
    var parts = ["\""]
    for c in s:
        if c == "\\":
            parts.push("\\\\")
        elif c == "\"":
            parts.push("\\\"")
        elif c == "\n":
            parts.push("\\n")
        elif c == "\t":
            parts.push("\\t")
        elif c == "\r":
            parts.push("\\r")
        elif c == "\u{0}":
            parts.push("\\0")
        elif ord(c) < 0x20 or ord(c) == 0x7f:
            parts.push("\\u{" + diag.hex(ord(c)) + "}")
        else:
            parts.push(c)
    parts.push("\"")
    return "".join(parts)

fn new_checker() -> Checker:
    return Checker(
        diags=[],
        typed=false,
        info=new_info(),
        items=[],
        cur_mod=0,
        locals=[],
        scopes=[],
        ret_ty=Ty.Unit,
        loops=[],
        par_stack=[],
        in_spec=false,
        no_try=0,
        unpacks=[],
        allow_gen=false,
        gensym=0,
        gtypes=[],
        gfns=[],
        cgmethods={},
        tenv={},
        pending=[],
        ninst=0,
        key_checks=[],
        failed=false,
        src_dirs={},
        embedded={},
        expand=[],
        or_names=None,
        or_seen=[],
        const_exprs={},
        ref_paths=[]
    )

struct Checker:
    diags: [Diag]
    # every variable needs a written type (`typed = true` in brine.toml, or `--typed`)
    typed: bool
    info: ProgramInfo
    items: [{str: Item}]
    cur_mod: int
    locals: [LocalInfo]
    scopes: [[(str, int)]]
    ret_ty: Ty
    # one entry per enclosing loop: is it a `par for`?
    loops: [bool]
    par_stack: [ParCx]
    in_spec: bool
    # inside a comprehension, where `?` can't return from the function
    no_try: int
    # comprehension names unpacked from a tuple: (name, hidden variable, index)
    unpacks: [(str, str, int)]
    allow_gen: bool
    gensym: int
    gtypes: [GenType]
    gfns: [GenFn]
    # generic methods of ordinary types: (module, type name) -> method name -> index in `gfns`
    cgmethods: {(int, str): {str: int}}
    # type parameters while checking a generic instance: `T` -> `int`
    tenv: {str: Ty}
    pending: [Pending]
    ninst: int
    # map key types to validate once every struct's fields are known
    key_checks: [(Ty, Span)]
    # type argument inference already reported an error
    failed: bool
    # directory of each source file (by file id), for `embed("...")`
    src_dirs: {int: str}
    # file contents already embedded, by the span of the path literal (calls can be checked twice)
    embedded: {Span: str}
    # statements that replace the one just checked (`a, b = b, a`)
    expand: [Stmt]
    # inside a later alternative of `A(c) | B(c)`: the names the first one bound
    or_names: Option[{str: int}]
    # ... and the ones this alternative has bound so far
    or_seen: [str]
    # array constants: the literal each use stands for, every element folded
    const_exprs: {int: Expr}
    # `let t = ref self.t`: the variable and the fields each alias stands for.
    # Its scope entry has id `-2 - k` for alias k.
    ref_paths: [(str, [str], Span)]

    fn err(ref self, d: Diag):
        self.diags.push(d)

    fn tn(self, t: Ty) -> str:
        return "`" + self.info.ty_name(t) + "`"

    fn item(self, name: str) -> Option[Item]:
        return self.items[self.cur_mod].get(name)

    fn has_item(self, name: str) -> bool:
        return name in self.items[self.cur_mod]

    # ============================================================ program
    fn check_program(ref self, ref prog: Program):
        self.info.module_names = [m.name for m in prog.modules]
        # ---- register items
        var spans: [{str: Span}] = []
        for mi in 0..len(prog.modules):
            var items: {str: (Item, Span)} = {}
            let mm = mangle_module(prog.modules[mi].name)
            self.register_generics(mi, ref prog.modules[mi], ref items)
            let m = prog.modules[mi]
            for s in m.structs:
                let id = len(self.info.structs)
                self.info.structs.push(
                    StructInfo(
                        name=s.name,
                        module=mi,
                        fields=[],
                        methods={},
                        span=s.span,
                        c_name=f"{mm}__{s.name}",
                        origin=None
                    )
                )
                self.info.struct_names.push(s.name)
                self.insert_item(ref items, s.name, Item.Struct(id), s.span)
            for e in m.enums:
                let id = len(self.info.enums)
                self.info.enums.push(
                    EnumInfo(
                        name=e.name,
                        module=mi,
                        variants=[],
                        methods={},
                        span=e.span,
                        c_name=f"{mm}__{e.name}",
                        origin=None,
                        bare=false
                    )
                )
                self.info.enum_names.push(e.name)
                self.insert_item(ref items, e.name, Item.Enum(id), e.span)
            for fi in 0..len(m.fns):
                let id = len(self.info.fns)
                prog.modules[mi].fns[fi].id = id
                let f = m.fns[fi]
                var c_name = f"{mm}__{f.name}"
                if f.is_extern:
                    c_name = f.name
                else:
                    match f.method_of:
                        case Some(s):
                            c_name = f"{mm}__{s}__{f.name}"
                        case None:
                            pass
                self.info.fns.push(
                    FnSig(
                        name=f.name,
                        module=mi,
                        idx=fi,
                        params=[],
                        ret=Ty.Unit,
                        c_name=c_name,
                        is_extern=f.is_extern,
                        method_of=None,
                        has_self=false,
                        span=f.name_span
                    )
                )
                match f.method_of:
                    case None:
                        self.insert_item(ref items, f.name, Item.Fn(id), f.name_span)
                    case Some(sname):
                        var dup = false
                        match items.get(sname):
                            case Some((Item.Struct(sid), _)):
                                self.info.fns[id].method_of = Some(Ty.Struct(sid))
                                dup = f.name in self.info.structs[sid].methods
                                self.info.structs[sid].methods[f.name] = id
                            case Some((Item.Enum(eid), _)):
                                self.info.fns[id].method_of = Some(Ty.Enum(eid))
                                dup = f.name in self.info.enums[eid].methods
                                self.info.enums[eid].methods[f.name] = id
                            case _:
                                pass
                        if dup:
                            self.err(
                                diag.error(
                                    "E0202",
                                    f"method `{f.name}` is defined twice on `{sname}`"
                                ).label(f.name_span, "duplicate method")
                            )
            for c in m.consts:
                let id = len(self.info.consts)
                self.info.consts.push(
                    ConstInfo(
                        name=c.name,
                        module=mi,
                        ty=Ty.Error,
                        value=ConstVal.Int(0),
                        span=c.span
                    )
                )
                self.insert_item(ref items, c.name, Item.Const(id), c.span)
            for ii, imp in enumerate(m.imports):
                if imp.alias == "":
                    continue
                let target = prog.import_targets[mi][ii]
                self.insert_item(ref items, imp.alias, Item.Module(target), imp.span)
            var sp: {str: Span} = {}
            var its: {str: Item} = {}
            for k, v in items.items():
                sp[k] = v.1
                its[k] = v.0
            spans.push(sp)
            self.items.push(its)
        self.from_imports(prog, ref spans)
        self.import_prelude()

        # ---- struct fields
        for mi in 0..len(prog.modules):
            self.cur_mod = mi
            for s in prog.modules[mi].structs:
                match self.items[mi].get(s.name):
                    case Some(Item.Struct(sid)):
                        let fields = self.resolve_fields(s.fields)
                        self.info.structs[sid].fields = fields
                    case _:
                        pass
        # ---- enum variants
        for mi in 0..len(prog.modules):
            self.cur_mod = mi
            for e in prog.modules[mi].enums:
                match self.items[mi].get(e.name):
                    case Some(Item.Enum(eid)):
                        let vs = self.resolve_variants(e)
                        for mname, fid in self.info.enums[eid].methods.items():
                            for v in vs:
                                if v.name == mname:
                                    let d = diag.error(
                                        "E0202",
                                        f"`{mname}` is both a variant and a method of `{e.name}`"
                                    )
                                    self.diags.push(
                                        d.label(
                                            self.info.fns[fid].span,
                                            "method"
                                        ).label(v.span, "variant")
                                    )
                                    break
                        self.info.enums[eid].variants = vs
                    case _:
                        pass
        # ---- function signatures
        for mi in 0..len(prog.modules):
            self.cur_mod = mi
            for f in prog.modules[mi].fns:
                let id = f.id
                let (params, ret, has_self) = self.resolve_sig(f, id)
                if f.is_extern:
                    for pi, p in enumerate(f.params):
                        let ps = params[pi]
                        var ok = false
                        match ps.ty:
                            case Ty.Int(_) | Ty.Float(_) | Ty.Bool:
                                ok = true
                            case _:
                                pass
                        if not ok or p.by_ref or p.mutable:
                            self.err(
                                diag.error(
                                    "E0311",
                                    "extern functions may only take integers, floats and bools"
                                ).label(p.span, "parameter has type " + self.tn(ps.ty))
                            )
                    var rok = false
                    match ret:
                        case Ty.Int(_) | Ty.Float(_) | Ty.Bool | Ty.Unit:
                            rok = true
                        case _:
                            pass
                    if not rok:
                        self.err(
                            diag.error(
                                "E0311",
                                "extern functions may only return integers, floats, bools or nothing"
                            ).label(f.span, "unsupported return type")
                        )
                self.info.fns[id].params = params
                self.info.fns[id].ret = ret
                self.info.fns[id].has_self = has_self

        # ---- constants
        for mi in 0..len(prog.modules):
            self.cur_mod = mi
            for ci in 0..len(prog.modules[mi].consts):
                match self.items[mi].get(prog.modules[mi].consts[ci].name):
                    case Some(Item.Const(id)):
                        self.locals = []
                        self.scopes = [[]]
                        var c = prog.modules[mi].consts[ci]
                        var ann: Option[Ty] = None
                        match c.ty:
                            case Some(te):
                                ann = Some(self.resolve_type(te))
                            case None:
                                pass
                        let t = self.check_expr(ref c.value, ann)
                        var ty = t
                        match ann:
                            case Some(a):
                                self.expect_ty(a, c.value)
                                ty = a
                            case None:
                                pass
                        match self.eval_const(c.value):
                            case Some(v):
                                self.info.consts[id].value = v
                                self.info.consts[id].ty = ty
                            case None:
                                match self.const_array(c.value):
                                    case Some(lit):
                                        self.const_exprs[id] = lit
                                        self.info.consts[id].ty = ty
                                    case None:
                                        if not t.is_error():
                                            self.err(
                                                diag.error(
                                                    "E0317",
                                                    "constant value must be computable at compile time"
                                                )
                                                .label(c.value.span, "not a constant expression")
                                                .with_help(
                                                    "constants can use literals, arithmetic, other constants, and arrays of these"
                                                )
                                            )
                        prog.modules[mi].consts[ci] = c
                    case _:
                        pass

        # ---- bodies
        for mi in 0..len(prog.modules):
            self.cur_mod = mi
            for fi in 0..len(prog.modules[mi].fns):
                if prog.modules[mi].fns[fi].is_extern:
                    continue
                let sig = self.info.fns[prog.modules[mi].fns[fi].id]
                self.check_fn(ref prog.modules[mi].fns[fi], sig.params, sig.ret)
            for ti in 0..len(prog.modules[mi].tests):
                self.check_fn(ref prog.modules[mi].tests[ti], [], Ty.Unit)
        # ---- instances of generic functions used above (and the ones they use)
        self.check_pending(ref prog)

        # ---- map key types
        let kcs = self.key_checks
        self.key_checks = []
        for k, span in kcs:
            var seen: [Ty] = []
            if not k.is_error() and not self.hashable(k, ref seen):
                var d = diag.error(
                    "E0335",
                    self.tn(k) + " can't be used as a map key"
                ).label(span, "invalid key type")
                d = d.note(
                    "map keys must be integers, `bool`, `str`, enums, or arrays, tuples and structs of those"
                )
                if k.is_float():
                    d = d.with_help(
                        "floats aren't allowed because `nan != nan`; use an integer key instead"
                    )
                else:
                    d = d.with_help("use a key type that can be compared with `==`")
                self.err(d)

        # ---- recursive by-value structs
        for sid in 0..len(self.info.structs):
            var seen: [int] = []
            if self.struct_contains(sid, sid, ref seen):
                let s = self.info.structs[sid]
                let d = diag.error(
                    "E0309",
                    f"struct `{self.info.struct_names[sid]}` contains itself and would have infinite size"
                )
                self.err(
                    d.label(s.span, "recursive struct").with_help(
                        "store the recursive part inside an array or an enum, e.g. `children: [Node]`"
                    )
                )
        # generic code is checked once per instance; report each problem once
        var seen_d: {(str, str, int, int, int): bool} = {}
        var kept: [Diag] = []
        for d in self.diags:
            var key = (d.code, d.msg, -1, 0, 0)
            if len(d.labels) > 0:
                let s = d.labels[0].span
                key = (d.code, d.msg, s.file, s.lo, s.hi)
            if key not in seen_d:
                seen_d[key] = true
                kept.push(d)
        self.diags = kept

    fn insert_item(ref self, ref items: {str: (Item, Span)}, name: str, it: Item, span: Span):
        match items.get(name):
            case Some((_, prev)):
                items[name] = (it, span)
                self.dup(name, span, prev)
            case None:
                items[name] = (it, span)

    fn resolve_fields(ref self, decls: [FieldDecl]) -> [(str, Ty)]:
        var fields: [(str, Ty)] = []
        for f in decls:
            let t = self.resolve_type(f.ty)
            if any(n == f.name for n, _ in fields):
                self.err(
                    diag.error(
                        "E0202",
                        f"field `{f.name}` is defined twice"
                    ).label(f.span, "duplicate field")
                )
            fields.push((f.name, t))
        return fields

    fn resolve_variants(ref self, e: EnumDecl) -> [VariantInfo]:
        var vs: [VariantInfo] = []
        for v in e.variants:
            if any(x.name == v.name for x in vs):
                self.err(
                    diag.error(
                        "E0202",
                        f"variant `{v.name}` is defined twice"
                    ).label(v.span, "duplicate variant")
                )
            let fields = self.resolve_fields(v.fields)
            vs.push(VariantInfo(name=v.name, fields=fields, span=v.span))
        if len(vs) == 0:
            self.err(
                diag.error(
                    "E0110",
                    f"enum `{e.name}` has no variants"
                ).label(e.span, "add at least one variant")
            )
        return vs

    # Parameter types, return type, and whether the first parameter is `self`.
    fn resolve_sig(ref self, f: FnDecl, id: int) -> ([ParamSig], Ty, bool):
        var params: [ParamSig] = []
        var has_self = false
        for pi, p in enumerate(f.params):
            var ty = Ty.Error
            match p.ty:
                case Some(t):
                    ty = self.resolve_type(t)
                case None:
                    if pi == 0:
                        has_self = true
                    match self.info.fns[id].method_of:
                        case Some(t):
                            ty = t
                        case None:
                            pass
            if p.name != "_" and any(q.name == p.name for q in params):
                self.err(
                    diag.error(
                        "E0202",
                        f"parameter `{p.name}` is defined twice"
                    ).label(p.span, "duplicate")
                )
            params.push(ParamSig(name=p.name, ty=ty, by_ref=p.by_ref))
        var ret = Ty.Unit
        match f.ret:
            case Some(t):
                ret = self.resolve_type(t)
            case None:
                pass
        return (params, ret, has_self)

    # The item named by `path` (`Name` or `module.Name`) as seen from module `module`.
    fn item_at(self, module: int, path: [str]) -> Option[Item]:
        if len(path) == 1:
            return self.items[module].get(path[0])
        if len(path) == 2:
            match self.items[module].get(path[0]):
                case Some(Item.Module(m)):
                    return self.items[m].get(path[1])
                case _:
                    return None
        return None

    # `from a import x, y`: bind each name to the item defined in `a`.
    # Only items defined in `a` itself can be imported (not `a`'s own imports).
    fn from_imports(ref self, prog: Program, ref spans: [{str: Span}]):
        var own: [{str: Item}] = []
        for its in self.items:
            var o: {str: Item} = {}
            for k, v in its.items():
                match v:
                    case Item.Module(_):
                        pass
                    case _:
                        o[k] = v
            own.push(o)
        for mi, m in enumerate(prog.modules):
            for ii, imp in enumerate(m.imports):
                let target = prog.import_targets[mi][ii]
                for name, sp in imp.names:
                    match own[target].get(name):
                        case None:
                            let mname = ".".join(imp.path)
                            var d = diag.error(
                                "E0201",
                                f"module `{mname}` has no item `{name}`"
                            ).label(sp, "not found")
                            match best_match(name, own[target].keys()):
                                case Some(b):
                                    d = d.with_help(f"did you mean `{b}`?").fix(sp, b, "replace")
                                case None:
                                    pass
                            self.err(d)
                        case Some(it):
                            match spans[mi].get(name):
                                case Some(prev):
                                    let p = ".".join(imp.path)
                                    let last = imp.path[len(imp.path) - 1]
                                    self.err(
                                        diag.error(
                                            "E0202",
                                            f"`{name}` is imported but this module already has that name"
                                        )
                                        .label(sp, "imported here")
                                        .label(prev, "also defined here")
                                        .with_help(
                                            f"rename one of them, or use `import {p}` and write `{last}.{name}`"
                                        )
                                    )
                                case None:
                                    spans[mi][name] = sp
                                    self.items[mi][name] = it

    fn dup(ref self, name: str, span: Span, prev: Span):
        self.err(
            diag.error("E0202", f"`{name}` is defined more than once")
            .label(span, "redefined here")
            .label(prev, "first defined here")
        )

    fn struct_contains(self, sid: int, target: int, ref seen: [int]) -> bool:
        if sid in seen:
            return false
        seen.push(sid)
        for _, t in self.info.structs[sid].fields:
            if self.ty_contains_struct(t, target, ref seen):
                return true
        return false

    fn ty_contains_struct(self, t: Ty, target: int, ref seen: [int]) -> bool:
        match t:
            case Ty.Struct(s):
                return s == target or self.struct_contains(s, target, ref seen)
            case Ty.Tuple(ts):
                for x in ts:
                    if self.ty_contains_struct(x, target, ref seen):
                        return true
                return false
            case _:
                return false

    fn resolve_type(ref self, te: TypeExpr) -> Ty:
        match te:
            case TypeExpr.Array(elem, _):
                return Ty.Array(self.resolve_type(elem))
            case TypeExpr.Map(key, val, span):
                let k = self.resolve_type(key)
                let v = self.resolve_type(val)
                self.check_key_type(k, span)
                return Ty.Map(k, v)
            case TypeExpr.Tuple(elems, _):
                if len(elems) == 0:
                    return Ty.Unit
                var ts: [Ty] = []
                for x in elems:
                    ts.push(self.resolve_type(x))
                return Ty.Tuple(ts)
            case TypeExpr.Named(path, args, span):
                let name = ".".join(path)
                var found: Option[Ty] = None
                if len(path) == 1 and path[0] in self.tenv:
                    found = Some(self.tenv[path[0]])
                elif len(path) == 1 and prim_type(name).is_some():
                    found = prim_type(name)
                else:
                    match self.item_at(self.cur_mod, path):
                        case Some(Item.Struct(id)):
                            found = Some(Ty.Struct(id))
                        case Some(Item.Enum(id)):
                            found = Some(Ty.Enum(id))
                        case Some(Item.GenType(tid)):
                            if len(args) == 0:
                                let g = self.gtypes[tid]
                                let d = diag.error(
                                    "E0334",
                                    f"`{name}` needs type arguments"
                                ).label(span, f"e.g. `{name}[{int_names(g.tparams)}]`")
                                self.err(d.note(f"declared as `{g.name}[{', '.join(g.tparams)}]`"))
                                return Ty.Error
                            var targs: [Ty] = []
                            for a in args:
                                targs.push(self.resolve_type(a))
                            return self.apply(tid, targs, span)
                        case _:
                            pass
                match found:
                    case Some(t):
                        if len(args) > 0:
                            self.err(
                                diag.error(
                                    "E0334",
                                    f"`{name}` is not generic"
                                ).label(span, "remove the type arguments")
                            )
                        return t
                    case None:
                        pass
                var d = diag.error(
                    "E0203",
                    f"unknown type `{name}`"
                ).label(span, "not a known type")
                var cands = type_names()
                for k, v in self.items[self.cur_mod].items():
                    match v:
                        case Item.Struct(_) | Item.Enum(_) | Item.GenType(_):
                            cands.push(k)
                        case _:
                            pass
                cands.extend(self.tenv.keys())
                var hint: Option[str] = None
                match name:
                    case "string" | "String":
                        hint = Some("str")
                    case "i64" | "Int" | "integer":
                        hint = Some("int")
                    case "double" | "Float" | "float64":
                        hint = Some("float")
                    case "boolean" | "Bool":
                        hint = Some("bool")
                    case _:
                        hint = best_match(name, cands)
                match hint:
                    case Some(h):
                        d = d.with_help(f"did you mean `{h}`?").fix(span, h, f"replace with `{h}`")
                    case None:
                        pass
                if name == "list" or name == "List" or name == "Vec":
                    d = d.with_help("arrays are written `[T]`, e.g. `[int]`")
                self.err(d)
                return Ty.Error

    # `[3, 4, 5]`, `[0] * 256` or `[[1, 2], [3, 4]]` with every element known
    # now: the same literal with each element folded to a literal.
    fn const_array(self, e: Expr) -> Option[Expr]:
        var out: [Expr] = []
        match e.kind:
            case ExprKind.Array(xs):
                for x in xs:
                    out.push(self.const_elem(x)?)
            case ExprKind.Repeat(x, n):
                let v = self.const_elem(x)?
                match self.eval_const(n)?:
                    case ConstVal.Int(k):
                        if k < 0 or k > 1 << 20:
                            return None
                        for _ in 0..int(k):
                            out.push(v)
                    case _:
                        return None
            case _:
                return None
        var r = e
        r.kind = ExprKind.Array(out)
        return Some(r)

    fn const_elem(self, x: Expr) -> Option[Expr]:
        match self.eval_const(x):
            case Some(v):
                var lit = x
                match v:
                    case ConstVal.Int(n):
                        lit.kind = ExprKind.Int(n)
                    case ConstVal.UInt(n):
                        lit.kind = ExprKind.UInt(n)
                    case ConstVal.Float(f):
                        lit.kind = ExprKind.Float(f)
                    case ConstVal.Bool(b):
                        lit.kind = ExprKind.Bool(b)
                    case ConstVal.Str(t):
                        lit.kind = ExprKind.Str(t)
                lit.res = Res.Unresolved
                return Some(lit)
            case None:
                return self.const_array(x)

    fn eval_const(self, e: Expr) -> Option[ConstVal]:
        match e.kind:
            case ExprKind.Int(v):
                if e.ty.is_float():
                    return Some(ConstVal.Float(float(v)))
                return Some(ConstVal.Int(v))
            case ExprKind.UInt(v):
                return Some(ConstVal.UInt(v))
            case ExprKind.Float(v):
                return Some(ConstVal.Float(v))
            case ExprKind.Bool(b):
                return Some(ConstVal.Bool(b))
            case ExprKind.Str(s):
                return Some(ConstVal.Str(s))
            case ExprKind.Ident(_) | ExprKind.Field(_, _, _):
                match e.res:
                    case Res.Const(id):
                        return Some(self.info.consts[id].value)
                    case _:
                        return None
            case ExprKind.Call(_, args):
                match e.cres:
                    case CallRes.Builtin(Builtin.Embed):
                        if len(args) == 0:
                            return None
                        return self.eval_const(args[0].expr)
                    # `len(TABLE)` of an array constant
                    case CallRes.Builtin(Builtin.Len):
                        if len(args) != 1:
                            return None
                        match args[0].expr.res:
                            case Res.Const(_):
                                match args[0].expr.kind:
                                    case ExprKind.Array(xs):
                                        return Some(ConstVal.Int(i128(len(xs))))
                                    case _:
                                        return None
                            case _:
                                return None
                    case _:
                        return None
            case ExprKind.Unary(op, x):
                let v = self.eval_const(x)?
                match (op, v):
                    case (UnOp.Neg, ConstVal.Int(n)):
                        return Some(ConstVal.Int(num.checked_neg(n)?))
                    case (UnOp.Neg, ConstVal.Float(f)):
                        return Some(ConstVal.Float(-f))
                    case (UnOp.Not, ConstVal.Bool(b)):
                        return Some(ConstVal.Bool(not b))
                    case (UnOp.BitNot, ConstVal.Int(n)):
                        return Some(ConstVal.Int(~n))
                    case _:
                        return None
            case ExprKind.Binary(op, l, r):
                let a = self.eval_const(l)?
                let b = self.eval_const(r)?
                match (a, b):
                    case (ConstVal.Int(x), ConstVal.Int(y)):
                        match op:
                            case BinOp.Add:
                                return Some(ConstVal.Int(num.checked_add(x, y)?))
                            case BinOp.Sub:
                                return Some(ConstVal.Int(num.checked_sub(x, y)?))
                            case BinOp.Mul:
                                return Some(ConstVal.Int(num.checked_mul(x, y)?))
                            case BinOp.Div:
                                return Some(ConstVal.Int(num.floor_div(x, y)?))
                            case BinOp.Mod:
                                return Some(ConstVal.Int(num.floor_mod(x, y)?))
                            case BinOp.BitAnd:
                                return Some(ConstVal.Int(x & y))
                            case BinOp.BitOr:
                                return Some(ConstVal.Int(x | y))
                            case BinOp.BitXor:
                                return Some(ConstVal.Int(x ^ y))
                            case BinOp.Shl:
                                return Some(ConstVal.Int(num.checked_shl(x, y)?))
                            case BinOp.Shr:
                                return Some(ConstVal.Int(num.checked_shr(x, y)?))
                            case _:
                                return None
                    case (ConstVal.Float(x), ConstVal.Float(y)):
                        match op:
                            case BinOp.Add:
                                return Some(ConstVal.Float(x + y))
                            case BinOp.Sub:
                                return Some(ConstVal.Float(x - y))
                            case BinOp.Mul:
                                return Some(ConstVal.Float(x * y))
                            case BinOp.Div:
                                return Some(ConstVal.Float(x / y))
                            case _:
                                return None
                    case (ConstVal.Str(x), ConstVal.Str(y)):
                        if op == BinOp.Add:
                            return Some(ConstVal.Str(x + y))
                        return None
                    case (ConstVal.Bool(x), ConstVal.Bool(y)):
                        match op:
                            case BinOp.And:
                                return Some(ConstVal.Bool(x and y))
                            case BinOp.Or:
                                return Some(ConstVal.Bool(x or y))
                            case _:
                                return None
                    case _:
                        return None
            case _:
                return None

    # ============================================================ functions
    fn check_fn(ref self, ref f: FnDecl, params: [ParamSig], ret: Ty):
        self.locals = []
        self.scopes = [[]]
        self.ret_ty = ret
        self.loops = []
        self.par_stack = []
        f.param_locals = []
        for pi, p in enumerate(f.params):
            let ps = params[pi]
            let kind = LocalKind.RefParam if ps.by_ref else LocalKind.Param
            let id = self.declare(p.name, p.span, ps.ty, kind)
            f.param_locals.push(id)
        self.in_spec = true
        for ri in 0..len(f.requires):
            self.check_expr(ref f.requires[ri], Some(Ty.Bool))
            self.expect_ty(Ty.Bool, f.requires[ri])
        self.scopes.push([])
        if ret != Ty.Unit:
            let id = self.declare("result", f.name_span, ret, LocalKind.Result)
            f.result_local = Some(id)
        for ri in 0..len(f.ensures):
            self.check_expr(ref f.ensures[ri], Some(Ty.Bool))
            self.expect_ty(Ty.Bool, f.ensures[ri])
        self.scopes.pop()
        self.in_spec = false
        # `mut x: T` parameters: the body works on a local copy named `x`, while the
        # parameter itself (renamed `x'`) keeps the value the caller passed. Contracts
        # were resolved above, so they talk about the caller's value.
        var prologue: [Stmt] = []
        for i, p in enumerate(f.params):
            if p.mutable and not p.by_ref:
                let pid = f.param_locals[i]
                let hidden = p.name + "'"
                self.locals[pid].name = hidden
                for j in 0..len(self.scopes[0]):
                    if self.scopes[0][j].1 == pid:
                        self.scopes[0][j] = (hidden, pid)
                let init = mk(ExprKind.Ident(hidden), p.span)
                prologue.push(
                    stmt(StmtKind.Let(true, LetPat.Name(p.name, p.span), None, init, false), p.span)
                )
        if len(prologue) > 0:
            prologue.extend(f.body.stmts)
            f.body.stmts = prologue
        self.check_block(ref f.body)
        var void = false
        match ret:
            case Ty.Unit | Ty.Error:
                void = true
            case _:
                pass
        if not void and not block_terminates(f.body):
            self.err(
                diag.error(
                    "E0306",
                    f"function `{f.name}` may reach the end without returning a value"
                )
                .label(f.name_span, "expected to return " + self.tn(ret))
                .with_help("add a `return` statement at the end of the function")
            )
        f.locals = self.locals
        self.locals = []

    # In a typed project, a variable without a written type is an error.
    # `fix` offers to insert the inferred type after `span`.
    fn require_type(ref self, span: Span, names: str, label: str, fix: Option[str]):
        if not self.typed or self.info.module_names[self.cur_mod] == PRELUDE or "?" in label:
            return
        if all(n == "_" for n in names.split(", ")):
            return
        # a generic function's body is checked once per use; say it once
        for d in self.diags:
            if d.code == "E0337" and len(d.labels) > 0 and d.labels[0].span == span:
                return
        let plural = ", " in names
        var d = diag.error(
            "E0337",
            f"`{names}` " + ("have" if plural else "has") + " no written type"
        ).label(span, label)
        d = d.note(
            "this project asks for a type on every variable (`typed = true` in brine.toml, or `--typed`)"
        )
        match fix:
            case Some(fx):
                d = d.fix(Span(file=span.file, lo=span.hi, hi=span.hi), fx, "add the type")
            case None:
                pass
        self.err(d)

    fn cur_level(self) -> int:
        return len(self.par_stack)

    fn declare(ref self, name: str, span: Span, ty: Ty, kind: LocalKind) -> int:
        if name == "_":
            # a wildcard: it may repeat, and it can't be read
            let id = len(self.locals)
            self.locals.push(
                LocalInfo(name=name, ty=ty, kind=kind, par_level=self.cur_level(), span=span)
            )
            return id
        match self.defined_at(name):
            case Some(pspan):
                if kind != LocalKind.Result:
                    self.err(
                        diag.error("E0207", f"`{name}` is already defined in this function")
                        .label(span, "defined again here")
                        .label(pspan, "first defined here")
                        .with_help(
                            "brine doesn't allow shadowing; pick a new name, or declare it with `var` and assign to it"
                        )
                    )
            case None:
                pass
        let id = len(self.locals)
        self.locals.push(
            LocalInfo(name=name, ty=ty, kind=kind, par_level=self.cur_level(), span=span)
        )
        self.scopes[len(self.scopes) - 1].push((name, id))
        return id

    fn lookup_local(self, name: str) -> Option[int]:
        var si = len(self.scopes) - 1
        while si >= 0:
            let s = self.scopes[si]
            var j = len(s) - 1
            while j >= 0:
                if s[j].0 == name:
                    if s[j].1 < 0:
                        return None
                    return Some(s[j].1)
                j -= 1
            si -= 1
        return None

    # The alias `name` stands for, when it's `let name = ref x.field`.
    fn lookup_path(self, name: str) -> Option[int]:
        var si = len(self.scopes) - 1
        while si >= 0:
            let s = self.scopes[si]
            var j = len(s) - 1
            while j >= 0:
                if s[j].0 == name:
                    if s[j].1 < 0:
                        return Some(-2 - s[j].1)
                    return None
                j -= 1
            si -= 1
        return None

    # The span where `name` was defined in this function, if it was.
    fn defined_at(self, name: str) -> Option[Span]:
        match self.lookup_local(name):
            case Some(id):
                return Some(self.locals[id].span)
            case None:
                pass
        match self.lookup_path(name):
            case Some(k):
                return Some(self.ref_paths[k].2)
            case None:
                return None

    fn use_local(ref self, id: int):
        let pl = self.locals[id].par_level
        for i in pl..len(self.par_stack):
            if id not in self.par_stack[i].captures:
                self.par_stack[i].captures.push(id)

    fn all_names(self) -> [str]:
        var v: [str] = []
        for s in self.scopes:
            for n, _ in s:
                v.push(n)
        v.extend(self.items[self.cur_mod].keys())
        for n, _ in builtins():
            v.push(n)
        v.extend(["sum", "product", "any", "all", "range", "world", "os"])
        return v

    fn undefined(ref self, name: str, span: Span, what: str):
        var d = diag.error(
            "E0201",
            f"cannot find {what} `{name}`"
        ).label(span, "not found in this scope")
        match name:
            case "None" | "nil" | "null" | "NULL":
                d = d.with_help("brine has no null value; every variable holds a real value")
            case "_":
                d = d.with_help("`_` ignores a value; give the value a name to use it")
            case "self":
                d = d.with_help(
                    "`self` is only available in methods declared inside a `struct` with `fn name(self, ...)`"
                )
            case "println" | "printf" | "puts" | "console":
                d = d.with_help("use `print(...)`").fix(span, "print", "replace with `print`")
            case "length" | "size" | "count":
                d = d.with_help("use `len(x)`").fix(span, "len", "replace with `len`")
            case _:
                match best_match(name, self.all_names()):
                    case Some(m):
                        d = d.with_help(f"did you mean `{m}`?").fix(span, m, f"replace with `{m}`")
                    case None:
                        pass
        self.err(d)

    # ============================================================ statements
    fn check_block(ref self, ref b: Block):
        self.scopes.push([])
        # a statement may be replaced by several (`a, b = b, a`)
        var out: [Stmt] = []
        var expanded = false
        for i in 0..len(b.stmts):
            self.check_stmt(ref b.stmts[i])
            if len(self.expand) > 0:
                if not expanded:
                    out = b.stmts[:i]
                    expanded = true
                for x in self.expand:
                    for e in stmt_exprs(x):
                        self.check_mut_conflicts(e)
                    out.push(x)
                self.expand = []
                continue
            for e in stmt_exprs(b.stmts[i]):
                self.check_mut_conflicts(e)
            if expanded:
                out.push(b.stmts[i])
        if expanded:
            b.stmts = out
        self.scopes.pop()

    # Value semantics inside one expression: a variable changed in place by a
    # call (`xs.pop()`, a `ref self` method, a `ref` argument) can't be changed
    # again or read elsewhere in the same expression, since the result would
    # depend on the order of evaluation. Reads in the call's own receiver and
    # arguments are fine (they happen before the change, as in Rust and Swift),
    # and so are uses on different sides of `and`/`or`/`if-else`, which run in order.
    # A call in another call's arguments runs first, so `t.f(t.g(x))` is fine
    # when `t` is a variable or a field path; and different fields of a variable
    # (`self.a`, `self.b`) are separate places.
    fn check_mut_conflicts(ref self, e: Expr):
        var m = MutScan(sites=[], reads=[], seq=[], places=[])
        mut_sites(e, self.info, ref m)
        var done: [int] = []
        for st in m.sites:
            let root = st.root
            if root in done:
                continue
            done.push(root)
            var reported = false
            for d in self.diags:
                if d.code == "E0405" and len(d.labels) > 0:
                    let l = d.labels[0].span
                    if l.file == e.span.file and e.span.lo <= l.lo and l.hi <= e.span.hi:
                        reported = true
                        break
            if reported:
                continue
            let n = self.locals[root].name
            var mine: [MutSite] = []
            for s in m.sites:
                if s.root == root:
                    mine.push(s)
            # a second change: `xs.push(xs.pop()[0])`, `f(xs.pop(), xs.pop())`
            var twice: Option[(Span, Span)] = None
            for i in 0..len(mine):
                let a = mine[i]
                for j in i + 1..len(mine):
                    let b = mine[j]
                    if (
                        b.span != a.span
                        and paths_overlap(a.path, b.path)
                        and not ordered(m.seq, a.span, b.span)
                        and not runs_first(a, b)
                        and not runs_first(b, a)
                    ):
                        twice = Some((a.span, b.span))
                        break
                if twice.is_some():
                    break
            match twice:
                case Some((first, again)):
                    self.err(
                        diag.error("E0405", f"`{n}` is changed twice in the same expression")
                        .label(again, "changed here")
                        .label(first, "and changed here")
                        .note("brine doesn't define which of the two runs first")
                        .with_help(
                            "make one change in its own statement first, e.g. `let v = ...`, then use `v`"
                        )
                    )
                    continue
                case None:
                    pass
            # a read outside the changing call
            var conflict: Option[(Span, Span)] = None
            for s in mine:
                for r in m.reads:
                    if (
                        r.root == root
                        and paths_overlap(r.path, s.path)
                        and not within(r.span, s.span)
                        and not ordered(m.seq, r.span, s.span)
                        and not read_later(m.places, r.span, s.span)
                    ):
                        conflict = Some((s.span, r.span))
                        break
                if conflict.is_some():
                    break
            match conflict:
                case Some((site, read)):
                    self.err(
                        diag.error(
                            "E0405",
                            f"`{n}` is changed and also read in the same expression"
                        )
                        .label(site, "changed here")
                        .label(read, "read here")
                        .with_help(
                            "make the change in its own statement first, then use the result"
                        )
                    )
                case None:
                    pass

    # `let r = ref x`: `r` becomes another name for the variable `x`. Every use of
    # `r` resolves to `x`, so the rest of the compiler never sees the alias.
    fn check_ref_let(
        ref self,
        mutable: bool,
        pat: LetPat,
        ty: Option[TypeExpr],
        ref init: Expr,
        span: Span
    ):
        if mutable:
            self.err(
                diag.error("E0404", "references are declared with `let`")
                .label(span, "a reference always names the same variable")
                .with_help(
                    "change the variable through the reference instead; the reference itself can't be re-pointed"
                )
                .fix(
                    Span(file=span.file, lo=span.lo, hi=span.lo + 3),
                    "let",
                    "replace `var` with `let`"
                )
            )
        var ann: Option[Ty] = None
        match ty:
            case Some(te):
                ann = Some(self.resolve_type(te))
            case None:
                pass
        self.check_expr(ref init, ann)
        match ann:
            case Some(a):
                self.expect_ty(a, init)
            case None:
                pass
        var target = -1
        var fields: [str] = []
        var root = ""
        var at = init
        var walking = true
        while walking:
            walking = false
            match at.kind:
                case ExprKind.Ident(n):
                    match at.res:
                        case Res.Local(id):
                            target = id
                            root = n
                        case _:
                            pass
                case ExprKind.Field(b, f, _):
                    if field_base(b.ty):
                        fields.insert(0, f)
                        at = b
                        walking = true
                case _:
                    pass
        var name = ""
        var nsp = span
        match pat:
            case LetPat.Name(n, sp):
                name = n
                nsp = sp
            case LetPat.Tuple(_):
                self.err(
                    diag.error(
                        "E0404",
                        "a reference can't be unpacked"
                    ).label(span, "use a single name: `let r = ref x`")
                )
                return
        if target < 0:
            if not init.ty.is_error():
                self.err(
                    diag.error("E0404", "`ref` needs a variable or a field of one")
                    .label(init.span, "not a variable or a field")
                    .with_help(
                        "write `let r = ref total` or `let r = ref self.total`; for an element, keep its index: `xs[i]`"
                    )
                )
            # declare it anyway, so its uses don't report it as undefined
            self.declare(name, nsp, Ty.Error, LocalKind.Let)
            return
        match self.defined_at(name):
            case Some(pspan):
                self.err(
                    diag.error("E0207", f"`{name}` is already defined in this function")
                    .label(nsp, "defined again here")
                    .label(pspan, "first defined here")
                    .with_help("brine doesn't allow shadowing; pick a new name")
                )
            case None:
                pass
        if len(fields) > 0:
            self.ref_paths.push((root, fields, nsp))
            self.scopes[len(self.scopes) - 1].push((name, -1 - len(self.ref_paths)))
            return
        self.scopes[len(self.scopes) - 1].push((name, target))

    # The place left of `=`: checks that it can be assigned and gives its type.
    # None: an undefined name, already reported.
    fn assign_target(ref self, ref target: Expr) -> Option[Ty]:
        match target.kind:
            case ExprKind.Ident(name):
                if (
                    self.lookup_local(name).is_none()
                    and self.lookup_path(name).is_none()
                    and not self.has_item(name)
                ):
                    let d = diag.error(
                        "E0201",
                        f"cannot assign to undefined variable `{name}`"
                    ).label(target.span, "not declared")
                    self.err(
                        d.with_help(f"declare it first: `var {name} = ...`").fix(
                            Span(file=target.span.file, lo=target.span.lo, hi=target.span.lo),
                            "var ",
                            "declare with `var`"
                        )
                    )
                    return None
            case _:
                pass
        let tt = self.check_expr(ref target, None)
        var is_const = false
        match target.kind:
            case ExprKind.Ident(n):
                match target.res:
                    case Res.Const(_):
                        is_const = true
                        self.err(
                            diag.error(
                                "E0401",
                                f"cannot assign to constant `{n}`"
                            ).label(target.span, "constants never change")
                        )
                    case _:
                        pass
            case _:
                pass
        if not is_const and not tt.is_error():
            self.check_mutation_target(target, "assign to")
        return Some(tt)

    # `a, b = b, a`: every value is computed first, then stored left to right.
    # It becomes `let t = (b, a)`, `a = t.0`, `b = t.1`.
    fn tuple_assign(ref self, span: Span, target: Expr, op: Option[BinOp], value: Expr):
        var value2 = value
        match op:
            case Some(_):
                self.err(
                    diag.error("E0404", "a compound assignment needs a single place")
                    .label(target.span, "several places")
                    .with_help("write one `+=` for each place")
                )
                self.check_expr(ref value2, None)
                self.expand = [stmt(StmtKind.ExprStmt(value2), span)]
                return
            case None:
                pass
        var leaves: [(Expr, [int])] = []
        place_leaves(target, [], ref leaves)
        var tys: [Ty] = []
        for i in 0..len(leaves):
            if is_wild(leaves[i].0):
                tys.push(Ty.Unknown)
                continue
            match self.assign_target(ref leaves[i].0):
                case Some(t):
                    tys.push(t)
                case None:
                    tys.push(Ty.Error)
        var k = 0
        let vt = self.check_expr(ref value2, Some(shape_ty(target, tys, ref k)))
        let tmp = f"tup'{span.lo}"
        let id = self.declare(tmp, value2.span, vt, LocalKind.Let)
        var first = stmt(
            StmtKind.Let(false, LetPat.Name(tmp, value2.span), None, value2, false),
            span
        )
        first.locals = [id]
        var out = [first]
        if vt.is_error():
            self.expand = out
            return
        if not fits_shape(target, vt):
            let tn = self.tn(vt)
            self.err(
                diag.error("E0301", f"cannot assign {tn} to {len(leaves)} places")
                .label(value2.span, f"has type {tn}")
                .label(target.span, "the places")
                .with_help("give one value for each place, e.g. `a, b = b, a`")
            )
            self.expand = out
            return
        self.place_conflicts(leaves)
        for i, leaf in enumerate(leaves):
            if is_wild(leaf.0):
                continue
            let vspan = elem_span(value2, leaf.1)
            var src = mk(ExprKind.Ident(tmp), vspan)
            for j in leaf.1:
                src = mk(ExprKind.Field(src, str(j), vspan), vspan)
            self.check_expr(ref src, Some(tys[i]))
            if not tys[i].is_error():
                self.expect_ty(tys[i], src)
            out.push(stmt(StmtKind.Assign(leaf.0, None, src), span))
        self.expand = out

    # Places in one tuple assignment must not overlap, and an index in one
    # must not read a variable another changes: the result would depend on
    # the order of the stores.
    fn place_conflicts(ref self, leaves: [(Expr, [int])]):
        for i in 0..len(leaves):
            let a = leaves[i].0
            if is_wild(a):
                continue
            match lvalue_root(a):
                case Some(root):
                    for j in 0..len(leaves):
                        let b = leaves[j].0
                        if j == i or is_wild(b):
                            continue
                        match index_reading(b, root):
                            case Some(sp):
                                let n = self.locals[root].name
                                self.err(
                                    diag.error(
                                        "E0405",
                                        f"this index reads `{n}`, which the same assignment changes"
                                    )
                                    .label(sp, f"reads `{n}`")
                                    .label(a.span, f"`{n}` changes here")
                                    .with_help(
                                        "assign in two steps, so the order is visible: first the index's variable, then the element"
                                    )
                                )
                                return
                            case None:
                                pass
                case None:
                    pass
            for j in i + 1..len(leaves):
                match (place_key(a), place_key(leaves[j].0)):
                    case (Some(x), Some(y)):
                        if x == y or x.starts_with(y + ".") or y.starts_with(x + "."):
                            self.err(
                                diag.error("E0405", "the same place is assigned twice")
                                .label(leaves[j].0.span, "assigned again here")
                                .label(a.span, "first assigned here")
                                .with_help("assign each place once")
                            )
                            return
                    case _:
                        pass

    fn check_stmt(ref self, ref s: Stmt):
        let span = s.span
        match s.kind:
            case StmtKind.Let(mutable, pat, ty, init, is_ref):
                var init2 = init
                if is_ref:
                    self.check_ref_let(mutable, pat, ty, ref init2, span)
                    s.kind = StmtKind.Pass
                    return
                var ann: Option[Ty] = None
                match ty:
                    case Some(te):
                        ann = Some(self.resolve_type(te))
                    case None:
                        pass
                var t = self.check_expr(ref init2, ann)
                match ann:
                    case Some(a):
                        self.expect_ty(a, init2)
                        t = a
                    case None:
                        pass
                # a `mut` parameter's copy (`let x = x'`) is made by the compiler
                var param_copy = false
                var init_name = ""
                match init2.kind:
                    case ExprKind.Ident(nm):
                        init_name = nm
                    case _:
                        pass
                match pat:
                    case LetPat.Name(n, _):
                        param_copy = init_name != "" and init_name == n + "'"
                    case _:
                        pass
                if ty.is_none() and not param_copy:
                    let tn = self.info.ty_name(t)
                    match pat:
                        case LetPat.Name(n, ns):
                            self.require_type(ns, n, f"add `: {tn}`", Some(f": {tn}"))
                        # `let () = ...` has no names to annotate
                        case LetPat.Tuple(ns) if len(ns) == 0:
                            pass
                        # a nested tuple (`tup'..`) is part of a pattern reported as a whole
                        case LetPat.Tuple(_) if init_name.starts_with("tup'"):
                            pass
                        case LetPat.Tuple(ns):
                            let sp = ns[0].1.to(ns[len(ns) - 1].1)
                            let shown = [x.0 for x in ns if "'" not in x.0]
                            let nested = len(shown) < len(ns)
                            let names = ", ".join(shown) + (", ..." if nested else "")
                            # `for k, v in ...` is unpacked by a `let` the compiler adds
                            let in_for = init_name.starts_with("for'")
                            var label = f"add `: {tn}` after the `)`"
                            if in_for and nested:
                                label = "give every loop variable a type, e.g. `i: int, (a: int, b: str)`"
                            match t:
                                case Ty.Tuple(ts):
                                    if in_for and not nested and len(ts) == len(ns):
                                        var each: [str] = []
                                        for i, x in enumerate(ns):
                                            each.push(x.0 + ": " + self.info.ty_name(ts[i]))
                                        label = "write `" + ", ".join(each) + "`"
                                case _:
                                    pass
                            self.require_type(sp, names, label, None)
                if t == Ty.Unit:
                    self.err(
                        diag.error("E0301", "this expression doesn't produce a value")
                        .label(init2.span, "has type `()`")
                        .with_help(
                            "functions without `-> Type` return nothing; call them as a statement instead"
                        )
                    )
                let kind = LocalKind.Var if mutable else LocalKind.Let
                var locals: [int] = []
                match pat:
                    case LetPat.Name(n, sp):
                        locals.push(self.declare(n, sp, t, kind))
                    case LetPat.Tuple(names):
                        var tys: [Ty] = []
                        match t:
                            case Ty.Tuple(ts):
                                if len(ts) == len(names):
                                    tys = ts
                            case _:
                                pass
                        if len(tys) == 0:
                            for _ in names:
                                tys.push(Ty.Error)
                            if t != Ty.Error:
                                let tn = self.tn(t)
                                self.err(
                                    diag.error(
                                        "E0301",
                                        f"cannot unpack {tn} into {len(names)} variables"
                                    ).label(init2.span, f"has type {tn}")
                                )
                        for i, x in enumerate(names):
                            locals.push(self.declare(x.0, x.1, tys[i], kind))
                s.kind = StmtKind.Let(mutable, pat, ty, init2, is_ref)
                s.locals = locals
            case StmtKind.Assign(target, op, value):
                match target.kind:
                    case ExprKind.Tuple(_):
                        self.tuple_assign(s.span, target, op, value)
                        return
                    case _:
                        pass
                var target2 = target
                var value2 = value
                var tt = Ty.Error
                match self.assign_target(ref target2):
                    case Some(t):
                        tt = t
                    case None:
                        self.check_expr(ref value2, None)
                        s.kind = StmtKind.Assign(target2, op, value2)
                        return
                match op:
                    case None:
                        self.check_expr(ref value2, Some(tt))
                        self.expect_ty(tt, value2)
                    case Some(o):
                        let vt = self.check_expr(ref value2, Some(tt))
                        let res = self.binop_type(o, tt, vt, span, target2.span, value2.span)
                        if not res.is_error() and res != tt:
                            self.err(
                                diag.error(
                                    "E0301",
                                    "compound assignment changes the variable's type"
                                ).label(span, "type mismatch")
                            )
                s.kind = StmtKind.Assign(target2, op, value2)
            case StmtKind.ExprStmt(e):
                var e2 = e
                self.check_expr(ref e2, None)
                match e2.kind:
                    case ExprKind.Compare(_, _):
                        self.err(
                            diag.warning("W0001", "comparison result is unused")
                            .label(e2.span, "this value is discarded")
                            .with_help("did you mean to assign with `=`?")
                        )
                    case _:
                        pass
                s.kind = StmtKind.ExprStmt(e2)
            case StmtKind.If(branches, els):
                var bs = branches
                for i in 0..len(bs):
                    self.check_cond(ref bs[i].0)
                    self.check_block(ref bs[i].1)
                var els2 = els
                match els:
                    case Some(b):
                        var b2 = b
                        self.check_block(ref b2)
                        els2 = Some(b2)
                    case None:
                        pass
                s.kind = StmtKind.If(bs, els2)
            case StmtKind.While(cond, invariants, body):
                var cond2 = cond
                var invs = invariants
                var body2 = body
                self.check_cond(ref cond2)
                self.in_spec = true
                for i in 0..len(invs):
                    self.check_expr(ref invs[i], Some(Ty.Bool))
                    self.expect_ty(Ty.Bool, invs[i])
                self.in_spec = false
                self.loops.push(false)
                self.check_block(ref body2)
                self.loops.pop()
                s.kind = StmtKind.While(cond2, invs, body2)
            case StmtKind.For(var_name, var_span, ty, iter, invariants, body, is_par):
                var iter2 = iter
                var invs = invariants
                var body2 = body
                var ann: Option[Ty] = None
                match ty:
                    case Some(te):
                        ann = Some(self.resolve_type(te))
                    case None:
                        pass
                let found = self.check_iter(ref iter2, ann)
                var elem = found
                match ann:
                    case Some(a):
                        if not a.is_error() and not found.is_error() and a != found:
                            let an = self.tn(a)
                            let fname = self.tn(found)
                            self.err(
                                diag.error("E0301", "mismatched types").label(
                                    ty.unwrap().span(),
                                    f"expected {an}, but the loop gives {fname}"
                                )
                            )
                        elem = a
                    case None:
                        pass
                # `for k, v in ...` checks its types on the unpacking `let` in the body
                var unpacked = false
                if len(body2.stmts) > 0:
                    match body2.stmts[0].kind:
                        case StmtKind.Let(_, _, _, init, _):
                            match init.kind:
                                case ExprKind.Ident(nm):
                                    unpacked = nm == var_name
                                case _:
                                    pass
                        case _:
                            pass
                if ty.is_none() and not unpacked:
                    let tn = self.info.ty_name(elem)
                    self.require_type(var_span, var_name, f"add `: {tn}`", Some(f": {tn}"))
                let kind = LocalKind.ForVar if iter2.ty == Ty.Range else LocalKind.ForElem
                if is_par:
                    let level = self.cur_level() + 1
                    self.par_stack.push(
                        ParCx(level=level, is_for=true, loop_var=None, captures=[], writes=[])
                    )
                self.scopes.push([])
                let id = self.declare(var_name, var_span, elem, kind)
                s.local = id
                if is_par:
                    self.par_stack[len(self.par_stack) - 1].loop_var = Some(id)
                    if len(invs) > 0:
                        self.err(
                            diag.error(
                                "E0507",
                                "`par for` loops can't have invariants"
                            ).label(invs[0].span, "remove this")
                        )
                if not is_par:
                    match iter2.kind:
                        case ExprKind.Call(_, args):
                            if iter2.cres == CallRes.Range and len(args) == 3 and len(invs) > 0:
                                self.err(
                                    diag.error(
                                        "E0507",
                                        "invariants on stepped ranges are not supported yet"
                                    )
                                    .label(iter2.span, "stepped range")
                                    .with_help("use a `while` loop with an explicit counter")
                                )
                        case _:
                            pass
                self.in_spec = true
                for i in 0..len(invs):
                    self.check_expr(ref invs[i], Some(Ty.Bool))
                    self.expect_ty(Ty.Bool, invs[i])
                self.in_spec = false
                self.loops.push(is_par)
                self.check_block(ref body2)
                self.loops.pop()
                self.scopes.pop()
                if is_par:
                    let cx = self.par_stack.pop()
                    s.caps = cx.captures
                    s.writes = cx.writes
                    for w in cx.writes:
                        var bad: [Span] = []
                        scan_bad_uses_block(body2, w, id, ref bad)
                        if len(bad) > 0:
                            let n = self.locals[w].name
                            let vn = var_name
                            self.err(
                                diag.error(
                                    "E0502",
                                    f"`{n}` is written at `{n}[{vn}]` in this `par for`, so it can't be accessed any other way"
                                )
                                .label(bad[0], "accessed here")
                                .note(
                                    "other iterations may be writing to the other elements at the same time"
                                )
                                .with_help(
                                    f"only use `{n}[{vn}]` inside the loop, or copy the data you need before the loop"
                                )
                            )
                s.kind = StmtKind.For(var_name, var_span, ty, iter2, invs, body2, is_par)
            case StmtKind.Return(e):
                if len(self.par_stack) > 0:
                    self.err(
                        diag.error("E0505", "`return` is not allowed inside a `par` body")
                        .label(span, "can't return from a parallel iteration")
                        .with_help("use `continue` to skip the rest of an iteration")
                    )
                let rt = self.ret_ty
                match e:
                    case Some(x):
                        var x2 = x
                        if rt == Ty.Unit:
                            # `return f()` where `f` returns nothing is fine (generic code
                            # with `T = ()` writes it too)
                            let xt = self.check_expr(ref x2, None)
                            if xt != Ty.Unit and not xt.is_error():
                                self.err(
                                    diag.error("E0301", "this function doesn't return a value")
                                    .label(x2.span, "unexpected return value")
                                    .with_help("add a return type to the signature, e.g. `-> int`")
                                )
                        else:
                            self.check_expr(ref x2, Some(rt))
                            self.expect_ty(rt, x2)
                        s.kind = StmtKind.Return(Some(x2))
                    case None:
                        if rt != Ty.Unit and not rt.is_error():
                            let t = self.tn(rt)
                            self.err(
                                diag.error(
                                    "E0301",
                                    f"this function must return a value of type {t}"
                                ).label(span, "missing value")
                            )
            case StmtKind.Break | StmtKind.Continue:
                var kw = "continue"
                if s.kind == StmtKind.Break:
                    kw = "break"
                if len(self.loops) == 0:
                    self.err(
                        diag.error(
                            "E0313",
                            f"`{kw}` outside of a loop"
                        ).label(span, "not inside a loop")
                    )
                elif self.loops[len(self.loops) - 1] and kw == "break":
                    self.err(
                        diag.error("E0505", "`break` is not allowed inside a `par for`")
                        .label(span, "parallel iterations can't stop each other")
                        .with_help(
                            "use `continue` to skip an iteration, or a sequential `for` loop"
                        )
                    )
            case StmtKind.Pass:
                pass
            case StmtKind.Assert(cond, msg):
                var cond2 = cond
                self.check_cond(ref cond2)
                var msg2 = msg
                match msg:
                    case Some(m):
                        var m2 = m
                        self.check_expr(ref m2, Some(Ty.Str))
                        self.expect_ty(Ty.Str, m2)
                        msg2 = Some(m2)
                    case None:
                        pass
                s.kind = StmtKind.Assert(cond2, msg2)
            case StmtKind.Prove(e):
                var e2 = e
                self.in_spec = true
                self.check_expr(ref e2, Some(Ty.Bool))
                self.expect_ty(Ty.Bool, e2)
                self.in_spec = false
                s.kind = StmtKind.Prove(e2)
            case StmtKind.Match(scrut, cases):
                var scrut2 = scrut
                var cases2 = cases
                let st = self.check_expr(ref scrut2, None)
                if st == Ty.Unit:
                    self.err(
                        diag.error(
                            "E0301",
                            "cannot `match` on `()`"
                        ).label(scrut2.span, "this expression doesn't produce a value")
                    )
                let before = self.error_count()
                for ci in 0..len(cases2):
                    self.scopes.push([])
                    self.check_pattern(ref cases2[ci].pat, st)
                    match cases2[ci].guard:
                        case Some(g):
                            var g2 = g
                            self.check_cond(ref g2)
                            cases2[ci].guard = Some(g2)
                        case None:
                            pass
                    self.check_block(ref cases2[ci].body)
                    self.scopes.pop()
                let pattern_errors = self.error_count() > before
                if not st.is_error() and st != Ty.Unit and not pattern_errors:
                    self.check_match_cases(scrut2, cases2, st)
                # `case A(c) | B(c):` runs as `case A(c):` and `case B(c):` with
                # the same body, so later passes never see names bound inside `|`
                var split: [Case] = []
                for c in cases2:
                    if binds_in_or(c.pat, false):
                        for q in or_split(c.pat):
                            var c2 = c
                            c2.pat = q
                            split.push(c2)
                    else:
                        split.push(c)
                s.kind = StmtKind.Match(scrut2, split)
            case StmtKind.Contract(_, _):
                pass

    fn not_orderable(ref self, t: Ty, span: Span, msg: str):
        var d = diag.error("E0305", msg).label(
            span,
            "only numbers, strings, enums without data, and tuples and structs of these support `<`"
        )
        match unordered_part(self.info, t):
            case Some((what, pt)):
                if pt != t:
                    d = d.note(f"{what} has type " + self.tn(pt))
            case None:
                pass
        self.err(d)

    fn error_count(self) -> int:
        var n = 0
        for d in self.diags:
            if d.is_error():
                n += 1
        return n

    # ============================================================ patterns
    fn pat_mismatch(ref self, ty: Ty, span: Span, what: str):
        if not ty.is_error():
            let tn = self.tn(ty)
            self.err(
                diag.error(
                    "E0301",
                    f"this pattern can't match a value of type {tn}"
                ).label(span, f"{what} pattern")
            )

    # Type-checks a pattern against the type of the value it matches and
    # declares the names it binds in the current scope.
    fn check_pattern(ref self, ref p: Pattern, ty: Ty):
        let span = p.span
        match p.kind:
            case PatKind.Wild:
                pass
            case PatKind.Bind(name):
                var gv = false
                match self.item(name):
                    case Some(Item.GenVariant(_, _)):
                        gv = self.lookup_local(name).is_none()
                    case _:
                        pass
                if gv:
                    # `case None:` names a prelude variant rather than capturing
                    p.kind = PatKind.Variant([name], None)
                    p.vres = None
                    p.fields = []
                    self.check_pattern(ref p, ty)
                    return
                match self.item(name):
                    case Some(Item.Const(id)):
                        if self.lookup_local(name).is_none():
                            self.const_pattern(ref p, name, id, ty)
                            return
                    case _:
                        pass
                match self.or_names:
                    case Some(names):
                        self.or_bind(ref p, name, names, ty)
                        return
                    case None:
                        pass
                p.local = self.declare(name, span, ty, LocalKind.Let)
            case PatKind.Int(v):
                match ty:
                    case Ty.Int(k):
                        if v < k.min() or v > k.max():
                            self.err(
                                diag.error(
                                    "E0315",
                                    f"`{v}` is out of range for `{k.name()}`"
                                ).label(span, "can never match")
                            )
                    case _:
                        self.pat_mismatch(ty, span, "an integer")
            case PatKind.Str(_):
                if ty != Ty.Str:
                    self.pat_mismatch(ty, span, "a string")
            case PatKind.Bool(_):
                if ty != Ty.Bool:
                    self.pat_mismatch(ty, span, "a bool")
            case PatKind.Tuple(ps):
                var ps2 = ps
                var ok = false
                match ty:
                    case Ty.Tuple(ts):
                        if len(ts) == len(ps):
                            ok = true
                            for i in 0..len(ps2):
                                self.check_pattern(ref ps2[i], ts[i])
                    case _:
                        pass
                if not ok:
                    self.pat_mismatch(ty, span, f"a {len(ps)}-element tuple")
                    for i in 0..len(ps2):
                        self.check_pattern(ref ps2[i], Ty.Error)
                p.kind = PatKind.Tuple(ps2)
            case PatKind.Or(alts):
                var alts2 = alts
                self.check_or_pattern(ref alts2, ty)
                p.kind = PatKind.Or(alts2)
            case PatKind.Variant(path, args):
                match self.resolve_variant_path(path, span, ty):
                    case None:
                        match args:
                            case Some(list):
                                var l2 = list
                                for i in 0..len(l2):
                                    self.check_pattern(ref l2[i].1, Ty.Error)
                                p.kind = PatKind.Variant(path, Some(l2))
                            case None:
                                pass
                        return
                    case Some((eid, vi)):
                        self.check_variant_pattern(ref p, path, args, eid, vi, ty)

    # `case LIMIT:` compares with the constant, like the literal it stands for.
    fn const_pattern(ref self, ref p: Pattern, name: str, id: int, ty: Ty):
        let c = self.info.consts[id]
        var kind: Option[PatKind] = None
        match c.value:
            case ConstVal.Int(v):
                if c.ty.is_int():
                    kind = Some(PatKind.Int(v))
            case ConstVal.Bool(b):
                kind = Some(PatKind.Bool(b))
            case ConstVal.Str(v):
                kind = Some(PatKind.Str(v))
            case _:
                pass
        if c.ty.is_error():
            return
        let ctn = self.tn(c.ty)
        match kind:
            case Some(k):
                if not ty.is_error() and c.ty != ty:
                    let tn = self.tn(ty)
                    self.err(
                        diag.error(
                            "E0301",
                            f"constant `{name}` has type {ctn}, but the value matched has type {tn}"
                        ).label(p.span, f"has type {ctn}")
                    )
                    return
                p.kind = k
                self.check_pattern(ref p, ty)
            case None:
                self.err(
                    diag.error(
                        "E0322",
                        f"constant `{name}` has type {ctn}, which can't be a pattern"
                    )
                    .label(p.span, "only integer, string and bool constants can")
                    .with_help(f"compare with a guard: `case x if x == {name}:`")
                )

    # `A(c) | B(c)`: every alternative binds the same names with the same
    # types. The first alternative declares them and the others reuse them.
    fn check_or_pattern(ref self, ref alts: [Pattern], ty: Ty):
        match self.or_names:
            case Some(_):
                # inside a later alternative of an outer `|`
                let outer = self.or_seen
                var first: [str] = []
                for i in 0..len(alts):
                    self.or_seen = []
                    self.check_pattern(ref alts[i], ty)
                    if i == 0:
                        first = self.or_seen
                    else:
                        self.same_names(first, self.or_seen, alts[i].span)
                self.or_seen = outer
                self.or_seen.extend(first)
                return
            case None:
                pass
        let n0 = len(self.locals)
        self.check_pattern(ref alts[0], ty)
        var names: {str: int} = {}
        var first: [str] = []
        for id in n0..len(self.locals):
            let n = self.locals[id].name
            if n != "_" and n not in names:
                names[n] = id
                first.push(n)
        for i in 1..len(alts):
            self.or_names = Some(names)
            self.or_seen = []
            self.check_pattern(ref alts[i], ty)
            let seen = self.or_seen
            self.or_names = None
            self.or_seen = []
            self.same_names(first, seen, alts[i].span)

    # A name in a later alternative of `|`: the first alternative's variable.
    fn or_bind(ref self, ref p: Pattern, name: str, names: {str: int}, ty: Ty):
        match names.get(name):
            case Some(id):
                p.local = id
                if name in self.or_seen:
                    self.err(
                        diag.error("E0207", f"`{name}` is bound twice in this pattern")
                        .label(p.span, "bound again here")
                        .with_help("use a different name, or `_` to ignore a value")
                    )
                    return
                self.or_seen.push(name)
                let t0 = self.locals[id].ty
                if not t0.is_error() and not ty.is_error() and t0 != ty:
                    let tn = self.tn(ty)
                    let tn0 = self.tn(t0)
                    self.err(
                        diag.error(
                            "E0321",
                            f"`{name}` has type {tn} here but {tn0} in the first alternative"
                        )
                        .label(p.span, f"has type {tn}")
                        .label(self.locals[id].span, f"has type {tn0}")
                        .with_help("write a separate `case` for each alternative")
                    )
            case None:
                self.err(
                    diag.error("E0321", f"`{name}` is bound here but not in the first alternative")
                    .label(p.span, "only bound in this alternative")
                    .with_help(
                        "every alternative of `|` must bind the same names; use `_` for values you don't need"
                    )
                )
                if self.lookup_local(name).is_none():
                    p.local = self.declare(name, p.span, ty, LocalKind.Let)

    fn same_names(ref self, first: [str], seen: [str], span: Span):
        for n in first:
            if n not in seen:
                self.err(
                    diag.error("E0321", f"`{n}` must be bound in every alternative of `|`")
                    .label(span, f"doesn't bind `{n}`")
                    .with_help(
                        "bind the same names in each alternative, or write a separate `case` for each"
                    )
                )
        for n in seen:
            if n not in first:
                self.err(
                    diag.error("E0321", f"`{n}` is bound here but not in the first alternative")
                    .label(span, f"binds `{n}`")
                    .with_help(
                        "every alternative of `|` must bind the same names; use `_` for values you don't need"
                    )
                )

    fn check_variant_pattern(
        ref self,
        ref p: Pattern,
        path: [str],
        args: Option[[(Option[(str, Span)], Pattern)]],
        eid: int,
        vi: int,
        ty: Ty
    ):
        let span = p.span
        let en = self.info.enums[eid]
        let v = en.variants[vi]
        if not ty.is_error() and ty != Ty.Enum(eid):
            let tn = self.tn(ty)
            self.err(
                diag.error(
                    "E0301",
                    f"`{en.variant_label(vi)}` can't match a value of type {tn}"
                ).label(span, f"this is a `{self.info.enum_names[eid]}` pattern")
            )
        p.vres = Some((eid, vi))
        var out: [Pattern] = []
        for _ in v.fields:
            out.push(pattern(PatKind.Wild, span))
        let fnames = ", ".join([f.0 for f in v.fields])
        match args:
            case None:
                if len(v.fields) > 0:
                    self.err(
                        diag.error("E0302", f"`{en.name}.{v.name}` has fields")
                        .label(span, "add a pattern for each field")
                        .with_help(
                            f"write `{en.name}.{v.name}({fnames})`, or `{en.name}.{v.name}()` to ignore the fields"
                        )
                        .fix(
                            Span(file=span.file, lo=span.hi, hi=span.hi),
                            "()",
                            "ignore the fields"
                        )
                    )
            case Some(list):
                if len(v.fields) == 0 and len(list) > 0:
                    self.err(
                        diag.error(
                            "E0302",
                            f"`{en.name}.{v.name}` has no fields"
                        ).label(span, f"write `{en.name}.{v.name}`")
                    )
                var positional = 0
                for k, _ in list:
                    if k.is_none():
                        positional += 1
                let keyword = len(list) - positional
                if (
                    keyword == 0
                    and positional != 0
                    and positional != len(v.fields)
                    and len(v.fields) > 0
                ):
                    let nf = len(v.fields)
                    self.err(
                        diag.error(
                            "E0302",
                            f"`{en.name}.{v.name}` has {nf} field{plural(nf)} but the pattern has {positional}"
                        )
                        .label(span, "wrong number of fields")
                        .note(f"fields: {fnames}")
                        .with_help(
                            "use `_` for fields you don't need, or name the ones you want: `field=pattern`"
                        )
                    )
                var seen_kw = false
                var given: [bool] = [false] * len(v.fields)
                for i, item in enumerate(list):
                    let kw = item.0
                    var q = item.1
                    var idx = -1
                    match kw:
                        case None:
                            if seen_kw:
                                self.err(
                                    diag.error(
                                        "E0302",
                                        "positional patterns must come before `field=pattern`"
                                    ).label(q.span, "positional after keyword")
                                )
                            idx = i
                        case Some((n, nsp)):
                            seen_kw = true
                            for k, f in enumerate(v.fields):
                                if f.0 == n:
                                    idx = k
                                    break
                            if idx < 0:
                                var d = diag.error(
                                    "E0205",
                                    f"`{en.name}.{v.name}` has no field `{n}`"
                                ).label(nsp, "unknown field")
                                match best_match(n, [f.0 for f in v.fields]):
                                    case Some(b):
                                        d = d.with_help(
                                            f"did you mean `{b}`?"
                                        ).fix(nsp, b, "replace")
                                    case None:
                                        pass
                                self.err(d)
                    if idx >= 0 and idx < len(v.fields):
                        if given[idx]:
                            self.err(
                                diag.error(
                                    "E0302",
                                    f"field `{v.fields[idx].0}` matched twice"
                                ).label(q.span, "duplicate")
                            )
                        given[idx] = true
                        self.check_pattern(ref q, v.fields[idx].1)
                        out[idx] = q
                    else:
                        self.check_pattern(ref q, Ty.Error)
                p.kind = PatKind.Variant(path, Some([]))
        p.fields = out

    # Resolves `Enum.Variant` or `module.Enum.Variant` in a pattern matching a `ty`.
    fn resolve_variant_path(ref self, path: [str], span: Span, ty: Ty) -> Option[(int, int)]:
        let tpath = path[:len(path) - 1]
        let vname = path[len(path) - 1]
        let pname = ".".join(path)
        var item: Option[Item] = None
        if len(tpath) == 0:
            match self.item(vname):
                # `Some(x)`: a prelude variant
                case Some(Item.GenVariant(tid, _)):
                    item = Some(Item.GenType(tid))
                case _:
                    pass
        elif len(tpath) <= 2:
            item = self.item_at(self.cur_mod, tpath)
        var generic = false
        var eid = -1
        match item:
            case Some(Item.Enum(e)):
                eid = e
            case Some(Item.GenType(tid)):
                generic = true
                if self.gtypes[tid].edecl.is_some():
                    match self.enum_instance(tid, ty):
                        case Some(e):
                            eid = e
                        case None:
                            if not ty.is_error():
                                let tn = self.tn(ty)
                                let gname = self.gtypes[tid].name
                                self.err(
                                    diag.error(
                                        "E0301",
                                        f"`{pname}` can't match a value of type {tn}"
                                    ).label(span, f"this is a `{gname}` pattern")
                                )
                            return None
            case _:
                pass
        if eid < 0:
            var d = diag.error(
                "E0201",
                f"`{pname}` is not an enum variant"
            ).label(span, "unknown variant")
            if len(tpath) == 0:
                # `case Circle(r)`: find the enum it belongs to
                var found: [str] = []
                for it in self.items[self.cur_mod].values():
                    match it:
                        case Item.Enum(e):
                            if any(x.name == vname for x in self.info.enums[e].variants):
                                found.push(self.info.enums[e].name + "." + vname)
                        case _:
                            pass
                if len(found) > 0:
                    d = d.with_help(f"variants are written with their enum: `{found[0]}`")
                else:
                    d = d.with_help(
                        "patterns name variants with their enum, e.g. `Shape.Circle(r)`; a plain name like `x` captures the value"
                    )
            else:
                var is_struct = false
                match item:
                    case Some(Item.Struct(_)):
                        is_struct = true
                    case _:
                        pass
                if is_struct or generic:
                    d = d.with_help(
                        "struct patterns are not supported yet; bind the value with a name and read its fields"
                    )
            self.err(d)
            return None
        let en = self.info.enums[eid]
        for vi, v in enumerate(en.variants):
            if v.name == vname:
                return Some((eid, vi))
        let cands = [v.name for v in en.variants]
        var d = diag.error(
            "E0201",
            f"enum `{en.name}` has no variant `{vname}`"
        ).label(span, "unknown variant")
        match best_match(vname, cands):
            case Some(b):
                d = d.with_help(f"did you mean `{en.name}.{b}`?")
            case None:
                d = d.note("variants: " + ", ".join(cands))
        self.err(d)
        return None

    # Exhaustiveness: every possible value must be handled by some case.
    fn check_match_cases(ref self, scrut: Expr, cases: [Case], ty: Ty):
        var rows: [[Pattern]] = []
        for c in cases:
            if any(is_catch_all(r[0]) for r in rows):
                self.err(
                    diag.warning("W0002", "this case can never be reached")
                    .label(c.span, "unreachable")
                    .with_help("an earlier `case` already matches every value")
                )
                break
            if c.guard.is_none():
                rows.push([c.pat])
        match self.missing(rows, [ty]):
            case Some(ws):
                var w = ""
                if len(ws) > 0:
                    w = ws[0]
                var d = diag.error(
                    "E0320",
                    "this `match` doesn't handle every possible value"
                ).label(scrut.span, "of type " + self.tn(ty))
                if w == "_":
                    d = d.with_help("add a catch-all `case _:` at the end")
                else:
                    d = d.note(
                        f"not handled: `{w}`"
                    ).with_help(f"add `case {w}:`, or a catch-all `case _:`")
                if any(c.guard.is_some() for c in cases):
                    d = d.note("cases with an `if` guard don't count, since the guard may be false")
                self.err(d)
            case None:
                pass

    # Returns an example of values (one per column) that no row matches.
    fn missing(self, rows: [[Pattern]], tys: [Ty]) -> Option[[str]]:
        if len(tys) == 0:
            if len(rows) == 0:
                return Some([])
            return None
        # flatten `|` in the first column
        var exp: [[Pattern]] = []
        for r in rows:
            push_alts(r[0], r[1:], ref exp)
        let rest = tys[1:]
        if len(exp) == 0:
            return Some(["_"] * len(tys))
        # no patterns look inside this column: only the remaining columns matter
        # (this also stops the expansion of recursive types)
        var ty0 = tys[0]
        if all(is_catch_all(r[0]) for r in exp):
            ty0 = Ty.Error
        let wild = pattern(PatKind.Wild, Span(file=0, lo=0, hi=0))
        match ty0:
            case Ty.Enum(eid):
                let en = self.info.enums[eid]
                for vi, v in enumerate(en.variants):
                    let n = len(v.fields)
                    var sub: [[Pattern]] = []
                    for r in exp:
                        match r[0].kind:
                            case PatKind.Wild | PatKind.Bind(_):
                                var nr = [wild] * n
                                nr.extend(r[1:])
                                sub.push(nr)
                            case PatKind.Variant(_, _):
                                match r[0].vres:
                                    case Some((_, x)):
                                        if x == vi and len(r[0].fields) == n:
                                            var nr = r[0].fields
                                            nr.extend(r[1:])
                                            sub.push(nr)
                                    case None:
                                        pass
                            case _:
                                pass
                    var ftys = [f.1 for f in v.fields]
                    ftys.extend(rest)
                    match self.missing(sub, ftys):
                        case Some(w):
                            let a = w[:n]
                            var head = en.variant_label(vi)
                            if n > 0:
                                head = head + "(" + ", ".join(a) + ")"
                            var out = [head]
                            out.extend(w[n:])
                            return Some(out)
                        case None:
                            pass
                return None
            case Ty.Bool:
                for b in [true, false]:
                    var sub: [[Pattern]] = []
                    for r in exp:
                        var take = false
                        match r[0].kind:
                            case PatKind.Wild | PatKind.Bind(_):
                                take = true
                            case PatKind.Bool(x):
                                take = x == b
                            case _:
                                pass
                        if take:
                            sub.push(r[1:])
                    match self.missing(sub, rest):
                        case Some(w):
                            var out = ["true" if b else "false"]
                            out.extend(w)
                            return Some(out)
                        case None:
                            pass
                return None
            case Ty.Tuple(ts):
                let n = len(ts)
                var sub: [[Pattern]] = []
                for r in exp:
                    match r[0].kind:
                        case PatKind.Wild | PatKind.Bind(_):
                            var nr = [wild] * n
                            nr.extend(r[1:])
                            sub.push(nr)
                        case PatKind.Tuple(ps):
                            if len(ps) == n:
                                var nr = ps
                                nr.extend(r[1:])
                                sub.push(nr)
                        case _:
                            pass
                var ftys = ts
                ftys.extend(rest)
                let w = self.missing(sub, ftys)?
                var out = ["(" + ", ".join(w[:n]) + ")"]
                out.extend(w[n:])
                return Some(out)
            case _:
                # infinitely many values: only catch-alls cover the rest
                var sub: [[Pattern]] = []
                for r in exp:
                    if is_catch_all(r[0]):
                        sub.push(r[1:])
                let w = self.missing(sub, rest)?
                var out = ["_"]
                out.extend(w)
                return Some(out)

    fn check_cond(ref self, ref c: Expr):
        let t = self.check_expr(ref c, Some(Ty.Bool))
        if not t.is_error() and t != Ty.Bool:
            var d = diag.error(
                "E0307",
                "condition must be a `bool`, found " + self.tn(t)
            ).label(c.span, "not a bool")
            if t.is_numeric():
                d = d.with_help("compare explicitly, e.g. `x != 0`")
            else:
                match t:
                    case Ty.Array(_) | Ty.Str:
                        d = d.with_help("check the length explicitly, e.g. `len(xs) > 0`")
                    case _:
                        pass
            self.err(d)

    fn is_range_call(self, e: Expr) -> bool:
        match e.kind:
            case ExprKind.Call(callee, _):
                match callee.kind:
                    case ExprKind.Ident(name):
                        return (
                            name == "range"
                            and self.lookup_local("range").is_none()
                            and not self.has_item("range")
                        )
                    case _:
                        return false
            case _:
                return false

    # The element type of a loop's iterable; `want` is the loop variable's written type.
    fn check_iter(ref self, ref e: Expr, want0: Option[Ty]) -> Ty:
        var want: Option[Ty] = None
        match want0:
            case Some(t):
                if t.is_int():
                    want = Some(t)
            case None:
                pass
        match e.kind:
            case ExprKind.Range(lo, hi, inclusive):
                var lo2 = lo
                var hi2 = hi
                var lt = self.check_expr(ref lo2, want)
                let ht = self.check_expr(ref hi2, Some(lt))
                if lo2.is_literal() and not hi2.is_literal() and ht.is_int() and lt != ht:
                    lt = self.check_expr(ref lo2, Some(ht))
                e.kind = ExprKind.Range(lo2, hi2, inclusive)
                e.ty = Ty.Range
                if lt.is_error() or ht.is_error():
                    return int_ty()
                if not lt.is_int() or lt != ht:
                    let a = self.tn(lt)
                    let b = self.tn(ht)
                    self.err(
                        diag.error(
                            "E0301",
                            f"range bounds must be integers of the same type, found {a} and {b}"
                        ).label(e.span, "invalid range")
                    )
                    return int_ty()
                return lt
            case ExprKind.Call(callee, args):
                if self.is_range_call(e):
                    e.cres = CallRes.Range
                    e.ty = Ty.Range
                    if len(args) == 0 or len(args) > 3:
                        self.err(
                            diag.error(
                                "E0302",
                                "`range` takes 1 to 3 arguments: range(end), range(start, end) or range(start, end, step)"
                            ).label(e.span, "wrong number of arguments")
                        )
                        return int_ty()
                    var args2 = args
                    var t = int_ty()
                    match want:
                        case Some(w):
                            t = w
                        case None:
                            pass
                    for i in 0..len(args2):
                        if not args2[i].expr.is_literal():
                            t = self.check_expr(ref args2[i].expr, None)
                            break
                    for i in 0..len(args2):
                        let at = self.check_expr(ref args2[i].expr, Some(t))
                        if not at.is_error() and (not at.is_int() or at != t):
                            self.err(
                                diag.error(
                                    "E0301",
                                    "range arguments must be integers of the same type"
                                ).label(args2[i].expr.span, "has type " + self.tn(at))
                            )
                    e.kind = ExprKind.Call(callee, args2)
                    if t.is_error():
                        return int_ty()
                    return t
            case _:
                pass
        let t = self.check_expr(ref e, None)
        match t:
            case Ty.Array(el):
                return el
            case Ty.Map(k, _):
                return k
            case Ty.Error:
                return Ty.Error
            # each UTF-8 character, as a string
            case Ty.Str:
                return Ty.Str
            case _:
                let tn = self.tn(t)
                self.err(
                    diag.error("E0314", f"cannot iterate over a value of type {tn}")
                    .label(e.span, "not iterable")
                    .with_help("loop over a range like `0..n` or an array")
                )
                return Ty.Error

    # Validates that `e` can be mutated: it must be a place rooted at a mutable
    # local, and must respect the race-freedom rules inside `par` bodies.
    fn check_mutation_target(ref self, e: Expr, what: str) -> Option[int]:
        match e.kind:
            case ExprKind.Index(base, _):
                if base.ty == Ty.Str:
                    self.err(
                        diag.error("E0404", f"cannot {what} a character of a string")
                        .label(e.span, "strings can't be changed in place")
                        .with_help("build a new string, e.g. `s = s[:i] + \"x\" + s[i + 1:]`")
                    )
                    return None
            case _:
                pass
        var root = -1
        match lvalue_root(e):
            case Some(r):
                root = r
            case None:
                match const_root(e):
                    case Some(id):
                        let n = self.info.consts[id].name
                        self.err(
                            diag.error("E0401", f"cannot {what} constant `{n}`")
                            .label(e.span, "constants never change")
                            .with_help(f"copy it into a variable first: `var t = {n}`")
                        )
                        return None
                    case None:
                        pass
                if not e.ty.is_error():
                    self.err(
                        diag.error(
                            "E0404",
                            f"cannot {what} this expression"
                        ).label(e.span, "not a variable, field or array element")
                    )
                return None
        let info = self.locals[root]
        match info.kind:
            case LocalKind.Var | LocalKind.RefParam:
                pass
            case LocalKind.Let:
                self.err(
                    diag.error(
                        "E0401",
                        f"cannot {what} `{info.name}` because it was declared with `let`"
                    )
                    .label(e.span, "immutable")
                    .label(info.span, "declared here")
                    .with_help(f"declare it with `var {info.name} = ...` to make it mutable")
                )
                return None
            case LocalKind.Param:
                self.err(
                    diag.error("E0403", f"cannot {what} parameter `{info.name}`")
                    .label(e.span, "parameters are read-only")
                    .label(info.span, "declared here")
                    .with_help(
                        f"to change a local copy, declare it `mut {info.name}: ...`; to change the caller's variable, declare it `ref {info.name}: ...` and call with `ref`"
                    )
                )
                return None
            case LocalKind.ForVar | LocalKind.ForElem | LocalKind.Result:
                self.err(
                    diag.error(
                        "E0401",
                        f"cannot {what} loop variable `{info.name}`"
                    ).label(e.span, "loop variables are read-only")
                )
                return None
        if info.par_level < self.cur_level():
            var ok = false
            let top = len(self.par_stack) - 1
            if top >= 0:
                let cx = self.par_stack[top]
                if cx.is_for and info.par_level + 1 == cx.level:
                    # `xs[i]` only: map entries aren't separate memory
                    match root_step(e):
                        case Some(st):
                            match st.kind:
                                case ExprKind.Index(base, idx):
                                    match base.ty:
                                        case Ty.Array(_):
                                            match idx.kind:
                                                case ExprKind.Ident(_):
                                                    match idx.res:
                                                        case Res.Local(l):
                                                            ok = cx.loop_var == Some(l)
                                                        case _:
                                                            pass
                                                case _:
                                                    pass
                                        case _:
                                            pass
                                case _:
                                    pass
                        case None:
                            pass
            if ok:
                if root not in self.par_stack[top].writes:
                    self.par_stack[top].writes.push(root)
            else:
                var lv = "i"
                if top >= 0:
                    match self.par_stack[top].loop_var:
                        case Some(l):
                            lv = self.locals[l].name
                        case None:
                            pass
                var on_map = false
                match root_step(e):
                    case Some(st):
                        match st.kind:
                            case ExprKind.Index(base, _):
                                match base.ty:
                                    case Ty.Map(_, _):
                                        on_map = true
                                    case _:
                                        pass
                            case _:
                                pass
                    case None:
                        pass
                var help = f"a `par for` may only write `{info.name}[{lv}]` (its own element); to combine values use `par sum(...)`, `par [...]`, or a sequential loop"
                if on_map:
                    help = "maps can't be changed inside `par`; compute the values with `par [...]`, then fill the map in a sequential loop"
                self.err(
                    diag.error("E0501", f"cannot {what} `{info.name}` inside a `par` body")
                    .label(e.span, "would be a data race")
                    .note(f"`{info.name}` is shared by all parallel iterations")
                    .with_help(help)
                )
                return None
        return Some(root)

    # ============================================================ expressions
    fn check_expr(ref self, ref e: Expr, exp: Option[Ty]) -> Ty:
        let allow_gen = self.allow_gen
        self.allow_gen = false
        let t = self.expr_inner(ref e, exp, allow_gen)
        e.ty = t
        return t

    # Checks an argument against its parameter type. Arguments of generic calls
    # were already checked while inferring the type arguments.
    fn check_arg(ref self, ref e: Expr, t: Ty):
        if e.ty == Ty.Unknown:
            self.check_expr(ref e, Some(t))
        self.expect_ty(t, e)

    fn check_key_type(ref self, k: Ty, span: Span):
        self.key_checks.push((k, span))

    # Can values of `t` be map keys? (`==` must be total, so no floats.)
    fn hashable(self, t: Ty, ref seen: [Ty]) -> bool:
        if t in seen:
            return true
        match t:
            case Ty.Int(_) | Ty.Bool | Ty.Str:
                return true
            case Ty.Array(e):
                return self.hashable(e, ref seen)
            case Ty.Tuple(ts):
                for x in ts:
                    if not self.hashable(x, ref seen):
                        return false
                return true
            case Ty.Struct(sid):
                seen.push(t)
                for f in self.info.structs[sid].fields:
                    if not self.hashable(f.1, ref seen):
                        return false
                return true
            case Ty.Enum(eid):
                seen.push(t)
                for v in self.info.enums[eid].variants:
                    for f in v.fields:
                        if not self.hashable(f.1, ref seen):
                            return false
                return true
            case Ty.Error | Ty.Unknown:
                return true
            case _:
                return false

    # Checks `xs` against one shared type (array elements, map keys or values).
    # Literals adapt to the first non-literal's type.
    fn check_same(ref self, ref xs: [Expr], guide0: Option[Ty], what: str) -> Ty:
        var guide = guide0
        var tys: [Ty] = []
        for i in 0..len(xs):
            let t = self.check_expr(ref xs[i], guide)
            if guide.is_none() and not xs[i].is_literal():
                guide = Some(t)
            tys.push(t)
        match guide:
            case Some(g):
                for i in 0..len(xs):
                    if xs[i].is_literal() and tys[i] != g:
                        tys[i] = self.check_expr(ref xs[i], Some(g))
            case None:
                pass
        var t0 = tys[0]
        match guide:
            case Some(g):
                t0 = g
            case None:
                pass
        for i in 0..len(xs):
            if not compatible(t0, tys[i]):
                let a = self.tn(t0)
                let b = self.tn(tys[i])
                self.err(
                    diag.error(
                        "E0301",
                        f"{what} must all have the same type"
                    ).label(xs[i].span, f"expected {a}, found {b}")
                )
        return t0

    fn prelude_item(self, name: str) -> Option[Item]:
        for i, n in enumerate(self.info.module_names):
            if n == PRELUDE:
                return self.items[i].get(name)
        return None

    # `Option[t]` from the prelude.
    fn option_of(ref self, t: Ty, span: Span) -> Ty:
        match self.prelude_item("Option"):
            case Some(Item.GenType(tid)):
                return self.inst_type(tid, [t], span)
            case _:
                return Ty.Error

    # `x?`: the value inside an `Option`/`Result`, returning early with `None`/`Err`.
    fn check_try(ref self, t: Ty, span: Span) -> Ty:
        if t.is_error():
            return Ty.Error
        if self.in_spec:
            self.spec_err(span)
        if self.no_try > 0 or len(self.par_stack) > 0:
            self.err(
                diag.error("E0342", "`?` can't be used inside a comprehension or `par` body")
                .label(span, "can't return from the function here")
                .with_help("write a `for` loop, or handle the value with `match`")
            )
        var k = TryKind.Opt(0, 0, Ty.Error)
        match try_kind(self.info, t):
            case Some(x):
                k = x
            case None:
                self.err(
                    diag.error("E0340", "`?` needs an `Option` or `Result`, found " + self.tn(t))
                    .label(span, "not an `Option` or `Result`")
                    .with_help(
                        "`x?` gives the value inside `Some`/`Ok`, or returns `None`/`Err` from the function"
                    )
                )
                return Ty.Error
        let rt = self.ret_ty
        var fits = false
        match (k, try_kind(self.info, rt)):
            case (TryKind.Opt(_, _, _), Some(TryKind.Opt(_, _, _))):
                fits = true
            case (TryKind.Res(_, _, _, err), Some(TryKind.Res(_, _, _, rerr))):
                fits = true
                if not compatible(rerr, err):
                    self.err(
                        diag.error(
                            "E0341",
                            "`?` would return a "
                            + self.tn(err)
                            + " error from a function whose errors are "
                            + self.tn(rerr)
                        )
                        .label(span, "the error here is " + self.tn(err))
                        .with_help(
                            "convert it with `match`, or make the function's error type match"
                        )
                    )
            case _:
                pass
        if not fits and not rt.is_error():
            var want = "Option[...]"
            match k:
                case TryKind.Res(_, _, _, err):
                    want = "Result[..., " + self.info.ty_name(err) + "]"
                case _:
                    pass
            self.err(
                diag.error("E0341", f"`?` needs the function to return {want}")
                .label(span, "this returns from a function that returns " + self.tn(rt))
                .with_help(f"change the return type to `{want}`, or handle the value with `match`")
            )
        match k:
            case TryKind.Opt(_, _, inner):
                return inner
            case TryKind.Res(_, _, ok, _):
                return ok

    fn result_of(ref self, t: Ty, e: Ty, span: Span) -> Ty:
        match self.prelude_item("Result"):
            case Some(Item.GenType(tid)):
                return self.inst_type(tid, [t, e], span)
            case _:
                return Ty.Error

    # Check that a builtin got `len(tys)` arguments of exactly these types.
    fn builtin_args(ref self, name: str, ref args: [Arg], tys: [Ty], span: Span):
        if self.nargs(name, ref args, len(tys), span):
            for i in 0..len(args):
                self.check_expr(ref args[i].expr, Some(tys[i]))
                self.expect_ty(tys[i], args[i].expr)

    fn key_arg(ref self, ref args: [Arg], k: Ty):
        self.check_expr(ref args[0].expr, Some(k))
        self.expect_ty(k, args[0].expr)

    fn map_method(
        ref self,
        recv: Expr,
        k: Ty,
        v: Ty,
        name: str,
        name_span: Span,
        ref args: [Arg],
        ref res: CallRes,
        span: Span
    ) -> Ty:
        if self.in_spec:
            self.spec_err(span)
        match name:
            case "get":
                res = CallRes.Builtin(Builtin.Get)
                if len(args) == 2:
                    self.key_arg(ref args, k)
                    self.check_expr(ref args[1].expr, Some(v))
                    self.expect_ty(v, args[1].expr)
                    return v
                if self.nargs("get", ref args, 1, span):
                    self.key_arg(ref args, k)
                return self.option_of(v, span)
            case "remove":
                res = CallRes.Builtin(Builtin.Remove)
                self.check_mutation_target(recv, "remove from")
                if self.nargs("remove", ref args, 1, span):
                    self.key_arg(ref args, k)
                return Ty.Bool
            case "keys":
                res = CallRes.Builtin(Builtin.Keys)
                self.nargs(name, ref args, 0, span)
                return Ty.Array(k)
            case "values":
                res = CallRes.Builtin(Builtin.Values)
                self.nargs(name, ref args, 0, span)
                return Ty.Array(v)
            case "items":
                res = CallRes.Builtin(Builtin.Items)
                self.nargs(name, ref args, 0, span)
                return Ty.Array(Ty.Tuple([k, v]))
            case _:
                var d = diag.error(
                    "E0206",
                    f"maps have no method `{name}`"
                ).label(name_span, "unknown method")
                match name:
                    case "contains" | "contains_key" | "has_key" | "has":
                        d = d.with_help("use `k in m`")
                    case "insert" | "set" | "put" | "add":
                        d = d.with_help("use `m[k] = v`")
                    case "delete" | "erase" | "pop" | "del":
                        d = d.with_help(
                            "use `m.remove(k)`"
                        ).fix(name_span, "remove", "replace with `remove`")
                    case "len" | "length" | "size" | "count":
                        d = d.with_help("use `len(m)`")
                    case _:
                        d = d.note(
                            "map methods: get(k), get(k, default), remove(k), keys(), values(), items()"
                        )
                self.err(d)
                for i in 0..len(args):
                    self.check_expr(ref args[i].expr, None)
                return Ty.Error

    fn expect_ty(ref self, expected: Ty, e: Expr):
        if compatible(expected, e.ty):
            return
        let et = self.tn(expected)
        let ft = self.tn(e.ty)
        var d = diag.error("E0301", "mismatched types").label(e.span, f"expected {et}, found {ft}")
        if expected.is_float() and e.ty.is_int():
            d = d.with_help("convert explicitly with `float(...)`")
        elif expected.is_int() and e.ty.is_float():
            d = d.with_help("convert explicitly with `int(...)` (truncates toward zero)")
        elif expected.is_int() and e.ty.is_int():
            var how = "checked at runtime"
            match (expected, e.ty):
                case (Ty.Int(to), Ty.Int(from)):
                    if to.min() <= from.min() and from.umax() <= to.umax():
                        how = "always fits"
                case _:
                    pass
            d = d.with_help(
                "convert explicitly with `" + self.info.ty_name(expected) + f"(...)` ({how})"
            )
        elif expected == Ty.Str:
            d = d.with_help("convert with `str(...)` or use an f-string like f\"{x}\"")
        self.err(d)

    fn expr_inner(ref self, ref e: Expr, exp: Option[Ty], allow_gen: bool) -> Ty:
        # a name unpacked by a comprehension is a field of its hidden loop variable
        match e.kind:
            case ExprKind.Ident(name):
                match self.lookup_path(name):
                    case Some(k):
                        let (root, fields, _) = self.ref_paths[k]
                        var base = mk(ExprKind.Ident(root), e.span)
                        for i in 0..len(fields) - 1:
                            base = mk(ExprKind.Field(base, fields[i], e.span), e.span)
                        e.kind = ExprKind.Field(base, fields[len(fields) - 1], e.span)
                        e.idx = 0
                        e.res = Res.Unresolved
                        return self.expr_inner(ref e, exp, allow_gen)
                    case None:
                        pass
                var ui = len(self.unpacks) - 1
                while ui >= 0:
                    let u = self.unpacks[ui]
                    if u.0 == name:
                        let base = mk(ExprKind.Ident(u.1), e.span)
                        e.kind = ExprKind.Field(base, f"{u.2}", e.span)
                        e.idx = 0
                        e.res = Res.Unresolved
                        return self.expr_inner(ref e, exp, allow_gen)
                    ui -= 1
            case _:
                pass
        let span = e.span
        # literal adaptation
        match e.kind:
            case ExprKind.Int(v):
                match exp:
                    case Some(Ty.Int(k)):
                        if v < k.min() or v > k.max():
                            self.err(
                                diag.error(
                                    "E0315",
                                    f"literal `{v}` is out of range for `{k.name()}`"
                                ).label(span, f"`{k.name()}` holds {k.min()}..={k.umax()}")
                            )
                        return Ty.Int(k)
                    case Some(Ty.Float(f)):
                        e.kind = ExprKind.Float(float(v))
                        return Ty.Float(f)
                    case _:
                        if v > IntTy.I64.max() or v < IntTy.I64.min():
                            var help = "annotate the type as `i128` or `u128` if you need values this large"
                            if v <= IntTy.U64.max() and v >= 0:
                                help = "annotate the type as `u64` (or `i128`) if you need values this large"
                            self.err(
                                diag.error("E0315", "literal is too large for `int`")
                                .label(span, "exceeds 9223372036854775807")
                                .with_help(help)
                            )
                        return int_ty()
            case ExprKind.UInt(v):
                if exp == Some(Ty.Int(IntTy.U128)):
                    return Ty.Int(IntTy.U128)
                var what = "`int`"
                match exp:
                    case Some(t):
                        what = "`" + self.tn(t) + "`"
                    case None:
                        pass
                self.err(
                    diag.error("E0315", f"literal is too large for {what}")
                    .label(span, f"only a `u128` holds {v}")
                    .with_help("annotate the type as `u128`")
                )
                return Ty.Error
            case ExprKind.Unary(op, inner):
                if op == UnOp.Neg:
                    match inner.kind:
                        case ExprKind.Int(v):
                            e.kind = ExprKind.Int(-v)
                            return self.expr_inner(ref e, exp, false)
                        case ExprKind.Float(v):
                            e.kind = ExprKind.Float(-v)
                            return self.expr_inner(ref e, exp, false)
                        case _:
                            pass
            case ExprKind.Binary(op, l, r):
                if op == BinOp.Mul:
                    match l.kind:
                        case ExprKind.Array(xs):
                            if len(xs) == 1:
                                e.kind = ExprKind.Repeat(xs[0], r)
                                return self.expr_inner(ref e, exp, false)
                        case _:
                            pass
            case ExprKind.Call(callee, args):
                # desugar reducer over array: sum(xs) => sum(__it for __it in xs)
                match callee.kind:
                    case ExprKind.Ident(name):
                        var is_comp = false
                        if len(args) == 1:
                            match args[0].expr.kind:
                                case ExprKind.Comp(_):
                                    is_comp = true
                                case _:
                                    pass
                        if (
                            reducer_by_name(name).is_some()
                            and len(args) == 1
                            and not is_comp
                            and self.lookup_local(name).is_none()
                            and not self.has_item(name)
                        ):
                            self.gensym += 1
                            let vname = f"__it{self.gensym}"
                            let a = args[0]
                            let sp = a.expr.span
                            let body = mk(ExprKind.Ident(vname), sp)
                            let comp = Comp(
                                kind=CompKind.Gen,
                                body=body,
                                name=vname,
                                name_span=sp,
                                unpack=[],
                                iter=a.expr,
                                filter=None,
                                par=false
                            )
                            e.kind = ExprKind.Call(
                                callee,
                                [Arg(by_ref=false, name=None, expr=mk(ExprKind.Comp(comp), sp))]
                            )
                    case _:
                        pass
            case _:
                pass

        match e.kind:
            # (literals that adapt to the expected type returned above)
            case ExprKind.Int(_):
                return int_ty()
            case ExprKind.UInt(_):
                return Ty.Int(IntTy.U128)
            case ExprKind.Float(_):
                match exp:
                    case Some(Ty.Float(FloatTy.F32)):
                        return Ty.Float(FloatTy.F32)
                    case _:
                        return float_ty()
            case ExprKind.Bool(_):
                return Ty.Bool
            case ExprKind.Str(_):
                return Ty.Str
            case ExprKind.FStr(segs):
                if self.in_spec:
                    self.spec_err(span)
                var segs2 = segs
                for i in 0..len(segs2):
                    match segs2[i]:
                        case FSeg.Part(x, spec):
                            var x2 = x
                            let t = self.check_expr(ref x2, None)
                            segs2[i] = FSeg.Part(x2, spec)
                            # the prelude formats any `E` (an `Err(())` prints `()`)
                            let prelude = self.info.module_names[self.cur_mod] == PRELUDE
                            if not printable(t) and not prelude:
                                self.err(
                                    diag.error(
                                        "E0301",
                                        "cannot format a value of type " + self.tn(t)
                                    ).label(x2.span, "not printable")
                                )
                            match spec:
                                case Some(sp):
                                    match parse_fmt_spec(sp):
                                        case None:
                                            self.err(
                                                diag.error("E0318", f"invalid format spec `{sp}`")
                                                .label(x2.span, "in this f-string field")
                                                .with_help(
                                                    "supported: `.2f` (fixed), `.3e` (scientific), `8` (width), `<8` (left-align), `08` (zero-pad), `x` (hex), `b` (binary)"
                                                )
                                            )
                                        case Some(fs):
                                            let k = fs.kind.unwrap_or("")
                                            if (k == "f" or k == "e") and not t.is_numeric():
                                                self.err(
                                                    diag.error(
                                                        "E0318",
                                                        "`f`/`e` format specs require a number"
                                                    ).label(x2.span, "has type " + self.tn(t))
                                                )
                                            if (k == "x" or k == "b") and not t.is_int():
                                                self.err(
                                                    diag.error(
                                                        "E0318",
                                                        "`x`/`b` format specs require an integer"
                                                    ).label(x2.span, "has type " + self.tn(t))
                                                )
                                case None:
                                    pass
                        case _:
                            pass
                e.kind = ExprKind.FStr(segs2)
                return Ty.Str
            case ExprKind.Ident(name):
                return self.check_ident(ref e, name, exp)
            case ExprKind.Try(inner):
                var x = inner
                let t = self.check_expr(ref x, None)
                e.kind = ExprKind.Try(x)
                return self.check_try(t, span)
            case ExprKind.Unary(op, inner):
                var x = inner
                var uexp = exp
                if op == UnOp.Not:
                    uexp = Some(Ty.Bool)
                let t = self.check_expr(ref x, uexp)
                e.kind = ExprKind.Unary(op, x)
                if t.is_error():
                    return Ty.Error
                match op:
                    case UnOp.Neg:
                        match t:
                            case Ty.Int(k):
                                if not k.signed():
                                    self.err(
                                        diag.error(
                                            "E0305",
                                            f"cannot negate an unsigned `{k.name()}`"
                                        ).label(span, "unsigned")
                                    )
                            case _:
                                if not t.is_float():
                                    self.err(
                                        diag.error(
                                            "E0305",
                                            "cannot negate a value of type " + self.tn(t)
                                        ).label(span, "not a number")
                                    )
                                    return Ty.Error
                        return t
                    case UnOp.Not:
                        if t != Ty.Bool:
                            self.err(
                                diag.error("E0305", "`not` needs a `bool`, found " + self.tn(t))
                                .label(span, "not a bool")
                                .with_help("use `~x` for bitwise negation of integers")
                            )
                        return Ty.Bool
                    case UnOp.BitNot:
                        if not t.is_int():
                            self.err(
                                diag.error(
                                    "E0305",
                                    "`~` needs an integer"
                                ).label(span, "not an integer")
                            )
                        return t
            case ExprKind.Binary(op, l, r):
                var l2 = l
                var r2 = r
                if op == BinOp.And or op == BinOp.Or:
                    let lt = self.check_expr(ref l2, Some(Ty.Bool))
                    let rt = self.check_expr(ref r2, Some(Ty.Bool))
                    e.kind = ExprKind.Binary(op, l2, r2)
                    for t, sp in [(lt, l2.span), (rt, r2.span)]:
                        if not t.is_error() and t != Ty.Bool:
                            self.err(
                                diag.error(
                                    "E0305",
                                    f"`{op.sym()}` needs `bool` operands, found " + self.tn(t)
                                )
                                .label(sp, "not a bool")
                                .with_help("use `&` / `|` for bitwise operations on integers")
                            )
                    return Ty.Bool
                var oexp: Option[Ty] = None
                match exp:
                    case Some(t):
                        if t.is_numeric():
                            oexp = Some(t)
                    case None:
                        pass
                var lt = self.check_expr(ref l2, oexp)
                var rexp: Option[Ty] = None
                if lt.is_numeric():
                    rexp = Some(lt)
                let rt = self.check_expr(ref r2, rexp)
                if l2.is_literal() and not r2.is_literal() and rt.is_numeric() and lt != rt:
                    lt = self.check_expr(ref l2, Some(rt))
                e.kind = ExprKind.Binary(op, l2, r2)
                return self.binop_type(op, lt, rt, span, l2.span, r2.span)
            case ExprKind.Compare(first, rest):
                var first2 = first
                var rest2 = rest
                # find a non-literal operand type to guide literals
                var guide: Option[Ty] = None
                let ft = self.check_expr(ref first2, None)
                if not first2.is_literal():
                    guide = Some(ft)
                var tys = [ft]
                for i in 0..len(rest2):
                    let t = self.check_expr(ref rest2[i].1, guide)
                    if guide.is_none() and not rest2[i].1.is_literal():
                        guide = Some(t)
                    tys.push(t)
                match guide:
                    case Some(g):
                        if g.is_numeric():
                            if first2.is_literal():
                                tys[0] = self.check_expr(ref first2, Some(g))
                            for i in 0..len(rest2):
                                if rest2[i].1.is_literal():
                                    tys[i + 1] = self.check_expr(ref rest2[i].1, Some(g))
                    case None:
                        pass
                e.kind = ExprKind.Compare(first2, rest2)
                var spans = [first2.span]
                for x in rest2:
                    spans.push(x.1.span)
                for i, x in enumerate(rest2):
                    let op = x.0
                    let a = tys[i]
                    let b = tys[i + 1]
                    if a.is_error() or b.is_error():
                        continue
                    let both = spans[i].to(spans[i + 1])
                    if a != b:
                        var d = diag.error(
                            "E0305",
                            "cannot compare " + self.tn(a) + " with " + self.tn(b)
                        ).label(both, "mismatched types")
                        if a.is_numeric() and b.is_numeric():
                            d = d.with_help("convert one side explicitly, e.g. `float(x)`")
                        self.err(d)
                        continue
                    let ord = op == CmpOp.Lt or op == CmpOp.Le or op == CmpOp.Gt or op == CmpOp.Ge
                    if ord and not orderable(self.info, a):
                        self.not_orderable(
                            a,
                            both,
                            "values of type " + self.tn(a) + " can't be ordered"
                        )
                    elif not ord and not equatable(a):
                        self.err(
                            diag.error(
                                "E0305",
                                "values of type " + self.tn(a) + " can't be compared"
                            ).label(both, "not comparable")
                        )
                return Ty.Bool
            case ExprKind.IfElse(cond, then, els):
                var c2 = cond
                var t2 = then
                var e2 = els
                self.check_cond(ref c2)
                var tt = self.check_expr(ref t2, exp)
                let et = self.check_expr(ref e2, Some(tt))
                if t2.is_literal() and not e2.is_literal() and et.is_numeric() and tt != et:
                    tt = self.check_expr(ref t2, Some(et))
                e.kind = ExprKind.IfElse(c2, t2, e2)
                if not compatible(tt, et):
                    let a = self.tn(tt)
                    let b = self.tn(et)
                    self.err(
                        diag.error(
                            "E0301",
                            f"`if` and `else` have different types: {a} and {b}"
                        ).label(e2.span, f"expected {a}")
                    )
                return tt
            case ExprKind.Call(_, _):
                return self.check_call(ref e, exp)
            case ExprKind.MethodCall(_, _, _, _):
                return self.check_method(ref e, exp, None)
            case ExprKind.Field(base, name, name_span):
                return self.check_field(ref e, base, name, name_span, exp)
            case ExprKind.Index(base, idx):
                var b2 = base
                var i2 = idx
                let bt = self.check_expr(ref b2, None)
                match bt:
                    case Ty.Map(k, v):
                        self.check_expr(ref i2, Some(k))
                        self.expect_ty(k, i2)
                        e.kind = ExprKind.Index(b2, i2)
                        return v
                    case _:
                        pass
                let it = self.check_expr(ref i2, Some(int_ty()))
                e.kind = ExprKind.Index(b2, i2)
                if not it.is_error() and not it.is_int():
                    self.err(
                        diag.error(
                            "E0304",
                            "array index must be an integer, found " + self.tn(it)
                        ).label(i2.span, "not an integer")
                    )
                match bt:
                    case Ty.Array(el):
                        return el
                    case Ty.Error:
                        return Ty.Error
                    # the byte at `i`, as a one-character string
                    case Ty.Str:
                        return Ty.Str
                    case _:
                        self.err(
                            diag.error(
                                "E0304",
                                "cannot index into a value of type " + self.tn(bt)
                            ).label(b2.span, "not an array")
                        )
                        return Ty.Error
            case ExprKind.Slice(base, lo, hi):
                var b2 = base
                let bt = self.check_expr(ref b2, None)
                let lo2 = self.check_bound(lo)
                let hi2 = self.check_bound(hi)
                e.kind = ExprKind.Slice(b2, lo2, hi2)
                match bt:
                    case Ty.Array(_) | Ty.Str | Ty.Error:
                        return bt
                    case _:
                        self.err(
                            diag.error(
                                "E0304",
                                "cannot slice a value of type " + self.tn(bt)
                            ).label(b2.span, "not an array or string")
                        )
                        return Ty.Error
            case ExprKind.Array(elems):
                var eexp: Option[Ty] = None
                match exp:
                    case Some(Ty.Array(el)):
                        eexp = Some(el)
                    case _:
                        pass
                if len(elems) == 0:
                    match exp:
                        case Some(Ty.Array(_)):
                            return exp.unwrap()
                        case _:
                            self.err(
                                diag.error(
                                    "E0308",
                                    "cannot infer the element type of an empty array"
                                )
                                .label(span, "type unknown")
                                .with_help("annotate the variable, e.g. `var xs: [int] = []`")
                            )
                            return Ty.Error
                var xs = elems
                let t0 = self.check_same(ref xs, eexp, "array elements")
                e.kind = ExprKind.Array(xs)
                return Ty.Array(t0)
            case ExprKind.Map(kvs):
                var ek: Option[Ty] = None
                var ev: Option[Ty] = None
                match exp:
                    case Some(Ty.Map(k, v)):
                        ek = Some(k)
                        ev = Some(v)
                    case _:
                        pass
                if len(kvs) == 0:
                    match exp:
                        case Some(Ty.Map(_, _)):
                            return exp.unwrap()
                        case _:
                            self.err(
                                diag.error(
                                    "E0308",
                                    "cannot infer the key and value types of an empty map"
                                )
                                .label(span, "type unknown")
                                .with_help("annotate the variable, e.g. `var m: {str: int} = {}`")
                            )
                            return Ty.Error
                var ks = [kv.0 for kv in kvs]
                var vs = [kv.1 for kv in kvs]
                let kt = self.check_same(ref ks, ek, "map keys")
                let vt = self.check_same(ref vs, ev, "map values")
                var kvs2: [(Expr, Expr)] = []
                for i in 0..len(ks):
                    kvs2.push((ks[i], vs[i]))
                e.kind = ExprKind.Map(kvs2)
                self.check_key_type(kt, span)
                # the same constant key twice is almost certainly a mistake
                var seen: [(str, Span)] = []
                for k in ks:
                    var lit = ""
                    var has = true
                    match k.kind:
                        case ExprKind.Int(v):
                            lit = f"{v}"
                        case ExprKind.UInt(v):
                            lit = f"{v}"
                        case ExprKind.Str(s):
                            lit = debug_str(s)
                        case ExprKind.Bool(b):
                            lit = "true" if b else "false"
                        case _:
                            has = false
                    if has:
                        var first: Option[Span] = None
                        for x, sp in seen:
                            if x == lit:
                                first = Some(sp)
                                break
                        match first:
                            case Some(f):
                                self.err(
                                    diag.error("E0336", f"key {lit} appears twice in this map")
                                    .label(k.span, "duplicate key")
                                    .label(f, "first used here")
                                )
                            case None:
                                seen.push((lit, k.span))
                return Ty.Map(kt, vt)
            case ExprKind.Contains(item, coll, neg):
                var it2 = item
                var c2 = coll
                let ct = self.check_expr(ref c2, None)
                var want: Option[Ty] = None
                match ct:
                    case Ty.Map(k, _):
                        want = Some(k)
                    case Ty.Array(el):
                        want = Some(el)
                    case Ty.Str:
                        want = Some(Ty.Str)
                    case _:
                        pass
                self.check_expr(ref it2, want)
                e.kind = ExprKind.Contains(it2, c2, neg)
                match want:
                    case Some(w):
                        self.expect_ty(w, it2)
                        if not equatable(w):
                            self.err(
                                diag.error(
                                    "E0301",
                                    "cannot compare values of type " + self.tn(w)
                                ).label(it2.span, "not comparable")
                            )
                    case None:
                        if not ct.is_error():
                            let tn = self.tn(ct)
                            self.err(
                                diag.error(
                                    "E0301",
                                    f"`in` needs a map, array or string on the right, found {tn}"
                                ).label(c2.span, "can't search this")
                            )
                return Ty.Bool
            case ExprKind.Repeat(elem, count):
                var el2 = elem
                var c2 = count
                var eexp: Option[Ty] = None
                match exp:
                    case Some(Ty.Array(el)):
                        eexp = Some(el)
                    case _:
                        pass
                let et = self.check_expr(ref el2, eexp)
                let ct = self.check_expr(ref c2, Some(int_ty()))
                e.kind = ExprKind.Repeat(el2, c2)
                if not ct.is_error() and ct != int_ty():
                    self.err(
                        diag.error(
                            "E0301",
                            "array repeat count must be an `int`"
                        ).label(c2.span, "found " + self.tn(ct))
                    )
                if et == Ty.Unit:
                    return Ty.Error
                return Ty.Array(et)
            case ExprKind.Tuple(elems):
                if len(elems) == 0:
                    return Ty.Unit
                var xs = elems
                let exps = self.tuple_exps(exp, len(xs))
                var ts: [Ty] = []
                for i in 0..len(xs):
                    ts.push(self.check_expr(ref xs[i], exps[i]))
                e.kind = ExprKind.Tuple(xs)
                return Ty.Tuple(ts)
            case ExprKind.Range(_, _, _):
                self.err(
                    diag.error("E0312", "ranges can only be used in `for` loops and comprehensions")
                    .label(span, "range used as a value")
                    .with_help("to make an array, write `[i for i in 0..n]`")
                )
                return Ty.Error
            case ExprKind.Comp(c):
                return self.check_comp(ref e, c, exp, allow_gen)
            case ExprKind.ParTuple(elems):
                if self.in_spec:
                    self.spec_err(span)
                let level = self.cur_level() + 1
                self.par_stack.push(
                    ParCx(level=level, is_for=false, loop_var=None, captures=[], writes=[])
                )
                var xs = elems
                let exps = self.tuple_exps(exp, len(xs))
                var ts: [Ty] = []
                for i in 0..len(xs):
                    let t = self.check_expr(ref xs[i], exps[i])
                    if t == Ty.Unit:
                        self.err(
                            diag.error(
                                "E0301",
                                "each expression in `par(...)` must produce a value"
                            ).label(xs[i].span, "has type `()`")
                        )
                    ts.push(t)
                let cx = self.par_stack.pop()
                e.caps = cx.captures
                e.kind = ExprKind.ParTuple(xs)
                return Ty.Tuple(ts)
            case ExprKind.Error:
                return Ty.Error

    fn tuple_exps(self, exp: Option[Ty], n: int) -> [Option[Ty]]:
        var out: [Option[Ty]] = []
        match exp:
            case Some(Ty.Tuple(ts)):
                if len(ts) == n:
                    for t in ts:
                        out.push(Some(t))
                    return out
            case _:
                pass
        for _ in 0..n:
            out.push(None)
        return out

    # A slice bound: an `int` that isn't written negative.
    fn check_bound(ref self, b: Option[Expr]) -> Option[Expr]:
        match b:
            case None:
                return None
            case Some(x):
                var x2 = x
                # look before checking: checking folds `-1` into a literal
                var neg = false
                match x.kind:
                    case ExprKind.Unary(UnOp.Neg, _):
                        neg = true
                    case _:
                        pass
                let it = self.check_expr(ref x2, Some(int_ty()))
                if not it.is_error() and it != int_ty():
                    self.err(
                        diag.error(
                            "E0304",
                            "slice bounds must be `int`, found " + self.tn(it)
                        ).label(x2.span, "not an `int`")
                    )
                if neg:
                    self.err(
                        diag.error("E0304", "slice bounds can't be negative")
                        .label(x2.span, "negative")
                        .with_help(
                            "brine has no negative indexes; write `xs[len(xs) - 1]` or `s[:len(s) - 1]`"
                        )
                    )
                return Some(x2)

    # An array constant becomes its literal at each use; `res` still names the
    # constant, so changing it is reported as changing a constant.
    fn use_const(ref self, ref e: Expr, id: int):
        match self.const_exprs.get(id):
            case Some(lit):
                e.kind = lit.kind
                e.ty = lit.ty
            case None:
                pass
        e.res = Res.Const(id)

    fn check_ident(ref self, ref e: Expr, name: str, exp: Option[Ty]) -> Ty:
        let span = e.span
        match self.lookup_local(name):
            case Some(id):
                e.res = Res.Local(id)
                self.use_local(id)
                return self.locals[id].ty
            case None:
                pass
        match self.item(name):
            case Some(Item.Const(id)):
                self.use_const(ref e, id)
                return self.info.consts[id].ty
            case Some(Item.Fn(_)) | Some(Item.GenFn(_)):
                self.err(
                    diag.error(
                        "E0310",
                        f"`{name}` is a function; functions can't be used as values yet"
                    ).label(span, "call it with `(...)`")
                )
                return Ty.Error
            case Some(Item.Struct(_)):
                self.err(
                    diag.error(
                        "E0310",
                        f"`{name}` is a type, not a value"
                    ).label(span, f"construct one with `{name}(...)`")
                )
                return Ty.Error
            case Some(Item.Enum(eid)):
                var v = ""
                if len(self.info.enums[eid].variants) > 0:
                    v = self.info.enums[eid].variants[0].name
                self.err(
                    diag.error(
                        "E0310",
                        f"`{name}` is a type, not a value"
                    ).label(span, f"pick a variant, e.g. `{name}.{v}`")
                )
                return Ty.Error
            case Some(Item.Module(_)):
                self.err(
                    diag.error(
                        "E0310",
                        f"`{name}` is a module, not a value"
                    ).label(span, f"use `{name}.item`")
                )
                return Ty.Error
            case Some(Item.GenVariant(tid, _)):
                return self.variant_value_generic(tid, name, span, ref e.res, span, exp)
            case Some(Item.GenType(_)):
                self.err(
                    diag.error(
                        "E0310",
                        f"`{name}` is a type, not a value"
                    ).label(span, "not a value")
                )
                return Ty.Error
            case None:
                if name == "world":
                    self.err(
                        diag.error(
                            "E0310",
                            "`world` is a module, not a value"
                        ).label(span, "use e.g. `world.rank()`")
                    )
                elif name == "os":
                    self.err(
                        diag.error(
                            "E0310",
                            "`os` is a module, not a value"
                        ).label(span, "use e.g. `os.cwd()`")
                    )
                elif builtin_by_name(name).is_some() or reducer_by_name(name).is_some():
                    self.err(
                        diag.error(
                            "E0310",
                            f"`{name}` is a built-in function; call it with `(...)`"
                        ).label(span, "not a value")
                    )
                else:
                    self.undefined(name, span, "value")
                return Ty.Error

    fn check_field(
        ref self,
        ref e: Expr,
        base: Expr,
        name: str,
        name_span: Span,
        exp: Option[Ty]
    ) -> Ty:
        let span = e.span
        match self.type_path(base):
            case Some(Item.Enum(eid)):
                return self.variant_value(eid, name, name_span, ref e.res, span)
            case _:
                pass
        match self.generic_item(base):
            case Some(Item.GenType(tid)):
                return self.variant_value_generic(tid, name, name_span, ref e.res, span, exp)
            case _:
                pass
        match self.applied_type(base):
            case Some(t):
                match t:
                    case Ty.Enum(eid):
                        return self.variant_value(eid, name, name_span, ref e.res, span)
                    case Ty.Error:
                        return Ty.Error
                    case _:
                        self.err(
                            diag.error(
                                "E0310",
                                self.tn(t) + " is a type, not a value"
                            ).label(base.span, "not a value")
                        )
                        return Ty.Error
            case None:
                pass
        match base.kind:
            case ExprKind.Ident(bname):
                if self.lookup_local(bname).is_none():
                    match self.item(bname):
                        case Some(Item.Module(m)):
                            match self.items[m].get(name):
                                case Some(Item.Const(id)):
                                    self.use_const(ref e, id)
                                    return self.info.consts[id].ty
                                case Some(_):
                                    self.err(
                                        diag.error(
                                            "E0310",
                                            f"`{bname}.{name}` is not a value"
                                        ).label(span, "call functions with `(...)`")
                                    )
                                    return Ty.Error
                                case None:
                                    var d = diag.error(
                                        "E0201",
                                        f"module `{bname}` has no item `{name}`"
                                    ).label(name_span, "not found")
                                    match best_match(name, self.items[m].keys()):
                                        case Some(b):
                                            d = d.with_help(
                                                f"did you mean `{b}`?"
                                            ).fix(name_span, b, "replace")
                                        case None:
                                            pass
                                    self.err(d)
                                    return Ty.Error
                        case _:
                            pass
            case _:
                pass
        var b2 = base
        let bt = self.check_expr(ref b2, None)
        e.kind = ExprKind.Field(b2, name, name_span)
        match bt:
            case Ty.Struct(sid):
                let s = self.info.structs[sid]
                for i, f in enumerate(s.fields):
                    if f.0 == name:
                        e.idx = i
                        return f.1
                let cands = [f.0 for f in s.fields]
                var d = diag.error(
                    "E0205",
                    f"struct `{s.name}` has no field `{name}`"
                ).label(name_span, "unknown field")
                if name in s.methods:
                    d = d.with_help(f"`{name}` is a method; call it with `.{name}()`")
                else:
                    match best_match(name, cands):
                        case Some(b):
                            d = d.with_help(f"did you mean `{b}`?").fix(name_span, b, "replace")
                        case None:
                            if len(cands) > 0:
                                d = d.note("available fields: " + ", ".join(cands))
                self.err(d)
                return Ty.Error
            case Ty.Enum(eid):
                let en = self.info.enums[eid]
                var d = diag.error(
                    "E0205",
                    f"enum `{en.name}` has no fields"
                ).label(name_span, "use `match` to read the data in a variant")
                if name in en.methods:
                    d = d.with_help(f"`{name}` is a method; call it with `.{name}()`")
                self.err(d)
                return Ty.Error
            case Ty.Tuple(ts):
                match parse_index(name):
                    case Some(i):
                        if i < len(ts):
                            e.idx = i
                            return ts[i]
                    case None:
                        pass
                let n = len(ts)
                let top = n - 1 if n > 0 else 0
                self.err(
                    diag.error(
                        "E0205",
                        f"tuple has no field `{name}`"
                    ).label(name_span, f"valid fields are 0..{top}")
                )
                return Ty.Error
            case Ty.Error:
                return Ty.Error
            case _:
                var d = diag.error(
                    "E0205",
                    self.tn(bt) + f" has no field `{name}`"
                ).label(name_span, "unknown field")
                if name == "len" or name == "length" or name == "size":
                    d = d.with_help("use `len(x)`")
                self.err(d)
                return Ty.Error

    # The names a comprehension unpacks its element into. Each is a field of its
    # parent (the hidden loop variable, or a hidden name for a nested tuple),
    # which is how uses of it are checked and compiled.
    fn comp_unpack(ref self, c: Comp, vname: str, elem: Ty, kind: LocalKind):
        var held: {str: Ty} = {}
        held[vname] = elem
        var reported: [str] = []
        for u in c.unpack:
            let pt = held[u.parent]
            let count = len([x for x in c.unpack if x.parent == u.parent])
            var t = Ty.Error
            var ok = pt.is_error()
            match pt:
                case Ty.Tuple(ts):
                    if len(ts) == count:
                        t = ts[u.index]
                        ok = true
                case _:
                    pass
            if not ok and u.parent not in reported:
                reported.push(u.parent)
                let tn = self.tn(pt)
                var sp = c.name_span
                for x in c.unpack:
                    if x.name == u.parent:
                        sp = x.span
                self.err(
                    diag.error(
                        "E0301",
                        f"cannot unpack {tn} into {count} variables"
                    ).label(sp, f"this has type {tn}")
                )
            held[u.name] = t
            if u.name == "_":
                continue
            if "'" not in u.name:
                match self.lookup_local(u.name):
                    case Some(prev):
                        let pspan = self.locals[prev].span
                        self.err(
                            diag.error("E0207", f"`{u.name}` is already defined in this function")
                            .label(u.span, "defined again here")
                            .label(pspan, "first defined here")
                            .with_help("brine doesn't allow shadowing; pick a new name")
                        )
                    case None:
                        pass
            if ok:
                self.unpacks.push((u.name, u.parent, u.index))
            else:
                # already reported; don't report every use too
                self.declare(u.name, u.span, Ty.Error, kind)

    fn check_comp(ref self, ref e: Expr, c0: Comp, exp: Option[Ty], allow_gen: bool) -> Ty:
        let span = e.span
        if self.in_spec:
            self.spec_err(span)
        var c = c0
        if c.kind == CompKind.Gen and not allow_gen:
            self.err(
                diag.error(
                    "E0316",
                    "generator expressions can only be used inside sum(), product(), min(), max(), any() or all()"
                )
                .label(span, "generator here")
                .with_help("wrap it in brackets to make an array: `[... for ...]`")
            )
        let elem = self.check_iter(ref c.iter, None)
        let kind = LocalKind.ForVar if c.iter.ty == Ty.Range else LocalKind.ForElem
        if c.par:
            let level = self.cur_level() + 1
            self.par_stack.push(
                ParCx(level=level, is_for=false, loop_var=None, captures=[], writes=[])
            )
        self.scopes.push([])
        let vname = c.name
        let unpacked = len(self.unpacks)
        if len(c.unpack) > 0:
            self.comp_unpack(c, vname, elem, kind)
        let id = self.declare(vname, c.name_span, elem, kind)
        e.local = id
        self.no_try += 1
        match c.filter:
            case Some(f):
                var f2 = f
                self.check_cond(ref f2)
                c.filter = Some(f2)
            case None:
                pass
        var bexp: Option[Ty] = None
        if c.kind == CompKind.List:
            match exp:
                case Some(Ty.Array(el)):
                    bexp = Some(el)
                case _:
                    pass
        let bt = self.check_expr(ref c.body, bexp)
        self.no_try -= 1
        while len(self.unpacks) > unpacked:
            self.unpacks.pop()
        self.scopes.pop()
        if c.par:
            let cx = self.par_stack.pop()
            e.caps = cx.captures
            if c.filter.is_some() and c.kind == CompKind.List:
                self.err(
                    diag.error("E0508", "`if` filters in `par [...]` are not supported yet")
                    .label(span, "filtered parallel comprehension")
                    .with_help(
                        "use a sequential comprehension, or `par sum(... if ...)` for reductions"
                    )
                )
        e.kind = ExprKind.Comp(c)
        if bt == Ty.Unit:
            self.err(
                diag.error(
                    "E0301",
                    "comprehension body doesn't produce a value"
                ).label(c.body.span, "has type `()`")
            )
            return Ty.Error
        match c.kind:
            case CompKind.List:
                return Ty.Array(bt)
            case CompKind.Gen:
                return bt

    fn spec_err(ref self, span: Span):
        # report only the outermost offending expression
        for d in self.diags:
            if d.code == "E0606" and len(d.labels) > 0:
                let l = d.labels[0].span
                if l.file == span.file and l.lo <= span.lo and span.hi <= l.hi:
                    return
        self.err(
            diag.error("E0606", "this is not allowed in a specification")
            .label(span, "not allowed here")
            .note(
                "`requires`, `ensures`, `invariant` and `prove` may use arithmetic, comparisons, `and`/`or`/`not`, `len`, `abs`, `min`, `max`, fields, indexing, and `result`"
            )
        )

    fn binop_type(ref self, op: BinOp, lt: Ty, rt: Ty, span: Span, ls: Span, rs: Span) -> Ty:
        if lt.is_error() or rt.is_error():
            return Ty.Error
        match op:
            case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.Div | BinOp.Mod:
                if op == BinOp.Add and lt == Ty.Str and rt == Ty.Str:
                    return Ty.Str
                if lt.is_numeric() and lt == rt:
                    return lt
                var verb = "take the remainder of"
                match op:
                    case BinOp.Add:
                        verb = "add"
                    case BinOp.Sub:
                        verb = "subtract"
                    case BinOp.Mul:
                        verb = "multiply"
                    case BinOp.Div:
                        verb = "divide"
                    case _:
                        pass
                var d = diag.error(
                    "E0305",
                    f"cannot {verb} " + self.tn(lt) + " and " + self.tn(rt)
                ).label(span, f"`{op.sym()}` with mismatched operands")
                if lt.is_numeric() and rt.is_numeric():
                    d = d.with_help(
                        "brine never converts numbers implicitly; use `float(x)` or `int(x)`"
                    )
                elif (lt == Ty.Str or rt == Ty.Str) and op == BinOp.Add:
                    d = d.with_help("convert with `str(x)`, or use an f-string: f\"{a}{b}\"")
                self.err(d)
                return Ty.Error
            case BinOp.BitAnd | BinOp.BitOr | BinOp.BitXor:
                if lt.is_int() and lt == rt:
                    return lt
                var d = diag.error(
                    "E0305",
                    f"`{op.sym()}` needs two integers of the same type, found "
                    + self.tn(lt)
                    + " and "
                    + self.tn(rt)
                ).label(span, "invalid operands")
                if lt == Ty.Bool:
                    d = d.with_help(
                        "use `" + ("and" if op == BinOp.BitAnd else "or") + "` for booleans"
                    )
                self.err(d)
                return Ty.Error
            case BinOp.Shl | BinOp.Shr:
                if lt.is_int() and rt.is_int():
                    return lt
                self.err(
                    diag.error("E0305", "shifts need integer operands").label(rs, "not an integer")
                )
                return Ty.Error
            case BinOp.And | BinOp.Or:
                return Ty.Bool

    # ------------------------------------------------------------ calls
    fn check_all(ref self, ref args: [Arg]):
        for i in 0..len(args):
            self.check_expr(ref args[i].expr, None)

    fn check_call(ref self, ref e: Expr, exp: Option[Ty]) -> Ty:
        let span = e.span
        match e.kind:
            case ExprKind.Call(callee, args):
                # `x.m[T](...)`: a method call with explicit type arguments
                match callee.kind:
                    case ExprKind.Index(base, idx):
                        match base.kind:
                            case ExprKind.Field(recv, name, name_span):
                                if (
                                    self.generic_item(base).is_none()
                                    and self.type_path(base).is_none()
                                ):
                                    let targs = self.type_args(idx)
                                    e.kind = ExprKind.MethodCall(recv, name, name_span, args)
                                    e.cres = CallRes.Unresolved
                                    return self.check_method(ref e, exp, Some(targs))
                            case _:
                                pass
                    case _:
                        pass
                var c2 = callee
                var a2 = args
                var res = e.cres
                let t = self.check_call_inner(ref c2, ref a2, ref res, span, exp)
                e.kind = ExprKind.Call(c2, a2)
                e.cres = res
                return t
            case _:
                return Ty.Error

    fn check_call_inner(
        ref self,
        ref callee: Expr,
        ref args: [Arg],
        ref res: CallRes,
        span: Span,
        exp: Option[Ty]
    ) -> Ty:
        match callee.kind:
            case ExprKind.Index(base, idx):
                match self.type_path(base):
                    case Some(Item.Struct(_)) | Some(Item.Enum(_)):
                        self.err(
                            diag.error(
                                "E0334",
                                "this type is not generic"
                            ).label(base.span, "remove the type arguments")
                        )
                        self.check_all(ref args)
                        return Ty.Error
                    case _:
                        pass
                match self.generic_item(base):
                    case Some(item):
                        let targs = self.type_args(idx)
                        match item:
                            case Item.GenFn(g):
                                return self.call_generic_fn(
                                    g,
                                    Some(targs),
                                    ref args,
                                    ref res,
                                    span,
                                    exp
                                )
                            case Item.GenType(t):
                                return self.ctor_generic(
                                    t,
                                    Some(targs),
                                    ref args,
                                    ref res,
                                    span,
                                    exp
                                )
                            case _:
                                self.err(
                                    diag.error(
                                        "E0334",
                                        "type arguments go on the enum, not the variant"
                                    )
                                    .label(callee.span, "e.g. `Option[int].Some(...)`")
                                    .with_help("usually they can be left out: `Some(x)`")
                                )
                                self.check_all(ref args)
                                return Ty.Error
                    case None:
                        pass
            case _:
                pass
        var name = ""
        let cspan = callee.span
        match callee.kind:
            case ExprKind.Ident(n):
                name = n
            case _:
                let t = self.check_expr(ref callee, None)
                if not t.is_error():
                    self.err(
                        diag.error(
                            "E0303",
                            "this expression is not callable"
                        ).label(callee.span, "has type " + self.tn(t))
                    )
                self.check_all(ref args)
                return Ty.Error
        match self.lookup_local(name):
            case Some(id):
                let t = self.locals[id].ty
                self.err(
                    diag.error(
                        "E0303",
                        f"`{name}` is a variable of type " + self.tn(t) + ", not a function"
                    ).label(cspan, "not callable")
                )
                return Ty.Error
            case None:
                pass
        # `T(x)` in generic code converts to what `T` stands for, like `int(x)`
        var conv = prim_type(name)
        if name in self.tenv:
            conv = Some(self.tenv[name])
        match self.item(name):
            case Some(_) if name in self.tenv:
                pass
            case Some(Item.Fn(id)):
                callee.res = Res.Fn(id)
                res = CallRes.Fn(id)
                if self.in_spec:
                    self.spec_err(span)
                let sig = self.info.fns[id]
                return self.check_args(sig, ref args, span, 0)
            case Some(Item.Struct(sid)):
                res = CallRes.Ctor(sid)
                return self.check_ctor(sid, ref args, span)
            case Some(Item.Enum(eid)):
                var v = ""
                if len(self.info.enums[eid].variants) > 0:
                    v = self.info.enums[eid].variants[0].name
                self.err(
                    diag.error(
                        "E0303",
                        f"`{name}` is an enum; construct one of its variants"
                    ).label(cspan, f"e.g. `{name}.{v}(...)`")
                )
                self.check_all(ref args)
                return Ty.Error
            case Some(Item.GenFn(g)):
                return self.call_generic_fn(g, None, ref args, ref res, span, exp)
            case Some(Item.GenType(t)):
                return self.ctor_generic(t, None, ref args, ref res, span, exp)
            case Some(Item.GenVariant(t, vi)):
                return self.variant_generic(t, vi, ref args, ref res, span, cspan, exp)
            case Some(Item.Const(_)) | Some(Item.Module(_)):
                self.err(
                    diag.error("E0303", f"`{name}` is not a function").label(cspan, "not callable")
                )
                return Ty.Error
            case None:
                pass
        # conversions
        match conv:
            case Some(target):
                res = CallRes.Convert(target)
                if len(args) != 1:
                    self.err(
                        diag.error(
                            "E0302",
                            f"`{name}(...)` takes exactly one argument"
                        ).label(span, "wrong number of arguments")
                    )
                    return target
                let at = self.check_expr(ref args[0].expr, None)
                if at.is_error():
                    return target
                var ok = false
                match target:
                    case Ty.Int(k):
                        ok = at.is_numeric() or at == Ty.Bool or at == Ty.Str
                        match at:
                            # an enum without data: its variant's position, from 0
                            case Ty.Enum(eid):
                                let en = self.info.enums[eid]
                                if not en.has_payload():
                                    ok = true
                                    let top = i128(len(en.variants) - 1)
                                    if top > k.max():
                                        self.err(
                                            diag.error(
                                                "E0301",
                                                f"`{en.name}` has {len(en.variants)} variants, more than `{k.name()}` holds"
                                            )
                                            .label(args[0].expr.span, "too many variants")
                                            .with_help("convert to `int` instead")
                                        )
                            case _:
                                pass
                    case Ty.Float(_):
                        ok = at.is_numeric() or at == Ty.Str
                    case Ty.Str:
                        ok = printable(at)
                    case _:
                        ok = false
                if not ok:
                    # a type parameter: say what it stands for
                    let shown = (
                        f"`{name}`"
                        if name not in self.tenv
                        else f"`{name}` (" + self.tn(target) + ")"
                    )
                    var d = diag.error(
                        "E0301",
                        "cannot convert " + self.tn(at) + " to " + shown
                    ).label(args[0].expr.span, "unsupported conversion")
                    if target == Ty.Bool:
                        d = d.with_help("compare explicitly instead, e.g. `x != 0`")
                    self.err(d)
                return target
            case None:
                pass
        if name == "range":
            self.err(
                diag.error(
                    "E0312",
                    "`range(...)` can only be used in `for` loops and comprehensions"
                )
                .label(span, "range used as a value")
                .with_help("to make an array, write `[i for i in range(n)]`")
            )
            return Ty.Error
        match reducer_by_name(name):
            case Some(r):
                var is_comp = false
                if len(args) == 1:
                    match args[0].expr.kind:
                        case ExprKind.Comp(_):
                            is_comp = true
                        case _:
                            pass
                if is_comp:
                    if self.in_spec:
                        self.spec_err(span)
                    res = CallRes.Reduce(r)
                    self.allow_gen = true
                    let bt = self.check_expr(ref args[0].expr, None)
                    if bt.is_error():
                        return Ty.Error
                    match r:
                        case Reducer.Any | Reducer.All:
                            if bt != Ty.Bool:
                                self.err(
                                    diag.error(
                                        "E0301",
                                        f"`{name}` needs `bool` values, found " + self.tn(bt)
                                    ).label(args[0].expr.span, "not a bool")
                                )
                            return Ty.Bool
                        case Reducer.Min | Reducer.Max:
                            var in_par = false
                            match args[0].expr.kind:
                                case ExprKind.Comp(c):
                                    in_par = c.par
                                case _:
                                    pass
                            if bt.is_numeric():
                                return bt
                            if in_par:
                                self.err(
                                    diag.error(
                                        "E0301",
                                        f"a parallel `{name}` needs numbers, found " + self.tn(bt)
                                    ).label(args[0].expr.span, "not numeric")
                                )
                            elif not orderable(self.info, bt):
                                self.not_orderable(
                                    bt,
                                    args[0].expr.span,
                                    f"`{name}` needs values that can be ordered"
                                )
                            return bt
                        case _:
                            if not bt.is_numeric():
                                self.err(
                                    diag.error(
                                        "E0301",
                                        f"`{name}` needs numbers, found " + self.tn(bt)
                                    ).label(args[0].expr.span, "not numeric")
                                )
                            return bt
            case None:
                pass
        match builtin_by_name(name):
            case Some(b):
                res = CallRes.Builtin(b)
                return self.check_builtin(b, ref args, exp, span)
            case None:
                pass
        if name == "sum" or name == "product" or name == "any" or name == "all":
            self.err(
                diag.error(
                    "E0302",
                    f"`{name}` takes one argument: an array or a generator like `x for x in xs`"
                ).label(span, "wrong arguments")
            )
            return Ty.Error
        self.check_all(ref args)
        self.undefined(name, cspan, "function")
        return Ty.Error

    fn check_args(ref self, sig: FnSig, ref args: [Arg], span: Span, skip: int) -> Ty:
        let params = sig.params[min(skip, len(sig.params)):]
        if len(args) != len(params):
            var ps: [str] = []
            for p in params:
                ps.push(("ref " if p.by_ref else "") + p.name + ": " + self.info.ty_name(p.ty))
            let np = len(params)
            let na = len(args)
            self.err(
                diag.error(
                    "E0302",
                    f"`{sig.name}` takes {np} argument{plural(np)} but {na} "
                    + ("was" if na == 1 else "were")
                    + " given"
                )
                .label(span, "wrong number of arguments")
                .note(f"signature: fn {sig.name}(" + ", ".join(ps) + ")")
            )
            self.check_all(ref args)
            return sig.ret
        var mut_roots: [(int, [str], Span)] = []
        for i in 0..len(args):
            let p = params[i]
            match args[i].name:
                case Some((n, nsp)):
                    if n != p.name:
                        self.err(
                            diag.error(
                                "E0302",
                                f"keyword argument `{n}` doesn't match parameter `{p.name}`"
                            )
                            .label(nsp, "unexpected name")
                            .note("keyword arguments must be given in parameter order")
                        )
                case None:
                    pass
            self.check_arg(ref args[i].expr, p.ty)
            if p.by_ref:
                if not args[i].by_ref:
                    let sp = args[i].expr.span
                    self.err(
                        diag.error(
                            "E0402",
                            f"parameter `{p.name}` is a `ref`; pass the argument with `ref`"
                        )
                        .label(sp, "the callee may modify this")
                        .with_help(
                            "passing by reference is always visible at the call site in brine"
                        )
                        .fix(Span(file=sp.file, lo=sp.lo, hi=sp.lo), "ref ", "add `ref`")
                    )
                match self.check_mutation_target(args[i].expr, "pass as `ref`"):
                    case Some(r):
                        var path: [str] = []
                        match place_of(args[i].expr):
                            case Some((_, fp, _)):
                                path = fp
                            case None:
                                pass
                        mut_roots.push((r, path, args[i].expr.span))
                    case None:
                        pass
            elif args[i].by_ref:
                self.err(
                    diag.error("E0402", f"parameter `{p.name}` is passed by value")
                    .label(args[i].expr.span, "remove `ref` here")
                    .with_help(
                        f"declare the parameter as `ref {p.name}: ...` if the function should change the caller's variable"
                    )
                )
        # by-value arguments are evaluated (and kept) before the call, so only a
        # second `ref` to the same variable is a problem
        for r, path, rsp in mut_roots:
            for a in args:
                # each pair once, at the later argument
                if a.expr.span.lo <= rsp.lo or not a.by_ref:
                    continue
                if touches(a.expr, r, path):
                    let n = self.locals[r].name
                    self.err(
                        diag.error("E0405", f"`{n}` is passed as `ref` twice")
                        .label(a.expr.span, "second reference here")
                        .label(rsp, "passed as `ref` here")
                        .note(
                            "a `ref` argument must be the only access to that variable during the call"
                        )
                        .with_help(
                            f"pass `{n}` once and reach both parts through it, or pass separate fields (`ref {n}.a, ref {n}.b`)"
                        )
                    )
        return sig.ret

    fn check_ctor(ref self, sid: int, ref args: [Arg], span: Span) -> Ty:
        if self.in_spec:
            self.spec_err(span)
        let s = self.info.structs[sid]
        self.check_field_args(s.name, s.fields, ref args, span)
        return Ty.Struct(sid)

    # `Enum.Variant` used as a value.
    fn variant_value(
        ref self,
        eid: int,
        name: str,
        name_span: Span,
        ref res: Res,
        span: Span
    ) -> Ty:
        let en = self.info.enums[eid]
        for vi, v in enumerate(en.variants):
            if v.name == name:
                if len(v.fields) > 0:
                    let fs = [f.0 + ": " + self.info.ty_name(f.1) for f in v.fields]
                    self.err(
                        diag.error("E0302", f"`{en.name}.{name}` needs values for its fields")
                        .label(span, f"write `{en.name}.{name}(...)`")
                        .note("fields: " + ", ".join(fs))
                    )
                res = Res.Variant(eid, vi)
                return Ty.Enum(eid)
        var d = diag.error(
            "E0201",
            f"enum `{en.name}` has no variant `{name}`"
        ).label(name_span, "unknown variant")
        if name in en.methods:
            d = d.with_help(f"`{name}` is a method; call it with `(...)`")
        else:
            let cands = [v.name for v in en.variants]
            match best_match(name, cands):
                case Some(b):
                    d = d.with_help(f"did you mean `{b}`?").fix(name_span, b, "replace")
                case None:
                    d = d.note("variants: " + ", ".join(cands))
        self.err(d)
        return Ty.Error

    # The struct or enum named by `Name` or `module.Name` (if `e` is such a path).
    fn type_path(self, e: Expr) -> Option[Item]:
        var it: Option[Item] = None
        match e.kind:
            case ExprKind.Ident(name):
                if self.defined_at(name).is_none():
                    it = self.item(name)
            case ExprKind.Field(b, name, _):
                match b.kind:
                    case ExprKind.Ident(m):
                        if self.defined_at(m).is_none():
                            match self.item(m):
                                case Some(Item.Module(mi)):
                                    it = self.items[mi].get(name)
                                case _:
                                    pass
                    case _:
                        pass
            case _:
                pass
        match it:
            case Some(Item.Struct(_)) | Some(Item.Enum(_)):
                return it
            case _:
                return None

    # Arguments of a struct constructor or enum variant, positional or `field=value`.
    fn check_field_args(ref self, what: str, fields: [(str, Ty)], ref args: [Arg], span: Span):
        let keyword = any(a.name.is_some() for a in args)
        if keyword:
            var seen: [str] = []
            for i in 0..len(args):
                match args[i].name:
                    case None:
                        self.err(
                            diag.error(
                                "E0302",
                                "mix of positional and keyword arguments"
                            ).label(args[i].expr.span, "add `field=`")
                        )
                        self.check_expr(ref args[i].expr, None)
                    case Some((n, nsp)):
                        var fi = -1
                        for k, f in enumerate(fields):
                            if f.0 == n:
                                fi = k
                                break
                        if fi >= 0:
                            self.check_arg(ref args[i].expr, fields[fi].1)
                            if n in seen:
                                self.err(
                                    diag.error(
                                        "E0302",
                                        f"field `{n}` given twice"
                                    ).label(nsp, "duplicate")
                                )
                            seen.push(n)
                        else:
                            var d = diag.error(
                                "E0205",
                                f"`{what}` has no field `{n}`"
                            ).label(nsp, "unknown field")
                            match best_match(n, [f.0 for f in fields]):
                                case Some(b):
                                    d = d.with_help(f"did you mean `{b}`?").fix(nsp, b, "replace")
                                case None:
                                    pass
                            self.err(d)
                            self.check_expr(ref args[i].expr, None)
            var missing: [str] = []
            for f in fields:
                if f.0 not in seen:
                    missing.push(f.0)
            if len(missing) > 0:
                let s = "s" if len(missing) > 1 else ""
                let ms = ", ".join(["`" + m + "`" for m in missing])
                self.err(
                    diag.error(
                        "E0302",
                        f"missing field{s} {ms} in `{what}(...)`"
                    ).label(span, "every field needs a value")
                )
        else:
            if len(args) != len(fields):
                let fs = [f.0 + ": " + self.info.ty_name(f.1) for f in fields]
                let nf = len(fields)
                let na = len(args)
                self.err(
                    diag.error(
                        "E0302",
                        f"`{what}` has {nf} field{plural(nf)} but {na} value"
                        + (" was" if na == 1 else "s were")
                        + " given"
                    )
                    .label(span, "wrong number of values")
                    .note("fields: " + ", ".join(fs))
                )
                self.check_all(ref args)
                return
            for i in 0..len(args):
                if args[i].by_ref:
                    self.err(
                        diag.error(
                            "E0402",
                            "constructor arguments can't be `ref`"
                        ).label(args[i].expr.span, "remove `ref`")
                    )
                self.check_arg(ref args[i].expr, fields[i].1)

    fn nargs(ref self, name: str, ref args: [Arg], n: int, span: Span) -> bool:
        if len(args) != n:
            self.err(
                diag.error(
                    "E0302",
                    f"`{name}` takes {n} argument{plural(n)} but {len(args)} were given"
                ).label(span, "wrong number of arguments")
            )
            self.check_all(ref args)
            return false
        return true

    # `print(a, b, sep=", ", end="")`: `sep` goes between the values, `end` after them.
    fn print_args(ref self, ref args: [Arg]):
        var seen: [str] = []
        for i in 0..len(args):
            if args[i].by_ref:
                self.err(
                    diag.error(
                        "E0402",
                        "`print` takes its arguments by value"
                    ).label(args[i].expr.span, "remove `ref` here")
                )
            match args[i].name:
                case Some((n, nsp)):
                    if n != "sep" and n != "end":
                        self.err(
                            diag.error("E0302", f"`print` has no keyword argument `{n}`")
                            .label(nsp, "unknown name")
                            .note(
                                "`print` takes `sep=` (between values, default \" \") and `end=` (after them, default \"\\n\")"
                            )
                        )
                        self.check_expr(ref args[i].expr, None)
                        continue
                    if n in seen:
                        self.err(
                            diag.error(
                                "E0302",
                                f"`{n}` is given twice"
                            ).label(nsp, "given again here")
                        )
                    seen.push(n)
                    self.check_expr(ref args[i].expr, Some(Ty.Str))
                    self.expect_ty(Ty.Str, args[i].expr)
                    continue
                case None:
                    pass
            let t = self.check_expr(ref args[i].expr, None)
            if not printable(t) and not t.is_error():
                self.err(
                    diag.error(
                        "E0301",
                        "cannot print a value of type " + self.tn(t)
                    ).label(args[i].expr.span, "not printable")
                )

    fn check_builtin(ref self, b: Builtin, ref args: [Arg], exp: Option[Ty], span: Span) -> Ty:
        var name = "?"
        for n, x in builtins():
            if x == b:
                name = n
                break
        var spec_ok = false
        match b:
            case Builtin.Len | Builtin.Abs | Builtin.Min | Builtin.Max:
                spec_ok = true
            case _:
                pass
        if self.in_spec and not spec_ok:
            self.spec_err(span)
        if b != Builtin.Print and b != Builtin.Eprint:
            for a in args:
                match a.name:
                    case Some((n, nsp)):
                        self.err(
                            diag.error(
                                "E0302",
                                f"`{name}` doesn't take keyword arguments"
                            ).label(nsp, f"remove `{n}=`")
                        )
                    case None:
                        pass
        match b:
            case Builtin.Print | Builtin.Eprint:
                self.print_args(ref args)
                return Ty.Unit
            case Builtin.Len:
                if not self.nargs(name, ref args, 1, span):
                    return int_ty()
                let t = self.check_expr(ref args[0].expr, None)
                var ok = t.is_error()
                match t:
                    case Ty.Array(_) | Ty.Str | Ty.Map(_, _):
                        ok = true
                    case _:
                        pass
                if not ok:
                    self.err(
                        diag.error(
                            "E0301",
                            "`len` needs an array, string or map, found " + self.tn(t)
                        ).label(args[0].expr.span, "no length")
                    )
                return int_ty()
            case Builtin.Abs:
                if not self.nargs(name, ref args, 1, span):
                    return Ty.Error
                let t = self.check_expr(ref args[0].expr, None)
                if not t.is_error() and not t.is_numeric():
                    self.err(
                        diag.error(
                            "E0301",
                            "`abs` needs a number"
                        ).label(args[0].expr.span, "found " + self.tn(t))
                    )
                return t
            case Builtin.Min | Builtin.Max:
                if not self.nargs(name, ref args, 2, span):
                    return Ty.Error
                var t0 = self.check_expr(ref args[0].expr, None)
                var e1: Option[Ty] = None
                if t0.is_numeric():
                    e1 = Some(t0)
                let t1 = self.check_expr(ref args[1].expr, e1)
                if (
                    args[0].expr.is_literal()
                    and not args[1].expr.is_literal()
                    and t1.is_numeric()
                    and t0 != t1
                ):
                    t0 = self.check_expr(ref args[0].expr, Some(t1))
                if t0.is_error() or t1.is_error():
                    return Ty.Error
                if t0 != t1:
                    self.err(
                        diag.error(
                            "E0301",
                            f"`{name}` needs two values of the same type, found "
                            + self.tn(t0)
                            + " and "
                            + self.tn(t1)
                        ).label(span, "mismatched arguments")
                    )
                    return Ty.Error
                if not orderable(self.info, t0):
                    self.not_orderable(t0, span, f"`{name}` needs values that can be ordered")
                    return Ty.Error
                return t0
            case Builtin.Sqrt | Builtin.Sin | Builtin.Cos | Builtin.Tan | Builtin.Exp | Builtin.Log | Builtin.Floor | Builtin.Ceil | Builtin.Round:
                if not self.nargs(name, ref args, 1, span):
                    return float_ty()
                let t = self.check_expr(ref args[0].expr, Some(float_ty()))
                if not t.is_error() and not t.is_float():
                    self.err(
                        diag.error(
                            "E0301",
                            f"`{name}` needs a float, found " + self.tn(t)
                        ).label(args[0].expr.span, "convert with `float(...)`")
                    )
                    return float_ty()
                if t.is_error():
                    return float_ty()
                return t
            case Builtin.Pow:
                if not self.nargs(name, ref args, 2, span):
                    return float_ty()
                for i in 0..len(args):
                    let t = self.check_expr(ref args[i].expr, Some(float_ty()))
                    if not t.is_error() and t != float_ty():
                        self.err(
                            diag.error(
                                "E0301",
                                "`pow` needs float arguments"
                            ).label(args[i].expr.span, "found " + self.tn(t))
                        )
                return float_ty()
            case Builtin.Clock:
                self.nargs(name, ref args, 0, span)
                return float_ty()
            case Builtin.Flush:
                self.nargs(name, ref args, 0, span)
                return Ty.Unit
            case Builtin.Args:
                self.nargs(name, ref args, 0, span)
                return Ty.Array(Ty.Str)
            case Builtin.Exit:
                if self.nargs(name, ref args, 1, span):
                    let t = self.check_expr(ref args[0].expr, Some(int_ty()))
                    if not t.is_error() and t != int_ty():
                        self.err(
                            diag.error(
                                "E0301",
                                "`exit` needs an `int` code"
                            ).label(args[0].expr.span, "not an int")
                        )
                if len(self.par_stack) > 0:
                    self.err(
                        diag.error(
                            "E0503",
                            "`exit` can't be called inside a `par` body"
                        ).label(span, "not allowed here")
                    )
                return Ty.Unit
            case Builtin.Panic:
                if self.nargs(name, ref args, 1, span):
                    let t = self.check_expr(ref args[0].expr, Some(Ty.Str))
                    if not t.is_error() and t != Ty.Str:
                        self.err(
                            diag.error(
                                "E0301",
                                "`panic` needs a `str` message"
                            ).label(args[0].expr.span, "not a string")
                        )
                return Ty.Unit
            case Builtin.Enumerate:
                if not self.nargs(name, ref args, 1, span):
                    return Ty.Error
                let t = self.check_expr(ref args[0].expr, None)
                match t:
                    case Ty.Array(el):
                        return Ty.Array(Ty.Tuple([int_ty(), el]))
                    case Ty.Error:
                        return Ty.Error
                    case _:
                        let tn = self.tn(t)
                        self.err(
                            diag.error(
                                "E0301",
                                f"`enumerate` needs an array, found {tn}"
                            ).label(args[0].expr.span, "not an array")
                        )
                        return Ty.Error
            case Builtin.Ord:
                if self.nargs(name, ref args, 1, span):
                    self.check_expr(ref args[0].expr, Some(Ty.Str))
                    self.expect_ty(Ty.Str, args[0].expr)
                return int_ty()
            case Builtin.Chr:
                if self.nargs(name, ref args, 1, span):
                    self.check_expr(ref args[0].expr, Some(int_ty()))
                    self.expect_ty(int_ty(), args[0].expr)
                return Ty.Str
            case Builtin.ReadFile:
                self.builtin_args(name, ref args, [Ty.Str], span)
                return self.result_of(Ty.Str, Ty.Str, span)
            case Builtin.WriteFile | Builtin.Run:
                if b == Builtin.Run:
                    self.builtin_args(name, ref args, [Ty.Array(Ty.Str)], span)
                else:
                    self.builtin_args(name, ref args, [Ty.Str, Ty.Str], span)
                if len(self.par_stack) > 0:
                    self.err(
                        diag.error("E0503", f"`{name}` can't be called inside a `par` body")
                        .label(span, "not allowed here")
                        .with_help(
                            "its effects would happen in an unpredictable order; do it before or after the `par`"
                        )
                    )
                let ok = int_ty() if b == Builtin.Run else Ty.Unit
                return self.result_of(ok, Ty.Str, span)
            case Builtin.FileExists:
                self.builtin_args(name, ref args, [Ty.Str], span)
                return Ty.Bool
            case Builtin.Getenv:
                self.builtin_args(name, ref args, [Ty.Str], span)
                return self.option_of(Ty.Str, span)
            case Builtin.Embed:
                self.check_embed(ref args, span)
                return Ty.Str
            case _:
                panic("method builtin called as a function")
                return Ty.Error

    # `recv.name(args)`; `targs` are explicit type arguments: `x.m[int](...)`.
    fn check_method(ref self, ref e: Expr, exp: Option[Ty], targs: Option[[Ty]]) -> Ty:
        match e.kind:
            case ExprKind.MethodCall(recv, name, name_span, args):
                var r2 = recv
                var a2 = args
                var res = e.cres
                let t = self.check_method_inner(
                    ref r2,
                    name,
                    name_span,
                    ref a2,
                    ref res,
                    e.span,
                    exp,
                    targs
                )
                match res:
                    case CallRes.In:
                        e.kind = ExprKind.Contains(a2[0].expr, r2, false)
                        return t
                    case _:
                        pass
                e.kind = ExprKind.MethodCall(r2, name, name_span, a2)
                e.cres = res
                return t
            case _:
                return Ty.Error

    fn check_method_inner(
        ref self,
        ref recv: Expr,
        name: str,
        name_span: Span,
        ref args: [Arg],
        ref res: CallRes,
        span: Span,
        exp: Option[Ty],
        targs: Option[[Ty]]
    ) -> Ty:
        # ---- qualified names: module.f(), world.op(), Struct.static(), Enum.Variant(...)
        var static_ty: Option[Ty] = None
        match recv.kind:
            case ExprKind.Ident(rname):
                if self.lookup_local(rname).is_none():
                    match self.item(rname):
                        case Some(Item.Module(m)):
                            recv.res = Res.Module(m)
                            match self.items[m].get(name):
                                case Some(Item.Fn(id)):
                                    res = CallRes.Fn(id)
                                    if self.in_spec:
                                        self.spec_err(span)
                                    let sig = self.info.fns[id]
                                    return self.check_args(sig, ref args, span, 0)
                                case Some(Item.Struct(sid)):
                                    res = CallRes.Ctor(sid)
                                    return self.check_ctor(sid, ref args, span)
                                case Some(Item.GenFn(g)):
                                    return self.call_generic_fn(
                                        g,
                                        None,
                                        ref args,
                                        ref res,
                                        span,
                                        exp
                                    )
                                case Some(Item.GenType(t)):
                                    return self.ctor_generic(t, None, ref args, ref res, span, exp)
                                case _:
                                    var d = diag.error(
                                        "E0201",
                                        f"module `{rname}` has no function `{name}`"
                                    ).label(name_span, "not found")
                                    match best_match(name, self.items[m].keys()):
                                        case Some(b):
                                            d = d.with_help(
                                                f"did you mean `{b}`?"
                                            ).fix(name_span, b, "replace")
                                        case None:
                                            pass
                                    self.err(d)
                                    self.check_all(ref args)
                                    return Ty.Error
                        case Some(Item.Struct(sid)):
                            recv.res = Res.Struct(sid)
                            static_ty = Some(Ty.Struct(sid))
                        case Some(Item.Enum(eid)):
                            recv.res = Res.Enum(eid)
                            static_ty = Some(Ty.Enum(eid))
                        case Some(Item.GenType(tid)):
                            return self.static_generic(
                                tid,
                                name,
                                name_span,
                                ref args,
                                ref res,
                                span,
                                exp,
                                targs
                            )
                        case None:
                            if rname == "world":
                                recv.res = Res.World
                                return self.check_world(
                                    name,
                                    name_span,
                                    ref args,
                                    ref res,
                                    exp,
                                    span
                                )
                            if rname == "os":
                                recv.res = Res.Os
                                return self.check_os(name, name_span, ref args, ref res, span)
                        case _:
                            pass
            case ExprKind.Field(base, sname, _):
                match base.kind:
                    case ExprKind.Ident(mname):
                        if self.lookup_local(mname).is_none():
                            match self.item(mname):
                                case Some(Item.Module(m)):
                                    match self.items[m].get(sname):
                                        case Some(Item.Struct(sid)):
                                            static_ty = Some(Ty.Struct(sid))
                                        case Some(Item.Enum(eid)):
                                            static_ty = Some(Ty.Enum(eid))
                                        case Some(Item.GenType(tid)):
                                            return self.static_generic(
                                                tid,
                                                name,
                                                name_span,
                                                ref args,
                                                ref res,
                                                span,
                                                exp,
                                                targs
                                            )
                                        case _:
                                            pass
                                case _:
                                    pass
                    case _:
                        pass
            case _:
                pass
        if static_ty.is_none():
            match self.applied_type(recv):
                case Some(t):
                    if t.is_error():
                        self.check_all(ref args)
                        return Ty.Error
                    static_ty = Some(t)
                case None:
                    pass
        match static_ty:
            case Some(Ty.Enum(eid)):
                for vi, v in enumerate(self.info.enums[eid].variants):
                    if v.name == name:
                        return self.construct_variant(eid, vi, ref args, ref res, span, name_span)
            case _:
                pass
        match static_ty:
            case Some(st):
                self.inst_method(st, name, span)
                if name == "from_int":
                    self.enum_from_int(st)
                let (tname, methods, _) = self.members(st)
                if name not in methods:
                    match self.generic_method(st, name):
                        case Some((gid, fixed)):
                            if self.takes_self(gid):
                                self.err(
                                    diag.error(
                                        "E0206",
                                        f"`{tname}.{name}` takes `self`; call it on a value"
                                    ).label(span, f"e.g. `x.{name}(...)`")
                                )
                                self.check_unchecked(ref args)
                                return Ty.Error
                            match self.generic_instance(gid, fixed, targs, ref args, span, exp, 0):
                                case Some(id):
                                    res = CallRes.Fn(id)
                                    let sig = self.info.fns[id]
                                    return self.check_args(sig, ref args, span, 0)
                                case None:
                                    return Ty.Error
                        case None:
                            pass
                if targs.is_some():
                    self.no_targs(name, span)
                match methods.get(name):
                    case Some(id):
                        let sig = self.info.fns[id]
                        if sig.has_self:
                            self.err(
                                diag.error(
                                    "E0206",
                                    f"`{tname}.{name}` takes `self`; call it on a value"
                                ).label(span, f"e.g. `x.{name}(...)`")
                            )
                            return sig.ret
                        if self.in_spec:
                            self.spec_err(span)
                        res = CallRes.Fn(id)
                        return self.check_args(sig, ref args, span, 0)
                    case None:
                        var d = diag.error(
                            "E0206",
                            f"`{tname}` has no method or variant `{name}`"
                        ).label(name_span, "unknown name")
                        var cands = methods.keys()
                        match st:
                            case Ty.Enum(eid):
                                for v in self.info.enums[eid].variants:
                                    cands.push(v.name)
                            case _:
                                pass
                        match best_match(name, cands):
                            case Some(b):
                                d = d.with_help(f"did you mean `{b}`?").fix(name_span, b, "replace")
                            case None:
                                pass
                        self.err(d)
                        self.check_all(ref args)
                        return Ty.Error
            case None:
                pass

        # ---- methods on values
        let rt = self.check_expr(ref recv, None)
        if targs.is_some():
            match rt:
                case Ty.Struct(_) | Ty.Enum(_) | Ty.Error:
                    pass
                case _:
                    self.no_targs(name, span)
        match rt:
            case Ty.Error:
                self.check_all(ref args)
                return Ty.Error
            case Ty.Map(k, v):
                return self.map_method(recv, k, v, name, name_span, ref args, ref res, span)
            case Ty.Array(el):
                return self.array_method(recv, el, name, name_span, ref args, ref res, span)
            case Ty.Str:
                return self.str_method(name, name_span, ref args, ref res, span)
            case Ty.Struct(_) | Ty.Enum(_):
                self.inst_method(rt, name, span)
                let (tname, methods, fields) = self.members(rt)
                var found = methods.get(name)
                if found.is_some() and targs.is_some():
                    self.no_targs(name, span)
                if found.is_none():
                    match self.generic_method(rt, name):
                        case Some((gid, fixed)):
                            if not self.takes_self(gid):
                                self.err(
                                    diag.error(
                                        "E0206",
                                        f"`{name}` is a static method; call it as `{tname}.{name}(...)`"
                                    ).label(name_span, "no `self` parameter")
                                )
                                self.check_unchecked(ref args)
                                return Ty.Error
                            found = self.generic_instance(gid, fixed, targs, ref args, span, exp, 1)
                            if found.is_none():
                                return Ty.Error
                        case None:
                            pass
                match found:
                    case Some(id):
                        let sig = self.info.fns[id]
                        if not sig.has_self:
                            self.err(
                                diag.error(
                                    "E0206",
                                    f"`{name}` is a static method; call it as `{tname}.{name}(...)`"
                                ).label(name_span, "no `self` parameter")
                            )
                            return sig.ret
                        if self.in_spec:
                            self.spec_err(span)
                        if sig.params[0].by_ref:
                            self.check_mutation_target(recv, f"call `ref self` method `{name}` on")
                        res = CallRes.Method(id)
                        let ret = self.check_args(sig, ref args, span, 1)
                        # by-value arguments are evaluated (and kept) before the call, so they may
                        # read the receiver; another `ref` to it would be a second live alias
                        if sig.params[0].by_ref:
                            match place_of(recv):
                                case Some((root, rpath, _)):
                                    for a in args:
                                        if a.by_ref and touches(a.expr, root, rpath):
                                            let n = self.locals[root].name
                                            self.err(
                                                diag.error(
                                                    "E0405",
                                                    f"`{n}` is changed by this method call and also passed as `ref`"
                                                )
                                                .label(a.expr.span, "second reference here")
                                                .note(
                                                    "a `ref` must be the only access to that variable during the call"
                                                )
                                                .with_help(
                                                    "pass separate fields of it (`s.a.f(ref s.b)`), or make the change in two steps"
                                                )
                                            )
                                case None:
                                    pass
                        return ret
                    case None:
                        var cands = methods.keys()
                        cands.extend(self.template_methods(rt))
                        var d = diag.error(
                            "E0206",
                            f"`{tname}` has no method `{name}`"
                        ).label(name_span, "unknown method")
                        if name in fields:
                            d = d.with_help(f"`{name}` is a field; access it without `()`")
                        else:
                            match best_match(name, cands):
                                case Some(b):
                                    d = d.with_help(
                                        f"did you mean `{b}`?"
                                    ).fix(name_span, b, "replace")
                                case None:
                                    pass
                        self.err(d)
                        self.check_all(ref args)
                        return Ty.Error
            case _:
                var d = diag.error(
                    "E0206",
                    self.tn(rt) + f" has no method `{name}`"
                ).label(name_span, "unknown method")
                if name == "len" or name == "length":
                    d = d.with_help("use `len(x)`")
                self.err(d)
                self.check_all(ref args)
                return Ty.Error

    # `Enum.Variant(args)` for a concrete enum.
    fn construct_variant(
        ref self,
        eid: int,
        vi: int,
        ref args: [Arg],
        ref res: CallRes,
        span: Span,
        name_span: Span
    ) -> Ty:
        let en = self.info.enums[eid]
        let v = en.variants[vi]
        let label = en.variant_label(vi)
        res = CallRes.Variant(eid, vi)
        if self.in_spec:
            self.spec_err(span)
        if len(v.fields) == 0:
            let sp = Span(file=span.file, lo=name_span.hi, hi=span.hi)
            self.err(
                diag.error("E0302", f"`{label}` has no fields")
                .label(span, f"write `{label}` without parentheses")
                .fix(sp, "", "remove `()`")
            )
            for i in 0..len(args):
                if args[i].expr.ty == Ty.Unknown:
                    self.check_expr(ref args[i].expr, None)
        else:
            self.check_field_args(label, v.fields, ref args, span)
        return Ty.Enum(eid)

    fn no_targs(ref self, name: str, span: Span):
        self.err(
            diag.error(
                "E0334",
                f"method `{name}` has no type parameters"
            ).label(span, "remove the type arguments")
        )

    # Name, methods and field names of a struct or enum type.
    fn members(self, t: Ty) -> (str, {str: int}, [str]):
        match t:
            case Ty.Struct(sid):
                let s = self.info.structs[sid]
                return (self.info.struct_names[sid], s.methods, [f.0 for f in s.fields])
            case Ty.Enum(eid):
                return (self.info.enum_names[eid], self.info.enums[eid].methods, [])
            case _:
                return ("", {}, [])

    fn msg_err(ref self, t: Ty, sp: Span):
        if not t.is_error() and not is_messageable(t):
            let tn = self.tn(t)
            self.err(
                diag.error("E0319", f"values of type {tn} can't be sent between processes yet")
                .label(sp, "not messageable")
                .note(
                    "messageable types: integers and floats of any width, bool, str, and arrays of those (e.g. [u8], [[float]], [str])"
                )
            )

    fn check_world(
        ref self,
        name: str,
        name_span: Span,
        ref args: [Arg],
        ref res: CallRes,
        exp: Option[Ty],
        span: Span
    ) -> Ty:
        var found: Option[WorldOp] = None
        for n, o in world_ops():
            if n == name:
                found = Some(o)
                break
        var op = WorldOp.Rank
        match found:
            case Some(o):
                op = o
            case None:
                if name == "send" or name == "recv":
                    self.err(
                        diag.error(
                            "E0512",
                            f"`world.{name}` doesn't exist: unmatched sends and receives can deadlock"
                        )
                        .label(name_span, "not available")
                        .with_help(
                            "every rank takes part in each communication: `world.shift(v, 1)` sends `v` to the next rank and returns the value from the previous one; `world.exchange(xs)` sends `xs[j]` to rank `j`"
                        )
                        .note(
                            "run `brine explain E0512` for how to express point-to-point patterns"
                        )
                    )
                    self.check_all(ref args)
                    return Ty.Error
                var d = diag.error(
                    "E0206",
                    f"`world` has no function `{name}`"
                ).label(name_span, "unknown")
                match best_match(name, [x.0 for x in world_ops()]):
                    case Some(b):
                        d = d.with_help(f"did you mean `world.{b}`?").fix(name_span, b, "replace")
                    case None:
                        d = d.note(
                            "world functions: rank, size, barrier, broadcast, sum, min, max, any, all, gather_all, shift, exchange"
                        )
                self.err(d)
                return Ty.Error
        res = CallRes.World(op)
        if self.in_spec:
            self.spec_err(span)
        if len(self.par_stack) > 0:
            self.err(
                diag.error("E0503", "`world` operations can't be used inside a `par` body")
                .label(span, "not allowed here")
                .with_help("communicate before or after the parallel section")
            )
        let wname = f"world.{name}"
        match op:
            case WorldOp.Rank | WorldOp.Size:
                self.nargs(wname, ref args, 0, span)
                return int_ty()
            case WorldOp.Barrier:
                self.nargs(wname, ref args, 0, span)
                return Ty.Unit
            case WorldOp.Shift:
                if len(args) < 2 or len(args) > 3:
                    self.err(
                        diag.error(
                            "E0302",
                            f"`world.shift` takes 2 or 3 arguments but {len(args)} were given"
                        )
                        .label(span, "wrong number of arguments")
                        .with_help(
                            "`world.shift(v, by)` wraps around; `world.shift(v, by, edge)` doesn't: a rank with nothing to receive (no rank `by` before it) gets `edge`"
                        )
                    )
                    self.check_all(ref args)
                    return Ty.Error
                let vt = self.check_expr(ref args[0].expr, exp)
                self.msg_err(vt, args[0].expr.span)
                if len(args) == 3:
                    let et = self.check_expr(ref args[2].expr, Some(vt))
                    if not et.is_error() and not vt.is_error() and et != vt:
                        let en = self.tn(et)
                        let vn = self.tn(vt)
                        self.err(
                            diag.error(
                                "E0301",
                                f"the edge value of `world.shift` must have the type of the value shifted ({vn}), found {en}"
                            ).label(args[2].expr.span, f"expected {vn}")
                        )
                let t = self.check_expr(ref args[1].expr, Some(int_ty()))
                if not t.is_error() and t != int_ty():
                    self.err(
                        diag.error(
                            "E0301",
                            "the shift distance must be an `int`"
                        ).label(args[1].expr.span, "not an int")
                    )
                return vt
            case WorldOp.Exchange:
                if not self.nargs(wname, ref args, 1, span):
                    return Ty.Error
                let t = self.check_expr(ref args[0].expr, exp)
                match t:
                    case Ty.Array(el):
                        self.msg_err(el, args[0].expr.span)
                    case _:
                        if not t.is_error():
                            let tn = self.tn(t)
                            self.err(
                                diag.error(
                                    "E0301",
                                    f"`world.exchange` takes an array with one element per rank, found {tn}"
                                ).label(args[0].expr.span, "not an array")
                            )
                return t
            case WorldOp.Broadcast:
                if not self.nargs(wname, ref args, 2, span):
                    return Ty.Error
                let t = self.check_expr(ref args[0].expr, Some(int_ty()))
                if not t.is_error() and t != int_ty():
                    self.err(
                        diag.error(
                            "E0301",
                            "root rank must be an `int`"
                        ).label(args[0].expr.span, "not an int")
                    )
                let vt = self.check_expr(ref args[1].expr, exp)
                self.msg_err(vt, args[1].expr.span)
                return vt
            case WorldOp.Sum | WorldOp.Min | WorldOp.Max:
                if not self.nargs(wname, ref args, 1, span):
                    return Ty.Error
                let t = self.check_expr(ref args[0].expr, exp)
                var ok = t == int_ty() or t == float_ty()
                match t:
                    case Ty.Array(el):
                        ok = el == int_ty() or el == float_ty()
                    case _:
                        pass
                if not t.is_error() and not ok:
                    self.err(
                        diag.error(
                            "E0319",
                            f"`{wname}` works on `int`, `float`, `[int]` or `[float]` (element by element), found "
                            + self.tn(t)
                        ).label(args[0].expr.span, "unsupported type")
                    )
                return t
            case WorldOp.Any | WorldOp.All:
                if not self.nargs(wname, ref args, 1, span):
                    return Ty.Error
                let t = self.check_expr(ref args[0].expr, Some(Ty.Bool))
                if not t.is_error() and t != Ty.Bool:
                    self.err(
                        diag.error(
                            "E0319",
                            f"`{wname}` works on `bool`, found " + self.tn(t)
                        ).label(args[0].expr.span, "not a bool")
                    )
                return Ty.Bool
            case WorldOp.GatherAll:
                if not self.nargs(wname, ref args, 1, span):
                    return Ty.Error
                var ex: Option[Ty] = None
                match exp:
                    case Some(Ty.Array(el)):
                        ex = Some(el)
                    case _:
                        pass
                let t = self.check_expr(ref args[0].expr, ex)
                self.msg_err(t, args[0].expr.span)
                return Ty.Array(t)

    # `os.name(args)`: files, directories and processes.
    fn check_os(
        ref self,
        name: str,
        name_span: Span,
        ref args: [Arg],
        ref res: CallRes,
        span: Span
    ) -> Ty:
        var found: Option[OsOp] = None
        for n, o in os_ops():
            if n == name:
                found = Some(o)
                break
        var op = OsOp.Cwd
        match found:
            case Some(o):
                op = o
            case None:
                let names = [x.0 for x in os_ops()]
                var d = diag.error(
                    "E0206",
                    f"`os` has no function `{name}`"
                ).label(name_span, "unknown")
                match best_match(name, names):
                    case Some(b):
                        d = d.with_help(f"did you mean `os.{b}`?").fix(name_span, b, "replace")
                    case None:
                        d = d.note("os functions: " + ", ".join(names))
                self.err(d)
                self.check_all(ref args)
                return Ty.Error
        res = CallRes.Os(op)
        if self.in_spec:
            self.spec_err(span)
        let oname = f"os.{name}"
        if op.has_effects() and len(self.par_stack) > 0:
            self.err(
                diag.error("E0503", f"`{oname}` can't be called inside a `par` body")
                .label(span, "not allowed here")
                .with_help(
                    "its effects would happen in an unpredictable order; do it before or after the `par`"
                )
            )
        let strs = Ty.Array(Ty.Str)
        match op:
            case OsOp.ListDir:
                self.builtin_args(oname, ref args, [Ty.Str], span)
                return self.result_of(strs, Ty.Str, span)
            case OsOp.IsDir | OsOp.IsFile:
                self.builtin_args(oname, ref args, [Ty.Str], span)
                return Ty.Bool
            case OsOp.MakeDir | OsOp.RemoveFile | OsOp.SetCwd:
                self.builtin_args(oname, ref args, [Ty.Str], span)
                return self.result_of(Ty.Unit, Ty.Str, span)
            case OsOp.Rename:
                self.builtin_args(oname, ref args, [Ty.Str, Ty.Str], span)
                return self.result_of(Ty.Unit, Ty.Str, span)
            case OsOp.WriteBytes:
                self.builtin_args(oname, ref args, [Ty.Str, Ty.Array(Ty.Int(IntTy.U8))], span)
                return self.result_of(Ty.Unit, Ty.Str, span)
            case OsOp.Cwd | OsOp.ExePath | OsOp.TempDir | OsOp.Name | OsOp.Arch:
                self.nargs(oname, ref args, 0, span)
                return Ty.Str
            case OsOp.AbsPath:
                self.builtin_args(oname, ref args, [Ty.Str], span)
                return self.result_of(Ty.Str, Ty.Str, span)
            case OsOp.Pid | OsOp.CpuCount | OsOp.ThreadCount:
                self.nargs(oname, ref args, 0, span)
                return int_ty()
            case OsOp.Sleep:
                self.builtin_args(oname, ref args, [float_ty()], span)
                return Ty.Unit
            case OsOp.IsTerminal:
                self.builtin_args(oname, ref args, [int_ty()], span)
                return Ty.Bool
            case OsOp.EnableAnsi:
                self.nargs(oname, ref args, 0, span)
                return Ty.Unit
            case OsOp.FreePorts:
                self.builtin_args(oname, ref args, [int_ty()], span)
                return self.result_of(Ty.Array(int_ty()), Ty.Str, span)
            case OsOp.Spawn:
                self.builtin_args(
                    oname,
                    ref args,
                    [strs, Ty.Map(Ty.Str, Ty.Str), Ty.Bool, Ty.Bool],
                    span
                )
                return self.result_of(int_ty(), Ty.Str, span)
            case OsOp.Wait:
                self.builtin_args(oname, ref args, [int_ty()], span)
                return int_ty()
            case OsOp.Poll:
                self.builtin_args(oname, ref args, [int_ty()], span)
                return self.option_of(int_ty(), span)
            case OsOp.Kill:
                self.builtin_args(oname, ref args, [int_ty()], span)
                return Ty.Unit
            case OsOp.Output:
                self.builtin_args(oname, ref args, [int_ty()], span)
                return Ty.Tuple([Ty.Str, Ty.Str])

    # `embed("file")`: replaces the path literal with the file's contents.
    fn check_embed(ref self, ref args: [Arg], span: Span):
        if not self.nargs("embed", ref args, 1, span):
            return
        let lit = args[0].expr.span
        match self.embedded.get(lit):
            case Some(t):
                args[0].expr.kind = ExprKind.Str(t)
                args[0].expr.ty = Ty.Str
                return
            case None:
                pass
        var rel = ""
        match args[0].expr.kind:
            case ExprKind.Str(s):
                rel = s
            case _:
                self.check_expr(ref args[0].expr, Some(Ty.Str))
                self.err(
                    diag.error("E0707", "`embed` needs a string literal")
                    .label(args[0].expr.span, "not a literal")
                    .with_help(
                        "the file is read when the program is compiled, so write its path out: `embed(\"notes.txt\")`"
                    )
                )
                return
        let dir = self.src_dirs.get(lit.file, ".")
        let path = path_join(dir, rel)
        var shown = path.replace("\\", "/")
        if shown.starts_with("./"):
            shown = shown[2:]
        var text = ""
        match read_file(path):
            case Ok(t):
                text = t.replace("\r\n", "\n")
            case Err(msg):
                if msg.ends_with("the file is not valid UTF-8 text"):
                    self.err(
                        diag.error(
                            "E0707",
                            f"cannot embed `{rel}`: the file is not valid UTF-8 text"
                        ).label(lit, f"read from `{shown}`")
                    )
                else:
                    var d = diag.error("E0707", f"cannot embed `{rel}`")
                    if not file_exists(path):
                        d = d.label(lit, f"no file at `{shown}`").with_help(
                            "the path is relative to the directory of the file that contains the `embed`"
                        )
                    else:
                        # the runtime's message is "cannot read <path>: <reason>"
                        let pre = f"cannot read {path}: "
                        let why = msg[len(pre):] if msg.starts_with(pre) else msg
                        d = d.label(lit, f"`{shown}`: {why}")
                    self.err(d)
        self.embedded[lit] = text
        args[0].expr.kind = ExprKind.Str(text)
        args[0].expr.ty = Ty.Str

    # ------------------------------------------------------------ methods of built-in types
    # Checks `args` against `tys` (count and types).
    fn typed_args(ref self, name: str, ref args: [Arg], tys: [Ty], span: Span) -> bool:
        if not self.nargs(name, ref args, len(tys), span):
            return false
        for i in 0..len(args):
            self.check_expr(ref args[i].expr, Some(tys[i]))
            self.expect_ty(tys[i], args[i].expr)
        return true

    fn str_method(
        ref self,
        name: str,
        name_span: Span,
        ref args: [Arg],
        ref res: CallRes,
        span: Span
    ) -> Ty:
        let strs = Ty.Array(Ty.Str)
        var m = StrM.Find
        var params: [Ty] = []
        var ret = Ty.Str
        match name:
            case "find":
                m = StrM.Find
                params = [Ty.Str]
                ret = self.option_of(int_ty(), span)
            case "split":
                if len(args) == 0:
                    m = StrM.SplitWs
                else:
                    m = StrM.Split
                    params = [Ty.Str]
                ret = strs
            case "join":
                m = StrM.Join
                params = [strs]
            case "starts_with":
                m = StrM.StartsWith
                params = [Ty.Str]
                ret = Ty.Bool
            case "ends_with":
                m = StrM.EndsWith
                params = [Ty.Str]
                ret = Ty.Bool
            case "strip":
                m = StrM.Strip
            case "lstrip":
                m = StrM.LStrip
            case "rstrip":
                m = StrM.RStrip
            case "replace":
                m = StrM.Replace
                params = [Ty.Str, Ty.Str]
            case "upper":
                m = StrM.Upper
            case "lower":
                m = StrM.Lower
            case "lines":
                m = StrM.Lines
                ret = strs
            case "is_digit":
                m = StrM.IsDigit
                ret = Ty.Bool
            case "is_alpha":
                m = StrM.IsAlpha
                ret = Ty.Bool
            case "is_space":
                m = StrM.IsSpace
                ret = Ty.Bool
            case "is_alnum":
                m = StrM.IsAlnum
                ret = Ty.Bool
            case "count":
                m = StrM.Count
                params = [Ty.Str]
                ret = int_ty()
            case "bytes":
                m = StrM.Bytes
                ret = Ty.Array(Ty.Int(IntTy.U8))
            case "chars":
                m = StrM.Chars
                ret = strs
            case "repeat":
                m = StrM.Repeat
                params = [int_ty()]
            case "contains":
                return self.contains_method(name, ref args, ref res, Ty.Str, span)
            case _:
                var d = diag.error(
                    "E0206",
                    f"strings have no method `{name}`"
                ).label(name_span, "unknown method")
                var to = ""
                for from_, t in str_renames():
                    if from_ == name:
                        to = t
                        break
                if to != "":
                    d = d.with_help(f"use `{to}`").fix(name_span, to, f"replace with `{to}`")
                else:
                    match name:
                        case "len" | "length" | "size":
                            d = d.with_help("use `len(s)`")
                        case "format":
                            d = d.with_help("use an f-string: f\"x = {x}\"")
                        case _:
                            d = d.note(
                                "string methods: find, contains, split, join, starts_with, ends_with, strip, lstrip, rstrip, replace, upper, lower, lines, is_digit, is_alpha, is_space, is_alnum, count, bytes, chars, repeat"
                            )
                self.err(d)
                self.check_all(ref args)
                return Ty.Error
        if self.in_spec:
            self.spec_err(span)
        res = CallRes.Builtin(Builtin.Str(m))
        self.typed_args(name, ref args, params, span)
        return ret

    # `s.contains(sub)` and `xs.contains(x)` mean `sub in s` and `x in xs`.
    fn contains_method(
        ref self,
        name: str,
        ref args: [Arg],
        ref res: CallRes,
        want: Ty,
        span: Span
    ) -> Ty:
        if not self.typed_args(name, ref args, [want], span):
            return Ty.Error
        if not equatable(want):
            self.err(
                diag.error(
                    "E0301",
                    "cannot compare values of type " + self.tn(want)
                ).label(args[0].expr.span, "not comparable")
            )
            return Ty.Error
        res = CallRes.In
        return Ty.Bool

    fn array_method(
        ref self,
        recv: Expr,
        el: Ty,
        name: str,
        name_span: Span,
        ref args: [Arg],
        ref res: CallRes,
        span: Span
    ) -> Ty:
        if name == "contains":
            return self.contains_method(name, ref args, ref res, el, span)
        if self.in_spec:
            self.spec_err(span)
        let arr = Ty.Array(el)
        var b = Builtin.Push
        var params: [Ty] = []
        var ret = Ty.Unit
        var verb = ""
        match name:
            case "push":
                b = Builtin.Push
                params = [el]
                verb = "push to"
            case "pop":
                if len(args) == 1:
                    b = Builtin.PopAt
                    params = [int_ty()]
                else:
                    b = Builtin.Pop
                ret = el
                verb = "pop from"
            case "insert":
                b = Builtin.Insert
                params = [int_ty(), el]
                verb = "insert into"
            case "extend":
                b = Builtin.Extend
                params = [arr]
                verb = "extend"
            case "sort":
                b = Builtin.Sort
                verb = "sort"
            case "reverse":
                b = Builtin.Reverse
                verb = "reverse"
            case "clear":
                b = Builtin.Clear
                verb = "clear"
            case "index":
                b = Builtin.IndexOf
                params = [el]
                ret = self.option_of(int_ty(), span)
            case _:
                var d = diag.error(
                    "E0206",
                    f"arrays have no method `{name}`"
                ).label(name_span, "unknown method")
                match name:
                    case "append" | "add" | "push_back":
                        d = d.with_help(
                            "use `xs.push(x)`"
                        ).fix(name_span, "push", "replace with `push`")
                    case "len" | "length" | "size" | "count":
                        d = d.with_help("use `len(xs)`")
                    case "remove" | "remove_at" | "delete":
                        d = d.with_help("use `xs.pop(i)` to remove the element at index `i`")
                    case "find":
                        d = d.with_help(
                            "use `xs.index(x)`"
                        ).fix(name_span, "index", "replace with `index`")
                    case "sorted" | "sort_by":
                        d = d.with_help("use `xs.sort()` on a `var` copy")
                    case _:
                        d = d.note(
                            "array methods: push(x), pop(), pop(i), insert(i, x), extend(ys), index(x), contains(x), sort(), reverse(), clear()"
                        )
                self.err(d)
                self.check_all(ref args)
                return Ty.Error
        res = CallRes.Builtin(b)
        if verb != "":
            self.check_mutation_target(recv, verb)
        self.typed_args(name, ref args, params, span)
        if b == Builtin.Sort and not el.is_error() and not orderable(self.info, el):
            self.not_orderable(el, span, "arrays of " + self.tn(el) + " can't be sorted")
        if b == Builtin.IndexOf and not equatable(el):
            self.err(
                diag.error(
                    "E0305",
                    "values of type " + self.tn(el) + " can't be compared"
                ).label(span, "not comparable")
            )
        return ret

    # ============================================================ generics
    # Generic declarations are templates. Each use with concrete types makes a
    # copy (an instance) that is checked like ordinary code, so the prover and
    # the code generator only ever see concrete types.

    # Moves generic structs, enums and functions of module `mi` out of the
    # module and into the template tables.
    fn register_generics(ref self, mi: int, ref m: Module, ref items: {str: (Item, Span)}):
        var owners: {str: int} = {}
        let bare = m.name == PRELUDE
        var structs: [StructDecl] = []
        for s in m.structs:
            if len(s.tparams) == 0:
                structs.push(s)
                continue
            let id = len(self.gtypes)
            owners[s.name] = id
            self.insert_item(ref items, s.name, Item.GenType(id), s.span)
            self.gtypes.push(
                GenType(
                    name=s.name,
                    module=mi,
                    tparams=[p.0 for p in s.tparams],
                    sdecl=Some(s),
                    edecl=None,
                    methods={},
                    bare=false,
                    insts={}
                )
            )
        m.structs = structs
        var enums: [EnumDecl] = []
        for e in m.enums:
            if len(e.tparams) == 0:
                enums.push(e)
                continue
            let id = len(self.gtypes)
            owners[e.name] = id
            self.insert_item(ref items, e.name, Item.GenType(id), e.span)
            if bare:
                for vi, v in enumerate(e.variants):
                    self.insert_item(ref items, v.name, Item.GenVariant(id, vi), v.span)
            self.gtypes.push(
                GenType(
                    name=e.name,
                    module=mi,
                    tparams=[p.0 for p in e.tparams],
                    sdecl=None,
                    edecl=Some(e),
                    methods={},
                    bare=bare,
                    insts={}
                )
            )
        m.enums = enums
        var fns: [FnDecl] = []
        for f in m.fns:
            var owner: Option[int] = None
            match f.method_of:
                case Some(o):
                    owner = owners.get(o)
                case None:
                    pass
            if len(f.tparams) == 0 and owner.is_none():
                fns.push(f)
                continue
            let gid = len(self.gfns)
            # a method's own type parameters follow its type's: `fn Box[T].map[U]` has [T, U]
            var tparams: [str] = []
            match owner:
                case Some(t):
                    tparams = self.gtypes[t].tparams
                case None:
                    pass
            let n_owner = len(tparams)
            for p, sp in f.tparams:
                if p in tparams[:n_owner]:
                    let tname = f.method_of.unwrap_or("")
                    self.err(
                        diag.error(
                            "E0331",
                            f"type parameter `{p}` is already a type parameter of `{tname}`"
                        )
                        .label(sp, "declared again here")
                        .with_help(
                            "the method can use the type's parameter directly; or pick another name"
                        )
                    )
            for p in f.tparams:
                tparams.push(p.0)
            match owner:
                case Some(t):
                    let tname = self.gtypes[t].name
                    var clash: Option[Span] = None
                    match self.gtypes[t].edecl:
                        case Some(ed):
                            for v in ed.variants:
                                if v.name == f.name:
                                    clash = Some(v.span)
                                    break
                        case None:
                            pass
                    let had = f.name in self.gtypes[t].methods
                    self.gtypes[t].methods[f.name] = gid
                    if had:
                        self.err(
                            diag.error(
                                "E0202",
                                f"method `{f.name}` is defined twice on `{tname}`"
                            ).label(f.name_span, "duplicate method")
                        )
                    match clash:
                        case Some(vs):
                            self.err(
                                diag.error(
                                    "E0202",
                                    f"`{f.name}` is both a variant and a method of `{tname}`"
                                )
                                .label(f.name_span, "method")
                                .label(vs, "variant")
                            )
                        case None:
                            pass
                case None:
                    match f.method_of:
                        # a generic method of an ordinary type
                        case Some(tname):
                            let key = (mi, tname)
                            if key not in self.cgmethods:
                                self.cgmethods[key] = {}
                            let had = f.name in self.cgmethods[key]
                            self.cgmethods[key][f.name] = gid
                            if had:
                                self.err(
                                    diag.error(
                                        "E0202",
                                        f"method `{f.name}` is defined twice on `{tname}`"
                                    ).label(f.name_span, "duplicate method")
                                )
                        case None:
                            self.insert_item(ref items, f.name, Item.GenFn(gid), f.name_span)
            self.gfns.push(
                GenFn(module=mi, tparams=tparams, decl=f, owner=owner, n_owner=n_owner, insts={})
            )
        m.fns = fns

    # Makes the prelude's items visible in every module (a module's own items win).
    fn import_prelude(ref self):
        var pm = -1
        for i, n in enumerate(self.info.module_names):
            if n == PRELUDE:
                pm = i
                break
        if pm < 0:
            return
        var exported: [(str, Item)] = []
        for k, v in self.items[pm].items():
            match v:
                case Item.Module(_):
                    pass
                case _:
                    exported.push((k, v))
        for mi in 0..len(self.items):
            if mi != pm:
                for k, v in exported:
                    if k not in self.items[mi]:
                        self.items[mi][k] = v

    # ------------------------------------------------------------ instances
    # Enter a template's module with the given type parameters; `leave` undoes it.
    fn enter(ref self, module: int, env: {str: Ty}) -> (int, {str: Ty}):
        let saved = (self.cur_mod, self.tenv)
        self.cur_mod = module
        self.tenv = env
        return saved

    fn leave(ref self, saved: (int, {str: Ty})):
        self.cur_mod = saved.0
        self.tenv = saved.1

    fn can_instantiate(ref self, span: Span) -> bool:
        self.ninst += 1
        if self.ninst == MAX_INSTANCES + 1:
            self.err(
                diag.error("E0333", "too many generic instances")
                .label(span, "while making this one")
                .note(
                    "a generic function or type probably uses itself with ever larger types, like `f[[T]]` inside `f[T]`"
                )
            )
        return self.ninst <= MAX_INSTANCES

    fn targs_name(self, tparams: [str], args: [Ty]) -> str:
        var parts: [str] = []
        for i in 0..min(len(tparams), len(args)):
            parts.push(tparams[i] + " = " + self.info.ty_name(args[i]))
        return ", ".join(parts)

    # `Name[args]`: checks the number of arguments, then instantiates.
    fn apply(ref self, tid: int, args: [Ty], span: Span) -> Ty:
        let g = self.gtypes[tid]
        if len(args) != len(g.tparams):
            let n = len(g.tparams)
            let na = len(args)
            self.err(
                diag.error(
                    "E0334",
                    f"`{g.name}` takes {n} type argument{plural(n)} but {na} "
                    + ("was" if na == 1 else "were")
                    + " given"
                )
                .label(span, "wrong number of type arguments")
                .note(f"declared as `{g.name}[" + ", ".join(g.tparams) + "]`")
            )
            return Ty.Error
        return self.inst_type(tid, args, span)

    # The struct or enum `tid` with concrete type arguments.
    fn inst_type(ref self, tid: int, args: [Ty], span: Span) -> Ty:
        if any(t.is_error() for t in args):
            return Ty.Error
        let is_enum = self.gtypes[tid].edecl.is_some()
        match self.gtypes[tid].insts.get(args):
            case Some(id):
                return Ty.Enum(id) if is_enum else Ty.Struct(id)
            case None:
                pass
        if not self.can_instantiate(span):
            return Ty.Error
        let g = self.gtypes[tid]
        let display = g.name + "[" + ", ".join([self.info.ty_name(t) for t in args]) + "]"
        let c_name = (
            mangle_module(self.info.module_names[g.module]) + "__" + g.name + "__" + f"{self.ninst}"
        )
        var env: {str: Ty} = {}
        for i in 0..min(len(g.tparams), len(args)):
            env[g.tparams[i]] = args[i]
        let origin = Some((tid, args))
        var id = 0
        if is_enum:
            let ed = g.edecl.unwrap()
            self.info.enums.push(
                EnumInfo(
                    name=g.name,
                    module=g.module,
                    variants=[],
                    methods={},
                    span=ed.span,
                    c_name=c_name,
                    origin=origin,
                    bare=g.bare
                )
            )
            self.info.enum_names.push(display)
            id = len(self.info.enums) - 1
        else:
            let sd = g.sdecl.unwrap()
            self.info.structs.push(
                StructInfo(
                    name=g.name,
                    module=g.module,
                    fields=[],
                    methods={},
                    span=sd.span,
                    c_name=c_name,
                    origin=origin
                )
            )
            self.info.struct_names.push(display)
            id = len(self.info.structs) - 1
        self.gtypes[tid].insts[args] = id
        let saved = self.enter(g.module, env)
        match g.edecl:
            case Some(ed):
                let vs = self.resolve_variants(ed)
                self.info.enums[id].variants = vs
            case None:
                pass
        match g.sdecl:
            case Some(sd):
                let fs = self.resolve_fields(sd.fields)
                self.info.structs[id].fields = fs
            case None:
                pass
        self.leave(saved)
        return Ty.Enum(id) if is_enum else Ty.Struct(id)

    # The function `gid` with concrete type arguments; its body is checked later.
    fn inst_fn(ref self, gid: int, args: [Ty], span: Span) -> Option[int]:
        if any(t.is_error() for t in args):
            return None
        match self.gfns[gid].insts.get(args):
            case Some(id):
                return Some(id)
            case None:
                pass
        let g = self.gfns[gid]
        let module = g.module
        # a method with type parameters of its own has an instance per use, not one per type
        let own_tparams = len(g.tparams) > g.n_owner
        var decl = g.decl
        var env: {str: Ty} = {}
        for i in 0..min(len(g.tparams), len(args)):
            env[g.tparams[i]] = args[i]
        let what = f"`{decl.name}` with " + self.targs_name(g.tparams, args)
        var method_of: Option[Ty] = None
        match g.owner:
            case Some(t):
                let it = self.inst_type(t, args[:g.n_owner], span)
                if it == Ty.Error:
                    return None
                method_of = Some(it)
            case None:
                match decl.method_of:
                    case Some(o):
                        match self.items[module].get(o):
                            case Some(Item.Struct(s)):
                                method_of = Some(Ty.Struct(s))
                            case Some(Item.Enum(e)):
                                method_of = Some(Ty.Enum(e))
                            case _:
                                pass
                    case None:
                        pass
        match self.gfns[gid].insts.get(args):
            case Some(id):
                return Some(id)
            case None:
                pass
        if not self.can_instantiate(span):
            return None
        let id = len(self.info.fns)
        decl.id = id
        let mm = mangle_module(self.info.module_names[module])
        var c_name = f"{mm}__{decl.name}__{id}"
        match decl.method_of:
            case Some(o):
                c_name = f"{mm}__{o}__{decl.name}__{id}"
            case None:
                pass
        self.info.fns.push(
            FnSig(
                name=decl.name,
                module=module,
                idx=0,
                params=[],
                ret=Ty.Unit,
                c_name=c_name,
                is_extern=false,
                method_of=method_of,
                has_self=false,
                span=decl.name_span
            )
        )
        self.gfns[gid].insts[args] = id
        if not own_tparams:
            match method_of:
                case Some(Ty.Struct(s)):
                    self.info.structs[s].methods[decl.name] = id
                case Some(Ty.Enum(e)):
                    self.info.enums[e].methods[decl.name] = id
                case _:
                    pass
        let saved = self.enter(module, env)
        let (params, ret, has_self) = self.resolve_sig(decl, id)
        self.leave(saved)
        self.info.fns[id].params = params
        self.info.fns[id].ret = ret
        self.info.fns[id].has_self = has_self
        self.pending.push(Pending(module=module, env=env, decl=decl, what=what))
        return Some(id)

    # `Color.from_int(i)` on an enum without data: made on first use, as
    # `match i: case 0: return Some(Color.Red) ... case _: return None`.
    fn enum_from_int(ref self, t: Ty):
        var eid = 0
        match t:
            case Ty.Enum(e):
                eid = e
            case _:
                return
        let en = self.info.enums[eid]
        if "from_int" in en.methods or en.has_payload() or en.origin.is_some():
            return
        let sp = en.span
        var cases: [Case] = []
        for vi, v in enumerate(en.variants):
            let val = mk(ExprKind.Field(mk(ExprKind.Ident(en.name), sp), v.name, sp), sp)
            let some = mk(
                ExprKind.Call(
                    mk(ExprKind.Ident("Some"), sp),
                    [Arg(by_ref=false, name=None, expr=val)]
                ),
                sp
            )
            let body = Block(stmts=[stmt(StmtKind.Return(Some(some)), sp)], span=sp)
            cases.push(Case(pat=pattern(PatKind.Int(i128(vi)), sp), guard=None, body=body, span=sp))
        let none = stmt(StmtKind.Return(Some(mk(ExprKind.Ident("None"), sp))), sp)
        cases.push(
            Case(
                pat=pattern(PatKind.Wild, sp),
                guard=None,
                body=Block(stmts=[none], span=sp),
                span=sp
            )
        )
        let m = stmt(StmtKind.Match(mk(ExprKind.Ident("i"), sp), cases), sp)
        let id = len(self.info.fns)
        let decl = FnDecl(
            name="from_int",
            name_span=sp,
            params=[Param(name="i", span=sp, ty=None, by_ref=false, mutable=false)],
            ret=None,
            requires=[],
            ensures=[],
            body=Block(stmts=[m], span=sp),
            span=sp,
            is_extern=false,
            method_of=Some(en.name),
            tparams=[],
            test_name=None,
            id=id,
            locals=[],
            param_locals=[],
            result_local=None
        )
        let ret = self.option_of(t, sp)
        let mm = mangle_module(self.info.module_names[en.module])
        self.info.fns.push(
            FnSig(
                name="from_int",
                module=en.module,
                idx=0,
                params=[ParamSig(name="i", ty=Ty.Int(IntTy.I64), by_ref=false)],
                ret=ret,
                c_name=f"{mm}__{en.name}__from_int",
                is_extern=false,
                method_of=Some(t),
                has_self=false,
                span=sp
            )
        )
        self.info.enums[eid].methods["from_int"] = id
        self.pending.push(
            Pending(module=en.module, env={}, decl=decl, what=f"`{en.name}.from_int`")
        )

    # Checks the bodies of all instances made so far (which may make more).
    fn check_pending(ref self, ref prog: Program):
        while len(self.pending) > 0:
            let p = self.pending.pop()
            var decl = p.decl
            let sig = self.info.fns[decl.id]
            let before = len(self.diags)
            let saved = self.enter(p.module, p.env)
            self.check_fn(ref decl, sig.params, sig.ret)
            self.leave(saved)
            for i in before..len(self.diags):
                self.diags[i].notes.push(f"in {p.what}")
            self.info.fns[decl.id].idx = len(prog.modules[p.module].fns)
            prog.modules[p.module].fns.push(decl)

    # Makes sure method `name` of a generic type's instance exists.
    fn inst_method(ref self, t: Ty, name: str, span: Span):
        var origin: Option[(int, [Ty])] = None
        var has = true
        match t:
            case Ty.Struct(s):
                origin = self.info.structs[s].origin
                has = name in self.info.structs[s].methods
            case Ty.Enum(e):
                origin = self.info.enums[e].origin
                has = name in self.info.enums[e].methods
            case _:
                pass
        if has:
            return
        match origin:
            case Some((tid, args)):
                match self.gtypes[tid].methods.get(name):
                    case Some(gid):
                        if len(self.gfns[gid].tparams) == self.gfns[gid].n_owner:
                            self.inst_fn(gid, args, span)
                    case None:
                        pass
            case None:
                pass

    fn type_key(self, t: Ty) -> Option[(int, str)]:
        match t:
            case Ty.Struct(s):
                return Some((self.info.structs[s].module, self.info.structs[s].name))
            case Ty.Enum(e):
                return Some((self.info.enums[e].module, self.info.enums[e].name))
            case _:
                return None

    # The method `name` of `t` that has type parameters of its own, with the
    # type arguments `t` already fixes (those of a generic type's instance).
    fn generic_method(self, t: Ty, name: str) -> Option[(int, [Ty])]:
        match self.origin(t):
            case Some((tid, args)):
                let gid = self.gtypes[tid].methods.get(name)?
                let g = self.gfns[gid]
                if len(g.tparams) > g.n_owner:
                    return Some((gid, args))
                return None
            case None:
                pass
        let key = self.type_key(t)?
        let ms = self.cgmethods.get(key)?
        let g = ms.get(name)?
        return Some((g, []))

    # Whether generic function `gid` is a method taking `self`.
    fn takes_self(self, gid: int) -> bool:
        let d = self.gfns[gid].decl
        return d.method_of.is_some() and len(d.params) > 0 and d.params[0].ty.is_none()

    # Method names of a generic type's template, and generic methods (for suggestions).
    fn template_methods(self, t: Ty) -> [str]:
        match self.origin(t):
            case Some((tid, _)):
                return self.gtypes[tid].methods.keys()
            case None:
                match self.type_key(t):
                    case Some(key):
                        match self.cgmethods.get(key):
                            case Some(m):
                                return m.keys()
                            case None:
                                return []
                    case None:
                        return []

    fn origin(self, t: Ty) -> Option[(int, [Ty])]:
        match t:
            case Ty.Struct(s):
                return self.info.structs[s].origin
            case Ty.Enum(e):
                return self.info.enums[e].origin
            case _:
                return None

    # The instance of generic enum `tid` that `t` is, if it is one.
    fn enum_instance(self, tid: int, t: Ty) -> Option[int]:
        match t:
            case Ty.Enum(e):
                match self.info.enums[e].origin:
                    case Some((x, _)):
                        if x == tid:
                            return Some(e)
                    case None:
                        pass
            case _:
                pass
        return None

    # ------------------------------------------------------------ inference
    # Binds type parameters by matching a declared type against an actual one.
    fn unify(self, te: TypeExpr, actual: Ty, tparams: [str], module: int, ref sub: [Option[Ty]]):
        match te:
            case TypeExpr.Named(path, args, _):
                if len(args) == 0:
                    if len(path) == 1:
                        for i, p in enumerate(tparams):
                            if p == path[0]:
                                if sub[i].is_none() and actual != Ty.Unknown:
                                    sub[i] = Some(actual)
                                break
                    return
                match self.item_at(module, path):
                    case Some(Item.GenType(tid)):
                        match self.origin(actual):
                            case Some((at, aargs)):
                                if tid == at:
                                    for i in 0..min(len(args), len(aargs)):
                                        self.unify(args[i], aargs[i], tparams, module, ref sub)
                            case None:
                                pass
                    case _:
                        pass
            case TypeExpr.Array(elem, _):
                match actual:
                    case Ty.Array(a):
                        self.unify(elem, a, tparams, module, ref sub)
                    case _:
                        pass
            case TypeExpr.Map(key, val, _):
                match actual:
                    case Ty.Map(k, v):
                        self.unify(key, k, tparams, module, ref sub)
                        self.unify(val, v, tparams, module, ref sub)
                    case _:
                        pass
            case TypeExpr.Tuple(elems, _):
                match actual:
                    case Ty.Tuple(ts):
                        if len(elems) == len(ts):
                            for i in 0..len(ts):
                                self.unify(elems[i], ts[i], tparams, module, ref sub)
                    case _:
                        pass

    # Works out type arguments from the expected result type and the arguments.
    # Each argument is checked here, once, with its parameter's type as context
    # when that is already known. `map[i]` is the parameter argument `i` goes to.
    fn infer(
        ref self,
        tparams: [str],
        module: int,
        sub0: [Option[Ty]],
        params: [Option[TypeExpr]],
        ret: Option[TypeExpr],
        ref args: [Arg],
        map: [Option[int]],
        exp: Option[Ty]
    ) -> [Option[Ty]]:
        var sub = sub0
        match (ret, exp):
            case (Some(r), Some(e)):
                self.unify(r, e, tparams, module, ref sub)
            case _:
                pass
        # arguments like `None` or `[]` get their type from context, so they go last
        var order: [int] = []
        for i in 0..len(args):
            if not self.needs_context(args[i].expr):
                order.push(i)
        for i in 0..len(args):
            if self.needs_context(args[i].expr):
                order.push(i)
        for i in order:
            var te0: Option[TypeExpr] = None
            match map[i]:
                case Some(pi):
                    if pi < len(params):
                        te0 = params[pi]
                case None:
                    pass
            if te0.is_none():
                continue
            let te = te0.unwrap()
            var known: Option[Ty] = None
            if not mentions_unbound(te, tparams, sub):
                var env: {str: Ty} = {}
                for j in 0..len(tparams):
                    env[tparams[j]] = sub[j].unwrap_or(Ty.Error)
                let saved = self.enter(module, env)
                known = Some(self.resolve_type(te))
                self.leave(saved)
            let t = self.check_expr(ref args[i].expr, known)
            if known.is_none() and not self.fits(te, t, module):
                self.err(
                    diag.error("E0301", "mismatched types").label(
                        args[i].expr.span,
                        "expected `" + te_name(te) + "`, found " + self.tn(t)
                    )
                )
                self.failed = true
            self.unify(te, t, tparams, module, ref sub)
        return sub

    # Whether `t` has the shape of declared type `te` (ignoring what the parameters stand for).
    fn fits(self, te: TypeExpr, t: Ty, module: int) -> bool:
        if t.is_error():
            return true
        match te:
            case TypeExpr.Array(elem, _):
                match t:
                    case Ty.Array(e):
                        return self.fits(elem, e, module)
                    case _:
                        return false
            case TypeExpr.Map(key, val, _):
                match t:
                    case Ty.Map(k, v):
                        return self.fits(key, k, module) and self.fits(val, v, module)
                    case _:
                        return false
            case TypeExpr.Tuple(elems, _):
                match t:
                    case Ty.Tuple(ts):
                        if len(ts) != len(elems):
                            return false
                        for i in 0..len(ts):
                            if not self.fits(elems[i], ts[i], module):
                                return false
                        return true
                    case _:
                        return false
            case TypeExpr.Named(path, args, _):
                if len(args) == 0:
                    return true
                match (self.item_at(module, path), self.origin(t)):
                    case (Some(Item.GenType(tid)), Some((x, xs))):
                        if tid != x:
                            return false
                        for i in 0..min(len(args), len(xs)):
                            if not self.fits(args[i], xs[i], module):
                                return false
                        return true
                    case _:
                        return false

    # Expressions whose type comes from where they're used: `None`, `[]`.
    fn needs_context(self, e: Expr) -> bool:
        match e.kind:
            case ExprKind.Array(xs):
                return len(xs) == 0
            case ExprKind.Ident(_):
                match self.generic_item(e):
                    case Some(Item.GenVariant(_, _)):
                        return true
                    case _:
                        return false
            case ExprKind.Field(b, _, _):
                match self.generic_item(e):
                    case Some(Item.GenVariant(_, _)):
                        return true
                    case _:
                        pass
                match self.generic_item(b):
                    case Some(Item.GenType(_)):
                        return true
                    case _:
                        return false
            case _:
                return false

    fn need_all(
        ref self,
        what: str,
        tparams: [str],
        sub: [Option[Ty]],
        span: Span,
        help: str
    ) -> Option[[Ty]]:
        if self.failed:
            self.failed = false
            return None
        for i, t in enumerate(sub):
            if t.is_none():
                self.err(
                    diag.error("E0332", f"can't infer type parameter `{tparams[i]}` of `{what}`")
                    .label(span, "type unknown here")
                    .with_help(help)
                )
                return None
        return Some([t.unwrap_or(Ty.Error) for t in sub])

    fn check_unchecked(ref self, ref args: [Arg]):
        for i in 0..len(args):
            if args[i].expr.ty == Ty.Unknown:
                self.check_expr(ref args[i].expr, None)

    # ------------------------------------------------------------ uses
    # The generic item named by `e` (`Name` or `module.Name`), if any.
    fn generic_item(self, e: Expr) -> Option[Item]:
        var it: Option[Item] = None
        match e.kind:
            case ExprKind.Ident(name):
                if self.defined_at(name).is_none():
                    it = self.item(name)
            case ExprKind.Field(b, name, _):
                match b.kind:
                    case ExprKind.Ident(m):
                        if self.defined_at(m).is_none():
                            match self.item(m):
                                case Some(Item.Module(mi)):
                                    it = self.items[mi].get(name)
                                case _:
                                    pass
                    case _:
                        pass
            case _:
                pass
        match it:
            case Some(Item.GenType(_)) | Some(Item.GenFn(_)) | Some(Item.GenVariant(_, _)):
                return it
            case _:
                return None

    # `[int, str]` in `Pair[int, str](...)`, resolved.
    fn type_args(ref self, idx: Expr) -> [Ty]:
        var elems = [idx]
        match idx.kind:
            case ExprKind.Tuple(xs):
                elems = xs
            case _:
                pass
        var out: [Ty] = []
        for e in elems:
            match expr_to_type(e):
                case Some(te):
                    out.push(self.resolve_type(te))
                case None:
                    self.err(
                        diag.error("E0203", "expected a type")
                        .label(e.span, "not a type")
                        .with_help(
                            "type arguments are types, like `Option[int]` or `Pair[str, [float]]`"
                        )
                    )
                    out.push(Ty.Error)
        return out

    # `Name[args]` as an expression, when `Name` is a generic type.
    fn applied_type(ref self, e: Expr) -> Option[Ty]:
        match e.kind:
            case ExprKind.Index(b, idx):
                match self.generic_item(b):
                    case Some(Item.GenType(tid)):
                        let args = self.type_args(idx)
                        return Some(self.apply(tid, args, e.span))
                    case _:
                        return None
            case _:
                return None

    # `f(args)` or `f[int](args)` for a generic function or a static method of a generic type.
    fn call_generic_fn(
        ref self,
        gid: int,
        explicit: Option[[Ty]],
        ref args: [Arg],
        ref res: CallRes,
        span: Span,
        exp: Option[Ty]
    ) -> Ty:
        match self.generic_instance(gid, [], explicit, ref args, span, exp, 0):
            case Some(id):
                res = CallRes.Fn(id)
                let sig = self.info.fns[id]
                return self.check_args(sig, ref args, span, 0)
            case None:
                return Ty.Error

    # The instance of generic function `gid` that a call needs. `fixed` are its
    # first type arguments (a generic method's type already fixes those),
    # `explicit` the rest if written; any others are inferred. The arguments
    # go to the parameters from `first` on (1 skips `self`).
    fn generic_instance(
        ref self,
        gid: int,
        fixed: [Ty],
        explicit: Option[[Ty]],
        ref args: [Arg],
        span: Span,
        exp: Option[Ty],
        first: int
    ) -> Option[int]:
        if self.in_spec:
            self.spec_err(span)
        let g = self.gfns[gid]
        let tparams = g.tparams
        let name = g.decl.name
        let params = [p.ty for p in g.decl.params]
        let free = tparams[len(fixed):]
        var sub: [Option[Ty]] = [Some(t) for t in fixed]
        match explicit:
            case Some(v):
                if len(v) != len(free):
                    let n = len(free)
                    let nv = len(v)
                    self.err(
                        diag.error(
                            "E0334",
                            f"`{name}` takes {n} type argument{plural(n)} but {nv} "
                            + ("was" if nv == 1 else "were")
                            + " given"
                        )
                        .label(span, "wrong number of type arguments")
                        .note(f"declared as `{name}[" + ", ".join(free) + "]`")
                    )
                    self.check_unchecked(ref args)
                    return None
                for t in v:
                    sub.push(Some(t))
            case None:
                while len(sub) < len(tparams):
                    sub.push(None)
                var map: [Option[int]] = []
                for i in 0..len(args):
                    map.push(Some(i + first))
                sub = self.infer(tparams, g.module, sub, params, g.decl.ret, ref args, map, exp)
        let s = "" if len(free) == 1 else "s"
        let recv = "x." if first > 0 else ""
        let help = f"give the type{s} explicitly, e.g. `{recv}{name}[" + int_names(free) + "](...)`"
        match self.need_all(name, tparams, sub, span, help):
            case Some(targs):
                match self.inst_fn(gid, targs, span):
                    case Some(id):
                        return Some(id)
                    case None:
                        self.check_unchecked(ref args)
                        return None
            case None:
                self.check_unchecked(ref args)
                return None

    # Type arguments of a generic struct or enum variant, from explicit
    # arguments, the expected type, or the field values.
    fn type_args_for(
        ref self,
        tid: int,
        explicit: Option[[Ty]],
        fields: [FieldDecl],
        ref args: [Arg],
        exp: Option[Ty],
        span: Span,
        what: str
    ) -> Option[[Ty]]:
        let g = self.gtypes[tid]
        match explicit:
            case Some(v):
                if len(v) != len(g.tparams):
                    self.apply(tid, v, span)
                    return None
                return Some(v)
            case None:
                pass
        var seed: [Option[Ty]] = [None] * len(g.tparams)
        match exp:
            case Some(e):
                match self.origin(e):
                    case Some((t, a)):
                        if t == tid:
                            seed = [Some(x) for x in a]
                    case None:
                        pass
            case None:
                pass
        let params: [Option[TypeExpr]] = [Some(f.ty) for f in fields]
        var map: [Option[int]] = []
        for i, a in enumerate(args):
            match a.name:
                case Some((n, _)):
                    var pos: Option[int] = None
                    for k, f in enumerate(fields):
                        if f.name == n:
                            pos = Some(k)
                            break
                    map.push(pos)
                case None:
                    map.push(Some(i))
        let sub = self.infer(g.tparams, g.module, seed, params, None, ref args, map, None)
        let help = (
            f"give the types explicitly, e.g. `{g.name}["
            + int_names(g.tparams)
            + "]`, or add a type annotation to the variable"
        )
        return self.need_all(what, g.tparams, sub, span, help)

    # `Pair(a=1, b="x")` or `Pair[int, str](...)`.
    fn ctor_generic(
        ref self,
        tid: int,
        explicit: Option[[Ty]],
        ref args: [Arg],
        ref res: CallRes,
        span: Span,
        exp: Option[Ty]
    ) -> Ty:
        let g = self.gtypes[tid]
        let name = g.name
        match g.sdecl:
            case None:
                var v = ""
                match g.edecl:
                    case Some(ed):
                        if len(ed.variants) > 0:
                            v = ed.variants[0].name
                    case None:
                        pass
                self.err(
                    diag.error(
                        "E0303",
                        f"`{name}` is an enum; construct one of its variants"
                    ).label(span, f"e.g. `{name}.{v}(...)`")
                )
                self.check_unchecked(ref args)
                return Ty.Error
            case Some(sd):
                match self.type_args_for(tid, explicit, sd.fields, ref args, exp, span, name):
                    case None:
                        self.check_unchecked(ref args)
                        return Ty.Error
                    case Some(targs):
                        match self.inst_type(tid, targs, span):
                            case Ty.Struct(sid):
                                res = CallRes.Ctor(sid)
                                return self.check_ctor(sid, ref args, span)
                            case _:
                                self.check_unchecked(ref args)
                                return Ty.Error

    # `Some(x)`, `Option.Some(x)`.
    fn variant_generic(
        ref self,
        tid: int,
        vi: int,
        ref args: [Arg],
        ref res: CallRes,
        span: Span,
        name_span: Span,
        exp: Option[Ty]
    ) -> Ty:
        let ed = self.gtypes[tid].edecl.unwrap()
        let v = ed.variants[vi]
        let what = self.variant_label_g(tid, vi)
        match self.type_args_for(tid, None, v.fields, ref args, exp, span, what):
            case None:
                self.check_unchecked(ref args)
                return Ty.Error
            case Some(targs):
                match self.inst_type(tid, targs, span):
                    case Ty.Enum(eid):
                        return self.construct_variant(eid, vi, ref args, ref res, span, name_span)
                    case _:
                        self.check_unchecked(ref args)
                        return Ty.Error

    fn variant_label_g(self, tid: int, vi: int) -> str:
        let g = self.gtypes[tid]
        let v = g.edecl.unwrap().variants[vi].name
        if g.bare:
            return v
        return g.name + "." + v

    # `None` or `Option.None` used as a value: the type comes from context.
    fn variant_value_generic(
        ref self,
        tid: int,
        name: str,
        name_span: Span,
        ref res: Res,
        span: Span,
        exp: Option[Ty]
    ) -> Ty:
        match exp:
            case Some(e):
                match self.enum_instance(tid, e):
                    case Some(eid):
                        return self.variant_value(eid, name, name_span, ref res, span)
                    case None:
                        pass
            case None:
                pass
        let g = self.gtypes[tid]
        let gname = g.name
        match g.edecl:
            case None:
                self.err(
                    diag.error(
                        "E0310",
                        f"`{gname}` is a type, not a value"
                    ).label(span, "not a value")
                )
                return Ty.Error
            case Some(ed):
                var vi = -1
                for i, v in enumerate(ed.variants):
                    if v.name == name:
                        vi = i
                        break
                if vi < 0:
                    let cands = [v.name for v in ed.variants]
                    var d = diag.error(
                        "E0201",
                        f"enum `{gname}` has no variant `{name}`"
                    ).label(name_span, "unknown variant")
                    match best_match(name, cands):
                        case Some(b):
                            d = d.with_help(f"did you mean `{b}`?").fix(name_span, b, "replace")
                        case None:
                            pass
                    self.err(d)
                elif len(ed.variants[vi].fields) > 0:
                    let l = self.variant_label_g(tid, vi)
                    self.err(
                        diag.error(
                            "E0302",
                            f"`{l}` needs values for its fields"
                        ).label(span, f"write `{l}(...)`")
                    )
                else:
                    let l = self.variant_label_g(tid, vi)
                    let tp = int_names(g.tparams)
                    self.err(
                        diag.error("E0332", f"can't infer which `{gname}` type `{l}` belongs to")
                        .label(span, "type unknown here")
                        .with_help(f"add a type annotation, e.g. `let x: {gname}[{tp}] = {l}`")
                    )
                return Ty.Error

    # `Option.Some(x)`, `Option.none_helper()`: names looked up on a generic type without type arguments.
    fn static_generic(
        ref self,
        tid: int,
        name: str,
        name_span: Span,
        ref args: [Arg],
        ref res: CallRes,
        span: Span,
        exp: Option[Ty],
        targs: Option[[Ty]]
    ) -> Ty:
        let g = self.gtypes[tid]
        let gname = g.name
        if targs.is_some():
            let ps = ", ".join(g.tparams)
            self.err(
                diag.error("E0334", f"give `{gname}`'s type arguments first")
                .label(span, "type arguments of a generic type's method")
                .with_help(
                    f"write `{gname}[{ps}].{name}[...](...)`, or leave the type arguments out"
                )
            )
            self.check_unchecked(ref args)
            return Ty.Error
        match g.edecl:
            case Some(ed):
                for vi, v in enumerate(ed.variants):
                    if v.name == name:
                        return self.variant_generic(
                            tid,
                            vi,
                            ref args,
                            ref res,
                            span,
                            name_span,
                            exp
                        )
            case None:
                pass
        match g.methods.get(name):
            case Some(gid):
                let ps = self.gfns[gid].decl.params
                if len(ps) > 0 and ps[0].ty.is_none():
                    self.err(
                        diag.error(
                            "E0206",
                            f"`{gname}.{name}` takes `self`; call it on a value"
                        ).label(span, f"e.g. `x.{name}(...)`")
                    )
                    self.check_unchecked(ref args)
                    return Ty.Error
                return self.call_generic_fn(gid, None, ref args, ref res, span, exp)
            case None:
                pass
        var cands = g.methods.keys()
        match g.edecl:
            case Some(ed):
                for v in ed.variants:
                    cands.push(v.name)
            case None:
                pass
        var d = diag.error(
            "E0206",
            f"`{gname}` has no method or variant `{name}`"
        ).label(name_span, "unknown name")
        match best_match(name, cands):
            case Some(b):
                d = d.with_help(f"did you mean `{b}`?").fix(name_span, b, "replace")
            case None:
                pass
        self.err(d)
        self.check_unchecked(ref args)
        return Ty.Error

# ================================================================ helpers

fn compatible(a: Ty, b: Ty) -> bool:
    return a == b or a.is_error() or b.is_error() or a == Ty.Never or b == Ty.Never

fn printable(t: Ty) -> bool:
    match t:
        case Ty.Unit | Ty.Range | Ty.Never:
            return false
        case Ty.Array(e):
            return printable(e)
        case Ty.Tuple(ts):
            return all(printable(x) for x in ts)
        case _:
            return true

# Values `<` can order: numbers, strings, enums without data (in declaration
# order), and tuples and structs of these (compared part by part, first to last).
fn orderable(info: ProgramInfo, t: Ty) -> bool:
    return unordered_part(info, t).is_none()

# The first part of `t` that can't be ordered, described, if any.
fn unordered_part(info: ProgramInfo, t: Ty) -> Option[(str, Ty)]:
    if t.is_numeric() or t == Ty.Str or t.is_error():
        return None
    match t:
        case Ty.Enum(eid):
            if not info.enums[eid].has_payload():
                return None
        case Ty.Tuple(ts):
            for i, x in enumerate(ts):
                match unordered_part(info, x):
                    case Some(p):
                        if p.1 == x:
                            return Some((f"element {i}", x))
                        return Some(p)
                    case None:
                        pass
            return None
        case Ty.Struct(sid):
            for f in info.structs[sid].fields:
                match unordered_part(info, f.1):
                    case Some(p):
                        if p.1 == f.1:
                            return Some((f"field `{f.0}`", f.1))
                        return Some(p)
                    case None:
                        pass
            return None
        case _:
            pass
    return Some(("it", t))

fn equatable(t: Ty) -> bool:
    match t:
        case Ty.Unit | Ty.Range | Ty.Never:
            return false
        case Ty.Array(e):
            return equatable(e)
        case Ty.Tuple(ts):
            return all(equatable(x) for x in ts)
        case _:
            return true

# The array constant `e` (`TABLE[i]`) is part of, if any.
fn const_root(e: Expr) -> Option[int]:
    match e.res:
        case Res.Const(id):
            return Some(id)
        case _:
            pass
    match e.kind:
        case ExprKind.Index(x, _) | ExprKind.Field(x, _, _):
            return const_root(x)
        case _:
            return None

# The places of `a, (b, c) = ...`, each with its path into the value.
fn place_leaves(e: Expr, path: [int], ref out: [(Expr, [int])]):
    match e.kind:
        case ExprKind.Tuple(xs):
            for i, x in enumerate(xs):
                var p = path
                p.push(i)
                place_leaves(x, p, ref out)
        case _:
            out.push((e, path))

# A struct or tuple: a value whose fields `let r = ref x.f` can alias.
fn field_base(t: Ty) -> bool:
    match t:
        case Ty.Struct(_) | Ty.Tuple(_):
            return true
        case _:
            return false

fn is_wild(e: Expr) -> bool:
    match e.kind:
        case ExprKind.Ident(n):
            return n == "_"
        case _:
            return false

# The type a tuple of places expects, from the types of its places in order.
fn shape_ty(e: Expr, tys: [Ty], ref k: int) -> Ty:
    match e.kind:
        case ExprKind.Tuple(xs):
            var ts: [Ty] = []
            for x in xs:
                ts.push(shape_ty(x, tys, ref k))
            return Ty.Tuple(ts)
        case _:
            k += 1
            return tys[k - 1]

fn fits_shape(e: Expr, t: Ty) -> bool:
    match e.kind:
        case ExprKind.Tuple(xs):
            match t:
                case Ty.Tuple(ts):
                    if len(ts) != len(xs):
                        return false
                    for i, x in enumerate(xs):
                        if not fits_shape(x, ts[i]):
                            return false
                    return true
                case _:
                    return false
        case _:
            return true

# Where the value for a path comes from, for error labels.
fn elem_span(v: Expr, path: [int]) -> Span:
    var e = v
    for i in path:
        match e.kind:
            case ExprKind.Tuple(xs):
                e = xs[i]
            case _:
                return e.span
    return e.span

# The span of an index in place `e` that mentions local `id`.
fn index_reading(e: Expr, id: int) -> Option[Span]:
    match e.kind:
        case ExprKind.Field(x, _, _):
            return index_reading(x, id)
        case ExprKind.Index(x, i):
            if expr_mentions(i, id):
                return Some(i.span)
            return index_reading(x, id)
        case _:
            return None

# `a.b.c` as text with the variable's id, or None when the place has an index.
fn place_key(e: Expr) -> Option[str]:
    match e.kind:
        case ExprKind.Ident(_):
            match local_of(e):
                case Some(id):
                    return Some(str(id))
                case None:
                    return None
        case ExprKind.Field(x, name, _):
            match place_key(x):
                case Some(k):
                    return Some(k + "." + name)
                case None:
                    return None
        case _:
            return None

# The path step applied directly to the root variable.
fn root_step(e: Expr) -> Option[Expr]:
    var inner = e
    match e.kind:
        case ExprKind.Field(x, _, _):
            inner = x
        case ExprKind.Index(x, _):
            inner = x
        case _:
            return None
    match inner.kind:
        case ExprKind.Ident(_):
            return Some(e)
        case _:
            return root_step(inner)

fn within(x: Span, s: Span) -> bool:
    return s.lo <= x.lo and x.hi <= s.hi

fn ordered(seq: [(Span, Span)], a: Span, b: Span) -> bool:
    for l, r in seq:
        if (within(a, l) and within(b, r)) or (within(a, r) and within(b, l)):
            return true
    return false

# A call that changes a variable in place: the variable, the fields of it the
# call can reach (all of it when empty), whether the place is only fields
# (`t`, `self.a`, not `xs[i]`), and the call.
struct MutSite:
    root: int
    path: [str]
    exact: bool
    span: Span

# A mention of a variable: the fields read (all of it when empty).
struct MutRead:
    root: int
    path: [str]
    span: Span

struct MutScan:
    sites: [MutSite]
    reads: [MutRead]
    # pairs of parts that run one after the other
    seq: [(Span, Span)]
    # the receiver or `ref` argument of a changing call, made only of fields,
    # and that call: the place is used when the call runs, after its arguments
    places: [(Span, Span)]

# Does change `a` run before change `b`? It does when `a` is in `b`'s arguments
# and `b` changes a place that no index leads to (`t.f(t.g(x))`): that place's
# address stays the same while the arguments run.
fn runs_first(a: MutSite, b: MutSite) -> bool:
    return b.exact and within(a.span, b.span) and a.span != b.span

# Is read `r` part of the place a changing call uses, with change `s` in that
# call's arguments (so the place is used after `s`)?
fn read_later(places: [(Span, Span)], r: Span, s: Span) -> bool:
    for p, call in places:
        if within(r, p) and within(s, call) and s != call:
            return true
    return false

# The variable a place starts at, the fields it goes through before any index,
# and whether it is only fields: `self.a.b` is (self, [a, b], true), `xs[i].b`
# is (xs, [], false).
fn place_of(e: Expr) -> Option[(int, [str], bool)]:
    match e.kind:
        case ExprKind.Ident(_):
            match local_of(e):
                case Some(l):
                    return Some((l, [], true))
                case None:
                    return None
        case ExprKind.Field(x, f, _):
            match place_of(x):
                case Some((l, p, exact)):
                    if not exact:
                        return Some((l, p, false))
                    var q = p
                    q.push(f)
                    return Some((l, q, true))
                case None:
                    return None
        case ExprKind.Index(x, _):
            match place_of(x):
                case Some((l, p, _)):
                    return Some((l, p, false))
                case None:
                    return None
        case _:
            return None

# Do two field paths of one variable share memory (is one a prefix of the other)?
fn paths_overlap(a: [str], b: [str]) -> bool:
    for i in 0..min(len(a), len(b)):
        if a[i] != b[i]:
            return false
    return true

# Does `e` use variable `r` in a part that overlaps its fields `path`?
fn touches(e: Expr, r: int, path: [str]) -> bool:
    match e.kind:
        case ExprKind.Ident(_) | ExprKind.Field(_, _, _):
            match place_of(e):
                case Some((l, p, true)):
                    return l == r and paths_overlap(p, path)
                case _:
                    pass
        case _:
            pass
    for c in children(e):
        if touches(c, r, path):
            return true
    return false

# Records in `m` the variables changed in place by calls in `e`, every mention
# of a variable, and the parts that run one after the other.
fn mut_sites(e: Expr, info: ProgramInfo, ref m: MutScan):
    match e.kind:
        case ExprKind.Ident(_) | ExprKind.Field(_, _, _):
            match place_of(e):
                case Some((l, p, true)):
                    m.reads.push(MutRead(root=l, path=p, span=e.span))
                    return
                case _:
                    pass
        # a nested comprehension or `par` body runs as its own code
        case ExprKind.Comp(_) | ExprKind.ParTuple(_):
            return
        case ExprKind.Binary(op, l, r):
            if op == BinOp.And or op == BinOp.Or:
                m.seq.push((l.span, r.span))
                mut_sites(l, info, ref m)
                mut_sites(r, info, ref m)
                return
        case ExprKind.IfElse(c, t, f):
            m.seq.push((c.span, t.span))
            m.seq.push((c.span, f.span))
            m.seq.push((t.span, f.span))
            mut_sites(c, info, ref m)
            mut_sites(t, info, ref m)
            mut_sites(f, info, ref m)
            return
        case _:
            pass
    var recv: Option[Expr] = None
    var args: [Arg] = []
    var is_call = false
    match e.kind:
        case ExprKind.MethodCall(r, _, _, a):
            recv = Some(r)
            args = a
            is_call = true
        case ExprKind.Call(_, a):
            args = a
            is_call = true
        case _:
            pass
    var recv_mut = false
    if is_call:
        match e.cres:
            case CallRes.Builtin(b):
                recv_mut = b.mutates_recv()
            case CallRes.Method(id):
                if id < len(info.fns) and len(info.fns[id].params) > 0:
                    recv_mut = info.fns[id].params[0].by_ref
            case _:
                pass
    # the change happens when the call runs, after all its arguments are read
    var changed: [Expr] = []
    if recv_mut:
        match recv:
            case Some(r):
                changed.push(r)
            case None:
                pass
    for a in args:
        if a.by_ref:
            changed.push(a.expr)
    for x in changed:
        match place_of(x):
            case Some((root, p, exact)):
                m.sites.push(MutSite(root=root, path=p, exact=exact, span=e.span))
                if exact:
                    m.places.push((x.span, e.span))
            case None:
                pass
    for c in children(e):
        mut_sites(c, info, ref m)

fn expr_mentions(e: Expr, id: int) -> bool:
    match e.kind:
        case ExprKind.Ident(_):
            return local_of(e) == Some(id)
        case _:
            pass
    for c in children(e):
        if expr_mentions(c, id):
            return true
    return false

fn scan_bad_uses_expr(e: Expr, w: int, lv: int, ref bad: [Span]):
    match e.kind:
        case ExprKind.Index(base, idx):
            if local_of(base) == Some(w):
                if local_of(idx) != Some(lv):
                    bad.push(e.span)
                scan_bad_uses_expr(idx, w, lv, ref bad)
                return
            scan_bad_uses_expr(base, w, lv, ref bad)
            scan_bad_uses_expr(idx, w, lv, ref bad)
            return
        case ExprKind.Ident(_):
            if local_of(e) == Some(w):
                bad.push(e.span)
            return
        case _:
            pass
    for c in children(e):
        scan_bad_uses_expr(c, w, lv, ref bad)

fn scan_bad_uses_block(b: Block, w: int, lv: int, ref bad: [Span]):
    for s in b.stmts:
        for e in stmt_exprs(s):
            scan_bad_uses_expr(e, w, lv, ref bad)
        for blk in stmt_blocks(s):
            scan_bad_uses_block(blk, w, lv, ref bad)

# Does `p` bind a name inside a `|`?
fn binds_in_or(p: Pattern, in_or: bool) -> bool:
    match p.kind:
        case PatKind.Bind(_):
            return in_or
        case PatKind.Or(ps):
            return any(binds_in_or(q, true) for q in ps)
        case PatKind.Tuple(ps):
            return any(binds_in_or(q, in_or) for q in ps)
        case PatKind.Variant(_, _):
            return any(binds_in_or(q, in_or) for q in p.fields)
        case _:
            return false

# The patterns without `|` that together match what `p` matches, in order.
fn or_split(p: Pattern) -> [Pattern]:
    match p.kind:
        case PatKind.Or(alts):
            var out: [Pattern] = []
            for a in alts:
                out.extend(or_split(a))
            return out
        case PatKind.Tuple(ps):
            var out: [Pattern] = []
            for elems in or_product(ps):
                var q = p
                q.kind = PatKind.Tuple(elems)
                out.push(q)
            return out
        case PatKind.Variant(_, _):
            var out: [Pattern] = []
            for fields in or_product(p.fields):
                var q = p
                q.fields = fields
                out.push(q)
            return out
        case _:
            return [p]

fn or_product(ps: [Pattern]) -> [[Pattern]]:
    var acc: [[Pattern]] = [[]]
    for q in ps:
        let qs = or_split(q)
        var next: [[Pattern]] = []
        for pre in acc:
            for x in qs:
                var c = pre
                c.push(x)
                next.push(c)
        acc = next
    return acc

# `_` or a plain name: matches every value.
fn is_catch_all(p: Pattern) -> bool:
    match p.kind:
        case PatKind.Wild | PatKind.Bind(_):
            return true
        case _:
            return false

fn push_alts(p: Pattern, rest: [Pattern], ref out: [[Pattern]]):
    match p.kind:
        case PatKind.Or(alts):
            for a in alts:
                push_alts(a, rest, ref out)
        case _:
            var r = [p]
            r.extend(rest)
            out.push(r)

fn block_terminates(b: Block) -> bool:
    return any(stmt_terminates(s) for s in b.stmts)

fn stmt_terminates(s: Stmt) -> bool:
    match s.kind:
        case StmtKind.Return(_):
            return true
        case StmtKind.If(branches, els):
            match els:
                case Some(e):
                    return all(block_terminates(b.1) for b in branches) and block_terminates(e)
                case None:
                    return false
        # `match` is always exhaustive
        case StmtKind.Match(_, cases):
            return all(block_terminates(c.body) for c in cases)
        case StmtKind.While(cond, _, body):
            match cond.kind:
                case ExprKind.Bool(true):
                    return not block_has_break(body)
                case _:
                    return false
        case StmtKind.ExprStmt(e):
            match e.kind:
                case ExprKind.Call(_, _):
                    match e.cres:
                        case CallRes.Builtin(Builtin.Panic) | CallRes.Builtin(Builtin.Exit):
                            return true
                        case _:
                            return false
                case _:
                    return false
        case _:
            return false

fn block_has_break(b: Block) -> bool:
    for s in b.stmts:
        match s.kind:
            case StmtKind.Break:
                return true
            case StmtKind.If(branches, els):
                if any(block_has_break(x.1) for x in branches):
                    return true
                match els:
                    case Some(e):
                        if block_has_break(e):
                            return true
                    case None:
                        pass
            case StmtKind.Match(_, cases):
                if any(block_has_break(c.body) for c in cases):
                    return true
            case _:
                pass
    return false

# Python spellings we don't use, and what to write instead.
fn str_renames() -> [(str, str)]:
    return [
        ("startswith", "starts_with"),
        ("endswith", "ends_with"),
        ("isdigit", "is_digit"),
        ("isalpha", "is_alpha"),
        ("isspace", "is_space"),
        ("isalnum", "is_alnum"),
        ("splitlines", "lines"),
        ("trim", "strip"),
        ("trim_start", "lstrip"),
        ("trim_end", "rstrip"),
        ("to_upper", "upper"),
        ("to_lower", "lower"),
        ("index", "find")
    ]

# `dir` joined with `rel` (an absolute `rel` stands alone).
fn path_join(dir: str, rel: str) -> str:
    if rel.starts_with("/") or rel.starts_with("\\"):
        return rel
    if len(rel) >= 2 and rel[1] == ":":
        return rel
    if dir == "":
        return rel
    if dir.ends_with("/") or dir.ends_with("\\"):
        return dir + rel
    return dir + "/" + rel

# A tuple field name like `0` or `12`.
fn parse_index(s: str) -> Option[int]:
    if s == "" or len(s) > 18:
        return None
    if not s.is_digit():
        return None
    return Some(int(s))

# ================================================================ generics helpers

# A declared type as written: `[T]`, `Option[T]`.
fn te_name(te: TypeExpr) -> str:
    match te:
        case TypeExpr.Named(path, args, _):
            if len(args) == 0:
                return ".".join(path)
            return ".".join(path) + "[" + ", ".join([te_name(a) for a in args]) + "]"
        case TypeExpr.Array(elem, _):
            return "[" + te_name(elem) + "]"
        case TypeExpr.Map(key, val, _):
            return "{" + te_name(key) + ": " + te_name(val) + "}"
        case TypeExpr.Tuple(elems, _):
            return "(" + ", ".join([te_name(a) for a in elems]) + ")"

fn mentions_unbound(te: TypeExpr, tparams: [str], sub: [Option[Ty]]) -> bool:
    match te:
        case TypeExpr.Named(path, args, _):
            if len(path) == 1:
                for i in 0..min(len(tparams), len(sub)):
                    if tparams[i] == path[0] and sub[i].is_none():
                        return true
            return any(mentions_unbound(a, tparams, sub) for a in args)
        case TypeExpr.Array(elem, _):
            return mentions_unbound(elem, tparams, sub)
        case TypeExpr.Map(key, val, _):
            return mentions_unbound(key, tparams, sub) or mentions_unbound(val, tparams, sub)
        case TypeExpr.Tuple(elems, _):
            return any(mentions_unbound(a, tparams, sub) for a in elems)

fn exprs_to_types(xs: [Expr]) -> Option[[TypeExpr]]:
    var out: [TypeExpr] = []
    for x in xs:
        out.push(expr_to_type(x)?)
    return Some(out)

# Reads an expression like `[int]`, `geo.Point` or `Option[str]` as a type.
fn expr_to_type(e: Expr) -> Option[TypeExpr]:
    let span = e.span
    match e.kind:
        case ExprKind.Ident(name):
            return Some(TypeExpr.Named([name], [], span))
        case ExprKind.Field(b, name, _):
            match b.kind:
                case ExprKind.Ident(m):
                    return Some(TypeExpr.Named([m, name], [], span))
                case _:
                    return None
        case ExprKind.Index(b, idx):
            match expr_to_type(b):
                case Some(TypeExpr.Named(path, args, _)):
                    if len(args) > 0:
                        return None
                    var elems = [idx]
                    match idx.kind:
                        case ExprKind.Tuple(xs):
                            elems = xs
                        case _:
                            pass
                    let targs = exprs_to_types(elems)?
                    return Some(TypeExpr.Named(path, targs, span))
                case _:
                    return None
        case ExprKind.Array(xs):
            if len(xs) != 1:
                return None
            return Some(TypeExpr.Array(expr_to_type(xs[0])?, span))
        case ExprKind.Map(kvs):
            if len(kvs) != 1:
                return None
            let k = expr_to_type(kvs[0].0)?
            let v = expr_to_type(kvs[0].1)?
            return Some(TypeExpr.Map(k, v, span))
        case ExprKind.Tuple(xs):
            return Some(TypeExpr.Tuple(exprs_to_types(xs)?, span))
        case _:
            return None
