# Register allocation for the x86-64 backend: which vregs live in registers.
#
# Liveness over the flat code's control flow gives an interference graph.
# Vregs copied to one another that don't interfere are merged first (the
# copies out of SSA especially: a loop's variable is several vregs), most
# frequent copies first. Then they are colored in order of priority (their
# uses, weighted by loop depth), each preferring the register of a vreg it is
# copied to or from. A vreg live across a call
# gets a callee-saved register (on System V, xmm8-15 for floats, which do_call
# saves around the calls in `keep`); one that isn't, and isn't a call's
# argument or a parameter, can also take a caller-saved one that no
# instruction template uses (r8 r9, and rsi rdi on System V; xmm2-5, xmm2-7
# on System V). Calls of `cold` functions (slow paths) are the exception:
# what is live across one may be in any register, and the call saves the
# ones it changes (`keep`). The templates in x64.br write a result's register only after
# reading the operands, except `d = a op b` for integer add, sub, and, or, xor
# and float add, sub, mul, div, which write d before reading b: there d and b
# interfere even when b dies.

from ir import K, Op, Inst, Func
from opt import reads

struct RA:
    # the register of each vreg (-1: its stack slot)
    reg: [int]
    freg: [int]
    # callee-saved registers used: general ones, and xmm ones on Windows
    saved: [int]
    fsaved: [int]
    # per instruction, the vregs live across the call it makes in registers
    # that call changes: on System V floats in xmm registers, and for a call
    # of a `cold` function anything in a caller-saved register
    keep: [[int]]

fn is_term(op: Op) -> bool:
    return (
        op == Op.Jmp
        or op == Op.Br
        or op == Op.BrNot
        or op == Op.Switch
        or op == Op.Ret
        or op == Op.Unreachable
    )

# The runtime's division of integers up to 64 bits: brine_fdiv_S and
# brine_fmod_S (b isn't 0), brine_div_S and brine_mod_S (checked, with a
# location). x64.br compiles them inline (int_div).
fn int_div_rt(n: str) -> bool:
    var rest = ""
    if n.starts_with("brine_fdiv_") or n.starts_with("brine_fmod_"):
        rest = n[11:]
    elif n.starts_with("brine_div_") or n.starts_with("brine_mod_"):
        rest = n[10:]
    else:
        return false
    return (
        rest == "i8"
        or rest == "i16"
        or rest == "i32"
        or rest == "i64"
        or rest == "u8"
        or rest == "u16"
        or rest == "u32"
        or rest == "u64"
    )

# a runtime call that x64.br compiles inline, calling nothing
fn inline_call(x: Inst) -> bool:
    if x.op != Op.Call or x.b != 1:
        return false
    let n = x.s
    if n == "brine_f_sqrt" or n == "brine_f_sqrtf":
        return x.d >= 0
    return (
        n == "brine_str_retain"
        or n == "brine_arr_retain"
        or n == "brine_map_retain"
        or n == "brine_box_retain"
        or n == "brine_box_dec"
        or (n == "brine_bytes_rev" and x.d >= 0)
        or (n == "brine_bytes_rev0" and x.d >= 0)
        or (n == "brine_bswap_u64" and x.d >= 0)
        or (int_div_rt(n) and len(x.args) == 2 and x.d >= 0)
    )

# Does the code for x call anything (and so change the caller-saved registers)?
fn callish(x: Inst, vk: [K]) -> bool:
    if x.op == Op.Call:
        return not inline_call(x)
    if x.op == Op.CallInd or x.op == Op.Unreachable:
        return true
    if x.op == Op.Copy or x.op == Op.Zero:
        return x.n > 64
    if x.d >= 0 and (vk[x.d].is_wide() or (x.op == Op.Rem and vk[x.d].is_float())):
        return true
    for v in reads(x, len(vk)):
        if vk[v].is_wide():
            return true
    return false

# Does x64.br's code for x leave r10 and r11 alone? Then they can hold vregs
# live across it, and its operands and result.
fn keeps_r10(x: Inst, vk: [K]) -> bool:
    if x.d >= 0 and vk[x.d].is_wide():
        return false
    match x.op:
        case Op.Const | Op.Mov | Op.SlotAddr | Op.Global | Op.Elem:
            return x.d < 0 or not vk[x.d].is_float() or x.op == Op.Mov
        case Op.Add | Op.Sub | Op.Mul | Op.And | Op.Or | Op.Xor | Op.Shl | Op.Shr:
            return not vk[x.d].is_float()
        case Op.Neg | Op.Not | Op.AddO | Op.SubO | Op.MulO | Op.IdxChk:
            return not vk[x.d].is_float()
        case Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge:
            return not vk[x.a].is_float() and not vk[x.a].is_wide()
        case Op.Conv:
            return not vk[x.d].is_float() and not vk[x.a].is_float() and not vk[x.a].is_wide()
        case Op.Load:
            return not vk[x.d].is_wide()
        case Op.Store:
            return not vk[x.b].is_wide()
        case Op.Label | Op.Jmp | Op.Br | Op.BrNot | Op.Line:
            return true
        case _:
            return false

# Is this `d = a op b` with d written before b is read?
fn two_address(x: Inst, vk: [K]) -> bool:
    if x.d < 0 or x.b < 0 or x.b == x.d:
        return false
    if vk[x.d].is_float():
        return x.op == Op.Add or x.op == Op.Sub or x.op == Op.Mul or x.op == Op.Div
    return x.op == Op.Add or x.op == Op.Sub or x.op == Op.And or x.op == Op.Or or x.op == Op.Xor

# Is x `d = op a (, b)`, computed in d's register after loading a into it?
fn same_reg_ok(x: Inst, vk: [K]) -> bool:
    if x.d < 0 or x.a < 0 or vk[x.d].is_wide():
        return false
    match x.op:
        case Op.Add | Op.Sub | Op.And | Op.Or | Op.Xor | Op.Shl | Op.Shr:
            return true
        case Op.Mul | Op.Div:
            return vk[x.d].is_float()
        case Op.Neg | Op.Not:
            return not vk[x.d].is_float()
        case _:
            return false

fn find(rep: [int], j: int) -> int:
    var r = j
    while rep[r] != r:
        r = rep[r]
    return r

fn interferes(mat: [int], wn: int, j: int, k: int) -> bool:
    return mat[j * wn + (k >> 6)] & (1 << (k & 63)) != 0

fn add_edge(ref mat: [int], ref adj: [[int]], wn: int, j: int, k: int):
    if j == k:
        return
    let at = j * wn + (k >> 6)
    let bit = 1 << (k & 63)
    if mat[at] & bit != 0:
        return
    mat[at] |= bit
    mat[k * wn + (j >> 6)] |= 1 << (j & 63)
    adj[j].push(k)
    adj[k].push(j)

# What x reads, where a read of v with ea[v] >= 0 reads ea[v] and eb[v]
# instead (an address the backend folds into its loads and stores).
fn reads_x(x: Inst, nv: int, ea: [int], eb: [int]) -> [int]:
    var out: [int] = []
    for v in reads(x, nv):
        if ea[v] >= 0:
            out.push(ea[v])
            out.push(eb[v])
        else:
            out.push(v)
    return out

# ok[v]: may v live in a register? (Not folded into its uses, not 128 bits.)
fn allocate(f: Func, ok: [bool], ea: [int], eb: [int], win: bool, cold: {str: bool}) -> RA:
    let nv = len(f.vk)
    let ncode = len(f.code)
    var out = RA(reg=[-1] * nv, freg=[-1] * nv, saved=[], fsaved=[], keep=[])
    # the candidates, numbered 0..nc
    var ci = [-1] * nv
    var cv: [int] = []
    for v in 0..nv:
        if ok[v]:
            ci[v] = len(cv)
            cv.push(v)
    let nc = len(cv)
    if nc == 0 or ncode == 0:
        return out
    var isf = [false] * nc
    for j in 0..nc:
        isf[j] = f.vk[cv[j]].is_float()
    let wn = (nc + 63) / 64
    # basic blocks: bstart[b]..bstart[b + 1]
    var lat = [-1] * f.nlabels
    for i in 0..ncode:
        if f.code[i].op == Op.Label:
            lat[f.code[i].n] = i
    var bstart: [int] = []
    var bof = [0] * ncode
    for i in 0..ncode:
        if i == 0 or f.code[i].op == Op.Label or is_term(f.code[i - 1].op):
            bstart.push(i)
        bof[i] = len(bstart) - 1
    let nb = len(bstart)
    bstart.push(ncode)
    var succ: [[int]] = [[] for _ in 0..nb]
    for b in 0..nb:
        let t = f.code[bstart[b + 1] - 1]
        if t.op == Op.Jmp:
            succ[b].push(bof[lat[t.n]])
        elif t.op == Op.Br or t.op == Op.BrNot:
            succ[b].push(bof[lat[t.n]])
            if b + 1 < nb:
                succ[b].push(b + 1)
        elif t.op == Op.Switch:
            for l in t.args:
                succ[b].push(bof[lat[l]])
        elif t.op != Op.Ret and t.op != Op.Unreachable and b + 1 < nb:
            succ[b].push(b + 1)
    # liveness
    var gen = [0] * (nb * wn)
    var kill = [0] * (nb * wn)
    for b in 0..nb:
        for i in bstart[b]..bstart[b + 1]:
            let x = f.code[i]
            for u in reads_x(x, nv, ea, eb):
                let j = ci[u]
                if j >= 0:
                    let at = b * wn + (j >> 6)
                    let bit = 1 << (j & 63)
                    if kill[at] & bit == 0:
                        gen[at] |= bit
            if x.d >= 0 and ci[x.d] >= 0:
                let j = ci[x.d]
                kill[b * wn + (j >> 6)] |= 1 << (j & 63)
    var lin = [0] * (nb * wn)
    var lout = [0] * (nb * wn)
    var changed = true
    while changed:
        changed = false
        var b = nb - 1
        while b >= 0:
            for k in 0..wn:
                var o = 0
                for s in succ[b]:
                    o |= lin[s * wn + k]
                lout[b * wn + k] = o
                let n = gen[b * wn + k] | (o & ~kill[b * wn + k])
                if n != lin[b * wn + k]:
                    lin[b * wn + k] = n
                    changed = true
            b -= 1
    # loop depth: a backward jump to label L puts L..jump in a loop
    var depth = [0] * (ncode + 1)
    var loops = false
    for i in 0..ncode:
        let x = f.code[i]
        if x.op == Op.Jmp or x.op == Op.Br or x.op == Op.BrNot:
            let l = lat[x.n]
            if l >= 0 and l <= i:
                depth[l] += 1
                depth[i + 1] -= 1
                loops = true
    var w = [0] * nc
    var iw = [0] * ncode
    var dd = 0
    for i in 0..ncode:
        let x = f.code[i]
        dd += depth[i]
        let u = 1 << (3 * min(dd, 3))
        iw[i] = u
        if x.d >= 0 and ci[x.d] >= 0:
            w[ci[x.d]] += u
        for v in reads_x(x, nv, ea, eb):
            if ci[v] >= 0:
                w[ci[v]] += u
    # the interference graph, walking each block backward from its live-out
    var mat = [0] * (nc * wn)
    var adj: [[int]] = [[] for _ in 0..nc]
    var moves: [[int]] = [[] for _ in 0..nc]
    # the copies: (-weight, d, a)
    var copies: [(int, int, int)] = []
    var cross = [false] * nc
    var noarg = [false] * nc
    # live across, or read or written by, an instruction that changes r10 or r11
    var nor10 = [false] * nc
    var fcalls: [int] = []
    var flive: [[int]] = []
    var ccalls: [int] = []
    var clive: [[int]] = []
    var live = [0] * wn
    for b in 0..nb:
        for k in 0..wn:
            live[k] = lout[b * wn + k]
        var i = bstart[b + 1] - 1
        while i >= bstart[b]:
            let x = f.code[i]
            let cd = ci[x.d] if x.d >= 0 else -1
            if cd >= 0:
                live[cd >> 6] &= ~(1 << (cd & 63))
                var ca = -1
                # an index check's result is its index: a copy
                if (x.op == Op.Mov or x.op == Op.IdxChk) and x.a >= 0:
                    ca = ci[x.a]
                    if ca >= 0 and ca != cd and isf[ca] == isf[cd]:
                        moves[cd].push(ca)
                        moves[ca].push(cd)
                        copies.push((-iw[i], cd, ca))
                elif same_reg_ok(x, f.vk) and ci[x.a] >= 0:
                    # d = a op b computes in d's register from a: better
                    # the same one, when a dies here
                    let pa = ci[x.a]
                    if pa != cd and isf[pa] == isf[cd]:
                        moves[cd].push(pa)
                        moves[pa].push(cd)
                for k in 0..wn:
                    var wd = live[k]
                    while wd != 0:
                        let t = wd.trailing_zeros()
                        wd ^= 1 << t
                        let j = k * 64 + t
                        if j != ca and isf[j] == isf[cd]:
                            add_edge(ref mat, ref adj, wn, cd, j)
                if two_address(x, f.vk) and ci[x.b] >= 0 and isf[ci[x.b]] == isf[cd]:
                    add_edge(ref mat, ref adj, wn, cd, ci[x.b])
            let rs = reads_x(x, nv, ea, eb)
            # a slow path's integer arguments can be in any register (x64.br
            # sets them in an order that reads each before it is changed)
            let slow = x.op == Op.Call and x.s in cold
            if not keeps_r10(x, f.vk):
                for k in 0..wn:
                    var wd = live[k]
                    while wd != 0:
                        let t = wd.trailing_zeros()
                        wd ^= 1 << t
                        nor10[k * 64 + t] = true
                if cd >= 0:
                    nor10[cd] = true
                for u in rs:
                    if ci[u] >= 0 and (not slow or isf[ci[u]]):
                        nor10[ci[u]] = true
            if callish(x, f.vk):
                var fl: [int] = []
                for k in 0..wn:
                    var wd = live[k]
                    while wd != 0:
                        let t = wd.trailing_zeros()
                        wd ^= 1 << t
                        let j = k * 64 + t
                        if slow:
                            fl.push(j)
                        else:
                            cross[j] = true
                            if isf[j]:
                                fl.push(j)
                if slow:
                    ccalls.push(i)
                    clive.push(fl)
                elif not win and len(fl) > 0:
                    fcalls.push(i)
                    flive.push(fl)
                for u in rs:
                    if ci[u] >= 0 and (not slow or isf[ci[u]]):
                        noarg[ci[u]] = true
            for u in rs:
                let j = ci[u]
                if j >= 0:
                    live[j >> 6] |= 1 << (j & 63)
            i -= 1
        if b == 0:
            # the parameters are all set on entry (an integer one in any
            # register: x64.br sets them in parallel)
            for p in 0..f.nparams:
                let cp = ci[p]
                if cp < 0:
                    continue
                if isf[cp]:
                    noarg[cp] = true
                live[cp >> 6] |= 1 << (cp & 63)
            for p in 0..f.nparams:
                let cp = ci[p]
                if cp < 0:
                    continue
                for k in 0..wn:
                    var wd = live[k]
                    while wd != 0:
                        let t = wd.trailing_zeros()
                        wd ^= 1 << t
                        let j = k * 64 + t
                        if isf[j] == isf[cp]:
                            add_edge(ref mat, ref adj, wn, cp, j)
    # coloring: registers 0-15 are general, 16-31 are xmm0-15
    let callee = [3, 6, 7, 12, 13, 14, 15] if win else [3, 12, 13, 14, 15]
    let caller = [8, 9] if win else [8, 9, 6, 7]
    var fcallee: [int] = []
    var fcaller: [int] = []
    for x in 2..16:
        if x < (6 if win else 8):
            fcaller.push(16 + x)
        else:
            fcallee.push(16 + x)
    # merging copies
    var rep = [j for j in 0..nc]
    copies.sort()
    for (_, c, d) in copies:
        let a = find(rep, c)
        let b = find(rep, d)
        if a == b or interferes(mat, wn, a, b):
            continue
        rep[b] = a
        w[a] += w[b]
        w[b] = 0
        cross[a] = cross[a] or cross[b]
        noarg[a] = noarg[a] or noarg[b]
        nor10[a] = nor10[a] or nor10[b]
        let nb_ = adj[b]
        for n in nb_:
            add_edge(ref mat, ref adj, wn, a, find(rep, n))
        moves[a].extend(moves[b])
    # without loops, a callee-saved register only pays off for a vreg used a lot
    let least = 3 if loops else 6
    var order: [(int, int)] = []
    for j in 0..nc:
        if w[j] > 0 and rep[j] == j:
            order.push((-w[j], j))
    order.sort()
    var color = [-1] * nc
    var used = [false] * 32
    for (_, j) in order:
        var forbid = 0
        for k0 in adj[j]:
            let k = find(rep, k0)
            if color[k] >= 0:
                forbid |= 1 << color[k]
        let free = not cross[j] and not noarg[j]
        let cs = fcaller if isf[j] else caller
        let ce = fcallee if isf[j] else callee
        let r10 = not isf[j] and not nor10[j]
        var pick = -1
        for p in moves[j]:
            let c = color[find(rep, p)]
            if (
                c >= 0
                and (forbid >> c) & 1 == 0
                and (c in ce or (free and c in cs) or (r10 and (c == 10 or c == 11)))
            ):
                pick = c
                break
        if pick < 0 and r10:
            for c in [10, 11]:
                if (forbid >> c) & 1 == 0:
                    pick = c
                    break
        if pick < 0 and free:
            for c in cs:
                if (forbid >> c) & 1 == 0:
                    pick = c
                    break
        if pick < 0:
            for c in ce:
                if used[c] and (forbid >> c) & 1 == 0:
                    pick = c
                    break
        if pick < 0 and w[j] >= least:
            for c in ce:
                if (forbid >> c) & 1 == 0:
                    pick = c
                    break
        if pick >= 0:
            color[j] = pick
            used[pick] = true
    for j in 0..nc:
        color[j] = color[find(rep, j)]
    for j in 0..nc:
        let c = color[j]
        if c >= 16:
            out.freg[cv[j]] = c - 16
        elif c >= 0:
            out.reg[cv[j]] = c
    for c in callee:
        if used[c]:
            out.saved.push(c)
    out.keep = [[] for _ in 0..ncode]
    if win:
        for c in fcallee:
            if used[c]:
                out.fsaved.push(c - 16)
    else:
        for n, i in enumerate(fcalls):
            for j in flive[n]:
                if color[j] >= 16:
                    out.keep[i].push(cv[j])
    for n, i in enumerate(ccalls):
        for j in clive[n]:
            let c = color[j]
            if c >= 0 and (c in caller or c in fcaller or (not win and c in fcallee)):
                out.keep[i].push(cv[j])
    return out
