# Lowering: the checked, verified AST to brine IR (ir.br).
#
# Every backend starts here: ir_c.br writes the IR as C, x64.br as x86-64
# machine code. Ownership: `expr()` returns a vreg. A managed value (str, array, map, enum box,
# or an aggregate containing one) is either *borrowed* (read from a live
# variable) or an *owned temp* registered in the current statement frame;
# `own()` claims an owned temp or retains a borrowed value, and unclaimed temps
# are released when the frame is popped. Aggregates (tuples, structs) live in
# memory: their vreg is a pointer to them.
#
# Every local variable has a home in memory: a stack slot, or (for `ref`
# parameters and aggregate parameters) the caller's memory behind a pointer.
#
# Memory layouts are C's (the runtime is C and shares them):
# tuples and structs are C structs, enums with payload are boxes
# `{rc, tag, union of variant structs}`, other enums are int32.
from diag import Span, SourceMap
from types import Ty, IntTy, FloatTy, Res, CallRes, Builtin, StrM, Reducer, WorldOp, OsOp, LocalInfo, LocalKind, int_ty
from ast import BinOp, CmpOp, UnOp, FSeg, Arg, Comp, Expr, ExprKind, LetPat, Pattern, PatKind, Case, Stmt, StmtKind, Block, FnDecl, Program
from ast import FmtSpec, parse_fmt_spec, children, stmt_exprs, stmt_blocks, local_of
from info import ProgramInfo, ConstVal, TryKind, try_kind, mangle_module, PRELUDE
from num import u128_bits
from ir import K, Op, Func, Data, Reloc, Module, FB, new_func, le_bytes, str_bytes, f64_bits, f32_bits
from ir import DType, DField, DVar, DT_BASE, DT_STRUCT, DT_UNION, DT_ENUM, DT_PTR, DT_TYPEDEF, DT_ARRAY
import ptx
import msl
import jam
import pack
import ranges
import idiom
import narrow
import kernel
import slp

struct Options:
    # generate a test-runner `main` instead of the program's `main`
    tests: bool
    # mark statements with their source lines (`Op.Line`) for debuggers
    debug: bool
    # compile `par` bodies for a GPU (not on WebAssembly)
    gpu: bool
    # optimizations that make more code (release builds): interleaved loops
    fast: bool
    # release builds through C: small fixed-size kernels as vector code (kernel.br)
    vec: bool

struct Temp:
    v: int
    ty: Ty
    claimed: bool

# A value a scope releases when it ends: the value itself (`home` false), or
# the address of a variable whose current value is released (`home` true).
struct Owned:
    v: int
    ty: Ty
    home: bool

# For `x / 2^k` and `x % 2^k` on a signed integer, k (else -1): floor division
# by a power of two is an arithmetic shift and the floored remainder a mask.
# C compilers don't see through brine_fdiv/brine_fmod and divide for real.
fn pow2_shift(op: BinOp, r: Expr, ty: Ty) -> int:
    if op != BinOp.Div and op != BinOp.Mod:
        return -1
    match ty:
        case Ty.Int(k):
            if not k.signed() or k.bits() > 64:
                return -1
            match r.kind:
                case ExprKind.Int(v):
                    var p: i128 = 2
                    var s = 1
                    while p < v and s < 62:
                        p *= 2
                        s += 1
                    return s if p == v else -1
                case _:
                    return -1
        case _:
            return -1

struct ArrCache:
    arr: int
    data: int
    len: int

struct Loop:
    depth: int
    brk: int
    cont: int

# The state of the function being built.
struct FnCx:
    fb: FB
    frames: [[Temp]]
    scopes: [[Owned]]
    loops: [Loop]
    par_writes: {int: bool}
    # arrays no enclosing loop can share, grow or replace: their pointers
    # are loaded once before the loop (and made unique if the loop writes them)
    arrc: {int: ArrCache}
    # homes of locals: a stack slot, or a pointer vreg
    lslot: {int: int}
    lptr: {int: int}
    # the `__loc` parameter of prelude functions, or -1
    loc: int
    # where an aggregate result is written (an extra first parameter), or -1
    sret: int
    # debug builds: the number of `Func.dvars` when each scope opened
    dmark: [int]
    # the body of a `par` construct
    lifted: bool
    # the lanes of the interleaved loop being lowered
    jx: JamCx
    # the local `[bool]` arrays kept as bits (pack.br)
    packed: {int: bool}
    # the `[b] * n` being lowered makes one
    bits_init: bool
    # the local integer arrays kept as bytes (narrow.br), and whether the
    # array being made is one
    narrow: {int: bool}
    narrow_init: bool
    # in a range-versioned copy (ranges.br): integer arithmetic needs no
    # overflow checks, and these calls (by span) go to clones without them
    nc: bool
    nc_calls: {str: int}
    # in the fallback copy of a versioned loop: don't version again
    nv: bool
    # lowering a loop twice (idiom.twin_body): 1 in the first copy, 2 in the
    # second; the labels in the second the idioms of the first fail over to
    # (by span), the stack slots of the locals the copies share, and the
    # (slot, address) vregs the second copy has made so far: it is entered
    # midway, so each landing sets them again (a scope releases a local
    # through its address)
    twin: int
    twin_out: {str: int}
    twin_slots: {int: int}
    twin_ptrs: [(int, int)]

# The lanes of an interleaved loop (see jam.br): vregs, one per lane.
struct JamCx:
    # does the lane run the current statement
    act: [int]
    # the inner loops, innermost last: the lanes still looping, and those
    # that did `continue` in this iteration
    alive: [[int]]
    cont: [[int]]
    # each lane's stack slot for each variable of the body
    slots: {int: [int]}
    # reductions, by variable: does the lane add something, and what
    has: {int: [int]}
    val: {int: [int]}

fn no_jam() -> JamCx:
    return JamCx(act=[], alive=[], cont=[], slots={}, has={}, val={})

fn new_cx(f: Func) -> FnCx:
    return FnCx(
        fb=FB(f=f),
        frames=[],
        scopes=[],
        loops=[],
        par_writes={},
        arrc={},
        lslot={},
        lptr={},
        loc=-1,
        sret=-1,
        dmark=[],
        lifted=false,
        jx=no_jam(),
        packed={},
        bits_init=false,
        narrow={},
        narrow_init=false,
        nc=false,
        nc_calls={},
        nv=false,
        twin=0,
        twin_out={},
        twin_slots={},
        twin_ptrs=[]
    )

# An iteration domain: a range of integers, or the elements of an array.
enum Dom:
    Range(ty: IntTy, lo: int, hi: int, incl: bool, step: int)
    Arr(arr: int, elem: Ty)

struct Lay:
    size: int
    align: int

# Where the fields of an enum box are.
struct BoxLay:
    # offset of the union of variant structs
    uoff: int
    # size of the whole box
    size: int
    # per variant: its size (to the end of its struct) and its field offsets
    vsize: [int]
    voffs: [[int]]

fn align_up(x: int, a: int) -> int:
    return (x + a - 1) / a * a

fn int_kind(k: IntTy) -> K:
    match k:
        case IntTy.I8:
            return K.I8
        case IntTy.I16:
            return K.I16
        case IntTy.I32:
            return K.I32
        case IntTy.I64:
            return K.I64
        case IntTy.I128:
            return K.I128
        case IntTy.U8:
            return K.U8
        case IntTy.U16:
            return K.U16
        case IntTy.U32:
            return K.U32
        case IntTy.U64:
            return K.U64
        case IntTy.U128:
            return K.U128

# The lowered program, and the C functions it declares `extern` (the C
# backend needs their prototypes; for native code they are just symbols).
struct Lowered:
    m: Module
    externs: [Func]
    # C functions the C backend writes before the others (kernel.br)
    kernels: [str]

fn lower(prog: Program, info: ProgramInfo, sm: SourceMap, opts: Options) -> Lowered:
    var g = Lower(
        prog=prog,
        info=info,
        sm=sm,
        opts=opts,
        funcs=[],
        data=[],
        slays=[],
        soffs=[],
        sdone=[],
        blays=[],
        done={},
        strs={},
        cstrs={},
        nlifts={},
        dnames={},
        cx=new_cx(new_func("", [], false, K.I64)),
        fnd=None,
        flocals=[],
        fsyms={},
        dtypes=[],
        dtys={},
        gsites=[],
        fdecls={},
        clones=[],
        cloned={},
        nc_body=false,
        khints={},
        kernels=[]
    )
    return g.run()

struct Lower:
    prog: Program
    info: ProgramInfo
    sm: SourceMap
    opts: Options
    funcs: [Func]
    data: [Data]
    # layouts of structs and enum boxes, by id (see `prep_layouts`)
    slays: [Lay]
    soffs: [[int]]
    sdone: [bool]
    blays: [BoxLay]
    done: {str: bool}
    # string literal objects and plain C strings, by text
    strs: {str: str}
    cstrs: {str: str}
    nlifts: {str: int}
    dnames: {str: bool}
    cx: FnCx
    fnd: Option[FnDecl]
    flocals: [LocalInfo]
    # IR names of brine functions, by id
    fsyms: {int: str}
    # debug builds: the types of variables, and their indexes by mangled name
    dtypes: [DType]
    dtys: {str: int}
    # `par` constructs that may run on a GPU (see `gpu_emit`)
    gsites: [GpuSite]
    # brine functions by id, and those that need a clone without overflow
    # checks (ranges.br)
    fdecls: {int: FnDecl}
    clones: [int]
    cloned: {int: bool}
    # the body being lowered is such a clone
    nc_body: bool
    # the array lengths callers pass (kernel.br), and the kernels made
    khints: {int: [int]}
    kernels: [str]

    # ============================================================ driver
    fn run(ref self) -> Lowered:
        self.prep_layouts()
        let prog = self.prog
        if self.opts.fast:
            for m in prog.modules:
                for f in m.fns:
                    if not f.is_extern:
                        self.fdecls[f.id] = f
        if self.opts.vec:
            self.khints = kernel.hints(prog, self.info)
        for m in prog.modules:
            for f in m.fns:
                if not f.is_extern:
                    self.gen_body(f, self.info.fns[f.id].c_name, false)
        if self.opts.tests:
            self.gen_tests()
        else:
            self.gen_main()
        var ci = 0
        while ci < len(self.clones):
            let f = self.fdecls[self.clones[ci]]
            self.nc_body = true
            self.gen_body(f, self.info.fns[f.id].c_name + "__nc", false)
            self.nc_body = false
            ci += 1
        var externs: [Func] = []
        var seen: {str: bool} = {}
        for sig in self.info.fns:
            if sig.is_extern and not (sig.c_name in seen):
                seen[sig.c_name] = true
                let ks = [self.kind(p.ty) for p in sig.params]
                let has = self.ret_has(sig.ret)
                externs.push(new_func(sig.c_name, ks, has, self.kind(sig.ret) if has else K.I64))
        self.gpu_emit()
        return Lowered(
            m=Module(funcs=self.funcs, data=self.data, dtypes=self.dtypes),
            externs=externs,
            kernels=self.kernels
        )

    # The IR parameters of brine function `id`: an sret pointer first for an
    # aggregate result, then the parameters, then `__loc` for prelude functions.
    fn sig_kinds(ref self, id: int) -> [K]:
        let sig = self.info.fns[id]
        var ks: [K] = []
        if self.agg(sig.ret):
            ks.push(K.Ptr)
        for p in sig.params:
            if p.by_ref:
                ks.push(K.Ptr)
            else:
                ks.push(self.kind(p.ty))
        if self.tracks_caller(id):
            ks.push(K.Ptr)
        return ks

    fn ret_has(self, t: Ty) -> bool:
        return t != Ty.Unit and t != Ty.Never and not self.agg(t)

    # A brine function (or, `is_test`, a test block) as IR function `name`.
    fn gen_body(ref self, f: FnDecl, name: str, is_test: bool):
        var ks: [K] = []
        var ret = Ty.Unit
        if not is_test:
            ret = self.info.fns[f.id].ret
            ks = self.sig_kinds(f.id)
        let has = self.ret_has(ret)
        let rk = self.kind(ret) if has else K.I64
        self.fnd = Some(f)
        self.flocals = f.locals
        self.cx = new_cx(new_func(name, ks, has, rk))
        self.cx.nc = self.nc_body
        if self.opts.debug:
            self.dbg_func(f, is_test)
        elif self.opts.fast:
            self.cx.packed = pack.find(f.body, f.locals)
        if not is_test:
            let sig = self.info.fns[f.id]
            var pi = 0
            if self.agg(ret):
                self.cx.sret = 0
                pi = 1
            for i, p in enumerate(sig.params):
                if i >= len(f.param_locals):
                    continue
                let v = pi + i
                let id = f.param_locals[i]
                if p.by_ref or self.agg(p.ty):
                    self.cx.lptr[id] = v
                    self.dbg_ptr_var(id, v, true)
                else:
                    let a = self.new_local(id, p.ty)
                    self.cx.fb.store(a, 0, v)
            if self.tracks_caller(f.id):
                self.cx.loc = len(ks) - 1
            elif f.id in self.khints and not self.nc_body:
                self.kernel_entry(f, name)
        var nw = narrow.Narrow(arrs={}, guards=[])
        if self.opts.fast and not self.opts.debug:
            nw = narrow.find(f.body, f.locals)
        if len(nw.arrs) > 0 and len(nw.guards) > 0:
            # bytes only while the parameters allow it, else plain arrays
            let slow = self.cx.fb.label()
            for p in nw.guards:
                let x = self.read_local(p)
                let top = self.cx.fb.konst(K.I64, 256)
                let ok = self.cx.fb.cmp(Op.Le, x, top)
                self.cx.fb.brnot(ok, slow)
            self.cx.narrow = nw.arrs
            self.block(f.body)
            self.end_body(has)
            self.cx.narrow = {}
            self.cx.fb.place(slow)
        else:
            self.cx.narrow = nw.arrs
        self.block(f.body)
        self.end_body(has)
        self.funcs.push(self.cx.fb.f)

    fn end_body(ref self, has: bool):
        if not self.cx.fb.ends():
            if has:
                self.cx.fb.unreachable()
            else:
                self.cx.fb.ret(-1)

    # A function kernel.br found a kernel for: when its arrays have the
    # lengths the kernel was made for, call it and return; else go on to
    # the body as written.
    fn kernel_entry(ref self, f: FnDecl, name: str):
        let sig = self.info.fns[f.id]
        var lays: [(int, [int])] = []
        for p in sig.params:
            match p.ty:
                case Ty.Array(et):
                    var offs = [0]
                    match et:
                        case Ty.Struct(sid):
                            offs = [
                                self.field_off(et, j) for j in 0..len(self.info.structs[sid].fields)
                            ]
                        case _:
                            pass
                    lays.push((self.lay(et).size, offs))
                case _:
                    lays.push((0, []))
        var k = kernel.Kernel(name="", c="", arrays=[], floats=[], has_ret=false)
        match kernel.plan(f, self.info, self.fdecls, self.khints[f.id], lays, name):
            case Some(x):
                k = x
            case None:
                return
        self.kernels.push(k.c)
        let slow = self.cx.fb.label()
        for pi, n, _ in k.arrays:
            let arr = self.param_arr(pi, sig.params[pi].by_ref)
            let len = self.cx.fb.load(K.I64, arr, 8)
            let want = self.cx.fb.konst(K.I64, n)
            let ok = self.cx.fb.cmp(Op.Eq, len, want)
            self.cx.fb.brnot(ok, slow)
        for pi, _, written in k.arrays:
            if written:
                self.cx.fb.call_void("brine_arr_unique", [pi])
        var args: [int] = []
        for pi, _, _ in k.arrays:
            let arr = self.param_arr(pi, sig.params[pi].by_ref)
            args.push(self.cx.fb.load(K.Ptr, arr, 48))
        args.extend(k.floats)
        if k.has_ret:
            let r = self.cx.fb.call(K.F64, k.name, args)
            self.cx.fb.ret(r)
        else:
            self.cx.fb.call_void(k.name, args)
            self.cx.fb.ret(-1)
        self.cx.fb.place(slow)

    # The array parameter `i` (by value: its vreg; `ref`: behind its pointer).
    fn param_arr(ref self, i: int, by_ref: bool) -> int:
        if by_ref:
            return self.cx.fb.load(K.Ptr, i, 0)
        return i

    fn main_sym(self) -> Option[int]:
        let prog = self.prog
        let m = prog.modules[prog.main_module]
        for f in m.fns:
            if f.name == "main" and f.method_of.is_none():
                return Some(f.id)
        return None

    # `int main(int argc, char **argv)`
    fn start_main(ref self) -> FnCx:
        let saved = self.cx
        var f = new_func("main", [K.I32, K.Ptr], true, K.I32)
        f.public = true
        self.cx = new_cx(f)
        self.cx.fb.call_void("brine_rt_init", [0, 1])
        return saved

    fn finish_main(ref self, code: int, saved: FnCx):
        self.cx.fb.call_void("brine_rt_shutdown", [])
        self.cx.fb.ret(code)
        self.funcs.push(self.cx.fb.f)
        self.cx = saved

    fn gen_main(ref self):
        self.fnd = None
        let saved = self.start_main()
        var code = -1
        match self.main_sym():
            case Some(id):
                let sig = self.info.fns[id]
                let sym = self.info.fns[id].c_name
                if sig.ret == Ty.Unit:
                    self.cx.fb.call_void(sym, [])
                    code = self.cx.fb.konst(K.I32, 0)
                else:
                    match try_kind(self.info, sig.ret):
                        case Some(TryKind.Res(_, err_v, _, err)):
                            # `main() -> Result[(), E]`: an `Err` prints "error: ..." and exits with 1
                            let r = self.cx.fb.call(K.Ptr, sym, [])
                            code = self.cx.fb.vreg(K.I32)
                            let zero = self.cx.fb.konst(K.I32, 0)
                            self.cx.fb.mov(code, zero)
                            let tag = self.cx.fb.load(K.I64, r, 8)
                            let ev = self.cx.fb.konst(K.I64, err_v)
                            let is_err = self.cx.fb.cmp(Op.Eq, tag, ev)
                            let skip = self.cx.fb.label()
                            self.cx.fb.brnot(is_err, skip)
                            let sb = self.sb_new()
                            self.sb_lit(sb, "error: ")
                            let eid = cg_enum_id(sig.ret)
                            let fv = self.ld(r, self.vfield_off(eid, err_v, 0), err)
                            self.fmt_code(sb, fv, err, false)
                            self.cx.fb.call_void("brine_eprint_sb", [sb])
                            let one = self.cx.fb.konst(K.I32, 1)
                            self.cx.fb.mov(code, one)
                            self.cx.fb.place(skip)
                            self.release(r, sig.ret)
                        case _:
                            let c64 = self.cx.fb.call(K.I64, sym, [])
                            code = self.cx.fb.conv(K.I32, c64)
            case None:
                code = self.cx.fb.konst(K.I32, 0)
        self.finish_main(code, saved)

    fn gen_tests(ref self):
        let prog = self.prog
        var tests: [(str, str)] = []
        for m in prog.modules:
            let mm = mangle_module(m.name)
            for ti, t in enumerate(m.tests):
                let c = f"{mm}__test_{ti}"
                self.gen_body(t, c, true)
                let prefix = "" if m.name == prog.modules[prog.main_module].name else m.name + ": "
                let name = prefix + t.test_name.unwrap_or("")
                tests.push((c, name))
        self.fnd = None
        self.gen_streq()
        let saved = self.start_main()
        let fb0 = self.cx.fb
        # the arguments come from the runtime (`brine_arg`), not C's argv, whose
        # pointers aren't 8 bytes everywhere (WebAssembly)
        let argc = 0
        let done = self.cx.fb.label()
        let not_list = self.cx.fb.label()
        let not_run = self.cx.fb.label()
        let two = self.cx.fb.konst(K.I32, 2)
        let three = self.cx.fb.konst(K.I32, 3)
        let one64 = self.cx.fb.konst(K.I64, 1)
        let two64 = self.cx.fb.konst(K.I64, 2)
        # --list
        let ge2 = self.cx.fb.cmp(Op.Ge, argc, two)
        self.cx.fb.brnot(ge2, not_list)
        let a1 = self.cx.fb.call(K.Ptr, "brine_arg", [one64])
        let ls = self.cstr("--list")
        let is_list = self.cx.fb.call(K.Bool, "br_streq", [a1, ls])
        self.cx.fb.brnot(is_list, not_list)
        for i, t in enumerate(tests):
            let sb = self.sb_new()
            let iv = self.cx.fb.konst(K.I64, i)
            self.cx.fb.call_void("brine_sb_i64", [sb, iv])
            self.sb_lit(sb, "\t")
            self.sb_lit(sb, t.1)
            self.cx.fb.call_void("brine_print_sb", [sb])
        self.cx.fb.jmp(done)
        self.cx.fb.place(not_list)
        # --run k
        let ge3 = self.cx.fb.cmp(Op.Ge, argc, three)
        self.cx.fb.brnot(ge3, not_run)
        let a1b = self.cx.fb.call(K.Ptr, "brine_arg", [one64])
        let rs = self.cstr("--run")
        let is_run = self.cx.fb.call(K.Bool, "br_streq", [a1b, rs])
        self.cx.fb.brnot(is_run, not_run)
        let a2 = self.cx.fb.call(K.Ptr, "brine_arg", [two64])
        let k = self.cx.fb.call(K.I64, "br_atoi", [a2])
        for i, t in enumerate(tests):
            let iv = self.cx.fb.konst(K.I64, i)
            let hit = self.cx.fb.cmp(Op.Eq, k, iv)
            let next = self.cx.fb.label()
            self.cx.fb.brnot(hit, next)
            self.cx.fb.call_void(t.0, [])
            self.cx.fb.jmp(done)
            self.cx.fb.place(next)
        let tl = self.cstr("<test>")
        let msg = self.cstr("no such test")
        self.cx.fb.call_void("brine_panic_at", [tl, msg])
        self.cx.fb.place(not_run)
        for t in tests:
            let sb = self.sb_new()
            self.sb_lit(sb, f"test {t.1} ... ")
            self.cx.fb.call_void(t.0, [])
            self.sb_lit(sb, "ok")
            self.cx.fb.call_void("brine_print_sb", [sb])
        self.cx.fb.place(done)
        let z = self.cx.fb.konst(K.I32, 0)
        self.finish_main(z, saved)
        let _ = fb0

    # `br_streq(a, b)` (C strings) and `br_atoi(s)` (decimal digits) for the test runner
    fn gen_streq(ref self):
        let saved = self.cx
        self.cx = new_cx(new_func("br_streq", [K.Ptr, K.Ptr], true, K.Bool))
        let a = self.cx.fb.copy_of(0)
        let b = self.cx.fb.copy_of(1)
        let head = self.cx.fb.label()
        let out = self.cx.fb.label()
        let one = self.cx.fb.konst(K.I64, 1)
        let zero = self.cx.fb.konst(K.U8, 0)
        self.cx.fb.place(head)
        let x = self.cx.fb.load(K.U8, a, 0)
        let y = self.cx.fb.load(K.U8, b, 0)
        let ne = self.cx.fb.cmp(Op.Ne, x, y)
        self.cx.fb.br(ne, out)
        let end = self.cx.fb.cmp(Op.Eq, x, zero)
        self.cx.fb.br(end, out)
        let a2 = self.cx.fb.elem(a, one, 1)
        self.cx.fb.mov(a, a2)
        let b2 = self.cx.fb.elem(b, one, 1)
        self.cx.fb.mov(b, b2)
        self.cx.fb.jmp(head)
        self.cx.fb.place(out)
        let r = self.cx.fb.cmp(Op.Eq, x, y)
        self.cx.fb.ret(r)
        self.funcs.push(self.cx.fb.f)

        self.cx = new_cx(new_func("br_atoi", [K.Ptr], true, K.I64))
        let p = self.cx.fb.copy_of(0)
        let n = self.cx.fb.konst(K.I64, 0)
        let ten = self.cx.fb.konst(K.I64, 10)
        let c48 = self.cx.fb.konst(K.I64, 48)
        let one2 = self.cx.fb.konst(K.I64, 1)
        let zero2 = self.cx.fb.konst(K.U8, 0)
        let head2 = self.cx.fb.label()
        let out2 = self.cx.fb.label()
        self.cx.fb.place(head2)
        let ch = self.cx.fb.load(K.U8, p, 0)
        let is0 = self.cx.fb.cmp(Op.Eq, ch, zero2)
        self.cx.fb.br(is0, out2)
        let n10 = self.cx.fb.bin(Op.Mul, K.I64, n, ten)
        let c64 = self.cx.fb.conv(K.I64, ch)
        let dg = self.cx.fb.bin(Op.Sub, K.I64, c64, c48)
        let n2 = self.cx.fb.bin(Op.Add, K.I64, n10, dg)
        self.cx.fb.mov(n, n2)
        let p2 = self.cx.fb.elem(p, one2, 1)
        self.cx.fb.mov(p, p2)
        self.cx.fb.jmp(head2)
        self.cx.fb.place(out2)
        self.cx.fb.ret(n)
        self.funcs.push(self.cx.fb.f)
        self.cx = saved

    # ============================================================ emission helpers
    fn loc(ref self, span: Span) -> int:
        if self.cx.loc >= 0:
            match self.fnd:
                case Some(f):
                    if f.test_name.is_none():
                        return self.cx.loc
                case None:
                    pass
        return self.cstr(self.sm.loc(span))

    # Prelude functions (like `unwrap()`) report errors at their caller's location.
    fn tracks_caller(self, id: int) -> bool:
        let sig = self.info.fns[id]
        return not sig.is_extern and self.info.module_names[sig.module] == PRELUDE

    # Named by content, so names don't shift when other literals come and go.
    fn data_name(ref self, prefix: str, s: str) -> str:
        var h: u128 = 14695981039346656037
        for b in s.bytes():
            h = ((h ^ u128(b)) * 1099511628211) & 18446744073709551615
        var name = prefix + f"{u64(h):016x}"
        while name in self.dnames:
            name += "x"
        self.dnames[name] = true
        return name

    # The address of a NUL-terminated C string.
    fn cstr(ref self, s: str) -> int:
        let sym = self.cstr_sym(s)
        return self.cx.fb.global(sym)

    # The symbol of a NUL-terminated C string.
    fn cstr_sym(ref self, s: str) -> str:
        var sym = ""
        match self.cstrs.get(s):
            case Some(x):
                sym = x
            case None:
                sym = self.data_name("br_c", s)
                self.cstrs[s] = sym
                var b: [u8] = []
                str_bytes(ref b, s)
                b.push(u8(0))
                self.data.push(Data(name=sym, align=1, bytes=b, relocs=[], readonly=true))
        return sym

    # A string literal: an immortal `brine_str`.
    fn str_lit(ref self, s: str) -> int:
        var sym = ""
        match self.strs.get(s):
            case Some(x):
                sym = x
            case None:
                sym = self.data_name("br_s", s)
                self.strs[s] = sym
                var b: [u8] = []
                le_bytes(ref b, -1, 8)
                le_bytes(ref b, len(s), 8)
                str_bytes(ref b, s)
                # to the end of the word holding the NUL: strings are read a word at a time
                while len(b) % 8 != 0 or len(b) == 16 + len(s):
                    b.push(u8(0))
                self.data.push(Data(name=sym, align=8, bytes=b, relocs=[], readonly=false))
        return self.cx.fb.global(sym)

    fn push_frame(ref self):
        self.cx.frames.push([])

    fn pop_frame(ref self):
        var f: [Temp] = []
        if len(self.cx.frames) > 0:
            f = self.cx.frames.pop()
        if not self.cx.fb.ends():
            self.release_temps(f)

    fn release_temps(ref self, temps: [Temp]):
        var i = len(temps) - 1
        while i >= 0:
            let t = temps[i]
            if not t.claimed:
                self.release(t.v, t.ty)
            i -= 1

    fn register(ref self, v: int, ty: Ty):
        if self.managed(ty):
            if len(self.cx.frames) == 0:
                self.cx.frames.push([])
            let k = len(self.cx.frames) - 1
            self.cx.frames[k].push(Temp(v=v, ty=ty, claimed=false))

    fn claim(ref self, v: int) -> bool:
        var fi = len(self.cx.frames) - 1
        while fi >= 0:
            for ti in 0..len(self.cx.frames[fi]):
                if self.cx.frames[fi][ti].v == v and not self.cx.frames[fi][ti].claimed:
                    self.cx.frames[fi][ti].claimed = true
                    return true
            fi -= 1
        return false

    fn push_scope(ref self):
        self.cx.scopes.push([])
        if self.opts.debug:
            self.cx.dmark.push(len(self.cx.fb.f.dvars))

    fn pop_scope(ref self):
        var s: [Owned] = []
        if len(self.cx.scopes) > 0:
            s = self.cx.scopes.pop()
        if self.opts.debug and len(self.cx.dmark) > 0:
            let mark = self.cx.dmark.pop()
            self.dbg_close(mark)
        if self.cx.fb.ends():
            return
        var i = len(s) - 1
        while i >= 0:
            self.release_owned(s[i])
            i -= 1

    fn release_owned(ref self, o: Owned):
        if o.home:
            let v = self.ld(o.v, 0, o.ty)
            self.release(v, o.ty)
        else:
            self.release(o.v, o.ty)

    # A local variable (its home) that the current scope releases.
    fn add_home(ref self, p: int, ty: Ty):
        if self.managed(ty):
            let k = len(self.cx.scopes) - 1
            self.cx.scopes[k].push(Owned(v=p, ty=ty, home=true))

    # An owned value that the current scope releases.
    fn add_owned(ref self, v: int, ty: Ty):
        if self.managed(ty):
            let k = len(self.cx.scopes) - 1
            self.cx.scopes[k].push(Owned(v=v, ty=ty, home=false))

    fn release_scopes_from(ref self, depth: int):
        var i = len(self.cx.scopes) - 1
        while i >= depth:
            let sc = self.cx.scopes[i]
            var j = len(sc) - 1
            while j >= 0:
                self.release_owned(sc[j])
                j -= 1
            i -= 1

    # A temp owned by the current frame.
    fn temp(ref self, v: int, ty: Ty) -> int:
        self.register(v, ty)
        return v

    fn owned(ref self, e: Expr) -> int:
        let v = self.expr(e)
        return self.own(v, e.ty)

    # Take ownership of an evaluated value: claim a temp, or retain a borrowed value.
    fn own(ref self, v: int, ty: Ty) -> int:
        if not self.managed(ty):
            return v
        if self.claim(v):
            return v
        if self.agg(ty):
            let lay = self.lay(ty)
            let t = self.cx.fb.temp_mem(lay.size, lay.align)
            self.cx.fb.copy(t, v, lay.size)
            self.retain(t, ty)
            return t
        self.retain(v, ty)
        return v

    # Owned values of several expressions. All are evaluated before any is
    # claimed, so a `?` in a later one can't leak an earlier one.
    fn owned_all(ref self, es: [Expr]) -> [int]:
        var vals: [int] = []
        for e in es:
            vals.push(self.expr(e))
        var out: [int] = []
        for i, e in enumerate(es):
            out.push(self.own(vals[i], e.ty))
        return out

    # `()` as a value
    fn unit(ref self) -> int:
        return self.cx.fb.konst(K.U8, 0)

    # ============================================================ types and layouts
    fn managed(self, t: Ty) -> bool:
        match t:
            case Ty.Str | Ty.Array(_) | Ty.Map(_, _):
                return true
            case Ty.Tuple(ts):
                return any(self.managed(x) for x in ts)
            case Ty.Struct(sid):
                return any(self.managed(f.1) for f in self.info.structs[sid].fields)
            case Ty.Enum(eid):
                return self.info.enums[eid].has_payload()
            case _:
                return false

    fn boxed(self, t: Ty) -> bool:
        match t:
            case Ty.Enum(eid):
                return self.info.enums[eid].has_payload()
            case _:
                return false

    # Tuples and structs: values in memory, handled through pointers.
    fn agg(self, t: Ty) -> bool:
        match t:
            case Ty.Tuple(ts):
                return len(ts) > 0
            case Ty.Struct(_):
                return true
            case _:
                return false

    fn kind(self, t: Ty) -> K:
        match t:
            case Ty.Int(k):
                return int_kind(k)
            case Ty.Float(FloatTy.F32):
                return K.F32
            case Ty.Float(FloatTy.F64):
                return K.F64
            case Ty.Bool:
                return K.Bool
            case Ty.Unit:
                return K.U8
            case Ty.Tuple(ts):
                if len(ts) == 0:
                    return K.U8
                return K.Ptr
            case Ty.Enum(eid):
                if self.info.enums[eid].has_payload():
                    return K.Ptr
                return K.I32
            case _:
                return K.Ptr

    fn mark_done(ref self, k: str) -> bool:
        if k in self.done:
            return false
        self.done[k] = true
        return true

    fn mangle(self, t: Ty) -> str:
        match t:
            case Ty.Int(k):
                return k.suffix()
            case Ty.Float(FloatTy.F64):
                return "f64"
            case Ty.Float(FloatTy.F32):
                return "f32"
            case Ty.Bool:
                return "bool"
            case Ty.Str:
                return "str"
            case Ty.Array(e):
                return "arr_" + self.mangle(e)
            case Ty.Map(k, v):
                return "map_" + self.mangle(k) + "_" + self.mangle(v)
            case Ty.Tuple(ts):
                return f"tup{len(ts)}_" + "_".join([self.mangle(x) for x in ts])
            case Ty.Struct(sid):
                return self.info.structs[sid].c_name
            case Ty.Enum(eid):
                return self.info.enums[eid].c_name
            case _:
                return "unit"

    # The field types of a tuple or struct.
    fn field_tys(self, t: Ty) -> [Ty]:
        match t:
            case Ty.Struct(sid):
                return [fd.1 for fd in self.info.structs[sid].fields]
            case Ty.Tuple(ts):
                return ts
            case _:
                return []

    fn lay(self, t: Ty) -> Lay:
        match t:
            case Ty.Int(k):
                let b = k.bits() / 8
                return Lay(size=b, align=b)
            case Ty.Float(FloatTy.F32):
                return Lay(size=4, align=4)
            case Ty.Bool | Ty.Unit:
                return Lay(size=1, align=1)
            case Ty.Enum(eid):
                if self.info.enums[eid].has_payload():
                    return Lay(size=8, align=8)
                return Lay(size=4, align=4)
            case Ty.Struct(sid):
                return self.slays[sid]
            case Ty.Tuple(ts):
                if len(ts) == 0:
                    return Lay(size=1, align=1)
                return self.struct_lay(ts).0
            case _:
                return Lay(size=8, align=8)

    # C's layout of a struct with fields of types `ts`.
    fn struct_lay(self, ts: [Ty]) -> (Lay, [int]):
        var off = 0
        var al = 1
        var offs: [int] = []
        for x in ts:
            let l = self.lay(x)
            off = align_up(off, l.align)
            offs.push(off)
            off += l.size
            al = max(al, l.align)
        if len(ts) == 0:
            off = 1
        return (Lay(size=align_up(off, al), align=al), offs)

    fn field_off(self, t: Ty, idx: int) -> int:
        match t:
            case Ty.Struct(sid):
                return self.soffs[sid][idx]
            case Ty.Tuple(ts):
                return self.struct_lay(ts).1 [idx]
            case _:
                return 0

    fn box_lay(self, eid: int) -> BoxLay:
        return self.blays[eid]

    # Offset of field `fi` of variant `vi` in the enum's box.
    fn vfield_off(self, eid: int, vi: int, fi: int) -> int:
        return self.blays[eid].voffs[vi][fi]

    # Struct layouts depend on the layouts of the structs they contain, so they
    # are computed once, up front, inner structs first.
    fn prep_layouts(ref self):
        let ns = len(self.info.structs)
        self.slays = [Lay(size=1, align=1)] * ns
        let none: [int] = []
        self.soffs = [none] * ns
        self.sdone = [false] * ns
        for sid in 0..ns:
            self.prep_struct(sid)
        for eid in 0..len(self.info.enums):
            self.blays.push(self.make_box_lay(eid))

    fn prep_ty(ref self, t: Ty):
        match t:
            case Ty.Struct(sid):
                self.prep_struct(sid)
            case Ty.Tuple(ts):
                for x in ts:
                    self.prep_ty(x)
            case _:
                pass

    fn prep_struct(ref self, sid: int):
        if self.sdone[sid]:
            return
        self.sdone[sid] = true
        let fts = [fd.1 for fd in self.info.structs[sid].fields]
        for x in fts:
            self.prep_ty(x)
        let r = self.struct_lay(fts)
        self.slays[sid] = r.0
        self.soffs[sid] = r.1

    fn make_box_lay(self, eid: int) -> BoxLay:
        let en = self.info.enums[eid]
        var ual = 1
        var usz = 0
        var lays: [(Lay, [int])] = []
        for v in en.variants:
            let r = self.struct_lay([fd.1 for fd in v.fields])
            lays.push(r)
            if len(v.fields) > 0:
                ual = max(ual, r.0.align)
                usz = max(usz, r.0.size)
        let uoff = align_up(16, ual)
        let bal = max(8, ual)
        var vsize: [int] = []
        var voffs: [[int]] = []
        for i, v in enumerate(en.variants):
            let r = lays[i]
            vsize.push(uoff + (r.0.size if len(v.fields) > 0 else 0))
            voffs.push([uoff + o for o in r.1])
        return BoxLay(
            uoff=uoff,
            size=align_up(uoff + align_up(usz, ual), bal),
            vsize=vsize,
            voffs=voffs
        )

    # ============================================================ values in memory
    # The value of type `t` at p + off: loaded, or (an aggregate) its address.
    fn ld(ref self, p: int, off: int, t: Ty) -> int:
        if self.agg(t):
            # a new vreg even at offset 0: temps are known by vreg, and a
            # field must not be mistaken for the aggregate holding it
            if off == 0:
                return self.cx.fb.copy_of(p)
            return self.cx.fb.offset(p, off)
        return self.cx.fb.load(self.kind(t), p, off)

    fn st(ref self, p: int, off: int, t: Ty, v: int):
        if self.agg(t):
            let lay = self.lay(t)
            let d = self.cx.fb.offset(p, off)
            self.cx.fb.copy(d, v, lay.size)
        else:
            self.cx.fb.store(p, off, v)

    # The address of a value: an aggregate already is one; a scalar is
    # stored in a new stack slot.
    fn addr_of(ref self, v: int, t: Ty) -> int:
        if self.agg(t):
            return v
        let lay = self.lay(t)
        let p = self.cx.fb.temp_mem(lay.size, lay.align)
        self.cx.fb.store(p, 0, v)
        return p

    # A new home for a local variable of type `t`.
    fn new_local(ref self, id: int, t: Ty) -> int:
        if self.cx.twin == 2:
            match self.cx.twin_slots.get(id):
                case Some(s0):
                    self.cx.lslot[id] = s0
                    let p0 = self.cx.fb.slot_addr(s0)
                    self.cx.twin_ptrs.push((s0, p0))
                    return p0
                case None:
                    pass
        let lay = self.lay(t)
        let s = self.cx.fb.slot(lay.size, lay.align)
        self.cx.fb.name_slot(s, self.flocals[id].name, not self.agg(t), self.kind(t))
        self.cx.lslot[id] = s
        if self.opts.debug:
            let lk = self.flocals[id].kind
            let param = lk == LocalKind.Param or lk == LocalKind.RefParam
            self.dbg_var(id, s, -1, param)
        if self.cx.twin == 1:
            self.cx.twin_slots[id] = s
        let p = self.cx.fb.slot_addr(s)
        if self.cx.twin == 2:
            self.cx.twin_ptrs.push((s, p))
        return p

    fn local_ptr(ref self, id: int) -> int:
        match self.cx.lptr.get(id):
            case Some(p):
                return p
            case None:
                pass
        match self.cx.lslot.get(id):
            case Some(s):
                return self.cx.fb.slot_addr(s)
            case None:
                panic(f"lowering: local {id} ({self.flocals[id].name}) has no home")
        return -1

    fn read_local(ref self, id: int) -> int:
        let p = self.local_ptr(id)
        return self.ld(p, 0, self.flocals[id].ty)

    # ============================================================ debug info
    # Debug builds describe each function's variables and their types for
    # debuggers (see `Func.dvars` and `Module.dtypes`).
    fn dbg_func(ref self, f: FnDecl, is_test: bool):
        var name = f.name
        if is_test:
            name = "test " + f.test_name.unwrap_or(f.name)
        else:
            let sig = self.info.fns[f.id]
            name = sig.name
            match sig.method_of:
                case Some(t):
                    name = self.info.ty_name(t) + "." + sig.name
                case None:
                    pass
            if self.ret_has(sig.ret) and not self.kind(sig.ret).is_wide():
                self.cx.fb.f.dret = self.dty(sig.ret)
        let file = self.sm.file(f.span.file)
        let (l, _) = file.line_col(f.span.lo)
        self.cx.fb.f.dname = name
        self.cx.fb.f.dfile = file.path
        self.cx.fb.f.dline = l

    # Local `id` lives in stack slot `slot`, or behind the pointer in vreg `ptr`.
    fn dbg_var(ref self, id: int, slot: int, ptr: int, param: bool):
        let li = self.flocals[id]
        if li.name == "_" or li.name.starts_with("__"):
            return
        let ty = self.dty(li.ty)
        let lo = len(self.cx.fb.f.code)
        self.cx.fb.f.dvars.push(
            DVar(name=li.name, ty=ty, slot=slot, ptr=ptr, param=param, lo=lo, hi=-1)
        )

    fn dbg_ptr_var(ref self, id: int, v: int, param: bool):
        if self.opts.debug:
            self.dbg_var(id, -1, v, param)

    # The variables declared since `mark` go out of scope here.
    fn dbg_close(ref self, mark: int):
        let here = len(self.cx.fb.f.code)
        for i in mark..len(self.cx.fb.f.dvars):
            if self.cx.fb.f.dvars[i].hi < 0:
                self.cx.fb.f.dvars[i].hi = here

    fn dty_add(ref self, d: DType) -> int:
        self.dtypes.push(d)
        return len(self.dtypes) - 1

    # The debug type of `t`, by index (described once, even when recursive).
    fn dty(ref self, t: Ty) -> int:
        let key = self.mangle(t)
        match self.dtys.get(key):
            case Some(i):
                return i
            case None:
                pass
        let i = self.dty_add(dbase("?", K.I64))
        self.dtys[key] = i
        let d = self.make_dty(t)
        self.dtypes[i] = d
        return i

    # A pointer to debug type `to` (-1: to anything).
    fn dty_ptr(ref self, to: int) -> int:
        let key = f"#ptr{to}"
        match self.dtys.get(key):
            case Some(i):
                return i
            case None:
                pass
        let i = self.dty_add(DType(tag=DT_PTR, name="", size=8, k=K.Ptr, to=to, fields=[]))
        self.dtys[key] = i
        return i

    # Strings, arrays, maps and enum boxes are pointers to runtime objects
    # (brine_rt.h); debuggers see them under their brine names (`str`,
    # `[int]`), which is what the pretty-printers look for.
    fn make_dty(ref self, t: Ty) -> DType:
        let name = self.info.ty_name(t)
        match t:
            case Ty.Int(_) | Ty.Float(_) | Ty.Bool:
                return dbase(name, self.kind(t))
            case Ty.Str:
                let int = self.dty(int_ty())
                let ch = self.dty_add(dbase("char", K.U8))
                let data = self.dty_add(
                    DType(tag=DT_ARRAY, name="", size=0, k=K.U8, to=ch, fields=[])
                )
                let fs = [dfield("rc", int, 0), dfield("len", int, 8), dfield("data", data, 16)]
                let s = self.dty_add(dstruct("brine_str", 16, fs))
                return dtypedef(name, self.dty_ptr(s))
            case Ty.Array(e):
                let int = self.dty(int_ty())
                let any = self.dty_ptr(-1)
                let et = self.dty(e)
                let ep = self.dty_ptr(et)
                let fs = [
                    dfield("rc", int, 0),
                    dfield("len", int, 8),
                    dfield("cap", int, 16),
                    dfield("esz", int, 24),
                    dfield("retain", any, 32),
                    dfield("release", any, 40),
                    dfield("data", ep, 48)
                ]
                let s = self.dty_add(dstruct("brine_arr " + name, 56, fs))
                return dtypedef(name, self.dty_ptr(s))
            case Ty.Map(k, v):
                let int = self.dty(int_ty())
                let any = self.dty_ptr(-1)
                let kt = self.dty(k)
                let kp = self.dty_ptr(kt)
                let vt = self.dty(v)
                let vp = self.dty_ptr(vt)
                let bt = self.dty(Ty.Bool)
                let bp = self.dty_ptr(bt)
                let fs = [
                    dfield("rc", int, 0),
                    dfield("len", int, 8),
                    dfield("used", int, 16),
                    dfield("cap", int, 24),
                    dfield("nidx", int, 32),
                    dfield("ty", any, 40),
                    dfield("keys", kp, 48),
                    dfield("vals", vp, 56),
                    dfield("hashes", any, 64),
                    dfield("live", bp, 72),
                    dfield("index", any, 80)
                ]
                let s = self.dty_add(dstruct("brine_map " + name, 88, fs))
                return dtypedef(name, self.dty_ptr(s))
            case Ty.Struct(sid):
                var fs: [DField] = []
                for i, fd in enumerate(self.info.structs[sid].fields):
                    let ft = self.dty(fd.1)
                    fs.push(dfield(fd.0, ft, self.soffs[sid][i]))
                return dstruct(name, self.slays[sid].size, fs)
            case Ty.Tuple(ts):
                if len(ts) == 0:
                    return dbase("()", K.U8)
                let (lay, offs) = self.struct_lay(ts)
                var fs: [DField] = []
                for i, x in enumerate(ts):
                    fs.push(dfield(f"_{i}", self.dty(x), offs[i]))
                return dstruct(name, lay.size, fs)
            case Ty.Enum(eid):
                let en = self.info.enums[eid]
                var vals: [DField] = []
                for vi in 0..len(en.variants):
                    vals.push(dfield(en.variant_label(vi), -1, vi))
                if not en.has_payload():
                    return DType(tag=DT_ENUM, name=name, size=4, k=K.I32, to=-1, fields=vals)
                # a box: {rc, tag, the union of the variants with fields}
                let int = self.dty(int_ty())
                let bl = self.blays[eid]
                let tag = self.dty_add(
                    DType(tag=DT_ENUM, name=name + ".tag", size=8, k=K.I64, to=-1, fields=vals)
                )
                var vs: [DField] = []
                for vi, v in enumerate(en.variants):
                    if len(v.fields) == 0:
                        continue
                    var fs: [DField] = []
                    for fi, fd in enumerate(v.fields):
                        fs.push(dfield(fd.0, self.dty(fd.1), bl.voffs[vi][fi] - bl.uoff))
                    let vt = self.dty_add(dstruct(en.variant_label(vi), bl.vsize[vi] - bl.uoff, fs))
                    vs.push(dfield(v.name, vt, 0))
                let u = self.dty_add(
                    DType(tag=DT_UNION, name=name + ".variants", size=bl.size - bl.uoff, k=K.I64, to=-1, fields=vs)
                )
                let fs = [
                    dfield("rc", int, 0),
                    dfield("tag", tag, 8),
                    dfield("variant", u, bl.uoff)
                ]
                let b = self.dty_add(dstruct("brine_box " + name, bl.size, fs))
                return dtypedef(name, self.dty_ptr(b))
            case _:
                return dbase("()", K.U8)

    # ============================================================ reference counting
    fn retain(ref self, v: int, t: Ty):
        match t:
            case Ty.Str:
                self.cx.fb.rt_void("brine_str_retain", [v])
            case Ty.Array(_):
                self.cx.fb.rt_void("brine_arr_retain", [v])
            case Ty.Map(_, _):
                self.cx.fb.rt_void("brine_map_retain", [v])
            case Ty.Enum(_):
                if self.boxed(t):
                    self.cx.fb.rt_void("brine_box_retain", [v])
            case Ty.Tuple(_) | Ty.Struct(_):
                if self.managed(t):
                    let m = self.need_rc(t)
                    self.cx.fb.call_void("br_retain_" + m, [v])
            case _:
                pass

    fn release(ref self, v: int, t: Ty):
        match t:
            case Ty.Str:
                self.cx.fb.rt_void("brine_str_release", [v])
            case Ty.Array(_):
                self.cx.fb.rt_void("brine_arr_release", [v])
            case Ty.Map(_, _):
                self.cx.fb.rt_void("brine_map_release", [v])
            case Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                if self.managed(t):
                    let m = self.need_rc(t)
                    self.cx.fb.call_void("br_release_" + m, [v])
            case _:
                pass

    # Start building helper function `name`; `finish_helper` switches back.
    fn start_helper(ref self, name: str, params: [K], has_ret: bool, ret: K) -> FnCx:
        let saved = self.cx
        self.cx = new_cx(new_func(name, params, has_ret, ret))
        return saved

    fn finish_helper(ref self, saved: FnCx):
        if not self.cx.fb.ends():
            self.cx.fb.ret(-1)
        self.funcs.push(self.cx.fb.f)
        self.cx = saved

    # br_retain_<m>(v), br_release_<m>(v), and their `void (*)(void *)` forms
    # br_rtp_<m>(p), br_rlp_<m>(p) for arrays and maps.
    fn need_rc(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        if not self.mark_done("rc_" + m):
            return m
        match t:
            case Ty.Enum(eid):
                let variants = self.info.enums[eid].variants
                let s1 = self.start_helper("br_retain_" + m, [K.Ptr], false, K.I64)
                self.cx.fb.rt_void("brine_box_retain", [0])
                self.finish_helper(s1)
                let s2 = self.start_helper("br_release_" + m, [K.Ptr], false, K.I64)
                let dead = self.cx.fb.rt(K.Bool, "brine_box_dec", [0])
                let out = self.cx.fb.label()
                self.cx.fb.brnot(dead, out)
                let tag = self.cx.fb.load(K.I64, 0, 8)
                for vi, v in enumerate(variants):
                    if not any(self.managed(fd.1) for fd in v.fields):
                        continue
                    let next = self.cx.fb.label()
                    let vv = self.cx.fb.konst(K.I64, vi)
                    let hit = self.cx.fb.cmp(Op.Eq, tag, vv)
                    self.cx.fb.brnot(hit, next)
                    for fi, fd in enumerate(v.fields):
                        if self.managed(fd.1):
                            let x = self.ld(0, self.vfield_off(eid, vi, fi), fd.1)
                            self.release(x, fd.1)
                    self.cx.fb.place(next)
                self.cx.fb.call_void("brine_box_free", [0])
                self.cx.fb.place(out)
                self.finish_helper(s2)
                let s3 = self.start_helper("br_rtp_" + m, [K.Ptr], false, K.I64)
                let b3 = self.cx.fb.load(K.Ptr, 0, 0)
                self.cx.fb.rt_void("brine_box_retain", [b3])
                self.finish_helper(s3)
                let s4 = self.start_helper("br_rlp_" + m, [K.Ptr], false, K.I64)
                let b4 = self.cx.fb.load(K.Ptr, 0, 0)
                self.cx.fb.call_void("br_release_" + m, [b4])
                self.finish_helper(s4)
                return m
            case _:
                pass
        let ts = self.field_tys(t)
        let s5 = self.start_helper("br_retain_" + m, [K.Ptr], false, K.I64)
        for i, ft in enumerate(ts):
            if self.managed(ft):
                let x = self.ld(0, self.field_off(t, i), ft)
                self.retain(x, ft)
        self.finish_helper(s5)
        let s6 = self.start_helper("br_release_" + m, [K.Ptr], false, K.I64)
        for i, ft in enumerate(ts):
            if self.managed(ft):
                let x = self.ld(0, self.field_off(t, i), ft)
                self.release(x, ft)
        self.finish_helper(s6)
        # an aggregate's retain already takes its address
        let s7 = self.start_helper("br_rtp_" + m, [K.Ptr], false, K.I64)
        self.cx.fb.call_void("br_retain_" + m, [0])
        self.finish_helper(s7)
        let s8 = self.start_helper("br_rlp_" + m, [K.Ptr], false, K.I64)
        self.cx.fb.call_void("br_release_" + m, [0])
        self.finish_helper(s8)
        return m

    # The element retain/release functions arrays of `t` use (or "" for none).
    fn elem_fns(ref self, t: Ty) -> (str, str):
        match t:
            case Ty.Str:
                return ("brine_rt_str", "brine_rl_str")
            case Ty.Array(_):
                return ("brine_rt_arr", "brine_rl_arr")
            case Ty.Map(_, _):
                return ("brine_rt_map", "brine_rl_map")
            case Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                if self.managed(t):
                    let m = self.need_rc(t)
                    return ("br_rtp_" + m, "br_rlp_" + m)
                return ("", "")
            case _:
                return ("", "")

    fn fn_ptr(ref self, sym: str) -> int:
        if sym == "":
            return self.cx.fb.konst(K.Ptr, 0)
        return self.cx.fb.global(sym)

    # brine_arr_new(n, sizeof(elem), retain, release, loc)
    fn new_arr(ref self, elem: Ty, n: int, loc: int) -> int:
        let (rt, rl) = self.elem_fns(elem)
        let sz = self.cx.fb.konst(K.I64, self.lay(elem).size)
        let a = self.fn_ptr(rt)
        let b = self.fn_ptr(rl)
        let n64 = self.cx.fb.conv(K.I64, n)
        return self.cx.fb.call(K.Ptr, "brine_arr_new", [n64, sz, a, b, loc])

    # ============================================================ string building
    # A new string builder on the stack.
    fn sb_new(ref self) -> int:
        let sb = self.cx.fb.temp_mem(24, 8)
        self.cx.fb.call_void("brine_sb_init", [sb])
        return sb

    fn sb_lit(ref self, sb: int, s: str):
        if s == "":
            return
        let p = self.cstr(s)
        let n = self.cx.fb.konst(K.I64, len(s))
        self.cx.fb.call_void("brine_sb_cat", [sb, p, n])

    # Append value `v` of type `t` to the builder at `sb`.
    fn fmt_code(ref self, sb: int, v: int, t: Ty, nested: bool):
        match t:
            case Ty.Int(IntTy.I128):
                self.cx.fb.rt_void("brine_sb_i128", [sb, v])
            case Ty.Int(IntTy.U128):
                self.cx.fb.rt_void("brine_sb_u128", [sb, v])
            case Ty.Int(k):
                if k.signed():
                    let x = self.cx.fb.conv(K.I64, v)
                    self.cx.fb.call_void("brine_sb_i64", [sb, x])
                else:
                    let x = self.cx.fb.conv(K.U64, v)
                    self.cx.fb.call_void("brine_sb_u64", [sb, x])
            case Ty.Float(FloatTy.F64):
                self.cx.fb.call_void("brine_sb_f64", [sb, v])
            case Ty.Float(FloatTy.F32):
                self.cx.fb.call_void("brine_sb_f32", [sb, v])
            case Ty.Bool:
                self.cx.fb.call_void("brine_sb_bool", [sb, v])
            case Ty.Unit:
                self.sb_lit(sb, "()")
            case Ty.Str:
                if nested:
                    self.cx.fb.call_void("brine_sb_repr_str", [sb, v])
                else:
                    self.cx.fb.call_void("brine_sb_str", [sb, v])
            case Ty.Array(_) | Ty.Map(_, _) | Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                let f = self.need_fmt(t)
                self.cx.fb.call_void(f, [sb, v])
            case _:
                pass

    fn need_fmt(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_fmt_" + m
        if not self.mark_done(name):
            return name
        let saved = self.start_helper(name, [K.Ptr, self.kind(t)], false, K.I64)
        let sb = 0
        let v = 1
        match t:
            case Ty.Array(e):
                self.sb_lit(sb, "[")
                let n = self.cx.fb.load(K.I64, v, 8)
                let data = self.cx.fb.load(K.Ptr, v, 48)
                let esz = self.lay(e).size
                let i = self.cx.fb.konst(K.I64, 0)
                let zero = self.cx.fb.konst(K.I64, 0)
                let one = self.cx.fb.konst(K.I64, 1)
                let head = self.cx.fb.label()
                let out = self.cx.fb.label()
                let first = self.cx.fb.label()
                self.cx.fb.place(head)
                let more = self.cx.fb.cmp(Op.Lt, i, n)
                self.cx.fb.brnot(more, out)
                let is0 = self.cx.fb.cmp(Op.Eq, i, zero)
                self.cx.fb.br(is0, first)
                self.sb_lit(sb, ", ")
                self.cx.fb.place(first)
                let p = self.cx.fb.elem(data, i, esz)
                let x = self.ld(p, 0, e)
                self.fmt_code(sb, x, e, true)
                let i2 = self.cx.fb.bin(Op.Add, K.I64, i, one)
                self.cx.fb.mov(i, i2)
                self.cx.fb.jmp(head)
                self.cx.fb.place(out)
                self.sb_lit(sb, "]")
            case Ty.Map(kt, vt):
                self.sb_lit(sb, "{")
                let used = self.cx.fb.load(K.I64, v, 16)
                let keys = self.cx.fb.load(K.Ptr, v, 48)
                let vals = self.cx.fb.load(K.Ptr, v, 56)
                let live = self.cx.fb.load(K.Ptr, v, 72)
                let i = self.cx.fb.konst(K.I64, 0)
                let n = self.cx.fb.konst(K.I64, 0)
                let zero = self.cx.fb.konst(K.I64, 0)
                let one = self.cx.fb.konst(K.I64, 1)
                let head = self.cx.fb.label()
                let next = self.cx.fb.label()
                let out = self.cx.fb.label()
                let first = self.cx.fb.label()
                self.cx.fb.place(head)
                let more = self.cx.fb.cmp(Op.Lt, i, used)
                self.cx.fb.brnot(more, out)
                let lp = self.cx.fb.elem(live, i, 1)
                let alive = self.cx.fb.load(K.Bool, lp, 0)
                self.cx.fb.brnot(alive, next)
                let is0 = self.cx.fb.cmp(Op.Eq, n, zero)
                let n2 = self.cx.fb.bin(Op.Add, K.I64, n, one)
                self.cx.fb.mov(n, n2)
                self.cx.fb.br(is0, first)
                self.sb_lit(sb, ", ")
                self.cx.fb.place(first)
                let kp = self.cx.fb.elem(keys, i, self.lay(kt).size)
                let kx = self.ld(kp, 0, kt)
                self.fmt_code(sb, kx, kt, true)
                self.sb_lit(sb, ": ")
                let vp = self.cx.fb.elem(vals, i, self.lay(vt).size)
                let vx = self.ld(vp, 0, vt)
                self.fmt_code(sb, vx, vt, true)
                self.cx.fb.place(next)
                let i2 = self.cx.fb.bin(Op.Add, K.I64, i, one)
                self.cx.fb.mov(i, i2)
                self.cx.fb.jmp(head)
                self.cx.fb.place(out)
                self.sb_lit(sb, "}")
            case Ty.Tuple(_) | Ty.Struct(_):
                var open = "("
                var names: [str] = []
                let ts = self.field_tys(t)
                match t:
                    case Ty.Struct(sid):
                        let s = self.info.structs[sid]
                        open = s.name + "("
                        names = [fd.0 + "=" for fd in s.fields]
                    case _:
                        names = [""] * len(ts)
                self.sb_lit(sb, open)
                for i, ft in enumerate(ts):
                    let sep = ", " if i > 0 else ""
                    self.sb_lit(sb, sep + names[i])
                    let x = self.ld(v, self.field_off(t, i), ft)
                    self.fmt_code(sb, x, ft, true)
                self.sb_lit(sb, ")")
            case Ty.Enum(eid):
                let en = self.info.enums[eid]
                let boxed = en.has_payload()
                var tag = v
                if boxed:
                    tag = self.cx.fb.load(K.I64, v, 8)
                let out = self.cx.fb.label()
                for vi, var_ in enumerate(en.variants):
                    let next = self.cx.fb.label()
                    let vv = self.cx.fb.konst(K.I64 if boxed else K.I32, vi)
                    let hit = self.cx.fb.cmp(Op.Eq, tag, vv)
                    self.cx.fb.brnot(hit, next)
                    let head = en.variant_label(vi) + ("" if len(var_.fields) == 0 else "(")
                    self.sb_lit(sb, head)
                    for fi, fd in enumerate(var_.fields):
                        # prelude enums print like `Some(5)`, others like `Shape.Circle(radius=1.0)`
                        let pre = ("" if fi == 0 else ", ") + ("" if en.bare else fd.0 + "=")
                        self.sb_lit(sb, pre)
                        let x = self.ld(v, self.vfield_off(eid, vi, fi), fd.1)
                        self.fmt_code(sb, x, fd.1, true)
                    if len(var_.fields) > 0:
                        self.sb_lit(sb, ")")
                    self.cx.fb.jmp(out)
                    self.cx.fb.place(next)
                self.cx.fb.place(out)
            case _:
                pass
        self.finish_helper(saved)
        return name

    # ============================================================ equality, hashing, ordering
    # Bool: a == b for values of type t.
    fn eq_code(ref self, a: int, b: int, t: Ty) -> int:
        match t:
            case Ty.Str:
                return self.cx.fb.rt(K.Bool, "brine_str_eq", [a, b])
            case Ty.Map(_, _):
                self.map_ty(t)
                return self.cx.fb.call(K.Bool, "brine_map_eq", [a, b])
            case Ty.Array(_) | Ty.Struct(_):
                let f = self.need_eq(t)
                return self.cx.fb.call(K.Bool, f, [a, b])
            case Ty.Tuple(_):
                if not self.agg(t):
                    return self.cx.fb.konst(K.Bool, 1)
                let f = self.need_eq(t)
                return self.cx.fb.call(K.Bool, f, [a, b])
            case Ty.Enum(_):
                if self.boxed(t):
                    let f = self.need_eq(t)
                    return self.cx.fb.call(K.Bool, f, [a, b])
                return self.cx.fb.cmp(Op.Eq, a, b)
            case _:
                return self.cx.fb.cmp(Op.Eq, a, b)

    fn need_eq(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_eq_" + m
        if not self.mark_done(name):
            return name
        let k = self.kind(t)
        let saved = self.start_helper(name, [k, k], true, K.Bool)
        let a = 0
        let b = 1
        let yes = self.cx.fb.konst(K.Bool, 1)
        let no = self.cx.fb.konst(K.Bool, 0)
        let lno = self.cx.fb.label()
        match t:
            case Ty.Array(e):
                let lyes = self.cx.fb.label()
                let same = self.cx.fb.cmp(Op.Eq, a, b)
                self.cx.fb.br(same, lyes)
                let na = self.cx.fb.load(K.I64, a, 8)
                let nb = self.cx.fb.load(K.I64, b, 8)
                let dl = self.cx.fb.cmp(Op.Ne, na, nb)
                self.cx.fb.br(dl, lno)
                let da = self.cx.fb.load(K.Ptr, a, 48)
                let db = self.cx.fb.load(K.Ptr, b, 48)
                let esz = self.lay(e).size
                let i = self.cx.fb.konst(K.I64, 0)
                let one = self.cx.fb.konst(K.I64, 1)
                let head = self.cx.fb.label()
                self.cx.fb.place(head)
                let more = self.cx.fb.cmp(Op.Lt, i, na)
                self.cx.fb.brnot(more, lyes)
                let pa = self.cx.fb.elem(da, i, esz)
                let pb = self.cx.fb.elem(db, i, esz)
                let xa = self.ld(pa, 0, e)
                let xb = self.ld(pb, 0, e)
                let q = self.eq_code(xa, xb, e)
                self.cx.fb.brnot(q, lno)
                let i2 = self.cx.fb.bin(Op.Add, K.I64, i, one)
                self.cx.fb.mov(i, i2)
                self.cx.fb.jmp(head)
                self.cx.fb.place(lyes)
                self.cx.fb.ret(yes)
            case Ty.Enum(eid):
                let variants = self.info.enums[eid].variants
                let lyes = self.cx.fb.label()
                let same = self.cx.fb.cmp(Op.Eq, a, b)
                self.cx.fb.br(same, lyes)
                let ta = self.cx.fb.load(K.I64, a, 8)
                let tb = self.cx.fb.load(K.I64, b, 8)
                let dt = self.cx.fb.cmp(Op.Ne, ta, tb)
                self.cx.fb.br(dt, lno)
                for vi, v in enumerate(variants):
                    if len(v.fields) == 0:
                        continue
                    let next = self.cx.fb.label()
                    let vv = self.cx.fb.konst(K.I64, vi)
                    let hit = self.cx.fb.cmp(Op.Eq, ta, vv)
                    self.cx.fb.brnot(hit, next)
                    for fi, fd in enumerate(v.fields):
                        let off = self.vfield_off(eid, vi, fi)
                        let xa = self.ld(a, off, fd.1)
                        let xb = self.ld(b, off, fd.1)
                        let q = self.eq_code(xa, xb, fd.1)
                        self.cx.fb.brnot(q, lno)
                    self.cx.fb.jmp(lyes)
                    self.cx.fb.place(next)
                self.cx.fb.place(lyes)
                self.cx.fb.ret(yes)
            case _:
                for i, ft in enumerate(self.field_tys(t)):
                    let off = self.field_off(t, i)
                    let xa = self.ld(a, off, ft)
                    let xb = self.ld(b, off, ft)
                    let q = self.eq_code(xa, xb, ft)
                    self.cx.fb.brnot(q, lno)
                self.cx.fb.ret(yes)
        self.cx.fb.place(lno)
        self.cx.fb.ret(no)
        self.finish_helper(saved)
        return name

    # U64: a hash of `v` (equal values hash equally).
    fn hash_code(ref self, v: int, t: Ty) -> int:
        match t:
            case Ty.Int(k):
                if k.bits() == 128:
                    let u = self.cx.fb.conv(K.U128, v)
                    return self.cx.fb.rt(K.U64, "brine_hash_u128", [u])
                let x = self.cx.fb.conv(K.U64, v)
                return self.cx.fb.rt(K.U64, "brine_hash_u64", [x])
            case Ty.Bool:
                let x = self.cx.fb.conv(K.U64, v)
                return self.cx.fb.rt(K.U64, "brine_hash_u64", [x])
            case Ty.Enum(_):
                if not self.boxed(t):
                    let x = self.cx.fb.conv(K.U64, v)
                    return self.cx.fb.rt(K.U64, "brine_hash_u64", [x])
                let f = self.need_hash(t)
                return self.cx.fb.call(K.U64, f, [v])
            case Ty.Str:
                return self.cx.fb.rt(K.U64, "brine_hash_str", [v])
            case Ty.Array(_) | Ty.Tuple(_) | Ty.Struct(_):
                let f = self.need_hash(t)
                return self.cx.fb.call(K.U64, f, [v])
            case _:
                return self.cx.fb.konst(K.U64, 0)

    fn need_hash(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_hash_" + m
        if not self.mark_done(name):
            return name
        let saved = self.start_helper(name, [self.kind(t)], true, K.U64)
        let v = 0
        let h = self.cx.fb.konst(K.U64, 2216829733)
        match t:
            case Ty.Array(e):
                let n = self.cx.fb.load(K.I64, v, 8)
                let data = self.cx.fb.load(K.Ptr, v, 48)
                let esz = self.lay(e).size
                let i = self.cx.fb.konst(K.I64, 0)
                let one = self.cx.fb.konst(K.I64, 1)
                let head = self.cx.fb.label()
                let out = self.cx.fb.label()
                self.cx.fb.place(head)
                let more = self.cx.fb.cmp(Op.Lt, i, n)
                self.cx.fb.brnot(more, out)
                let p = self.cx.fb.elem(data, i, esz)
                let x = self.ld(p, 0, e)
                let c = self.hash_code(x, e)
                let h2 = self.cx.fb.rt(K.U64, "brine_hash_mix", [h, c])
                self.cx.fb.mov(h, h2)
                let i2 = self.cx.fb.bin(Op.Add, K.I64, i, one)
                self.cx.fb.mov(i, i2)
                self.cx.fb.jmp(head)
                self.cx.fb.place(out)
                let nu = self.cx.fb.conv(K.U64, n)
                let h3 = self.cx.fb.rt(K.U64, "brine_hash_mix", [h, nu])
                self.cx.fb.mov(h, h3)
            case Ty.Enum(eid):
                let variants = self.info.enums[eid].variants
                let tag = self.cx.fb.load(K.I64, v, 8)
                let tu = self.cx.fb.conv(K.U64, tag)
                let h1 = self.cx.fb.rt(K.U64, "brine_hash_mix", [h, tu])
                self.cx.fb.mov(h, h1)
                let out = self.cx.fb.label()
                for vi, var_ in enumerate(variants):
                    if len(var_.fields) == 0:
                        continue
                    let next = self.cx.fb.label()
                    let vv = self.cx.fb.konst(K.I64, vi)
                    let hit = self.cx.fb.cmp(Op.Eq, tag, vv)
                    self.cx.fb.brnot(hit, next)
                    for fi, fd in enumerate(var_.fields):
                        let x = self.ld(v, self.vfield_off(eid, vi, fi), fd.1)
                        let c = self.hash_code(x, fd.1)
                        let h2 = self.cx.fb.rt(K.U64, "brine_hash_mix", [h, c])
                        self.cx.fb.mov(h, h2)
                    self.cx.fb.jmp(out)
                    self.cx.fb.place(next)
                self.cx.fb.place(out)
            case _:
                for i, ft in enumerate(self.field_tys(t)):
                    let x = self.ld(v, self.field_off(t, i), ft)
                    let c = self.hash_code(x, ft)
                    let h2 = self.cx.fb.rt(K.U64, "brine_hash_mix", [h, c])
                    self.cx.fb.mov(h, h2)
        self.cx.fb.ret(h)
        self.finish_helper(saved)
        return name

    # `int cmp(const void *, const void *)` ordering values of `t` (for sorting).
    fn need_cmp(ref self, t: Ty) -> str:
        let m = self.mangle(t)
        let name = "br_cmp_" + m
        if not self.mark_done(name):
            return name
        let saved = self.start_helper(name, [K.Ptr, K.Ptr], true, K.I32)
        let x = self.ld(0, 0, t)
        let y = self.ld(1, 0, t)
        match t:
            case Ty.Str:
                let r = self.cx.fb.call(K.I32, "brine_str_cmp", [x, y])
                self.cx.fb.ret(r)
            case _:
                if t.is_float():
                    # NaN sorts after every number
                    let xn = self.cx.fb.cmp(Op.Ne, x, x)
                    let yn = self.cx.fb.cmp(Op.Ne, y, y)
                    let any_nan = self.cx.fb.bin(Op.Or, K.Bool, xn, yn)
                    let plain = self.cx.fb.label()
                    self.cx.fb.brnot(any_nan, plain)
                    let a = self.cx.fb.conv(K.I32, xn)
                    let b = self.cx.fb.conv(K.I32, yn)
                    let d = self.cx.fb.bin(Op.Sub, K.I32, a, b)
                    self.cx.fb.ret(d)
                    self.cx.fb.place(plain)
                let gt = self.cx.fb.cmp(Op.Gt, x, y)
                let lt = self.cx.fb.cmp(Op.Lt, x, y)
                let g = self.cx.fb.conv(K.I32, gt)
                let l = self.cx.fb.conv(K.I32, lt)
                let r = self.cx.fb.bin(Op.Sub, K.I32, g, l)
                self.cx.fb.ret(r)
        self.finish_helper(saved)
        return name

    # The `brine_map_ty` descriptor for map type `t` (its address).
    fn map_ty(ref self, t: Ty) -> int:
        var k = Ty.Error
        var v = Ty.Error
        match t:
            case Ty.Map(a, b):
                k = a
                v = b
            case _:
                pass
        let m = self.mangle(t)
        let name = "br_mt_" + m
        if not self.mark_done(name):
            return self.cx.fb.global(name)
        let s1 = self.start_helper("br_hk_" + m, [K.Ptr], true, K.U64)
        let kx = self.ld(0, 0, k)
        let h = self.hash_code(kx, k)
        self.cx.fb.ret(h)
        self.finish_helper(s1)
        let s2 = self.start_helper("br_kq_" + m, [K.Ptr, K.Ptr], true, K.Bool)
        let ka = self.ld(0, 0, k)
        let kb = self.ld(1, 0, k)
        let qk = self.eq_code(ka, kb, k)
        self.cx.fb.ret(qk)
        self.finish_helper(s2)
        let s3 = self.start_helper("br_vq_" + m, [K.Ptr, K.Ptr], true, K.Bool)
        let va = self.ld(0, 0, v)
        let vb = self.ld(1, 0, v)
        let qv = self.eq_code(va, vb, v)
        self.cx.fb.ret(qv)
        self.finish_helper(s3)
        let s4 = self.start_helper("br_kf_" + m, [K.Ptr, K.Ptr], false, K.I64)
        let kf = self.ld(1, 0, k)
        self.fmt_code(0, kf, k, true)
        self.finish_helper(s4)
        # br_mf_<m>(map, &key): the key's entry or -1, with the hash and the
        # key comparison known, so the C compiler inlines the whole lookup
        let s5 = self.start_helper("br_mf_" + m, [K.Ptr, K.Ptr], true, K.I64)
        let fk = self.ld(1, 0, k)
        let hx = self.hash_code(fk, k)
        let kq = self.fn_ptr("br_kq_" + m)
        let ksz = self.cx.fb.konst(K.I64, self.lay(k).size)
        let exact = self.exact_hash(fk, k)
        let found = self.cx.fb.rt(K.I64, "brine_map_probe", [0, 1, hx, kq, ksz, exact])
        self.cx.fb.ret(found)
        self.finish_helper(s5)
        let (krt, krl) = self.elem_fns(k)
        let (vrt, vrl) = self.elem_fns(v)
        var b: [u8] = []
        le_bytes(ref b, self.lay(k).size, 8)
        le_bytes(ref b, self.lay(v).size, 8)
        var relocs: [Reloc] = []
        let fns = ["br_hk_" + m, "br_kq_" + m, "br_vq_" + m, "br_kf_" + m, krt, krl, vrt, vrl]
        for i, f in enumerate(fns):
            if f != "":
                relocs.push(Reloc(off=16 + 8 * i, sym=f, add=0))
            le_bytes(ref b, 0, 8)
        self.data.push(Data(name=name, align=8, bytes=b, relocs=relocs, readonly=true))
        return self.cx.fb.global(name)

    # The function finding a key in a map of type `t` (see `map_ty`).
    fn map_find(ref self, t: Ty) -> str:
        self.map_ty(t)
        return "br_mf_" + self.mangle(t)

    # Bool: is `hash_code(v, t)` one-to-one for this value, so that equal
    # hashes mean equal keys? (Integers up to 64 bits and the like go
    # through a bijection; strings of up to 7 bytes too, see brine_hash_str.)
    fn exact_hash(ref self, v: int, t: Ty) -> int:
        match t:
            case Ty.Int(k):
                return self.cx.fb.konst(K.Bool, 1 if k.bits() <= 64 else 0)
            case Ty.Bool:
                return self.cx.fb.konst(K.Bool, 1)
            case Ty.Enum(_):
                return self.cx.fb.konst(K.Bool, 0 if self.boxed(t) else 1)
            case Ty.Str:
                let n = self.cx.fb.load(K.I64, v, 8)
                let eight = self.cx.fb.konst(K.I64, 8)
                return self.cx.fb.cmp(Op.Lt, n, eight)
            case _:
                return self.cx.fb.konst(K.Bool, 0)

    # ============================================================ Option and Result
    fn variant_index(self, eid: int, name: str, dflt: int) -> int:
        for i, v in enumerate(self.info.enums[eid].variants):
            if v.name == name:
                return i
        return dflt

    # A new box for variant `vi` of enum `eid` (fields unset).
    fn box_new(ref self, eid: int, vi: int, full: bool) -> int:
        let bl = self.box_lay(eid)
        let size = bl.size if full else bl.vsize[vi]
        let sz = self.cx.fb.konst(K.I64, size)
        let tg = self.cx.fb.konst(K.I64, vi)
        return self.cx.fb.call(K.Ptr, "brine_box_new", [sz, tg])

    # A variant without fields: a static immortal box, or (no payloads) a number.
    fn variant_const(ref self, t: Ty, vi: int) -> int:
        let eid = cg_enum_id(t)
        if self.boxed(t):
            let ct = self.info.enums[eid].c_name
            let name = f"br_ev_{ct}_{vi}"
            if self.mark_done(name):
                var b: [u8] = []
                le_bytes(ref b, -1, 8)
                le_bytes(ref b, vi, 8)
                self.data.push(Data(name=name, align=8, bytes=b, relocs=[], readonly=false))
            return self.cx.fb.global(name)
        return self.cx.fb.konst(K.I32, vi)

    # An `Option` value: `Some(*vp)` when `present` holds, else `None`. The value
    # at `vp` is borrowed, and only read when present.
    fn make_option(ref self, oty: Ty, present: int, vp: int, vt: Ty) -> int:
        let eid = cg_enum_id(oty)
        let some = self.variant_index(eid, "Some", 0)
        let none = self.variant_index(eid, "None", 1)
        let t = self.cx.fb.vreg(K.Ptr)
        let nc = self.variant_const(oty, none)
        self.cx.fb.mov(t, nc)
        let skip = self.cx.fb.label()
        self.cx.fb.brnot(present, skip)
        let b = self.box_new(eid, some, false)
        let off = self.vfield_off(eid, some, 0)
        let val = self.ld(vp, 0, vt)
        self.st(b, off, vt, val)
        let fv = self.ld(b, off, vt)
        self.retain(fv, vt)
        self.cx.fb.mov(t, b)
        self.cx.fb.place(skip)
        return self.temp(t, oty)

    # A `Result` value: `Ok(val)` when `ok` holds, else `Err(err)`. Both are moved in.
    fn make_result(ref self, rty: Ty, ok: int, val: int, vty: Ty, err: int) -> int:
        let eid = cg_enum_id(rty)
        let okv = self.variant_index(eid, "Ok", 0)
        let errv = self.variant_index(eid, "Err", 1)
        let t = self.cx.fb.vreg(K.Ptr)
        let lerr = self.cx.fb.label()
        let done = self.cx.fb.label()
        self.cx.fb.brnot(ok, lerr)
        let b1 = self.box_new(eid, okv, true)
        self.st(b1, self.vfield_off(eid, okv, 0), vty, val)
        self.cx.fb.mov(t, b1)
        self.cx.fb.jmp(done)
        self.cx.fb.place(lerr)
        let b2 = self.box_new(eid, errv, true)
        self.cx.fb.store(b2, self.vfield_off(eid, errv, 0), err)
        self.cx.fb.mov(t, b2)
        self.cx.fb.place(done)
        return self.temp(t, rty)

    # ============================================================ literals
    fn int_lit(ref self, v: i128, t: Ty) -> int:
        match t:
            case Ty.Float(_):
                return self.float_lit(float(v), t)
            case Ty.Int(k):
                let kk = int_kind(k)
                if k.bits() == 128:
                    return self.cx.fb.konst128(kk, v)
                if k == IntTy.U64 and v > 9223372036854775807:
                    return self.cx.fb.konst(kk, int(v - 18446744073709551616))
                return self.cx.fb.konst(kk, int(v))
            case _:
                return self.cx.fb.konst(K.I64, int(v))

    fn float_lit(ref self, v: float, t: Ty) -> int:
        match t:
            case Ty.Float(FloatTy.F32):
                return self.cx.fb.fconst(K.F32, f32_bits(v))
            case _:
                return self.cx.fb.fconst(K.F64, f64_bits(v))

    fn const_val(ref self, id: int) -> int:
        let c = self.info.consts[id]
        match c.value:
            case ConstVal.Int(v):
                return self.int_lit(v, c.ty)
            case ConstVal.UInt(v):
                return self.cx.fb.konst128(K.U128, u128_bits(v))
            case ConstVal.Float(v):
                return self.float_lit(v, c.ty)
            case ConstVal.Bool(b):
                return self.cx.fb.konst(K.Bool, 1 if b else 0)
            case ConstVal.Str(s):
                return self.str_lit(s)

    # ============================================================ statements
    fn block(ref self, b: Block):
        self.push_scope()
        var k = 0
        while k < len(b.stmts):
            self.stmt(b.stmts[k])
            if self.rot_after(b.stmts, k):
                k += 3
            else:
                k += 1
        self.pop_scope()

    fn stmt(ref self, s: Stmt):
        if self.opts.debug:
            let file = self.sm.file(s.span.file)
            let (l, _) = file.line_col(s.span.lo)
            self.cx.fb.line(l, file.path)
        match s.kind:
            case StmtKind.Let(_, pat, _, init, _):
                self.push_frame()
                self.cx.bits_init = len(s.locals) > 0 and s.locals[0] in self.cx.packed
                self.cx.narrow_init = len(s.locals) > 0 and s.locals[0] in self.cx.narrow
                let v = self.owned(init)
                match pat:
                    case LetPat.Name(_, _):
                        let id = s.locals[0]
                        let ty = self.flocals[id].ty
                        let p = self.new_local(id, ty)
                        self.st(p, 0, ty, v)
                        self.add_home(p, ty)
                    case LetPat.Tuple(_):
                        for i, id in enumerate(s.locals):
                            let ty = self.flocals[id].ty
                            let x = self.ld(v, self.field_off(init.ty, i), ty)
                            let p = self.new_local(id, ty)
                            self.st(p, 0, ty, x)
                            self.add_home(p, ty)
                self.pop_frame()
            case StmtKind.Assign(target, op, value):
                self.push_frame()
                self.assign(target, op, value, self.op_checked(op, target.ty, not s.proven), s.span)
                self.pop_frame()
            case StmtKind.ExprStmt(e):
                self.push_frame()
                self.expr(e)
                self.pop_frame()
            case StmtKind.If(branches, els):
                let end = self.cx.fb.label()
                for br_ in branches:
                    self.push_frame()
                    let c = self.expr(br_.0)
                    self.pop_frame()
                    let next = self.cx.fb.label()
                    self.cx.fb.brnot(c, next)
                    self.block(br_.1)
                    if not self.cx.fb.ends():
                        self.cx.fb.jmp(end)
                    self.cx.fb.place(next)
                match els:
                    case Some(eb):
                        self.block(eb)
                    case None:
                        pass
                self.cx.fb.place(end)
            case StmtKind.Match(scrut, cases):
                self.match_stmt(scrut, cases)
            case StmtKind.While(cond, _, body):
                if self.twin_while(s, cond, body):
                    return
                let iend = self.idiom_head(
                    ranges.key(s.span),
                    idiom.while_idiom(cond, body, self.flocals),
                    None
                )
                if iend == -2:
                    return
                let head = self.cx.fb.label()
                let brk = self.cx.fb.label()
                let saved = self.loop_arrays([cond], body)
                self.cx.fb.place(head)
                self.push_frame()
                let c = self.expr(cond)
                self.pop_frame()
                self.cx.fb.brnot(c, brk)
                self.cx.loops.push(Loop(depth=len(self.cx.scopes), brk=brk, cont=head))
                self.block(body)
                self.cx.loops.pop()
                if not self.cx.fb.ends():
                    self.cx.fb.jmp(head)
                self.cx.fb.place(brk)
                self.cx.arrc = saved
                if iend >= 0:
                    self.cx.fb.place(iend)
            case StmtKind.For(_, _, _, iter, _, body, is_par):
                var iend = -1
                if not is_par:
                    iend = self.idiom_head(
                        ranges.key(s.span),
                        idiom.for_idiom(iter, s.local, body, self.flocals),
                        Some(iter)
                    )
                if iend == -2:
                    pass
                elif is_par:
                    self.par_for(iter, s.local, s.caps, s.writes, body, s.span)
                elif self.opts.fast and not self.cx.lifted and self.version_for(s, iter, body):
                    pass
                elif self.opts.fast and not self.cx.lifted and self.jam_for(iter, s.local, body):
                    pass
                else:
                    self.push_scope()
                    self.push_frame()
                    let dom = self.domain(iter, true)
                    self.pop_frame()
                    let saved = self.loop_arrays([iter], body)
                    let lc = self.loop_open(dom, s.local)
                    self.cx.loops.push(Loop(depth=len(self.cx.scopes), brk=lc.brk, cont=lc.cont))
                    self.block(body)
                    self.cx.loops.pop()
                    self.loop_close(dom, lc)
                    self.cx.arrc = saved
                    self.pop_scope()
                if iend >= 0:
                    self.cx.fb.place(iend)
            case StmtKind.Return(value):
                match value:
                    case Some(e):
                        self.push_frame()
                        let v = self.owned(e)
                        var r = -1
                        if self.cx.sret >= 0:
                            let lay = self.lay(e.ty)
                            self.cx.fb.copy(self.cx.sret, v, lay.size)
                        elif self.cx.fb.f.has_ret:
                            r = v
                        self.pop_frame()
                        self.release_scopes_from(0)
                        self.cx.fb.ret(r)
                    case None:
                        self.release_scopes_from(0)
                        self.cx.fb.ret(-1)
            case StmtKind.Break:
                let l = self.cx.loops[len(self.cx.loops) - 1]
                self.release_scopes_from(l.depth)
                self.cx.fb.jmp(l.brk)
            case StmtKind.Continue:
                let l = self.cx.loops[len(self.cx.loops) - 1]
                self.release_scopes_from(l.depth)
                self.cx.fb.jmp(l.cont)
            case StmtKind.Assert(cond, msg):
                if s.proven:
                    return
                self.push_frame()
                let c = self.expr(cond)
                let ok = self.cx.fb.label()
                self.cx.fb.br(c, ok)
                self.push_frame()
                var m = -1
                match msg:
                    case Some(mx):
                        m = self.expr(mx)
                    case None:
                        m = self.cx.fb.konst(K.Ptr, 0)
                let loc = self.loc(s.span)
                let src = self.cstr(self.sm.snippet(cond.span))
                self.cx.fb.call_void("brine_assert_fail", [loc, src, m])
                self.cx.fb.unreachable()
                self.cx.frames.pop()
                self.cx.fb.place(ok)
                self.pop_frame()
            case _:
                pass

    # ============================================================ idioms
    # A loop idiom.br recognized: one runtime call that does it when all it
    # touches is in bounds, else (the code that follows) the loop as written.
    # Returns the label after the loop, -1 having emitted nothing, or -2 in
    # the first copy of a twin loop: there the loop isn't lowered, a failure
    # goes to the second copy.
    fn idiom_head(ref self, key: str, id: Option[idiom.Idiom], iter: Option[Expr]) -> int:
        if not self.opts.fast or self.cx.lifted or len(self.cx.jx.act) > 0:
            return -1
        if self.cx.twin == 2:
            self.twin_land(key)
            return -1
        match id:
            case Some(x):
                var ok = -1
                match x:
                    case idiom.Idiom.Rev(a, i, j):
                        # only worth it a register at a time
                        if not (a in self.cx.narrow):
                            return -1
                        let (d, n) = self.bytes_of(a)
                        let pi = self.local_ptr(i)
                        let pj = self.local_ptr(j)
                        ok = self.cx.fb.rt(K.Bool, "brine_bytes_rev", [d, n, pi, pj])
                    case idiom.Idiom.Shl(a):
                        if a in self.cx.packed or not self.plain_elems(a):
                            return -1
                        let (lo, hi) = self.idiom_bounds(iter.unwrap())
                        if a in self.cx.narrow:
                            let (d, n) = self.bytes_of(a)
                            ok = self.cx.fb.rt(K.Bool, "brine_bytes_shl", [d, n, lo, hi])
                        else:
                            let pa = self.local_ptr(a)
                            ok = self.cx.fb.rt(K.Bool, "brine_arr_shl", [pa, lo, hi])
                    case idiom.Idiom.Copy(b, a):
                        if a in self.cx.packed or b in self.cx.packed or not self.plain_elems(a):
                            return -1
                        if (a in self.cx.narrow) != (b in self.cx.narrow):
                            return -1
                        let (lo, hi) = self.idiom_bounds(iter.unwrap())
                        if a in self.cx.narrow:
                            let (db, nb) = self.bytes_of(b)
                            let (da, na) = self.bytes_of(a)
                            ok = self.cx.fb.rt(K.Bool, "brine_bytes_copy", [db, nb, da, na, lo, hi])
                        else:
                            let pb = self.local_ptr(b)
                            let av = self.read_local(a)
                            ok = self.cx.fb.rt(K.Bool, "brine_arr_copy", [pb, av, lo, hi])
                return self.idiom_fail(key, ok)
            case None:
                return -1

    # After an idiom's call: where to go when it returns false (see idiom_head)
    fn idiom_fail(ref self, key: str, ok: int) -> int:
        if self.cx.twin == 1:
            let l = self.cx.fb.label()
            self.cx.fb.brnot(ok, l)
            self.cx.twin_out[key] = l
            return -2
        let slow = self.cx.fb.label()
        let end = self.cx.fb.label()
        self.cx.fb.brnot(ok, slow)
        self.cx.fb.jmp(end)
        self.cx.fb.place(slow)
        return end

    # In the second copy of a twin loop: where the first's idiom `key` fails over to
    fn twin_land(ref self, key: str):
        match self.cx.twin_out.get(key):
            case Some(l):
                self.cx.fb.place(l)
                for sp in self.cx.twin_ptrs:
                    let a = self.cx.fb.slot_addr(sp.0)
                    self.cx.fb.mov(sp.1, a)
            case None:
                pass

    fn plain_elems(self, a: int) -> bool:
        match self.flocals[a].ty:
            case Ty.Array(t):
                return not self.managed(t)
            case _:
                return false

    # `let x = a[lo]` was stmts[k]: when it and the next two statements rotate
    # a part of `a` (idiom.rot_idiom), the rotation in one call, else the
    # statements as written. Returns whether it lowered stmts[k + 1..k + 3].
    fn rot_after(ref self, stmts: [Stmt], k: int) -> bool:
        if not self.opts.fast or self.cx.lifted or len(self.cx.jx.act) > 0 or self.cx.fb.ends():
            return false
        let a = idiom.rot_idiom(stmts, k, self.flocals)
        if a < 0 or a in self.cx.packed or not self.plain_elems(a):
            return false
        let key = ranges.key(stmts[k + 1].span) + "r"
        if self.cx.twin == 2:
            self.twin_land(key)
            return false
        var lo = -1
        var hi = -1
        match stmts[k + 1].kind:
            case StmtKind.For(_, _, _, it, _, _, _):
                let (l, h) = self.idiom_bounds(it)
                lo = l
                hi = h
            case _:
                return false
        var ok = -1
        if a in self.cx.narrow:
            let (d, n) = self.bytes_of(a)
            ok = self.cx.fb.rt(K.Bool, "brine_bytes_rotl", [d, n, lo, hi])
        else:
            let pa = self.local_ptr(a)
            ok = self.cx.fb.rt(K.Bool, "brine_arr_rotl", [pa, lo, hi])
        let end = self.idiom_fail(key, ok)
        if end >= 0:
            self.stmt(stmts[k + 1])
            self.stmt(stmts[k + 2])
            self.cx.fb.place(end)
        return true

    # A loop idiom.twin_body allows, in two copies. Returns false having
    # emitted nothing when it doesn't qualify.
    fn twin_while(ref self, s: Stmt, cond: Expr, body: Block) -> bool:
        if not self.opts.fast or self.opts.debug or self.cx.lifted or len(
            self.cx.jx.act
        ) > 0 or self.cx.twin != 0:
            return false
        if not idiom.twin_body(body, self.flocals):
            return false
        # the arrays both copies use, cached before either
        let saved = self.loop_arrays([cond], body)
        self.cx.twin = 1
        self.cx.twin_out = {}
        self.cx.twin_slots = {}
        self.cx.twin_ptrs = []
        self.stmt(s)
        let end = self.cx.fb.label()
        if not self.cx.fb.ends():
            self.cx.fb.jmp(end)
        self.cx.twin = 2
        if len(self.cx.twin_out) > 0:
            self.stmt(s)
        self.cx.twin = 0
        self.cx.twin_out = {}
        self.cx.twin_slots = {}
        self.cx.twin_ptrs = []
        self.cx.fb.place(end)
        self.cx.arrc = saved
        return true

    # The data and length of byte array `a` (never shared, so writable).
    fn bytes_of(ref self, a: int) -> (int, int):
        match self.cx.arrc.get(a):
            case Some(c):
                return (c.data, c.len)
            case None:
                let v = self.read_local(a)
                let n = self.cx.fb.load(K.I64, v, 8)
                let d = self.cx.fb.load(K.Ptr, v, 48)
                return (d, n)

    fn idiom_bounds(ref self, iter: Expr) -> (int, int):
        match iter.kind:
            case ExprKind.Range(lo, hi, _):
                let l = self.expr(lo)
                let h = self.expr(hi)
                return (l, h)
            case _:
                return (-1, -1)

    # ============================================================ range versioning
    # A loop ranges.br found free of overflow while its inputs are within a
    # bound: test them once, then run a copy without overflow checks, or the
    # loop as written. Returns false, having emitted nothing, when it doesn't
    # qualify.
    fn version_for(ref self, s: Stmt, iter: Expr, body: Block) -> bool:
        if self.cx.nc or self.cx.nv or len(self.cx.jx.act) > 0:
            return false
        match ranges.plan(iter, s.local, body, self.flocals, self.info, self.fdecls):
            case Some(v):
                let slow = self.cx.fb.label()
                let end = self.cx.fb.label()
                let t = int(v.bound)
                for p in v.params:
                    match self.flocals[p].ty:
                        case Ty.Int(k):
                            let kk = int_kind(k)
                            let x = self.read_local(p)
                            if v.bound < k.max():
                                let hi = self.cx.fb.konst(kk, t)
                                let ok = self.cx.fb.cmp(Op.Le, x, hi)
                                self.cx.fb.brnot(ok, slow)
                            if k.signed() and -v.bound > k.min():
                                let lo = self.cx.fb.konst(kk, -t)
                                let ok = self.cx.fb.cmp(Op.Ge, x, lo)
                                self.cx.fb.brnot(ok, slow)
                        case _:
                            pass
                for ck in v.calls:
                    let id = v.calls[ck]
                    if not (id in self.cloned):
                        self.cloned[id] = true
                        self.clones.push(id)
                self.cx.nc = true
                self.cx.nc_calls = v.calls
                self.stmt(s)
                self.cx.nc = false
                self.cx.nc_calls = {}
                if not self.cx.fb.ends():
                    self.cx.fb.jmp(end)
                self.cx.fb.place(slow)
                self.cx.nv = true
                self.stmt(s)
                self.cx.nv = false
                self.cx.fb.place(end)
                return true
            case None:
                return false

    # Is `op` on a `ty` checked, `checked` being what the source asks for? A
    # range-versioned copy drops the checks ranges.br showed can't fail.
    fn op_checked(self, op: Option[BinOp], ty: Ty, checked: bool) -> bool:
        if not checked or not self.cx.nc or ranges.handled(ty).is_none():
            return checked
        match op:
            case Some(o):
                match o:
                    case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.Div | BinOp.Mod:
                        return false
                    case _:
                        return true
            case None:
                return checked

    # ============================================================ interleaving
    # `for x in lo..hi:` whose iterations jam.br found independent: LANES
    # iterations at a time while that many are left, so the CPU overlaps
    # their long dependency chains, then the rest one by one. Returns false,
    # having emitted nothing, when the loop doesn't qualify.
    fn jam_for(ref self, iter: Expr, var_id: int, body: Block) -> bool:
        var p = jam.Plan(locals=[], reds=[])
        match jam.plan(iter, var_id, body, self.flocals):
            case Some(x):
                p = x
            case None:
                return false
        let n = jam.LANES
        self.push_scope()
        self.push_frame()
        let dom = self.domain(iter, true)
        self.pop_frame()
        let saved = self.loop_arrays([iter], body)
        var kt = IntTy.I64
        var lo = -1
        var hi = -1
        match dom:
            case Dom.Range(t, l, h, _, _):
                kt = t
                lo = l
                hi = h
            case _:
                pass
        let kk = int_kind(kt)
        let head = self.cx.fb.label()
        let rest = self.cx.fb.label()
        let x = self.cx.fb.copy_of(lo)
        var jx = no_jam()
        var ids = [var_id]
        ids.extend(p.locals)
        for id in ids:
            let t = self.flocals[id].ty
            let lay = self.lay(t)
            var ss: [int] = []
            for _ in 0..n:
                let sl = self.cx.fb.slot(lay.size, lay.align)
                self.cx.fb.name_slot(sl, self.flocals[id].name, true, self.kind(t))
                ss.push(sl)
            jx.slots[id] = ss
        for r in p.reds:
            let rk = self.kind(self.flocals[r].ty)
            var hs: [int] = []
            var vs: [int] = []
            for _ in 0..n:
                hs.push(self.cx.fb.vreg(K.Bool))
                vs.push(self.cx.fb.vreg(rk))
            jx.has[r] = hs
            jx.val[r] = vs
        for _ in 0..n:
            jx.act.push(self.cx.fb.vreg(K.Bool))
        self.cx.fb.place(head)
        # a whole group is left: x < hi and hi - x >= n (in u64: no overflow)
        let more = self.cx.fb.cmp(Op.Lt, x, hi)
        self.cx.fb.brnot(more, rest)
        let hu = self.cx.fb.conv(K.U64, hi)
        let xu = self.cx.fb.conv(K.U64, x)
        let left = self.cx.fb.bin(Op.Sub, K.U64, hu, xu)
        let nk = self.cx.fb.konst(K.U64, n)
        let enough = self.cx.fb.cmp(Op.Ge, left, nk)
        self.cx.fb.brnot(enough, rest)
        let yes = self.cx.fb.konst(K.Bool, 1)
        let no = self.cx.fb.konst(K.Bool, 0)
        for l in 0..n:
            let lk = self.cx.fb.konst(kk, l)
            let xl = self.cx.fb.bin(Op.Add, kk, x, lk)
            let xp = self.cx.fb.slot_addr(jx.slots[var_id][l])
            self.cx.fb.store(xp, 0, xl)
            self.cx.fb.mov(jx.act[l], yes)
            for r in p.reds:
                self.cx.fb.mov(jx.has[r][l], no)
        self.cx.jx = jx
        self.jam_block(body)
        self.cx.jx = no_jam()
        # the reductions, in the order of the iterations
        for l in 0..n:
            for r in p.reds:
                let skip = self.cx.fb.label()
                self.cx.fb.brnot(jx.has[r][l], skip)
                self.jam_reduce(body, r, jx.val[r][l])
                self.cx.fb.place(skip)
        let step = self.cx.fb.konst(kk, n)
        let x2 = self.cx.fb.bin(Op.Add, kk, x, step)
        self.cx.fb.mov(x, x2)
        self.cx.fb.jmp(head)
        self.cx.fb.place(rest)
        # the rest, one at a time
        let dom2 = Dom.Range(kt, x, hi, false, -1)
        let lc = self.loop_open(dom2, var_id)
        self.cx.loops.push(Loop(depth=len(self.cx.scopes), brk=lc.brk, cont=lc.cont))
        self.block(body)
        self.cx.loops.pop()
        self.loop_close(dom2, lc)
        self.cx.arrc = saved
        self.pop_scope()
        return true

    # Adds a lane's part `v` into reduction `r`, as its statement in `b`
    # would have (checked unless proven).
    fn jam_reduce(ref self, b: Block, r: int, v: int):
        for s in b.stmts:
            match s.kind:
                case StmtKind.Assign(t, op, _):
                    if jam.local_id(t) == r:
                        let ty = self.flocals[r].ty
                        let lp = self.local_ptr(r)
                        let cur = self.ld(lp, 0, ty)
                        let o = op.unwrap_or(BinOp.Add)
                        let c = self.arith(
                            o,
                            cur,
                            v,
                            ty,
                            self.op_checked(Some(o), ty, not s.proven),
                            s.span
                        )
                        self.st(lp, 0, ty, c)
                        return
                case _:
                    pass
            for blk in jam.nested_blocks(s):
                self.jam_reduce(blk, r, v)

    # Points the body's variables at lane `l`'s copies.
    fn lane(ref self, l: int):
        for id in self.cx.jx.slots:
            self.cx.lslot[id] = self.cx.jx.slots[id][l]

    # The value of `e` in lane `l`. When `e` can fault on values its own
    # iteration never has, only computed if `guard` (the lane runs it).
    fn jam_expr(ref self, e: Expr, l: int, guard: int) -> int:
        self.lane(l)
        if not jam.traps(e):
            self.push_frame()
            let v = self.expr(e)
            self.pop_frame()
            return v
        let k = self.kind(e.ty)
        let t = self.cx.fb.vreg(k)
        let z = self.zero_of(k, 0)
        self.cx.fb.mov(t, z)
        let skip = self.cx.fb.label()
        self.cx.fb.brnot(guard, skip)
        self.push_frame()
        let v = self.expr(e)
        self.pop_frame()
        self.cx.fb.mov(t, v)
        self.cx.fb.place(skip)
        return t

    fn jam_ptr(ref self, id: int, l: int) -> int:
        return self.cx.fb.slot_addr(self.cx.jx.slots[id][l])

    fn jam_any(ref self, m: [int]) -> int:
        var a = m[0]
        for i in 1..len(m):
            a = self.cx.fb.bin(Op.Or, K.Bool, a, m[i])
        return a

    fn jam_copy(ref self, m: [int]) -> [int]:
        var out: [int] = []
        for v in m:
            out.push(self.cx.fb.copy_of(v))
        return out

    fn jam_set(ref self, d: [int], m: [int]):
        for i in 0..len(d):
            self.cx.fb.mov(d[i], m[i])

    # After an `if`: the lanes that ran before it run on, except those that
    # left the inner loop or continued it.
    fn jam_restore(ref self, before: [int], brk: bool, cont: bool):
        let k = len(self.cx.jx.alive)
        for l in 0..len(before):
            var a = before[l]
            if brk:
                a = self.cx.fb.bin(Op.And, K.Bool, a, self.cx.jx.alive[k - 1][l])
            if cont:
                let nc = self.cx.fb.un(Op.Not, K.Bool, self.cx.jx.cont[k - 1][l])
                a = self.cx.fb.bin(Op.And, K.Bool, a, nc)
            self.cx.fb.mov(self.cx.jx.act[l], a)

    fn jam_block(ref self, b: Block):
        for s in b.stmts:
            self.jam_stmt(s)

    # The head of an inner loop, once `alive` has the lanes still looping:
    # leaves when none is, else runs those.
    fn jam_loop_head(ref self, alive: [int], cont: [int], out: int):
        let any = self.jam_any(alive)
        self.cx.fb.brnot(any, out)
        self.jam_set(self.cx.jx.act, alive)
        self.cx.jx.alive.push(alive)
        self.cx.jx.cont.push(cont)

    fn jam_loop_end(ref self):
        self.cx.jx.alive.pop()
        self.cx.jx.cont.pop()

    fn jam_stmt(ref self, s: Stmt):
        let n = len(self.cx.jx.act)
        match s.kind:
            case StmtKind.Let(_, _, _, init, _):
                let id = s.locals[0]
                let ty = self.flocals[id].ty
                for l in 0..n:
                    let v = self.jam_expr(init, l, self.cx.jx.act[l])
                    let ptr = self.jam_ptr(id, l)
                    self.st(ptr, 0, ty, v)
            case StmtKind.Assign(target, op, value):
                let id = jam.local_id(target)
                let ty = self.flocals[id].ty
                let red = id in self.cx.jx.has
                for l in 0..n:
                    let act = self.cx.jx.act[l]
                    let v = self.jam_expr(value, l, act)
                    let skip = self.cx.fb.label()
                    self.cx.fb.brnot(act, skip)
                    if red:
                        let one = self.cx.fb.konst(K.Bool, 1)
                        self.cx.fb.mov(self.cx.jx.has[id][l], one)
                        self.cx.fb.mov(self.cx.jx.val[id][l], v)
                    else:
                        let ptr = self.jam_ptr(id, l)
                        var nv = v
                        match op:
                            case Some(o):
                                # jam.br only allows proven (or float) ones
                                let cur = self.ld(ptr, 0, ty)
                                nv = self.arith(o, cur, v, ty, false, s.span)
                            case None:
                                pass
                        self.st(ptr, 0, ty, nv)
                    self.cx.fb.place(skip)
            case StmtKind.If(branches, els):
                let before = self.jam_copy(self.cx.jx.act)
                let rem = self.jam_copy(self.cx.jx.act)
                for br_ in branches:
                    var run: [int] = []
                    for l in 0..n:
                        let c = self.jam_expr(br_.0, l, rem[l])
                        let t = self.cx.fb.bin(Op.And, K.Bool, rem[l], c)
                        let nc = self.cx.fb.un(Op.Not, K.Bool, c)
                        let r2 = self.cx.fb.bin(Op.And, K.Bool, rem[l], nc)
                        self.cx.fb.mov(rem[l], r2)
                        run.push(t)
                    let skip = self.cx.fb.label()
                    if not jam.flat(br_.1):
                        let any = self.jam_any(run)
                        self.cx.fb.brnot(any, skip)
                    self.jam_set(self.cx.jx.act, run)
                    self.jam_block(br_.1)
                    self.cx.fb.place(skip)
                match els:
                    case Some(eb):
                        let skip = self.cx.fb.label()
                        if not jam.flat(eb):
                            let any = self.jam_any(rem)
                            self.cx.fb.brnot(any, skip)
                        self.jam_set(self.cx.jx.act, rem)
                        self.jam_block(eb)
                        self.cx.fb.place(skip)
                    case None:
                        pass
                var brk = false
                var cnt = false
                for nb in jam.nested_blocks(s):
                    brk = brk or jam.exits(nb, false)
                    cnt = cnt or jam.exits(nb, true)
                self.jam_restore(before, brk, cnt)
            case StmtKind.While(cond, _, body):
                let before = self.jam_copy(self.cx.jx.act)
                let alive = self.jam_copy(self.cx.jx.act)
                var cont: [int] = []
                if jam.exits(body, true):
                    for _ in 0..n:
                        cont.push(self.cx.fb.vreg(K.Bool))
                let top = self.cx.fb.label()
                let out = self.cx.fb.label()
                self.cx.fb.place(top)
                for l in 0..n:
                    if len(cont) > 0:
                        let f0 = self.cx.fb.konst(K.Bool, 0)
                        self.cx.fb.mov(cont[l], f0)
                    let c = self.jam_expr(cond, l, alive[l])
                    let a2 = self.cx.fb.bin(Op.And, K.Bool, alive[l], c)
                    self.cx.fb.mov(alive[l], a2)
                self.jam_loop_head(alive, cont, out)
                self.jam_block(body)
                self.jam_loop_end()
                self.cx.fb.jmp(top)
                self.cx.fb.place(out)
                self.jam_set(self.cx.jx.act, before)
            case StmtKind.For(_, _, _, iter, _, body, _):
                var lo_e = iter
                var hi_e = iter
                match iter.kind:
                    case ExprKind.Range(a, b, _):
                        lo_e = a
                        hi_e = b
                    case _:
                        pass
                let id = s.local
                let ty = self.flocals[id].ty
                let kk = self.kind(ty)
                let before = self.jam_copy(self.cx.jx.act)
                var his: [int] = []
                for l in 0..n:
                    let a = self.jam_expr(lo_e, l, before[l])
                    let b = self.jam_expr(hi_e, l, before[l])
                    let ptr = self.jam_ptr(id, l)
                    self.st(ptr, 0, ty, a)
                    his.push(self.cx.fb.copy_of(b))
                let alive = self.jam_copy(self.cx.jx.act)
                var cont: [int] = []
                if jam.exits(body, true):
                    for _ in 0..n:
                        cont.push(self.cx.fb.vreg(K.Bool))
                let top = self.cx.fb.label()
                let out = self.cx.fb.label()
                self.cx.fb.place(top)
                for l in 0..n:
                    if len(cont) > 0:
                        let f0 = self.cx.fb.konst(K.Bool, 0)
                        self.cx.fb.mov(cont[l], f0)
                    let ptr = self.jam_ptr(id, l)
                    let k = self.ld(ptr, 0, ty)
                    let c = self.cx.fb.cmp(Op.Lt, k, his[l])
                    let a2 = self.cx.fb.bin(Op.And, K.Bool, alive[l], c)
                    self.cx.fb.mov(alive[l], a2)
                self.jam_loop_head(alive, cont, out)
                self.jam_block(body)
                self.jam_loop_end()
                # step the lanes still looping (k < hi, so k + 1 can't overflow)
                for l in 0..n:
                    let skip = self.cx.fb.label()
                    self.cx.fb.brnot(alive[l], skip)
                    let ptr = self.jam_ptr(id, l)
                    let k = self.ld(ptr, 0, ty)
                    let one = self.cx.fb.konst(kk, 1)
                    let k2 = self.cx.fb.bin(Op.Add, kk, k, one)
                    self.st(ptr, 0, ty, k2)
                    self.cx.fb.place(skip)
                self.cx.fb.jmp(top)
                self.cx.fb.place(out)
                self.jam_set(self.cx.jx.act, before)
            case StmtKind.Break:
                let k = len(self.cx.jx.alive) - 1
                for l in 0..n:
                    let na = self.cx.fb.un(Op.Not, K.Bool, self.cx.jx.act[l])
                    let a = self.cx.jx.alive[k][l]
                    let a2 = self.cx.fb.bin(Op.And, K.Bool, a, na)
                    self.cx.fb.mov(a, a2)
                    let f0 = self.cx.fb.konst(K.Bool, 0)
                    self.cx.fb.mov(self.cx.jx.act[l], f0)
            case StmtKind.Continue:
                let k = len(self.cx.jx.cont) - 1
                for l in 0..n:
                    let c = self.cx.jx.cont[k][l]
                    let c2 = self.cx.fb.bin(Op.Or, K.Bool, c, self.cx.jx.act[l])
                    self.cx.fb.mov(c, c2)
                    let f0 = self.cx.fb.konst(K.Bool, 0)
                    self.cx.fb.mov(self.cx.jx.act[l], f0)
            case _:
                # pass, prove, contracts and proven asserts do nothing here
                pass

    # Before a loop: the local arrays it only indexes (and measures) can't be
    # shared, grown or replaced inside it, so their pointer, data and length are
    # loaded once, and those it writes are made unique once. Returns the old set.
    fn loop_arrays(ref self, head: [Expr], body: Block) -> {int: ArrCache}:
        let saved = self.cx.arrc
        var u = IndexUse(info=self.info, seen={}, written={}, bad={}, decl={})
        for e in head:
            u.expr(e)
        u.block(body)
        for l in u.seen:
            if l in u.bad or l in u.decl or l in self.cx.par_writes or l in self.cx.arrc:
                continue
            if not (l in self.cx.lslot or l in self.cx.lptr):
                continue
            let info = self.flocals[l]
            if l in u.written:
                # only a variable the function may change can be made unique
                match info.kind:
                    case LocalKind.Var | LocalKind.RefParam:
                        pass
                    case _:
                        continue
            match info.ty:
                case Ty.Array(_):
                    let p = self.local_ptr(l)
                    if l in u.written:
                        self.cx.fb.call_void("brine_arr_unique", [p])
                    let a = self.cx.fb.load(K.Ptr, p, 0)
                    let n = self.cx.fb.load(K.I64, a, 8)
                    let d = self.cx.fb.load(K.Ptr, a, 48)
                    self.cx.arrc[l] = ArrCache(arr=a, data=d, len=n)
                case _:
                    pass
        return saved

    # The local array `e` names, when an enclosing loop cached it.
    fn cached_arr(self, e: Expr) -> Option[ArrCache]:
        match local_of(e):
            case Some(l):
                return self.cx.arrc.get(l)
            case None:
                return None

    # The type an array's elements are stored as: bytes for narrow.br's
    # arrays (the program sees `t`).
    fn elem_ty(self, base: Expr, t: Ty) -> Ty:
        if len(self.cx.narrow) == 0:
            return t
        match local_of(base):
            case Some(l):
                if l in self.cx.narrow:
                    return Ty.Int(IntTy.U8)
                return t
            case None:
                return t

    fn is_bits(self, e: Expr) -> bool:
        match local_of(e):
            case Some(l):
                return l in self.cx.packed
            case None:
                return false

    # Element `idx` of bit array `base`: the address of its 64-bit word and
    # its place in the word.
    fn bit_at(ref self, base: Expr, idx: Expr, checked: bool, span: Span) -> (int, int):
        var data = -1
        var n = -1
        match self.cached_arr(base):
            case Some(c):
                data = c.data
                n = c.len
            case None:
                let a = self.expr(base)
                n = self.cx.fb.load(K.I64, a, 8)
                data = self.cx.fb.load(K.Ptr, a, 48)
        let i0 = self.expr(idx)
        var ix = self.cx.fb.conv(K.I64, i0)
        if checked:
            let loc = self.loc(span)
            ix = self.cx.fb.chk(Op.IdxChk, K.I64, ix, n, loc)
        let six = self.cx.fb.konst(K.I64, 6)
        let wi = self.cx.fb.bin(Op.Shr, K.I64, ix, six)
        let p = self.cx.fb.elem(data, wi, 8)
        let m63 = self.cx.fb.konst(K.I64, 63)
        let sh = self.cx.fb.bin(Op.And, K.I64, ix, m63)
        return (p, sh)

    # The address of element `i` of a cached array.
    fn cached_elem_ptr(ref self, c: ArrCache, i: int, et: Ty, checked: bool, span: Span) -> int:
        var ix = self.cx.fb.conv(K.I64, i)
        if checked:
            let loc = self.loc(span)
            ix = self.cx.fb.chk(Op.IdxChk, K.I64, ix, c.len, loc)
        return self.cx.fb.elem(c.data, ix, self.lay(et).size)

    # U8: the byte `v` appends to a string when it is `t[i]` or a one-byte
    # literal (`s += t[i]` then appends a byte), or -1. Index checks as in
    # brine_str_at.
    fn str_byte(ref self, v: Expr) -> int:
        match v.kind:
            case ExprKind.Str(s):
                if len(s) == 1:
                    return self.cx.fb.konst(K.U8, int(s.bytes()[0]))
            case ExprKind.Index(base, idx):
                if base.ty == Ty.Str:
                    let b = self.expr(base)
                    let i0 = self.expr(idx)
                    var i = self.cx.fb.conv(K.I64, i0)
                    if v.checked:
                        let n = self.cx.fb.load(K.I64, b, 8)
                        let loc = self.loc(v.span)
                        i = self.cx.fb.chk(Op.IdxChk, K.I64, i, n, loc)
                    let p = self.cx.fb.elem(b, i, 1)
                    return self.cx.fb.load(K.U8, p, 16)
            case _:
                pass
        return -1

    fn assign(ref self, target: Expr, op: Option[BinOp], value: Expr, checked: bool, span: Span):
        let ty = target.ty
        match target.kind:
            case ExprKind.Index(b0, i0):
                if self.is_bits(b0):
                    # pack.br only keeps arrays whose elements are set with `=`
                    let v = self.expr(value)
                    let (p, sh) = self.bit_at(b0, i0, target.checked, target.span)
                    let w = self.cx.fb.load(K.U64, p, 0)
                    let one = self.cx.fb.konst(K.U64, 1)
                    let m = self.cx.fb.bin(Op.Shl, K.U64, one, sh)
                    let nm = self.cx.fb.un(Op.Not, K.U64, m)
                    let keep = self.cx.fb.bin(Op.And, K.U64, w, nm)
                    let vb = self.cx.fb.conv(K.U64, v)
                    let set = self.cx.fb.bin(Op.Shl, K.U64, vb, sh)
                    let w2 = self.cx.fb.bin(Op.Or, K.U64, keep, set)
                    self.cx.fb.store(p, 0, w2)
                    return
                if self.elem_ty(b0, ty) != ty:
                    # narrow.br only keeps arrays set with `=`, to small values
                    let v = self.expr(value)
                    let vb = self.cx.fb.conv(K.U8, v)
                    let lp = self.lvalue(target)
                    self.cx.fb.store(lp, 0, vb)
                    return
                match b0.ty:
                    case Ty.Map(_, _):
                        if op.is_none():
                            # `m[k] = v` inserts
                            let vks = self.owned_all([value, i0])
                            let vs = self.addr_of(vks[0], ty)
                            let ks = self.addr_of(vks[1], i0.ty)
                            let b = self.lvalue(b0)
                            self.cx.fb.call_void("brine_map_set", [b, ks, vs])
                            return
                    case _:
                        pass
            case _:
                pass
        match op:
            case None:
                let v = self.owned(value)
                let lp = self.lvalue(target)
                if not self.managed(ty):
                    self.st(lp, 0, ty, v)
                elif self.agg(ty):
                    let lay = self.lay(ty)
                    let old = self.cx.fb.temp_mem(lay.size, lay.align)
                    self.cx.fb.copy(old, lp, lay.size)
                    self.cx.fb.copy(lp, v, lay.size)
                    self.release(old, ty)
                else:
                    let old = self.cx.fb.load(self.kind(ty), lp, 0)
                    self.cx.fb.store(lp, 0, v)
                    self.release(old, ty)
            case Some(o2):
                if ty == Ty.Str:
                    let c = self.str_byte(value)
                    if c >= 0:
                        let lp = self.lvalue(target)
                        self.cx.fb.rt_void("brine_str_add_byte", [lp, c])
                        return
                let v = self.expr(value)
                let lp = self.lvalue(target)
                if ty == Ty.Str:
                    self.cx.fb.rt_void("brine_str_add", [lp, v])
                else:
                    let cur = self.cx.fb.load(self.kind(ty), lp, 0)
                    let c = self.arith(o2, cur, v, ty, checked, span)
                    self.cx.fb.store(lp, 0, c)

    # ------------------------------------------------------------ match
    fn match_stmt(ref self, scrut: Expr, cases: [Case]):
        let ty = scrut.ty
        self.push_scope()
        self.push_frame()
        var v = -1
        if self.fixed_local(scrut):
            # the variable keeps the value alive for the whole match: borrow it
            v = self.expr(scrut)
            self.pop_frame()
        else:
            v = self.owned(scrut)
            self.pop_frame()
            self.add_owned(v, ty)
        let end = self.cx.fb.label()
        for c in cases:
            let next = self.cx.fb.label()
            self.pat_test(c.pat, v, ty, next)
            self.pat_bind(c.pat, v, ty)
            match c.guard:
                case Some(g):
                    self.push_frame()
                    let gv = self.expr(g)
                    self.pop_frame()
                    self.cx.fb.brnot(gv, next)
                case None:
                    pass
            self.block(c.body)
            if not self.cx.fb.ends():
                self.cx.fb.jmp(end)
            self.cx.fb.place(next)
        self.cx.fb.unreachable()
        self.cx.fb.place(end)
        self.pop_scope()

    # A `let` variable or a by-value parameter: nothing can change it while
    # it is in scope.
    fn fixed_local(self, e: Expr) -> bool:
        match local_of(e):
            case Some(l):
                match self.flocals[l].kind:
                    case LocalKind.Let | LocalKind.Param:
                        return true
                    case _:
                        return false
            case None:
                return false

    # Does `p` match everything without binding anything?
    fn pat_trivial(self, p: Pattern) -> bool:
        match p.kind:
            case PatKind.Wild:
                return true
            case PatKind.Tuple(ps):
                return all(self.pat_trivial(q) for q in ps)
            case _:
                return false

    # Does `p` bind a name?
    fn pat_binds(self, p: Pattern) -> bool:
        match p.kind:
            case PatKind.Bind(_):
                return true
            case PatKind.Tuple(ps):
                return any(self.pat_binds(q) for q in ps)
            case PatKind.Variant(_, _):
                return any(self.pat_binds(q) for q in p.fields)
            case _:
                return false

    # Jump to `fail` unless the value `v` (of type `ty`) matches `p`.
    fn pat_test(ref self, p: Pattern, v: int, ty: Ty, fail: int):
        match p.kind:
            case PatKind.Wild | PatKind.Bind(_):
                pass
            case PatKind.Int(n):
                let l = self.int_lit(n, ty)
                let c = self.cx.fb.cmp(Op.Eq, v, l)
                self.cx.fb.brnot(c, fail)
            case PatKind.Str(s):
                let l = self.str_lit(s)
                let c = self.cx.fb.rt(K.Bool, "brine_str_eq", [v, l])
                self.cx.fb.brnot(c, fail)
            case PatKind.Bool(b):
                if b:
                    self.cx.fb.brnot(v, fail)
                else:
                    self.cx.fb.br(v, fail)
            case PatKind.Or(alts):
                let ok = self.cx.fb.label()
                for i, a in enumerate(alts):
                    if i + 1 == len(alts):
                        self.pat_test(a, v, ty, fail)
                    else:
                        let next = self.cx.fb.label()
                        self.pat_test(a, v, ty, next)
                        self.cx.fb.jmp(ok)
                        self.cx.fb.place(next)
                self.cx.fb.place(ok)
            case PatKind.Tuple(ps):
                match ty:
                    case Ty.Tuple(ts):
                        for i, q in enumerate(ps):
                            if not self.pat_trivial(q):
                                let x = self.ld(v, self.field_off(ty, i), ts[i])
                                self.pat_test(q, x, ts[i], fail)
                    case _:
                        pass
            case PatKind.Variant(_, _):
                match p.vres:
                    case Some((eid, vi)):
                        if not self.boxed(ty):
                            let k = self.cx.fb.konst(K.I32, vi)
                            let c = self.cx.fb.cmp(Op.Eq, v, k)
                            self.cx.fb.brnot(c, fail)
                            return
                        let fts = self.info.enums[eid].variants[vi].fields
                        let tag = self.cx.fb.load(K.I64, v, 8)
                        let k = self.cx.fb.konst(K.I64, vi)
                        let c = self.cx.fb.cmp(Op.Eq, tag, k)
                        self.cx.fb.brnot(c, fail)
                        for i in 0..min(len(p.fields), len(fts)):
                            if not self.pat_trivial(p.fields[i]):
                                let x = self.ld(v, self.vfield_off(eid, vi, i), fts[i].1)
                                self.pat_test(p.fields[i], x, fts[i].1, fail)
                    case None:
                        self.cx.fb.jmp(fail)

    # Declare the names bound by `p`. They borrow from the matched value,
    # which the `match` keeps alive.
    fn pat_bind(ref self, p: Pattern, v: int, ty: Ty):
        match p.kind:
            case PatKind.Bind(_):
                let home = self.new_local(p.local, ty)
                self.st(home, 0, ty, v)
            case PatKind.Tuple(ps):
                match ty:
                    case Ty.Tuple(ts):
                        for i, q in enumerate(ps):
                            if self.pat_binds(q):
                                let x = self.ld(v, self.field_off(ty, i), ts[i])
                                self.pat_bind(q, x, ts[i])
                    case _:
                        pass
            case PatKind.Variant(_, _):
                match p.vres:
                    case Some((eid, vi)):
                        let fts = self.info.enums[eid].variants[vi].fields
                        for i in 0..min(len(p.fields), len(fts)):
                            if self.pat_binds(p.fields[i]):
                                let x = self.ld(v, self.vfield_off(eid, vi, i), fts[i].1)
                                self.pat_bind(p.fields[i], x, fts[i].1)
                    case None:
                        pass
            case _:
                pass

    # A pointer to the place `e` names.
    fn lvalue(ref self, e: Expr) -> int:
        match e.kind:
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        return self.local_ptr(id)
                    case _:
                        pass
            case ExprKind.Field(base, _, _):
                let b = self.lvalue(base)
                return self.cx.fb.offset(b, self.field_off(base.ty, e.idx))
            case ExprKind.Index(base, idx):
                match base.ty:
                    case Ty.Map(_, _):
                        let k = self.expr(idx)
                        let kp = self.addr_of(k, idx.ty)
                        let b = self.lvalue(base)
                        let loc = self.loc(e.span)
                        let m = self.cx.fb.load(K.Ptr, b, 0)
                        let mf = self.map_find(base.ty)
                        let en = self.cx.fb.call(K.I64, mf, [m, kp])
                        let vsz = self.cx.fb.konst(K.I64, self.lay(e.ty).size)
                        return self.cx.fb.rt(K.Ptr, "brine_map_val_mut", [b, en, kp, vsz, loc])
                    case _:
                        pass
                let i = self.expr(idx)
                let et = self.elem_ty(base, e.ty)
                match self.cached_arr(base):
                    case Some(c):
                        return self.cached_elem_ptr(c, i, et, e.checked, e.span)
                    case None:
                        pass
                let b = self.lvalue(base)
                var skip = false
                match base.kind:
                    case ExprKind.Ident(_):
                        match base.res:
                            case Res.Local(l):
                                skip = l in self.cx.par_writes
                            case _:
                                pass
                    case _:
                        pass
                if not skip:
                    self.cx.fb.call_void("brine_arr_unique", [b])
                let a = self.cx.fb.load(K.Ptr, b, 0)
                return self.arr_elem_ptr(a, i, et, e.checked, e.span)
            case _:
                pass
        let v = self.expr(e)
        return self.addr_of(v, e.ty)

    # The address of element `i` of array `a` (bounds-checked when `checked`).
    fn arr_elem_ptr(ref self, a: int, i: int, et: Ty, checked: bool, span: Span) -> int:
        var ix = self.cx.fb.conv(K.I64, i)
        if checked:
            let n = self.cx.fb.load(K.I64, a, 8)
            let loc = self.loc(span)
            ix = self.cx.fb.chk(Op.IdxChk, K.I64, ix, n, loc)
        let data = self.cx.fb.load(K.Ptr, a, 48)
        return self.cx.fb.elem(data, ix, self.lay(et).size)

    # ============================================================ expressions
    fn expr(ref self, e: Expr) -> int:
        match e.kind:
            case ExprKind.Int(v):
                return self.int_lit(v, e.ty)
            case ExprKind.UInt(v):
                return self.cx.fb.konst128(K.U128, u128_bits(v))
            case ExprKind.Float(v):
                return self.float_lit(v, e.ty)
            case ExprKind.Bool(b):
                return self.cx.fb.konst(K.Bool, 1 if b else 0)
            case ExprKind.Str(s):
                return self.str_lit(s)
            case ExprKind.FStr(segs):
                let sb = self.sb_new()
                for seg in segs:
                    match seg:
                        case FSeg.Lit(s):
                            self.sb_lit(sb, s)
                        case FSeg.Part(x, spec):
                            let v = self.expr(x)
                            var fs: Option[FmtSpec] = None
                            match spec:
                                case Some(sp):
                                    fs = parse_fmt_spec(sp)
                                case None:
                                    pass
                            match fs:
                                case None:
                                    self.fmt_code(sb, v, x.ty, false)
                                case Some(f):
                                    self.fmt_spec(sb, v, x.ty, f)
                return self.sb_finish(sb)
            case ExprKind.Ident(_):
                match e.res:
                    case Res.Local(id):
                        return self.read_local(id)
                    case Res.Const(id):
                        return self.const_val(id)
                    case Res.Variant(_, vi):
                        return self.variant_const(e.ty, vi)
                    case _:
                        return self.cx.fb.konst(K.I64, 0)
            case ExprKind.Try(x):
                return self.try_expr(x, e)
            case ExprKind.Unary(op, x):
                let v = self.expr(x)
                match op:
                    case UnOp.Neg:
                        match e.ty:
                            case Ty.Int(k):
                                if k.signed() and not (self.cx.nc and ranges.handled(e.ty).is_some()):
                                    let loc = self.loc(e.span)
                                    return self.cx.fb.rt(
                                        int_kind(k),
                                        f"brine_neg_{k.suffix()}",
                                        [v, loc]
                                    )
                            case _:
                                pass
                        return self.cx.fb.un(Op.Neg, self.kind(e.ty), v)
                    case UnOp.Not:
                        return self.cx.fb.un(Op.Not, K.Bool, v)
                    case UnOp.BitNot:
                        return self.cx.fb.un(Op.Not, self.kind(e.ty), v)
            case ExprKind.Binary(op, l, r):
                if op == BinOp.And or op == BinOp.Or:
                    let a = self.expr(l)
                    let t = self.cx.fb.copy_of(a)
                    let skip = self.cx.fb.label()
                    if op == BinOp.And:
                        self.cx.fb.brnot(t, skip)
                    else:
                        self.cx.fb.br(t, skip)
                    self.push_frame()
                    let b = self.expr(r)
                    self.cx.fb.mov(t, b)
                    self.pop_frame()
                    self.cx.fb.place(skip)
                    return t
                if op == BinOp.Add and e.ty == Ty.Str:
                    let a = self.expr(l)
                    let b = self.expr(r)
                    let c = self.cx.fb.call(K.Ptr, "brine_str_concat", [a, b])
                    return self.temp(c, Ty.Str)
                let a = self.expr(l)
                let chk = self.op_checked(Some(op), e.ty, e.checked)
                let sh = -1 if chk else pow2_shift(op, r, e.ty)
                if sh > 0:
                    let kk = self.kind(e.ty)
                    if op == BinOp.Div:
                        let n = self.cx.fb.konst(kk, sh)
                        return self.cx.fb.bin(Op.Shr, kk, a, n)
                    let m = self.cx.fb.konst(kk, (1 << sh) - 1)
                    return self.cx.fb.bin(Op.And, kk, a, m)
                let b = self.expr(r)
                return self.arith(op, a, b, e.ty, chk, e.span)
            case ExprKind.Compare(first, rest):
                let a = self.expr(first)
                if len(rest) == 1:
                    let b = self.expr(rest[0].1)
                    return self.cmp_code(rest[0].0, a, b, first.ty)
                # `a < b < c`: each operand is evaluated once, and only while
                # the comparisons so far hold
                let r = self.cx.fb.konst(K.Bool, 0)
                var prev = a
                var skips: [int] = []
                let n = len(rest)
                for i, opx in enumerate(rest):
                    self.push_frame()
                    let x = self.expr(opx.1)
                    let c = self.cmp_code(opx.0, prev, x, opx.1.ty)
                    self.cx.fb.mov(r, c)
                    if i + 1 < n:
                        let l = self.cx.fb.label()
                        self.cx.fb.brnot(r, l)
                        skips.push(l)
                    prev = x
                var j = n - 1
                while j >= 0:
                    if j + 1 < n:
                        self.cx.fb.place(skips[j])
                    self.pop_frame()
                    j -= 1
                return r
            case ExprKind.IfElse(cond, then, els):
                let c = self.expr(cond)
                let m = self.managed(e.ty)
                let t = self.cx.fb.vreg(self.kind(e.ty))
                let lels = self.cx.fb.label()
                let end = self.cx.fb.label()
                self.cx.fb.brnot(c, lels)
                self.push_frame()
                let v1 = self.owned(then) if m else self.expr(then)
                if then.ty != Ty.Never:
                    self.cx.fb.mov(t, v1)
                self.pop_frame()
                self.cx.fb.jmp(end)
                self.cx.fb.place(lels)
                self.push_frame()
                let v2 = self.owned(els) if m else self.expr(els)
                if els.ty != Ty.Never:
                    self.cx.fb.mov(t, v2)
                self.pop_frame()
                self.cx.fb.place(end)
                return self.temp(t, e.ty)
            case ExprKind.Call(_, args):
                match e.cres:
                    case CallRes.Fn(id):
                        return self.call_fn(id, None, args, e.span)
                    case CallRes.Ctor(sid):
                        return self.ctor(sid, args, e)
                    case CallRes.Variant(eid, vi):
                        return self.variant(eid, vi, args, e)
                    case CallRes.Builtin(b):
                        return self.builtin(b, None, args, e)
                    case CallRes.Reduce(r):
                        return self.reduce(r, args[0].expr, e)
                    case CallRes.Convert(t):
                        return self.convert(t, args[0].expr, e)
                    case _:
                        return self.unit()
            case ExprKind.MethodCall(recv, _, _, args):
                match e.cres:
                    case CallRes.Fn(id):
                        return self.call_fn(id, None, args, e.span)
                    case CallRes.Method(id):
                        return self.call_fn(id, Some(recv), args, e.span)
                    case CallRes.Ctor(sid):
                        return self.ctor(sid, args, e)
                    case CallRes.Variant(eid, vi):
                        return self.variant(eid, vi, args, e)
                    case CallRes.Builtin(b):
                        return self.builtin(b, Some(recv), args, e)
                    case CallRes.World(op):
                        return self.world(op, args, e)
                    case CallRes.Os(op):
                        return self.os(op, args, e)
                    case _:
                        return self.unit()
            case ExprKind.Field(base, _, _):
                match e.res:
                    case Res.Const(id):
                        return self.const_val(id)
                    case Res.Variant(_, vi):
                        return self.variant_const(e.ty, vi)
                    case _:
                        pass
                let b = self.expr(base)
                return self.ld(b, self.field_off(base.ty, e.idx), e.ty)
            case ExprKind.Slice(base, lo, hi):
                let b = self.expr(base)
                var l = -1
                match lo:
                    case Some(x):
                        let lo0 = self.expr(x)
                        l = self.cx.fb.conv(K.I64, lo0)
                    case None:
                        l = self.cx.fb.konst(K.I64, 0)
                var h = -1
                match hi:
                    case Some(x):
                        let hi0 = self.expr(x)
                        h = self.cx.fb.conv(K.I64, hi0)
                    case None:
                        h = self.cx.fb.load(K.I64, b, 8)
                let loc = self.loc(e.span)
                let f = "brine_str_slice" if base.ty == Ty.Str else "brine_arr_slice"
                let r = self.cx.fb.call(K.Ptr, f, [b, l, h, loc])
                return self.temp(r, e.ty)
            case ExprKind.Index(base, idx):
                if base.ty == Ty.Str:
                    let b = self.expr(base)
                    let i0 = self.expr(idx)
                    let i = self.cx.fb.conv(K.I64, i0)
                    if e.checked:
                        let loc = self.loc(e.span)
                        return self.cx.fb.rt(K.Ptr, "brine_str_at", [b, i, loc])
                    return self.cx.fb.rt(K.Ptr, "brine_str_byte", [b, i])
                match base.ty:
                    case Ty.Map(_, _):
                        let b = self.expr(base)
                        let k = self.expr(idx)
                        let kp = self.addr_of(k, idx.ty)
                        let loc = self.loc(e.span)
                        let mf = self.map_find(base.ty)
                        let en = self.cx.fb.call(K.I64, mf, [b, kp])
                        let vsz = self.cx.fb.konst(K.I64, self.lay(e.ty).size)
                        let p = self.cx.fb.rt(K.Ptr, "brine_map_val", [b, en, kp, vsz, loc])
                        return self.ld(p, 0, e.ty)
                    case _:
                        pass
                if self.is_bits(base):
                    let (p, sh) = self.bit_at(base, idx, e.checked, e.span)
                    let w = self.cx.fb.load(K.U64, p, 0)
                    let x = self.cx.fb.bin(Op.Shr, K.U64, w, sh)
                    let one = self.cx.fb.konst(K.U64, 1)
                    let bit = self.cx.fb.bin(Op.And, K.U64, x, one)
                    let z = self.cx.fb.konst(K.U64, 0)
                    return self.cx.fb.cmp(Op.Ne, bit, z)
                let et = self.elem_ty(base, e.ty)
                var p = -1
                match self.cached_arr(base):
                    case Some(c):
                        let i = self.expr(idx)
                        p = self.cached_elem_ptr(c, i, et, e.checked, e.span)
                    case None:
                        let b = self.expr(base)
                        let i = self.expr(idx)
                        p = self.arr_elem_ptr(b, i, et, e.checked, e.span)
                let x = self.ld(p, 0, et)
                if et != e.ty:
                    return self.cx.fb.conv(self.kind(e.ty), x)
                return x
            case ExprKind.Map(kvs):
                let mt = self.map_ty(e.ty)
                let t = self.cx.fb.call(K.Ptr, "brine_map_new", [mt])
                self.register(t, e.ty)
                let home = self.addr_of(t, e.ty)
                for kv in kvs:
                    let vals = self.owned_all([kv.0, kv.1])
                    let ks = self.addr_of(vals[0], kv.0.ty)
                    let vs = self.addr_of(vals[1], kv.1.ty)
                    self.cx.fb.call_void("brine_map_set", [home, ks, vs])
                    self.cx.fb.load_to(t, home, 0)
                return t
            case ExprKind.Contains(item, coll, neg):
                let c = self.expr(coll)
                let x = self.expr(item)
                var tst = -1
                match coll.ty:
                    case Ty.Map(_, _):
                        let kp = self.addr_of(x, item.ty)
                        let mf = self.map_find(coll.ty)
                        let en = self.cx.fb.call(K.I64, mf, [c, kp])
                        let zero = self.cx.fb.konst(K.I64, 0)
                        tst = self.cx.fb.cmp(Op.Ge, en, zero)
                    case Ty.Str:
                        tst = self.cx.fb.call(K.Bool, "brine_str_contains", [c, x])
                    case _:
                        let ix = self.find_elem(c, x, coll.ty.elem())
                        let zero = self.cx.fb.konst(K.I64, 0)
                        tst = self.cx.fb.cmp(Op.Ge, ix, zero)
                if neg:
                    return self.cx.fb.un(Op.Not, K.Bool, tst)
                return tst
            case ExprKind.Array(es):
                let el = e.ty.elem()
                let vals = self.owned_all(es)
                let loc = self.loc(e.span)
                let n = self.cx.fb.konst(K.I64, len(es))
                let t = self.new_arr(el, n, loc)
                self.register(t, e.ty)
                if len(vals) > 0:
                    let data = self.cx.fb.load(K.Ptr, t, 48)
                    let esz = self.lay(el).size
                    for i, v in enumerate(vals):
                        self.st(data, i * esz, el, v)
                return t
            case ExprKind.Repeat(elem, count):
                let bits = self.cx.bits_init
                self.cx.bits_init = false
                var el = e.ty.elem()
                let bytes = self.cx.narrow_init
                self.cx.narrow_init = false
                if bytes:
                    el = Ty.Int(IntTy.U8)
                var v = self.expr(elem)
                if el != e.ty.elem():
                    v = self.cx.fb.conv(K.U8, v)
                let n0 = self.expr(count)
                let n = self.cx.fb.conv(K.I64, n0)
                let loc = self.loc(e.span)
                if bits:
                    let fill = self.cx.fb.conv(K.I64, v)
                    let b = self.cx.fb.call(K.Ptr, "brine_bits_new", [n, fill, loc])
                    self.register(b, e.ty)
                    return b
                var t = -1
                if bytes:
                    t = self.cx.fb.call(K.Ptr, "brine_bytes_new", [n, loc])
                else:
                    t = self.new_arr(el, n, loc)
                self.register(t, e.ty)
                var zero = false
                match elem.kind:
                    case ExprKind.Int(z):
                        zero = z == 0
                    case ExprKind.Bool(z):
                        zero = not z
                    case ExprKind.Float(z):
                        let zs = f"{z}"
                        zero = z == 0.0 and not zs.starts_with("-")
                    case _:
                        pass
                if not zero:
                    let data = self.cx.fb.load(K.Ptr, t, 48)
                    let k = self.cx.fb.konst(K.I64, 0)
                    let one = self.cx.fb.konst(K.I64, 1)
                    let head = self.cx.fb.label()
                    let out = self.cx.fb.label()
                    self.cx.fb.place(head)
                    let more = self.cx.fb.cmp(Op.Lt, k, n)
                    self.cx.fb.brnot(more, out)
                    let p = self.cx.fb.elem(data, k, self.lay(el).size)
                    self.st(p, 0, el, v)
                    self.retain(v, el)
                    let k2 = self.cx.fb.bin(Op.Add, K.I64, k, one)
                    self.cx.fb.mov(k, k2)
                    self.cx.fb.jmp(head)
                    self.cx.fb.place(out)
                return t
            case ExprKind.Tuple(es):
                if len(es) == 0:
                    return self.unit()
                let vals = self.owned_all(es)
                let lay = self.lay(e.ty)
                let t = self.cx.fb.temp_mem(lay.size, lay.align)
                match e.ty:
                    case Ty.Tuple(ts):
                        for i, v in enumerate(vals):
                            self.st(t, self.field_off(e.ty, i), ts[i], v)
                    case _:
                        pass
                return self.temp(t, e.ty)
            case ExprKind.Comp(c):
                if c.par:
                    return self.par_list(c, e)
                return self.seq_list(c, e)
            case ExprKind.ParTuple(elems):
                return self.par_tuple(elems, e.caps, e)
            case _:
                return self.unit()

    # A string builder's contents as a new string (an owned temp).
    fn sb_finish(ref self, sb: int) -> int:
        let r = self.cx.fb.call(K.Ptr, "brine_sb_finish", [sb])
        return self.temp(r, Ty.Str)

    # I64: the index of the first element of array `a` equal to `x`, or -1.
    fn find_elem(ref self, a: int, x: int, el: Ty) -> int:
        let r = self.cx.fb.konst(K.I64, -1)
        let i = self.cx.fb.konst(K.I64, 0)
        let one = self.cx.fb.konst(K.I64, 1)
        let n = self.cx.fb.load(K.I64, a, 8)
        let data = self.cx.fb.load(K.Ptr, a, 48)
        let head = self.cx.fb.label()
        let out = self.cx.fb.label()
        let found = self.cx.fb.label()
        self.cx.fb.place(head)
        let more = self.cx.fb.cmp(Op.Lt, i, n)
        self.cx.fb.brnot(more, out)
        let p = self.cx.fb.elem(data, i, self.lay(el).size)
        let y = self.ld(p, 0, el)
        let q = self.eq_code(y, x, el)
        self.cx.fb.br(q, found)
        let i2 = self.cx.fb.bin(Op.Add, K.I64, i, one)
        self.cx.fb.mov(i, i2)
        self.cx.fb.jmp(head)
        self.cx.fb.place(found)
        self.cx.fb.mov(r, i)
        self.cx.fb.place(out)
        return r

    fn fmt_spec(ref self, sb: int, v: int, t: Ty, fs: FmtSpec):
        var start = -1
        if fs.width > 0:
            start = self.cx.fb.load(K.I64, sb, 8)
        let k = fs.kind.unwrap_or("")
        if k == "f" or k == "e":
            let p = self.cx.fb.konst(K.I32, fs.prec.unwrap_or(-1))
            let kc = self.cx.fb.konst(K.I32, ord(k))
            let x = self.cx.fb.conv(K.F64, v)
            self.cx.fb.call_void("brine_sb_fmt_f64", [sb, x, p, kc])
        elif k == "x" or k == "b":
            let kc = self.cx.fb.konst(K.I32, ord(k))
            match t:
                case Ty.Int(IntTy.I128):
                    self.cx.fb.rt_void("brine_sb_fmt_i128", [sb, v, kc])
                case Ty.Int(IntTy.U128):
                    self.cx.fb.rt_void("brine_sb_fmt_u128", [sb, v, kc])
                case Ty.Int(ik):
                    if ik.signed():
                        let x = self.cx.fb.conv(K.I64, v)
                        self.cx.fb.call_void("brine_sb_fmt_i64", [sb, x, kc])
                    else:
                        let x = self.cx.fb.conv(K.U64, v)
                        self.cx.fb.call_void("brine_sb_fmt_u64", [sb, x, kc])
                case _:
                    let x = self.cx.fb.conv(K.U64, v)
                    self.cx.fb.call_void("brine_sb_fmt_u64", [sb, x, kc])
        else:
            self.fmt_code(sb, v, t, false)
        if fs.width > 0:
            let w = self.cx.fb.konst(K.I64, fs.width)
            let left = self.cx.fb.konst(K.Bool, 1 if fs.left else 0)
            let zero = self.cx.fb.konst(K.Bool, 1 if fs.zero else 0)
            self.cx.fb.call_void("brine_sb_pad", [sb, start, w, left, zero])

    fn arith(ref self, op: BinOp, a: int, b: int, ty: Ty, checked: bool, span: Span) -> int:
        match ty:
            case Ty.Int(k):
                let kk = int_kind(k)
                let s = k.suffix()
                match op:
                    case BinOp.Add | BinOp.Sub | BinOp.Mul:
                        var o = Op.Mul
                        var oo = Op.MulO
                        if op == BinOp.Add:
                            o = Op.Add
                            oo = Op.AddO
                        elif op == BinOp.Sub:
                            o = Op.Sub
                            oo = Op.SubO
                        if checked:
                            let loc = self.loc(span)
                            return self.cx.fb.chk(oo, kk, a, b, loc)
                        return self.cx.fb.bin(o, kk, a, b)
                    case BinOp.Div | BinOp.Mod:
                        let n = "div" if op == BinOp.Div else "mod"
                        if checked:
                            let loc = self.loc(span)
                            return self.cx.fb.rt(kk, f"brine_{n}_{s}", [a, b, loc])
                        # floor division and modulo (b is known not to be zero)
                        if not k.signed():
                            return self.cx.fb.bin(Op.Div if op == BinOp.Div else Op.Rem, kk, a, b)
                        return self.cx.fb.rt(kk, f"brine_f{n}_{s}", [a, b])
                    case BinOp.BitAnd:
                        return self.cx.fb.bin(Op.And, kk, a, b)
                    case BinOp.BitOr:
                        return self.cx.fb.bin(Op.Or, kk, a, b)
                    case BinOp.BitXor:
                        return self.cx.fb.bin(Op.Xor, kk, a, b)
                    case BinOp.Shl | BinOp.Shr:
                        let n = "shl" if op == BinOp.Shl else "shr"
                        if checked:
                            let loc = self.loc(span)
                            let b64 = self.cx.fb.conv(K.I64, b)
                            return self.cx.fb.rt(kk, f"brine_{n}_{s}", [a, b64, loc])
                        return self.cx.fb.bin(Op.Shl if op == BinOp.Shl else Op.Shr, kk, a, b)
                    case _:
                        return self.cx.fb.konst(kk, 0)
            case Ty.Float(f):
                let fk = K.F32 if f == FloatTy.F32 else K.F64
                match op:
                    case BinOp.Add:
                        return self.cx.fb.bin(Op.Add, fk, a, b)
                    case BinOp.Sub:
                        return self.cx.fb.bin(Op.Sub, fk, a, b)
                    case BinOp.Mul:
                        return self.cx.fb.bin(Op.Mul, fk, a, b)
                    case BinOp.Div:
                        return self.cx.fb.bin(Op.Div, fk, a, b)
                    case _:
                        let fname = "brine_f_fmodf" if f == FloatTy.F32 else "brine_f_fmod"
                        return self.cx.fb.rt(fk, fname, [a, b])
            case _:
                return self.cx.fb.konst(K.I64, 0)

    fn cmp_code(ref self, op: CmpOp, a: int, b: int, t: Ty) -> int:
        match t:
            case Ty.Str:
                match op:
                    case CmpOp.Eq:
                        return self.cx.fb.rt(K.Bool, "brine_str_eq", [a, b])
                    case CmpOp.Ne:
                        let q = self.cx.fb.rt(K.Bool, "brine_str_eq", [a, b])
                        return self.cx.fb.un(Op.Not, K.Bool, q)
                    case _:
                        let c = self.cx.fb.call(K.I32, "brine_str_cmp", [a, b])
                        let z = self.cx.fb.konst(K.I32, 0)
                        return self.cx.fb.cmp(cmp_op(op), c, z)
            case Ty.Array(_) | Ty.Map(_, _) | Ty.Tuple(_) | Ty.Struct(_) | Ty.Enum(_):
                let q = self.eq_code(a, b, t)
                if op == CmpOp.Ne:
                    return self.cx.fb.un(Op.Not, K.Bool, q)
                return q
            case _:
                return self.cx.fb.cmp(cmp_op(op), a, b)

    fn call_fn(ref self, id: int, recv: Option[Expr], args: [Arg], span: Span) -> int:
        var sig = self.info.fns[id]
        if len(self.cx.nc_calls) > 0 and ranges.key(span) in self.cx.nc_calls:
            sig.c_name = sig.c_name + "__nc"
        # With a `ref` parameter, by-value arguments may read the variable the call
        # changes; holding a reference of their own makes copy-on-write protect them.
        let has_ref = any(p.by_ref for p in sig.params)
        var cargs: [int] = []
        var sret = -1
        if self.agg(sig.ret):
            let lay = self.lay(sig.ret)
            sret = self.cx.fb.temp_mem(lay.size, lay.align)
            cargs.push(sret)
        var pi = 0
        match recv:
            case Some(r):
                if sig.params[0].by_ref:
                    cargs.push(self.lvalue(r))
                else:
                    cargs.push(self.value_arg(r, has_ref))
                pi = 1
            case None:
                pass
        for i, a in enumerate(args):
            if pi + i >= len(sig.params):
                break
            if sig.params[pi + i].by_ref:
                cargs.push(self.lvalue(a.expr))
            else:
                cargs.push(self.value_arg(a.expr, has_ref))
        if self.tracks_caller(id):
            cargs.push(self.loc(span))
        if sret >= 0:
            self.cx.fb.call_void(sig.c_name, cargs)
            return self.temp(sret, sig.ret)
        if not self.ret_has(sig.ret):
            self.cx.fb.call_void(sig.c_name, cargs)
            return self.unit()
        let r = self.cx.fb.call(self.kind(sig.ret), sig.c_name, cargs)
        return self.temp(r, sig.ret)

    # `x?`: return `None`/`Err` from the function, or continue with the value inside.
    fn try_expr(ref self, x: Expr, e: Expr) -> int:
        let v = self.expr(x)
        let f = self.fnd.unwrap()
        let rty = self.info.fns[f.id].ret
        let kind = try_kind(self.info, x.ty).unwrap()
        var fail_v = 0
        var ok_v = 0
        match kind:
            case TryKind.Opt(some, none, _):
                fail_v = none
                ok_v = some
            case TryKind.Res(okv, errv, _, _):
                fail_v = errv
                ok_v = okv
        let tag = self.cx.fb.load(K.I64, v, 8)
        let fv = self.cx.fb.konst(K.I64, fail_v)
        let failed = self.cx.fb.cmp(Op.Eq, tag, fv)
        let ok = self.cx.fb.label()
        self.cx.fb.brnot(failed, ok)
        var ret = -1
        let xe = cg_enum_id(x.ty)
        let rk = try_kind(self.info, rty)
        match (kind, rk):
            case (TryKind.Res(_, _, _, err), Some(TryKind.Res(_, rerr_v, _, _))):
                let re = cg_enum_id(rty)
                let r = self.box_new(re, rerr_v, true)
                let ev = self.ld(v, self.vfield_off(xe, fail_v, 0), err)
                let roff = self.vfield_off(re, rerr_v, 0)
                self.st(r, roff, err, ev)
                let rv = self.ld(r, roff, err)
                self.retain(rv, err)
                ret = r
            case (_, Some(TryKind.Opt(_, none, _))):
                ret = self.variant_const(rty, none)
            case _:
                panic("`?` in a function that doesn't return Option/Result")
        # leave the function: release this statement's temps and every local
        var temps: [Temp] = []
        for fr in self.cx.frames:
            temps.extend(fr)
        self.release_temps(temps)
        self.release_scopes_from(0)
        self.cx.fb.ret(ret)
        self.cx.fb.place(ok)
        return self.ld(v, self.vfield_off(xe, ok_v, 0), e.ty)

    # A by-value argument; `hold` keeps a reference until the end of the statement.
    fn value_arg(ref self, e: Expr, hold: bool) -> int:
        if not hold or not self.managed(e.ty):
            return self.expr(e)
        let v = self.owned(e)
        self.register(v, e.ty)
        return v

    # The positions of named arguments among `fields`.
    fn arg_slots(self, args: [Arg], fields: [(str, Ty)]) -> [int]:
        var out: [int] = []
        for i, a in enumerate(args):
            var idx = i
            match a.name:
                case Some((name, _)):
                    for j, fd in enumerate(fields):
                        if fd.0 == name:
                            idx = j
                            break
                case None:
                    pass
            out.push(idx)
        return out

    fn ctor(ref self, sid: int, args: [Arg], e: Expr) -> int:
        let fields = self.info.structs[sid].fields
        # evaluate every argument before claiming any (see `owned_all`)
        let owned = self.owned_all([a.expr for a in args])
        let slots = self.arg_slots(args, fields)
        let lay = self.lay(e.ty)
        let t = self.cx.fb.temp_mem(lay.size, lay.align)
        if len(fields) == 0:
            self.cx.fb.zero(t, lay.size)
        for i, v in enumerate(owned):
            let idx = slots[i]
            if idx < len(fields):
                self.st(t, self.field_off(e.ty, idx), fields[idx].1, v)
        return self.temp(t, e.ty)

    fn variant(ref self, eid: int, vi: int, args: [Arg], e: Expr) -> int:
        let fields = self.info.enums[eid].variants[vi].fields
        if len(fields) == 0:
            return self.variant_const(e.ty, vi)
        let owned = self.owned_all([a.expr for a in args])
        let slots = self.arg_slots(args, fields)
        let b = self.box_new(eid, vi, false)
        for i, v in enumerate(owned):
            let idx = slots[i]
            if idx < len(fields):
                self.st(b, self.vfield_off(eid, vi, idx), fields[idx].1, v)
        return self.temp(b, e.ty)

    # ============================================================ built-in functions
    fn builtin(ref self, b: Builtin, recv: Option[Expr], args: [Arg], e: Expr) -> int:
        match b:
            case Builtin.Print | Builtin.Eprint:
                # arguments run in the order written, `sep=` and `end=` included
                var vals: [(int, Ty)] = []
                var sep = -1
                var end = -1
                for a in args:
                    let v = self.expr(a.expr)
                    match a.name:
                        case Some((n, _)):
                            if n == "sep":
                                sep = v
                            else:
                                end = v
                        case None:
                            vals.push((v, a.expr.ty))
                let sb = self.sb_new()
                for i, x in enumerate(vals):
                    if i > 0:
                        if sep >= 0:
                            self.fmt_code(sb, sep, Ty.Str, false)
                        else:
                            self.sb_lit(sb, " ")
                    self.fmt_code(sb, x.0, x.1, false)
                if end >= 0:
                    self.fmt_code(sb, end, Ty.Str, false)
                else:
                    self.sb_lit(sb, "\n")
                let f = "brine_out_sb" if b == Builtin.Print else "brine_err_sb"
                self.cx.fb.call_void(f, [sb])
                return self.unit()
            case Builtin.Len:
                match self.cached_arr(args[0].expr):
                    case Some(c):
                        return c.len
                    case None:
                        pass
                let v = self.expr(args[0].expr)
                return self.cx.fb.load(K.I64, v, 8)
            case Builtin.Get:
                let r = recv.unwrap()
                var vt = Ty.Error
                match r.ty:
                    case Ty.Map(_, x):
                        vt = x
                    case _:
                        pass
                let m = self.expr(r)
                let k = self.expr(args[0].expr)
                let kp = self.addr_of(k, args[0].expr.ty)
                let ix = self.cx.fb.call(K.I64, "brine_map_find", [m, kp])
                let zero = self.cx.fb.konst(K.I64, 0)
                let present = self.cx.fb.cmp(Op.Ge, ix, zero)
                let vals = self.cx.fb.load(K.Ptr, m, 56)
                let vp = self.cx.fb.elem(vals, ix, self.lay(vt).size)
                if len(args) == 2:
                    let d = self.expr(args[1].expr)
                    let res = self.cx.fb.copy_of(d)
                    let skip = self.cx.fb.label()
                    self.cx.fb.brnot(present, skip)
                    let x = self.ld(vp, 0, vt)
                    self.cx.fb.mov(res, x)
                    self.cx.fb.place(skip)
                    return res
                return self.make_option(e.ty, present, vp, vt)
            case Builtin.Remove:
                let r = recv.unwrap()
                let k = self.expr(args[0].expr)
                let kp = self.addr_of(k, args[0].expr.ty)
                let lp = self.lvalue(r)
                return self.cx.fb.call(K.Bool, "brine_map_remove", [lp, kp])
            case Builtin.Keys | Builtin.Values:
                let m = self.expr(recv.unwrap())
                let f = "brine_map_keys" if b == Builtin.Keys else "brine_map_values"
                let r = self.cx.fb.call(K.Ptr, f, [m])
                return self.temp(r, e.ty)
            case Builtin.Items:
                let r = recv.unwrap()
                var kt = Ty.Error
                var vt = Ty.Error
                match r.ty:
                    case Ty.Map(x, y):
                        kt = x
                        vt = y
                    case _:
                        pass
                let m = self.expr(r)
                let el = e.ty.elem()
                let loc = self.loc(e.span)
                let n = self.cx.fb.load(K.I64, m, 8)
                let t = self.new_arr(el, n, loc)
                self.register(t, e.ty)
                let used = self.cx.fb.load(K.I64, m, 16)
                let keys = self.cx.fb.load(K.Ptr, m, 48)
                let mvals = self.cx.fb.load(K.Ptr, m, 56)
                let live = self.cx.fb.load(K.Ptr, m, 72)
                let data = self.cx.fb.load(K.Ptr, t, 48)
                let i = self.cx.fb.konst(K.I64, 0)
                let j = self.cx.fb.konst(K.I64, 0)
                let one = self.cx.fb.konst(K.I64, 1)
                let head = self.cx.fb.label()
                let next = self.cx.fb.label()
                let out = self.cx.fb.label()
                self.cx.fb.place(head)
                let more = self.cx.fb.cmp(Op.Lt, i, used)
                self.cx.fb.brnot(more, out)
                let lp = self.cx.fb.elem(live, i, 1)
                let alive = self.cx.fb.load(K.Bool, lp, 0)
                self.cx.fb.brnot(alive, next)
                let p = self.cx.fb.elem(data, j, self.lay(el).size)
                let j2 = self.cx.fb.bin(Op.Add, K.I64, j, one)
                self.cx.fb.mov(j, j2)
                let kptr = self.cx.fb.elem(keys, i, self.lay(kt).size)
                let kx = self.ld(kptr, 0, kt)
                let o0 = self.field_off(el, 0)
                self.st(p, o0, kt, kx)
                self.retain(kx, kt)
                let vptr = self.cx.fb.elem(mvals, i, self.lay(vt).size)
                let vx = self.ld(vptr, 0, vt)
                let o1 = self.field_off(el, 1)
                self.st(p, o1, vt, vx)
                self.retain(vx, vt)
                self.cx.fb.place(next)
                let i2 = self.cx.fb.bin(Op.Add, K.I64, i, one)
                self.cx.fb.mov(i, i2)
                self.cx.fb.jmp(head)
                self.cx.fb.place(out)
                return t
            case Builtin.Abs:
                let v = self.expr(args[0].expr)
                match e.ty:
                    case Ty.Int(k):
                        let loc = self.loc(e.span)
                        return self.cx.fb.rt(int_kind(k), f"brine_abs_{k.suffix()}", [v, loc])
                    case Ty.Float(FloatTy.F32):
                        return self.cx.fb.rt(K.F32, "brine_f_fabsf", [v])
                    case _:
                        return self.cx.fb.rt(K.F64, "brine_f_fabs", [v])
            case Builtin.Min | Builtin.Max:
                let a = self.expr(args[0].expr)
                let c = self.expr(args[1].expr)
                let mn = b == Builtin.Min
                match e.ty:
                    case Ty.Float(fk):
                        let suf = "f" if fk == FloatTy.F32 else ""
                        let nm = "min" if mn else "max"
                        return self.cx.fb.rt(self.kind(e.ty), f"brine_f_f{nm}{suf}", [a, c])
                    case _:
                        let take = self.cx.fb.cmp(Op.Lt if mn else Op.Gt, a, c)
                        let res = self.cx.fb.copy_of(c)
                        let skip = self.cx.fb.label()
                        self.cx.fb.brnot(take, skip)
                        self.cx.fb.mov(res, a)
                        self.cx.fb.place(skip)
                        return res
            case Builtin.Sqrt | Builtin.Sin | Builtin.Cos | Builtin.Tan | Builtin.Exp | Builtin.Log | Builtin.Floor | Builtin.Ceil | Builtin.Round:
                let v = self.expr(args[0].expr)
                var n = "round"
                match b:
                    case Builtin.Sqrt:
                        n = "sqrt"
                    case Builtin.Sin:
                        n = "sin"
                    case Builtin.Cos:
                        n = "cos"
                    case Builtin.Tan:
                        n = "tan"
                    case Builtin.Exp:
                        n = "exp"
                    case Builtin.Log:
                        n = "log"
                    case Builtin.Floor:
                        n = "floor"
                    case Builtin.Ceil:
                        n = "ceil"
                    case _:
                        n = "round"
                let suf = "f" if e.ty == Ty.Float(FloatTy.F32) else ""
                return self.cx.fb.rt(self.kind(e.ty), f"brine_f_{n}{suf}", [v])
            case Builtin.Pow:
                let a = self.expr(args[0].expr)
                let c = self.expr(args[1].expr)
                return self.cx.fb.rt(K.F64, "brine_f_pow", [a, c])
            case Builtin.Clock:
                return self.cx.fb.call(K.F64, "brine_clock", [])
            case Builtin.Args:
                let r = self.cx.fb.call(K.Ptr, "brine_args", [])
                return self.temp(r, e.ty)
            case Builtin.Exit:
                let code0 = self.expr(args[0].expr)
                let v = self.cx.fb.conv(K.I64, code0)
                self.cx.fb.call_void("brine_exit", [v])
                return self.unit()
            case Builtin.Panic:
                let v = self.expr(args[0].expr)
                let loc = self.loc(e.span)
                self.cx.fb.call_void("brine_panic_str", [loc, v])
                return self.unit()
            case Builtin.Push:
                let r = recv.unwrap()
                let el = r.ty.elem()
                let v = self.owned(args[0].expr)
                let tp = self.addr_of(v, el)
                let lp = self.lvalue(r)
                self.cx.fb.call_void("brine_arr_push", [lp, tp])
                return self.unit()
            case Builtin.Pop | Builtin.PopAt:
                let r = recv.unwrap()
                var idx = -1
                if b == Builtin.PopAt:
                    let idx0 = self.expr(args[0].expr)
                    idx = self.cx.fb.conv(K.I64, idx0)
                let lp = self.lvalue(r)
                let lay = self.lay(e.ty)
                let out = self.cx.fb.temp_mem(lay.size, lay.align)
                let loc = self.loc(e.span)
                if idx >= 0:
                    self.cx.fb.call_void("brine_arr_pop_at", [lp, idx, out, loc])
                else:
                    self.cx.fb.call_void("brine_arr_pop", [lp, out, loc])
                let v = self.ld(out, 0, e.ty)
                return self.temp(v, e.ty)
            case Builtin.Insert:
                let r = recv.unwrap()
                let i0 = self.expr(args[0].expr)
                let i = self.cx.fb.conv(K.I64, i0)
                let v = self.owned(args[1].expr)
                let tp = self.addr_of(v, r.ty.elem())
                let lp = self.lvalue(r)
                let loc = self.loc(e.span)
                self.cx.fb.call_void("brine_arr_insert", [lp, i, tp, loc])
                return self.unit()
            case Builtin.Extend:
                let r = recv.unwrap()
                let v = self.expr(args[0].expr)
                let lp = self.lvalue(r)
                self.cx.fb.call_void("brine_arr_extend", [lp, v])
                return self.unit()
            case Builtin.Reverse | Builtin.Clear | Builtin.Sort:
                let r = recv.unwrap()
                let lp = self.lvalue(r)
                if b == Builtin.Reverse:
                    self.cx.fb.call_void("brine_arr_reverse", [lp])
                elif b == Builtin.Clear:
                    self.cx.fb.call_void("brine_arr_clear", [lp])
                else:
                    let c = self.need_cmp(r.ty.elem())
                    let fp = self.cx.fb.global(c)
                    self.cx.fb.call_void("brine_arr_sort", [lp, fp])
                return self.unit()
            case Builtin.IndexOf:
                let r = recv.unwrap()
                let a = self.expr(r)
                let x = self.expr(args[0].expr)
                let ix = self.find_elem(a, x, r.ty.elem())
                let zero = self.cx.fb.konst(K.I64, 0)
                let present = self.cx.fb.cmp(Op.Ge, ix, zero)
                let ip = self.addr_of(ix, int_ty())
                return self.make_option(e.ty, present, ip, int_ty())
            case Builtin.Str(m):
                let r = recv.unwrap()
                var vals = [self.expr(r)]
                for a in args:
                    vals.push(self.expr(a.expr))
                vals.push(self.loc(e.span))
                if m == StrM.Find:
                    let ix = self.cx.fb.call(K.I64, m.c_name(), vals)
                    let zero = self.cx.fb.konst(K.I64, 0)
                    let present = self.cx.fb.cmp(Op.Ge, ix, zero)
                    let ip = self.addr_of(ix, int_ty())
                    return self.make_option(e.ty, present, ip, int_ty())
                let res = self.cx.fb.call(self.kind(e.ty), m.c_name(), vals)
                return self.temp(res, e.ty)
            case Builtin.Enumerate:
                let a = self.expr(args[0].expr)
                let el = e.ty.elem()
                var x = Ty.Error
                match el:
                    case Ty.Tuple(ts):
                        x = ts[1]
                    case _:
                        pass
                let loc = self.loc(e.span)
                let n = self.cx.fb.load(K.I64, a, 8)
                let t = self.new_arr(el, n, loc)
                self.register(t, e.ty)
                let src = self.cx.fb.load(K.Ptr, a, 48)
                let dst = self.cx.fb.load(K.Ptr, t, 48)
                let i = self.cx.fb.konst(K.I64, 0)
                let one = self.cx.fb.konst(K.I64, 1)
                let head = self.cx.fb.label()
                let out = self.cx.fb.label()
                self.cx.fb.place(head)
                let more = self.cx.fb.cmp(Op.Lt, i, n)
                self.cx.fb.brnot(more, out)
                let p = self.cx.fb.elem(dst, i, self.lay(el).size)
                self.cx.fb.store(p, self.field_off(el, 0), i)
                let sptr = self.cx.fb.elem(src, i, self.lay(x).size)
                let xv = self.ld(sptr, 0, x)
                self.st(p, self.field_off(el, 1), x, xv)
                self.retain(xv, x)
                let i2 = self.cx.fb.bin(Op.Add, K.I64, i, one)
                self.cx.fb.mov(i, i2)
                self.cx.fb.jmp(head)
                self.cx.fb.place(out)
                return t
            case Builtin.ReadFile:
                let p = self.expr(args[0].expr)
                let outp = self.null_slot()
                let ok = self.cx.fb.call(K.Bool, "brine_read_file", [p, outp])
                let o = self.cx.fb.load(K.Ptr, outp, 0)
                return self.make_result(e.ty, ok, o, Ty.Str, o)
            case Builtin.WriteFile:
                let p = self.expr(args[0].expr)
                let t = self.expr(args[1].expr)
                let errp = self.null_slot()
                let ok = self.cx.fb.call(K.Bool, "brine_write_file", [p, t, errp])
                let err = self.cx.fb.load(K.Ptr, errp, 0)
                let u = self.unit()
                return self.make_result(e.ty, ok, u, Ty.Unit, err)
            case Builtin.Run:
                let a = self.expr(args[0].expr)
                let codep = self.null_slot()
                let errp = self.null_slot()
                let ok = self.cx.fb.call(K.Bool, "brine_run", [a, codep, errp])
                let code = self.cx.fb.load(K.I64, codep, 0)
                let err = self.cx.fb.load(K.Ptr, errp, 0)
                return self.make_result(e.ty, ok, code, int_ty(), err)
            case Builtin.FileExists:
                let p = self.expr(args[0].expr)
                return self.cx.fb.call(K.Bool, "brine_file_exists", [p])
            case Builtin.Embed:
                return self.expr(args[0].expr)
            case Builtin.Getenv:
                let n = self.expr(args[0].expr)
                let g = self.cx.fb.call(K.Ptr, "brine_getenv", [n])
                let null = self.cx.fb.konst(K.Ptr, 0)
                let present = self.cx.fb.cmp(Op.Ne, g, null)
                let gp = self.addr_of(g, Ty.Str)
                let o = self.make_option(e.ty, present, gp, Ty.Str)
                let skip = self.cx.fb.label()
                self.cx.fb.brnot(present, skip)
                self.release(g, Ty.Str)
                self.cx.fb.place(skip)
                return o
            case Builtin.Ord:
                let v = self.expr(args[0].expr)
                let loc = self.loc(e.span)
                return self.cx.fb.call(K.I64, "brine_ord", [v, loc])
            case Builtin.Chr:
                let c0 = self.expr(args[0].expr)
                let v = self.cx.fb.conv(K.I64, c0)
                let loc = self.loc(e.span)
                let r = self.cx.fb.call(K.Ptr, "brine_chr", [v, loc])
                return self.temp(r, Ty.Str)

    # The address of a new 8-byte stack slot holding 0 (an out-parameter).
    fn null_slot(ref self) -> int:
        let p = self.cx.fb.temp_mem(8, 8)
        let z = self.cx.fb.konst(K.I64, 0)
        self.cx.fb.store(p, 0, z)
        return p

    fn convert(ref self, target: Ty, a: Expr, e: Expr) -> int:
        # f32(0.5) is an f32 constant, not an f64 converted at run time (Apple
        # GPUs have no f64 to convert from)
        match a.kind:
            case ExprKind.Float(x):
                match target:
                    case Ty.Float(FloatTy.F32):
                        return self.float_lit(x, target)
                    case _:
                        pass
            case _:
                pass
        let v = self.expr(a)
        match (target, a.ty):
            case (Ty.Int(k), Ty.Int(j)):
                if k == j:
                    return v
                let kk = int_kind(k)
                if widens(j, k):
                    return self.cx.fb.conv(kk, v)
                let loc = self.loc(e.span)
                let ks = k.suffix()
                if j.bits() == 128:
                    return self.cx.fb.rt(kk, f"brine_conv_{ks}_from_{j.suffix()}", [v, loc])
                if j.signed():
                    let x = self.cx.fb.conv(K.I64, v)
                    return self.cx.fb.rt(kk, f"brine_conv_{ks}_from_i64", [x, loc])
                let x = self.cx.fb.conv(K.U64, v)
                return self.cx.fb.rt(kk, f"brine_conv_{ks}_from_u64", [x, loc])
            case (Ty.Int(k), Ty.Float(_)):
                let loc = self.loc(e.span)
                let x = self.cx.fb.conv(K.F64, v)
                return self.cx.fb.rt(int_kind(k), f"brine_conv_{k.suffix()}_from_f64", [x, loc])
            case (Ty.Int(k), Ty.Bool):
                return self.cx.fb.conv(int_kind(k), v)
            case (Ty.Int(k), Ty.Str):
                let loc = self.loc(e.span)
                let kk = int_kind(k)
                match k:
                    case IntTy.I64:
                        return self.cx.fb.call(K.I64, "brine_parse_i64", [v, loc])
                    case IntTy.I128 | IntTy.U128:
                        return self.cx.fb.rt(kk, f"brine_parse_{k.suffix()}", [v, loc])
                    # through 128 bits, so all of `u64` parses
                    case _:
                        let p = self.cx.fb.rt(K.I128, "brine_parse_i128", [v, loc])
                        return self.cx.fb.rt(kk, f"brine_conv_{k.suffix()}_from_i128", [p, loc])
            case (Ty.Float(f), Ty.Str):
                let loc = self.loc(e.span)
                let p = self.cx.fb.call(K.F64, "brine_parse_f64", [v, loc])
                if f == FloatTy.F32:
                    return self.cx.fb.conv(K.F32, p)
                return p
            case (Ty.Float(f), _):
                return self.cx.fb.conv(K.F32 if f == FloatTy.F32 else K.F64, v)
            case (Ty.Str, Ty.Str):
                return v
            case (Ty.Str, _):
                let sb = self.sb_new()
                self.fmt_code(sb, v, a.ty, false)
                return self.sb_finish(sb)
            case _:
                return v

    # `brine_os_<f>(args..., &out, &err)` returning success, made into a `Result`.
    # `out` is the kind of the output, if there is one.
    fn os_with_err(ref self, f: str, out: Option[K], a: [int], e: Expr) -> int:
        let errp = self.null_slot()
        var call_args = a
        var outp = -1
        match out:
            case Some(_):
                outp = self.null_slot()
                call_args.push(outp)
            case None:
                pass
        call_args.push(errp)
        let ok = self.cx.fb.call(K.Bool, f"brine_os_{f}", call_args)
        var vty = Ty.Unit
        match try_kind(self.info, e.ty):
            case Some(TryKind.Res(_, _, okt, _)):
                vty = okt
            case _:
                pass
        var val = -1
        match out:
            case Some(k):
                val = self.cx.fb.load(k, outp, 0)
            case None:
                val = self.unit()
        let err = self.cx.fb.load(K.Ptr, errp, 0)
        return self.make_result(e.ty, ok, val, vty, err)

    # `os.f(...)`: plain runtime calls; failures come back as `Err` values.
    fn os(ref self, op: OsOp, args: [Arg], e: Expr) -> int:
        var a: [int] = []
        for x in args:
            a.push(self.expr(x.expr))
        match op:
            case OsOp.ListDir:
                return self.os_with_err("list_dir", Some(K.Ptr), a, e)
            case OsOp.FreePorts:
                return self.os_with_err("free_ports", Some(K.Ptr), a, e)
            case OsOp.AbsPath:
                return self.os_with_err("abs_path", Some(K.Ptr), a, e)
            case OsOp.Spawn:
                return self.os_with_err("spawn", Some(K.I64), a, e)
            case OsOp.MakeDir:
                return self.os_with_err("make_dir", None, a, e)
            case OsOp.RemoveFile:
                return self.os_with_err("remove_file", None, a, e)
            case OsOp.Rename:
                return self.os_with_err("rename", None, a, e)
            case OsOp.SetCwd:
                return self.os_with_err("set_cwd", None, a, e)
            case OsOp.WriteBytes:
                return self.os_with_err("write_bytes", None, a, e)
            case OsOp.ExePath:
                let r = self.cx.fb.call(K.Ptr, "brine_os_exe_path", [])
                return self.temp(r, Ty.Str)
            case OsOp.IsDir:
                return self.cx.fb.call(K.Bool, "brine_os_is_dir", [a[0]])
            case OsOp.IsFile:
                return self.cx.fb.call(K.Bool, "brine_os_is_file", [a[0]])
            case OsOp.IsTerminal:
                let fd = self.cx.fb.conv(K.I64, a[0])
                return self.cx.fb.call(K.Bool, "brine_os_is_terminal", [fd])
            case OsOp.Cwd:
                let r = self.cx.fb.call(K.Ptr, "brine_os_cwd", [])
                return self.temp(r, Ty.Str)
            case OsOp.TempDir:
                let r = self.cx.fb.call(K.Ptr, "brine_os_temp_dir", [])
                return self.temp(r, Ty.Str)
            case OsOp.Name:
                let r = self.cx.fb.call(K.Ptr, "brine_os_name", [])
                return self.temp(r, Ty.Str)
            case OsOp.Arch:
                let r = self.cx.fb.call(K.Ptr, "brine_os_arch", [])
                return self.temp(r, Ty.Str)
            case OsOp.Pid:
                return self.cx.fb.call(K.I64, "brine_os_pid", [])
            case OsOp.CpuCount:
                return self.cx.fb.call(K.I64, "brine_os_cpu_count", [])
            case OsOp.Wait:
                let loc = self.loc(e.span)
                return self.cx.fb.call(K.I64, "brine_os_wait", [a[0], loc])
            case OsOp.Sleep:
                let s = self.cx.fb.conv(K.F64, a[0])
                self.cx.fb.call_void("brine_os_sleep", [s])
                return self.unit()
            case OsOp.EnableAnsi:
                self.cx.fb.call_void("brine_os_enable_ansi", [])
                return self.unit()
            case OsOp.Kill:
                let loc = self.loc(e.span)
                self.cx.fb.call_void("brine_os_kill", [a[0], loc])
                return self.unit()
            case OsOp.Poll:
                let codep = self.null_slot()
                let loc = self.loc(e.span)
                let done = self.cx.fb.call(K.Bool, "brine_os_poll", [a[0], codep, loc])
                return self.make_option(e.ty, done, codep, int_ty())
            case OsOp.Output:
                let outp = self.null_slot()
                let ep = self.null_slot()
                let loc = self.loc(e.span)
                self.cx.fb.call_void("brine_os_output", [a[0], outp, ep, loc])
                let lay = self.lay(e.ty)
                let t = self.cx.fb.temp_mem(lay.size, lay.align)
                let o = self.cx.fb.load(K.Ptr, outp, 0)
                let er = self.cx.fb.load(K.Ptr, ep, 0)
                self.cx.fb.store(t, self.field_off(e.ty, 0), o)
                self.cx.fb.store(t, self.field_off(e.ty, 1), er)
                return self.temp(t, e.ty)

    # A value as the runtime's `world` functions take it (ints as i64, floats as f64).
    fn wval(ref self, v: int, t: Ty) -> int:
        match t:
            case Ty.Int(_):
                return self.cx.fb.conv(K.I64, v)
            case Ty.Float(_):
                return self.cx.fb.conv(K.F64, v)
            case _:
                return v

    fn wkind(self, t: Ty) -> K:
        match t:
            case Ty.Int(_):
                return K.I64
            case Ty.Float(_):
                return K.F64
            case _:
                return self.kind(t)

    fn world(ref self, op: WorldOp, args: [Arg], e: Expr) -> int:
        match op:
            case WorldOp.Rank:
                return self.cx.fb.call(K.I64, "brine_world_rank", [])
            case WorldOp.Size:
                return self.cx.fb.call(K.I64, "brine_world_size", [])
            case WorldOp.Barrier:
                self.cx.fb.call_void("brine_world_barrier", [])
                return self.unit()
            case WorldOp.Shift:
                let x0 = self.expr(args[0].expr)
                let v = self.wval(x0, e.ty)
                let by0 = self.expr(args[1].expr)
                let by = self.cx.fb.conv(K.I64, by0)
                let de = self.cstr(world_desc(e.ty))
                let loc = self.loc(e.span)
                let r = self.world_move("brine_world_shift", e.ty, de, v, by, loc)
                return self.temp(r, e.ty)
            case WorldOp.Exchange:
                let xs = self.expr(args[0].expr)
                let de = self.cstr(world_desc(e.ty.elem()))
                let loc = self.loc(e.span)
                let r = self.cx.fb.call(K.Ptr, "brine_world_exchange", [de, xs, loc])
                return self.temp(r, e.ty)
            case WorldOp.Broadcast:
                let root0 = self.expr(args[0].expr)
                let root = self.cx.fb.conv(K.I64, root0)
                let x0 = self.expr(args[1].expr)
                let v = self.wval(x0, e.ty)
                let de = self.cstr(world_desc(e.ty))
                let loc = self.loc(e.span)
                let r = self.world_move("brine_world_bcast", e.ty, de, v, root, loc)
                return self.temp(r, e.ty)
            case WorldOp.Sum | WorldOp.Min | WorldOp.Max:
                let x0 = self.expr(args[0].expr)
                let v = self.wval(x0, e.ty)
                var code = 2
                if op == WorldOp.Sum:
                    code = 0
                elif op == WorldOp.Min:
                    code = 1
                let c = self.cx.fb.konst(K.I32, code)
                let loc = self.loc(e.span)
                let r = self.cx.fb.call(
                    self.wkind(e.ty),
                    f"brine_world_reduce_{world_suffix(e.ty)}",
                    [v, c, loc]
                )
                return self.cx.fb.conv(self.kind(e.ty), r)
            case WorldOp.GatherAll:
                let t = args[0].expr.ty
                let x0 = self.expr(args[0].expr)
                let v = self.wval(x0, t)
                let de = self.cstr(world_desc(t))
                let loc = self.loc(e.span)
                let wk = self.wkind(t)
                let vp = self.cx.fb.temp_mem(wk.size(), wk.size())
                self.cx.fb.store(vp, 0, v)
                let r = self.cx.fb.call(K.Ptr, "brine_world_gather", [de, vp, loc])
                return self.temp(r, e.ty)

    # shift and broadcast pass the value and the result by pointer
    fn world_move(ref self, f: str, t: Ty, de: int, v: int, n: int, loc: int) -> int:
        let wk = self.wkind(t)
        let vp = self.cx.fb.temp_mem(wk.size(), wk.size())
        self.cx.fb.store(vp, 0, v)
        let op = self.cx.fb.temp_mem(wk.size(), wk.size())
        self.cx.fb.call_void(f, [de, vp, op, n, loc])
        let r = self.cx.fb.load(wk, op, 0)
        return self.cx.fb.conv(self.kind(t), r)

    # ============================================================ loops and comprehensions
    fn domain(ref self, iter: Expr, stmt: bool) -> Dom:
        match iter.kind:
            case ExprKind.Range(lo, hi, inclusive):
                var k = IntTy.I64
                match lo.ty:
                    case Ty.Int(x):
                        k = x
                    case _:
                        pass
                let l = self.expr(lo)
                let h = self.expr(hi)
                return Dom.Range(k, l, h, inclusive, -1)
            case ExprKind.Call(_, args):
                if iter.cres == CallRes.Range:
                    var k = IntTy.I64
                    match args[0].expr.ty:
                        case Ty.Int(x):
                            k = x
                        case _:
                            pass
                    var vals: [int] = []
                    for a in args:
                        vals.push(self.expr(a.expr))
                    if len(vals) == 1:
                        let z = self.cx.fb.konst(int_kind(k), 0)
                        return Dom.Range(k, z, vals[0], false, -1)
                    if len(vals) == 2:
                        return Dom.Range(k, vals[0], vals[1], false, -1)
                    let s = vals[2]
                    let z = self.cx.fb.konst(int_kind(k), 0)
                    let is0 = self.cx.fb.cmp(Op.Eq, s, z)
                    let ok = self.cx.fb.label()
                    self.cx.fb.brnot(is0, ok)
                    self.panic_at(iter.span, "range() step must not be zero")
                    self.cx.fb.place(ok)
                    return Dom.Range(k, vals[0], vals[1], false, s)
            case _:
                pass
        # a map loops over a snapshot of its keys, so the body may change the map
        var v = -1
        var ty = iter.ty
        if iter.ty == Ty.Str:
            let s = self.expr(iter)
            let loc = self.loc(iter.span)
            v = self.cx.fb.call(K.Ptr, "brine_s_chars", [s, loc])
            ty = Ty.Array(Ty.Str)
        else:
            match iter.ty:
                case Ty.Map(kt, _):
                    let m = self.expr(iter)
                    v = self.cx.fb.call(K.Ptr, "brine_map_keys", [m])
                    ty = Ty.Array(kt)
                case _:
                    v = self.owned(iter)
        if stmt:
            self.add_owned(v, ty)
        else:
            self.register(v, ty)
        return Dom.Arr(v, ty.elem())

    fn panic_at(ref self, span: Span, msg: str):
        let loc = self.loc(span)
        let m = self.cstr(msg)
        self.cx.fb.call_void("brine_panic_at", [loc, m])
        self.cx.fb.unreachable()

    # Start a loop over `dom` with its variable in local `var_id`; the body follows.
    fn loop_open(ref self, dom: Dom, var_id: int) -> LoopCtl:
        let fb_head = self.cx.fb.label()
        let cont = self.cx.fb.label()
        let brk = self.cx.fb.label()
        match dom:
            case Dom.Range(ty, lo, hi, incl, step):
                let kk = int_kind(ty)
                let home = self.new_local(var_id, Ty.Int(ty))
                let i = self.cx.fb.copy_of(lo)
                var pos = -1
                if step >= 0:
                    let z = self.cx.fb.konst(kk, 0)
                    pos = self.cx.fb.cmp(Op.Gt, step, z)
                    let lt = self.cx.fb.cmp(Op.Lt, lo, hi)
                    let gt = self.cx.fb.cmp(Op.Gt, lo, hi)
                    let g = self.select_bool(pos, lt, gt)
                    self.cx.fb.brnot(g, brk)
                elif incl:
                    let le = self.cx.fb.cmp(Op.Le, lo, hi)
                    self.cx.fb.brnot(le, brk)
                self.cx.fb.place(fb_head)
                if step < 0 and not incl:
                    let lt = self.cx.fb.cmp(Op.Lt, i, hi)
                    self.cx.fb.brnot(lt, brk)
                self.cx.fb.store(home, 0, i)
                return LoopCtl(head=fb_head, cont=cont, brk=brk, i=i, pos=pos)
            case Dom.Arr(arr, elem):
                let home = self.new_local(var_id, elem)
                let k = self.cx.fb.konst(K.I64, 0)
                self.cx.fb.place(fb_head)
                let n = self.cx.fb.load(K.I64, arr, 8)
                let more = self.cx.fb.cmp(Op.Lt, k, n)
                self.cx.fb.brnot(more, brk)
                let data = self.cx.fb.load(K.Ptr, arr, 48)
                let p = self.cx.fb.elem(data, k, self.lay(elem).size)
                let x = self.ld(p, 0, elem)
                self.st(home, 0, elem, x)
                return LoopCtl(head=fb_head, cont=cont, brk=brk, i=k, pos=-1)

    # pos ? a : b, for booleans
    fn select_bool(ref self, c: int, a: int, b: int) -> int:
        let x = self.cx.fb.bin(Op.And, K.Bool, c, a)
        let nc = self.cx.fb.un(Op.Not, K.Bool, c)
        let y = self.cx.fb.bin(Op.And, K.Bool, nc, b)
        return self.cx.fb.bin(Op.Or, K.Bool, x, y)

    fn loop_close(ref self, dom: Dom, lc: LoopCtl):
        if not self.cx.fb.ends():
            self.cx.fb.jmp(lc.cont)
        self.cx.fb.place(lc.cont)
        match dom:
            case Dom.Range(ty, _, hi, incl, step):
                let kk = int_kind(ty)
                if step >= 0:
                    # stop before stepping past `hi` (in u64, so nothing overflows)
                    let hu = self.cx.fb.conv(K.U64, hi)
                    let iu = self.cx.fb.conv(K.U64, lc.i)
                    let su = self.cx.fb.conv(K.U64, step)
                    let d1 = self.cx.fb.bin(Op.Sub, K.U64, hu, iu)
                    let g1 = self.cx.fb.cmp(Op.Gt, d1, su)
                    let d2 = self.cx.fb.bin(Op.Sub, K.U64, iu, hu)
                    let ns = self.cx.fb.un(Op.Neg, K.U64, su)
                    let g2 = self.cx.fb.cmp(Op.Gt, d2, ns)
                    let g = self.select_bool(lc.pos, g1, g2)
                    self.cx.fb.brnot(g, lc.brk)
                    let i2 = self.cx.fb.bin(Op.Add, kk, lc.i, step)
                    self.cx.fb.mov(lc.i, i2)
                else:
                    if incl:
                        let last = self.cx.fb.cmp(Op.Eq, lc.i, hi)
                        self.cx.fb.br(last, lc.brk)
                    let one = self.cx.fb.konst(kk, 1)
                    let i2 = self.cx.fb.bin(Op.Add, kk, lc.i, one)
                    self.cx.fb.mov(lc.i, i2)
            case Dom.Arr(_, _):
                let one = self.cx.fb.konst(K.I64, 1)
                let k2 = self.cx.fb.bin(Op.Add, K.I64, lc.i, one)
                self.cx.fb.mov(lc.i, k2)
        self.cx.fb.jmp(lc.head)
        self.cx.fb.place(lc.brk)

    # The number of iterations (I64).
    fn dom_count(ref self, dom: Dom, span: Span) -> int:
        match dom:
            case Dom.Range(_, lo, hi, incl, step):
                let u = self.cx.fb.konst(K.U64, 0)
                let hu = self.cx.fb.conv(K.U64, hi)
                let lu = self.cx.fb.conv(K.U64, lo)
                let one = self.cx.fb.konst(K.U64, 1)
                let done = self.cx.fb.label()
                if step < 0:
                    let c = self.cx.fb.cmp(Op.Le if incl else Op.Lt, lo, hi)
                    self.cx.fb.brnot(c, done)
                    let d = self.cx.fb.bin(Op.Sub, K.U64, hu, lu)
                    if incl:
                        let d1 = self.cx.fb.bin(Op.Add, K.U64, d, one)
                        self.cx.fb.mov(u, d1)
                        let zero = self.cx.fb.konst(K.U64, 0)
                        let wrapped = self.cx.fb.cmp(Op.Eq, u, zero)
                        let ok = self.cx.fb.label()
                        self.cx.fb.brnot(wrapped, ok)
                        self.panic_at(span, "range has too many elements")
                        self.cx.fb.place(ok)
                    else:
                        self.cx.fb.mov(u, d)
                else:
                    let z = self.cx.fb.konst(self.cx.fb.f.vk[step], 0)
                    let pos = self.cx.fb.cmp(Op.Gt, step, z)
                    let su = self.cx.fb.conv(K.U64, step)
                    let neg = self.cx.fb.label()
                    self.cx.fb.brnot(pos, neg)
                    let lt = self.cx.fb.cmp(Op.Lt, lo, hi)
                    self.cx.fb.brnot(lt, done)
                    let d = self.cx.fb.bin(Op.Sub, K.U64, hu, lu)
                    let d1 = self.cx.fb.bin(Op.Sub, K.U64, d, one)
                    let q = self.cx.fb.bin(Op.Div, K.U64, d1, su)
                    let q1 = self.cx.fb.bin(Op.Add, K.U64, q, one)
                    self.cx.fb.mov(u, q1)
                    self.cx.fb.jmp(done)
                    self.cx.fb.place(neg)
                    let gt = self.cx.fb.cmp(Op.Gt, lo, hi)
                    self.cx.fb.brnot(gt, done)
                    let e1 = self.cx.fb.bin(Op.Sub, K.U64, lu, hu)
                    let e2 = self.cx.fb.bin(Op.Sub, K.U64, e1, one)
                    let ns = self.cx.fb.un(Op.Neg, K.U64, su)
                    let r = self.cx.fb.bin(Op.Div, K.U64, e2, ns)
                    let r1 = self.cx.fb.bin(Op.Add, K.U64, r, one)
                    self.cx.fb.mov(u, r1)
                self.cx.fb.place(done)
                let max: u64 = 9223372036854775807
                let mx = self.cx.fb.konst(K.U64, int(max))
                let big = self.cx.fb.cmp(Op.Gt, u, mx)
                let fine = self.cx.fb.label()
                self.cx.fb.brnot(big, fine)
                self.panic_at(span, "range has too many elements")
                self.cx.fb.place(fine)
                return self.cx.fb.conv(K.I64, u)
            case Dom.Arr(arr, _):
                return self.cx.fb.load(K.I64, arr, 8)

    # `if not filter: continue`
    fn emit_filter(ref self, f: Expr, cont: int):
        self.push_frame()
        let v = self.expr(f)
        self.pop_frame()
        self.cx.fb.brnot(v, cont)

    fn seq_list(ref self, c: Comp, e: Expr) -> int:
        var el = c.body.ty
        let bytes = self.cx.narrow_init
        self.cx.narrow_init = false
        if bytes:
            el = Ty.Int(IntTy.U8)
        let loc = self.loc(e.span)
        let dom = self.domain(c.iter, false)
        match c.filter:
            case None:
                let n = self.dom_count(dom, e.span)
                var res = -1
                if bytes:
                    let n64 = self.cx.fb.conv(K.I64, n)
                    res = self.cx.fb.call(K.Ptr, "brine_bytes_new", [n64, loc])
                else:
                    res = self.new_arr(el, n, loc)
                self.register(res, e.ty)
                let data = self.cx.fb.load(K.Ptr, res, 48)
                let k = self.cx.fb.konst(K.I64, 0)
                let one = self.cx.fb.konst(K.I64, 1)
                let lc = self.loop_open(dom, e.local)
                self.push_frame()
                var v = self.owned(c.body)
                if bytes:
                    v = self.cx.fb.conv(K.U8, v)
                let p = self.cx.fb.elem(data, k, self.lay(el).size)
                self.st(p, 0, el, v)
                let k2 = self.cx.fb.bin(Op.Add, K.I64, k, one)
                self.cx.fb.mov(k, k2)
                self.pop_frame()
                self.loop_close(dom, lc)
                return res
            case Some(flt):
                let zero = self.cx.fb.konst(K.I64, 0)
                let res = self.new_arr(el, zero, loc)
                self.register(res, e.ty)
                let home = self.addr_of(res, e.ty)
                let lc = self.loop_open(dom, e.local)
                self.emit_filter(flt, lc.cont)
                self.push_frame()
                let v = self.owned(c.body)
                let tp = self.addr_of(v, el)
                self.cx.fb.call_void("brine_arr_push", [home, tp])
                self.cx.fb.load_to(res, home, 0)
                self.pop_frame()
                self.loop_close(dom, lc)
                return res

    fn reduce(ref self, r: Reducer, arg: Expr, e: Expr) -> int:
        match arg.kind:
            case ExprKind.Comp(c):
                if c.par:
                    return self.par_reduce(r, c, e, arg.local, arg.caps)
                let (acc, has) = self.reduce_init(r, e.ty)
                let dom = self.domain(c.iter, false)
                let lc = self.loop_open(dom, arg.local)
                self.reduce_step(r, c, e.ty, acc, has, e.span, lc)
                self.loop_close(dom, lc)
                self.reduce_finish(r, has, e.span)
                return acc
            case _:
                return self.cx.fb.konst(K.I64, 0)

    fn reduce_init(ref self, r: Reducer, ty: Ty) -> (int, int):
        let k = self.kind(ty)
        var acc = -1
        match r:
            case Reducer.Sum | Reducer.Min | Reducer.Max:
                acc = self.zero_of(k, 0)
            case Reducer.Product:
                acc = self.zero_of(k, 1)
            case Reducer.Any:
                acc = self.cx.fb.konst(K.Bool, 0)
            case Reducer.All:
                acc = self.cx.fb.konst(K.Bool, 1)
        let has = self.cx.fb.konst(K.Bool, 0)
        return (acc, has)

    # A new vreg of kind `k` holding the number `n`.
    fn zero_of(ref self, k: K, n: int) -> int:
        if k == K.F64:
            return self.cx.fb.fconst(k, f64_bits(float(n)))
        if k == K.F32:
            return self.cx.fb.fconst(k, f32_bits(float(n)))
        if k == K.I128 or k == K.U128:
            return self.cx.fb.konst128(k, i128(n))
        return self.cx.fb.konst(k, n)

    fn reduce_step(
        ref self,
        r: Reducer,
        c: Comp,
        ty: Ty,
        acc: int,
        has: int,
        span: Span,
        lc: LoopCtl
    ):
        match c.filter:
            case Some(f):
                self.emit_filter(f, lc.cont)
            case None:
                pass
        self.push_frame()
        let v = self.expr(c.body)
        self.pop_frame()
        self.reduce_into(r, ty, acc, has, v, span, lc.brk)
        let t = self.cx.fb.konst(K.Bool, 1)
        self.cx.fb.mov(has, t)

    # Combine `v` into the accumulator. `brk` (or -1) ends the loop early for any/all.
    fn reduce_into(ref self, r: Reducer, ty: Ty, acc: int, has: int, v: int, span: Span, brk: int):
        match r:
            case Reducer.Sum:
                let s = self.arith(BinOp.Add, acc, v, ty, true, span)
                self.cx.fb.mov(acc, s)
            case Reducer.Product:
                let s = self.arith(BinOp.Mul, acc, v, ty, true, span)
                self.cx.fb.mov(acc, s)
            case Reducer.Min | Reducer.Max:
                let better = self.cx.fb.cmp(Op.Lt if r == Reducer.Min else Op.Gt, v, acc)
                let first = self.cx.fb.un(Op.Not, K.Bool, has)
                let take = self.cx.fb.bin(Op.Or, K.Bool, first, better)
                let skip = self.cx.fb.label()
                self.cx.fb.brnot(take, skip)
                self.cx.fb.mov(acc, v)
                self.cx.fb.place(skip)
            case Reducer.Any | Reducer.All:
                let is_any = r == Reducer.Any
                if brk < 0:
                    let x = self.cx.fb.bin(Op.Or if is_any else Op.And, K.Bool, acc, v)
                    self.cx.fb.mov(acc, x)
                    return
                let skip = self.cx.fb.label()
                if is_any:
                    self.cx.fb.brnot(v, skip)
                else:
                    self.cx.fb.br(v, skip)
                let x = self.cx.fb.konst(K.Bool, 1 if is_any else 0)
                self.cx.fb.mov(acc, x)
                let t = self.cx.fb.konst(K.Bool, 1)
                self.cx.fb.mov(has, t)
                self.cx.fb.jmp(brk)
                self.cx.fb.place(skip)

    fn reduce_finish(ref self, r: Reducer, has: int, span: Span):
        if r == Reducer.Min or r == Reducer.Max:
            let n = "min" if r == Reducer.Min else "max"
            let ok = self.cx.fb.label()
            self.cx.fb.br(has, ok)
            self.panic_at(span, f"{n}() of an empty sequence")
            self.cx.fb.place(ok)

    # ------------------------------------------------------------ parallel
    # The context fields that carry the domain into a lifted body.
    fn dom_fields(ref self, dom: Dom) -> [(str, Ty, int)]:
        match dom:
            case Dom.Range(_, lo, _, _, step):
                let dlo = self.cx.fb.conv(K.U64, lo)
                var dst = -1
                if step >= 0:
                    dst = self.cx.fb.conv(K.U64, step)
                else:
                    dst = self.cx.fb.konst(K.U64, 1)
                let u = Ty.Int(IntTy.U64)
                return [("dlo", u, dlo), ("dst", u, dst)]
            case Dom.Arr(arr, _):
                return [("darr", Ty.Str, arr)]

    # Inside a lifted body: the value of the domain's element `k`.
    fn dom_value(ref self, dom: Dom, pc: ParCtx, k: int) -> int:
        match dom:
            case Dom.Range(ty, _, _, _, _):
                let dlo = self.cx.fb.load(K.U64, 0, pc.off("dlo"))
                let dst = self.cx.fb.load(K.U64, 0, pc.off("dst"))
                let ku = self.cx.fb.conv(K.U64, k)
                let m = self.cx.fb.bin(Op.Mul, K.U64, ku, dst)
                let s = self.cx.fb.bin(Op.Add, K.U64, dlo, m)
                return self.cx.fb.conv(int_kind(ty), s)
            case Dom.Arr(_, elem):
                let arr = self.cx.fb.load(K.Ptr, 0, pc.off("darr"))
                let data = self.cx.fb.load(K.Ptr, arr, 48)
                let p = self.cx.fb.elem(data, k, self.lay(elem).size)
                return self.ld(p, 0, elem)

    # The context of a lifted parallel body, filled in on the stack. Captured
    # locals are copied by value: par bodies never assign them. `extra` fields
    # with a value of -1 are left for the body to fill.
    fn par_ctx(ref self, captures: [int], extra: [(str, Ty, int)]) -> ParCtx:
        # numbered within the enclosing function, so names don't shift when other code changes
        let host = self.cx.fb.f.name
        let k = self.nlifts.get(host).unwrap_or(0)
        self.nlifts[host] = k + 1
        let id = f"{host}_{k}"
        var names: [str] = []
        var tys: [Ty] = []
        for c in captures:
            names.push(f"c{c}")
            tys.push(self.flocals[c].ty)
        for x in extra:
            names.push(x.0)
            tys.push(x.1)
        let (lay, offs) = self.struct_lay(tys)
        let ctx = self.cx.fb.temp_mem(lay.size, lay.align)
        for i, c in enumerate(captures):
            let v = self.read_local(c)
            self.st(ctx, offs[i], tys[i], v)
        let nc = len(captures)
        for j, x in enumerate(extra):
            if x.2 >= 0:
                self.st(ctx, offs[nc + j], x.1, x.2)
        return ParCtx(id=id, ctx=ctx, names=names, offs=offs, tys=tys, size=lay.size)

    # Start lifted function `name` (its parameter 0 is the context); captured
    # locals are read from the context.
    fn lift_enter(
        ref self,
        name: str,
        params: [K],
        pc: ParCtx,
        captures: [int],
        par_writes: [int]
    ) -> FnCx:
        let saved = self.cx
        self.cx = new_cx(new_func(name, params, false, K.I64))
        self.cx.lifted = true
        for w in par_writes:
            self.cx.par_writes[w] = true
        for c in captures:
            self.cx.lptr[c] = self.cx.fb.offset(0, pc.off(f"c{c}"))
            if self.opts.debug:
                self.dbg_ptr_var(c, self.cx.lptr[c], false)
        return saved

    fn lift_exit(ref self, saved: FnCx):
        if not self.cx.fb.ends():
            self.cx.fb.ret(-1)
        self.funcs.push(self.cx.fb.f)
        self.cx = saved

    # Run `br_par_<id>` over n iterations: on a GPU when it can and that pays,
    # otherwise on the thread pool.
    fn par_launch(ref self, pc: ParCtx, kind: int, n: int, real: [(str, Ty, int)], span: Span):
        let kd = self.gpu_site(pc, kind, 0, K.I64, real, span)
        let fp = self.cx.fb.global(f"br_par_{pc.id}")
        self.cx.fb.call_void("brine_par_for", [kd, pc.ctx, n, fp])

    # The real types of the context fields `dom_fields` adds (an array is
    # stored there as a plain pointer).
    fn dom_tys(self, dom: Dom) -> [(str, Ty, int)]:
        match dom:
            case Dom.Arr(_, elem):
                return [("darr", Ty.Array(elem), 0)]
            case _:
                return []

    # The descriptor `br_gk_<id>` of a parallel construct, for the runtime to
    # run it on a GPU (`gpu_emit` fills it in). `real` overrides context field
    # types, with flags: 1 written by the body, 2 only written (not read).
    fn gpu_site(
        ref self,
        pc: ParCtx,
        kind: int,
        op: int,
        vk: K,
        real: [(str, Ty, int)],
        span: Span
    ) -> int:
        let ptrs = self.gpu_ptrs(pc, real)
        let wh = self.cstr_sym(self.sm.loc(span))
        self.gsites.push(
            GpuSite(id=pc.id, kind=kind, op=op, vk=vk, where_sym=wh, ctx_size=pc.size, ptrs=ptrs)
        )
        return self.cx.fb.global(f"br_gk_{pc.id}")

    # Where the arrays in a context are, for the runtime to copy them to the
    # device: [nfields, (offset, flags, node)*, nodes...]. A node describes an
    # array: [element size, n, (offset in the element, node)*] for the arrays
    # inside each element; nodes are numbered from the first node's position.
    # Empty: something in the context can't be copied (strings, maps, boxes).
    fn gpu_ptrs(self, pc: ParCtx, real: [(str, Ty, int)]) -> [int]:
        var fields: [int] = []
        var nodes: [int] = []
        var nf = 0
        for i, name in enumerate(pc.names):
            var ty = pc.tys[i]
            var flags = 0
            for x in real:
                if x.0 == name:
                    ty = x.1
                    flags = x.2
            var subs: [(int, Ty)] = []
            if not self.gpu_plain(ty, pc.offs[i], ref subs):
                return []
            for sub in subs:
                let node = self.gpu_node(sub.1, ref nodes, 0)
                if node < 0:
                    return []
                let top = sub.0 == pc.offs[i]
                # arrays written on the device are copied back: no pointers in them
                if flags != 0 and (not top or nodes[node + 1] != 0):
                    return []
                fields.push(sub.0)
                fields.push(flags if top else 0)
                fields.push(node)
                nf += 1
        var out = [nf]
        out.extend(fields)
        out.extend(nodes)
        return out

    fn gpu_node(self, elem: Ty, ref nodes: [int], depth: int) -> int:
        var subs: [(int, Ty)] = []
        if depth > 8 or not self.gpu_plain(elem, 0, ref subs):
            return -1
        let at = len(nodes)
        nodes.push(self.lay(elem).size)
        nodes.push(len(subs))
        for _ in subs:
            nodes.push(0)
            nodes.push(0)
        for j, sub in enumerate(subs):
            let child = self.gpu_node(sub.1, ref nodes, depth + 1)
            if child < 0:
                return -1
            nodes[at + 2 + 2 * j] = sub.0
            nodes[at + 3 + 2 * j] = child
        return at

    # Is a value of type t plain data and arrays of it? `subs` gets the
    # offsets (from `base`) and element types of the arrays in it.
    fn gpu_plain(self, t: Ty, base: int, ref subs: [(int, Ty)]) -> bool:
        match t:
            case Ty.Int(_) | Ty.Float(_) | Ty.Bool | Ty.Unit:
                return true
            case Ty.Enum(eid):
                return not self.info.enums[eid].has_payload()
            case Ty.Array(e):
                subs.push((base, e))
                return true
            case Ty.Tuple(_) | Ty.Struct(_):
                for i, x in enumerate(self.field_tys(t)):
                    if not self.gpu_plain(x, base + self.field_off(t, i), ref subs):
                        return false
                return true
            case _:
                return false

    # The GPU code of the program's parallel constructs, and their descriptors
    # (`brine_kernel` in brine_rt.h).
    fn gpu_emit(ref self):
        if len(self.gsites) == 0:
            return
        var ks: [ptx.KReq] = []
        for g in self.gsites:
            ks.push(
                ptx.KReq(fname=f"br_par_{g.id}", entry=f"brk_{g.id}", kind=g.kind, op=g.op, vk=g.vk)
            )
        # Metal source on macOS, PTX elsewhere
        var code = ptx.GpuCode(ptx="", ok=[], why=[], cost=[], cost64=[])
        if not self.opts.gpu:
            let n = len(ks)
            code = ptx.GpuCode(
                ptx="",
                ok=[false] * n,
                why=["WebAssembly has no GPU"] * n,
                cost=[0] * n,
                cost64=[0] * n
            )
        elif os.name() == "macos":
            code = msl.build(self.funcs, ks)
        else:
            code = ptx.build(self.funcs, ks)
        if code.ptx != "":
            var b: [u8] = []
            str_bytes(ref b, code.ptx)
            b.push(u8(0))
            self.data.push(Data(name="br_gpu_ptx", align=8, bytes=b, relocs=[], readonly=true))
            match getenv("BRINE_DUMP_PTX"):
                case Some(path):
                    match write_file(path, code.ptx):
                        case Ok(_):
                            pass
                        case Err(_):
                            pass
                case None:
                    pass
        for i, g in enumerate(self.gsites):
            let ok = code.ok[i] and len(g.ptrs) > 0
            var rel: [Reloc] = []
            if ok:
                rel.push(Reloc(off=0, sym="br_gpu_ptx", add=0))
                rel.push(Reloc(off=8, sym=self.cstr_sym(f"brk_{g.id}"), add=0))
                if g.kind == 2:
                    rel.push(Reloc(off=80, sym=self.cstr_sym(ptx.comb_name(g.op, g.vk)), add=0))
            rel.push(Reloc(off=16, sym=g.where_sym, add=0))
            if not ok:
                var w = code.why[i]
                if len(g.ptrs) == 0:
                    w = "its context holds strings, maps or enums with payloads"
                rel.push(Reloc(off=96, sym=self.cstr_sym(w), add=0))
            if len(g.ptrs) > 0:
                var pb: [u8] = []
                for x in g.ptrs:
                    le_bytes(ref pb, x, 8)
                let pn = f"br_gp_{g.id}"
                self.data.push(Data(name=pn, align=8, bytes=pb, relocs=[], readonly=true))
                rel.push(Reloc(off=56, sym=pn, add=0))
            var b: [u8] = []
            let vals = [
                0,
                0,
                0,
                g.kind,
                g.op,
                kind_code(g.vk),
                g.ctx_size,
                0,
                code.cost[i],
                code.cost64[i],
                0,
                0,
                0
            ]
            for v in vals:
                le_bytes(ref b, v, 8)
            self.data.push(Data(name=f"br_gk_{g.id}", align=8, bytes=b, relocs=rel, readonly=false))

    # In a chunk function: `for k in lo..hi`, with the loop variable `local` set.
    fn chunk_open(ref self, dom: Dom, pc: ParCtx, local: int) -> LoopCtl:
        let head = self.cx.fb.label()
        let cont = self.cx.fb.label()
        let brk = self.cx.fb.label()
        let ty = self.flocals[local].ty
        let home = self.new_local(local, ty)
        let k = self.cx.fb.copy_of(2)
        self.cx.fb.place(head)
        let more = self.cx.fb.cmp(Op.Lt, k, 3)
        self.cx.fb.brnot(more, brk)
        let v = self.dom_value(dom, pc, k)
        self.st(home, 0, ty, v)
        return LoopCtl(head=head, cont=cont, brk=brk, i=k, pos=-1)

    fn chunk_close(ref self, lc: LoopCtl):
        if not self.cx.fb.ends():
            self.cx.fb.jmp(lc.cont)
        self.cx.fb.place(lc.cont)
        let one = self.cx.fb.konst(K.I64, 1)
        let k2 = self.cx.fb.bin(Op.Add, K.I64, lc.i, one)
        self.cx.fb.mov(lc.i, k2)
        self.cx.fb.jmp(lc.head)
        self.cx.fb.place(lc.brk)

    fn par_for(
        ref self,
        iter: Expr,
        local: int,
        captures: [int],
        par_writes: [int],
        body: Block,
        span: Span
    ):
        self.push_scope()
        self.push_frame()
        let dom = self.domain(iter, true)
        self.pop_frame()
        let n = self.dom_count(dom, span)
        for w in par_writes:
            let lp = self.local_ptr(w)
            self.cx.fb.call_void("brine_arr_unique", [lp])
        let extra = self.dom_fields(dom)
        let pc = self.par_ctx(captures, extra)
        var real = self.dom_tys(dom)
        for w in par_writes:
            real.push((f"c{w}", self.flocals[w].ty, 1))
        self.par_launch(pc, 0, n, real, span)
        self.pop_scope()

        let saved = self.lift_enter(
            f"br_par_{pc.id}",
            [K.Ptr, K.I64, K.I64, K.I64],
            pc,
            captures,
            par_writes
        )
        let lc = self.chunk_open(dom, pc, local)
        self.cx.loops.push(Loop(depth=len(self.cx.scopes), brk=lc.brk, cont=lc.cont))
        self.block(body)
        self.cx.loops.pop()
        self.chunk_close(lc)
        self.lift_exit(saved)

    fn par_list(ref self, c: Comp, e: Expr) -> int:
        let loc = self.loc(e.span)
        let dom = self.domain(c.iter, false)
        let n = self.dom_count(dom, e.span)
        let el = c.body.ty
        let res = self.new_arr(el, n, loc)
        self.register(res, e.ty)
        var extra = self.dom_fields(dom)
        extra.push(("res", Ty.Str, res))
        let pc = self.par_ctx(e.caps, extra)
        var real = self.dom_tys(dom)
        real.push(("res", e.ty, 3))
        self.par_launch(pc, 1, n, real, e.span)

        let saved = self.lift_enter(f"br_par_{pc.id}", [K.Ptr, K.I64, K.I64, K.I64], pc, e.caps, [])
        let lc = self.chunk_open(dom, pc, e.local)
        self.push_frame()
        let v = self.owned(c.body)
        let r = self.cx.fb.load(K.Ptr, 0, pc.off("res"))
        let data = self.cx.fb.load(K.Ptr, r, 48)
        let p = self.cx.fb.elem(data, lc.i, self.lay(el).size)
        self.st(p, 0, el, v)
        self.pop_frame()
        self.chunk_close(lc)
        self.lift_exit(saved)
        return res

    # `local` and `captures` are the comprehension's loop variable and captured
    # locals. The runtime splits the elements into leaves and combines the
    # leaves' results in a fixed tree (`brine_par_reduce`); the lifted function
    # folds one leaf.
    fn par_reduce(ref self, r: Reducer, c: Comp, e: Expr, local: int, captures: [int]) -> int:
        let ty = e.ty
        let lay = self.lay(ty)
        let dom = self.domain(c.iter, false)
        let n = self.dom_count(dom, e.span)
        let (acc, has) = self.reduce_init(r, ty)
        let accp = self.cx.fb.temp_mem(lay.size, lay.align)
        self.cx.fb.store(accp, 0, acc)
        let hasp = self.cx.fb.temp_mem(1, 1)
        self.cx.fb.store(hasp, 0, has)
        let extra = self.dom_fields(dom)
        let pc = self.par_ctx(captures, extra)
        let fp = self.cx.fb.global(f"br_par_{pc.id}")
        let kd = self.gpu_site(pc, 2, reducer_code(r), self.kind(ty), self.dom_tys(dom), e.span)
        let loc = self.loc(e.span)
        self.cx.fb.call_void("brine_par_reduce", [kd, n, fp, pc.ctx, accp, hasp, loc])
        self.cx.fb.load_to(acc, accp, 0)
        self.cx.fb.load_to(has, hasp, 0)
        self.reduce_finish(r, has, e.span)

        let saved = self.lift_enter(
            f"br_par_{pc.id}",
            [K.Ptr, K.I64, K.I64, K.I64, K.Ptr, K.Ptr],
            pc,
            captures,
            []
        )
        let (a2, h2) = self.reduce_init(r, ty)
        let lc = self.chunk_open(dom, pc, local)
        self.reduce_step(r, c, ty, a2, h2, e.span, lc)
        self.chunk_close(lc)
        self.cx.fb.store(4, 0, a2)
        self.cx.fb.store(5, 0, h2)
        self.lift_exit(saved)
        return acc

    fn par_tuple(ref self, elems: [Expr], captures: [int], e: Expr) -> int:
        var extra: [(str, Ty, int)] = []
        for i, x in enumerate(elems):
            extra.push((f"r{i}", x.ty, -1))
        let pc = self.par_ctx(captures, extra)
        let k = self.cx.fb.konst(K.I64, len(elems))
        let fp = self.cx.fb.global(f"br_task_{pc.id}")
        self.cx.fb.call_void("brine_par_tasks", [k, fp, pc.ctx])
        let lay = self.lay(e.ty)
        let res = self.cx.fb.temp_mem(lay.size, lay.align)
        for i, x in enumerate(elems):
            let v = self.ld(pc.ctx, pc.off(f"r{i}"), x.ty)
            self.st(res, self.field_off(e.ty, i), x.ty, v)
        self.register(res, e.ty)

        let saved = self.lift_enter(f"br_task_{pc.id}", [K.Ptr, K.I64], pc, captures, [])
        for i, x in enumerate(elems):
            let next = self.cx.fb.label()
            let iv = self.cx.fb.konst(K.I64, i)
            let hit = self.cx.fb.cmp(Op.Eq, 1, iv)
            self.cx.fb.brnot(hit, next)
            self.push_scope()
            self.push_frame()
            let v = self.owned(x)
            self.st(0, pc.off(f"r{i}"), x.ty, v)
            self.pop_frame()
            self.pop_scope()
            self.cx.fb.ret(-1)
            self.cx.fb.place(next)
        self.lift_exit(saved)
        return res

struct LoopCtl:
    head: int
    cont: int
    brk: int
    # the counter: the loop variable (ranges) or the index (arrays)
    i: int
    # for stepped ranges: is the step positive
    pos: int

# A parallel construct that may run on a GPU. kind 0: `par for`, 1: a map,
# 2: a reduction with reducer `op` over values of kind `vk`.
struct GpuSite:
    id: str
    kind: int
    op: int
    vk: K
    where_sym: str
    ctx_size: int
    ptrs: [int]

# A lifted parallel body's context: its fields' names and offsets.
struct ParCtx:
    id: str
    ctx: int
    names: [str]
    offs: [int]
    tys: [Ty]
    size: int

    fn off(self, name: str) -> int:
        for i, n in enumerate(self.names):
            if n == name:
                return self.offs[i]
        panic(f"lowering: no context field {name}")
        return 0

# The runtime's numbers for reducers and value kinds (BRINE_RED_*, BRINE_VK_* in brine_rt.h).
fn reducer_code(r: Reducer) -> int:
    match r:
        case Reducer.Sum:
            return 0
        case Reducer.Product:
            return 1
        case Reducer.Min:
            return 2
        case Reducer.Max:
            return 3
        case Reducer.Any:
            return 4
        case Reducer.All:
            return 5

fn kind_code(k: K) -> int:
    match k:
        case K.I8:
            return 0
        case K.I16:
            return 1
        case K.I32:
            return 2
        case K.I64:
            return 3
        case K.I128:
            return 4
        case K.U8:
            return 5
        case K.U16:
            return 6
        case K.U32:
            return 7
        case K.U64:
            return 8
        case K.U128:
            return 9
        case K.F32:
            return 10
        case K.F64:
            return 11
        case K.Ptr:
            return 12
        case K.Bool:
            return 13

fn cmp_op(op: CmpOp) -> Op:
    match op:
        case CmpOp.Eq:
            return Op.Eq
        case CmpOp.Ne:
            return Op.Ne
        case CmpOp.Lt:
            return Op.Lt
        case CmpOp.Le:
            return Op.Le
        case CmpOp.Gt:
            return Op.Gt
        case CmpOp.Ge:
            return Op.Ge

fn widens(from: IntTy, to: IntTy) -> bool:
    return to.min() <= from.min() and from.umax() <= to.umax()

# The enum id of an enum type (0 for anything else).
fn cg_enum_id(t: Ty) -> int:
    match t:
        case Ty.Enum(x):
            return x
        case _:
            return 0

# Suffix of the runtime's `world` functions for values of type `t`.
fn world_suffix(t: Ty) -> str:
    match t:
        case Ty.Int(_):
            return "i64"
        case Ty.Float(_):
            return "f64"
        case Ty.Bool:
            return "bool"
        case Ty.Str:
            return "str"
        case _:
            return "arr"

# The message type description the runtime's encoder understands.
fn world_desc(t: Ty) -> str:
    match t:
        case Ty.Int(_):
            return "i"
        case Ty.Float(_):
            return "f"
        case Ty.Bool:
            return "b"
        case Ty.Str:
            return "s"
        case Ty.Array(e):
            return "a" + world_desc(e)
        case _:
            return "?"

# How a loop uses its local arrays: `seen` indexed, `written` changed through
# an index (assigned, a receiver, a `ref` argument), `bad` used any other way (copied, passed, reassigned, iterated).
struct IndexUse:
    info: ProgramInfo
    seen: {int: bool}
    written: {int: bool}
    bad: {int: bool}
    # declared inside the loop: not there yet when it starts
    decl: {int: bool}

    fn expr(ref self, e: Expr):
        match e.kind:
            case ExprKind.Index(base, idx):
                match local_of(base):
                    case Some(l):
                        self.seen[l] = true
                        self.expr(idx)
                        return
                    case None:
                        pass
            case ExprKind.MethodCall(recv, _, _, args):
                # a receiver or `ref` argument may be changed in place
                var recv_mut = true
                match e.cres:
                    case CallRes.Builtin(b):
                        recv_mut = b.mutates_recv()
                    case CallRes.Method(id):
                        let ps = self.info.fns[id].params
                        recv_mut = len(ps) == 0 or ps[0].by_ref
                    case _:
                        pass
                if recv_mut:
                    self.target(recv)
                for a in args:
                    if a.by_ref:
                        self.target(a.expr)
            case ExprKind.Call(_, args):
                for a in args:
                    if a.by_ref:
                        self.target(a.expr)
                match e.cres:
                    case CallRes.Builtin(b):
                        match b:
                            case Builtin.Len:
                                if len(args) == 1 and local_of(args[0].expr).is_some():
                                    return
                            case _:
                                pass
                    case _:
                        pass
            case ExprKind.Ident(_):
                match local_of(e):
                    case Some(l):
                        self.bad[l] = true
                    case None:
                        pass
                return
            case _:
                pass
        for c in children(e):
            self.expr(c)

    fn block(ref self, b: Block):
        for s in b.stmts:
            match s.kind:
                case StmtKind.Assign(t, _, _):
                    self.target(t)
                case StmtKind.Let(_, _, _, init, is_ref):
                    for l in s.locals:
                        self.decl[l] = true
                    if is_ref:
                        self.target(init)
                case StmtKind.For(_, _, _, _, _, _, _):
                    self.decl[s.local] = true
                case StmtKind.Match(_, cases):
                    for c in cases:
                        self.pat(c.pat)
                case _:
                    pass
            for e in stmt_exprs(s):
                self.expr(e)
            for blk in stmt_blocks(s):
                self.block(blk)

    fn pat(ref self, p: Pattern):
        match p.kind:
            case PatKind.Bind(_):
                self.decl[p.local] = true
            case PatKind.Tuple(ps):
                for q in ps:
                    self.pat(q)
            case PatKind.Or(ps):
                for q in ps:
                    self.pat(q)
            case _:
                pass
        for q in p.fields:
            self.pat(q)

    # `a[i] = v`, `a[i].f = v`, `a[i][j] = v`: the array at the root is written
    fn target(ref self, t: Expr):
        match t.kind:
            case ExprKind.Index(base, _):
                match local_of(base):
                    case Some(l):
                        self.written[l] = true
                    case None:
                        self.target(base)
            case ExprKind.Field(base, _, _):
                self.target(base)
            case _:
                pass

fn dbase(name: str, k: K) -> DType:
    return DType(tag=DT_BASE, name=name, size=k.size(), k=k, to=-1, fields=[])

fn dstruct(name: str, size: int, fields: [DField]) -> DType:
    return DType(tag=DT_STRUCT, name=name, size=size, k=K.I64, to=-1, fields=fields)

fn dtypedef(name: str, to: int) -> DType:
    return DType(tag=DT_TYPEDEF, name=name, size=8, k=K.Ptr, to=to, fields=[])

fn dfield(name: str, ty: int, off: int) -> DField:
    return DField(name=name, ty=ty, off=off)
