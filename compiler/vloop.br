# Vector loops for the x86-64 backend. ssa.br finds innermost loops like
#
#     for j in lo..hi:
#         c[j] = c[j] + a * b[j]
#         s += 1.0 / float(i + j) * c[j]
#
# that load and store doubles at j of a few arrays, do + - * / on them, keep
# sums of them, and compute integers from j. Such a loop gets a kernel that
# runs it several elements at a time, called before the loop; it says how
# many elements it did and the loop does the rest. The kernel does eight at
# a time with AVX-512 when the CPU has it, else four with AVX2, else two
# with SSE2. Loops that compute integers need AVX-512 (64-bit integer
# multiply and conversion to double); without it their kernel does nothing.
#
# Each lane does what one iteration does, the same operations in the same
# order, and sums add the lanes one at a time in order, so the results are
# the same bits. Lanes read before earlier lanes' later writes, though,
# which differs from the loop when an access of a later element meets a
# later access of an earlier one: the kernel tests for that first and does
# nothing if so.
#
# The kernel's one parameter points at a block of 8-byte words: the arrays'
# addresses of element lo, the count, lo, the integers and the doubles the
# loop reads but doesn't change, and the sums (their values before, and the
# kernel writes them after).
from ir import KOp, KFunc, KPath, KO_CHK
from ir import KV_BCF, KV_BCI, KV_J, KV_JINC, KV_LD, KV_ST, KV_MOV, KV_FOP, KV_IOP, KV_SHI, KV_CVT
from ir import KV_RLD, KV_RED, KV_RST, VQ_ADD, VQ_SUB, VQ_AND, VQ_OR, VQ_XOR, VQ_MUL

# loads and stores of doubles (arr, off)
const L_LD = 0
const L_ST = 1
# doubles: d = a op b
const L_ADD = 2
const L_SUB = 3
const L_MUL = 4
const L_DIV = 5
# 64-bit integers: d = a op b
const L_IADD = 6
const L_ISUB = 7
const L_IMUL = 8
const L_IAND = 9
const L_IOR = 10
const L_IXOR = 11
# d = a shifted by `off` bits (L_SHR: as unsigned)
const L_SHL = 12
const L_SAR = 13
const L_SHR = 14
# d = the double of integer a
const L_CONV = 15
# sum `arr` = sum op a, op (L_ADD, L_SUB, L_MUL) in `off`
const L_RED = 16

const NREG = 16

# One operation of the body. Values 0..nint-1 are the integer parameters,
# then nflt doubles, then j (`jv`); each operation but L_ST and L_RED
# defines the next value.
struct LOp:
    op: int
    a: int
    b: int
    arr: int
    off: int

struct Loop:
    narr: int
    nint: int
    nflt: int
    nred: int
    ops: [LOp]

fn jv(l: Loop) -> int:
    return l.nint + l.nflt

# where things are in the block, in words
fn w_cnt(l: Loop) -> int:
    return l.narr

fn w_lo(l: Loop) -> int:
    return l.narr + 1

fn w_int(l: Loop, i: int) -> int:
    return l.narr + 2 + i

fn w_flt(l: Loop, i: int) -> int:
    return l.narr + 2 + l.nint + i

fn w_red(l: Loop, r: int) -> int:
    return l.narr + 2 + l.nint + l.nflt + r

fn nwords(l: Loop) -> int:
    return l.narr + 2 + l.nint + l.nflt + l.nred

fn defines(op: int) -> bool:
    return op != L_ST and op != L_RED

# ops with a second operand b
fn binary(op: int) -> bool:
    return op >= L_ADD and op <= L_IXOR

fn is_int(op: int) -> bool:
    return op >= L_IADD and op <= L_SHR

fn fop(op: int) -> int:
    match op:
        case L_ADD:
            return 88
        case L_SUB:
            return 92
        case L_MUL:
            return 89
        case _:
            return 94

fn iop(op: int) -> int:
    match op:
        case L_IADD:
            return VQ_ADD
        case L_ISUB:
            return VQ_SUB
        case L_IMUL:
            return VQ_MUL
        case L_IAND:
            return VQ_AND
        case L_IOR:
            return VQ_OR
        case _:
            return VQ_XOR

fn kop(op: int, a: int, b: int, n: int, m: int) -> KOp:
    return KOp(op=op, a=a, b=b, n=n, m=m)

fn no_kernel(name: str) -> KFunc:
    return KFunc(
        name=name,
        narr=0,
        nflt=0,
        has_ret=true,
        nslots=0,
        regs=[],
        ops=[],
        loop=true,
        paths=[]
    )

# The tests that lanes 0..w-1 run as the loop would (KO_CHK), or ok false
# when two accesses of one array always meet.
fn checks(l: Loop, w: int) -> (bool, [KOp]):
    var out: [KOp] = []
    var acc: [int] = []
    for i, x in enumerate(l.ops):
        if x.op == L_LD or x.op == L_ST:
            acc.push(i)
    for p in 0..len(acc):
        for q in p + 1..len(acc):
            let a = l.ops[acc[p]]
            let b = l.ops[acc[q]]
            if a.op == L_LD and b.op == L_LD:
                continue
            # a of a later element meets b of an earlier one when b's place
            # is 1 to 8w - 1 bytes after a's
            let n = b.off - a.off
            if a.arr == b.arr:
                if n > 0 and n < 8 * w:
                    return (false, [])
            else:
                out.push(kop(KO_CHK, a.arr, b.arr, n, w))
    return (true, out)

fn free_reg(held: [bool]) -> int:
    var r = 0
    while r < NREG and held[r]:
        r += 1
    return r

fn nvalues(l: Loop) -> int:
    var nv = jv(l) + 1
    for x in l.ops:
        if defines(x.op):
            nv += 1
    return nv

# Which operations matter: stores, sums, and what they read.
fn needed(l: Loop) -> [bool]:
    let n = len(l.ops)
    var used = [false] * nvalues(l)
    var need = [false] * n
    var v = nvalues(l)
    var i = n - 1
    while i >= 0:
        let x = l.ops[i]
        var d = -1
        if defines(x.op):
            v -= 1
            d = v
        if x.op == L_ST or x.op == L_RED or (d >= 0 and used[d]):
            need[i] = true
            if x.op != L_LD:
                used[x.a] = true
                if binary(x.op):
                    used[x.b] = true
        i -= 1
    return need

# The path w lanes wide (2: SSE2, 4: AVX2, 8: AVX-512), or ok false when it
# needs more than 16 registers, or integers below eight lanes.
fn lanes(l: Loop, w: int) -> (bool, KPath, [bool]):
    let none = KPath(w=w, pre=[], body=[], post=[])
    let need = needed(l)
    let nv = nvalues(l)
    var reg = [-1] * nv
    var last = [-1] * nv
    for i, x in enumerate(l.ops):
        if not need[i]:
            continue
        if w < 8 and (is_int(x.op) or x.op == L_CONV):
            return (false, none, [])
        if x.op != L_LD:
            last[x.a] = i
            if binary(x.op):
                last[x.b] = i
    var held = [false] * NREG
    var touched = [false] * NREG
    var pre: [KOp] = []
    var body: [KOp] = []
    var post: [KOp] = []
    # what the loop doesn't change, and the sums, live in registers throughout
    for v in 0..jv(l) + 1:
        if last[v] < 0:
            continue
        if (v < l.nint or v == jv(l)) and w < 8:
            return (false, none, [])
        let r = free_reg(held)
        if r == NREG:
            return (false, none, [])
        reg[v] = r
        held[r] = true
        touched[r] = true
        if v < l.nint:
            pre.push(kop(KV_BCI, r, 0, w_int(l, v), 0))
        elif v < jv(l):
            pre.push(kop(KV_BCF, r, 0, w_flt(l, v - l.nint), 0))
        else:
            pre.push(kop(KV_J, r, 0, w_lo(l), 0))
    var acc = [-1] * l.nred
    for k in 0..l.nred:
        let r = free_reg(held)
        if r == NREG:
            return (false, none, [])
        acc[k] = r
        held[r] = true
        touched[r] = true
        pre.push(kop(KV_RLD, r, 0, w_red(l, k), 0))
        post.push(kop(KV_RST, r, 0, w_red(l, k), 0))
    var v = jv(l) + 1
    for i, x in enumerate(l.ops):
        let d = v
        if defines(x.op):
            v += 1
        if not need[i]:
            continue
        let dies_a = x.op != L_LD and x.a > jv(l) and last[x.a] == i
        let dies_b = binary(x.op) and x.b > jv(l) and last[x.b] == i and x.b != x.a
        match x.op:
            case L_ST:
                body.push(kop(KV_ST, reg[x.a], x.arr, x.off, 0))
            case L_RED:
                body.push(kop(KV_RED, acc[x.arr], reg[x.a], fop(x.off), 0))
            case L_LD:
                let r = free_reg(held)
                if r == NREG:
                    return (false, none, [])
                reg[d] = r
                body.push(kop(KV_LD, r, x.arr, x.off, 0))
            case _:
                var r = -1
                if dies_a:
                    r = reg[x.a]
                elif dies_b and w > 2:
                    # three operands: d may be b's register
                    r = reg[x.b]
                else:
                    r = free_reg(held)
                    if r == NREG:
                        return (false, none, [])
                    if w == 2:
                        body.push(kop(KV_MOV, r, reg[x.a], 0, 0))
                reg[d] = r
                if x.op >= L_ADD and x.op <= L_DIV:
                    body.push(kop(KV_FOP, r, reg[x.a], fop(x.op), reg[x.b]))
                elif binary(x.op):
                    body.push(kop(KV_IOP, r, reg[x.a], iop(x.op), reg[x.b]))
                elif x.op == L_CONV:
                    body.push(kop(KV_CVT, r, reg[x.a], 0, 0))
                else:
                    var ext = 2
                    if x.op == L_SHL:
                        ext = 6
                    elif x.op == L_SAR:
                        ext = 4
                    body.push(kop(KV_SHI, r, reg[x.a], ext, x.off))
        # a register is free after its last read; d's is held while d is read
        if dies_a:
            held[reg[x.a]] = false
        if dies_b:
            held[reg[x.b]] = false
        if defines(x.op):
            touched[reg[d]] = true
            held[reg[d]] = last[d] >= 0
    if last[jv(l)] >= 0:
        body.push(kop(KV_JINC, reg[jv(l)], 0, 0, 0))
    return (true, KPath(w=w, pre=pre, body=body, post=post), touched)

# The kernel, or none (ok false), with paths up to `wmax` lanes.
fn compile(l: Loop, name: str, wmax: int) -> (bool, KFunc):
    var w = wmax
    var (ok, chk) = checks(l, w)
    while not ok and w > 2:
        # fewer lanes may still be fine
        w = w / 2
        let (ok2, chk2) = checks(l, w)
        ok = ok2
        chk = chk2
    if not ok:
        return (false, no_kernel(name))
    var paths: [KPath] = []
    var touched = [false] * NREG
    for pw in [8, 4, 2]:
        if pw <= w:
            let (okp, path, t) = lanes(l, pw)
            if okp:
                paths.push(path)
                for r in 0..NREG:
                    touched[r] = touched[r] or t[r]
    if len(paths) == 0:
        return (false, no_kernel(name))
    var regs: [int] = []
    for r in 0..NREG:
        if touched[r]:
            regs.push(r)
    return (
        true,
        KFunc(
            name=name,
            narr=l.narr,
            nflt=0,
            has_ret=true,
            nslots=0,
            regs=regs,
            ops=chk,
            loop=true,
            paths=paths
        )
    )
