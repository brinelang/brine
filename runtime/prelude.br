# The prelude: visible in every module without an import.

enum Option[T]:
    Some(value: T)
    None

    fn is_some(self) -> bool:
        match self:
            case Some(_):
                return true
            case None:
                return false

    fn is_none(self) -> bool:
        return not self.is_some()

    fn unwrap(self) -> T:
        match self:
            case Some(v):
                return v
            case None:
                panic("unwrap() called on None")

    fn unwrap_or(self, default: T) -> T:
        match self:
            case Some(v):
                return v
            case None:
                return default

enum Result[T, E]:
    Ok(value: T)
    Err(error: E)

    fn is_ok(self) -> bool:
        match self:
            case Ok(_):
                return true
            case Err(_):
                return false

    fn is_err(self) -> bool:
        return not self.is_ok()

    fn unwrap(self) -> T:
        match self:
            case Ok(v):
                return v
            case Err(_):
                panic("unwrap() called on Err")

    fn unwrap_or(self, default: T) -> T:
        match self:
            case Ok(v):
                return v
            case Err(_):
                return default

    fn ok(self) -> Option[T]:
        match self:
            case Ok(v):
                return Some(v)
            case Err(_):
                return None
