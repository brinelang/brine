# ---------------------------------------------------------------- the OS

extern fn QueryPerformanceCounter(c: ptr) -> i32

extern fn QueryPerformanceFrequency(f: ptr) -> i32

extern fn GetCurrentProcessId() -> u32

extern fn Sleep(ms: u32)

extern fn clock_gettime(id: i32, ts: ptr) -> i32

extern fn getpid() -> i32

extern fn nanosleep(req: ptr, rem: ptr) -> i32

# seconds since some fixed point (the C runtime's GPU code times with it too)
fn brine_clock() -> float:
    if os_is("windows"):
        let fq = global_mem("qpc_freq", 8)
        if load_i64(fq, 0) == 0:
            QueryPerformanceFrequency(fq)
        let c = stack_mem(8)
        QueryPerformanceCounter(c)
        return float(load_i64(c, 0)) / float(load_i64(fq, 0))
    else:
        let ts = stack_mem(16)
        # CLOCK_MONOTONIC
        clock_gettime(i32(6) if os_is("macos") else i32(1), ts)
        return float(load_i64(ts, 0)) + float(load_i64(ts, 8)) * 1.0e-9

fn brine_os_pid() -> int:
    if os_is("windows"):
        return int(GetCurrentProcessId())
    else:
        return int(getpid())

fn brine_os_sleep(seconds: float):
    if not (seconds > 0.0):
        return
    if os_is("windows"):
        var ms = ceil(seconds * 1000.0)
        while ms > 0.0:
            let part = 4000000000.0 if ms > 4000000000.0 else ms
            Sleep(u32(part))
            ms -= part
    else:
        let ts = stack_mem(16)
        let s = 1.0e15 if seconds > 1.0e15 else floor(seconds)
        var ns = int((seconds - s) * 1.0e9)
        if ns < 0:
            ns = 0
        if ns >= 1000000000:
            ns = 999999999
        store_i64(ts, 0, int(s))
        store_i64(ts, 8, ns)
        # (interrupted by a signal: sleep the rest)
        while nanosleep(ts, ts) != 0:
            pass

# ---------------------------------------------------------------- par

# `first` searches: the lowest chunk that found something so far, which
# later chunks stop at
fn first_stopped(stop: ptr, chunk: int) -> bool:
    return atomic_load(stop) < chunk

fn first_found(stop: ptr, chunk: int):
    var cur = atomic_load(stop)
    while chunk < cur:
        let seen = atomic_cas(stop, cur, chunk)
        if seen == cur:
            return
        cur = seen

# ---------------------------------------------------------------- threads

# Locks and condition variables take 64 bytes each, enough everywhere
# (pthread_mutex_t is 40 bytes on Linux x86-64, 48 on AArch64, 64 on macOS;
# pthread_cond_t 48). On Windows they are an SRW lock and a
# CONDITION_VARIABLE, ready when zeroed.
const LOCK_SIZE = 64

# every thread brine code runs on, `main` included, gets a stack this big
# (reserved, not committed)
const THREAD_STACK = 67108864

extern fn AcquireSRWLockExclusive(m: ptr)

extern fn ReleaseSRWLockExclusive(m: ptr)

extern fn TryAcquireSRWLockExclusive(m: ptr) -> u8

extern fn SleepConditionVariableSRW(c: ptr, m: ptr, ms: u32, flags: u32) -> i32

extern fn WakeAllConditionVariable(c: ptr)

extern fn CreateThread(attr: ptr, stack: u64, f: ptr, arg: ptr, flags: u32, id: ptr) -> ptr

extern fn WaitForSingleObject(h: ptr, ms: u32) -> u32

extern fn CloseHandle(h: ptr) -> i32

extern fn GetSystemInfo(si: ptr)

extern fn pthread_mutex_init(m: ptr, attr: ptr) -> i32

extern fn pthread_mutex_lock(m: ptr) -> i32

extern fn pthread_mutex_unlock(m: ptr) -> i32

extern fn pthread_mutex_trylock(m: ptr) -> i32

extern fn pthread_cond_init(c: ptr, attr: ptr) -> i32

extern fn pthread_cond_wait(c: ptr, m: ptr) -> i32

extern fn pthread_cond_broadcast(c: ptr) -> i32

extern fn pthread_attr_init(a: ptr) -> i32

extern fn pthread_attr_setstacksize(a: ptr, n: u64) -> i32

extern fn pthread_attr_destroy(a: ptr) -> i32

extern fn pthread_create(th: ptr, attr: ptr, f: ptr, arg: ptr) -> i32

extern fn pthread_join(th: u64, ret: ptr) -> i32

extern fn sysconf(name: i32) -> int

extern fn malloc(n: u64) -> ptr

extern fn free(p: ptr)

extern fn getenv(name: ptr) -> ptr

extern fn getauxval(t: u64) -> u64

fn lock_init(m: ptr):
    if os_is("windows"):
        store_i64(m, 0, 0)
    else:
        pthread_mutex_init(m, null_ptr())

fn lock(m: ptr):
    if os_is("windows"):
        AcquireSRWLockExclusive(m)
    else:
        pthread_mutex_lock(m)

fn unlock(m: ptr):
    if os_is("windows"):
        ReleaseSRWLockExclusive(m)
    else:
        pthread_mutex_unlock(m)

fn try_lock(m: ptr) -> bool:
    if os_is("windows"):
        return TryAcquireSRWLockExclusive(m) != 0
    else:
        return pthread_mutex_trylock(m) == 0

fn cond_init(c: ptr):
    if os_is("windows"):
        store_i64(c, 0, 0)
    else:
        pthread_cond_init(c, null_ptr())

fn cond_wait(c: ptr, m: ptr):
    if os_is("windows"):
        # (INFINITE)
        SleepConditionVariableSRW(c, m, u32(4294967295), u32(0))
    else:
        pthread_cond_wait(c, m)

fn cond_broadcast(c: ptr):
    if os_is("windows"):
        WakeAllConditionVariable(c)
    else:
        pthread_cond_broadcast(c)

# Starts the C function `void f(void *)` on arg in a new thread; the
# thread's handle goes in the 8 bytes at th.
fn thread_start(f: ptr, arg: ptr, th: ptr) -> bool:
    let t = malloc(16)
    store_ptr(t, 0, f)
    store_ptr(t, 8, arg)
    if os_is("windows"):
        # (STACK_SIZE_PARAM_IS_A_RESERVATION)
        let flags = u32(65536)
        let h = CreateThread(
            null_ptr(),
            u64(THREAD_STACK),
            symbol("brine_x_thread_main"),
            t,
            flags,
            null_ptr()
        )
        store_ptr(th, 0, h)
        return addr(h) != 0
    else:
        let at = stack_mem(64)
        pthread_attr_init(at)
        pthread_attr_setstacksize(at, u64(THREAD_STACK))
        let ok = pthread_create(th, at, symbol("brine_x_thread_main"), t) == 0
        pthread_attr_destroy(at)
        return ok

fn brine_x_thread_main(t: ptr) -> ptr:
    let f = load_ptr(t, 0)
    let arg = load_ptr(t, 8)
    free(t)
    brine_x_thread_enter()
    call_void(f, arg)
    brine_x_thread_leave()
    return null_ptr()

fn thread_join(th: u64):
    if os_is("windows"):
        let h = null_ptr() + int(th)
        WaitForSingleObject(h, u32(4294967295))
        CloseHandle(h)
    else:
        pthread_join(th, null_ptr())

fn ncpu() -> int:
    if os_is("windows"):
        # SYSTEM_INFO.dwNumberOfProcessors
        let si = stack_mem(48)
        GetSystemInfo(si)
        return int(load_u32(si, 32))
    else:
        # (_SC_NPROCESSORS_ONLN)
        let n = sysconf(i32(58) if os_is("macos") else i32(84))
        return n if n > 0 else 1

# C's atoi: blanks, a sign, then digits
fn atoi(p: ptr) -> int:
    var i = 0
    while true:
        let c = load_u8(p, i)
        if c != 32 and (c < 9 or c > 13):
            break
        i += 1
    let s = load_u8(p, i)
    let neg = s == 45
    if s == 45 or s == 43:
        i += 1
    var n = 0
    while true:
        let c = load_u8(p, i)
        if c < 48 or c > 57:
            break
        n = n * 10 + int(c - 48)
        i += 1
    return -n if neg else n

# ---------------------------------------------------------------- thread pool

# The running job is published in `cur` (and its number in `ids`); a worker
# counts itself in `active` before it reads `cur`, and the thread that
# posted the job clears `cur` and waits for `active` to drain before the job
# (in its frame) goes away. Joining and leaving take no lock; `mu` is only
# for sleeping. `budget` is how many more threads `par` tasks may start.
const PL_MU = 0
const PL_CV_WORK = 64
const PL_CV_DONE = 128
const PL_JOB_LOCK = 192
const PL_NTHREADS = 256
const PL_STARTED = 264
const PL_CUR = 272
const PL_IDS = 280
const PL_ACTIVE = 288
const PL_MAIN_WAITS = 296
const PL_BUDGET = 304

# a job: `fn(ctx, chunk, lo, hi)` for each of k chunks of the n items from lo
const JB_FN = 0
const JB_CTX = 8
const JB_LO = 16
const JB_N = 24
const JB_K = 32
const JB_NEXT = 40
const JB_ID = 48

# Waking a sleeping thread takes tens of microseconds, longer than many
# parallel regions run, so threads busy-wait a little before they sleep.
const SPINS = 20000

fn pool() -> ptr:
    return global_mem("pool", 320)

# (brine_rt_init, once)
fn brine_x_pool_init():
    let pl = pool()
    lock_init(pl + PL_MU)
    lock_init(pl + PL_JOB_LOCK)
    cond_init(pl + PL_CV_WORK)
    cond_init(pl + PL_CV_DONE)

fn brine_x_threads() -> int:
    let pl = pool()
    if load_i64(pl, PL_NTHREADS) == 0:
        let e = getenv(ptr_of("BRINE_THREADS") + STR_DATA)
        var n = 0 if addr(e) == 0 else atoi(e)
        if n <= 0:
            n = ncpu()
        if n > 1024:
            n = 1024
        store_i64(pl, PL_NTHREADS, n)
        atomic_store(pl + PL_BUDGET, n - 1)
    return load_i64(pl, PL_NTHREADS)

fn spin_while_eq(p: ptr, v: int):
    for _ in 0..SPINS:
        if atomic_load(p) != v:
            return
        cpu_relax()

fn run_chunks(j: ptr):
    let n = load_i64(j, JB_N)
    let k = load_i64(j, JB_K)
    let base = n / k
    let rem = n % k
    let lo = load_i64(j, JB_LO)
    while true:
        let c = atomic_add(j + JB_NEXT, 1)
        if c >= k:
            break
        let a = c * base + (c if c < rem else rem)
        let b = a + base + (1 if c < rem else 0)
        call_void(load_ptr(j, JB_FN), load_ptr(j, JB_CTX), c, lo + a, lo + b)

fn brine_x_pool_worker(arg: ptr):
    let pl = pool()
    brine_x_in_par_set(1)
    var seen = 0
    while true:
        spin_while_eq(pl + PL_IDS, seen)
        if atomic_load(pl + PL_IDS) == seen:
            lock(pl + PL_MU)
            while atomic_load(pl + PL_IDS) == seen:
                cond_wait(pl + PL_CV_WORK, pl + PL_MU)
            unlock(pl + PL_MU)
        seen = atomic_load(pl + PL_IDS)
        atomic_add(pl + PL_ACTIVE, 1)
        let j = atomic_load(pl + PL_CUR)
        if j != 0:
            run_chunks(null_ptr() + j)
        # (the last one out wakes the poster if it sleeps)
        if atomic_add(pl + PL_ACTIVE, -1) == 1 and atomic_load(pl + PL_MAIN_WAITS) != 0:
            lock(pl + PL_MU)
            cond_broadcast(pl + PL_CV_DONE)
            unlock(pl + PL_MU)

fn brine_par_run(lo: int, hi: int, nchunks: int, f: ptr, ctx: ptr):
    if hi <= lo or nchunks <= 0:
        return
    let pl = pool()
    let job = stack_mem(56)
    store_ptr(job, JB_FN, f)
    store_ptr(job, JB_CTX, ctx)
    store_i64(job, JB_LO, lo)
    store_i64(job, JB_N, hi - lo)
    store_i64(job, JB_K, nchunks)
    store_i64(job, JB_NEXT, 0)
    if (
        nchunks == 1
        or brine_x_in_par_get() != 0
        or brine_x_threads() <= 1
        or not try_lock(pl + PL_JOB_LOCK)
    ):
        run_chunks(job)
        return
    let mt = mt_count()
    # (before the workers can see the job, after they are done below)
    atomic_add(mt, MT_STEP)
    if load_i64(pl, PL_STARTED) == 0:
        store_i64(pl, PL_STARTED, 1)
        let th = stack_mem(8)
        for _ in 0..load_i64(pl, PL_NTHREADS) - 1:
            thread_start(symbol("brine_x_pool_worker"), null_ptr(), th)
    lock(pl + PL_MU)
    let id = load_i64(pl, PL_IDS) + 1
    store_i64(job, JB_ID, id)
    atomic_store(pl + PL_CUR, addr(job))
    atomic_store(pl + PL_IDS, id)
    cond_broadcast(pl + PL_CV_WORK)
    unlock(pl + PL_MU)
    brine_x_in_par_set(1)
    run_chunks(job)
    brine_x_in_par_set(0)
    atomic_store(pl + PL_CUR, 0)
    for _ in 0..SPINS:
        if atomic_load(pl + PL_ACTIVE) <= 0:
            break
        cpu_relax()
    if atomic_load(pl + PL_ACTIVE) > 0:
        lock(pl + PL_MU)
        atomic_store(pl + PL_MAIN_WAITS, 1)
        while atomic_load(pl + PL_ACTIVE) > 0:
            cond_wait(pl + PL_CV_DONE, pl + PL_MU)
        atomic_store(pl + PL_MAIN_WAITS, 0)
        unlock(pl + PL_MU)
    atomic_add(mt, -MT_STEP)
    unlock(pl + PL_JOB_LOCK)

# `par` tasks: a thread for each but the last while the budget lasts; the
# rest run here
fn brine_par_tasks(k: int, f: ptr, ctx: ptr):
    let pl = pool()
    brine_x_threads()
    let tasks = brine_alloc(k * 24)
    let ths = brine_alloc(k * 8)
    let spawned = brine_alloc(k)
    for i in 0..k:
        store_ptr(tasks, i * 24, f)
        store_ptr(tasks, i * 24 + 8, ctx)
        store_i64(tasks, i * 24 + 16, i)
        store_u8(spawned, i, u8(0))
    let mt = mt_count()
    atomic_add(mt, MT_STEP)
    for i in 0..k - 1:
        # (the budget was at least 1)
        if (
            atomic_add(pl + PL_BUDGET, -1) >= 1
            and thread_start(symbol("brine_x_task_main"), tasks + i * 24, ths + i * 8)
        ):
            store_u8(spawned, i, u8(1))
        else:
            atomic_add(pl + PL_BUDGET, 1)
    for i in 0..k:
        if load_u8(spawned, i) == 0:
            call_void(f, ctx, i)
    for i in 0..k:
        if load_u8(spawned, i) != 0:
            thread_join(load_u64(ths, i * 8))
            atomic_add(pl + PL_BUDGET, 1)
    atomic_add(mt, -MT_STEP)
    brine_free(tasks)
    brine_free(ths)
    brine_free(spawned)

fn brine_x_task_main(t: ptr):
    call_void(load_ptr(t, 0), load_ptr(t, 8), load_i64(t, 16))

# ---------------------------------------------------------------- memory

# Small blocks (strings, boxes, array headers) come from a heap of our own:
# one big reserved address range cut into 64 KiB chunks, each holding blocks
# of one size class, with a free list per class and thread. A range check
# tells its blocks from malloc's, so brine_free and brine_x_realloc take
# either. A thread that frees far more than it allocates (one consuming
# what others made), or that exits, hands its free blocks over in batches of
# about SPARE bytes, and a thread that runs out takes one batch, so memory
# doesn't pile up on any one thread.
const NCLASS = 12
const CHUNK = 65536
const RESERVE = 68719476736
# bytes of free blocks a thread may keep per class
const SPARE = 65536
# the chunks' size classes: a byte per chunk of RESERVE
const NCHUNKS = 1048576

# the rest of heap_info: where the next chunk starts, the key of the
# threads' heaps, and whether HI_OFF locates them
const HI_NEXT = 144
const HI_KEY = 152
const HI_TH = 160

# the rest of a thread's heap: where each class's last chunk has room
# left, the in-par flag, and brine_drop's state: how deep the frees nest,
# and the dead objects left for the outermost one (pairs: object, function)
const TH_BUMP = 192
const TH_END = 288
const TH_IN_PAR = 384
const TH_DROP_DEPTH = 392
const TH_DROPS = 400
const TH_NDROPS = 408
const TH_CAPDROPS = 416
const TH_SIZE = 424

# past this many nested frees, brine_drop leaves objects for later
const DROP_DEPTH = 200

extern fn TlsAlloc() -> u32

extern fn TlsGetValue(i: u32) -> ptr

extern fn TlsSetValue(i: u32, v: ptr) -> i32

extern fn VirtualAlloc(p: ptr, n: u64, kind: u32, prot: u32) -> ptr

extern fn _write(fd: i32, p: ptr, n: u32) -> i32

extern fn pthread_key_create(k: ptr, dtor: ptr) -> i32

extern fn pthread_getspecific(k: u32) -> ptr

extern fn pthread_setspecific(k: u32, v: ptr) -> i32

extern fn mmap(p: ptr, n: u64, prot: i32, flags: i32, fd: i32, off: i64) -> ptr

extern fn mprotect(p: ptr, n: u64, prot: i32) -> i32

extern fn write(fd: i32, p: ptr, n: u64) -> int

extern fn calloc(n: u64, k: u64) -> ptr

extern fn realloc(p: ptr, n: u64) -> ptr

extern fn abort()

fn heap_info() -> ptr:
    return global_mem("heap_info", 176)

# a stack of free batches per class: a batch is a free list, and its first
# block's second word links the next batch
fn heap_batches() -> ptr:
    return global_mem("heap_batches", 96)

fn heap_mu() -> ptr:
    return global_mem("heap_mu", 64)

fn oom_cold(n: int):
    oom_at(n, null_ptr())

# A failed allocation of n bytes is a panic, reported where the program
# asked for the memory when `loc` says so. It allocates nothing itself: the
# heap may be exhausted.
fn oom_at(n: int, loc: ptr):
    panic_claim()
    lock(io_mu())
    fflush(os_stdio(1))
    if brine_world_size() > 1:
        stderr_text("\npanic (rank ")
        stderr_uint(brine_world_rank())
        stderr_text("): ")
    else:
        stderr_text("\npanic: ")
    stderr_text("out of memory: could not allocate ")
    if n < 0:
        # the size itself overflowed
        stderr_text("more than 9223372036854775807 bytes")
    else:
        stderr_uint(n)
        stderr_text(" bytes")
        oom_units(n)
    if addr(loc) != 0:
        stderr_text("\n  --> ")
        fwrite(loc, u64(1), strlen(loc), os_stdio(2))
    stderr_text(
        "\n  = help: check where the size comes from (often a wrong count or length), or work on the data in smaller parts\n"
    )
    fflush(os_stdio(2))
    unlock(io_mu())
    oom_record(n, loc)
    exit(i32(101))

# The panic record (`panic_record`) of an out-of-memory panic, for `brine
# run --json`: written without allocating, like the message.
fn oom_record(n: int, loc: ptr):
    let path = getenv(lit("BRINE_PANIC_FILE"))
    if addr(path) == u64(0):
        return
    let f = os_fopen(path, "wb")
    if addr(f) == u64(0):
        return
    let nul = stack_mem(8)
    store_u8(nul, 0, u8(0))
    if addr(loc) != 0:
        fwrite(loc, u64(1), strlen(loc), f)
    fwrite(nul, u64(1), u64(1), f)
    file_text(f, "out of memory: could not allocate ")
    if n < 0:
        file_text(f, "more than 9223372036854775807")
    else:
        let b = stack_mem(24)
        var i = 24
        var v = n
        while true:
            i -= 1
            store_u8(b, i, u8(48 + v % 10))
            v /= 10
            if v == 0:
                break
        fwrite(b + i, u64(1), u64(24 - i), f)
    file_text(f, " bytes")
    fwrite(nul, u64(1), u64(1), f)
    fclose(f)

# ` (1.5 GiB)` for n bytes, when that says more than the number
fn oom_units(n: int):
    var unit = 1 << 40
    var name = " TiB)"
    if n < unit:
        unit = 1 << 30
        name = " GiB)"
    if n < unit:
        return
    let tenths = n / (unit / 10)
    stderr_text(" (")
    stderr_uint(tenths / 10)
    if tenths % 10 != 0:
        stderr_text(".")
        stderr_uint(tenths % 10)
    stderr_text(name)

# n >= 0 in decimal, without allocating
fn stderr_uint(n: int):
    let b = stack_mem(24)
    var i = 24
    var v = n
    while true:
        i -= 1
        store_u8(b, i, u8(48 + v % 10))
        v /= 10
        if v == 0:
            break
    fwrite(b + i, u64(1), u64(24 - i), os_stdio(2))

# n zero bytes for something the program asked for at `loc`
fn calloc_at(n: int, loc: ptr) -> ptr:
    if n < 0:
        oom_at(n, loc)
    let p = calloc(u64(max(n, 1)), u64(1))
    if addr(p) == 0:
        oom_at(n, loc)
    return p

# len * esz, or -1 when that overflows (no allocation can be that big)
fn alloc_bytes(len: int, esz: int) -> int:
    if esz > 0 and len > 9223372036854775807 / esz:
        return -1
    return len * esz

# n zeroed bytes of fresh pages, or 0
fn os_pages(n: int) -> ptr:
    if os_is("windows"):
        # (MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)
        return VirtualAlloc(null_ptr(), u64(n), u32(12288), u32(4))
    else:
        let m = mmap(null_ptr(), u64(n), i32(3), map_anon(), i32(-1), i64(0))
        return null_ptr() if addr(m) == 18446744073709551615 else m

# MAP_PRIVATE | MAP_ANONYMOUS
fn map_anon() -> i32:
    return i32(4098) if os_is("macos") else i32(34)

fn heap_key() -> u32:
    return u32(load_i64(heap_info(), HI_KEY))

# This thread's heap, at address 0 when there is none yet.
fn th_peek() -> ptr:
    let hi = heap_info()
    if load_i64(hi, HI_TH) != 0:
        return th_heap(hi)
    return th_peek_cold()

fn th_peek_cold() -> ptr:
    if os_is("windows"):
        return TlsGetValue(heap_key())
    else:
        return pthread_getspecific(heap_key())

fn th_set(h: ptr):
    if os_is("windows"):
        TlsSetValue(heap_key(), h)
    else:
        pthread_setspecific(heap_key(), h)

fn th_get() -> ptr:
    let h = th_peek()
    if addr(h) != 0:
        return h
    return th_new_cold()

fn th_new_cold() -> ptr:
    let h = calloc(u64(1), u64(TH_SIZE))
    if addr(h) == 0:
        oom_cold(TH_SIZE)
    th_set(h)
    return h

# Where the thread block keeps this thread's heap (key k's value h), as an
# offset from the thread pointer, the same in every thread; 1 when it
# isn't found. glibc keeps the first 32 keys' values in the thread block,
# above the thread pointer on x86-64 and below it on AArch64. The search
# stops at the first match, which a second value then confirms, so it
# reads nothing past the slot.
fn th_slot(k: u32, h: ptr) -> int:
    if os_is("linux"):
        if k >= 32:
            return 1
        let tp = thread_ptr()
        let step = 8 if os_is("x86_64") else -8
        var off = 0 if step > 0 else -8
        for _ in 0..256:
            if addr(load_ptr(tp, off)) == addr(h):
                pthread_setspecific(k, h + 8)
                let ok = addr(load_ptr(tp, off)) == addr(h) + 8
                pthread_setspecific(k, h)
                if ok:
                    return off
            off += step
        return 1
    else:
        return 1

# (brine_rt_init, once, before any thread starts; without the reservation
# every block is malloc's)
fn brine_x_heap_init(leakcheck: int):
    # (first: counting doesn't need the reservation or the fast path, which
    # macOS goes without)
    store_i64(leaks(), 0, leakcheck)
    let hi = heap_info()
    lock_init(heap_mu())
    for c in 0..NCLASS:
        store_i64(hi, HI_KEEP + c * 8, SPARE / class_size(c))
    var b = 0
    if os_is("windows"):
        let k = TlsAlloc()
        store_i64(hi, HI_KEY, int(k))
        # (TLS_OUT_OF_INDEXES)
        if k == u32(4294967295):
            return
        # (MEM_RESERVE, PAGE_NOACCESS: reservations are 64 KiB aligned)
        b = int(addr(VirtualAlloc(null_ptr(), u64(RESERVE), u32(8192), u32(1))))
    else:
        let ks = stack_mem(8)
        store_i64(ks, 0, 0)
        if pthread_key_create(ks, null_ptr()) != 0:
            return
        store_i64(hi, HI_KEY, int(load_u32(ks, 0)))
        # (PROT_NONE, MAP_NORESERVE)
        let flags = map_anon() | (i32(64) if os_is("macos") else i32(16384))
        let m = mmap(null_ptr(), u64(RESERVE + CHUNK), i32(0), flags, i32(-1), i64(0))
        if addr(m) != 18446744073709551615:
            b = (int(addr(m)) + CHUNK - 1) & -CHUNK
    let classes = os_pages(NCHUNKS)
    if b == 0 or addr(classes) == 0:
        return
    store_ptr(hi, HI_CLASSES, classes)
    store_i64(hi, HI_NEXT, b)
    store_i64(hi, HI_END, b + RESERVE)
    store_i64(hi, HI_BASE, b)
    # where native code finds a thread's heap
    if os_is("windows"):
        let k = int(heap_key())
        if k >= 64:
            return
        # TEB.TlsSlots[k]
        store_i64(hi, HI_OFF, 5248 + k * 8)
    else:
        let off = th_slot(heap_key(), th_get())
        if off == 1:
            return
        store_i64(hi, HI_OFF, off)
    store_i64(hi, HI_TH, 1)
    if leakcheck == 0:
        store_i64(hi, HI_FAST, 1)

fn chunk_new(c: int) -> ptr:
    let hi = heap_info()
    let ch = atomic_add(hi + HI_NEXT, CHUNK)
    if ch + CHUNK > load_i64(hi, HI_END):
        return null_ptr()
    let p = null_ptr() + ch
    if os_is("windows"):
        # (MEM_COMMIT, PAGE_READWRITE)
        if addr(VirtualAlloc(p, u64(CHUNK), u32(4096), u32(4))) == 0:
            return null_ptr()
    else:
        if mprotect(p, u64(CHUNK), i32(3)) != 0:
            return null_ptr()
    store_u8(load_ptr(hi, HI_CLASSES), (ch - load_i64(hi, HI_BASE)) / CHUNK, u8(c))
    return p

fn big(n: int) -> ptr:
    let p = malloc(u64(n if n > 0 else 1))
    if addr(p) == 0:
        oom_cold(n)
    return p

# hands a thread's free list for class c over as one batch
fn give(h: ptr, c: int):
    let p = load_ptr(h, TH_HEAD + c * 8)
    if addr(p) == 0:
        return
    let bs = heap_batches()
    lock(heap_mu())
    store_ptr(p, 8, load_ptr(bs, c * 8))
    store_ptr(bs, c * 8, p)
    unlock(heap_mu())
    store_ptr(h, TH_HEAD + c * 8, null_ptr())
    store_i64(h, TH_COUNT + c * 8, 0)

fn alloc_slow_cold(h: ptr, c: int, n: int) -> ptr:
    let sz = class_size(c)
    let bump = load_ptr(h, TH_BUMP + c * 8)
    if addr(bump) != 0 and addr(load_ptr(h, TH_END + c * 8)) - addr(bump) >= u64(sz):
        store_ptr(h, TH_BUMP + c * 8, bump + sz)
        return bump
    let bs = heap_batches()
    if atomic_load(bs + c * 8) != 0:
        lock(heap_mu())
        let b = load_ptr(bs, c * 8)
        if addr(b) != 0:
            store_ptr(bs, c * 8, load_ptr(b, 8))
        unlock(heap_mu())
        if addr(b) != 0:
            store_ptr(h, TH_HEAD + c * 8, load_ptr(b, 0))
            store_i64(h, TH_COUNT + c * 8, 0)
            return b
    let ch = chunk_new(c)
    if addr(ch) == 0:
        return big(n)
    store_ptr(h, TH_BUMP + c * 8, ch + sz)
    store_ptr(h, TH_END + c * 8, ch + CHUNK)
    return ch

fn alloc_miss_cold(n: int) -> ptr:
    if n > SMALL or load_u64(heap_info(), HI_BASE) == 0:
        return big(n)
    let c = size_class(n)
    let h = th_get()
    let p = load_ptr(h, TH_HEAD + c * 8)
    if addr(p) != 0:
        store_ptr(h, TH_HEAD + c * 8, load_ptr(p, 0))
        let k = load_i64(h, TH_COUNT + c * 8)
        if k > 0:
            store_i64(h, TH_COUNT + c * 8, k - 1)
        return p
    return alloc_slow_cold(h, c, n)

fn brine_alloc(n: int) -> ptr:
    let m = n if n > 0 else 1
    if m <= SMALL:
        let p = pop_free(m)
        if addr(p) != 0:
            return p
    return alloc_miss_cold(m)

fn free_miss_cold(p: ptr):
    if not in_heap(p):
        free(p)
        return
    let hi = heap_info()
    let c = int(load_u8(load_ptr(hi, HI_CLASSES), (addr(p) - load_u64(hi, HI_BASE)) >> 16))
    let h = th_get()
    store_ptr(p, 0, load_ptr(h, TH_HEAD + c * 8))
    store_ptr(h, TH_HEAD + c * 8, p)
    let k = load_i64(h, TH_COUNT + c * 8) + 1
    store_i64(h, TH_COUNT + c * 8, k)
    if k * class_size(c) > SPARE:
        give(h, c)

fn brine_free(p: ptr):
    if not push_free(p):
        free_miss_cold(p)

# realloc for either heap's blocks; out of memory panics
fn brine_x_realloc(p: ptr, n: int) -> ptr:
    if addr(p) == 0:
        return brine_alloc(n)
    if not in_heap(p):
        let q = realloc(p, u64(n if n > 0 else 1))
        if addr(q) == 0:
            oom_cold(n)
        return q
    let hi = heap_info()
    let have = class_size(
        int(load_u8(load_ptr(hi, HI_CLASSES), (addr(p) - load_u64(hi, HI_BASE)) >> 16))
    )
    if n <= have:
        return p
    let q = brine_alloc(n)
    memcpy(q, p, u64(have))
    brine_free(p)
    return q

# a thread's last act: its free blocks, and what is left of its chunks, go
# to the shared lists
fn brine_x_heap_exit():
    if load_u64(heap_info(), HI_BASE) == 0:
        return
    let h = th_peek()
    if addr(h) == 0:
        return
    for c in 0..NCLASS:
        let sz = class_size(c)
        while true:
            let bump = load_ptr(h, TH_BUMP + c * 8)
            if addr(bump) == 0 or addr(load_ptr(h, TH_END + c * 8)) - addr(bump) < u64(sz):
                break
            store_ptr(h, TH_BUMP + c * 8, bump + sz)
            store_ptr(bump, 0, load_ptr(h, TH_HEAD + c * 8))
            store_ptr(h, TH_HEAD + c * 8, bump)
        give(h, c)
    th_set(null_ptr())
    free(h)

# whether this thread runs a parallel region
fn brine_x_in_par_get() -> int:
    let h = th_peek()
    return 0 if addr(h) == 0 else load_i64(h, TH_IN_PAR)

fn brine_x_in_par_set(v: int):
    store_i64(th_get(), TH_IN_PAR, v)

# Freeing an object frees what it holds first, so a deep structure (a long
# enum list, a tree 100k levels deep) would recurse once per level and
# overflow the stack. `f(p)` finishes freeing a dead object; past
# DROP_DEPTH nested calls the object waits on a list instead, which the
# outermost call works through.
fn brine_drop(p: ptr, f: ptr):
    drop(p, f)

# (in place of brine_drop in native code: inline)
fn drop(p: ptr, f: ptr):
    let h = th_get()
    let depth = load_i64(h, TH_DROP_DEPTH)
    if depth >= DROP_DEPTH:
        drop_later_cold(h, p, f)
        return
    store_i64(h, TH_DROP_DEPTH, depth + 1)
    call_void(f, p)
    if depth == 0 and addr(load_ptr(h, TH_DROPS)) != 0:
        drop_rest_cold(h)
    store_i64(h, TH_DROP_DEPTH, depth)

fn drop_later_cold(h: ptr, p: ptr, f: ptr):
    let n = load_i64(h, TH_NDROPS)
    let cap = load_i64(h, TH_CAPDROPS)
    if n + 2 > cap:
        let nc = cap * 2 if cap != 0 else 256
        let d = realloc(load_ptr(h, TH_DROPS), u64(nc * 8))
        if addr(d) == 0:
            oom_cold(nc * 8)
        store_ptr(h, TH_DROPS, d)
        store_i64(h, TH_CAPDROPS, nc)
    let d = load_ptr(h, TH_DROPS)
    store_ptr(d, n * 8, p)
    store_ptr(d, n * 8 + 8, f)
    store_i64(h, TH_NDROPS, n + 2)

# the outermost brine_drop: the objects left (more may come)
fn drop_rest_cold(h: ptr):
    while load_i64(h, TH_NDROPS) > 0:
        let n = load_i64(h, TH_NDROPS) - 2
        store_i64(h, TH_NDROPS, n)
        let d = load_ptr(h, TH_DROPS)
        call_void(load_ptr(d, n * 8 + 8), load_ptr(d, n * 8))
    free(load_ptr(h, TH_DROPS))
    store_ptr(h, TH_DROPS, null_ptr())
    store_i64(h, TH_CAPDROPS, 0)

# ---------------------------------------------------------------- world

# One process per rank, connected to each other by TCP (BRINE_RANK,
# BRINE_WORLD_SIZE and BRINE_PEERS, set by `brine run --ranks`). A
# receiver thread per peer reads its messages into a queue; collectives
# run on the main thread and take them from the queues.

# the world: rank, size, how many lower ranks share this machine (GPUs go
# one per rank), the call this rank is in (operation, how many calls so
# far, call site), the peers, and whether the end was reached
const WD_RANK = 0
const WD_SIZE = 8
const WD_LOCAL = 16
const WD_OP = 24
const WD_SEQ = 32
const WD_SITE = 40
const WD_PEERS = 48
const WD_DONE = 56

# a peer: its locks and the queue's condition, its socket, the queue, set
# when the connection closed, and the receiver's read buffer
const PR_MU = 0
const PR_SEND_MU = 64
const PR_CV = 128
const PR_SOCK = 192
const PR_HEAD = 200
const PR_TAIL = 208
const PR_CLOSED = 216
const PR_RBUF = 224
const PR_RPOS = 232
const PR_REND = 240
const PR_SIZE = 256

# a message: the next in the queue, then the header as it travels (kind,
# length, the sender's call: operation, number, site length), the payload
# and the site
const MS_NEXT = 0
const MS_KIND = 8
const MS_LEN = 16
const MS_OP = 24
const MS_SEQ = 32
const MS_SLEN = 40
const MS_DATA = 48
const HDR = 40

const K_EMPTY = 0
const K_I64 = 1
const K_F64 = 2
const K_MSG = 7

# Which collective a message belongs to. Every rank makes the same calls in
# the same order (the compiler checks this), so each message carries its
# call and the receiver checks that it is in the same one: a mismatch is a
# clear panic instead of a hang or a silently wrong result.
const OP_BARRIER = 1
const OP_SHIFT = 2
const OP_EXCHANGE = 3
const OP_BCAST = 4
const OP_GATHER = 5
const OP_SUM = 6
const OP_MIN = 7
const OP_MAX = 8
const OP_ANY = 9
const OP_ALL = 10
const OP_FINISH = 11

# The receiver reads through a buffer: one `recv` usually brings in several
# small messages, or one whole.
const RBUF = 65536

# struct addrinfo: ai_family, ai_socktype, ai_protocol, ai_addrlen, then
# ai_addr (at 24 on Linux, after ai_canonname at 32 on Windows and macOS)
const AI_FAMILY = 4
const AI_SOCKTYPE = 8
const AI_PROTOCOL = 12
const AI_ADDRLEN = 16

# Winsock, from ws2_32.dll once a program needs it: importing it would load
# it, and the DLLs it needs, into every program. Its functions' addresses:
const WS_STARTUP = 0
const WS_SOCKET = 8
const WS_SETSOCKOPT = 16
const WS_BIND = 24
const WS_LISTEN = 32
const WS_ACCEPT = 40
const WS_CONNECT = 48
const WS_GETADDRINFO = 56
const WS_FREEADDRINFO = 64
const WS_CLOSESOCKET = 72
const WS_SEND = 80
const WS_RECV = 88

extern fn LoadLibraryA(name: ptr) -> ptr

extern fn GetProcAddress(h: ptr, name: ptr) -> ptr

extern fn SetEnvironmentVariableA(name: ptr, v: ptr) -> i32

extern fn _putenv(s: ptr) -> i32

extern fn __acrt_iob_func(i: u32) -> ptr

extern fn _errno() -> ptr

extern fn __errno_location() -> ptr

extern fn __error() -> ptr

extern fn socket(fam: i32, ty: i32, proto: i32) -> i32

extern fn setsockopt(s: i32, level: i32, name: i32, v: ptr, n: u32) -> i32

extern fn bind(s: i32, a: ptr, n: u32) -> i32

extern fn listen(s: i32, n: i32) -> i32

extern fn accept(s: i32, a: ptr, n: ptr) -> i32

extern fn connect(s: i32, a: ptr, n: u32) -> i32

extern fn getaddrinfo(host: ptr, port: ptr, hints: ptr, res: ptr) -> i32

extern fn freeaddrinfo(a: ptr)

extern fn close(fd: i32) -> i32

extern fn send(s: i32, p: ptr, n: u64, flags: i32) -> int

extern fn recv(s: i32, p: ptr, n: u64, flags: i32) -> int

extern fn unsetenv(name: ptr) -> i32

extern fn signal(sig: i32, f: ptr) -> ptr

extern fn setvbuf(f: ptr, buf: ptr, mode: i32, n: u64) -> i32

extern fn fflush(f: ptr) -> i32

extern fn fwrite(p: ptr, size: u64, n: u64, f: ptr) -> u64

extern fn exit(code: i32)

extern fn strlen(s: ptr) -> u64

fn wd() -> ptr:
    return global_mem("world", 64)

fn brine_world_rank() -> int:
    return load_i64(wd(), WD_RANK)

fn brine_world_size() -> int:
    return load_i64(wd(), WD_SIZE)

fn brine_x_world_local_rank() -> int:
    return load_i64(wd(), WD_LOCAL)

fn peer(r: int) -> ptr:
    return load_ptr(wd(), WD_PEERS) + r * PR_SIZE

# a string literal as a C string
fn lit(s: str) -> ptr:
    return ptr_of(s) + STR_DATA

fn c_stderr() -> ptr:
    if os_is("windows"):
        return __acrt_iob_func(u32(2))
    elif os_is("macos"):
        return load_ptr(symbol("__stderrp"), 0)
    else:
        return load_ptr(symbol("stderr"), 0)

fn errno_val() -> int:
    if os_is("windows"):
        return int(load_i32(_errno(), 0))
    elif os_is("macos"):
        return int(load_i32(__error(), 0))
    else:
        return int(load_i32(__errno_location(), 0))

fn sleep_ms(ms: int):
    if os_is("windows"):
        Sleep(u32(ms))
    else:
        let ts = stack_mem(16)
        store_i64(ts, 0, ms / 1000)
        store_i64(ts, 8, (ms % 1000) * 1000000)
        nanosleep(ts, null_ptr())

# The C string at p as a new brine string.
fn c_str(p: ptr) -> str:
    return str_of(brine_str_new(p, int(strlen(p))))

fn err_out(s: str):
    let p = ptr_of(s)
    fwrite(p + STR_DATA, u64(1), load_u64(p, STR_LEN), c_stderr())

# a failure while starting: the message, then exit code 2
fn world_fail(s: str):
    err_out(s)
    exit(i32(2))

fn kind_name(k: int) -> str:
    if k == K_EMPTY:
        return "nothing"
    elif k == K_I64:
        return "int"
    elif k == K_F64:
        return "float"
    elif k == K_MSG:
        return "message"
    return "(internal)"

fn op_name(op: int) -> str:
    if op == OP_BARRIER:
        return "`world.barrier`"
    elif op == OP_SHIFT:
        return "`world.shift`"
    elif op == OP_EXCHANGE:
        return "`world.exchange`"
    elif op == OP_BCAST:
        return "`world.broadcast`"
    elif op == OP_GATHER:
        return "`world.gather_all`"
    elif op == OP_SUM:
        return "`world.sum`"
    elif op == OP_MIN:
        return "`world.min`"
    elif op == OP_MAX:
        return "`world.max`"
    elif op == OP_ANY:
        return "`world.any`"
    elif op == OP_ALL:
        return "`world.all`"
    elif op == OP_FINISH:
        return "the end of the program"
    return "(internal)"

# A panic, its message cut to 1023 bytes as the C runtime's buffer cuts it.
fn world_panic(loc: ptr, msg: str):
    let p = ptr_of(msg)
    if load_i64(p, STR_LEN) > 1023:
        panic_text_cold(loc, str_of(brine_str_new(p + STR_DATA, 1023)))
    panic_text_cold(loc, msg)

# the call this rank is in (collectives only run on the main thread)
fn coll(op: int, loc: ptr):
    let w = wd()
    store_i64(w, WD_OP, op)
    store_ptr(w, WD_SITE, loc)
    store_i64(w, WD_SEQ, load_i64(w, WD_SEQ) + 1)

fn cur_site() -> ptr:
    let s = load_ptr(wd(), WD_SITE)
    return lit("") if addr(s) == 0 else s

# ---- sockets: a SOCKET on Windows, a file descriptor elsewhere; -1 is none

fn ws(f: int) -> ptr:
    return load_ptr(global_mem("world_ws", 96), f)

fn ws_start():
    let t = global_mem("world_ws", 96)
    let h = LoadLibraryA(lit("ws2_32.dll"))
    if addr(h) == 0:
        world_fail("brine: could not load ws2_32.dll\n")
    store_ptr(t, WS_STARTUP, GetProcAddress(h, lit("WSAStartup")))
    store_ptr(t, WS_SOCKET, GetProcAddress(h, lit("socket")))
    store_ptr(t, WS_SETSOCKOPT, GetProcAddress(h, lit("setsockopt")))
    store_ptr(t, WS_BIND, GetProcAddress(h, lit("bind")))
    store_ptr(t, WS_LISTEN, GetProcAddress(h, lit("listen")))
    store_ptr(t, WS_ACCEPT, GetProcAddress(h, lit("accept")))
    store_ptr(t, WS_CONNECT, GetProcAddress(h, lit("connect")))
    store_ptr(t, WS_GETADDRINFO, GetProcAddress(h, lit("getaddrinfo")))
    store_ptr(t, WS_FREEADDRINFO, GetProcAddress(h, lit("freeaddrinfo")))
    store_ptr(t, WS_CLOSESOCKET, GetProcAddress(h, lit("closesocket")))
    store_ptr(t, WS_SEND, GetProcAddress(h, lit("send")))
    store_ptr(t, WS_RECV, GetProcAddress(h, lit("recv")))
    # version 2.2 (WSADATA takes 408 bytes)
    let wsa = stack_mem(512)
    call_i32(ws(WS_STARTUP), u16(514), wsa)

fn sk_socket(fam: i32, ty: i32, proto: i32) -> int:
    if os_is("windows"):
        return int(call_u64(ws(WS_SOCKET), fam, ty, proto))
    else:
        return int(socket(fam, ty, proto))

fn sk_close(s: int):
    if os_is("windows"):
        call_i32(ws(WS_CLOSESOCKET), u64(s))
    else:
        close(i32(s))

fn sk_setopt(s: int, level: i32, name: i32, v: int):
    let p = stack_mem(8)
    store_i32(p, 0, i32(v))
    if os_is("windows"):
        call_i32(ws(WS_SETSOCKOPT), u64(s), level, name, p, i32(4))
    else:
        setsockopt(i32(s), level, name, p, u32(4))

fn sk_bind(s: int, a: ptr, n: int) -> bool:
    if os_is("windows"):
        return call_i32(ws(WS_BIND), u64(s), a, i32(n)) == 0
    else:
        return bind(i32(s), a, u32(n)) == 0

fn sk_listen(s: int, n: int) -> bool:
    if os_is("windows"):
        return call_i32(ws(WS_LISTEN), u64(s), i32(n)) == 0
    else:
        return listen(i32(s), i32(n)) == 0

fn sk_accept(s: int) -> int:
    if os_is("windows"):
        return int(call_u64(ws(WS_ACCEPT), u64(s), null_ptr(), null_ptr()))
    else:
        return int(accept(i32(s), null_ptr(), null_ptr()))

fn sk_connect(s: int, a: ptr, n: int) -> bool:
    if os_is("windows"):
        return call_i32(ws(WS_CONNECT), u64(s), a, i32(n)) == 0
    else:
        return connect(i32(s), a, u32(n)) == 0

fn sk_getaddrinfo(host: ptr, port: ptr, hints: ptr, res: ptr) -> bool:
    if os_is("windows"):
        return call_i32(ws(WS_GETADDRINFO), host, port, hints, res) == 0
    else:
        return getaddrinfo(host, port, hints, res) == 0

fn sk_freeaddrinfo(a: ptr):
    if os_is("windows"):
        call_void(ws(WS_FREEADDRINFO), a)
    else:
        freeaddrinfo(a)

# n <= 2^30 bytes: how many went, or <= 0
fn sk_send(s: int, p: ptr, n: int) -> int:
    if os_is("windows"):
        return int(call_i32(ws(WS_SEND), u64(s), p, i32(n), i32(0)))
    elif os_is("linux"):
        # (MSG_NOSIGNAL: a closed peer is an error, not SIGPIPE)
        return send(i32(s), p, u64(n), i32(16384))
    else:
        return send(i32(s), p, u64(n), i32(0))

fn sk_recv(s: int, p: ptr, n: int) -> int:
    if os_is("windows"):
        return int(call_i32(ws(WS_RECV), u64(s), p, i32(n), i32(0)))
    else:
        return recv(i32(s), p, u64(n), i32(0))

# a call a signal interrupted (EINTR): try again
fn interrupted(r: int) -> bool:
    if os_is("windows"):
        return false
    else:
        return r < 0 and errno_val() == 4

fn write_all(s: int, p0: ptr, n0: int) -> bool:
    var p = p0
    var n = n0
    while n > 0:
        let w = sk_send(s, p, 1073741824 if n > 1073741824 else n)
        if w <= 0:
            if interrupted(w):
                continue
            return false
        p = p + w
        n -= w
    return true

fn read_all(s: int, p0: ptr, n0: int) -> bool:
    var p = p0
    var n = n0
    while n > 0:
        let r = sk_recv(s, p, 1073741824 if n > 1073741824 else n)
        if r <= 0:
            if interrupted(r):
                continue
            return false
        p = p + r
        n -= r
    return true

# what has arrived, at least one byte: 0 when the connection is closed
fn read_some(s: int, p: ptr, n: int) -> int:
    while true:
        let r = sk_recv(s, p, 1073741824 if n > 1073741824 else n)
        if interrupted(r):
            continue
        return r if r > 0 else 0
    return 0

# ---- the queues

fn enqueue(pr: ptr, m: ptr):
    store_ptr(m, MS_NEXT, null_ptr())
    lock(pr + PR_MU)
    let t = load_ptr(pr, PR_TAIL)
    if addr(t) != 0:
        store_ptr(t, MS_NEXT, m)
    else:
        store_ptr(pr, PR_HEAD, m)
    store_ptr(pr, PR_TAIL, m)
    cond_broadcast(pr + PR_CV)
    unlock(pr + PR_MU)

fn rd(pr: ptr, dst: ptr, n0: int) -> bool:
    var d = dst
    var n = n0
    let buf = load_ptr(pr, PR_RBUF)
    while n > 0:
        var pos = load_i64(pr, PR_RPOS)
        var end = load_i64(pr, PR_REND)
        if pos == end:
            if n >= RBUF:
                return read_all(load_i64(pr, PR_SOCK), d, n)
            let r = read_some(load_i64(pr, PR_SOCK), buf, RBUF)
            if r <= 0:
                return false
            pos = 0
            end = r
            store_i64(pr, PR_REND, r)
        let k = end - pos if end - pos < n else n
        copy_bytes(d, buf + pos, k)
        store_i64(pr, PR_RPOS, pos + k)
        d = d + k
        n -= k
    return true

fn brine_x_world_receiver(pr: ptr):
    store_ptr(pr, PR_RBUF, brine_alloc(RBUF))
    let hdr = stack_mem(40)
    while true:
        if not rd(pr, hdr, HDR):
            break
        let len = load_i64(hdr, 8)
        let slen = load_i64(hdr, 32)
        if len < 0 or slen < 0 or slen > 4096:
            break
        let m = blk_alloc(MS_DATA + len + slen)
        copy_bytes(m + MS_KIND, hdr, HDR)
        if len + slen != 0 and not rd(pr, m + MS_DATA, len + slen):
            blk_free(m)
            break
        enqueue(pr, m)
    lock(pr + PR_MU)
    atomic_store(pr + PR_CLOSED, 1)
    cond_broadcast(pr + PR_CV)
    unlock(pr + PR_MU)

fn check_rank(r: int, what: str, loc: ptr):
    let n = brine_world_size()
    if r < 0 or r >= n:
        world_panic(loc, f"{what} rank {r} is out of range (world size is {n})")

# A peer is gone. Usually it failed and printed why: give `brine run` time to
# stop this rank quietly, so that message is the one people see.
fn peer_lost(r: int, loc: ptr):
    brine_flush()
    sleep_ms(1000)
    let op = op_name(load_i64(wd(), WD_OP))
    world_panic(
        loc,
        f"rank {r} stopped before taking part in {op} (it finished or failed: see its messages)"
    )

fn world_send(dest: int, kind: int, data: ptr, len: int, loc: ptr):
    # what this rank printed so far comes out before anything another rank
    # prints after hearing from it (ranks share stdout, each with its own
    # buffer)
    brine_flush()
    let w = wd()
    let pr = peer(dest)
    let site = cur_site()
    var slen = int(strlen(site))
    if slen > 4096:
        slen = 4096
    if dest == load_i64(w, WD_RANK):
        let m = blk_alloc(MS_DATA + len + slen)
        store_i64(m, MS_KIND, kind)
        store_i64(m, MS_LEN, len)
        store_i64(m, MS_OP, load_i64(w, WD_OP))
        store_i64(m, MS_SEQ, load_i64(w, WD_SEQ))
        store_i64(m, MS_SLEN, slen)
        copy_bytes(m + MS_DATA, data, len)
        copy_bytes(m + MS_DATA + len, site, slen)
        enqueue(pr, m)
        return
    let s = load_i64(pr, PR_SOCK)
    var ok = false
    if len <= RBUF:
        # one `send`: each one costs a system call and often a packet
        let b = blk_alloc(HDR + len + slen)
        store_i64(b, 0, kind)
        store_i64(b, 8, len)
        store_i64(b, 16, load_i64(w, WD_OP))
        store_i64(b, 24, load_i64(w, WD_SEQ))
        store_i64(b, 32, slen)
        copy_bytes(b + HDR, data, len)
        copy_bytes(b + HDR + len, site, slen)
        lock(pr + PR_SEND_MU)
        ok = write_all(s, b, HDR + len + slen)
        unlock(pr + PR_SEND_MU)
        blk_free(b)
    else:
        let h = stack_mem(40)
        store_i64(h, 0, kind)
        store_i64(h, 8, len)
        store_i64(h, 16, load_i64(w, WD_OP))
        store_i64(h, 24, load_i64(w, WD_SEQ))
        store_i64(h, 32, slen)
        lock(pr + PR_SEND_MU)
        ok = (
            write_all(s, h, HDR)
            and write_all(s, data, len)
            and (slen == 0 or write_all(s, site, slen))
        )
        unlock(pr + PR_SEND_MU)
    if not ok:
        peer_lost(dest, loc)

# The other rank is in a different call than this one.
fn mismatch(src: int, m: ptr, loc: ptr):
    let w = wd()
    let cur = load_i64(w, WD_OP)
    let op = load_i64(m, MS_OP)
    let sl = load_i64(m, MS_SLEN)
    let sp = m + MS_DATA + load_i64(m, MS_LEN)
    let site = str_of(brine_str_new(sp, sl))
    if op == OP_FINISH:
        world_panic(
            loc,
            f"rank {src} has already finished ({site}), but this rank is in {op_name(cur)}"
        )
    if cur == OP_FINISH:
        world_panic(
            loc,
            f"this rank has finished, but rank {src} is still communicating: {op_name(op)} at {site}"
        )
    let here = cur_site()
    if op == cur and int(strlen(here)) == sl and memcmp(sp, here, u64(sl)) == 0:
        let theirs = load_i64(m, MS_SEQ)
        let ours = load_i64(w, WD_SEQ)
        world_panic(
            loc,
            f"mismatched communication: rank {src} is in a different call of {op_name(op)} here (its communication #{theirs}, this rank's #{ours})"
        )
    world_panic(
        loc,
        f"mismatched communication: this rank is in {op_name(cur)}, but rank {src} is in {op_name(op)} at {site}"
    )

fn world_recv(src: int, kind: int, loc: ptr) -> ptr:
    let pr = peer(src)
    # the message usually comes within microseconds: wait for it awake, as
    # waking a sleeping thread takes longer
    for _ in 0..SPINS:
        if atomic_load(pr + PR_HEAD) != 0 or atomic_load(pr + PR_CLOSED) != 0:
            break
        cpu_relax()
    lock(pr + PR_MU)
    while addr(load_ptr(pr, PR_HEAD)) == 0:
        if load_i64(pr, PR_CLOSED) != 0:
            unlock(pr + PR_MU)
            peer_lost(src, loc)
        cond_wait(pr + PR_CV, pr + PR_MU)
    let m = load_ptr(pr, PR_HEAD)
    store_ptr(pr, PR_HEAD, load_ptr(m, MS_NEXT))
    if load_ptr(pr, PR_TAIL) == m:
        store_ptr(pr, PR_TAIL, null_ptr())
    unlock(pr + PR_MU)
    let w = wd()
    let cur = load_i64(w, WD_OP)
    let op = load_i64(m, MS_OP)
    # returning from `main` and `exit` are the same call; and the same
    # operation from different lines is too (both branches of an `if` may
    # make it), so the site is only for the message
    var same = cur == OP_FINISH
    if op != OP_FINISH:
        same = op == cur and load_i64(m, MS_SEQ) == load_i64(w, WD_SEQ)
    if not same:
        mismatch(src, m, loc)
    let mk = load_i64(m, MS_KIND)
    if mk != kind:
        world_panic(
            loc,
            f"type mismatch: rank {src} sent {kind_name(mk)}, but this rank expects {kind_name(kind)}"
        )
    return m

# ---- starting

fn sock_connect(host: ptr, port: ptr) -> int:
    let hints = stack_mem(48)
    memset(hints, i32(0), u64(48))
    # AF_INET, SOCK_STREAM
    store_i32(hints, AI_FAMILY, i32(2))
    store_i32(hints, AI_SOCKTYPE, i32(1))
    let res = stack_mem(8)
    store_ptr(res, 0, null_ptr())
    if not sk_getaddrinfo(host, port, hints, res) or addr(load_ptr(res, 0)) == 0:
        return -1
    let ai = load_ptr(res, 0)
    let s = sk_socket(load_i32(ai, AI_FAMILY), load_i32(ai, AI_SOCKTYPE), load_i32(ai, AI_PROTOCOL))
    if s == -1:
        sk_freeaddrinfo(ai)
        return -1
    let sa = load_ptr(ai, 24 if os_is("linux") else 32)
    if not sk_connect(s, sa, int(load_u32(ai, AI_ADDRLEN))):
        sk_close(s)
        sk_freeaddrinfo(ai)
        return -1
    sk_freeaddrinfo(ai)
    return s

# SOL_SOCKET and its options SO_REUSEADDR, SO_SNDBUF, SO_RCVBUF
fn sol_socket() -> i32:
    return i32(1) if os_is("linux") else i32(65535)

fn so_reuseaddr() -> i32:
    return i32(2) if os_is("linux") else i32(4)

fn sk_nodelay(s: int):
    # IPPROTO_TCP, TCP_NODELAY
    sk_setopt(s, i32(6), i32(1), 1)
    sk_setopt(s, sol_socket(), i32(7) if os_is("linux") else i32(4097), 4194304)
    sk_setopt(s, sol_socket(), i32(8) if os_is("linux") else i32(4098), 4194304)

fn c_starts(s: ptr, pre: str) -> bool:
    let p = ptr_of(pre)
    for i in 0..load_i64(p, STR_LEN):
        if load_u8(s, i) != load_u8(p, STR_DATA + i):
            return false
    return true

fn c_eq(a: ptr, b: ptr) -> bool:
    var i = 0
    while true:
        let c = load_u8(a, i)
        if c != load_u8(b, i):
            return false
        if c == 0:
            return true
        i += 1
    return true

fn loopback(h: ptr) -> bool:
    return c_starts(h, "127.") or c_eq(h, lit("localhost"))

fn same_host(a: ptr, b: ptr) -> bool:
    return c_eq(a, b) or (loopback(a) and loopback(b))

# Processes this rank starts (`run`, `os.spawn`) are not part of its world.
fn world_unsetenv(name: str, assign: str):
    if os_is("windows"):
        _putenv(lit(assign))
        SetEnvironmentVariableA(lit(name), null_ptr())
    else:
        unsetenv(lit(name))

# stderr is buffered with several ranks: what `abort` would lose
fn brine_x_world_abort_flush(sig: i32):
    fflush(c_stderr())

# A world variable's number: only digits (at most 9 of them), else -1.
fn env_num(p: ptr) -> int:
    var n = 0
    var i = 0
    while load_u8(p, i) != 0:
        let c = int(load_u8(p, i))
        if c < 48 or c > 57 or i >= 9:
            return -1
        n = n * 10 + c - 48
        i += 1
    return n if i > 0 else -1

fn brine_x_world_init():
    let w = wd()
    store_i64(w, WD_SIZE, 1)
    let er = getenv(lit("BRINE_RANK"))
    let es = getenv(lit("BRINE_WORLD_SIZE"))
    let ep = getenv(lit("BRINE_PEERS"))
    if addr(er) == 0 and addr(es) == 0 and addr(ep) == 0:
        return
    # (whoever started this rank got them wrong: say so instead of crashing
    # or waiting for peers that never come)
    if addr(es) == 0:
        world_fail("brine: BRINE_RANK or BRINE_PEERS is set, but BRINE_WORLD_SIZE is not\n")
    let size = env_num(es)
    if size < 1:
        world_fail(f"brine: BRINE_WORLD_SIZE={c_str(es)} is not a positive number\n")
    var rank = 0
    if addr(er) != 0:
        rank = env_num(er)
        if rank < 0:
            world_fail(f"brine: BRINE_RANK={c_str(er)} is not a number\n")
        if rank >= size:
            world_fail(f"brine: BRINE_RANK={c_str(er)} is not below BRINE_WORLD_SIZE={c_str(es)}\n")
    elif size > 1:
        world_fail(f"brine: BRINE_WORLD_SIZE={c_str(es)} is set, but BRINE_RANK is not\n")
    if size > 1:
        if addr(ep) == 0:
            world_fail(f"brine: BRINE_WORLD_SIZE={c_str(es)} is set, but BRINE_PEERS is not\n")
        var n = 1
        var i = 0
        while load_u8(ep, i) != 0:
            if load_u8(ep, i) == 44:
                n += 1
            i += 1
        if n != size:
            world_fail(f"brine: BRINE_PEERS lists {n} ranks, but BRINE_WORLD_SIZE={c_str(es)}\n")
    var list = null_ptr()
    if size > 1:
        let ln = int(strlen(ep))
        list = malloc(u64(ln + 1))
        memcpy(list, ep, u64(ln + 1))
    world_unsetenv("BRINE_RANK", "BRINE_RANK=")
    world_unsetenv("BRINE_WORLD_SIZE", "BRINE_WORLD_SIZE=")
    world_unsetenv("BRINE_PEERS", "BRINE_PEERS=")
    let ef = getenv(lit("BRINE_EXIT_FILE"))
    if addr(ef) != 0:
        if size > 1:
            let n = int(strlen(ef))
            let cp = malloc(u64(n + 1))
            memcpy(cp, ef, u64(n + 1))
            store_ptr(global_mem("world_exit_file", 8), 0, cp)
        world_unsetenv("BRINE_EXIT_FILE", "BRINE_EXIT_FILE=")
    if size <= 1:
        return
    store_i64(w, WD_RANK, rank)
    store_i64(w, WD_SIZE, size)
    # ranks share stderr: write each message whole (panics and `eprint`
    # flush); (_IOFBF)
    setvbuf(c_stderr(), global_mem("world_errbuf", 16384), i32(0), u64(16384))
    # (SIGABRT)
    signal(i32(22) if os_is("windows") else i32(6), symbol("brine_x_world_abort_flush"))
    if os_is("windows"):
        ws_start()
    else:
        # (SIGPIPE, SIG_IGN)
        signal(i32(13), null_ptr() + 1)
    store_ptr(w, WD_PEERS, brine_x_calloc(size * PR_SIZE))
    let hosts = brine_x_calloc(size * 8)
    let ports = brine_x_calloc(size * 8)
    var p = list
    for i in 0..size:
        # an entry ends at a comma; the port is after its last colon
        var n = 0
        while load_u8(p, n) != 0 and load_u8(p, n) != 44:
            n += 1
        let more = load_u8(p, n) == 44
        store_u8(p, n, u8(0))
        var colon = n - 1
        while colon >= 0 and load_u8(p, colon) != 58:
            colon -= 1
        let pn = env_num(p + colon + 1) if colon >= 0 else -1
        if pn < 1 or pn > 65535:
            world_fail(f"brine: invalid BRINE_PEERS entry '{c_str(p)}' (expected host:port)\n")
        store_u8(p, colon, u8(0))
        store_ptr(hosts, i * 8, p)
        store_ptr(ports, i * 8, p + colon + 1)
        p = p + (n + 1 if more else n)
    let me = load_ptr(hosts, rank * 8)
    var local = 0
    for i in 0..rank:
        if same_host(load_ptr(hosts, i * 8), me):
            local += 1
    store_i64(w, WD_LOCAL, local)
    for i in 0..size:
        let pr = peer(i)
        lock_init(pr + PR_MU)
        lock_init(pr + PR_SEND_MU)
        cond_init(pr + PR_CV)
        store_i64(pr, PR_SOCK, -1)
    # listen on our own port
    let ls = sk_socket(i32(2), i32(1), i32(0))
    sk_setopt(ls, sol_socket(), so_reuseaddr(), 1)
    # when every rank is on this machine, listen on loopback only: nothing
    # outside can reach it, and firewalls don't ask about it
    var all_local = true
    for i in 0..size:
        if not loopback(load_ptr(hosts, i * 8)):
            all_local = false
    let myport = load_ptr(ports, rank * 8)
    let port = atoi(myport) & 65535
    # struct sockaddr_in: the family (after sin_len on macOS), then the port
    # and the address, in network byte order
    let sa = stack_mem(16)
    memset(sa, i32(0), u64(16))
    if os_is("macos"):
        store_u8(sa, 1, u8(2))
    else:
        store_u16(sa, 0, u16(2))
    store_u8(sa, 2, u8(port >> 8))
    store_u8(sa, 3, u8(port & 255))
    if all_local:
        store_u8(sa, 4, u8(127))
        store_u8(sa, 7, u8(1))
    if not sk_bind(ls, sa, 16) or not sk_listen(ls, size + 4):
        world_fail(f"brine: rank {rank} could not listen on port {c_str(myport)}\n")
    # connect to lower ranks
    let word = stack_mem(8)
    for r in 0..rank:
        let host = load_ptr(hosts, r * 8)
        let rport = load_ptr(ports, r * 8)
        var s = -1
        var attempt = 0
        while attempt < 600 and s == -1:
            s = sock_connect(host, rport)
            if s == -1:
                sleep_ms(50)
            attempt += 1
        if s == -1:
            world_fail(
                f"brine: rank {rank} could not connect to rank {r} at {c_str(host)}:{c_str(rport)}\n"
            )
        sk_nodelay(s)
        store_i64(word, 0, rank)
        write_all(s, word, 8)
        store_i64(peer(r), PR_SOCK, s)
    # accept higher ranks
    for _ in rank + 1..size:
        let s = sk_accept(ls)
        if s == -1:
            world_fail(f"brine: accept failed on rank {rank}\n")
        sk_nodelay(s)
        store_i64(word, 0, -1)
        read_all(s, word, 8)
        let who = load_i64(word, 0)
        if who <= rank or who >= size:
            world_fail(f"brine: bad handshake on rank {rank}\n")
        store_i64(peer(who), PR_SOCK, s)
    sk_close(ls)
    let th = stack_mem(8)
    for r in 0..size:
        if r != rank:
            thread_start(symbol("brine_x_world_receiver"), peer(r), th)
    free(hosts)
    free(ports)

# ---- collectives

# Dissemination barrier: log2(size) rounds, no rank in the middle.
fn barrier(loc: ptr):
    let rank = brine_world_rank()
    let size = brine_world_size()
    var k = 1
    while k < size:
        world_send((rank + k) % size, K_EMPTY, null_ptr(), 0, loc)
        blk_free(world_recv((rank - k + size) % size, K_EMPTY, loc))
        k <<= 1

fn brine_world_barrier(loc: ptr):
    if brine_world_size() <= 1:
        return
    coll(OP_BARRIER, loc)
    barrier(loc)

# The end of the program (returning from `main`, or `exit`): wait until
# every rank gets there, so no rank leaves while others still talk to it.
# `brine run` stops the other ranks when one fails; a rank in `exit` waits
# for them first, so it says so in the file BRINE_EXIT_FILE named
fn exit_record(code: int):
    let path = load_ptr(global_mem("world_exit_file", 8), 0)
    if addr(path) == u64(0) or brine_world_size() <= 1:
        return
    let f = os_fopen(path, "wb")
    if addr(f) == u64(0):
        return
    file_text(f, f"{code}")
    fclose(f)

fn brine_x_world_finish(how: ptr):
    let w = wd()
    if load_i64(w, WD_SIZE) <= 1 or load_i64(w, WD_DONE) != 0:
        return
    store_i64(w, WD_DONE, 1)
    coll(OP_FINISH, how)
    barrier(lit("<end of the program>"))

# Messages are encoded from a type description string, which the compiler
# derives from the static type: i = 64-bit int, 1/2/4/h = 8/16/32/128-bit
# int, f = float, g = f32, b = bool, s = str, a<T> = array of <T>. Every
# rank reaches the same collective call (the compiler checks this), so both
# sides always agree on the description.

# bytes per element in memory
fn desc_size(d: ptr) -> int:
    let c = load_u8(d, 0)
    # b, 1
    if c == 98 or c == 49:
        return 1
    elif c == 50:
        return 2
    # 4, g
    elif c == 52 or c == 103:
        return 4
    # h
    elif c == 104:
        return 16
    return 8

# a string or an array
fn desc_ref(d: ptr) -> bool:
    let c = load_u8(d, 0)
    return c == 115 or c == 97

# plain data, sent as it is
fn desc_plain(d: ptr) -> bool:
    let c = load_u8(d, 0)
    return c != 115 and c != 97 and c != 98

# the element functions of an array of d
fn desc_rt(d: ptr) -> ptr:
    let c = load_u8(d, 0)
    if c == 115:
        return symbol("brine_rt_str")
    elif c == 97:
        return symbol("brine_rt_arr")
    return null_ptr()

fn desc_rl(d: ptr) -> ptr:
    let c = load_u8(d, 0)
    if c == 115:
        return symbol("brine_rl_str")
    elif c == 97:
        return symbol("brine_rl_arr")
    return null_ptr()

fn sb_word(sb: ptr, x: int):
    store_i64(sb_room(sb, 8), 0, x)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + 8)

fn encode(sb: ptr, d: ptr, v: ptr):
    let c = load_u8(d, 0)
    if c == 98:
        sb_byte(sb, u8(1) if load_u8(v, 0) != 0 else u8(0))
    elif c == 115:
        let s = load_ptr(v, 0)
        let n = load_i64(s, STR_LEN)
        sb_word(sb, n)
        brine_sb_cat(sb, s + STR_DATA, n)
    elif c == 97:
        let a = load_ptr(v, 0)
        let n = load_i64(a, ARR_LEN)
        sb_word(sb, n)
        let e = d + 1
        let data = load_ptr(a, ARR_DATA)
        if desc_plain(e):
            brine_sb_cat(sb, data, n * desc_size(e))
        else:
            let esz = load_i64(a, ARR_ESZ)
            for i in 0..n:
                encode(sb, e, data + i * esz)
    else:
        brine_sb_cat(sb, v, desc_size(d))

# Decodes one value at p into `out` (an owned reference for strings and
# arrays); where the next one starts.
fn decode(p: ptr, d: ptr, out: ptr, loc: ptr) -> ptr:
    let c = load_u8(d, 0)
    if c == 98:
        store_u8(out, 0, u8(1) if load_u8(p, 0) != 0 else u8(0))
        return p + 1
    elif c == 115:
        let n = load_i64(p, 0)
        store_ptr(out, 0, brine_str_new(p + 8, n))
        return p + 8 + n
    elif c == 97:
        let n = load_i64(p, 0)
        let e = d + 1
        let a = brine_arr_new(n, desc_size(e), desc_rt(e), desc_rl(e), loc)
        let data = load_ptr(a, ARR_DATA)
        var q = p + 8
        if desc_plain(e):
            copy_bytes(data, q, n * desc_size(e))
            q = q + n * desc_size(e)
        else:
            let esz = load_i64(a, ARR_ESZ)
            for i in 0..n:
                q = decode(q, e, data + i * esz, loc)
        store_ptr(out, 0, a)
        return q
    let n = desc_size(d)
    copy_bytes(out, p, n)
    return p + n

# a copy of the value at v in `out`, taking a new reference
fn copy_val(d: ptr, v: ptr, out: ptr):
    copy_bytes(out, v, desc_size(d))
    let c = load_u8(d, 0)
    if c == 115:
        str_retain(load_ptr(out, 0))
    elif c == 97:
        arr_retain(load_ptr(out, 0))

fn put(dest: int, d: ptr, v: ptr, loc: ptr):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    encode(sb, d, v)
    world_send(dest, K_MSG, load_ptr(sb, SB_P), load_i64(sb, SB_LEN), loc)
    blk_free(load_ptr(sb, SB_P))

fn take(src: int, d: ptr, out: ptr, loc: ptr):
    let m = world_recv(src, K_MSG, loc)
    decode(m + MS_DATA, d, out, loc)
    blk_free(m)

fn brine_world_shift(d: ptr, v: ptr, out: ptr, by: int, loc: ptr):
    let size = brine_world_size()
    if size <= 1:
        copy_val(d, v, out)
        return
    coll(OP_SHIFT, loc)
    # (`%` takes the divisor's sign)
    let k = by % size
    if k == 0:
        copy_val(d, v, out)
        return
    let rank = brine_world_rank()
    put((rank + k) % size, d, v, loc)
    take((rank - k + size) % size, d, out, loc)

# `world.shift(v, by, edge)`: no wrapping around; a rank with no rank `by`
# before it (rank - by is outside the world) gets `edge`.
fn brine_world_shift_edge(d: ptr, v: ptr, out: ptr, by: int, edge: ptr, loc: ptr):
    let size = brine_world_size()
    if size > 1:
        coll(OP_SHIFT, loc)
    if by == 0:
        copy_val(d, v, out)
        return
    if by >= size or by <= -size:
        copy_val(d, edge, out)
        return
    let rank = brine_world_rank()
    let to = rank + by
    let from = rank - by
    if to >= 0 and to < size:
        put(to, d, v, loc)
    if from >= 0 and from < size:
        take(from, d, out, loc)
    else:
        copy_val(d, edge, out)

fn brine_world_exchange(ed: ptr, xs: ptr, loc: ptr) -> ptr:
    let size = brine_world_size()
    let n = load_i64(xs, ARR_LEN)
    if n != size:
        world_panic(
            loc,
            f"world.exchange needs one element per rank: got {n} elements, but the world size is {size}"
        )
    let res = brine_arr_new(size, desc_size(ed), desc_rt(ed), desc_rl(ed), loc)
    if size > 1:
        coll(OP_EXCHANGE, loc)
    let rank = brine_world_rank()
    let xd = load_ptr(xs, ARR_DATA)
    let xe = load_i64(xs, ARR_ESZ)
    let rdata = load_ptr(res, ARR_DATA)
    let re = load_i64(res, ARR_ESZ)
    # everyone sends to a different rank at each step
    for k in 1..size:
        let j = (rank + k) % size
        put(j, ed, xd + j * xe, loc)
    copy_val(ed, xd + rank * xe, rdata + rank * re)
    for k in 1..size:
        let j = (rank - k + size) % size
        take(j, ed, rdata + j * re, loc)
    return res

# Binomial tree from `root`: log2(size) rounds; the encoded bytes are
# forwarded as they are.
fn brine_world_bcast(d: ptr, v: ptr, out: ptr, root: int, loc: ptr):
    check_rank(root, "root", loc)
    let size = brine_world_size()
    if size <= 1:
        copy_val(d, v, out)
        return
    coll(OP_BCAST, loc)
    let rank = brine_world_rank()
    let sb = stack_mem(24)
    var data = null_ptr()
    var len = 0
    var got = null_ptr()
    if rank == root:
        brine_sb_init(sb)
        encode(sb, d, v)
        data = load_ptr(sb, SB_P)
        len = load_i64(sb, SB_LEN)
    let vr = (rank - root + size) % size
    var mask = 1
    while mask < size:
        if (vr & mask) != 0:
            got = world_recv((rank - mask + size) % size, K_MSG, loc)
            data = got + MS_DATA
            len = load_i64(got, MS_LEN)
            break
        mask <<= 1
    mask >>= 1
    while mask > 0:
        if vr + mask < size:
            world_send((rank + mask) % size, K_MSG, data, len, loc)
        mask >>= 1
    if rank == root:
        copy_val(d, v, out)
        blk_free(data)
    else:
        decode(data, d, out, loc)
        blk_free(got)

# Every rank gets [v from rank 0, v from rank 1, ...]. Each rank encodes
# its value once. Strings and arrays (which can be large) go straight to
# every other rank, staggered so no rank is sent to by all at once: the
# data moves over all connections at the same time. Fixed-size values,
# where the number of messages matters more, use Bruck's algorithm: in
# round k each rank sends all it has (up to 2^k values) to the rank 2^k
# below and gets as much from the rank 2^k above, so log2(size) rounds.
# The choice depends on the type only, so every rank makes the same one.
fn brine_world_gather(ed: ptr, v: ptr, loc: ptr) -> ptr:
    let size = brine_world_size()
    let res = brine_arr_new(size, desc_size(ed), desc_rt(ed), desc_rl(ed), loc)
    let rdata = load_ptr(res, ARR_DATA)
    let re = load_i64(res, ARR_ESZ)
    if size <= 1:
        copy_val(ed, v, rdata)
        return res
    coll(OP_GATHER, loc)
    let rank = brine_world_rank()
    let b = stack_mem(24)
    brine_sb_init(b)
    encode(b, ed, v)
    if desc_ref(ed):
        copy_val(ed, v, rdata + rank * re)
        for k in 1..size:
            world_send((rank + k) % size, K_MSG, load_ptr(b, SB_P), load_i64(b, SB_LEN), loc)
        blk_free(load_ptr(b, SB_P))
        for k in 1..size:
            let j = (rank - k + size) % size
            take(j, ed, rdata + j * re, loc)
        return res
    # Bruck: rank r collects the values of ranks r, r+1, ... (mod size);
    # offs holds where each collected value starts in b, offs[n] the end
    let offs = brine_alloc((size + 1) * 8)
    store_i64(offs, 0, 0)
    store_i64(offs, 8, load_i64(b, SB_LEN))
    var n = 1
    let out = stack_mem(24)
    var d = 1
    while d < size:
        let c = d if d < size - d else size - d
        # the first c values: their lengths, then their bytes
        brine_sb_init(out)
        for i in 0..c:
            sb_word(out, load_i64(offs, (i + 1) * 8) - load_i64(offs, i * 8))
        brine_sb_cat(out, load_ptr(b, SB_P), load_i64(offs, c * 8))
        let to = (rank - d + size) % size
        world_send(to, K_MSG, load_ptr(out, SB_P), load_i64(out, SB_LEN), loc)
        blk_free(load_ptr(out, SB_P))
        let from = (rank + d) % size
        let m = world_recv(from, K_MSG, loc)
        let ml = load_i64(m, MS_LEN)
        var got = ml - c * 8
        var i = 0
        while i < c and got >= 0:
            let l = load_i64(m, MS_DATA + i * 8)
            got -= l
            store_i64(offs, (n + i + 1) * 8, load_i64(offs, (n + i) * 8) + l)
            i += 1
        if got != 0:
            world_panic(loc, f"`world.gather_all`: malformed message from rank {from}")
        brine_sb_cat(b, m + MS_DATA + c * 8, ml - c * 8)
        blk_free(m)
        n += c
        d <<= 1
    let bp = load_ptr(b, SB_P)
    for i in 0..size:
        decode(bp + load_i64(offs, i * 8), ed, rdata + ((rank + i) % size) * re, loc)
    brine_free(offs)
    blk_free(bp)
    return res

# ---- reductions
# Recursive doubling: in each round, partners combine (lower ranks' part,
# upper ranks' part) in that order, so every rank computes exactly the same
# operations and ends with bit-identical results. With a world size that
# isn't a power of two, the ranks above it first hand their value to a
# partner below and get the result back at the end.

# op: 0 sum, 1 min, 2 max, 3 any, 4 all (on 0/1)
fn red_op(op: i32) -> int:
    if op >= 0 and op < 5:
        return OP_SUM + int(op)
    return OP_SUM

# out[i] = lo[i] (op) hi[i]; `fl`: floats, else ints
fn combine(op: i32, fl: bool, lo: ptr, hi: ptr, out: ptr, n: int, loc: ptr):
    for i in 0..n:
        if fl:
            let a = load_f64(lo, i * 8)
            let b = load_f64(hi, i * 8)
            var r = 0.0
            if op == 0:
                r = a + b
            elif op == 1:
                r = b if b < a else a
            else:
                r = b if b > a else a
            store_f64(out, i * 8, r)
        else:
            let a = load_i64(lo, i * 8)
            let b = load_i64(hi, i * 8)
            var r = 0
            if op == 0:
                r = brine_x_add_i64(a, b, loc)
            elif op == 1 or op == 4:
                r = b if b < a else a
            else:
                r = b if b > a else a
            store_i64(out, i * 8, r)

# the partner's part, into tmp
fn red_take(src: int, kind: int, tmp: ptr, n: int, loc: ptr):
    let m = world_recv(src, kind, loc)
    let ml = load_i64(m, MS_LEN)
    if ml != n * 8:
        let op = op_name(load_i64(wd(), WD_OP))
        world_panic(
            loc,
            f"{op}: rank {src} has {ml / 8} elements, but this rank has {n} (arrays must be the same length on every rank)"
        )
    copy_bytes(tmp, m + MS_DATA, ml)
    blk_free(m)

# combines the n elements at acc across all ranks, in place
fn allreduce(acc: ptr, n: int, fl: bool, op: i32, loc: ptr):
    let rank = brine_world_rank()
    let size = brine_world_size()
    let kind = K_F64 if fl else K_I64
    let bytes = n * 8
    var p2 = 1
    while p2 * 2 <= size:
        p2 *= 2
    let extra = size - p2
    let tmp = blk_alloc(bytes if bytes > 0 else 1)
    if rank >= p2:
        world_send(rank - p2, kind, acc, bytes, loc)
        red_take(rank - p2, kind, tmp, n, loc)
        copy_bytes(acc, tmp, bytes)
        blk_free(tmp)
        return
    if rank < extra:
        red_take(rank + p2, kind, tmp, n, loc)
        combine(op, fl, acc, tmp, acc, n, loc)
    var mask = 1
    while mask < p2:
        let partner = rank ^ mask
        world_send(partner, kind, acc, bytes, loc)
        red_take(partner, kind, tmp, n, loc)
        if rank < partner:
            combine(op, fl, acc, tmp, acc, n, loc)
        else:
            combine(op, fl, tmp, acc, acc, n, loc)
        mask <<= 1
    if rank < extra:
        world_send(rank + p2, kind, acc, bytes, loc)
    blk_free(tmp)

fn brine_world_reduce_i64(v: int, op: i32, loc: ptr) -> int:
    if brine_world_size() <= 1:
        return v
    coll(red_op(op), loc)
    let acc = stack_mem(8)
    store_i64(acc, 0, v)
    allreduce(acc, 1, false, op, loc)
    return load_i64(acc, 0)

fn brine_world_reduce_f64(v: float, op: i32, loc: ptr) -> float:
    if brine_world_size() <= 1:
        return v
    coll(red_op(op), loc)
    let acc = stack_mem(8)
    store_f64(acc, 0, v)
    allreduce(acc, 1, true, op, loc)
    return load_f64(acc, 0)

# element by element over `[int]` (ed "i") or `[float]` (ed "f"); a new array
fn brine_world_reduce_arr(ed: ptr, xs: ptr, op: i32, loc: ptr) -> ptr:
    let n = load_i64(xs, ARR_LEN)
    let res = brine_arr_new(n, 8, null_ptr(), null_ptr(), loc)
    copy_bytes(load_ptr(res, ARR_DATA), load_ptr(xs, ARR_DATA), n * 8)
    if brine_world_size() <= 1:
        return res
    coll(red_op(op), loc)
    allreduce(load_ptr(res, ARR_DATA), n, load_u8(ed, 0) == 102, op, loc)
    return res

# ---------------------------------------------------------------- GPU

# `par` constructs whose bodies only compute (ptx.br decides, at compile
# time) can run on a GPU: NVIDIA's through CUDA, Apple's through Metal. The
# driver or framework is loaded when first needed: there's no toolkit or
# link-time dependency, and without a GPU everything runs on the thread pool.
#
# Results are the same either way: kernels compute exactly what the CPU code
# does (ptx.br, msl.br), reductions combine in the same tree, and a failing
# check on the device (overflow, an index, ...) discards the device's work
# and runs the construct on the CPU, which reports the error as usual.
#
# BRINE_GPU=off|on|auto (default auto): auto uses the GPU when the estimate
# says it's faster (the CPU's speed measured on the first elements, the
# GPU's after its first run, the copies at the measured bandwidth); on uses
# it for every construct it can run. BRINE_GPU_LOG=1 prints where each
# construct ran, and how long it took, to stderr.
#
# Device calls return 0 or an error dev_err describes (a C int: CUresult);
# device pointers are addresses the kernels use as they are.

const GPU_OOM: i32 = 2
const GPU_OFF = 0
const GPU_AUTO = 1
const GPU_ON = 2
const GS_NONE = 0
const GS_INIT = 1
const GS_READY = 2
const GS_FAILED = 3

# threads per block: the combine kernels' fan-in (BLOCK in ptx.br)
const GPU_BLOCK = 256
# smallest construct auto considers (elements)
const GPU_MIN_N = 4096
# a launch should take about this long (seconds): Windows resets a GPU
# whose kernel runs for 2 s
const GPU_SLICE = 0.03
# how much one hardware thread adds to the pool's speed: most CPUs run two
# threads per core
const CPU_EFF = 0.5
# arrays up to this many bytes are copied with the context, in one piece
const GPU_SMALL = 65536
# BRINE_LEAF (brine_rt.h)
const LEAF = 16

# the runtime's GPU state (br_gpu in the C): locks, then the fields `mu`
# guards; `run` is held while the device is in use
const G_MU = 0
const G_CV = 64
const G_RUN = 128
const G_MODE = 192
const G_LOG = 200
const G_STATE = 208
const G_PTX = 216
# the error flag kernels set (a device address)
const G_ERR = 224
const G_BUF = 232
const G_CAP = 240
const G_STAGE = 248
const G_STAGE_CAP = 256
const G_PINNED = 264
# bytes per second, host <-> device
const G_BW = 272
# how long getting the device ready takes
const G_INIT_S = 280
const G_SMS = 288
# how much faster than one CPU thread at f32 and integer code; at f64 code
const G_SPEED = 296
const G_F64 = 304
const G_WHY = 312
const G_NAME = 568
const WHY_SIZE = 256
const NAME_SIZE = 128

# brine_kernel (brine_rt.h)
const K_PTX = 0
const K_ENTRY = 8
const K_WHERE = 16
const K_KIND = 24
const K_OP = 32
const K_VK = 40
const K_CTX_SIZE = 48
const K_PTRS = 56
const K_COST = 64
const K_COST64 = 72
const K_COMB = 80
const K_STATE = 88
const K_WHY = 96

# what the runtime learned about one construct (k.state): its kernels, and
# per element: one CPU thread, the thread pool, the device (0: not
# measured); `seen`: the pool's time was measured, not estimated
const KS_FN = 0
const KS_COMB = 8
const KS_SEQ = 16
const KS_CPU = 24
const KS_GPU = 32
const KS_SEEN = 40
# planning its copies, per element (ns): walking arrays of arrays visits
# every inner array
const KS_PLAN = 48
const KS_SIZE = 56

# a reduction's partial tree (F_* in "the process")
const FOLD_SIZE = 1840

extern fn strcmp(a: ptr, b: ptr) -> i32

extern fn strncmp(a: ptr, b: ptr, n: u64) -> i32

extern fn strtoull(s: ptr, end: ptr, base: i32) -> u64

extern fn strdup(s: ptr) -> ptr

extern fn dlopen(name: ptr, flags: i32) -> ptr

extern fn dlsym(lib: ptr, name: ptr) -> ptr

fn gpu() -> ptr:
    return global_mem("gpu", 704)

# a literal as a C string
fn cz(s: str) -> ptr:
    return ptr_of(s) + STR_DATA

fn cstr_is(p: ptr, s: str) -> bool:
    return strcmp(p, cz(s)) == 0

fn sb_c(sb: ptr, p: ptr):
    brine_sb_cat(sb, p, int(strlen(p)))

# printf's %.<most>s
fn sb_cmax(sb: ptr, p: ptr, most: int):
    var n = 0
    while n < most and load_u8(p, n) != 0:
        n += 1
    brine_sb_cat(sb, p, n)

# A finished message (and its builder freed) to the buffer of `size`
# bytes at d, cut short as snprintf would.
fn sb_to(sb: ptr, d: ptr, size: int):
    var n = load_i64(sb, SB_LEN)
    if n > size - 1:
        n = size - 1
    memcpy(d, load_ptr(sb, SB_P), u64(n))
    store_u8(d, n, 0)
    blk_free(load_ptr(sb, SB_P))

fn why_lit(d: ptr, s: str):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, s)
    sb_to(sb, d, WHY_SIZE)

fn why_c(d: ptr, s: str, p: ptr):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, s)
    sb_c(sb, p)
    sb_to(sb, d, WHY_SIZE)

fn err_write(p: ptr, n: int):
    var i = 0
    while i < n:
        var w = 0
        if os_is("windows"):
            w = int(_write(i32(2), p + i, u32(n - i)))
        else:
            w = write(i32(2), p + i, u64(n - i))
        if w <= 0:
            return
        i += w

# "brine gpu: [rank r: ]<the message>" on stderr (and the builder freed)
fn gpu_log(sb: ptr):
    let o = stack_mem(24)
    brine_sb_init(o)
    sb_lit(o, "brine gpu: ")
    if brine_world_size() > 1:
        sb_lit(o, f"rank {brine_world_rank()}: ")
    brine_sb_cat(o, load_ptr(sb, SB_P), load_i64(sb, SB_LEN))
    sb_byte(o, 10)
    blk_free(load_ptr(sb, SB_P))
    brine_x_io_lock()
    err_write(load_ptr(o, SB_P), load_i64(o, SB_LEN))
    brine_x_io_unlock()
    blk_free(load_ptr(o, SB_P))

fn gpu_logging() -> bool:
    return load_i64(gpu(), G_LOG) != 0

fn gpu_mode() -> int:
    return load_i64(gpu(), G_MODE)

fn gpu_state() -> int:
    return atomic_load(gpu() + G_STATE)

# (brine_rt_init, once)
fn brine_x_gpu_setup():
    let g = gpu()
    lock_init(g + G_MU)
    lock_init(g + G_RUN)
    cond_init(g + G_CV)
    let m = getenv(cz("BRINE_GPU"))
    var mode = GPU_AUTO
    if addr(m) != 0 and (cstr_is(m, "off") or cstr_is(m, "0")):
        mode = GPU_OFF
    if addr(m) != 0 and (cstr_is(m, "on") or cstr_is(m, "1")):
        mode = GPU_ON
    store_i64(g, G_MODE, mode)
    let l = getenv(cz("BRINE_GPU_LOG"))
    let on = addr(l) != 0 and load_u8(l, 0) != 0 and not cstr_is(l, "0")
    store_i64(g, G_LOG, 1 if on else 0)
    store_f64(g, G_BW, 8.0e9)
    store_f64(g, G_INIT_S, 0.3)
    store_f64(g, G_SPEED, 150.0)
    store_f64(g, G_F64, 40.0)

# "; cpu estimate X ms" for the log, or nothing when the CPU time isn't
# known yet (BRINE_GPU=on sends work to the GPU before the CPU has run any)
fn sb_cpu_est(sb: ptr, cpu_s: float):
    if cpu_s <= 0.0:
        return
    sb_lit(sb, f"; cpu estimate {cpu_s * 1.0e3:.3f} ms")

# Which of the machine's n GPUs this rank uses, or -1. Ranks sharing a GPU
# would queue for it and each run slower than the CPU it gave up, so in
# auto mode the k-th rank on a machine gets GPU k, and the ranks beyond the
# GPUs stay on the CPU; BRINE_GPU=on shares them out round-robin.
fn gpu_ordinal(n: int, why: ptr) -> int:
    if n <= 0:
        return -1
    let r = brine_x_world_local_rank()
    if r < n:
        return r
    if gpu_mode() == GPU_ON:
        return r % n
    let sb = stack_mem(24)
    brine_sb_init(sb)
    let s1 = "" if r == 1 else "s"
    let s2 = "s" if r == 1 else ""
    let s3 = "" if n == 1 else "s"
    sb_lit(
        sb,
        f"{r} lower rank{s1} on this machine use{s2} its {n} GPU{s3} (one rank per GPU; BRINE_GPU=on shares them)"
    )
    sb_to(sb, why, WHY_SIZE)
    return -1

# ---- CUDA: the driver is loaded when first needed (nvcuda.dll,
# libcuda.so.1), and JIT-compiles the program's PTX (ptx.br)

# the driver's functions, then the context and the module
const CU_INIT = 0
const CU_COUNT = 8
const CU_GET = 16
const CU_ATTR = 24
const CU_NAME = 32
const CU_RETAIN = 40
const CU_SET_CUR = 48
const CU_SYNC = 56
const CU_LOAD = 64
const CU_FUNC = 72
const CU_GLOBAL = 80
const CU_ALLOC = 88
const CU_FREE = 96
const CU_HALLOC = 104
const CU_HFREE = 112
const CU_HTOD = 120
const CU_DTOH = 128
const CU_SET = 136
const CU_LAUNCH = 144
const CU_ERRSTR = 152
const CU_CTX = 160
const CU_MOD = 168

# CU_DEVICE_ATTRIBUTE_*, CU_JIT_*
const CU_ATTR_SMS: i32 = 16
const CU_ATTR_CC_MAJOR: i32 = 75
const CU_ATTR_CC_MINOR: i32 = 76
const CU_JIT_ERROR_LOG = 5
const CU_JIT_ERROR_LOG_SIZE = 6

fn cu() -> ptr:
    return global_mem("gpu_cu", 176)

fn cu_fn(off: int) -> ptr:
    return load_ptr(cu(), off)

fn cu_err(r: i32) -> ptr:
    let s = stack_mem(8)
    store_ptr(s, 0, null_ptr())
    let f = cu_fn(CU_ERRSTR)
    if addr(f) != 0:
        call_i32(f, r, s)
    let p = load_ptr(s, 0)
    return p if addr(p) != 0 else cz("unknown CUDA error")

fn cu_open() -> ptr:
    if os_is("windows"):
        return LoadLibraryA(cz("nvcuda.dll"))
    else:
        # RTLD_NOW | RTLD_LOCAL
        let h = dlopen(cz("libcuda.so.1"), i32(2))
        return h if addr(h) != 0 else dlopen(cz("libcuda.so"), i32(2))

fn cu_sym(lib: ptr, name: ptr) -> ptr:
    if os_is("windows"):
        return GetProcAddress(lib, name)
    else:
        return dlsym(lib, name)

fn cu_load(lib: ptr, off: int, name: str, why: ptr) -> bool:
    let f = cu_sym(lib, cz(name))
    store_ptr(cu(), off, f)
    if addr(f) == 0:
        let sb = stack_mem(24)
        brine_sb_init(sb)
        sb_lit(sb, f"the CUDA driver has no {name}")
        sb_to(sb, why, WHY_SIZE)
        return false
    return true

# Loads the driver, picks the device and JIT-compiles the program's PTX. On
# failure, `why` says what's missing. Called without the state's lock.
fn cu_open_dev(ptx: ptr, why: ptr) -> bool:
    let lib = cu_open()
    if addr(lib) == 0:
        why_lit(why, "no CUDA driver")
        return false
    if not cu_load(lib, CU_INIT, "cuInit", why):
        return false
    if not cu_load(lib, CU_COUNT, "cuDeviceGetCount", why):
        return false
    if not cu_load(lib, CU_GET, "cuDeviceGet", why):
        return false
    if not cu_load(lib, CU_ATTR, "cuDeviceGetAttribute", why):
        return false
    if not cu_load(lib, CU_NAME, "cuDeviceGetName", why):
        return false
    if not cu_load(lib, CU_RETAIN, "cuDevicePrimaryCtxRetain", why):
        return false
    if not cu_load(lib, CU_SET_CUR, "cuCtxSetCurrent", why):
        return false
    if not cu_load(lib, CU_SYNC, "cuCtxSynchronize", why):
        return false
    if not cu_load(lib, CU_LOAD, "cuModuleLoadDataEx", why):
        return false
    if not cu_load(lib, CU_FUNC, "cuModuleGetFunction", why):
        return false
    if not cu_load(lib, CU_GLOBAL, "cuModuleGetGlobal_v2", why):
        return false
    if not cu_load(lib, CU_ALLOC, "cuMemAlloc_v2", why):
        return false
    if not cu_load(lib, CU_FREE, "cuMemFree_v2", why):
        return false
    if not cu_load(lib, CU_HALLOC, "cuMemAllocHost_v2", why):
        return false
    if not cu_load(lib, CU_HFREE, "cuMemFreeHost", why):
        return false
    if not cu_load(lib, CU_HTOD, "cuMemcpyHtoD_v2", why):
        return false
    if not cu_load(lib, CU_DTOH, "cuMemcpyDtoH_v2", why):
        return false
    if not cu_load(lib, CU_SET, "cuMemsetD8_v2", why):
        return false
    if not cu_load(lib, CU_LAUNCH, "cuLaunchKernel", why):
        return false
    if not cu_load(lib, CU_ERRSTR, "cuGetErrorString", why):
        return false
    if strncmp(ptx, cz("// brine metal"), 14) == 0:
        why_lit(why, "the program was built for Metal")
        return false
    let g = gpu()
    let c = cu()
    # (CUdevice and the attributes are C ints)
    let v = stack_mem(16)
    store_i64(v, 0, 0)
    store_i64(v, 8, 0)
    var r = call_i32(cu_fn(CU_INIT), u32(0))
    if r == 0:
        r = call_i32(cu_fn(CU_COUNT), v)
    if r != 0:
        why_c(why, "cuInit: ", cu_err(r))
        return false
    let n = int(load_i32(v, 0))
    if n <= 0:
        why_lit(why, "no CUDA device")
        return false
    let ord = gpu_ordinal(n, why)
    if ord < 0:
        return false
    if call_i32(cu_fn(CU_GET), v + 4, i32(ord)) != 0:
        let sb = stack_mem(24)
        brine_sb_init(sb)
        sb_lit(sb, f"no CUDA device {ord}")
        sb_to(sb, why, WHY_SIZE)
        return false
    let dev = load_i32(v, 4)
    let at = stack_mem(16)
    store_i64(at, 0, 0)
    store_i64(at, 8, 0)
    call_i32(cu_fn(CU_ATTR), at, CU_ATTR_CC_MAJOR, dev)
    call_i32(cu_fn(CU_ATTR), at + 4, CU_ATTR_CC_MINOR, dev)
    let major = load_i32(at, 0)
    let minor = load_i32(at, 4)
    # x.0 data-center parts (P100, V100, A100, H100, B200) run f64 at half
    # the f32 rate; the others at 1/32 or 1/64
    if minor == 0 and major >= 6:
        store_f64(g, G_F64, 75.0)
    call_i32(cu_fn(CU_ATTR), at + 8, CU_ATTR_SMS, dev)
    store_i64(g, G_SMS, int(load_i32(at, 8)))
    call_i32(cu_fn(CU_NAME), g + G_NAME, i32(NAME_SIZE), dev)
    if major < 5:
        let sb = stack_mem(24)
        brine_sb_init(sb)
        sb_c(sb, g + G_NAME)
        sb_lit(sb, " is older than compute capability 5.0")
        sb_to(sb, why, WHY_SIZE)
        return false
    r = call_i32(cu_fn(CU_RETAIN), c + CU_CTX, dev)
    if r == 0:
        r = call_i32(cu_fn(CU_SET_CUR), load_ptr(c, CU_CTX))
    if r != 0:
        why_c(why, "no CUDA context: ", cu_err(r))
        return false
    let log = global_mem("gpu_cu_log", 4096)
    let opts = stack_mem(8)
    store_i32(opts, 0, i32(CU_JIT_ERROR_LOG))
    store_i32(opts, 4, i32(CU_JIT_ERROR_LOG_SIZE))
    let vals = stack_mem(16)
    store_ptr(vals, 0, log)
    store_i64(vals, 8, 4096)
    r = call_i32(cu_fn(CU_LOAD), c + CU_MOD, ptx, u32(2), opts, vals)
    if r != 0:
        let sb = stack_mem(24)
        brine_sb_init(sb)
        sb_lit(sb, "the PTX doesn't compile (")
        sb_c(sb, cu_err(r))
        sb_lit(sb, "): ")
        sb_cmax(sb, log, 180)
        sb_to(sb, why, WHY_SIZE)
        return false
    let sz = stack_mem(8)
    r = call_i32(cu_fn(CU_GLOBAL), g + G_ERR, sz, load_ptr(c, CU_MOD), cz("brine_gpu_err"))
    if r != 0:
        why_c(why, "cuModuleGetGlobal: ", cu_err(r))
        return false
    return true

fn cu_launch(f: ptr, blocks: int, args: ptr, nargs: int) -> i32:
    let p = stack_mem(64)
    var i = 0
    while i < nargs and i < 8:
        store_ptr(p, i * 8, args + i * 8)
        i += 1
    let one = u32(1)
    let r = call_i32(
        cu_fn(CU_LAUNCH),
        f,
        u32(blocks),
        one,
        one,
        u32(GPU_BLOCK),
        one,
        one,
        u32(0),
        null_ptr(),
        p,
        null_ptr()
    )
    return r if r != 0 else call_i32(cu_fn(CU_SYNC))

# ---- Metal (macOS), through the Objective-C runtime: the frameworks are
# loaded when first needed, so there's nothing to link. The program's module
# is MSL source (msl.br); "// stack N" on its second line is the device
# stack each thread needs. Memory is shared with the CPU, so copies are
# memcpy. Every objc_msgSend is called with the C's argument types for that
# message.

const M_CLS = 0
const M_SEL = 8
const M_MSG = 16
const M_PUSH = 24
const M_POP = 32
const M_DEV = 40
const M_QUEUE = 48
const M_LIB = 56
# the main buffer, the error flag's, the stack's; their GPU addresses
const M_BUF = 64
const M_FLAG = 72
const M_STK = 80
const M_BUF_AT = 88
const M_FLAG_AT = 96
const M_STK_AT = 104
const M_BUF_MEM = 112
const M_FLAG_MEM = 120
const M_BUF_LEN = 128
const M_STK_LEN = 136
const M_STACK = 144
# the kernels: (name, pipeline state) pairs
const M_FNS = 152
const M_NFNS = 160
const M_ERR = 168

const MTL_FAIL: i32 = 1
const MTL_STATUS_ERROR: u64 = 5
const MTL_KERNEL: u64 = 3
const MTL_MATH_SAFE = 0
const MTL_FUNCTIONS_PRECISE = 1
const MTL_FAMILY_APPLE7 = 1007

fn mtl() -> ptr:
    return global_mem("gpu_mtl", 424)

fn mtl_msg() -> ptr:
    return load_ptr(mtl(), M_MSG)

fn mtl_sel(s: str) -> ptr:
    return call_ptr(load_ptr(mtl(), M_SEL), cz(s))

fn mtl_cls(s: str) -> ptr:
    return call_ptr(load_ptr(mtl(), M_CLS), cz(s))

fn oc(o: ptr, s: str) -> ptr:
    return call_ptr(mtl_msg(), o, mtl_sel(s))

fn oc_o(o: ptr, s: str, a: ptr) -> ptr:
    return call_ptr(mtl_msg(), o, mtl_sel(s), a)

fn oc_u(o: ptr, s: str) -> u64:
    return call_u64(mtl_msg(), o, mtl_sel(s))

fn oc_void(o: ptr, s: str):
    call_void(mtl_msg(), o, mtl_sel(s))

fn oc_has(o: ptr, s: str) -> bool:
    return call_u8(mtl_msg(), o, mtl_sel("respondsToSelector:"), mtl_sel(s)) != 0

fn oc_str(p: ptr) -> ptr:
    return call_ptr(mtl_msg(), mtl_cls("NSString"), mtl_sel("stringWithUTF8String:"), p)

fn oc_cstr(nsstr: ptr) -> ptr:
    var s = null_ptr()
    if addr(nsstr) != 0:
        s = call_ptr(mtl_msg(), nsstr, mtl_sel("UTF8String"))
    return s if addr(s) != 0 else cz("unknown error")

# an NSError's description, or "" for none
fn oc_errtext(e: ptr) -> ptr:
    return oc_cstr(oc(e, "localizedDescription")) if addr(e) != 0 else cz("")

fn mtl_fail(what: str, nserr: ptr) -> i32:
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, what)
    if addr(nserr) != 0:
        sb_lit(sb, ": ")
        sb_c(sb, oc_errtext(nserr))
    sb_to(sb, mtl() + M_ERR, 256)
    return MTL_FAIL

fn mtl_err_lit(s: str):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, s)
    sb_to(sb, mtl() + M_ERR, 256)

# a shared buffer of n bytes, and its GPU address at `at`
fn mtl_buffer(n: int, at: ptr) -> ptr:
    let b = call_ptr(
        mtl_msg(),
        load_ptr(mtl(), M_DEV),
        mtl_sel("newBufferWithLength:options:"),
        u64(n),
        u64(0)
    )
    if addr(b) != 0:
        store_u64(at, 0, oc_u(b, "gpuAddress"))
    return b

# "<what>: <the error's description>" (at most `most` bytes of it) to why
fn mtl_why_err(why: ptr, what: str, e: ptr, most: int):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, what)
    sb_cmax(sb, oc_errtext(e), most)
    sb_to(sb, why, WHY_SIZE)

fn mtl_why_name(why: ptr, rest: str):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_c(sb, gpu() + G_NAME)
    sb_lit(sb, rest)
    sb_to(sb, why, WHY_SIZE)

fn mtl_open_dev(code: ptr, why: ptr) -> bool:
    if strncmp(code, cz("// brine metal\n// stack "), 24) != 0:
        why_lit(why, "the program wasn't built for Metal")
        return false
    let m = mtl()
    store_u64(m, M_STACK, strtoull(code + 24, null_ptr(), i32(10)))
    if gpu_ordinal(1, why) < 0:
        return false
    # RTLD_NOW | RTLD_LOCAL
    let fl = i32(6)
    let objc = dlopen(cz("/usr/lib/libobjc.A.dylib"), fl)
    let fnd = dlopen(cz("/System/Library/Frameworks/Foundation.framework/Foundation"), fl)
    let lib = dlopen(cz("/System/Library/Frameworks/Metal.framework/Metal"), fl)
    if addr(objc) == 0 or addr(fnd) == 0 or addr(lib) == 0:
        why_lit(why, "no Metal framework")
        return false
    store_ptr(m, M_CLS, dlsym(objc, cz("objc_getClass")))
    store_ptr(m, M_SEL, dlsym(objc, cz("sel_registerName")))
    store_ptr(m, M_MSG, dlsym(objc, cz("objc_msgSend")))
    store_ptr(m, M_PUSH, dlsym(objc, cz("objc_autoreleasePoolPush")))
    store_ptr(m, M_POP, dlsym(objc, cz("objc_autoreleasePoolPop")))
    let create = dlsym(lib, cz("MTLCreateSystemDefaultDevice"))
    if (
        addr(load_ptr(m, M_CLS)) == 0
        or addr(load_ptr(m, M_SEL)) == 0
        or addr(load_ptr(m, M_MSG)) == 0
        or addr(load_ptr(m, M_PUSH)) == 0
        or addr(load_ptr(m, M_POP)) == 0
        or addr(create) == 0
    ):
        why_lit(why, "the Objective-C runtime or Metal is missing a function")
        return false
    let ar = call_ptr(load_ptr(m, M_PUSH))
    let ok = mtl_setup(code, create, why)
    call_void(load_ptr(m, M_POP), ar)
    return ok

# The device, its kernels' pipelines and a queue (in an autorelease pool).
fn mtl_setup(code: ptr, create: ptr, why: ptr) -> bool:
    let m = mtl()
    let g = gpu()
    let msg = mtl_msg()
    let dev = call_ptr(create)
    if addr(dev) == 0:
        why_lit(why, "no Metal device")
        return false
    store_ptr(m, M_DEV, dev)
    let nsb = stack_mem(24)
    brine_sb_init(nsb)
    sb_c(nsb, oc_cstr(oc(dev, "name")))
    sb_to(nsb, g + G_NAME, NAME_SIZE)
    # Only Apple GPUs (M1 and later) are tested. The AMD and Intel GPUs of
    # Intel Macs wait for hardware to test on (see docs/DESIGN.md); the
    # virtual GPU of an Intel Mac VM gave wrong results.
    if (
        not oc_has(dev, "supportsFamily:")
        or call_u8(msg, dev, mtl_sel("supportsFamily:"), MTL_FAMILY_APPLE7) == 0
    ):
        mtl_why_name(why, " isn't an Apple GPU (AMD and Intel GPUs aren't supported yet)")
        return false
    let flag = mtl_buffer(256, m + M_FLAG_AT)
    store_ptr(m, M_FLAG, flag)
    if addr(flag) == 0 or not oc_has(flag, "gpuAddress"):
        mtl_why_name(why, " has no Metal 3 (GPU addresses need macOS 13)")
        return false
    store_ptr(m, M_FLAG_MEM, oc(flag, "contents"))
    # exact arithmetic, as on the CPU
    let opts = oc(oc(mtl_cls("MTLCompileOptions"), "alloc"), "init")
    # (the safe math mode alone still has approximate sqrt and division)
    if oc_has(opts, "setMathMode:") and oc_has(opts, "setMathFloatingPointFunctions:"):
        call_void(msg, opts, mtl_sel("setMathMode:"), MTL_MATH_SAFE)
        call_void(msg, opts, mtl_sel("setMathFloatingPointFunctions:"), MTL_FUNCTIONS_PRECISE)
    else:
        call_void(msg, opts, mtl_sel("setFastMathEnabled:"), false)
    let err = stack_mem(8)
    store_ptr(err, 0, null_ptr())
    let lib = call_ptr(
        msg,
        dev,
        mtl_sel("newLibraryWithSource:options:error:"),
        oc_str(code),
        opts,
        err
    )
    store_ptr(m, M_LIB, lib)
    oc_void(opts, "release")
    if addr(lib) == 0:
        mtl_why_err(why, "the Metal source doesn't compile: ", load_ptr(err, 0), 180)
        return false
    # every kernel's pipeline now, while the program runs on the CPU
    let names = oc(lib, "functionNames")
    let nn = oc_u(names, "count")
    let fns = calloc(nn if nn != 0 else u64(1), u64(16))
    store_ptr(m, M_FNS, fns)
    if addr(fns) == 0:
        why_lit(why, "out of memory")
        return false
    var i: u64 = 0
    while i < nn:
        let nm = call_ptr(msg, names, mtl_sel("objectAtIndex:"), i)
        i += 1
        let cn = oc_cstr(nm)
        let f = oc_o(lib, "newFunctionWithName:", nm)
        # kernels only
        if addr(f) != 0 and oc_u(f, "functionType") != MTL_KERNEL:
            oc_void(f, "release")
            continue
        store_ptr(err, 0, null_ptr())
        var ps = null_ptr()
        if addr(f) != 0:
            ps = call_ptr(msg, dev, mtl_sel("newComputePipelineStateWithFunction:error:"), f, err)
            oc_void(f, "release")
        if addr(ps) == 0:
            let sb = stack_mem(24)
            brine_sb_init(sb)
            sb_lit(sb, "no pipeline for ")
            sb_c(sb, cn)
            sb_lit(sb, ": ")
            sb_cmax(sb, oc_errtext(load_ptr(err, 0)), 160)
            sb_to(sb, why, WHY_SIZE)
            return false
        let k = load_i64(m, M_NFNS)
        store_ptr(fns, k * 16, strdup(cn))
        store_ptr(fns, k * 16 + 8, ps)
        store_i64(m, M_NFNS, k + 1)
    let q = oc(dev, "newCommandQueue")
    store_ptr(m, M_QUEUE, q)
    if addr(q) == 0:
        why_lit(why, "no Metal command queue")
        return false
    store_u64(g, G_ERR, load_u64(m, M_FLAG_AT))
    # memory is shared: copies run at memcpy speed
    store_f64(g, G_BW, 30.0e9)
    store_f64(g, G_SPEED, 60.0)
    return true

# where device memory is in the CPU's view of it
fn mtl_host(d: u64, n: int) -> ptr:
    let m = mtl()
    let b = load_u64(m, M_BUF_AT)
    if addr(load_ptr(m, M_BUF)) != 0 and d >= b and d + u64(n) <= b + load_u64(m, M_BUF_LEN):
        return load_ptr(m, M_BUF_MEM) + int(d - b)
    let f = load_u64(m, M_FLAG_AT)
    if d >= f and d + u64(n) <= f + 256:
        return load_ptr(m, M_FLAG_MEM) + int(d - f)
    mtl_err_lit("an address outside the GPU's buffers")
    return null_ptr()

# Runs one dispatch and waits for it: `groups` threadgroups of `per`
# threads, or (groups 0) `threads` threads.
fn mtl_dispatch(ps: ptr, a: ptr, na: int, threads: u64, groups: u64, per: u64) -> i32:
    let m = mtl()
    let ar = call_ptr(load_ptr(m, M_PUSH))
    let r = mtl_encode(ps, a, na, threads, groups, per)
    call_void(load_ptr(m, M_POP), ar)
    return r

fn mtl_encode(ps: ptr, a: ptr, na: int, threads: u64, groups: u64, per: u64) -> i32:
    let m = mtl()
    let msg = mtl_msg()
    let cb = oc(load_ptr(m, M_QUEUE), "commandBuffer")
    var enc = null_ptr()
    if addr(cb) != 0:
        enc = oc(cb, "computeCommandEncoder")
    if addr(enc) == 0:
        return mtl_fail("no Metal command buffer", null_ptr())
    call_void(msg, enc, mtl_sel("setComputePipelineState:"), ps)
    let sel_set = mtl_sel("setBuffer:offset:atIndex:")
    call_void(msg, enc, sel_set, load_ptr(m, M_BUF), u64(0), u64(0))
    call_void(msg, enc, mtl_sel("setBytes:length:atIndex:"), a, u64(na * 8), u64(1))
    call_void(msg, enc, sel_set, load_ptr(m, M_FLAG), u64(0), u64(2))
    # the kernels reach memory by address, not through their arguments
    # (which the Metal compiler drops when unused): every buffer has to be
    # made resident (read and write)
    let sel_use = mtl_sel("useResource:usage:")
    call_void(msg, enc, sel_use, load_ptr(m, M_BUF), u64(3))
    call_void(msg, enc, sel_use, load_ptr(m, M_FLAG), u64(3))
    if addr(load_ptr(m, M_STK)) != 0:
        call_void(msg, enc, sel_use, load_ptr(m, M_STK), u64(3))
    # MTLSize {width, height, depth}, by value: 24 bytes, which AArch64
    # passes as the address of a copy (the only Macs that get here)
    let tg = stack_mem(24)
    store_u64(tg, 0, per)
    store_u64(tg, 8, 1)
    store_u64(tg, 16, 1)
    let gs = stack_mem(24)
    store_u64(gs, 8, 1)
    store_u64(gs, 16, 1)
    if groups != 0:
        store_u64(gs, 0, groups)
        call_void(msg, enc, mtl_sel("dispatchThreadgroups:threadsPerThreadgroup:"), gs, tg)
    else:
        store_u64(gs, 0, threads)
        call_void(msg, enc, mtl_sel("dispatchThreads:threadsPerThreadgroup:"), gs, tg)
    oc_void(enc, "endEncoding")
    oc_void(cb, "commit")
    oc_void(cb, "waitUntilCompleted")
    if oc_u(cb, "status") == MTL_STATUS_ERROR:
        return mtl_fail("a Metal command failed", oc(cb, "error"))
    return i32(0)

# the device stack for the threads of one dispatch (bytes)
fn mtl_stack(bytes: u64) -> i32:
    let m = mtl()
    if load_u64(m, M_STK_LEN) >= bytes:
        return i32(0)
    if addr(load_ptr(m, M_STK)) != 0:
        oc_void(load_ptr(m, M_STK), "release")
    let s = mtl_buffer(int(bytes), m + M_STK_AT)
    store_ptr(m, M_STK, s)
    store_u64(m, M_STK_LEN, bytes if addr(s) != 0 else u64(0))
    return i32(0) if addr(s) != 0 else GPU_OOM

fn mtl_run(f: ptr, count: int, args: ptr, nargs: int) -> i32:
    let m = mtl()
    # msl.br's kernel arguments: context, n, first index, count, error flag,
    # stack, stack per thread, first thread, values, flags
    let a = stack_mem(80)
    memset(a, 0, 80)
    var i = 0
    while i < nargs and i < 6:
        store_u64(a, (i if i < 4 else i + 4) * 8, load_u64(args, i * 8))
        i += 1
    let stack = load_u64(m, M_STACK)
    store_u64(a, 32, load_u64(m, M_FLAG_AT))
    store_u64(a, 48, stack)
    let most_tg = oc_u(f, "maxTotalThreadsPerThreadgroup")
    let per = most_tg if most_tg < u64(GPU_BLOCK) else u64(GPU_BLOCK)
    # threads at a time: as many as 256 MB of stack holds
    var step = count
    if stack > 0:
        var most = int(u64(256 << 20) / stack)
        if most < 1:
            most = 1
        if step > most:
            step = most
        let r = mtl_stack(u64(step) * stack)
        if r != 0:
            return r
        store_u64(a, 40, load_u64(m, M_STK_AT))
    var t0 = 0
    while t0 < count:
        let k = count - t0 if count - t0 < step else step
        store_u64(a, 56, u64(t0))
        let r = mtl_dispatch(f, a, 10, u64(k), u64(0), per)
        if r != 0:
            return r
        t0 += step
    return i32(0)

fn mtl_comb(f: ptr, blocks: int, args: ptr, nargs: int) -> i32:
    let a = stack_mem(48)
    memset(a, 0, 48)
    var i = 0
    while i < nargs and i < 5:
        store_u64(a, i * 8, load_u64(args, i * 8))
        i += 1
    store_u64(a, 40, load_u64(mtl(), M_FLAG_AT))
    if oc_u(f, "maxTotalThreadsPerThreadgroup") < u64(GPU_BLOCK):
        mtl_err_lit(f"a combine kernel can't run {GPU_BLOCK} threads per threadgroup")
        return MTL_FAIL
    return mtl_dispatch(f, a, 6, u64(0), u64(blocks), u64(GPU_BLOCK))

# ---- the device, CUDA or Metal

fn dev_open(code: ptr, why: ptr) -> bool:
    if os_is("macos"):
        return mtl_open_dev(code, why)
    else:
        return cu_open_dev(code, why)

fn dev_err(r: i32) -> ptr:
    if os_is("macos"):
        return cz("out of memory") if r == GPU_OOM else mtl() + M_ERR
    else:
        return cu_err(r)

# makes the device current on this thread
fn dev_bind() -> i32:
    if os_is("macos"):
        return i32(0)
    else:
        return call_i32(cu_fn(CU_SET_CUR), load_ptr(cu(), CU_CTX))

# Metal has one main buffer at a time: gpu_reserve frees the old one first
fn dev_alloc(p: ptr, n: int) -> i32:
    if os_is("macos"):
        let m = mtl()
        let b = mtl_buffer(n, p)
        if addr(b) == 0:
            return GPU_OOM
        store_ptr(m, M_BUF, b)
        store_u64(m, M_BUF_AT, load_u64(p, 0))
        store_ptr(m, M_BUF_MEM, oc(b, "contents"))
        store_i64(m, M_BUF_LEN, n)
        return i32(0)
    else:
        return call_i32(cu_fn(CU_ALLOC), p, u64(n))

fn dev_free(d: u64):
    if os_is("macos"):
        let m = mtl()
        if addr(load_ptr(m, M_BUF)) == 0 or d != load_u64(m, M_BUF_AT):
            return
        oc_void(load_ptr(m, M_BUF), "release")
        store_ptr(m, M_BUF, null_ptr())
        store_i64(m, M_BUF_LEN, 0)
    else:
        call_i32(cu_fn(CU_FREE), d)

# host memory the device copies from quickly, or null
fn dev_host_alloc(n: int) -> ptr:
    if os_is("macos"):
        return null_ptr()
    else:
        let p = stack_mem(8)
        store_ptr(p, 0, null_ptr())
        if call_i32(cu_fn(CU_HALLOC), p, u64(n)) != 0:
            return null_ptr()
        return load_ptr(p, 0)

fn dev_host_free(p: ptr):
    if not os_is("macos"):
        call_i32(cu_fn(CU_HFREE), p)

fn dev_htod(d: u64, h: ptr, n: int) -> i32:
    if os_is("macos"):
        let m = mtl_host(d, n)
        if addr(m) == 0:
            return MTL_FAIL
        memcpy(m, h, u64(n))
        return i32(0)
    else:
        return call_i32(cu_fn(CU_HTOD), d, h, u64(n))

fn dev_dtoh(h: ptr, d: u64, n: int) -> i32:
    if os_is("macos"):
        let m = mtl_host(d, n)
        if addr(m) == 0:
            return MTL_FAIL
        memcpy(h, m, u64(n))
        return i32(0)
    else:
        return call_i32(cu_fn(CU_DTOH), h, d, u64(n))

fn dev_zero(d: u64, n: int) -> i32:
    if os_is("macos"):
        let m = mtl_host(d, n)
        if addr(m) == 0:
            return MTL_FAIL
        memset(m, 0, u64(n))
        return i32(0)
    else:
        return call_i32(cu_fn(CU_SET), d, u8(0), u64(n))

# the kernel `name` to the 8 bytes at f
fn dev_func(f: ptr, name: ptr) -> i32:
    if os_is("macos"):
        let m = mtl()
        let fns = load_ptr(m, M_FNS)
        for i in 0..load_i64(m, M_NFNS):
            if strcmp(load_ptr(fns, i * 16), name) == 0:
                store_ptr(f, 0, load_ptr(fns, i * 16 + 8))
                return i32(0)
        let sb = stack_mem(24)
        brine_sb_init(sb)
        sb_lit(sb, "no kernel ")
        sb_c(sb, name)
        sb_to(sb, m + M_ERR, 256)
        return MTL_FAIL
    else:
        return call_i32(cu_fn(CU_FUNC), f, load_ptr(cu(), CU_MOD), name)

# `count` threads of a construct's kernel, and waits for them. args (u64s):
# the context, n, the first index, count, and for reductions where the
# leaves' values and flags go.
fn dev_run(f: ptr, count: int, args: ptr, nargs: int) -> i32:
    if os_is("macos"):
        return mtl_run(f, count, args, nargs)
    else:
        return cu_launch(f, (count + GPU_BLOCK - 1) / GPU_BLOCK, args, nargs)

# `blocks` blocks of GPU_BLOCK threads of a combine kernel. args: values and
# flags in, their count, values and flags out.
fn dev_comb(f: ptr, blocks: int, args: ptr, nargs: int) -> i32:
    if os_is("macos"):
        return mtl_comb(f, blocks, args, nargs)
    else:
        return cu_launch(f, blocks, args, nargs)

# ---- getting the device ready

fn brine_x_gpu_init_main(code: ptr):
    let g = gpu()
    let why = stack_mem(256)
    memset(why, 0, 256)
    let t0 = brine_clock()
    let ok = dev_open(code, why)
    let dt = brine_clock() - t0
    lock(g + G_MU)
    atomic_store(g + G_STATE, GS_READY if ok else GS_FAILED)
    if ok:
        store_f64(g, G_INIT_S, dt)
    memcpy(g + G_WHY, why, 256)
    cond_broadcast(g + G_CV)
    unlock(g + G_MU)
    if gpu_logging():
        let sb = stack_mem(24)
        brine_sb_init(sb)
        if ok:
            sb_c(sb, g + G_NAME)
            sb_lit(sb, f" ready in {dt * 1.0e3:.0f} ms")
        else:
            sb_lit(sb, "not used: ")
            sb_c(sb, why)
        gpu_log(sb)

# Starts getting the device ready (in the background). Holds the lock.
fn gpu_start(code: ptr):
    let g = gpu()
    if gpu_state() != GS_NONE:
        return
    atomic_store(g + G_STATE, GS_INIT)
    store_ptr(g, G_PTX, code)
    let th = stack_mem(8)
    if not thread_start(symbol("brine_x_gpu_init_main"), code, th):
        atomic_store(g + G_STATE, GS_FAILED)
        why_lit(g + G_WHY, "no thread to start the GPU")

# Exiting while the CUDA driver starts up on its thread crashes in the
# driver, so the way out waits for that to finish.
fn brine_x_gpu_settle():
    let g = gpu()
    if gpu_state() != GS_INIT:
        return
    lock(g + G_MU)
    while gpu_state() == GS_INIT:
        cond_wait(g + G_CV, g + G_MU)
    unlock(g + G_MU)

# Waits until the device is ready or has failed. Holds the lock.
fn gpu_wait(code: ptr) -> bool:
    let g = gpu()
    gpu_start(code)
    while gpu_state() == GS_INIT:
        cond_wait(g + G_CV, g + G_MU)
    return gpu_state() == GS_READY

# A device call failed: no more GPU for this run.
fn gpu_fail(what: str, r: i32):
    let g = gpu()
    lock(g + G_MU)
    atomic_store(g + G_STATE, GS_FAILED)
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, what)
    sb_lit(sb, ": ")
    sb_c(sb, dev_err(r))
    sb_to(sb, g + G_WHY, WHY_SIZE)
    unlock(g + G_MU)
    if gpu_logging():
        let lb = stack_mem(24)
        brine_sb_init(lb)
        sb_lit(lb, "disabled: ")
        sb_lit(lb, what)
        sb_lit(lb, ": ")
        sb_c(lb, dev_err(r))
        gpu_log(lb)

fn kstate(k: ptr) -> ptr:
    if addr(load_ptr(k, K_STATE)) == 0:
        let s = calloc(u64(1), u64(KS_SIZE))
        if addr(s) == 0:
            return s
        store_ptr(k, K_STATE, s)
    return load_ptr(k, K_STATE)

# ---- copies

# One array the device needs: its header at `hoff` and its elements at
# `doff` in the device buffer. Staged ones are copied with the context in
# one piece (headers, small arrays, arrays of arrays, whose pointers are
# rewritten); the others straight from the array. `dense`
# (BRINE_GA_DENSE): iteration k writes element first + k only.
const GA_HOST = 0
const GA_NODE = 8
const GA_HOFF = 16
const GA_DOFF = 24
const GA_BYTES = 32
const GA_WRITTEN = 40
const GA_READ = 48
const GA_STAGED = 56
const GA_DENSE = 64
const GA_FIRST = 72
const GA_SIZE = 80

# The arrays of a construct: `tab` finds one by its host address (open
# addressing, index + 1); [lo, hi) are the iterations the device runs.
const GP_K = 0
const GP_NODES = 8
const GP_A = 16
const GP_NA = 24
const GP_ACAP = 32
const GP_TAB = 40
const GP_TCAP = 48
const GP_STAGE = 56
const GP_DIRECT = 64
const GP_LO = 72
const GP_HI = 80
const GP_OK = 88
# when planning should give up (brine_clock; 0: never), and whether it did
const GP_DEADLINE = 96
const GP_SLOW = 104
const GP_SIZE = 112

# brine_kernel.ptrs' flags (BRINE_GA_*)
const GA_F_WRITTEN = 1
const GA_F_DENSE = 2

fn align_up(x: int, a: int) -> int:
    return (x + a - 1) & ~(a - 1)

fn pl_arr(p: ptr, i: int) -> ptr:
    return load_ptr(p, GP_A) + i * GA_SIZE

# The index of host array h, or -1 and where it would go in `slot`.
fn gplan_find(p: ptr, h: ptr, slot: ptr) -> int:
    var x = addr(h)
    x ^= x >> 33
    x *= 0xff51afd7ed558ccd
    x ^= x >> 33
    let mask = load_i64(p, GP_TCAP) - 1
    let tab = load_ptr(p, GP_TAB)
    var i = int(x & u64(mask))
    while load_i64(tab, i * 8) != 0:
        let j = load_i64(tab, i * 8) - 1
        if load_ptr(pl_arr(p, j), GA_HOST) == h:
            return j
        i = (i + 1) & mask
    store_i64(slot, 0, i)
    return -1

fn gplan_grow(p: ptr):
    let tc = load_i64(p, GP_TCAP)
    let nc = tc * 2 if tc != 0 else 64
    free(load_ptr(p, GP_TAB))
    let tab = calloc(u64(nc), u64(8))
    store_ptr(p, GP_TAB, tab)
    store_i64(p, GP_TCAP, nc)
    if addr(tab) == 0:
        store_i64(p, GP_OK, 0)
        return
    let slot = stack_mem(8)
    for j in 0..load_i64(p, GP_NA):
        store_i64(slot, 0, 0)
        gplan_find(p, load_ptr(pl_arr(p, j), GA_HOST), slot)
        store_i64(tab, load_i64(slot, 0) * 8, j + 1)

fn gplan_add(
    p: ptr,
    a: ptr,
    node: int,
    written: int,
    read: int,
    dense: int,
    first: int,
    depth: int
):
    if load_i64(p, GP_OK) == 0 or addr(a) == 0:
        return
    if depth > 16:
        store_i64(p, GP_OK, 0)
        return
    if (load_i64(p, GP_NA) + 1) * 2 > load_i64(p, GP_TCAP):
        gplan_grow(p)
        if load_i64(p, GP_OK) == 0:
            return
    let slot = stack_mem(8)
    store_i64(slot, 0, 0)
    let i = gplan_find(p, a, slot)
    if i >= 0:
        let g = pl_arr(p, i)
        store_i64(g, GA_WRITTEN, load_i64(g, GA_WRITTEN) | written)
        store_i64(g, GA_READ, load_i64(g, GA_READ) | read)
        if load_i64(g, GA_DENSE) != dense or load_i64(g, GA_FIRST) != first:
            store_i64(g, GA_DENSE, 0)
            store_i64(g, GA_READ, 1)
        return
    let na = load_i64(p, GP_NA)
    if na == load_i64(p, GP_ACAP):
        let ac = load_i64(p, GP_ACAP)
        let nc = ac * 2 if ac != 0 else 16
        store_i64(p, GP_ACAP, nc)
        let n2 = realloc(load_ptr(p, GP_A), u64(nc * GA_SIZE))
        if addr(n2) == 0:
            store_i64(p, GP_OK, 0)
            return
        store_ptr(p, GP_A, n2)
    let nd = load_ptr(p, GP_NODES) + node * 8
    let esz = load_i64(nd, 0)
    let nsub = load_i64(nd, 8)
    let len = load_i64(a, ARR_LEN)
    if load_i64(a, ARR_ESZ) != esz and len > 0:
        store_i64(p, GP_OK, 0)
        return
    let g = pl_arr(p, na)
    let bytes = len * esz
    store_ptr(g, GA_HOST, a)
    store_i64(g, GA_NODE, node)
    store_i64(g, GA_BYTES, bytes)
    store_i64(g, GA_WRITTEN, written)
    store_i64(g, GA_READ, read)
    store_i64(g, GA_DENSE, dense)
    store_i64(g, GA_FIRST, first)
    let st = load_i64(p, GP_STAGE)
    store_i64(g, GA_HOFF, st)
    let staged = nsub > 0 or u64(bytes) <= u64(GPU_SMALL)
    store_i64(g, GA_STAGED, 1 if staged else 0)
    if staged:
        store_i64(g, GA_DOFF, st + 64)
        store_i64(p, GP_STAGE, align_up(st + 64 + bytes, 64))
    else:
        store_i64(p, GP_STAGE, st + 64)
        let d = load_i64(p, GP_DIRECT)
        store_i64(g, GA_DOFF, d)
        store_i64(p, GP_DIRECT, align_up(d + bytes, 256))
    store_i64(load_ptr(p, GP_TAB), load_i64(slot, 0) * 8, na + 1)
    store_i64(p, GP_NA, na + 1)
    let dl = load_f64(p, GP_DEADLINE)
    if dl > 0.0 and (na + 1) & 1023 == 0 and brine_clock() > dl:
        store_i64(p, GP_SLOW, 1)
        store_i64(p, GP_OK, 0)
        return
    if nsub > 0:
        let data = load_ptr(a, ARR_DATA)
        for e in 0..len:
            for s in 0..nsub:
                let c = load_ptr(data, e * esz + load_i64(nd, (2 + 2 * s) * 8))
                gplan_add(p, c, load_i64(nd, (3 + 2 * s) * 8), 0, 1, 0, 0, depth + 1)
            if load_i64(p, GP_OK) == 0:
                return

# The arrays a construct's context reaches (p: GP_SIZE bytes); gives up
# (GP_SLOW) at brine_clock() `deadline` unless it is 0.
fn gplan_make(p: ptr, k: ptr, ctx: ptr, deadline: float) -> bool:
    memset(p, 0, u64(GP_SIZE))
    store_ptr(p, GP_K, k)
    store_i64(p, GP_OK, 1)
    store_f64(p, GP_DEADLINE, deadline)
    let ptrs = load_ptr(k, K_PTRS)
    let nf = load_i64(ptrs, 0)
    store_ptr(p, GP_NODES, ptrs + (1 + 3 * nf) * 8)
    store_i64(p, GP_STAGE, align_up(load_i64(k, K_CTX_SIZE), 64))
    for f in 0..nf:
        let fd = ptrs + (1 + 3 * f) * 8
        let a = load_ptr(ctx, load_i64(fd, 0))
        let fl = load_i64(fd, 8)
        var first = 0
        if fl >> 8 != 0:
            first = load_i64(ctx, (fl >> 8) - 1)
        let dense = 1 if fl & GA_F_DENSE != 0 else 0
        let written = 1 if fl & GA_F_WRITTEN != 0 else 0
        gplan_add(p, a, load_i64(fd, 16), written, 1 - dense, dense, first, 0)
    let at = align_up(load_i64(p, GP_STAGE), 256)
    for i in 0..load_i64(p, GP_NA):
        let g = pl_arr(p, i)
        if load_i64(g, GA_STAGED) == 0:
            store_i64(g, GA_DOFF, load_i64(g, GA_DOFF) + at)
    return load_i64(p, GP_OK) != 0

# Plans the copies for the `rest` elements still to do (p: GP_SIZE bytes);
# false, with the reason in `why`, when that fails. Walking arrays of
# arrays visits every inner array, which can cost more than running the
# construct on the CPU: in auto mode the walk gives up once it has taken
# that long, and its cost per element is kept, so later calls don't walk.
fn gpu_plan(p: ptr, k: ptr, st: ptr, ctx: ptr, rest: int, why: ptr) -> bool:
    let g = gpu()
    let auto = gpu_mode() != GPU_ON
    lock(g + G_MU)
    let cpu_ns = load_f64(st, KS_CPU)
    let plan_ns = load_f64(st, KS_PLAN)
    unlock(g + G_MU)
    let slow = cz("copying its arrays of arrays to the GPU takes longer than running it on the CPU")
    if auto and plan_ns > 0.0 and plan_ns >= 0.75 * cpu_ns:
        memset(p, 0, u64(GP_SIZE))
        store_ptr(why, 0, slow)
        return false
    let t0 = brine_clock()
    var deadline = 0.0
    if auto and cpu_ns > 0.0:
        deadline = t0 + 0.75 * cpu_ns * 1.0e-9 * float(rest)
    let ok = gplan_make(p, k, ctx, deadline)
    var dt = brine_clock() - t0
    if load_i64(p, GP_SLOW) != 0:
        # a walk cut short would have taken longer
        dt *= 2.0
    if rest > 0:
        lock(g + G_MU)
        store_f64(st, KS_PLAN, dt * 1.0e9 / float(rest))
        unlock(g + G_MU)
    if not ok:
        store_ptr(why, 0, slow if load_i64(p, GP_SLOW) != 0 else cz("out of memory"))
    return ok

fn gplan_free(p: ptr):
    free(load_ptr(p, GP_A))
    free(load_ptr(p, GP_TAB))

fn gplan_size(p: ptr) -> int:
    return align_up(load_i64(p, GP_STAGE), 256) + load_i64(p, GP_DIRECT)

# The bytes of g that go back: all of them, or the elements the device's
# iterations write; (offset, bytes) to o.
fn garr_out(p: ptr, g: ptr, o: ptr):
    store_i64(o, 0, 0)
    store_i64(o, 8, load_i64(g, GA_BYTES))
    if load_i64(g, GA_DENSE) == 0:
        return
    let esz = load_i64(load_ptr(p, GP_NODES), load_i64(g, GA_NODE) * 8)
    let len = load_i64(load_ptr(g, GA_HOST), ARR_LEN)
    let first = load_i64(g, GA_FIRST)
    var a = first + load_i64(p, GP_LO)
    var b = first + load_i64(p, GP_HI)
    if a < 0:
        a = 0
    if b > len:
        b = len
    if b < a:
        b = a
    store_i64(o, 0, a * esz)
    store_i64(o, 8, (b - a) * esz)

fn gplan_bytes(p: ptr) -> int:
    var b = load_i64(p, GP_STAGE)
    let o = stack_mem(16)
    for i in 0..load_i64(p, GP_NA):
        let g = pl_arr(p, i)
        garr_out(p, g, o)
        if load_i64(g, GA_STAGED) == 0 and load_i64(g, GA_READ) != 0:
            b += load_i64(g, GA_BYTES)
        if load_i64(g, GA_WRITTEN) != 0:
            b += load_i64(o, 8)
    return b

fn gplan_index(p: ptr, h: ptr) -> int:
    let slot = stack_mem(8)
    return gplan_find(p, h, slot)

# Device memory for n bytes (one buffer, kept between launches); the
# error, if any, to r.
fn gpu_reserve(n: int, r: ptr) -> bool:
    let g = gpu()
    store_i32(r, 0, i32(0))
    if load_u64(g, G_CAP) >= u64(n):
        return true
    if load_u64(g, G_BUF) != 0:
        dev_free(load_u64(g, G_BUF))
    store_u64(g, G_BUF, 0)
    store_u64(g, G_CAP, 0)
    let c = n + n / 4
    let e = dev_alloc(g + G_BUF, c)
    store_i32(r, 0, e)
    if e != 0:
        store_u64(g, G_BUF, 0)
        return false
    store_i64(g, G_CAP, c)
    return true

fn gpu_stage(n: int) -> ptr:
    let g = gpu()
    if load_u64(g, G_STAGE_CAP) >= u64(n):
        return load_ptr(g, G_STAGE)
    let old = load_ptr(g, G_STAGE)
    if addr(old) != 0:
        if load_i64(g, G_PINNED) != 0:
            dev_host_free(old)
        else:
            free(old)
    let c = n + n / 4 + 4096
    var p = dev_host_alloc(c)
    store_i64(g, G_PINNED, 1 if addr(p) != 0 else 0)
    if addr(p) == 0:
        p = malloc(u64(c))
    store_ptr(g, G_STAGE, p)
    store_i64(g, G_STAGE_CAP, c if addr(p) != 0 else 0)
    return p

# Copies the context and the arrays to the device: the device context is at
# the buffer's start. Holds `run`.
fn gpu_copy_in(p: ptr, ctx: ptr) -> i32:
    let stage = load_i64(p, GP_STAGE)
    let st = gpu_stage(stage)
    if addr(st) == 0:
        return GPU_OOM
    let g = gpu()
    let base = load_u64(g, G_BUF)
    let k = load_ptr(p, GP_K)
    memcpy(st, ctx, u64(load_i64(k, K_CTX_SIZE)))
    let ptrs = load_ptr(k, K_PTRS)
    let nodes = load_ptr(p, GP_NODES)
    for f in 0..load_i64(ptrs, 0):
        let off = load_i64(ptrs, (1 + 3 * f) * 8)
        let i = gplan_index(p, load_ptr(ctx, off))
        let d = base + u64(load_i64(pl_arr(p, i), GA_HOFF)) if i >= 0 else u64(0)
        store_u64(st, off, d)
    let na = load_i64(p, GP_NA)
    for i in 0..na:
        let ga = pl_arr(p, i)
        let host = load_ptr(ga, GA_HOST)
        let hoff = load_i64(ga, GA_HOFF)
        let doff = load_i64(ga, GA_DOFF)
        let bytes = load_i64(ga, GA_BYTES)
        memcpy(st + hoff, host, u64(ARR_SIZE))
        store_u64(st, hoff + ARR_DATA, base + u64(doff))
        if load_i64(ga, GA_STAGED) == 0 or bytes == 0:
            continue
        let nd = nodes + load_i64(ga, GA_NODE) * 8
        let esz = load_i64(nd, 0)
        let nsub = load_i64(nd, 8)
        if load_i64(ga, GA_READ) != 0 or nsub > 0:
            memcpy(st + doff, load_ptr(host, ARR_DATA), u64(bytes))
        if nsub > 0:
            for e in 0..load_i64(host, ARR_LEN):
                for s in 0..nsub:
                    let at = st + doff + e * esz + load_i64(nd, (2 + 2 * s) * 8)
                    let j = gplan_index(p, load_ptr(at, 0))
                    let cd = base + u64(load_i64(pl_arr(p, j), GA_HOFF)) if j >= 0 else u64(0)
                    store_u64(at, 0, cd)
    var r = dev_htod(base, st, stage)
    var i = 0
    while i < na and r == 0:
        let ga = pl_arr(p, i)
        let bytes = load_i64(ga, GA_BYTES)
        if load_i64(ga, GA_STAGED) == 0 and load_i64(ga, GA_READ) != 0 and bytes > 0:
            r = dev_htod(
                base + u64(load_i64(ga, GA_DOFF)),
                load_ptr(load_ptr(ga, GA_HOST), ARR_DATA),
                bytes
            )
        i += 1
    if r == 0:
        r = dev_zero(load_u64(g, G_ERR), 4)
    return r

# Copies the arrays the body wrote back.
fn gpu_copy_out(p: ptr) -> i32:
    let base = load_u64(gpu(), G_BUF)
    let o = stack_mem(16)
    var r = i32(0)
    var i = 0
    while i < load_i64(p, GP_NA) and r == 0:
        let ga = pl_arr(p, i)
        garr_out(p, ga, o)
        let off = load_i64(o, 0)
        let n = load_i64(o, 8)
        if load_i64(ga, GA_WRITTEN) != 0 and n > 0:
            let h = load_ptr(load_ptr(ga, GA_HOST), ARR_DATA) + off
            r = dev_dtoh(h, base + u64(load_i64(ga, GA_DOFF) + off), n)
        i += 1
    return r

# whether a kernel set the error flag, to the 8 bytes at flag
fn gpu_errflag(flag: ptr) -> i32:
    let v = stack_mem(8)
    store_i64(v, 0, 0)
    let r = dev_dtoh(v, load_u64(gpu(), G_ERR), 4)
    store_i64(flag, 0, 1 if load_u32(v, 0) != 0 else 0)
    return r

# ---- policy

fn gpu_kind(k: ptr) -> str:
    let kind = load_i64(k, K_KIND)
    return "par reduction" if kind == 2 else ("par map" if kind == 1 else "par for")

# Device time per element, before it has been measured: the CPU's, scaled
# by how much faster the device runs this kind of code (f64 is slow on most
# GeForce cards).
fn gpu_guess_ns(k: ptr, seq_ns: float) -> float:
    let g = gpu()
    let cost = load_i64(k, K_COST)
    var f = float(load_i64(k, K_COST64)) / float(cost) if cost > 0 else 0.0
    if f > 1.0:
        f = 1.0
    return seq_ns * ((1.0 - f) / load_f64(g, G_SPEED) + f / load_f64(g, G_F64))

# what gpu_choose decided: run (the rest) on the GPU, the two estimates,
# and why not
const CH_USE = 0
const CH_CPU_S = 8
const CH_GPU_S = 16
const CH_WHY = 24

fn gpu_dev_ns(k: ptr, st: ptr) -> float:
    let ns = load_f64(st, KS_GPU)
    return ns if ns > 0.0 else gpu_guess_ns(k, load_f64(st, KS_SEQ))

# Should the `rest` elements still to do run on the device? Holds the lock.
fn gpu_choose(k: ptr, st: ptr, rest: int, bytes: int, launches: int, c: ptr):
    let g = gpu()
    store_i64(c, CH_USE, 0)
    store_ptr(c, CH_WHY, null_ptr())
    let gpu_ns = gpu_dev_ns(k, st)
    let cpu_s = load_f64(st, KS_CPU) * 1.0e-9 * float(rest)
    # (planning the copies is paid again on every call)
    let gpu_s = (
        (gpu_ns + load_f64(st, KS_PLAN)) * 1.0e-9 * float(rest)
        + float(bytes) / load_f64(g, G_BW)
        + 3.0e-5 * float(launches)
    )
    store_f64(c, CH_CPU_S, cpu_s)
    store_f64(c, CH_GPU_S, gpu_s)
    let code = load_ptr(k, K_PTX)
    if gpu_mode() == GPU_ON:
        let on_gpu = gpu_wait(code)
        store_i64(c, CH_USE, 1 if on_gpu else 0)
        if not on_gpu:
            store_ptr(c, CH_WHY, g + G_WHY)
        return
    if gpu_state() == GS_FAILED:
        store_ptr(c, CH_WHY, g + G_WHY)
        return
    let ready = gpu_state() == GS_READY
    let init = 0.0 if ready else load_f64(g, G_INIT_S)
    if gpu_s + init < 0.75 * cpu_s:
        let on_gpu = gpu_wait(code)
        store_i64(c, CH_USE, 1 if on_gpu else 0)
        if not on_gpu:
            store_ptr(c, CH_WHY, g + G_WHY)
        return
    # not now, but maybe soon: get the device ready in the background
    let soon = not ready and gpu_s < 0.75 * cpu_s
    if soon and cpu_s > 2.0e-3:
        gpu_start(code)
    store_ptr(c, CH_WHY, cz("starting the GPU") if soon else cz("faster on the CPU"))

# Runs elements [lo, n) of a `par for` sequentially on this thread until
# about `secs` have passed; returns where it stopped (the time per element
# to ns).
fn probe_for(f: ptr, ctx: ptr, lo: int, n: int, secs: float, ns: ptr) -> int:
    let t0 = brine_clock()
    var i = lo
    var step = 16
    let saved = brine_x_in_par_get()
    brine_x_in_par_set(1)
    while i < n:
        let j = i + step if i + step < n else n
        call_void(f, ctx, 0, i, j)
        i = j
        if brine_clock() - t0 >= secs:
            break
        step *= 2
    brine_x_in_par_set(saved)
    let dt = brine_clock() - t0
    store_f64(ns, 0, dt * 1.0e9 / float(i - lo) if i > lo else 0.0)
    return i

fn gpu_note_cpu(st: ptr, count: int, secs: float):
    if count <= 0 or addr(st) == 0:
        return
    let g = gpu()
    lock(g + G_MU)
    let ns = secs * 1.0e9 / float(count)
    # a measurement replaces the probe's estimate: the first elements may
    # not be typical
    let cpu_ns = 0.5 * (load_f64(st, KS_CPU) + ns) if load_i64(st, KS_SEEN) != 0 else ns
    store_f64(st, KS_CPU, cpu_ns)
    store_i64(st, KS_SEEN, 1)
    store_f64(st, KS_SEQ, cpu_ns * float(brine_x_threads()) * CPU_EFF)
    unlock(g + G_MU)

# Launches the kernel for elements [lo, n) in slices of about GPU_SLICE;
# the error flag to `flag`, the kernels' time to `kern`.
fn gpu_run_for(st: ptr, lo: int, n: int, flag: ptr, kern: ptr) -> i32:
    let g = gpu()
    var ns = load_f64(st, KS_GPU)
    var i = lo
    store_i64(flag, 0, 0)
    store_f64(kern, 0, 0.0)
    let args = stack_mem(32)
    while i < n:
        var cnt = 65536
        if ns > 0.0:
            let q = GPU_SLICE * 1.0e9 / ns
            cnt = 1 << 30 if q >= 1073741824.0 else int(q)
        if cnt < 65536:
            cnt = 65536
        if cnt > 1 << 30:
            cnt = 1 << 30
        if cnt > n - i:
            cnt = n - i
        store_u64(args, 0, load_u64(g, G_BUF))
        store_i64(args, 8, n)
        store_i64(args, 16, i)
        store_i64(args, 24, cnt)
        let t0 = brine_clock()
        var r = dev_run(load_ptr(st, KS_FN), cnt, args, 4)
        if r != 0:
            return r
        let dt = brine_clock() - t0
        store_f64(kern, 0, load_f64(kern, 0) + dt)
        ns = dt * 1.0e9 / float(cnt)
        i += cnt
        r = gpu_errflag(flag)
        if r != 0 or load_i64(flag, 0) != 0:
            return r
    if n > lo:
        store_f64(st, KS_GPU, load_f64(kern, 0) * 1.0e9 / float(n - lo))
    return i32(0)

fn gpu_func(st: ptr, k: ptr) -> i32:
    var r = i32(0)
    if addr(load_ptr(st, KS_FN)) == 0:
        r = dev_func(st + KS_FN, load_ptr(k, K_ENTRY))
        if r != 0:
            return r
    if load_i64(k, K_KIND) == 2 and addr(load_ptr(st, KS_COMB)) == 0:
        r = dev_func(st + KS_COMB, load_ptr(k, K_COMB))
    return r

# `before`: the time spent measuring and planning before the CPU ran it
fn gpu_log_cpu(k: ptr, n: int, why: ptr, secs: float, before: float):
    if not gpu_logging():
        return
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_c(sb, load_ptr(k, K_WHERE))
    sb_lit(sb, f" {gpu_kind(k)} n={n} -> cpu {secs * 1.0e3:.3f} ms (")
    if addr(load_ptr(k, K_PTX)) == 0:
        sb_lit(sb, "not GPU-eligible: ")
    sb_c(sb, why)
    if before >= 1.0e-5:
        sb_lit(sb, f"; deciding took {before * 1.0e3:.3f} ms")
    sb_lit(sb, ")")
    gpu_log(sb)

fn gpu_log_check(k: ptr, n: int):
    if not gpu_logging():
        return
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_c(sb, load_ptr(k, K_WHERE))
    sb_lit(sb, f" {gpu_kind(k)} n={n}: a check failed on the GPU, running it on the CPU")
    gpu_log(sb)

fn gpu_log_gpu(
    k: ptr,
    n: int,
    what: str,
    total: float,
    kern: float,
    copy: float,
    bytes: int,
    cpu_s: float
):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_c(sb, load_ptr(k, K_WHERE))
    let mb = float(bytes) / 1.0e6
    sb_lit(
        sb,
        f" {gpu_kind(k)} n={n} -> gpu {total * 1.0e3:.3f} ms ({what} {kern * 1.0e3:.3f} ms, copies {copy * 1.0e3:.3f} ms, {mb:.1f} MB"
    )
    sb_cpu_est(sb, cpu_s)
    sb_lit(sb, ")")
    gpu_log(sb)

# Why a construct of n elements stays on the CPU without a look at the
# device (a C string), or null. (Checked before nesting, which is a call:
# a nested construct's reason is never logged.)
fn gpu_skip(k: ptr, n: int) -> ptr:
    let code = load_ptr(k, K_PTX)
    if addr(code) == 0:
        return load_ptr(k, K_WHY)
    let mode = gpu_mode()
    if mode == GPU_OFF:
        return cz("BRINE_GPU=off")
    if n < GPU_MIN_N and mode != GPU_ON:
        return cz("small")
    return null_ptr()

# The start of a construct's GPU part after gpu_skip, shared by `par for`
# and the reductions: its state, or null with the reason in `why` when it
# stays on the CPU; `known`: its CPU time was measured.
fn gpu_begin(k: ptr, why: ptr, known: ptr) -> ptr:
    let g = gpu()
    store_ptr(why, 0, cz("nested in a parallel construct"))
    if brine_x_in_par_get() != 0:
        return null_ptr()
    lock(g + G_MU)
    let st = kstate(k)
    let failed = gpu_state() == GS_FAILED
    store_i64(known, 0, 1 if addr(st) != 0 and load_f64(st, KS_CPU) > 0.0 else 0)
    unlock(g + G_MU)
    store_ptr(why, 0, g + G_WHY if failed else cz("out of memory"))
    if addr(st) == 0 or failed:
        return null_ptr()
    return st

# The probe's time per element: one thread's, and the pool's estimate.
fn gpu_note_probe(st: ptr, ns: float):
    let g = gpu()
    lock(g + G_MU)
    store_f64(st, KS_SEQ, ns)
    store_f64(st, KS_CPU, ns / (float(brine_x_threads()) * CPU_EFF))
    unlock(g + G_MU)

# The GPU part of a `par for`: returns how many leading elements are done
# (all n when the device ran them, fewer when the CPU should run the rest).
# Every element below the returned count has run exactly once.
fn gpu_for(k: ptr, ctx: ptr, n: int, f: ptr, why: ptr) -> int:
    let g = gpu()
    let known = stack_mem(8)
    let st = gpu_begin(k, why, known)
    if addr(st) == 0:
        return 0
    var done = 0
    if load_i64(known, 0) == 0 and gpu_mode() != GPU_ON:
        let ns = stack_mem(8)
        done = probe_for(f, ctx, 0, n, 1.0e-4, ns)
        gpu_note_probe(st, load_f64(ns, 0))
        if done >= n:
            store_ptr(why, 0, cz("done while measuring"))
            return done
    let p = stack_mem(GP_SIZE)
    if not gpu_plan(p, k, st, ctx, n - done, why):
        gplan_free(p)
        return done
    # arrays that go back whole need the elements the probe wrote on the
    # device too
    store_i64(p, GP_LO, done)
    store_i64(p, GP_HI, n)
    if done > 0:
        for i in 0..load_i64(p, GP_NA):
            let ga = pl_arr(p, i)
            if load_i64(ga, GA_WRITTEN) != 0 and load_i64(ga, GA_DENSE) == 0:
                store_i64(ga, GA_READ, 1)
    let c = stack_mem(32)
    lock(g + G_MU)
    gpu_choose(k, st, n - done, gplan_bytes(p), 1 + (n - done) / (1 << 22), c)
    unlock(g + G_MU)
    if load_i64(c, CH_USE) == 0:
        gplan_free(p)
        store_ptr(why, 0, load_ptr(c, CH_WHY))
        return done
    store_ptr(why, 0, cz("the GPU is busy"))
    if not try_lock(g + G_RUN):
        gplan_free(p)
        return done
    let t0 = brine_clock()
    let rr = stack_mem(8)
    var r = dev_bind()
    let flag = stack_mem(8)
    store_i64(flag, 0, 0)
    let kern = stack_mem(8)
    store_f64(kern, 0, 0.0)
    var oom = false
    var t1 = t0
    var t2 = t0
    if r == 0:
        r = gpu_func(st, k)
    if r == 0 and not gpu_reserve(gplan_size(p), rr):
        r = load_i32(rr, 0)
        oom = r == GPU_OOM
    if r == 0:
        r = gpu_copy_in(p, ctx)
    t1 = brine_clock()
    if r == 0:
        r = gpu_run_for(st, done, n, flag, kern)
    t2 = brine_clock()
    if r == 0 and load_i64(flag, 0) == 0:
        r = gpu_copy_out(p)
    let t3 = brine_clock()
    let bytes = gplan_bytes(p)
    unlock(g + G_RUN)
    gplan_free(p)
    if oom:
        store_ptr(why, 0, cz("too big for the GPU's memory"))
        return done
    if r != 0:
        gpu_fail("running a kernel", r)
        store_ptr(why, 0, g + G_WHY)
        return done
    if load_i64(flag, 0) != 0:
        store_ptr(why, 0, cz("a check failed on the GPU"))
        gpu_log_check(k, n)
        return done
    let copy = (t1 - t0) + (t3 - t2)
    if bytes > 1 << 20 and copy > 0.0:
        lock(g + G_MU)
        store_f64(g, G_BW, 0.5 * (load_f64(g, G_BW) + float(bytes) / copy))
        unlock(g + G_MU)
    if gpu_logging():
        gpu_log_gpu(k, n, "kernel", t3 - t0, load_f64(kern, 0), copy, bytes, load_f64(c, CH_CPU_S))
    return n

# brine_par_plan (brine_rt.h)
fn par_plan(n: int) -> int:
    if n <= 0:
        return 0
    return n if n < 256 else 256

fn brine_par_for(k: ptr, ctx: ptr, n: int, f: ptr):
    if n <= 0:
        return
    var why = gpu_skip(k, n)
    var done = 0
    var before = 0.0
    if addr(why) == 0:
        let w = stack_mem(8)
        let tb = brine_clock()
        done = gpu_for(k, ctx, n, f, w)
        if done >= n:
            return
        why = load_ptr(w, 0)
        before = brine_clock() - tb
    let t0 = brine_clock()
    brine_par_run(done, n, par_plan(n - done), f, ctx)
    let dt = brine_clock() - t0
    if addr(load_ptr(k, K_PTX)) != 0 and n - done >= GPU_MIN_N and brine_x_in_par_get() == 0:
        gpu_note_cpu(kstate(k), n - done, dt)
    if gpu_logging() and brine_x_in_par_get() == 0:
        gpu_log_cpu(k, n, why, dt, before)

# ---- reductions on the GPU

# br_vk_size: the bytes of each BRINE_VK_*
fn vk_size(vk: int) -> int:
    if vk < 10:
        return 1 << (vk % 5)
    if vk == 10:
        return 4
    if vk == 13:
        return 1
    return 8

# Folds leaves [l0, l1) on this thread, pushing each at height 0.
fn fold_leaves(fo: ptr, f: ptr, ctx: ptr, n: int, l0: int, l1: int):
    let v = stack_mem(16)
    let h = stack_mem(8)
    let saved = brine_x_in_par_get()
    brine_x_in_par_set(1)
    for l in l0..l1:
        let a = l * LEAF
        let b = a + LEAF if a + LEAF < n else n
        store_u8(h, 0, u8(0))
        call_void(f, ctx, l, a, b, v, h)
        brine_x_fold_push(fo, 0, v, int(load_u8(h, 0)))
    brine_x_in_par_set(saved)

# One aligned subtree of cnt (up to 2^h) leaves starting at leaf l0 on the
# device; its root to v, has. bufa and bufb: room for `room` values and
# flags each.
fn gpu_subtree(
    k: ptr,
    st: ptr,
    n: int,
    l0: int,
    cnt: int,
    bufa: u64,
    bufb: u64,
    room: int,
    v: ptr,
    has: ptr
) -> i32:
    let sz = vk_size(load_i64(k, K_VK))
    var va = bufa
    var ha = bufa + u64(room * sz)
    var vb = bufb
    var hb = bufb + u64(room * sz)
    var count = cnt
    let args = stack_mem(48)
    store_u64(args, 0, load_u64(gpu(), G_BUF))
    store_i64(args, 8, n)
    store_i64(args, 16, l0)
    store_i64(args, 24, cnt)
    store_u64(args, 32, va)
    store_u64(args, 40, ha)
    var r = dev_run(load_ptr(st, KS_FN), cnt, args, 6)
    let cargs = stack_mem(40)
    while r == 0 and count > 1:
        let blocks = (count + GPU_BLOCK - 1) / GPU_BLOCK
        store_u64(cargs, 0, va)
        store_u64(cargs, 8, ha)
        store_i64(cargs, 16, count)
        store_u64(cargs, 24, vb)
        store_u64(cargs, 32, hb)
        r = dev_comb(load_ptr(st, KS_COMB), blocks, cargs, 5)
        let t = va
        va = vb
        vb = t
        let u = ha
        ha = hb
        hb = u
        count = blocks
    if r == 0:
        r = dev_dtoh(v, va, sz)
    if r == 0:
        r = dev_dtoh(has, ha, 1)
    return r

# The GPU part of a reduction: true when the device (with the CPU's first
# leaves, if it measured them) folded every leaf into fo (made here).
fn gpu_reduce(k: ptr, n: int, f: ptr, ctx: ptr, fo: ptr, loc: ptr, why: ptr, cpu_est: ptr) -> bool:
    let g = gpu()
    let known = stack_mem(8)
    let st = gpu_begin(k, why, known)
    if addr(st) == 0:
        return false
    # (only now: the CPU's reduction has a fold of its own)
    brine_x_fold_init(fo, load_i64(k, K_OP), load_i64(k, K_VK), loc)
    let nleaves = (n + LEAF - 1) / LEAF
    # measure: leaves [0, p), p a power of two, on this thread
    var p = 0
    if load_i64(known, 0) == 0 and gpu_mode() != GPU_ON:
        let t0 = brine_clock()
        p = 1
        fold_leaves(fo, f, ctx, n, 0, 1)
        while p < nleaves and p * 8 < nleaves and brine_clock() - t0 < 1.0e-4:
            fold_leaves(fo, f, ctx, n, p, 2 * p)
            p *= 2
        gpu_note_probe(st, (brine_clock() - t0) * 1.0e9 / float(p * LEAF))
    let rest = n - p * LEAF
    let pl = stack_mem(GP_SIZE)
    if not gpu_plan(pl, k, st, ctx, rest, why):
        gplan_free(pl)
        return false
    let c = stack_mem(32)
    lock(g + G_MU)
    gpu_choose(k, st, rest, gplan_bytes(pl), 2 + rest / (1 << 22), c)
    let gpu_ns = gpu_dev_ns(k, st)
    unlock(g + G_MU)
    store_f64(cpu_est, 0, load_f64(c, CH_CPU_S))
    if load_i64(c, CH_USE) == 0:
        gplan_free(pl)
        store_ptr(why, 0, load_ptr(c, CH_WHY))
        return false
    store_ptr(why, 0, cz("the GPU is busy"))
    if not try_lock(g + G_RUN):
        gplan_free(pl)
        return false
    # subtrees of up to 2^h leaves, about GPU_SLICE each
    var h = 12
    while (
        h < 24 and (1 << h) < nleaves and gpu_ns * 16.0 * float(1 << (h + 1)) < GPU_SLICE * 1.0e9
    ):
        h += 1
    let room = 1 << h
    let sz = vk_size(load_i64(k, K_VK))
    let half = align_up(room * (sz + 1), 256)
    let at = align_up(gplan_size(pl), 256)
    let t0 = brine_clock()
    let rr = stack_mem(8)
    var r = dev_bind()
    let flag = stack_mem(8)
    store_i64(flag, 0, 0)
    var oom = false
    if r == 0:
        r = gpu_func(st, k)
    if r == 0 and not gpu_reserve(at + 2 * half, rr):
        r = load_i32(rr, 0)
        oom = r == GPU_OOM
    if r == 0:
        r = gpu_copy_in(pl, ctx)
    let t1 = brine_clock()
    var l = p
    var seg = p if p > 0 else room
    let v = stack_mem(16)
    let hv = stack_mem(8)
    while r == 0 and l < nleaves:
        if seg > room:
            seg = room
        let cnt = nleaves - l if nleaves - l < seg else seg
        store_u8(hv, 0, u8(0))
        let buf = load_u64(g, G_BUF)
        r = gpu_subtree(k, st, n, l, cnt, buf + u64(at), buf + u64(at + half), room, v, hv)
        if r == 0:
            r = gpu_errflag(flag)
        if r != 0 or load_i64(flag, 0) != 0:
            break
        var sh = 0
        while (1 << sh) < seg:
            sh += 1
        brine_x_fold_push(fo, sh, v, int(load_u8(hv, 0)))
        l += seg
        # aligned: the next subtree is as big as everything before it, up
        # to `room`
        seg = l if p > 0 and l < room else room
    let t2 = brine_clock()
    let bytes = gplan_bytes(pl)
    unlock(g + G_RUN)
    gplan_free(pl)
    if oom:
        store_ptr(why, 0, cz("too big for the GPU's memory"))
        return false
    if r != 0:
        gpu_fail("running a kernel", r)
        store_ptr(why, 0, g + G_WHY)
        return false
    if load_i64(flag, 0) != 0:
        store_ptr(why, 0, cz("a check failed on the GPU"))
        gpu_log_check(k, n)
        return false
    if rest > 0:
        lock(g + G_MU)
        store_f64(st, KS_GPU, (t2 - t1) * 1.0e9 / float(rest))
        if bytes > 1 << 20 and t1 > t0:
            store_f64(g, G_BW, 0.5 * (load_f64(g, G_BW) + float(bytes) / (t1 - t0)))
        unlock(g + G_MU)
    if gpu_logging():
        gpu_log_gpu(k, n, "kernels", t2 - t0, t2 - t1, t1 - t0, bytes, load_f64(c, CH_CPU_S))
    return true

fn brine_par_reduce(k: ptr, n: int, f: ptr, ef: ptr, ctx: ptr, val: ptr, has: ptr, loc: ptr):
    if n <= 0:
        return
    var why = gpu_skip(k, n)
    var before = 0.0
    if addr(why) == 0:
        let fo = stack_mem(FOLD_SIZE)
        let w = stack_mem(8)
        let est = stack_mem(8)
        store_f64(est, 0, 0.0)
        let tb = brine_clock()
        if gpu_reduce(k, n, f, ctx, fo, loc, w, est):
            if brine_x_fold_finish(fo, val) != 0:
                store_u8(has, 0, u8(1))
            return
        why = load_ptr(w, 0)
        before = brine_clock() - tb
    let t0 = brine_clock()
    brine_x_reduce_cpu(n, f, ef, ctx, load_i64(k, K_OP), load_i64(k, K_VK), val, has, loc)
    let dt = brine_clock() - t0
    if addr(load_ptr(k, K_PTX)) != 0 and n >= GPU_MIN_N and brine_x_in_par_get() == 0:
        gpu_note_cpu(kstate(k), n, dt)
    if gpu_logging() and brine_x_in_par_get() == 0:
        gpu_log_cpu(k, n, why, dt, before)

# ------------------------------------------- files, stdin and the os module
# brine_rt.c's "files and processes", "stdin" and "the os module". Messages
# read as the C ones did: the C library's strerror, Windows' FormatMessageW.

extern fn strerror(e: i32) -> ptr

extern fn fopen(path: ptr, mode: ptr) -> ptr

extern fn _wfopen(path: ptr, mode: ptr) -> ptr

extern fn fread(p: ptr, size: u64, n: u64, f: ptr) -> u64

extern fn fclose(f: ptr) -> i32

extern fn ferror(f: ptr) -> i32

extern fn _fseeki64(f: ptr, off: i64, origin: i32) -> i32

extern fn _ftelli64(f: ptr) -> i64

extern fn fseeko(f: ptr, off: i64, whence: i32) -> i32

extern fn ftello(f: ptr) -> i64

extern fn wcslen(w: ptr) -> u64

extern fn GetLastError() -> u32

extern fn SetLastError(e: u32)

extern fn MultiByteToWideChar(cp: u32, flags: u32, s: ptr, n: i32, w: ptr, wn: i32) -> i32

extern fn WideCharToMultiByte(
    cp: u32,
    flags: u32,
    w: ptr,
    n: i32,
    s: ptr,
    sn: i32,
    d: ptr,
    u: ptr
) -> i32

extern fn GetFileAttributesW(path: ptr) -> u32

extern fn GetEnvironmentVariableW(name: ptr, buf: ptr, n: u32) -> u32

extern fn statx(dir: i32, path: ptr, flags: i32, mask: u32, buf: ptr) -> i32

extern fn stat(path: ptr, buf: ptr) -> i32

const CP_UTF8: u32 = 65001

# GetFileAttributesW's failure
const NO_ATTRS: u32 = 0xffffffff

# struct statx (Linux, every processor): stx_mode, a u16
const STATX_MODE = 28

# struct stat (macOS): st_mode, a u16
const MAC_ST_MODE = 4

# The C library's errno.
fn os_errno() -> int:
    if os_is("windows"):
        return int(load_i32(_errno(), 0))
    elif os_is("macos"):
        return int(load_i32(__error(), 0))
    else:
        return int(load_i32(__errno_location(), 0))

fn os_set_errno(e: int):
    if os_is("windows"):
        store_i32(_errno(), 0, i32(e))
    elif os_is("macos"):
        store_i32(__error(), 0, i32(e))
    else:
        store_i32(__errno_location(), 0, i32(e))

# The C library's stdout (1) or stderr (2).
fn os_stdio(i: int) -> ptr:
    if os_is("windows"):
        return __acrt_iob_func(u32(i))
    elif os_is("macos"):
        return load_ptr(symbol("__stdoutp") if i == 1 else symbol("__stderrp"), 0)
    else:
        return load_ptr(symbol("stdout") if i == 1 else symbol("stderr"), 0)

# A C string's text.
# A C string from the system (a file name, an environment variable, an
# argument) as a string, which has to be UTF-8: other bytes become U+FFFD.
fn os_text(p: ptr) -> ptr:
    return os_lossy_str(p, int(strlen(p)))

fn os_strerror(e: int) -> ptr:
    return os_text(strerror(i32(e)))

# A reference to message s, cut at 1023 bytes as the C one's buffer did.
fn os_msg(s: str) -> ptr:
    let p = ptr_of(s)
    if load_i64(p, STR_LEN) > 1023:
        return brine_str_new(p + STR_DATA, 1023)
    str_retain(p)
    return p

# s as a C string (its bytes end in a NUL already), or 0 when s holds a NUL,
# which no path or argument can
fn os_cstr(s: ptr) -> ptr:
    let n = load_i64(s, STR_LEN)
    if n != 0 and addr(memchr(s + STR_DATA, 0, u64(n))) != 0:
        return null_ptr()
    return s + STR_DATA

# C string s in UTF-16, NUL-terminated (a block of brine_alloc's).
fn os_wide(s: ptr) -> ptr:
    let n = int(MultiByteToWideChar(CP_UTF8, 0, s, -1, null_ptr(), 0))
    let w = blk_alloc(2 * (n if n > 0 else 1))
    if n <= 0:
        store_u16(w, 0, 0)
    else:
        MultiByteToWideChar(CP_UTF8, 0, s, -1, w, i32(n))
    return w

# os_wide for a path given to the file APIs. Those stop at 260 characters
# (MAX_PATH) unless the path is absolute and starts with `\\?\` (`\\?\UNC\`
# for `\\server\share`), so a long one is made so.
fn os_wpath(s: ptr) -> ptr:
    let w = os_wide(s)
    let n = int(wcslen(w))
    if n >= 4 and load_u16(w, 2) == 63 and load_u16(w, 0) == 92:
        return w
    # (the length that counts is the absolute one: a short relative path in a
    # deep directory is long too; CreateDirectoryW's limit is 248, leaving
    # room for a file name)
    let m = int(GetFullPathNameW(w, 0, null_ptr(), null_ptr()))
    if m < 240:
        return w
    let full = blk_alloc(2 * m)
    let got = int(GetFullPathNameW(w, u32(m), full, null_ptr()))
    if got <= 0 or got >= m:
        blk_free(full)
        return w
    blk_free(w)
    # `\\?\C:\...`, or `\\?\UNC\server\...` for `\\server\...`
    let unc = load_u16(full, 0) == 92 and load_u16(full, 2) == 92
    # (a device path, `\\.\...`, is left as it is)
    if unc and load_u16(full, 4) == 46:
        return full
    let pre = "\\\\?\\UNC" if unc else "\\\\?\\"
    let skip = 1 if unc else 0
    let out = blk_alloc(2 * (len(pre) + got + 1))
    for i in range(len(pre)):
        store_u16(out, 2 * i, u16(load_u8(ptr_of(pre) + STR_DATA, i)))
    memcpy(out + 2 * len(pre), full + 2 * skip, u64(2 * (got - skip + 1)))
    blk_free(full)
    return out

# n UTF-16 units (n < 0: up to the NUL) as a string; bad surrogates
# become U+FFFD
fn os_from_wide(w: ptr, n0: int) -> ptr:
    let n = int(wcslen(w)) if n0 < 0 else n0
    if n == 0:
        return new_str(0)
    let m = int(WideCharToMultiByte(CP_UTF8, 0, w, i32(n), null_ptr(), 0, null_ptr(), null_ptr()))
    if m <= 0:
        return new_str(0)
    let s = new_str(m)
    WideCharToMultiByte(CP_UTF8, 0, w, i32(n), s + STR_DATA, i32(m), null_ptr(), null_ptr())
    return s

# The index of the first of the n bytes at p where they stop being UTF-8
# (RFC 3629: no overlong forms, surrogates or code points past U+10FFFF),
# or -1. ASCII goes 16 bytes at a time.
fn os_utf8_bad(p: ptr, n: int) -> int:
    var i = 0
    while i < n:
        if i + 16 <= n and (load_u64(p, i) | load_u64(p, i + 8)) & 0x8080808080808080 == 0:
            i += 16
            continue
        if load_u8(p, i) < 0x80:
            i += 1
            continue
        let k = utf8_valid_len(p + i, n - i)
        if k == 0:
            return i
        i += k
    return -1

# The length of the UTF-8 character at p (2 to 4 bytes, of `avail`), or 0
# when the bytes there aren't one (RFC 3629's table: the second byte's range
# depends on the first).
fn utf8_valid_len(p: ptr, avail: int) -> int:
    let b = load_u8(p, 0)
    var w = 0
    var lo: u8 = 0x80
    var hi: u8 = 0xbf
    if b >= 0xc2 and b <= 0xdf:
        w = 2
    elif b >= 0xe0 and b <= 0xef:
        w = 3
        if b == 0xe0:
            lo = 0xa0
        elif b == 0xed:
            hi = 0x9f
    elif b >= 0xf0 and b <= 0xf4:
        w = 4
        if b == 0xf0:
            lo = 0x90
        elif b == 0xf4:
            hi = 0x8f
    if w == 0 or w > avail:
        return 0
    let c = load_u8(p, 1)
    if c < lo or c > hi:
        return 0
    for j in 2..w:
        if load_u8(p, j) & 0xc0 != 0x80:
            return 0
    return w

fn brine_str_from_utf8(a: ptr, out: ptr) -> bool:
    let d = load_ptr(a, ARR_DATA)
    let n = load_i64(a, ARR_LEN)
    let bad = os_utf8_bad(d, n)
    if bad >= 0:
        let c = u64(load_u8(d, bad))
        let h = ptr_of(HEX) + STR_DATA
        let sb = stack_mem(24)
        brine_sb_init(sb)
        sb_lit(sb, f"invalid UTF-8: byte {bad} (0x")
        sb_byte(sb, load_u8(h, c >> 4))
        sb_byte(sb, load_u8(h, c & 15))
        sb_lit(sb, ") starts no character")
        store_ptr(out, 0, brine_sb_finish(sb))
        return false
    store_ptr(out, 0, brine_str_new(d, n))
    return true

# Text read from outside as a string: bytes that aren't UTF-8 become U+FFFD.
fn os_lossy_str(p: ptr, n: int) -> ptr:
    if os_utf8_bad(p, n) < 0:
        return brine_str_new(p, n)
    return os_lossy(p, n)

# fopen of C strings path and mode
fn os_fopen(path: ptr, mode: str) -> ptr:
    let m = ptr_of(mode) + STR_DATA
    if os_is("windows"):
        let wp = os_wpath(path)
        let wm = os_wide(m)
        let f = _wfopen(wp, wm)
        # (freeing leaves errno as it is)
        blk_free(wp)
        blk_free(wm)
        return f
    else:
        return fopen(path, m)

# The length of the file f is open on, back at its start; -1 when seeking
# doesn't tell (a pipe), -2 when it can't get back to the start.
fn os_flen(f: ptr) -> int:
    var n: i64 = -1
    var back = 0
    if os_is("windows"):
        if _fseeki64(f, 0, 2) == 0:
            n = _ftelli64(f)
            back = int(_fseeki64(f, 0, 0))
    else:
        if fseeko(f, 0, 2) == 0:
            n = ftello(f)
            back = int(fseeko(f, 0, 0))
    if back != 0:
        return -2
    return int(n)

# All of the file at `path`: its bytes (brine_alloc's), their count and the
# size of the block in out[0], out[1] and out[2], or false with the message
# in *err.
fn os_slurp(path: ptr, out: ptr, err: ptr) -> bool:
    let p = os_cstr(path)
    if addr(p) == 0:
        store_ptr(err, 0, os_msg("cannot read a path containing a NUL byte"))
        return false
    # (Windows says "Permission denied", Linux opens it and fails to read)
    if os_kind(p) == 2:
        store_ptr(err, 0, os_msg(f"cannot read {str_of(path)}: it is a directory, not a file"))
        return false
    let f = os_fopen(p, "rb")
    if addr(f) == 0:
        let e = os_strerror(os_errno())
        store_ptr(err, 0, os_msg(f"cannot read {str_of(path)}: {str_of(e)}"))
        str_release(e)
        return false
    var b = null_ptr()
    var n = 0
    var cap = 0
    # a file of known length: read into one block of that size (and a byte
    # more, for the read that finds the end), not a growing one copied
    # each time it grows. (Its length is only a hint: /proc files say 0.)
    let flen = os_flen(f)
    var bad = flen == -2
    if flen > 0:
        cap = flen + 1
        b = brine_x_realloc(b, cap)
    while not bad:
        if n == cap:
            cap = cap * 2 if cap != 0 else 65536
            b = brine_x_realloc(b, cap)
        let got = int(fread(b + n, 1, u64(cap - n), f))
        n += got
        if got == 0:
            break
    if ferror(f) != 0:
        bad = true
    fclose(f)
    if bad:
        store_ptr(err, 0, os_msg(f"cannot read {str_of(path)}: read error"))
        if addr(b) != 0:
            brine_free(b)
        return false
    store_ptr(out, 0, b)
    store_i64(out, 8, n)
    store_i64(out, 16, cap)
    return true

fn brine_read_file(path: ptr, out: ptr) -> bool:
    let got = stack_mem(24)
    if not os_slurp(path, got, out):
        return false
    let b = load_ptr(got, 0)
    let n = load_i64(got, 8)
    let ok = os_utf8_bad(b, n) < 0
    if ok:
        store_ptr(out, 0, brine_str_new(b, n))
    else:
        store_ptr(out, 0, os_msg(f"cannot read {str_of(path)}: the file is not valid UTF-8 text"))
    brine_free(b)
    return ok

fn brine_os_read_bytes(path: ptr, out: ptr, err: ptr) -> bool:
    let got = stack_mem(24)
    if not os_slurp(path, got, err):
        return false
    let b = load_ptr(got, 0)
    let n = load_i64(got, 8)
    let a = brine_arr_new(0, 1, null_ptr(), null_ptr(), ptr_of("") + STR_DATA)
    # the array takes the block the bytes were read into: no copy, so a big
    # file is in memory once
    if n != 0:
        store_ptr(a, ARR_DATA, b)
        store_i64(a, ARR_LEN, n)
        store_i64(a, ARR_CAP, load_i64(got, 16))
    elif addr(b) != 0:
        brine_free(b)
    store_ptr(out, 0, a)
    return true

# Writes (mode "wb") or appends ("ab") the n bytes at d to the file at `path`.
fn os_put_file(path: ptr, d: ptr, n: int, mode: str, err: ptr) -> bool:
    let verb = "append to" if load_u8(ptr_of(mode), STR_DATA) == 97 else "write"
    let p = os_cstr(path)
    if addr(p) == 0:
        store_ptr(err, 0, os_msg(f"cannot {verb} a path containing a NUL byte"))
        return false
    let f = os_fopen(p, mode)
    if addr(f) == 0:
        let e = os_strerror(os_errno())
        store_ptr(err, 0, os_msg(f"cannot {verb} {str_of(path)}: {str_of(e)}"))
        str_release(e)
        return false
    var bad = false
    if n != 0:
        bad = fwrite(d, 1, u64(n), f) != u64(n)
    if fclose(f) != 0:
        bad = true
    if bad:
        store_ptr(err, 0, os_msg(f"cannot {verb} {str_of(path)}: write error (is the disk full?)"))
    return not bad

fn brine_write_file(path: ptr, text: ptr, err: ptr) -> bool:
    return os_put_file(path, text + STR_DATA, load_i64(text, STR_LEN), "wb", err)

fn brine_append_file(path: ptr, text: ptr, err: ptr) -> bool:
    return os_put_file(path, text + STR_DATA, load_i64(text, STR_LEN), "ab", err)

fn brine_os_write_bytes(path: ptr, data: ptr, err: ptr) -> bool:
    return os_put_file(path, load_ptr(data, ARR_DATA), load_i64(data, ARR_LEN), "wb", err)

fn brine_os_append_bytes(path: ptr, data: ptr, err: ptr) -> bool:
    return os_put_file(path, load_ptr(data, ARR_DATA), load_i64(data, ARR_LEN), "ab", err)

# Does stat succeed on C string p (following links)? Its st_mode in *mode.
fn os_stat(p: ptr, mode: ptr) -> bool:
    if os_is("macos"):
        let st = stack_mem(144)
        if stat(p, st) != 0:
            return false
        store_u32(mode, 0, u32(load_u16(st, MAC_ST_MODE)))
        return true
    else:
        # statx: one layout on every processor (and in glibc since 2.28)
        let st = stack_mem(256)
        # AT_FDCWD; STATX_TYPE | STATX_MODE
        if statx(-100, p, 0, 3, st) != 0:
            return false
        store_u32(mode, 0, u32(load_u16(st, STATX_MODE)))
        return true

fn brine_file_exists(path: ptr) -> bool:
    let p = os_cstr(path)
    if addr(p) == 0:
        return false
    if os_is("windows"):
        let w = os_wpath(p)
        let a = GetFileAttributesW(w)
        blk_free(w)
        return a != NO_ATTRS
    else:
        let mode = stack_mem(8)
        return os_stat(p, mode)

# The variable's value, or 0 when it isn't set.
fn brine_getenv(name: ptr) -> ptr:
    let n = os_cstr(name)
    if addr(n) == 0 or load_u8(n, 0) == 0:
        return null_ptr()
    if addr(memchr(n, 61, u64(load_i64(name, STR_LEN)))) != 0:
        return null_ptr()
    if os_is("windows"):
        let w = os_wide(n)
        SetLastError(0)
        let need = GetEnvironmentVariableW(w, null_ptr(), 0)
        if need == 0:
            blk_free(w)
            return null_ptr()
        let buf = blk_alloc(2 * int(need))
        let got = GetEnvironmentVariableW(w, buf, need)
        blk_free(w)
        let s = new_str(0) if got == 0 else os_from_wide(buf, int(got))
        blk_free(buf)
        return s
    else:
        let v = getenv(n)
        if addr(v) == 0:
            return null_ptr()
        return os_text(v)

# ---- stdin
# Read with read() / ReadFile, which return what has arrived, so a program
# talking a line protocol through a pipe gets each line as it comes. A
# Windows console is read as UTF-16 (ReadConsoleW), so typed text arrives
# as UTF-8 whatever the code page.

extern fn read(fd: i32, buf: ptr, n: u64) -> int

extern fn GetStdHandle(which: u32) -> ptr

extern fn GetConsoleMode(h: ptr, mode: ptr) -> i32

extern fn SetConsoleMode(h: ptr, mode: u32) -> i32

extern fn ReadConsoleW(h: ptr, buf: ptr, n: u32, got: ptr, ctl: ptr) -> i32

extern fn ReadFile(h: ptr, buf: ptr, n: u32, got: ptr, ov: ptr) -> i32

# (DWORD)-10, -11, -12
const STD_INPUT: u32 = 0xfffffff6
const STD_OUTPUT: u32 = 0xfffffff5
const STD_ERROR: u32 = 0xfffffff4

const EINTR = 4
const EIO = 5

# global_mem("os_in"): what was read and not yet taken, p[pos..len), the
# room, whether the input ended, its error (an errno); on Windows whether
# stdin is a console (0: not known yet, 1: no, 2: yes) and a high
# surrogate whose pair comes in the next read
const IN_P = 0
const IN_LEN = 8
const IN_POS = 16
const IN_CAP = 24
const IN_EOF = 32
const IN_ERR = 36
const IN_CONSOLE = 40
const IN_HI = 44

fn os_in_eof(b: ptr, e: int) -> bool:
    if e != 0:
        store_i32(b, IN_ERR, i32(e))
    store_u8(b, IN_EOF, 1)
    return false

# Reads more of stdin into p[len..]; false at its end or on an error.
fn os_in_fill() -> bool:
    let b = global_mem("os_in", 48)
    while true:
        if load_u8(b, IN_EOF) != 0:
            return false
        let pos = load_i64(b, IN_POS)
        if pos > 0:
            let len0 = load_i64(b, IN_LEN)
            memmove(load_ptr(b, IN_P), load_ptr(b, IN_P) + pos, u64(len0 - pos))
            store_i64(b, IN_LEN, len0 - pos)
            store_i64(b, IN_POS, 0)
        var cap = load_i64(b, IN_CAP)
        if cap - load_i64(b, IN_LEN) < 16384:
            cap = cap * 2 if cap != 0 else 65536
            store_ptr(b, IN_P, brine_x_realloc(load_ptr(b, IN_P), cap))
            store_i64(b, IN_CAP, cap)
        let len = load_i64(b, IN_LEN)
        let at = load_ptr(b, IN_P) + len
        let room = cap - len
        var got = 0
        if os_is("windows"):
            let h = GetStdHandle(STD_INPUT)
            if addr(h) == 0 or addr(h) == ONES:
                return os_in_eof(b, 0)
            if load_u8(b, IN_CONSOLE) == 0:
                let mode = stack_mem(8)
                store_u8(b, IN_CONSOLE, 2 if GetConsoleMode(h, mode) != 0 else 1)
            let nr = stack_mem(8)
            store_u32(nr, 0, 0)
            if load_u8(b, IN_CONSOLE) == 2:
                # at most 3 UTF-8 bytes per UTF-16 unit (a pair makes 4)
                let w = stack_mem(8192)
                let hi = load_u16(b, IN_HI)
                let k = 1 if hi != 0 else 0
                store_u16(w, 0, hi)
                store_u16(b, IN_HI, 0)
                let lim = room / 3 - 1
                let want = (lim if lim < 4095 else 4095) - k
                if ReadConsoleW(h, w + k * 2, u32(want), nr, null_ptr()) == 0:
                    return os_in_eof(b, EIO)
                var n = int(load_u32(nr, 0)) + k
                # Ctrl+Z at the start of a line ends the input, as in the C library
                if n == 0 or load_u16(w, 0) == 0x1a:
                    return os_in_eof(b, 0)
                let last = load_u16(w, (n - 1) * 2)
                if last >= 0xd800 and last < 0xdc00:
                    store_u16(b, IN_HI, last)
                    n -= 1
                var m = 0
                if n != 0:
                    m = int(
                        WideCharToMultiByte(
                            CP_UTF8,
                            0,
                            w,
                            i32(n),
                            at,
                            i32(room),
                            null_ptr(),
                            null_ptr()
                        )
                    )
                # the console ends lines with \r\n
                var j = 0
                for i in 0..m:
                    let c = load_u8(at, i)
                    if not (c == 13 and i + 1 < m and load_u8(at, i + 1) == 10):
                        store_u8(at, j, c)
                        j += 1
                got = j
                if got == 0:
                    continue
            else:
                let want = room if room < (1 << 30) else (1 << 30)
                if ReadFile(h, at, u32(want), nr, null_ptr()) == 0:
                    let e = GetLastError()
                    # ERROR_BROKEN_PIPE, ERROR_HANDLE_EOF: the writer is done
                    return os_in_eof(b, 0 if e == 109 or e == 38 else EIO)
                got = int(load_u32(nr, 0))
        else:
            var n = read(0, at, u64(room))
            while n < 0 and os_errno() == EINTR:
                n = read(0, at, u64(room))
            if n < 0:
                return os_in_eof(b, os_errno())
            got = n
        if got == 0:
            return os_in_eof(b, 0)
        store_i64(b, IN_LEN, len + got)
        return true
    return false

fn brine_input(prompt: ptr) -> ptr:
    if addr(prompt) != 0 and load_i64(prompt, STR_LEN) != 0:
        let sb = stack_mem(24)
        brine_sb_init(sb)
        brine_sb_str(sb, prompt)
        brine_out_sb(sb)
    # what was printed before (a prompt with `end=""`) shows before the wait
    brine_flush()
    let b = global_mem("os_in", 48)
    var seen = 0
    var n = 0
    while true:
        let at = load_ptr(b, IN_P) + load_i64(b, IN_POS)
        let have = load_i64(b, IN_LEN) - load_i64(b, IN_POS)
        if have > seen:
            let nl = memchr(at + seen, 10, u64(have - seen))
            if addr(nl) != 0:
                n = int(addr(nl) - addr(at))
                break
        seen = have
        if not os_in_fill():
            n = load_i64(b, IN_LEN) - load_i64(b, IN_POS)
            if n == 0:
                return null_ptr()
            break
    let pos = load_i64(b, IN_POS)
    let line = load_ptr(b, IN_P) + pos
    store_i64(b, IN_POS, pos + (n + 1 if n < load_i64(b, IN_LEN) - pos else n))
    if n > 0 and load_u8(line, n - 1) == 13:
        n -= 1
    return os_lossy_str(line, n)

fn brine_read_stdin(out: ptr) -> bool:
    brine_flush()
    while os_in_fill():
        pass
    let b = global_mem("os_in", 48)
    let e = int(load_i32(b, IN_ERR))
    if e != 0:
        let m = os_strerror(e)
        store_ptr(out, 0, os_msg(f"cannot read stdin: {str_of(m)}"))
        str_release(m)
        return false
    let p = load_ptr(b, IN_P) + load_i64(b, IN_POS)
    let n = load_i64(b, IN_LEN) - load_i64(b, IN_POS)
    store_i64(b, IN_POS, load_i64(b, IN_LEN))
    if os_utf8_bad(p, n) >= 0:
        store_ptr(out, 0, os_msg("cannot read stdin: the input is not valid UTF-8 text"))
        return false
    store_ptr(out, 0, brine_str_new(p, n))
    return true

# ---- run
extern fn posix_spawnp(pid: ptr, file: ptr, fa: ptr, attr: ptr, argv: ptr, envp: ptr) -> i32

extern fn waitpid(pid: i32, status: ptr, flags: i32) -> i32

extern fn _NSGetEnviron() -> ptr

extern fn CreateProcessW(
    app: ptr,
    line: ptr,
    pa: ptr,
    ta: ptr,
    inherit: i32,
    flags: u32,
    env: ptr,
    dir: ptr,
    si: ptr,
    pi: ptr
) -> i32

extern fn GetExitCodeProcess(h: ptr, code: ptr) -> i32

# STARTUPINFOW: cb, dwFlags, hStdInput, hStdOutput, hStdError
const SI_SIZE = 104
const SI_FLAGS = 60
const SI_IN = 80
const SI_OUT = 88
const SI_ERR = 96

# PROCESS_INFORMATION: hProcess, hThread
const PI_PROC = 0
const PI_THREAD = 8

const INFINITE: u32 = 0xffffffff

# The environment (the C library's `environ`).
fn os_environ() -> ptr:
    if os_is("macos"):
        return load_ptr(_NSGetEnviron(), 0)
    else:
        return load_ptr(symbol("environ"), 0)

# Is byte c one of the bytes of `set`?
fn os_in_set(c: u8, set: str) -> bool:
    let p = ptr_of(set)
    for i in 0..load_i64(p, STR_LEN):
        if load_u8(p, STR_DATA + i) == c:
            return true
    return false

# Does C string a hold a byte of `set`? (strpbrk)
fn os_has_any(a: ptr, set: str) -> bool:
    var i = 0
    while load_u8(a, i) != 0:
        if os_in_set(load_u8(a, i), set):
            return true
        i += 1
    return false

fn os_backslashes(sb: ptr, n: int):
    for i in 0..n:
        sb_byte(sb, 92)

# One argument of a command line (C string a), quoted so the child's argv
# parser gets it back unchanged.
fn os_quote_arg(sb: ptr, a: ptr):
    if load_u8(a, 0) != 0 and not os_has_any(a, " \t\n\u{b}\""):
        brine_sb_cat(sb, a, int(strlen(a)))
        return
    sb_byte(sb, 34)
    var i = 0
    while true:
        var slashes = 0
        while load_u8(a, i) == 92:
            slashes += 1
            i += 1
        let c = load_u8(a, i)
        if c == 0:
            os_backslashes(sb, slashes * 2)
            break
        os_backslashes(sb, slashes * 2 + 1 if c == 34 else slashes)
        sb_byte(sb, c)
        i += 1
    sb_byte(sb, 34)

# A wait status as run() reports it: the exit code, 128 + the signal, or -1.
fn os_run_code(st: int) -> int:
    let sig = st & 0x7f
    if sig == 0:
        return (st >> 8) & 0xff
    if sig != 0x7f:
        return 128 + sig
    return -1

# Runs a program and waits for it. False (with *err set) if it couldn't be
# started.
fn brine_run(argv: ptr, code: ptr, err: ptr) -> bool:
    store_i64(code, 0, 0)
    # the child writes to the same stdout: what we printed comes first
    brine_flush()
    let n = load_i64(argv, ARR_LEN)
    if n == 0:
        store_ptr(err, 0, os_msg("run() needs a program name, but the command list is empty"))
        return false
    let d = load_ptr(argv, ARR_DATA)
    let cv = blk_alloc(8 * (n + 1))
    var ok = true
    for i in 0..n:
        let c = os_cstr(load_ptr(d, i * 8))
        store_ptr(cv, i * 8, c)
        if addr(c) == 0 and ok:
            store_ptr(err, 0, os_msg(f"run(): argument {i} contains a NUL byte"))
            ok = false
    store_ptr(cv, n * 8, null_ptr())
    fflush(os_stdio(1))
    fflush(os_stdio(2))
    let c0 = str_of(load_ptr(d, 0))
    if ok:
        if os_is("windows"):
            let sb = stack_mem(24)
            brine_sb_init(sb)
            for i in 0..n:
                if i != 0:
                    sb_byte(sb, 32)
                os_quote_arg(sb, load_ptr(cv, i * 8))
            let line = brine_sb_finish(sb)
            let wl = os_wide(line + STR_DATA)
            str_release(line)
            let si = stack_mem(SI_SIZE)
            memset(si, 0, u64(SI_SIZE))
            store_u32(si, 0, u32(SI_SIZE))
            let pi = stack_mem(24)
            if (
                CreateProcessW(
                    null_ptr(),
                    wl,
                    null_ptr(),
                    null_ptr(),
                    1,
                    0,
                    null_ptr(),
                    null_ptr(),
                    si,
                    pi
                )
                == 0
            ):
                let e = GetLastError()
                if e == 2 or e == 3:
                    store_ptr(err, 0, os_msg(f"cannot run {c0}: program not found"))
                else:
                    store_ptr(err, 0, os_msg(f"cannot run {c0}: error {e}"))
                ok = false
            else:
                let h = load_ptr(pi, PI_PROC)
                WaitForSingleObject(h, INFINITE)
                let c = stack_mem(8)
                store_u32(c, 0, 0)
                GetExitCodeProcess(h, c)
                CloseHandle(h)
                CloseHandle(load_ptr(pi, PI_THREAD))
                store_i64(code, 0, int(load_i32(c, 0)))
            blk_free(wl)
        else:
            let pid = stack_mem(8)
            store_i64(pid, 0, 0)
            let r = int(
                posix_spawnp(pid, load_ptr(cv, 0), null_ptr(), null_ptr(), cv, os_environ())
            )
            if r != 0:
                if r == 2:
                    store_ptr(err, 0, os_msg(f"cannot run {c0}: program not found"))
                else:
                    let m = os_strerror(r)
                    store_ptr(err, 0, os_msg(f"cannot run {c0}: {str_of(m)}"))
                    str_release(m)
                ok = false
            else:
                let st = stack_mem(8)
                store_i64(st, 0, 0)
                while waitpid(load_i32(pid, 0), st, 0) < 0 and os_errno() == EINTR:
                    pass
                store_i64(code, 0, os_run_code(int(load_i32(st, 0))))
    blk_free(cv)
    return ok

# ---- the os module
extern fn FormatMessageW(
    flags: u32,
    src: ptr,
    id: u32,
    lang: u32,
    buf: ptr,
    n: u32,
    args: ptr
) -> u32

extern fn FindFirstFileExW(pat: ptr, level: i32, fd: ptr, op: i32, filter: ptr, flags: u32) -> ptr

extern fn FindNextFileW(h: ptr, fd: ptr) -> i32

extern fn FindClose(h: ptr) -> i32

extern fn CreateFileW(
    path: ptr,
    access: u32,
    share: u32,
    sa: ptr,
    disp: u32,
    flags: u32,
    tmpl: ptr
) -> ptr

extern fn GetFileInformationByHandle(h: ptr, info: ptr) -> i32

extern fn CreateDirectoryW(path: ptr, sa: ptr) -> i32

extern fn DeleteFileW(path: ptr) -> i32

extern fn MoveFileExW(a: ptr, b: ptr, flags: u32) -> i32

extern fn GetCurrentDirectoryW(n: u32, buf: ptr) -> u32

extern fn SetCurrentDirectoryW(path: ptr) -> i32

extern fn GetModuleFileNameW(m: ptr, buf: ptr, n: u32) -> u32

extern fn GetModuleHandleW(name: ptr) -> ptr

extern fn GetTempPathW(n: u32, buf: ptr) -> u32

extern fn GetFullPathNameW(name: ptr, n: u32, buf: ptr, file: ptr) -> u32

extern fn GetFinalPathNameByHandleW(h: ptr, buf: ptr, n: u32, flags: u32) -> u32

extern fn GetFileType(h: ptr) -> u32

extern fn GetFileInformationByHandleEx(h: ptr, class: i32, buf: ptr, n: u32) -> i32

extern fn opendir(path: ptr) -> ptr

extern fn readdir(d: ptr) -> ptr

extern fn closedir(d: ptr) -> i32

extern fn mkdir(path: ptr, mode: u32) -> i32

extern fn unlink(path: ptr) -> i32

extern fn rename(a: ptr, b: ptr) -> i32

extern fn getcwd(buf: ptr, n: u64) -> ptr

extern fn chdir(path: ptr) -> i32

extern fn readlink(path: ptr, buf: ptr, n: u64) -> int

extern fn _NSGetExecutablePath(buf: ptr, n: ptr) -> i32

extern fn realpath(path: ptr, out: ptr) -> ptr

extern fn isatty(fd: i32) -> i32

# WIN32_FIND_DATAW: cFileName, MAX_PATH UTF-16 units
const FD_SIZE = 592
const FD_NAME = 44

# struct dirent: d_name (glibc, on every processor; macOS)
const DIRENT_NAME = 19
const MAC_DIRENT_NAME = 21

# SYSTEM_INFO: dwNumberOfProcessors
const SYSI_NCPU = 32

const ATTR_DIR: u32 = 0x10
const ATTR_LINK: u32 = 0x400

# FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE
const SHARE_ALL: u32 = 7
const OPEN_EXISTING: u32 = 3
const BACKUP_SEMANTICS: u32 = 0x02000000

# INVALID_HANDLE_VALUE
fn os_bad_handle() -> ptr:
    return null_ptr() - 1

# The C int of a 32-bit code (an error number from a DWORD).
fn os_c_int(code: int) -> int:
    let c = code & 0xffffffff
    return c - 0x100000000 if c >= 0x80000000 else c

# The text Rust's io::Error prints for an OS error code.
fn os_err(code: int) -> ptr:
    let c = os_c_int(code)
    if os_is("windows"):
        let buf = stack_mem(4096)
        # FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS
        var n = int(FormatMessageW(0x1200, null_ptr(), u32(code), 0, buf, 2048, null_ptr()))
        if n == 0:
            let e = GetLastError()
            return os_msg(f"OS Error {c} (FormatMessageW() returned error {e}) (os error {c})")
        while n > 0:
            let ch = load_u16(buf, (n - 1) * 2)
            if ch != 13 and ch != 10 and ch != 32 and ch != 9:
                break
            n -= 1
        let m = os_from_wide(buf, n)
        let s = brine_str_concat(m, ptr_of(f" (os error {c})"))
        str_release(m)
        return s
    else:
        let m = os_strerror(code)
        let s = os_msg(f"{str_of(m)} (os error {c})")
        str_release(m)
        return s

fn os_nul_err() -> ptr:
    return os_msg("file name contained an unexpected NUL byte")

# Bytes as a string, invalid UTF-8 replaced as Rust's
# String::from_utf8_lossy does.
fn os_lossy(p: ptr, n: int) -> ptr:
    let sb = stack_mem(24)
    brine_sb_init(sb)
    var i = 0
    # the start of the valid bytes not copied yet
    var run = 0
    while i < n:
        let b = load_u8(p, i)
        if b < 0x80:
            i += 1
            continue
        var w = 0
        if b >= 0xc2 and b <= 0xdf:
            w = 2
        elif b >= 0xe0 and b <= 0xef:
            w = 3
        elif b >= 0xf0 and b <= 0xf4:
            w = 4
        var j = i + 1
        if w != 0:
            var lo: u8 = 0x80
            var hi: u8 = 0xbf
            if b == 0xe0:
                lo = 0xa0
            elif b == 0xed:
                hi = 0x9f
            elif b == 0xf0:
                lo = 0x90
            elif b == 0xf4:
                hi = 0x8f
            if j < n and load_u8(p, j) >= lo and load_u8(p, j) <= hi:
                j += 1
                while j - i < w and j < n and load_u8(p, j) >= 0x80 and load_u8(p, j) <= 0xbf:
                    j += 1
                if j - i == w:
                    i = j
                    continue
        brine_sb_cat(sb, p + run, i - run)
        sb_lit(sb, "\u{fffd}")
        i = j
        run = i
    brine_sb_cat(sb, p + run, n - run)
    return brine_sb_finish(sb)

# Compares two strings by their slots (for brine_arr_sort).
fn brine_x_os_cmp_strp(a: ptr, b: ptr) -> i32:
    return brine_str_cmp(load_ptr(a, 0), load_ptr(b, 0))

# Is the UTF-16 name at w "." or ".."?
fn os_dots_w(w: ptr) -> bool:
    if load_u16(w, 0) != 46:
        return false
    let c = load_u16(w, 2)
    return c == 0 or (c == 46 and load_u16(w, 4) == 0)

fn os_dots(p: ptr) -> bool:
    if load_u8(p, 0) != 46:
        return false
    let c = load_u8(p, 1)
    return c == 0 or (c == 46 and load_u8(p, 2) == 0)

fn brine_os_list_dir(path: ptr, out: ptr, err: ptr) -> bool:
    let p = os_cstr(path)
    if addr(p) == 0:
        store_ptr(err, 0, os_nul_err())
        return false
    let pa = stack_mem(8)
    store_ptr(pa, 0, new_strs())
    if os_is("windows"):
        var n = load_i64(path, STR_LEN)
        let pat = blk_alloc(n + 3)
        memcpy(pat, p, u64(n))
        if n > 0 and load_u8(p, n - 1) != 92 and load_u8(p, n - 1) != 47:
            store_u8(pat, n, 92)
            n += 1
        store_u8(pat, n, 42)
        store_u8(pat, n + 1, 0)
        let w = os_wpath(pat)
        blk_free(pat)
        let fd = stack_mem(FD_SIZE)
        # FindExInfoBasic, FindExSearchNameMatch
        let h = FindFirstFileExW(w, 1, fd, 0, null_ptr(), 0)
        blk_free(w)
        if h == os_bad_handle():
            let e = GetLastError()
            # only an empty root directory has no entries at all
            if e != 2:
                arr_release(load_ptr(pa, 0))
                store_ptr(err, 0, os_err(int(e)))
                return false
        else:
            while true:
                if not os_dots_w(fd + FD_NAME):
                    push_str(pa, os_from_wide(fd + FD_NAME, -1))
                if FindNextFileW(h, fd) == 0:
                    break
            FindClose(h)
    else:
        let dir = opendir(p)
        if addr(dir) == 0:
            let e = os_errno()
            arr_release(load_ptr(pa, 0))
            store_ptr(err, 0, os_err(e))
            return false
        let off = MAC_DIRENT_NAME if os_is("macos") else DIRENT_NAME
        while true:
            let ent = readdir(dir)
            if addr(ent) == 0:
                break
            if not os_dots(ent + off):
                push_str(pa, os_text(ent + off))
        closedir(dir)
    brine_arr_sort(pa, symbol("brine_x_os_cmp_strp"))
    store_ptr(out, 0, load_ptr(pa, 0))
    return true

# 0: missing, 1: a file, 2: a directory, 3: something else. Follows links.
fn os_kind(p: ptr) -> int:
    if os_is("windows"):
        let w = os_wpath(p)
        let a = GetFileAttributesW(w)
        var k = 0
        if a != NO_ATTRS:
            k = 2 if a & ATTR_DIR != 0 else 1
        if k != 0 and a & ATTR_LINK != 0:
            # a link: look at its target
            let h = CreateFileW(
                w,
                0,
                SHARE_ALL,
                null_ptr(),
                OPEN_EXISTING,
                BACKUP_SEMANTICS,
                null_ptr()
            )
            if h == os_bad_handle():
                k = 0
            else:
                let info = stack_mem(56)
                if GetFileInformationByHandle(h, info) != 0:
                    k = 2 if load_u32(info, 0) & ATTR_DIR != 0 else 1
                else:
                    k = 0
                CloseHandle(h)
        blk_free(w)
        return k
    else:
        let mode = stack_mem(8)
        if not os_stat(p, mode):
            return 0
        let t = load_u32(mode, 0) & 0xf000
        if t == 0x4000:
            return 2
        return 1 if t == 0x8000 else 3

fn brine_os_is_dir(path: ptr) -> bool:
    let p = os_cstr(path)
    return addr(p) != 0 and os_kind(p) == 2

fn brine_os_is_file(path: ptr) -> bool:
    let p = os_cstr(path)
    return addr(p) != 0 and os_kind(p) == 1

fn os_is_sep(c: u8) -> bool:
    if os_is("windows"):
        return c == 47 or c == 92
    else:
        return c == 47

# The length of C string p's root: "/" or, on Windows, "C:", "C:\" or "\".
fn os_root_len(p: ptr) -> int:
    if os_is("windows"):
        let c = load_u8(p, 0) | 32
        if c >= 97 and c <= 122 and load_u8(p, 1) == 58:
            return 3 if os_is_sep(load_u8(p, 2)) else 2
    return 1 if os_is_sep(load_u8(p, 0)) else 0

# Rust's Path::parent of C string p, as a new C string: 0 when there is
# none (a root); "" for a bare name.
fn os_parent(p: ptr) -> ptr:
    let root = os_root_len(p)
    var n = int(strlen(p))
    while n > root and os_is_sep(load_u8(p, n - 1)):
        n -= 1
    if n <= root:
        return null_ptr()
    var i = n
    while i > root and not os_is_sep(load_u8(p, i - 1)):
        i -= 1
    while i > root and os_is_sep(load_u8(p, i - 1)):
        i -= 1
    let q = blk_alloc(i + 1)
    memcpy(q, p, u64(i))
    store_u8(q, i, 0)
    return q

# 0 on success, else the OS error code.
fn os_mkdir1(p: ptr) -> int:
    if os_is("windows"):
        let w = os_wpath(p)
        let e = 0 if CreateDirectoryW(w, null_ptr()) != 0 else int(GetLastError())
        blk_free(w)
        return e
    else:
        return 0 if mkdir(p, 511) == 0 else os_errno()

fn os_not_found(e: int) -> bool:
    if os_is("windows"):
        return e == 2 or e == 3
    else:
        return e == 2

# Rust's fs::create_dir_all; -1 when the tree can't be made at all.
fn os_mkdir_all(p: ptr) -> int:
    if load_u8(p, 0) == 0:
        return 0
    var e = os_mkdir1(p)
    if e == 0:
        return 0
    if not os_not_found(e):
        return 0 if os_kind(p) == 2 else e
    let parent = os_parent(p)
    if addr(parent) == 0:
        return -1
    let pe = os_mkdir_all(parent)
    blk_free(parent)
    if pe != 0:
        return pe
    e = os_mkdir1(p)
    return 0 if e == 0 or os_kind(p) == 2 else e

fn brine_os_make_dir(path: ptr, err: ptr) -> bool:
    let p = os_cstr(path)
    if addr(p) == 0:
        store_ptr(err, 0, os_nul_err())
        return false
    let e = os_mkdir_all(p)
    if e == -1:
        store_ptr(err, 0, os_msg("failed to create whole tree"))
    elif e != 0:
        store_ptr(err, 0, os_err(e))
    return e == 0

fn brine_os_remove_file(path: ptr, err: ptr) -> bool:
    let p = os_cstr(path)
    if addr(p) == 0:
        store_ptr(err, 0, os_nul_err())
        return false
    var e = 0
    if os_is("windows"):
        let w = os_wpath(p)
        e = 0 if DeleteFileW(w) != 0 else int(GetLastError())
        blk_free(w)
    else:
        e = 0 if unlink(p) == 0 else os_errno()
    if e != 0:
        store_ptr(err, 0, os_err(e))
    return e == 0

fn brine_os_rename(src: ptr, dst: ptr, err: ptr) -> bool:
    let a = os_cstr(src)
    let b = os_cstr(dst)
    if addr(a) == 0 or addr(b) == 0:
        store_ptr(err, 0, os_nul_err())
        return false
    var e = 0
    if os_is("windows"):
        let wa = os_wpath(a)
        let wb = os_wpath(b)
        # MOVEFILE_REPLACE_EXISTING
        e = 0 if MoveFileExW(wa, wb, 1) != 0 else int(GetLastError())
        blk_free(wa)
        blk_free(wb)
    else:
        e = 0 if rename(a, b) == 0 else os_errno()
    if e != 0:
        store_ptr(err, 0, os_err(e))
    return e == 0

fn brine_os_cwd() -> ptr:
    if os_is("windows"):
        let n = GetCurrentDirectoryW(0, null_ptr())
        let w = blk_alloc(2 * (int(n) + 1))
        let got = GetCurrentDirectoryW(n + 1, w)
        let s = os_from_wide(w, int(got))
        blk_free(w)
        return s
    else:
        var cap = 256
        while true:
            let buf = blk_alloc(cap)
            if addr(getcwd(buf, u64(cap))) != 0:
                let s = os_text(buf)
                blk_free(buf)
                return s
            blk_free(buf)
            # ERANGE
            if os_errno() != 34:
                return os_lit(".")
            cap *= 2
    return new_str(0)

fn brine_os_set_cwd(path: ptr, err: ptr) -> bool:
    let p = os_cstr(path)
    if addr(p) == 0:
        store_ptr(err, 0, os_nul_err())
        return false
    var e = 0
    if os_is("windows"):
        let w = os_wide(p)
        e = 0 if SetCurrentDirectoryW(w) != 0 else int(GetLastError())
        blk_free(w)
    else:
        e = 0 if chdir(p) == 0 else os_errno()
    if e != 0:
        store_ptr(err, 0, os_err(e))
    return e == 0

# The absolute path of the running executable.
fn brine_os_exe_path() -> ptr:
    if os_is("windows"):
        var cap = 260
        while cap < (1 << 20):
            let w = blk_alloc(2 * cap)
            let n = int(GetModuleFileNameW(null_ptr(), w, u32(cap)))
            if n > 0 and n < cap:
                let s = os_from_wide(w, n)
                blk_free(w)
                return s
            blk_free(w)
            if n == 0:
                break
            cap *= 2
    elif os_is("macos"):
        let size = stack_mem(8)
        store_u32(size, 0, 0)
        _NSGetExecutablePath(null_ptr(), size)
        let buf = blk_alloc(int(load_u32(size, 0)) + 1)
        if _NSGetExecutablePath(buf, size) == 0:
            let r = realpath(buf, null_ptr())
            let s = os_text(buf if addr(r) == 0 else r)
            free(r)
            blk_free(buf)
            return s
        blk_free(buf)
    elif os_is("linux"):
        var cap = 256
        while cap < (1 << 20):
            let buf = blk_alloc(cap)
            let n = readlink(ptr_of("/proc/self/exe") + STR_DATA, buf, u64(cap))
            if n > 0 and n < cap:
                let s = brine_str_new(buf, n)
                blk_free(buf)
                return s
            blk_free(buf)
            if n <= 0:
                break
            cap *= 2
    let a0 = brine_arg(0)
    if addr(a0) == 0:
        return new_str(0)
    return os_text(a0)

fn brine_os_temp_dir() -> ptr:
    var s = null_ptr()
    if os_is("windows"):
        let k32 = os_wide(ptr_of("kernel32.dll") + STR_DATA)
        let f = GetProcAddress(GetModuleHandleW(k32), ptr_of("GetTempPath2W") + STR_DATA)
        blk_free(k32)
        # MAX_PATH + 2 units
        let w = stack_mem(528)
        var n = 0
        if addr(f) != 0:
            n = int(call_u32(f, u32(261), w))
        else:
            n = int(GetTempPathW(261, w))
        if n > 261:
            n = 0
        s = os_from_wide(w, n)
    else:
        let t = getenv(ptr_of("TMPDIR") + STR_DATA)
        s = os_text(ptr_of("/tmp") + STR_DATA if addr(t) == 0 else t)
    # no trailing separator, unless the whole path is a root
    let c = os_cstr(s)
    let root = 0 if addr(c) == 0 else os_root_len(c)
    let len = load_i64(s, STR_LEN)
    var n2 = len
    while n2 > root and os_is_sep(load_u8(s, STR_DATA + n2 - 1)):
        n2 -= 1
    if n2 != len:
        let t2 = brine_str_new(s + STR_DATA, n2)
        str_release(s)
        s = t2
    return s

fn brine_os_abs_path(path: ptr, out: ptr, err: ptr) -> bool:
    let p = os_cstr(path)
    if addr(p) == 0:
        store_ptr(err, 0, os_nul_err())
        return false
    if os_is("windows"):
        # what Rust's fs::canonicalize does: the final path of an open
        # handle, `\\?\C:\...`
        let w = os_wpath(p)
        let h = CreateFileW(
            w,
            0,
            SHARE_ALL,
            null_ptr(),
            OPEN_EXISTING,
            BACKUP_SEMANTICS,
            null_ptr()
        )
        blk_free(w)
        if h == os_bad_handle():
            store_ptr(err, 0, os_err(int(GetLastError())))
            return false
        # VOLUME_NAME_DOS
        let need = GetFinalPathNameByHandleW(h, null_ptr(), 0, 0)
        let buf = blk_alloc(2 * (int(need) + 1))
        var got: u32 = 0
        if need != 0:
            got = GetFinalPathNameByHandleW(h, buf, need + 1, 0)
        let e = int(GetLastError()) if got == 0 or got > need else 0
        CloseHandle(h)
        if e != 0 or got == 0:
            blk_free(buf)
            # ERROR_INVALID_DATA
            store_ptr(err, 0, os_err(e if e != 0 else 13))
            return false
        store_ptr(out, 0, os_from_wide(buf, int(got)))
        blk_free(buf)
        return true
    else:
        let r = realpath(p, null_ptr())
        let e = os_errno()
        if addr(r) == 0:
            store_ptr(err, 0, os_err(e))
            return false
        store_ptr(out, 0, os_text(r))
        free(r)
        return true

# A new string of literal s.
fn os_lit(s: str) -> ptr:
    let p = ptr_of(s)
    return brine_str_new(p + STR_DATA, load_i64(p, STR_LEN))

# the names Rust uses in std::env::consts
fn brine_os_name() -> ptr:
    if os_is("windows"):
        return os_lit("windows")
    elif os_is("macos"):
        return os_lit("macos")
    elif os_is("linux"):
        return os_lit("linux")
    return os_lit("unknown")

fn brine_os_arch() -> ptr:
    if os_is("x86_64"):
        return os_lit("x86_64")
    elif os_is("aarch64"):
        return os_lit("aarch64")
    return os_lit("unknown")

fn brine_os_cpu_count() -> int:
    var n = 0
    if os_is("windows"):
        let si = stack_mem(48)
        GetSystemInfo(si)
        n = int(load_i32(si, SYSI_NCPU))
    else:
        # _SC_NPROCESSORS_ONLN
        let m = sysconf(i32(58) if os_is("macos") else i32(84))
        n = int(i32(m)) if m > 0 else 1
    return n if n > 0 else 1

# An MSYS/Cygwin terminal is a named pipe called like
# `msys-...-pty0-to-master` (the same test as Rust's).
fn os_msys_tty(h: ptr) -> bool:
    # FILE_TYPE_PIPE
    if GetFileType(h) != 3:
        return false
    # FILE_NAME_INFO: the name's length in bytes, then MAX_PATH units
    let info = stack_mem(528)
    memset(info, 0, 524)
    # FileNameInfo
    if GetFileInformationByHandleEx(h, 2, info, 524) == 0:
        return false
    var n = int(load_u32(info, 0)) / 2
    if n > 260:
        n = 260
    let s = os_from_wide(info + 4, n)
    let len = load_i64(s, STR_LEN)
    var start = 0
    for i in 0..len:
        if load_u8(s, STR_DATA + i) == 92:
            start = i + 1
    let b = brine_str_new(s + STR_DATA + start, len - start)
    str_release(s)
    let none = null_ptr()
    let pre = (
        brine_s_starts_with(b, ptr_of("msys-"), none)
        or brine_s_starts_with(b, ptr_of("cygwin-"), none)
    )
    let r = pre and find_from(b, ptr_of("-pty"), 0) >= 0
    str_release(b)
    return r

fn brine_os_is_terminal(fd: int) -> bool:
    if fd < 0 or fd > 2:
        return false
    if os_is("windows"):
        let which = STD_INPUT if fd == 0 else (STD_OUTPUT if fd == 1 else STD_ERROR)
        let h = GetStdHandle(which)
        if addr(h) == 0 or h == os_bad_handle():
            return false
        let mode = stack_mem(8)
        if GetConsoleMode(h, mode) != 0:
            return true
        return os_msys_tty(h)
    else:
        return isatty(i32(fd)) == 1

fn brine_os_enable_ansi():
    if os_is("windows"):
        for i in 0..2:
            let h = GetStdHandle(STD_OUTPUT if i == 0 else STD_ERROR)
            let m = stack_mem(8)
            store_u32(m, 0, 0)
            if GetConsoleMode(h, m) != 0:
                # ENABLE_VIRTUAL_TERMINAL_PROCESSING
                SetConsoleMode(h, load_u32(m, 0) | 4)

# ---- free ports and processes
extern fn getsockname(fd: i32, sa: ptr, n: ptr) -> i32

extern fn lseek(fd: i32, off: int, whence: i32) -> int

extern fn kill(pid: i32, sig: i32) -> i32

extern fn mkostemp(tmpl: ptr, flags: i32) -> i32

extern fn posix_spawn_file_actions_init(fa: ptr) -> i32

extern fn posix_spawn_file_actions_destroy(fa: ptr) -> i32

extern fn posix_spawn_file_actions_addopen(
    fa: ptr,
    fd: i32,
    path: ptr,
    flags: i32,
    mode: u32
) -> i32

extern fn posix_spawn_file_actions_adddup2(fa: ptr, fd: i32, to: i32) -> i32

extern fn posix_spawnattr_init(a: ptr) -> i32

extern fn posix_spawnattr_destroy(a: ptr) -> i32

extern fn posix_spawnattr_setsigdefault(a: ptr, set: ptr) -> i32

extern fn posix_spawnattr_setflags(a: ptr, flags: i16) -> i32

extern fn sigemptyset(set: ptr) -> i32

extern fn sigaddset(set: ptr, sig: i32) -> i32

extern fn InitializeCriticalSection(m: ptr)

extern fn EnterCriticalSection(m: ptr)

extern fn LeaveCriticalSection(m: ptr)

extern fn GetTickCount() -> u32

extern fn SetFilePointer(h: ptr, lo: i32, hi: ptr, how: u32) -> u32

extern fn GetCurrentProcess() -> ptr

extern fn DuplicateHandle(
    sp: ptr,
    h: ptr,
    tp: ptr,
    out: ptr,
    access: u32,
    inherit: i32,
    opts: u32
) -> i32

extern fn GetSystemDirectoryW(buf: ptr, n: u32) -> u32

extern fn GetWindowsDirectoryW(buf: ptr, n: u32) -> u32

extern fn CompareStringOrdinal(a: ptr, na: i32, b: ptr, nb: i32, ignore_case: i32) -> i32

extern fn GetEnvironmentStringsW() -> ptr

extern fn FreeEnvironmentStringsW(p: ptr) -> i32

extern fn TerminateProcess(h: ptr, code: u32) -> i32

fn brine_os_free_ports(n0: int, out: ptr, err: ptr) -> bool:
    let n = n0 if n0 > 0 else 0
    # Winsock: loaded on first use (importing it would load it, and the DLLs
    # it needs, into every program). Both calls count, so repeating them is
    # cheap and safe from any thread.
    var f_socket = null_ptr()
    var f_bind = null_ptr()
    var f_listen = null_ptr()
    var f_name = null_ptr()
    var f_close = null_ptr()
    var f_err = null_ptr()
    if os_is("windows"):
        let ws = LoadLibraryA(ptr_of("ws2_32.dll") + STR_DATA)
        if addr(ws) == 0:
            let m = ptr_of("brine: could not load ws2_32.dll\n")
            fwrite(m + STR_DATA, 1, u64(load_i64(m, STR_LEN)), os_stdio(2))
            exit(2)
        let wsa = stack_mem(512)
        call_i32(GetProcAddress(ws, ptr_of("WSAStartup") + STR_DATA), u16(0x0202), wsa)
        f_socket = GetProcAddress(ws, ptr_of("socket") + STR_DATA)
        f_bind = GetProcAddress(ws, ptr_of("bind") + STR_DATA)
        f_listen = GetProcAddress(ws, ptr_of("listen") + STR_DATA)
        f_name = GetProcAddress(ws, ptr_of("getsockname") + STR_DATA)
        f_close = GetProcAddress(ws, ptr_of("closesocket") + STR_DATA)
        f_err = GetProcAddress(ws, ptr_of("WSAGetLastError") + STR_DATA)
    let pa = stack_mem(8)
    store_ptr(
        pa,
        0,
        brine_arr_new(0, 8, null_ptr(), null_ptr(), ptr_of("<os.free_ports>") + STR_DATA)
    )
    let socks = blk_alloc(8 * (n if n != 0 else 1))
    var open = 0
    var e = 0
    # every listener stays open until all ports are known, so they differ
    let sa = stack_mem(16)
    let len = stack_mem(8)
    let port = stack_mem(8)
    for i in 0..n:
        var s: u64 = 0
        if os_is("windows"):
            # AF_INET, SOCK_STREAM
            s = call_u64(f_socket, i32(2), i32(1), i32(0))
            if s == ONES:
                e = int(call_i32(f_err))
                break
        else:
            let fd = socket(2, 1, 0)
            if fd < 0:
                e = os_errno()
                break
            s = u64(fd)
        store_u64(socks, open * 8, s)
        open += 1
        memset(sa, 0, 16)
        if os_is("macos"):
            store_u8(sa, 1, 2)
        else:
            store_u16(sa, 0, 2)
        # 127.0.0.1, port 0: any free one
        store_u32(sa, 4, 0x0100007f)
        store_u32(len, 0, 16)
        var bad = false
        if os_is("windows"):
            bad = (
                call_i32(f_bind, s, sa, i32(16)) != 0
                or call_i32(f_listen, s, i32(128)) != 0
                or call_i32(f_name, s, sa, len) != 0
            )
            if bad:
                e = int(call_i32(f_err))
        else:
            let fd = i32(s)
            bad = bind(fd, sa, 16) != 0 or listen(fd, 128) != 0 or getsockname(fd, sa, len) != 0
            if bad:
                e = os_errno()
        if bad:
            break
        let p = load_u16(sa, 2)
        store_i64(port, 0, int((p >> 8) | ((p & 0xff) << 8)))
        brine_arr_push(pa, port)
    for i in 0..open:
        if os_is("windows"):
            call_i32(f_close, load_u64(socks, i * 8))
        else:
            close(i32(load_u64(socks, i * 8)))
    blk_free(socks)
    if e != 0:
        arr_release(load_ptr(pa, 0))
        store_ptr(err, 0, os_err(e))
        return false
    store_ptr(out, 0, load_ptr(pa, 0))
    return true

# A process record: the process (Windows: its handle; else the pid, i32),
# the capture files (Windows handles, else fds as i32; deleted when closed),
# whether it captures, whether it has exited, its exit code, and what it
# wrote (once it has exited).
const PR_PROC = 0
const PR_OUT = 8
const PR_ERR = 16
const PR_CAPTURE = 24
const PR_DONE = 25
const PR_CODE = 32
const PR_OUTS = 40
const PR_ERRS = 48
const PROC_SIZE = 56

# global_mem("os_procs"): every process os.spawn started (records, count,
# capacity; a handle is an index + 1) and whether the lock was made (by the
# first os.spawn: spawning can't happen in `par`). global_mem("os_proc_mu"):
# the lock, an OS mutex (CRITICAL_SECTION or pthread_mutex_t).
const PT_P = 0
const PT_N = 8
const PT_CAP = 16
const PT_READY = 24

fn os_lock(m: ptr):
    if os_is("windows"):
        EnterCriticalSection(m)
    else:
        pthread_mutex_lock(m)

fn os_unlock(m: ptr):
    if os_is("windows"):
        LeaveCriticalSection(m)
    else:
        pthread_mutex_unlock(m)

fn os_proc_get(h: int, what: str, loc: ptr) -> ptr:
    let t = global_mem("os_procs", 32)
    if h < 1 or h > load_i64(t, PT_N):
        if load_i64(t, PT_READY) != 0:
            os_unlock(global_mem("os_proc_mu", 64))
        panic_text_cold(loc, f"{what}: {h} is not a process handle from os.spawn")
    return load_ptr(t, PT_P) + (h - 1) * PROC_SIZE

# A new empty temporary file, deleted when its last handle closes. Windows.
fn os_capture_file() -> ptr:
    let dir = brine_os_temp_dir()
    let count = global_mem("os_capture_count", 8)
    var h = os_bad_handle()
    var e: u32 = 0
    for attempt in 0..100:
        let c = load_i64(count, 0) + 1
        store_i64(count, 0, c)
        let name = f"\\brine-out-{GetCurrentProcessId()}-{c}-{GetTickCount()}.tmp"
        let p = brine_str_concat(dir, ptr_of(name))
        let w = os_wide(p + STR_DATA)
        str_release(p)
        # GENERIC_READ | GENERIC_WRITE, CREATE_NEW,
        # FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE
        h = CreateFileW(w, 0xc0000000, SHARE_ALL, null_ptr(), 1, 0x04000100, null_ptr())
        e = GetLastError()
        blk_free(w)
        # ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS
        if h != os_bad_handle() or (e != 80 and e != 183):
            break
    str_release(dir)
    SetLastError(e)
    return h

# A new temporary file, already unlinked. Not Windows.
fn os_capture_fd() -> int:
    let dir = brine_os_temp_dir()
    let p = brine_str_concat(dir, ptr_of("/brine-out-XXXXXX"))
    str_release(dir)
    let c = os_cstr(p)
    var fd = -1
    if addr(c) != 0:
        # O_CLOEXEC: the fd isn't left open in other children
        fd = int(mkostemp(c, i32(0x1000000) if os_is("macos") else i32(0x80000)))
    if fd >= 0:
        unlink(c)
    str_release(p)
    return fd

# What a capture file holds, as a string (invalid UTF-8 replaced); closes it.
fn os_read_capture(f: ptr) -> ptr:
    if os_is("windows"):
        if addr(f) == 0 or f == os_bad_handle():
            return new_str(0)
        SetFilePointer(f, 0, null_ptr(), 0)
    else:
        if i32(addr(f)) < 0:
            return new_str(0)
        lseek(i32(addr(f)), 0, 0)
    var buf = null_ptr()
    var len = 0
    var cap = 0
    let got = stack_mem(8)
    while true:
        if len == cap:
            cap = cap * 2 if cap != 0 else 65536
            buf = brine_x_realloc(buf, cap)
        if os_is("windows"):
            store_u32(got, 0, 0)
            if (
                ReadFile(f, buf + len, u32(cap - len), got, null_ptr()) == 0
                or load_u32(got, 0) == 0
            ):
                break
            len += int(load_u32(got, 0))
        else:
            let r = read(i32(addr(f)), buf + len, u64(cap - len))
            if r < 0 and os_errno() == EINTR:
                continue
            if r <= 0:
                break
            len += r
    if os_is("windows"):
        CloseHandle(f)
    else:
        close(i32(addr(f)))
    let s = os_lossy(buf, len)
    brine_free(buf)
    return s

# An inheritable copy of h for the child (null when there is none).
fn os_inheritable(h: ptr) -> ptr:
    if addr(h) == 0 or h == os_bad_handle():
        return null_ptr()
    let d = stack_mem(8)
    store_ptr(d, 0, null_ptr())
    # DUPLICATE_SAME_ACCESS
    if DuplicateHandle(GetCurrentProcess(), h, GetCurrentProcess(), d, 0, 1, 2) == 0:
        return null_ptr()
    return load_ptr(d, 0)

# Rust's command-line quoting: the program is always quoted as is; other
# arguments when they hold a space or tab or are empty, with backslashes
# before quotes doubled.
fn os_append_arg(sb: ptr, a: ptr, program: bool):
    let quote = program or load_u8(a, 0) == 0 or os_has_any(a, " \t")
    if quote:
        sb_byte(sb, 34)
    var slashes = 0
    var i = 0
    while load_u8(a, i) != 0:
        let c = load_u8(a, i)
        if not program:
            if c == 92:
                slashes += 1
            else:
                if c == 34:
                    os_backslashes(sb, slashes + 1)
                slashes = 0
        sb_byte(sb, c)
        i += 1
    if quote:
        if not program:
            os_backslashes(sb, slashes)
        sb_byte(sb, 34)

fn os_wfile_exists(w: ptr) -> bool:
    let a = GetFileAttributesW(w)
    return a != NO_ATTRS and a & ATTR_DIR == 0

# dir (dl units) + "\" + name if that file exists, else null.
fn os_try_dir(dir: ptr, dl: int, name: ptr) -> ptr:
    let wl = int(wcslen(name))
    if dl == 0:
        return null_ptr()
    let c = blk_alloc(2 * (dl + wl + 2))
    memcpy(c, dir, u64(dl * 2))
    var at = dl
    let last = load_u16(c, (at - 1) * 2)
    if last != 92 and last != 47:
        store_u16(c, at * 2, 92)
        at += 1
    memcpy(c + at * 2, name, u64((wl + 1) * 2))
    if os_wfile_exists(c):
        return c
    blk_free(c)
    return null_ptr()

# MAX_PATH + 1 units
const DIR_UNITS = 261

# Finds a program the way Rust's Command does on Windows: a name without a
# path is looked up in the exe's directory, the system directories, then
# PATH; ".exe" is added when the name has no extension. Null if not found.
fn os_find_program(prog: ptr, path_var: ptr) -> ptr:
    let n = int(strlen(prog))
    var base = 0
    for q in 0..n:
        let c = load_u8(prog, q)
        if c == 47 or c == 92:
            base = q + 1
    let name = blk_alloc(n + 5)
    memcpy(name, prog, u64(n + 1))
    if addr(memchr(prog + base, 46, u64(n - base))) == 0:
        memcpy(name + n, ptr_of(".exe") + STR_DATA, 5)
    # a path: CreateProcess reports it if it's missing
    if base != 0:
        let wp = os_wpath(name)
        blk_free(name)
        return wp
    let wname = os_wide(name)
    blk_free(name)
    # three of DIR_UNITS
    let dirs = stack_mem(1566)
    var nd = 0
    var k = int(GetModuleFileNameW(null_ptr(), dirs, 260))
    if k > 0 and k < 260:
        var slash = -1
        for i in 0..k:
            if load_u16(dirs, i * 2) == 92:
                slash = i
        if slash >= 0:
            store_u16(dirs, slash * 2, 0)
            nd += 1
    k = int(GetSystemDirectoryW(dirs + nd * 2 * DIR_UNITS, 260))
    if k > 0 and k < 260:
        nd += 1
    k = int(GetWindowsDirectoryW(dirs + nd * 2 * DIR_UNITS, 260))
    if k > 0 and k < 260:
        nd += 1
    var found = null_ptr()
    for i in 0..nd:
        if addr(found) != 0:
            break
        let d = dirs + i * 2 * DIR_UNITS
        found = os_try_dir(d, int(wcslen(d)), wname)
    var p = path_var
    while addr(p) != 0 and load_u16(p, 0) != 0 and addr(found) == 0:
        var dl = 0
        while load_u16(p, dl * 2) != 0 and load_u16(p, dl * 2) != 59:
            dl += 1
        var d = p
        p = p + (dl + 1) * 2 if load_u16(p, dl * 2) == 59 else p + dl * 2
        # entries may be quoted
        if dl >= 2 and load_u16(d, 0) == 34 and load_u16(d, (dl - 1) * 2) == 34:
            d = d + 2
            dl -= 2
        found = os_try_dir(d, dl, wname)
    blk_free(wname)
    return found

# Does environment entry e ("NAME=value") have this name? (Case-insensitive,
# like Windows; hidden names start with '='.)
fn os_env_is(e: ptr, name: ptr) -> bool:
    var el = 1
    while load_u16(e, el * 2) != 0 and load_u16(e, el * 2) != 61:
        el += 1
    let nl = int(wcslen(name))
    return el == nl and CompareStringOrdinal(e, i32(el), name, i32(nl), 1) == 2

# The parent's environment block with the overrides applied (null: inherit
# it as is).
fn os_env_block(ek: ptr, ev: ptr, ne: int) -> ptr:
    if ne == 0:
        return null_ptr()
    let wk = blk_alloc(8 * ne)
    let wv = blk_alloc(8 * ne)
    for i in 0..ne:
        store_ptr(wk, i * 8, os_wide(load_ptr(ek, i * 8)))
        store_ptr(wv, i * 8, os_wide(load_ptr(ev, i * 8)))
    let cur = GetEnvironmentStringsW()
    var cap = 2
    var len = 0
    var e = cur
    while addr(e) != 0 and load_u16(e, 0) != 0:
        let l = int(wcslen(e)) + 1
        cap += l
        e = e + l * 2
    for i in 0..ne:
        cap += int(wcslen(load_ptr(wk, i * 8))) + int(wcslen(load_ptr(wv, i * 8))) + 2
    let block = blk_alloc(2 * cap)
    e = cur
    while addr(e) != 0 and load_u16(e, 0) != 0:
        let l = int(wcslen(e)) + 1
        var skip = false
        for i in 0..ne:
            if os_env_is(e, load_ptr(wk, i * 8)):
                skip = true
                break
        if not skip:
            memcpy(block + len * 2, e, u64(l * 2))
            len += l
        e = e + l * 2
    if addr(cur) != 0:
        FreeEnvironmentStringsW(cur)
    for i in 0..ne:
        let k = load_ptr(wk, i * 8)
        let v = load_ptr(wv, i * 8)
        let kl = int(wcslen(k))
        let vl = int(wcslen(v))
        memcpy(block + len * 2, k, u64(kl * 2))
        len += kl
        store_u16(block, len * 2, 61)
        len += 1
        memcpy(block + len * 2, v, u64(vl * 2))
        len += vl
        store_u16(block, len * 2, 0)
        len += 1
        blk_free(k)
        blk_free(v)
    store_u16(block, len * 2, 0)
    len += 1
    # an empty block still needs two NULs
    if len == 1:
        store_u16(block, len * 2, 0)
    blk_free(wk)
    blk_free(wv)
    return block

# Is C string a "PATH", ignoring ASCII case?
fn os_is_path(a: ptr) -> bool:
    let want = ptr_of("PATH") + STR_DATA
    for i in 0..5:
        var c = load_u8(a, i)
        if c >= 97 and c <= 122:
            c -= 32
        if c != load_u8(want, i):
            return false
    return true

# Starts the process; false with *err set if it couldn't be started.
fn os_start(
    rec: ptr,
    cv: ptr,
    n: int,
    ek: ptr,
    ev: ptr,
    ne: int,
    capture: bool,
    stdin_ok: bool,
    err: ptr
) -> bool:
    if os_is("windows"):
        # the program is looked up on the child's PATH
        var path_var = null_ptr()
        for i in 0..ne:
            if os_is_path(load_ptr(ek, i * 8)):
                if addr(path_var) != 0:
                    blk_free(path_var)
                path_var = os_wide(load_ptr(ev, i * 8))
        if addr(path_var) == 0:
            let pw = os_wide(ptr_of("PATH") + STR_DATA)
            let need = GetEnvironmentVariableW(pw, null_ptr(), 0)
            if need != 0:
                path_var = blk_alloc(2 * int(need))
                if GetEnvironmentVariableW(pw, path_var, need) == 0:
                    store_u16(path_var, 0, 0)
            blk_free(pw)
        let app = os_find_program(load_ptr(cv, 0), path_var)
        if addr(path_var) != 0:
            blk_free(path_var)
        if addr(app) == 0:
            store_ptr(err, 0, os_msg("program not found"))
            return false
        let sb = stack_mem(24)
        brine_sb_init(sb)
        os_append_arg(sb, load_ptr(cv, 0), true)
        for i in 1..n:
            sb_byte(sb, 32)
            os_append_arg(sb, load_ptr(cv, i * 8), false)
        let line = brine_sb_finish(sb)
        let wl = os_wide(line + STR_DATA)
        str_release(line)
        let block = os_env_block(ek, ev, ne)
        var in_h = null_ptr()
        var out_h = null_ptr()
        var err_h = null_ptr()
        if stdin_ok:
            in_h = os_inheritable(GetStdHandle(STD_INPUT))
        else:
            # SECURITY_ATTRIBUTES: nLength, the descriptor, bInheritHandle
            let sa = stack_mem(24)
            memset(sa, 0, 24)
            store_u32(sa, 0, 24)
            store_u32(sa, 16, 1)
            let nul = os_wide(ptr_of("NUL") + STR_DATA)
            # GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE
            in_h = CreateFileW(nul, 0x80000000, 3, sa, OPEN_EXISTING, 0, null_ptr())
            blk_free(nul)
            if in_h == os_bad_handle():
                in_h = null_ptr()
        var ok = true
        store_ptr(rec, PR_OUT, os_bad_handle())
        store_ptr(rec, PR_ERR, os_bad_handle())
        if capture:
            let of = os_capture_file()
            store_ptr(rec, PR_OUT, of)
            if of != os_bad_handle():
                store_ptr(rec, PR_ERR, os_capture_file())
            if load_ptr(rec, PR_ERR) == os_bad_handle():
                store_ptr(err, 0, os_err(int(GetLastError())))
                ok = false
            out_h = os_inheritable(of)
            err_h = os_inheritable(load_ptr(rec, PR_ERR))
        else:
            out_h = os_inheritable(GetStdHandle(STD_OUTPUT))
            err_h = os_inheritable(GetStdHandle(STD_ERROR))
        if ok:
            let si = stack_mem(SI_SIZE)
            memset(si, 0, u64(SI_SIZE))
            store_u32(si, 0, u32(SI_SIZE))
            # STARTF_USESTDHANDLES
            store_u32(si, SI_FLAGS, 0x100)
            store_ptr(si, SI_IN, in_h)
            store_ptr(si, SI_OUT, out_h)
            store_ptr(si, SI_ERR, err_h)
            let pi = stack_mem(24)
            # CREATE_UNICODE_ENVIRONMENT
            if (
                CreateProcessW(app, wl, null_ptr(), null_ptr(), 1, 0x400, block, null_ptr(), si, pi)
                == 0
            ):
                store_ptr(err, 0, os_err(int(GetLastError())))
                ok = false
            else:
                CloseHandle(load_ptr(pi, PI_THREAD))
                store_ptr(rec, PR_PROC, load_ptr(pi, PI_PROC))
        if addr(in_h) != 0:
            CloseHandle(in_h)
        if addr(out_h) != 0:
            CloseHandle(out_h)
        if addr(err_h) != 0:
            CloseHandle(err_h)
        if not ok:
            if load_ptr(rec, PR_OUT) != os_bad_handle():
                CloseHandle(load_ptr(rec, PR_OUT))
            if load_ptr(rec, PR_ERR) != os_bad_handle():
                CloseHandle(load_ptr(rec, PR_ERR))
        if addr(block) != 0:
            blk_free(block)
        blk_free(wl)
        blk_free(app)
        return ok
    else:
        # the environment: the parent's, minus overridden names, plus the
        # overrides
        let env = os_environ()
        var np = 0
        while addr(load_ptr(env, np * 8)) != 0:
            np += 1
        let envp = blk_alloc(8 * (np + ne + 1))
        let owned = blk_alloc(8 * (ne + 1))
        var k = 0
        for j in 0..np:
            let e = load_ptr(env, j * 8)
            var skip = false
            for i in 0..ne:
                let key = load_ptr(ek, i * 8)
                let kl = strlen(key)
                if strncmp(e, key, kl) == 0 and load_u8(e, int(kl)) == 61:
                    skip = true
                    break
            if not skip:
                store_ptr(envp, k * 8, e)
                k += 1
        for i in 0..ne:
            let key = load_ptr(ek, i * 8)
            let v = load_ptr(ev, i * 8)
            let kl = int(strlen(key))
            let vl = int(strlen(v))
            let o = blk_alloc(kl + vl + 2)
            memcpy(o, key, u64(kl))
            store_u8(o, kl, 61)
            memcpy(o + kl + 1, v, u64(vl + 1))
            store_ptr(owned, i * 8, o)
            store_ptr(envp, k * 8, o)
            k += 1
        store_ptr(envp, k * 8, null_ptr())
        # posix_spawn_file_actions_t, posix_spawnattr_t and sigset_t, with
        # room to spare (glibc: 80, 336 and 128 bytes; macOS: 8, 8 and 4)
        let fa = stack_mem(128)
        posix_spawn_file_actions_init(fa)
        let attr = stack_mem(512)
        posix_spawnattr_init(attr)
        # like Rust: the child starts with SIGPIPE at its default action
        let def = stack_mem(128)
        sigemptyset(def)
        sigaddset(def, 13)
        posix_spawnattr_setsigdefault(attr, def)
        # POSIX_SPAWN_SETSIGDEF
        posix_spawnattr_setflags(attr, i16(4))
        store_i64(rec, PR_OUT, -1)
        store_i64(rec, PR_ERR, -1)
        if not stdin_ok:
            posix_spawn_file_actions_addopen(fa, 0, ptr_of("/dev/null") + STR_DATA, 0, 0)
        var r = 0
        if capture:
            os_set_errno(0)
            let o = os_capture_fd()
            store_i64(rec, PR_OUT, o)
            var e = -1
            if o >= 0:
                e = os_capture_fd()
                store_i64(rec, PR_ERR, e)
            if o < 0 or e < 0:
                r = os_errno()
                if r == 0:
                    r = EIO
            else:
                posix_spawn_file_actions_adddup2(fa, i32(o), 1)
                posix_spawn_file_actions_adddup2(fa, i32(e), 2)
        if r == 0:
            r = int(posix_spawnp(rec + PR_PROC, load_ptr(cv, 0), fa, attr, cv, envp))
        posix_spawn_file_actions_destroy(fa)
        posix_spawnattr_destroy(attr)
        if r != 0:
            store_ptr(err, 0, os_err(r))
            if load_i64(rec, PR_OUT) >= 0:
                close(i32(load_i64(rec, PR_OUT)))
            if load_i64(rec, PR_ERR) >= 0:
                close(i32(load_i64(rec, PR_ERR)))
        for i in 0..ne:
            blk_free(load_ptr(owned, i * 8))
        blk_free(owned)
        blk_free(envp)
        return r == 0

fn brine_os_spawn(cmd: ptr, env: ptr, capture: bool, stdin_ok: bool, handle: ptr, err: ptr) -> bool:
    store_i64(handle, 0, 0)
    if not capture:
        brine_flush()
    let t = global_mem("os_procs", 32)
    let mu = global_mem("os_proc_mu", 64)
    if load_i64(t, PT_READY) == 0:
        if os_is("windows"):
            InitializeCriticalSection(mu)
        else:
            pthread_mutex_init(mu, null_ptr())
        store_i64(t, PT_READY, 1)
    let n = load_i64(cmd, ARR_LEN)
    if n == 0:
        store_ptr(err, 0, os_msg("os.spawn needs a program name, but the command list is empty"))
        return false
    let d = load_ptr(cmd, ARR_DATA)
    let cv = blk_alloc(8 * (n + 1))
    var ok = true
    var bad_name = false
    for i in 0..n:
        let c = os_cstr(load_ptr(d, i * 8))
        store_ptr(cv, i * 8, c)
        if addr(c) == 0:
            ok = false
    store_ptr(cv, n * 8, null_ptr())
    # the environment overrides
    let used = load_i64(env, MAP_USED)
    let ek = blk_alloc(8 * (used + 1))
    let ev = blk_alloc(8 * (used + 1))
    var ne = 0
    let live = load_ptr(env, MAP_LIVE)
    for i in 0..used:
        if load_u8(live, i) == 0:
            continue
        let k = os_cstr(load_ptr(load_ptr(env, MAP_KEYS), i * 8))
        let v = os_cstr(load_ptr(load_ptr(env, MAP_VALS), i * 8))
        store_ptr(ek, ne * 8, k)
        store_ptr(ev, ne * 8, v)
        if addr(k) == 0 or addr(v) == 0:
            ok = false
        elif load_u8(k, 0) == 0 or addr(memchr(k + 1, 61, strlen(k + 1))) != 0:
            bad_name = true
        ne += 1
    let rec = stack_mem(PROC_SIZE)
    memset(rec, 0, u64(PROC_SIZE))
    store_u8(rec, PR_CAPTURE, 1 if capture else 0)
    if not ok:
        store_ptr(err, 0, os_msg("nul byte found in provided data"))
    elif bad_name:
        store_ptr(err, 0, os_msg("os.spawn: invalid environment variable name"))
        ok = false
    else:
        fflush(os_stdio(1))
        fflush(os_stdio(2))
        ok = os_start(rec, cv, n, ek, ev, ne, capture, stdin_ok, err)
    blk_free(cv)
    blk_free(ek)
    blk_free(ev)
    if not ok:
        return false
    os_lock(mu)
    var np = load_i64(t, PT_N)
    if np == load_i64(t, PT_CAP):
        let cap = load_i64(t, PT_CAP) * 2 if load_i64(t, PT_CAP) != 0 else 8
        store_i64(t, PT_CAP, cap)
        store_ptr(t, PT_P, brine_x_realloc(load_ptr(t, PT_P), PROC_SIZE * cap))
    memcpy(load_ptr(t, PT_P) + np * PROC_SIZE, rec, u64(PROC_SIZE))
    np += 1
    store_i64(t, PT_N, np)
    store_i64(handle, 0, np)
    os_unlock(mu)
    return true

# Has it exited? (block: wait until it has.) Collects its output when it has.
fn os_proc_reap(p: ptr, block: bool) -> bool:
    if load_u8(p, PR_DONE) != 0:
        return true
    var code = 0
    let capture = load_u8(p, PR_CAPTURE) != 0
    if os_is("windows"):
        let h = load_ptr(p, PR_PROC)
        # WAIT_OBJECT_0
        if WaitForSingleObject(h, INFINITE if block else 0) != 0:
            return false
        let c = stack_mem(8)
        store_u32(c, 0, 0)
        GetExitCodeProcess(h, c)
        CloseHandle(h)
        store_ptr(p, PR_PROC, null_ptr())
        code = int(load_i32(c, 0))
    else:
        let st = stack_mem(8)
        store_i64(st, 0, 0)
        var r: i32 = 0
        while true:
            # WNOHANG
            r = waitpid(load_i32(p, PR_PROC), st, 0 if block else 1)
            if r >= 0 or os_errno() != EINTR:
                break
        if r == 0:
            return false
        let s = int(load_i32(st, 0))
        # WIFEXITED: the exit code, else 101
        code = 101 if r < 0 or s & 0x7f != 0 else (s >> 8) & 0xff
    store_ptr(p, PR_OUTS, os_read_capture(load_ptr(p, PR_OUT)) if capture else new_str(0))
    store_ptr(p, PR_ERRS, os_read_capture(load_ptr(p, PR_ERR)) if capture else new_str(0))
    store_u8(p, PR_DONE, 1)
    store_i64(p, PR_CODE, code)
    return true

# The process for a handle, with the lock held (panics on a bad handle).
fn os_proc_lock(h: int, what: str, loc: ptr) -> ptr:
    # nothing was spawned: always invalid
    if load_i64(global_mem("os_procs", 32), PT_READY) == 0:
        os_proc_get(h, what, loc)
    os_lock(global_mem("os_proc_mu", 64))
    return os_proc_get(h, what, loc)

fn brine_os_wait(handle: int, loc: ptr) -> int:
    let p = os_proc_lock(handle, "os.wait", loc)
    os_proc_reap(p, true)
    let c = load_i64(p, PR_CODE)
    os_unlock(global_mem("os_proc_mu", 64))
    return c

fn brine_os_poll(handle: int, code: ptr, loc: ptr) -> bool:
    let p = os_proc_lock(handle, "os.poll", loc)
    let done = os_proc_reap(p, false)
    store_i64(code, 0, load_i64(p, PR_CODE) if done else 0)
    os_unlock(global_mem("os_proc_mu", 64))
    return done

fn brine_os_kill(handle: int, loc: ptr):
    let p = os_proc_lock(handle, "os.kill", loc)
    if load_u8(p, PR_DONE) == 0:
        if os_is("windows"):
            # 101, as for a process killed by a signal on Unix
            TerminateProcess(load_ptr(p, PR_PROC), 101)
        else:
            # SIGKILL
            kill(load_i32(p, PR_PROC), 9)
        os_proc_reap(p, true)
    os_unlock(global_mem("os_proc_mu", 64))

fn brine_os_output(handle: int, out: ptr, err: ptr, loc: ptr):
    let p = os_proc_lock(handle, "os.output", loc)
    if not os_proc_reap(p, false):
        os_unlock(global_mem("os_proc_mu", 64))
        panic_text_cold(loc, "os.output: the process is still running; call os.wait first")
    let o = load_ptr(p, PR_OUTS)
    let e = load_ptr(p, PR_ERRS)
    str_retain(o)
    str_retain(e)
    store_ptr(out, 0, o)
    store_ptr(err, 0, e)
    os_unlock(global_mem("os_proc_mu", 64))

# At exit: drops what finished processes wrote (running ones are left
# alone). Called by brine_rt_shutdown.
fn brine_x_os_procs_free():
    let t = global_mem("os_procs", 32)
    let n = load_i64(t, PT_N)
    for i in 0..n:
        let p = load_ptr(t, PT_P) + i * PROC_SIZE
        if load_u8(p, PR_DONE) == 0:
            continue
        str_release(load_ptr(p, PR_OUTS))
        str_release(load_ptr(p, PR_ERRS))
        store_ptr(p, PR_OUTS, null_ptr())
        store_ptr(p, PR_ERRS, null_ptr())
    brine_free(load_ptr(t, PT_P))
    store_ptr(t, PT_P, null_ptr())
    store_i64(t, PT_N, 0)
    store_i64(t, PT_CAP, 0)

# ---- program arguments
fn brine_args() -> ptr:
    let pa = stack_mem(8)
    store_ptr(pa, 0, new_strs())
    var i = 1
    while true:
        let a = brine_arg(i)
        if addr(a) == 0:
            break
        push_str(pa, os_text(a))
        i += 1
    return load_ptr(pa, 0)

# ---------------------------------------------------------------- the process
# brine_rt.c's "panics", "stack overflow", "init / shutdown", the output
# functions and the reductions' fold: what starts and ends a program, and
# what it reports on the way out.

extern fn GetCommandLineW() -> ptr

extern fn _setmode(fd: i32, mode: i32) -> i32

extern fn SetConsoleOutputCP(cp: u32) -> i32

extern fn AddVectoredExceptionHandler(first: u32, f: ptr) -> ptr

extern fn SetThreadStackGuarantee(n: ptr) -> i32

extern fn sigaction(sig: i32, act: ptr, old: ptr) -> i32

extern fn sigaltstack(ss: ptr, old: ptr) -> i32

extern fn _exit(code: i32)

extern fn fstat(fd: i32, buf: ptr) -> i32

# the process's state: whether a panic is being reported, whether stdout
# is flushed at each line, the arguments, whether `main` runs on our
# thread yet, the key of each thread's stack top (plus one; POSIX), and
# the output lock
const P_PANICKING = 0
const P_OUT_LINES = 8
const P_ARGC = 16
const P_ARGV = 24
const P_STARTED = 32
const P_STACK_KEY = 40
const P_IO = 64

fn proc_mem() -> ptr:
    return global_mem("proc", 128)

# how many threads may touch values besides the main one, times MT_STEP
# (brine_rt.h's brine_mt: generated code reads it too). On an arm64 CPU
# without ARMv8.1's atomics it is odd, as if there always were: the one load
# a64.br's reference counts make tells them both.
const MT_STEP = 2

fn mt_count() -> ptr:
    return global_mem("brine_mt", 8)

# 1 when the CPU has ARMv8.1's atomic instructions (ldadd, swp, cas), which
# a64.br's code uses then instead of exclusive loads and stores: every arm64
# Mac has them; Linux says in AT_HWCAP (HWCAP_ATOMICS)
fn lse_flag() -> ptr:
    return global_mem("brine_lse", 8)

# the one-byte strings, immortal: 24 bytes each (brine_str1), set up first
fn byte_strs() -> ptr:
    return global_mem("brine_bytes", 6144)

fn bytes_init():
    let b = byte_strs()
    for c in 0..256:
        store_i64(b, c * 24, -1)
        store_i64(b, c * 24 + 8, 1)
        store_u8(b, c * 24 + 16, u8(c))

fn io_mu() -> ptr:
    return proc_mem() + P_IO

fn brine_x_io_lock():
    lock(io_mu())

fn brine_x_io_unlock():
    unlock(io_mu())

fn stderr_text(s: str):
    let p = ptr_of(s)
    fwrite(p + STR_DATA, u64(1), load_u64(p, STR_LEN), os_stdio(2))

# A C string as a (borrowed) str; the program is on its way out.
fn c_text(p: ptr) -> str:
    return str_of(os_text(p))

# ------------------------------------------------------------ panics
# Set by the first panic. Only that one is reported: a thread that fails
# (or prints) after it waits for the exit, so a `par` region failing on
# many threads prints one clean message.
fn park():
    while true:
        brine_os_sleep(1.0)

fn panic_claim():
    if atomic_xchg(proc_mem() + P_PANICKING, 1) != 0:
        park()

fn panic_text_cold(loc: ptr, msg: str):
    panic_help_cold(loc, msg, panic_help(msg))

# A panic with a line of help after its call chain ("" for none).
fn panic_help_cold(loc: ptr, msg: str, help: str):
    panic_claim()
    # under the output lock, so other threads' output (the GPU log) can't
    # land in the middle
    lock(io_mu())
    fflush(os_stdio(1))
    if brine_world_size() > 1:
        stderr_text(f"\npanic (rank {brine_world_rank()}): {msg}\n  --> {c_text(loc)}\n")
    else:
        stderr_text(f"\npanic: {msg}\n  --> {c_text(loc)}\n")
    let fp = frame_ptr()
    call_chain(fp, u64(0), os_stdio(2))
    help_line(help)
    fflush(os_stdio(2))
    unlock(io_mu())
    panic_record(c_text(loc), msg, fp, u64(0), help)
    panic_stop()
    brine_x_gpu_settle()
    exit(i32(101))

fn help_line(help: str):
    if len(help) > 0:
        stderr_text(f"  = help: {help}\n")

# How to avoid the runtime's panic with message msg, "" when there's nothing
# short and sure to say.
fn panic_help(msg: str) -> str:
    if msg.starts_with("index ") and text_has(msg, " is out of bounds for "):
        return "an index must be at least 0 and less than the length: check it against `len(...)` first"
    if msg.starts_with("slice ["):
        if text_has(msg, " is out of bounds for "):
            return "a slice [lo:hi] needs 0 <= lo <= hi <= the length"
        return "string positions count bytes: cut where a character starts, such as at a position `find()` gave"
    if msg.starts_with("unwrap() called on None"):
        return "match on the Option to handle None, or use `unwrap_or(default)`"
    if msg.starts_with("unwrap() called on Err"):
        return "match on the Result to handle the error, use `unwrap_or(default)`, or pass the error on with `?`"
    if msg.starts_with("division by zero") or msg.starts_with("remainder by zero"):
        return "check that the divisor isn't 0 first"
    if msg.starts_with("integer overflow"):
        return "use a wider type (such as `i128`), or `wrapping_add`, `wrapping_sub` or `wrapping_mul` if it should wrap around"
    if msg.starts_with("integer conversion out of range"):
        return "check that the value fits in the type before converting it"
    if msg.starts_with("float to integer conversion"):
        return "check that the value is in the type's range, and isn't NaN, before converting it"
    if msg.starts_with("invalid integer"):
        return "`s.to_int()` gives None for text that isn't a number, instead of panicking"
    if msg.starts_with("invalid float"):
        return "`s.to_float()` gives None for text that isn't a number, instead of panicking"
    if msg.starts_with("key ") and text_has(msg, " is not in the map"):
        return "check with `k in m` first, or use `m.get(k)` (an Option) or `m.get(k, default)`"
    if msg.starts_with("pop() from an empty array") or text_has(msg, "() of an empty sequence"):
        return "check that it isn't empty first"
    return ""

# whether `part` is somewhere in s
fn text_has(s: str, part: str) -> bool:
    let p = ptr_of(s) + STR_DATA
    let q = ptr_of(part) + STR_DATA
    let n = len(s)
    let m = len(part)
    for i in 0..n - m + 1:
        var j = 0
        while j < m and load_u8(p, i + j) == load_u8(q, j):
            j += 1
        if j == m:
            return true
    return false

# ------------------------------------------------------------ call chains
# Native code keeps its frame pointer (rbp, x29) chained through every frame
# (the saved one at [fp], the return address above it), and the backend writes a table of where each
# function starts and where its calls return to, with their sites: the lines
# of the calls and the functions inlined there (obj.br, `fn_table`), so a
# panic can name the functions it came through and the lines it came
# through them at. Nothing of this runs until a panic.

extern fn brine_frame_ptr() -> ptr

# this function's frame pointer (0 where there is no table: other CPUs)
fn frame_ptr() -> ptr:
    if os_is("x86_64") or os_is("aarch64"):
        return brine_frame_ptr()
    return null_ptr()

# the table's header words: the address of .text, the number of functions,
# the size of .text, of calls, of names, the size of the sites
const FT_TEXT = 0
const FT_FUNCS = 8
const FT_SIZE = 16
const FT_CALLS = 24
const FT_NAMES = 32
const FT_SITES = 40
const FT_HEAD = 48

fn fn_table() -> ptr:
    return symbol("brine_fn_table")

# where the sites start in the table
fn ft_sites(t: ptr) -> ptr:
    return (
        t
        + FT_HEAD
        + 8 * (load_i64(t, FT_FUNCS) + load_i64(t, FT_CALLS))
        + 4 * load_i64(t, FT_NAMES)
    )

# The last of n 8-byte entries at t + at whose first u32 is <= off (0 if none is).
fn ft_find(t: ptr, at: int, n: int, off: int) -> int:
    var lo = 0
    var hi = n - 1
    while lo < hi:
        let mid = (lo + hi + 1) / 2
        if int(load_u32(t, at + 8 * mid)) <= off:
            lo = mid
        else:
            hi = mid - 1
    return lo

# The function the code at address a is in: its site (its name and `fn`
# line), 0 for the runtime's, the prelude's and generated code, -1 outside
# the program.
fn frame_at(a: u64) -> int:
    # (only native code has the table)
    if os_is("x86_64") or os_is("aarch64"):
        let t = fn_table()
        let text = load_u64(t, FT_TEXT)
        let n = load_i64(t, FT_FUNCS)
        if a <= text or a > text + load_u64(t, FT_SIZE) or n == 0:
            return -1
        # (a return address is just after its call)
        let i = ft_find(t, FT_HEAD, n, int(a - text - u64(1)))
        return int(load_u32(t, FT_HEAD + 4 + 8 * i))
    return -1

# The site of the call that returns to address a (0: none).
fn site_at(a: u64) -> int:
    if os_is("x86_64") or os_is("aarch64"):
        let t = fn_table()
        let text = load_u64(t, FT_TEXT)
        let nc = load_i64(t, FT_CALLS)
        let off = int(a - text)
        let c = FT_HEAD + 8 * load_i64(t, FT_FUNCS)
        if a <= text or nc == 0 or int(load_u32(t, c)) > off:
            return 0
        let i = ft_find(t, c, nc, off)
        return int(load_u32(t, c + 4 + 8 * i))
    return 0

# The LEB128 number at p + at, and where the next one starts.
fn uleb_at(p: ptr, at: int) -> (int, int):
    var v = 0
    var sh = 0
    var i = at
    while true:
        let b = int(load_u8(p, i))
        i += 1
        v = v | ((b & 127) << sh)
        sh += 7
        if b < 128:
            break
    return (v, i)

# name n of the table ("name (file")
fn ft_name(t: ptr, n: int) -> str:
    let at = FT_HEAD + 8 * (load_i64(t, FT_FUNCS) + load_i64(t, FT_CALLS)) + 4 * n
    let names = ft_sites(t) + load_i64(t, FT_SITES)
    return c_text(names + int(load_u32(t, at)))

# Prints the functions a panic came through, innermost first, each with the
# line it was at: from the frame at fp (and, when pc isn't 0, the function at
# pc, which may not have set up its frame yet). A call's site names the
# functions inlined there too; the runtime's and the prelude's frames are left
# out (the user's call into them names the line). A `par` body or task ends
# it, since which thread ran it, and so what called it, varies from run to run.
fn call_chain(fp0: ptr, pc: u64, out: ptr):
    if addr(fp0) == u64(0):
        return
    let t = fn_table()
    let sites = ft_sites(t)
    var lines = 0
    var last = -1
    var last_line = -1
    var same = 0
    var fp = addr(fp0)
    var a = pc
    var steps = 0
    while steps < 10000000:
        steps += 1
        # (pc is where a fault was, not a return address)
        var ret = false
        if a == u64(0):
            # a frame: the saved frame pointer, then the return address
            a = load_u64(null_ptr() + int(fp), 8)
            ret = true
            let next = load_u64(null_ptr() + int(fp), 0)
            if next <= fp or next - fp > u64(1073741824) or (next & u64(7)) != u64(0):
                # the last frame: what it returns to isn't ours
                fp = u64(0)
            else:
                fp = next
        let at = frame_at(a)
        if at < 0:
            break
        if at > 0:
            let site = site_at(a) if ret else 0
            let (nf, i0) = uleb_at(sites, site if site > 0 else at)
            var i = i0
            for _ in 0..nf:
                let (name, i1) = uleb_at(sites, i)
                let (line, i2) = uleb_at(sites, i1)
                i = i2
                if name == last and line == last_line:
                    same += 1
                    continue
                if same > 0:
                    chain_again(t, last, last_line, same, out)
                    lines += 1
                    same = 0
                if lines >= 20:
                    file_text(out, "  ...\n")
                    return
                let s = ft_name(t, name)
                if lines == 0:
                    file_text(out, f"  in {s}:{line})\n")
                else:
                    file_text(out, f"  called from {s}:{line})\n")
                lines += 1
                last = name
                last_line = line
                if s.starts_with("a `par` body in ") or s.starts_with("a task in "):
                    return
        a = u64(0)
        if fp == u64(0):
            break
    if same > 0:
        chain_again(t, last, last_line, same, out)

# frame `name` at `line` called itself n more times
fn chain_again(t: ptr, name: int, line: int, n: int, out: ptr):
    let s = ft_name(t, name)
    if n == 1:
        file_text(out, f"  called from {s}:{line}), 1 more time\n")
    else:
        file_text(out, f"  called from {s}:{line}), {n} more times\n")

fn file_text(f: ptr, s: str):
    let p = ptr_of(s)
    fwrite(p + STR_DATA, u64(1), load_u64(p, STR_LEN), f)

# `brine run --json` reads the panic from the file BRINE_PANIC_FILE names:
# its location, a NUL, its message, a NUL, its call chain's lines, a NUL,
# then its help.
fn panic_record(loc: str, msg: str, fp: ptr, pc: u64, help: str):
    let path = getenv(lit("BRINE_PANIC_FILE"))
    if addr(path) == u64(0):
        return
    let f = os_fopen(path, "wb")
    if addr(f) == u64(0):
        return
    let nul = stack_mem(8)
    store_u8(nul, 0, u8(0))
    file_text(f, loc)
    fwrite(nul, u64(1), u64(1), f)
    file_text(f, msg)
    fwrite(nul, u64(1), u64(1), f)
    call_chain(fp, pc, f)
    fwrite(nul, u64(1), u64(1), f)
    file_text(f, help)
    fclose(f)

# `brine debug` stops here: the panic is printed, and the stack still has
# the frames that led to it
fn panic_stop():
    pass

fn brine_panic_at(loc: ptr, msg: ptr):
    panic_text_cold(loc, c_text(msg))

fn brine_panic_idx(i: int, n: int, loc: ptr):
    panic_text_cold(loc, f"index {i} is out of bounds for an array of length {n}")

fn brine_panic_ovf(op: ptr, loc: ptr):
    panic_text_cold(loc, f"integer overflow in {c_text(op)}")

# "+", "-" or "*" for "addition", "subtraction" or "multiplication"
fn ovf_sign(op: str) -> str:
    if op.starts_with("a"):
        return "+"
    if op.starts_with("s"):
        return "-"
    return "*"

# a op b overflowed (signed operands, or ones under 64 bits)
fn brine_panic_ovf_ab(op: ptr, a: int, b: int, loc: ptr):
    let o = c_text(op)
    let bs = f"({b})" if b < 0 else f"{b}"
    panic_text_cold(loc, f"integer overflow in {o}: {a} {ovf_sign(o)} {bs}")

# the same with u64 operands
fn brine_panic_ovf_u(op: ptr, a: int, b: int, loc: ptr):
    let o = c_text(op)
    panic_text_cold(loc, f"integer overflow in {o}: {u64(a)} {ovf_sign(o)} {u64(b)}")

# `panic(msg)`: the program's own message, so no help, but for the
# prelude's `unwrap`
fn brine_panic_str(loc: ptr, msg: ptr):
    let m = str_of(msg)
    panic_help_cold(loc, m, panic_help(m) if m.starts_with("unwrap() called on ") else "")

fn brine_assert_fail(loc: ptr, src: ptr, msg: ptr):
    if addr(msg) != 0:
        panic_text_cold(loc, f"assertion failed: {c_text(src)}\n  message: {str_of(msg)}")
    panic_text_cold(loc, f"assertion failed: {c_text(src)}")

# A failed `assert a <op> b`, with the values of a and b (lower.br,
# `assert_values`).
fn assert_values_cold(loc: ptr, src: ptr, msg: ptr, a: str, b: str):
    let s = c_text(src)
    if addr(msg) != 0:
        panic_help_cold(
            loc,
            f"assertion failed: {s}\n  left: {a}\n  right: {b}\n  message: {str_of(msg)}",
            ""
        )
    panic_help_cold(loc, f"assertion failed: {s}\n  left: {a}\n  right: {b}", "")

# (each formats a and b with a string builder: `brine_sb_*`)
fn brine_panic_assert_i(loc: ptr, src: ptr, msg: ptr, a: int, b: int):
    let sa = stack_mem(24)
    brine_sb_init(sa)
    brine_sb_i64(sa, a)
    let sb = stack_mem(24)
    brine_sb_init(sb)
    brine_sb_i64(sb, b)
    assert_values_cold(loc, src, msg, str_of(brine_sb_finish(sa)), str_of(brine_sb_finish(sb)))

fn brine_panic_assert_u(loc: ptr, src: ptr, msg: ptr, a: u64, b: u64):
    let sa = stack_mem(24)
    brine_sb_init(sa)
    brine_sb_u64(sa, a)
    let sb = stack_mem(24)
    brine_sb_init(sb)
    brine_sb_u64(sb, b)
    assert_values_cold(loc, src, msg, str_of(brine_sb_finish(sa)), str_of(brine_sb_finish(sb)))

fn brine_panic_assert_f(loc: ptr, src: ptr, msg: ptr, a: float, b: float):
    let sa = stack_mem(24)
    brine_sb_init(sa)
    brine_sb_f64(sa, a)
    let sb = stack_mem(24)
    brine_sb_init(sb)
    brine_sb_f64(sb, b)
    assert_values_cold(loc, src, msg, str_of(brine_sb_finish(sa)), str_of(brine_sb_finish(sb)))

fn brine_panic_assert_f32(loc: ptr, src: ptr, msg: ptr, a: f32, b: f32):
    let sa = stack_mem(24)
    brine_sb_init(sa)
    brine_sb_f32(sa, a)
    let sb = stack_mem(24)
    brine_sb_init(sb)
    brine_sb_f32(sb, b)
    assert_values_cold(loc, src, msg, str_of(brine_sb_finish(sa)), str_of(brine_sb_finish(sb)))

fn brine_panic_assert_b(loc: ptr, src: ptr, msg: ptr, a: bool, b: bool):
    assert_values_cold(loc, src, msg, "true" if a else "false", "true" if b else "false")

# (a and b are the values' text)
fn brine_panic_assert_text(loc: ptr, src: ptr, msg: ptr, a: ptr, b: ptr):
    assert_values_cold(loc, src, msg, str_of(a), str_of(b))

fn brine_unreachable():
    fflush(os_stdio(1))
    stderr_text("internal error: reached unreachable code\n")
    abort()

fn brine_exit(code: int):
    brine_flush()
    brine_x_gpu_settle()
    if code != 0:
        exit_record(code)
    # like returning from `main`: every rank waits for the others
    brine_x_world_finish(lit("it called `exit`"))
    brine_flush()
    exit(i32(code))

# ------------------------------------------------------------ stack overflow
# Deep recursion runs into the guard page under the stack. Instead of dying
# silently (and losing what is still buffered for stdout), report it like
# a panic. The handler runs on a reserve: on Windows the stack guarantee,
# on POSIX an alternate signal stack, both set up for each thread.
const STACK_HELP = "every thread has a 64 MB stack: check that the recursion ends, or make it a loop"

fn stack_overflow(fp: u64, pc: u64):
    panic_claim()
    fflush(os_stdio(1))
    if brine_world_size() > 1:
        stderr_text(f"\npanic (rank {brine_world_rank()}): stack overflow (recursion too deep)\n")
    else:
        stderr_text("\npanic: stack overflow (recursion too deep)\n")
    # (pc + 1: the fault may be at a function's first byte)
    call_chain(null_ptr() + int(fp), pc + u64(1), os_stdio(2))
    help_line(STACK_HELP)
    fflush(os_stdio(2))
    panic_record(
        "",
        "stack overflow (recursion too deep)",
        null_ptr() + int(fp),
        pc + u64(1),
        STACK_HELP
    )
    panic_stop()
    _exit(i32(101))

fn brine_x_on_exception(e: ptr) -> i32:
    # (EXCEPTION_STACK_OVERFLOW)
    if load_u32(load_ptr(e, 0), 0) == u32(3221225725):
        if os_is("x86_64"):
            # the CONTEXT's rbp and rip
            let c = load_ptr(e, 8)
            stack_overflow(load_u64(c, 160), load_u64(c, 248))
        stack_overflow(u64(0), u64(0))
    # (EXCEPTION_CONTINUE_SEARCH)
    return i32(0)

fn brine_x_on_segv(sig: i32, si: ptr, uc: ptr):
    var a = u64(0)
    if os_is("macos"):
        a = addr(load_ptr(si, 24))
    else:
        a = addr(load_ptr(si, 16))
    let top = addr(stack_top())
    # the stack's own pages are mapped: a fault in its range (or just under
    # it, from a big frame that skipped the guard page) is an overflow
    if top != 0 and a < top and a >= top - u64(THREAD_STACK + 1048576):
        # Linux x86-64: rbp and rip in the ucontext's registers
        if os_is("linux") and os_is("x86_64"):
            stack_overflow(load_u64(uc, 120), load_u64(uc, 168))
        # Linux AArch64: x29 and pc in the ucontext's sigcontext
        if os_is("linux") and os_is("aarch64"):
            stack_overflow(load_u64(uc, 416), load_u64(uc, 440))
        # macOS AArch64: x29 and pc in the thread state the ucontext points to
        if os_is("macos") and os_is("aarch64"):
            let m = load_ptr(uc, 48)
            stack_overflow(load_u64(m, 248), load_u64(m, 272))
        # macOS x86-64: rbp and rip in the thread state, after the 16-byte
        # exception state
        if os_is("macos") and os_is("x86_64"):
            let m = load_ptr(uc, 48)
            stack_overflow(load_u64(m, 64), load_u64(m, 144))
        stack_overflow(u64(0), u64(0))
    # anything else crashes as it would without the handler (SIG_DFL)
    signal(sig, null_ptr())

# this thread's stack top, when it is one of ours (POSIX)
fn stack_top() -> ptr:
    if os_is("windows"):
        return null_ptr()
    else:
        let k = load_i64(proc_mem(), P_STACK_KEY)
        if k == 0:
            return null_ptr()
        return pthread_getspecific(u32(k - 1))

fn stack_setup():
    if os_is("windows"):
        AddVectoredExceptionHandler(u32(1), symbol("brine_x_on_exception"))
    else:
        let ks = stack_mem(16)
        store_i64(ks, 0, 0)
        if pthread_key_create(ks, null_ptr()) == 0:
            store_i64(proc_mem(), P_STACK_KEY, int(load_u32(ks, 0)) + 1)
        let sa = stack_mem(160)
        memset(sa, i32(0), u64(160))
        store_ptr(sa, 0, symbol("brine_x_on_segv"))
        if os_is("macos"):
            # struct sigaction's sa_flags: SA_SIGINFO | SA_ONSTACK; SIGSEGV, SIGBUS
            store_i32(sa, 12, i32(65))
            sigaction(i32(11), sa, null_ptr())
            sigaction(i32(10), sa, null_ptr())
        else:
            store_i32(sa, 136, i32(134217732))
            sigaction(i32(11), sa, null_ptr())
            sigaction(i32(7), sa, null_ptr())

fn stack_enter():
    if os_is("windows"):
        let r = stack_mem(16)
        store_u32(r, 0, u32(65536))
        SetThreadStackGuarantee(r)
    else:
        let k = load_i64(proc_mem(), P_STACK_KEY)
        if k == 0:
            return
        let here = stack_mem(16)
        let ss = stack_mem(32)
        memset(ss, i32(0), u64(32))
        # stack_t: the alternate stack, its size and flags (64 KiB, at least
        # SIGSTKSZ)
        var size = 65536
        if os_is("macos"):
            size = 131072
        let sp = malloc(u64(size))
        if addr(sp) == 0:
            return
        store_ptr(ss, 0, sp)
        if os_is("macos"):
            store_i64(ss, 8, size)
        else:
            store_i64(ss, 16, size)
        if sigaltstack(ss, null_ptr()) != 0:
            free(sp)
            return
        pthread_setspecific(u32(k - 1), here)

fn stack_leave():
    if os_is("posix"):
        let k = load_i64(proc_mem(), P_STACK_KEY)
        if k == 0:
            return
        pthread_setspecific(u32(k - 1), null_ptr())
        let ss = stack_mem(32)
        let old = stack_mem(32)
        memset(ss, i32(0), u64(32))
        memset(old, i32(0), u64(32))
        # (SS_DISABLE)
        if os_is("macos"):
            store_i32(ss, 16, i32(4))
        else:
            store_i32(ss, 8, i32(2))
        if sigaltstack(ss, old) == 0 and addr(load_ptr(old, 0)) != 0:
            free(load_ptr(old, 0))

# A new thread sets up its stack overflow report first and gives its heap
# back last.
fn brine_x_thread_enter():
    stack_enter()

fn brine_x_thread_leave():
    brine_x_heap_exit()
    stack_leave()

# ------------------------------------------------------------ output
# stdout going to a terminal or a pipe is flushed at the end of each line,
# since something may be reading it as it comes (a person, or a program
# talking a line protocol); to a file it's written when the buffer fills.
# (C's line buffering would do, but the Windows C library has none.)
fn stdout_streams() -> bool:
    if os_is("windows"):
        # (STD_OUTPUT_HANDLE)
        let h = GetStdHandle(u32(4294967285))
        if addr(h) == 0 or addr(h) == 18446744073709551615:
            return false
        let t = GetFileType(h)
        # NUL is a character device too, but not a console (FILE_TYPE_PIPE,
        # FILE_TYPE_CHAR)
        let mode = stack_mem(16)
        return t == u32(3) or (t == u32(2) and GetConsoleMode(h, mode) != 0)
    elif os_is("macos"):
        let st = stack_mem(160)
        if fstat(i32(1), st) != 0:
            return false
        return streams_mode(int(load_u16(st, MAC_ST_MODE)))
    else:
        let st = stack_mem(256)
        # (AT_EMPTY_PATH, STATX_TYPE)
        if statx(i32(1), lit(""), i32(4096), u32(1), st) != 0:
            return false
        return streams_mode(int(load_u16(st, STATX_MODE)))

# a FIFO, a socket or a terminal
fn streams_mode(m: int) -> bool:
    let t = m & 61440
    return t == 4096 or t == 49152 or isatty(i32(1)) != 0

# writes a finished builder (and frees it); `print` adds its own `end`
fn brine_out_sb(sb: ptr):
    if atomic_load(proc_mem() + P_PANICKING) != 0:
        park()
    let p = load_ptr(sb, SB_P)
    let n = load_i64(sb, SB_LEN)
    let out = os_stdio(1)
    lock(io_mu())
    fwrite(p, u64(1), u64(n), out)
    if load_i64(proc_mem(), P_OUT_LINES) != 0 and addr(memchr(p, i32(10), u64(n))) != 0:
        fflush(out)
    unlock(io_mu())
    free_if(p)
    store_ptr(sb, SB_P, null_ptr())

fn brine_err_sb(sb: ptr):
    if atomic_load(proc_mem() + P_PANICKING) != 0:
        park()
    let p = load_ptr(sb, SB_P)
    lock(io_mu())
    fflush(os_stdio(1))
    fwrite(p, u64(1), load_u64(sb, SB_LEN), os_stdio(2))
    fflush(os_stdio(2))
    unlock(io_mu())
    free_if(p)
    store_ptr(sb, SB_P, null_ptr())

fn brine_flush():
    lock(io_mu())
    fflush(os_stdio(1))
    unlock(io_mu())

fn brine_print_sb(sb: ptr):
    brine_sb_cat(sb, lit("\n"), 1)
    brine_out_sb(sb)

fn brine_eprint_sb(sb: ptr):
    brine_sb_cat(sb, lit("\n"), 1)
    brine_err_sb(sb)

# `main` returned `Err`: sb is "error: <its message>", for stderr. For
# `brine run --json` it is a record (`panic_record`) too, with no location.
fn brine_main_err(sb: ptr):
    let path = getenv(lit("BRINE_PANIC_FILE"))
    let n = load_i64(sb, SB_LEN)
    if addr(path) != u64(0) and n >= 7:
        let f = os_fopen(path, "wb")
        if addr(f) != u64(0):
            let nul = stack_mem(8)
            store_u8(nul, 0, u8(0))
            fwrite(nul, u64(1), u64(1), f)
            file_text(f, "`main` returned an error: ")
            fwrite(load_ptr(sb, SB_P) + 7, u64(1), u64(n - 7), f)
            fwrite(nul, u64(1), u64(1), f)
            fclose(f)
    brine_eprint_sb(sb)

# ------------------------------------------------------------ start and end
# argument i (a C string), or null past the end
fn brine_arg(i: int) -> ptr:
    let pr = proc_mem()
    if i >= 0 and i < load_i64(pr, P_ARGC):
        return load_ptr(load_ptr(pr, P_ARGV), i * 8)
    return null_ptr()

# A test runs as `<tests> --run <k>`: from then on `args()` doesn't show the
# first n arguments, which are the runner's, not the test's.
fn brine_drop_args(n: int):
    let pr = proc_mem()
    let c = load_i64(pr, P_ARGC)
    if n > 0 and c > n:
        store_i64(pr, P_ARGC, c - n)
        store_ptr(pr, P_ARGV, load_ptr(pr, P_ARGV) + n * 8)

# Splits a command line the way CommandLineToArgvW does: the arguments go
# to d (len + 2 wide chars), argv[i] points at each. Our own copy because
# that function is in shell32.dll, which takes over a millisecond to load.
fn split_cmdline(s0: ptr, argv: ptr, d0: ptr) -> int:
    var s = s0
    var d = d0
    var argc = 1
    store_ptr(argv, 0, d)
    # the program ends at the next quote if it starts with one, else at a
    # space or control character, which is skipped
    if load_u16(s, 0) == 34:
        s = s + 2
        while load_u16(s, 0) != 0 and load_u16(s, 0) != 34:
            store_u16(d, 0, load_u16(s, 0))
            d = d + 2
            s = s + 2
        if load_u16(s, 0) != 0:
            s = s + 2
    else:
        while load_u16(s, 0) > 32:
            store_u16(d, 0, load_u16(s, 0))
            d = d + 2
            s = s + 2
        if load_u16(s, 0) != 0:
            s = s + 2
    store_u16(d, 0, 0)
    d = d + 2
    while load_u16(s, 0) == 32 or load_u16(s, 0) == 9:
        s = s + 2
    if load_u16(s, 0) == 0:
        return argc
    store_ptr(argv, argc * 8, d)
    argc += 1
    # 2n backslashes and a quote: n backslashes, and the quote opens or
    # closes; 2n+1 and a quote: n backslashes and a quote. Of a run of
    # quotes inside quotes, every third is a literal one.
    var q = 0
    var bs = 0
    while load_u16(s, 0) != 0:
        let c = load_u16(s, 0)
        if (c == 32 or c == 9) and q == 0:
            store_u16(d, 0, 0)
            d = d + 2
            bs = 0
            s = s + 2
            while load_u16(s, 0) == 32 or load_u16(s, 0) == 9:
                s = s + 2
            if load_u16(s, 0) != 0:
                store_ptr(argv, argc * 8, d)
                argc += 1
        elif c == 92:
            store_u16(d, 0, c)
            d = d + 2
            s = s + 2
            bs += 1
        elif c == 34:
            if bs & 1 == 0:
                d = d - bs / 2 * 2
                q += 1
            else:
                d = d - (bs / 2 + 1) * 2
                store_u16(d, 0, 34)
                d = d + 2
            s = s + 2
            bs = 0
            while load_u16(s, 0) == 34:
                s = s + 2
                q += 1
                if q == 3:
                    store_u16(d, 0, 34)
                    d = d + 2
                    q = 0
            if q == 2:
                q = 0
        else:
            store_u16(d, 0, c)
            d = d + 2
            s = s + 2
            bs = 0
    store_u16(d, 0, 0)
    return argc

# Windows hands `main` arguments in the local code page; brine strings are
# UTF-8
fn utf8_args(pr: ptr):
    let line = GetCommandLineW()
    # (the C library's argv[0] is then the program's path too)
    if load_u16(line, 0) == 0:
        return
    let len = int(wcslen(line))
    # each argument after the first follows a separator: at most len / 2 + 2
    let slots = len / 2 + 2
    let w = brine_alloc(slots * 8 + (len + 2) * 2)
    let n = split_cmdline(line, w, w + slots * 8)
    let out = brine_alloc((n + 1) * 8)
    for i in 0..n:
        let wi = load_ptr(w, i * 8)
        let m = int(
            WideCharToMultiByte(
                CP_UTF8,
                u32(0),
                wi,
                i32(-1),
                null_ptr(),
                i32(0),
                null_ptr(),
                null_ptr()
            )
        )
        let o = brine_alloc(max(m, 1))
        if m > 0:
            WideCharToMultiByte(CP_UTF8, u32(0), wi, i32(-1), o, i32(m), null_ptr(), null_ptr())
        else:
            store_u8(o, 0, 0)
        store_ptr(out, i * 8, o)
    store_ptr(out, n * 8, null_ptr())
    brine_free(w)
    store_i64(pr, P_ARGC, n)
    store_ptr(pr, P_ARGV, out)

# The OS gives the first thread a small stack (1 MB on Windows, 8 MB on
# Linux) while `par` threads get THREAD_STACK: so that code that works in
# `par` works outside it too, `main` runs again on a thread of ours.
fn brine_x_main_thread(p: ptr):
    let pr = proc_mem()
    exit(call_i32(symbol("main"), i32(load_i64(pr, P_ARGC)), load_ptr(pr, P_ARGV)))

# Where a program brine links itself starts on Windows (link.br): no C
# start-up code runs first, and brine_rt_init reads the arguments from
# GetCommandLineW.
fn brine_x_start():
    exit(call_i32(symbol("main"), i32(0), null_ptr()))

fn brine_rt_init(argc: i32, argv: ptr):
    let pr = proc_mem()
    if load_i64(pr, P_STARTED) == 0:
        store_i64(pr, P_STARTED, 1)
        if os_is("aarch64"):
            if os_is("macos"):
                store_i64(lse_flag(), 0, 1)
            elif os_is("linux"):
                if (getauxval(u64(16)) & u64(256)) != u64(0):
                    store_i64(lse_flag(), 0, 1)
            if load_i64(lse_flag(), 0) == 0:
                store_i64(mt_count(), 0, 1)
        bytes_init()
        stack_setup()
        store_i64(pr, P_ARGC, int(argc))
        store_ptr(pr, P_ARGV, argv)
        let th = stack_mem(16)
        if thread_start(symbol("brine_x_main_thread"), null_ptr(), th):
            thread_join(load_u64(th, 0))
            # (not reached: the thread exits the process)
            exit(i32(0))
    brine_x_heap_init(0 if addr(getenv(lit("BRINE_LEAKCHECK"))) == 0 else 1)
    store_i64(pr, P_ARGC, int(argc))
    store_ptr(pr, P_ARGV, argv)
    if os_is("windows"):
        utf8_args(pr)
        # output is UTF-8 with LF line endings on every platform (_O_BINARY)
        _setmode(i32(1), i32(32768))
        _setmode(i32(2), i32(32768))
        SetConsoleOutputCP(u32(65001))
    lock_init(io_mu())
    brine_x_pool_init()
    brine_x_gpu_setup()
    # (_IOFBF)
    setvbuf(os_stdio(1), malloc(u64(65536)), i32(0), u64(65536))
    store_i64(pr, P_OUT_LINES, 1 if stdout_streams() else 0)
    brine_x_world_init()

fn brine_rt_shutdown():
    brine_x_os_procs_free()
    fflush(os_stdio(1))
    brine_x_gpu_settle()
    brine_x_world_finish(lit("it returned from `main`"))
    fflush(os_stdio(1))
    if load_i64(leaks(), 0) != 0:
        stderr_text(f"brine: {brine_x_live_count()} live objects at exit\n")

# ------------------------------------------------------------ reductions
# `par sum(...)` and the other reductions combine in one fixed order that
# depends only on the element count (see brine_rt.h). A fold holds the
# nodes of complete aligned subtrees, highest first, like the digits of a
# binary counter: a new node merges with the top while their heights
# match. Pushing aligned subtrees in order and then combining what's left
# from the top down gives exactly the level-by-level pairing tree.
const RED_SUM = 0
const RED_PRODUCT = 1
const RED_MIN = 2
const RED_MAX = 3
const RED_ANY = 4
const RED_ALL = 5

# the value kinds (BRINE_VK_*)
const VK_I32 = 2
const VK_I64 = 3
const VK_I128 = 4
const VK_U8 = 5
const VK_U32 = 7
const VK_U64 = 8
const VK_U128 = 9
const VK_F32 = 10
const VK_F64 = 11

# a fold: the reduction, the value kind and size, the location, how many
# nodes, and each node's height, whether it has a value, and the value
const F_OP = 0
const F_VK = 8
const F_SIZE = 16
const F_LOC = 24
const F_TOP = 32
const F_HEIGHT = 40
const F_HAS = 616
const F_VAL = 688

fn vk_signed(vk: int) -> bool:
    return vk < VK_U8

# the integer of up to 64 bits at p
fn vk_load(vk: int, p: ptr) -> int:
    let s = vk % 5
    if vk_signed(vk):
        if s == 0:
            return int(load_i8(p, 0))
        if s == 1:
            return int(load_i16(p, 0))
        if s == 2:
            return int(load_i32(p, 0))
        return load_i64(p, 0)
    if s == 0:
        return int(load_u8(p, 0))
    if s == 1:
        return int(load_u16(p, 0))
    if s == 2:
        return int(load_u32(p, 0))
    return load_i64(p, 0)

fn vk_store(vk: int, p: ptr, v: int):
    let s = vk % 5
    if s == 0:
        store_u8(p, 0, u8(v & 255))
    elif s == 1:
        store_u16(p, 0, u16(v & 65535))
    elif s == 2:
        store_u32(p, 0, u32(v & 4294967295))
    else:
        store_i64(p, 0, v)

# a <- a (op) b; like the sequential `min`/`max`, the right value replaces
# the left one only if it's strictly smaller (larger), so NaNs and ties
# keep the left one
fn red_comb(op: int, vk: int, a: ptr, b: ptr, loc: ptr):
    if op == RED_ANY:
        store_bool(a, 0, load_bool(a, 0) or load_bool(b, 0))
    elif op == RED_ALL:
        store_bool(a, 0, load_bool(a, 0) and load_bool(b, 0))
    elif vk == VK_F64:
        let x = load_f64(a, 0)
        let y = load_f64(b, 0)
        if op == RED_SUM:
            store_f64(a, 0, x + y)
        elif op == RED_PRODUCT:
            store_f64(a, 0, x * y)
        elif (y < x) if op == RED_MIN else (y > x):
            store_f64(a, 0, y)
    elif vk == VK_F32:
        let x = load_f32(a, 0)
        let y = load_f32(b, 0)
        if op == RED_SUM:
            store_f32(a, 0, x + y)
        elif op == RED_PRODUCT:
            store_f32(a, 0, x * y)
        elif (y < x) if op == RED_MIN else (y > x):
            store_f32(a, 0, y)
    elif vk == VK_I128 or vk == VK_U128:
        comb_128(op, vk == VK_I128, a, b, loc)
    elif vk == VK_I64:
        let x = load_i64(a, 0)
        let y = load_i64(b, 0)
        if op == RED_SUM:
            store_i64(a, 0, brine_x_add_i64(x, y, loc))
        elif op == RED_PRODUCT:
            store_i64(a, 0, brine_x_mul_i64(x, y, loc))
        elif (y < x) if op == RED_MIN else (y > x):
            store_i64(a, 0, y)
    elif vk == VK_U64:
        let x = load_u64(a, 0)
        let y = load_u64(b, 0)
        if op == RED_SUM:
            store_u64(a, 0, brine_x_add_u64(x, y, loc))
        elif op == RED_PRODUCT:
            store_u64(a, 0, brine_x_mul_u64(x, y, loc))
        elif (y < x) if op == RED_MIN else (y > x):
            store_u64(a, 0, y)
    else:
        comb_small(op, vk, a, b, loc)

# 8 to 32 bits: exact in 64
fn comb_small(op: int, vk: int, a: ptr, b: ptr, loc: ptr):
    let x = vk_load(vk, a)
    let y = vk_load(vk, b)
    let bits = 8 << (vk % 5)
    var lo = 0
    var hi = (1 << bits) - 1
    if vk_signed(vk):
        lo = -(1 << (bits - 1))
        hi = (1 << (bits - 1)) - 1
    if op == RED_SUM:
        vk_store(vk, a, in_range(x + y, lo, hi, "integer overflow in addition", loc))
    elif op == RED_PRODUCT:
        if vk == VK_U32:
            # (the product of two u32 fits in a u64, not an i64)
            if u64(x) * u64(y) > u64(hi):
                panic_cold("integer overflow in multiplication", loc)
            vk_store(vk, a, int(u64(x) * u64(y)))
        else:
            vk_store(vk, a, in_range(x * y, lo, hi, "integer overflow in multiplication", loc))
    elif (y < x) if op == RED_MIN else (y > x):
        vk_store(vk, a, y)

fn comb_128(op: int, signed: bool, a: ptr, b: ptr, loc: ptr):
    let t = stack_mem(16)
    if op == RED_SUM:
        if signed:
            brine_x_add_i128(t, a, b, loc)
        else:
            brine_x_add_u128(t, a, b, loc)
        copy128(a, t)
    elif op == RED_PRODUCT:
        if signed:
            brine_x_mul_i128(t, a, b, loc)
        else:
            brine_x_mul_u128(t, a, b, loc)
        copy128(a, t)
    else:
        # b < a, 128-bit
        var lt = false
        let ah = load_u64(a, 8)
        let bh = load_u64(b, 8)
        if ah == bh:
            lt = load_u64(b, 0) < load_u64(a, 0)
        elif signed:
            lt = load_i64(b, 8) < load_i64(a, 8)
        else:
            lt = bh < ah
        let gt = not lt and (ah != bh or load_u64(a, 0) != load_u64(b, 0))
        if lt if op == RED_MIN else gt:
            copy128(a, b)

fn brine_x_fold_init(f: ptr, op: int, vk: int, loc: ptr):
    store_i64(f, F_OP, op)
    store_i64(f, F_VK, vk)
    store_i64(f, F_SIZE, vk_size(vk))
    store_ptr(f, F_LOC, loc)
    store_i64(f, F_TOP, 0)

# a <- a (+) b, where a node without a value (all filtered out) is the
# identity
fn node_comb(f: ptr, a: ptr, ha: ptr, b: ptr, hb: bool):
    if not hb:
        return
    if not load_bool(ha, 0):
        copy_bytes(a, b, load_i64(f, F_SIZE))
        store_bool(ha, 0, true)
        return
    red_comb(load_i64(f, F_OP), load_i64(f, F_VK), a, b, load_ptr(f, F_LOC))

# Pushes the node of an aligned subtree of 2^h leaves that starts where the
# nodes pushed so far end.
fn brine_x_fold_push(f: ptr, h0: int, v0: ptr, has0: int):
    var h = h0
    var v = v0
    var has = has0 != 0
    while true:
        let top = load_i64(f, F_TOP)
        if top == 0 or load_i64(f, F_HEIGHT + (top - 1) * 8) != h:
            break
        let t = top - 1
        node_comb(f, f + F_VAL + t * 16, f + F_HAS + t, v, has)
        store_i64(f, F_TOP, t)
        v = f + F_VAL + t * 16
        has = load_bool(f, F_HAS + t)
        h += 1
    let t = load_i64(f, F_TOP)
    store_i64(f, F_TOP, t + 1)
    store_i64(f, F_HEIGHT + t * 8, h)
    store_bool(f, F_HAS + t, has)
    let dst = f + F_VAL + t * 16
    if addr(v) != addr(dst):
        copy_bytes(dst, v, load_i64(f, F_SIZE))

# The root: the nodes left, combined from the top down. 0 if no element had
# a value.
fn brine_x_fold_finish(f: ptr, out: ptr) -> int:
    let top = load_i64(f, F_TOP)
    if top == 0:
        return 0
    var t = top - 1
    while t > 0:
        node_comb(
            f,
            f + F_VAL + (t - 1) * 16,
            f + F_HAS + t - 1,
            f + F_VAL + t * 16,
            load_bool(f, F_HAS + t)
        )
        t -= 1
    if not load_bool(f, F_HAS):
        return 0
    copy_bytes(out, f + F_VAL, load_i64(f, F_SIZE))
    return 1

# a reduction on the CPU: the leaf function, its context, the element and
# leaf counts, leaves per task, the reduction, kind and location, per task
# the node of its subtree and whether it has one, and for any/all the
# value that decides the result (else -1) and the lowest leaf (or element)
# known to have it
const J_FN = 0
const J_CTX = 8
const J_N = 16
const J_NLEAVES = 24
const J_TASK_LEAVES = 32
const J_OP = 40
const J_VK = 48
const J_LOC = 56
const J_VALS = 64
const J_HAS = 72
const J_DECIDE = 80
const J_STOP = 88
const J_SIZE = 96

# `any` and `all` are decided by the first element that is true (false):
# leaves after one that has it needn't run. The ones before it still do, so
# a panic the sequential loop would reach still happens.
fn decided(j: ptr, at: int) -> bool:
    return load_i64(j, J_DECIDE) >= 0 and atomic_load(j + J_STOP) < at

fn decide(j: ptr, at: int, v: ptr, h: bool):
    let d = load_i64(j, J_DECIDE)
    if d < 0 or not h or load_bool(v, 0) != (d == 1):
        return
    var cur = atomic_load(j + J_STOP)
    while at < cur:
        let was = atomic_cas(j + J_STOP, cur, at)
        if was == cur:
            return
        cur = was

fn brine_x_reduce_task(j: ptr, chunk: int, lo: int, hi: int):
    let v = stack_mem(16)
    let hp = stack_mem(16)
    let f = stack_mem(FOLD_SIZE)
    let n = load_i64(j, J_N)
    let nleaves = load_i64(j, J_NLEAVES)
    let tl = load_i64(j, J_TASK_LEAVES)
    for t in lo..hi:
        brine_x_fold_init(f, load_i64(j, J_OP), load_i64(j, J_VK), load_ptr(j, J_LOC))
        var l = t * tl
        let l1 = min(l + tl, nleaves)
        while l < l1 and not decided(j, l):
            let a = l * LEAF
            store_u8(hp, 0, 0)
            call_void(load_ptr(j, J_FN), load_ptr(j, J_CTX), l, a, min(a + LEAF, n), v, hp)
            let h = load_bool(hp, 0)
            decide(j, l, v, h)
            brine_x_fold_push(f, 0, v, 1 if h else 0)
            l += 1
        let has = brine_x_fold_finish(f, load_ptr(j, J_VALS) + t * 16)
        store_bool(load_ptr(j, J_HAS), t, has != 0)

# Few leaves for the threads: each element is a task of its own (`efn`
# gives its value, unfolded), and the leaves are folded from those values
# afterwards, in the same order as the leaf function would.
fn brine_x_reduce_elem(j: ptr, chunk: int, lo: int, hi: int):
    let vals = load_ptr(j, J_VALS)
    let has = load_ptr(j, J_HAS)
    for e in lo..hi:
        store_bool(has, e, false)
        if not decided(j, e):
            call_void(
                load_ptr(j, J_FN),
                load_ptr(j, J_CTX),
                e / LEAF,
                e,
                e + 1,
                vals + e * 16,
                has + e
            )
            decide(j, e, vals + e * 16, load_bool(has, e))

fn reduce_elems(j: ptr, f: ptr, start: ptr):
    let n = load_i64(j, J_N)
    let op = load_i64(j, J_OP)
    let vk = load_i64(j, J_VK)
    let loc = load_ptr(j, J_LOC)
    let size = vk_size(vk)
    let vals = load_ptr(j, J_VALS)
    let has = load_ptr(j, J_HAS)
    brine_par_run(0, n, n, symbol("brine_x_reduce_elem"), j)
    # sum and product start from 0 (1) like the leaf function: 0.0 + -0.0
    # is 0.0
    let from_start = op != RED_MIN and op != RED_MAX
    let acc = stack_mem(16)
    for l in 0..load_i64(j, J_NLEAVES):
        copy_bytes(acc, start, size)
        var h = false
        for e in l * LEAF..min((l + 1) * LEAF, n):
            if load_bool(has, e):
                if h or from_start:
                    red_comb(op, vk, acc, vals + e * 16, loc)
                else:
                    copy_bytes(acc, vals + e * 16, size)
                h = true
        brine_x_fold_push(f, 0, acc, 1 if h else 0)

fn brine_x_reduce_cpu(
    n: int,
    f: ptr,
    ef: ptr,
    ctx: ptr,
    op: int,
    vk: int,
    val: ptr,
    has: ptr,
    loc: ptr
):
    if n <= 0:
        return
    let j = stack_mem(J_SIZE)
    let nleaves = (n + LEAF - 1) / LEAF
    store_ptr(j, J_FN, f)
    store_ptr(j, J_CTX, ctx)
    store_i64(j, J_N, n)
    store_i64(j, J_NLEAVES, nleaves)
    store_i64(j, J_OP, op)
    store_i64(j, J_VK, vk)
    store_ptr(j, J_LOC, loc)
    var d = -1
    if op == RED_ANY:
        d = 1
    elif op == RED_ALL:
        d = 0
    store_i64(j, J_DECIDE, d)
    store_i64(j, J_STOP, 9223372036854775807)
    let nth = brine_x_threads()
    let fo = stack_mem(FOLD_SIZE)
    brine_x_fold_init(fo, op, vk, loc)
    if addr(ef) != 0 and n > 1 and nleaves < 4 * nth and nth > 1 and brine_x_in_par_get() == 0:
        store_ptr(j, J_FN, ef)
        store_ptr(j, J_VALS, brine_alloc(n * 16))
        store_ptr(j, J_HAS, brine_alloc(n))
        reduce_elems(j, fo, val)
    else:
        # tasks of 2^h leaves, several per thread for balance; the result
        # doesn't depend on the split, since every task is a whole subtree
        let want = nth * 8
        var h = 0
        while h < 62 and (1 << h) * want < nleaves:
            h += 1
        let tl = 1 << h
        store_i64(j, J_TASK_LEAVES, tl)
        let ntasks = (nleaves + tl - 1) / tl
        store_ptr(j, J_VALS, brine_alloc(ntasks * 16))
        store_ptr(j, J_HAS, brine_alloc(ntasks))
        brine_par_run(0, ntasks, ntasks, symbol("brine_x_reduce_task"), j)
        for t in 0..ntasks:
            let hv = 1 if load_bool(load_ptr(j, J_HAS), t) else 0
            brine_x_fold_push(fo, h, load_ptr(j, J_VALS) + t * 16, hv)
    if brine_x_fold_finish(fo, val) != 0:
        store_bool(has, 0, true)
    brine_free(load_ptr(j, J_VALS))
    brine_free(load_ptr(j, J_HAS))

# ------------------------------------------------------------ in-place pushes
# push and pop on an array this code owns alone: in place unless it is full
# (empty) or shared
fn arr_push_in(pa: ptr, elem: ptr, esz: int):
    let a = load_ptr(pa, 0)
    let n = load_i64(a, ARR_LEN)
    if n < load_i64(a, ARR_CAP) and load_i64(a, ARR_RC) == 1:
        copy_bytes(load_ptr(a, ARR_DATA) + n * esz, elem, esz)
        store_i64(a, ARR_LEN, n + 1)
        return
    brine_arr_push(pa, elem)

fn arr_pop_in(pa: ptr, out: ptr, esz: int, loc: ptr):
    let a = load_ptr(pa, 0)
    let n = load_i64(a, ARR_LEN)
    if n > 0 and load_i64(a, ARR_RC) == 1:
        store_i64(a, ARR_LEN, n - 1)
        copy_bytes(out, load_ptr(a, ARR_DATA) + (n - 1) * esz, esz)
        return
    brine_arr_pop(pa, out, loc)

fn arr_clear_in(pa: ptr):
    let a = load_ptr(pa, 0)
    if addr(load_ptr(a, ARR_RL)) == 0 and load_i64(a, ARR_RC) == 1:
        store_i64(a, ARR_LEN, 0)
        return
    brine_arr_clear(pa)

# ------------------------------------------------------------ loop idioms
# Loops the compiler recognizes, done in one step when every element they
# touch is in bounds. False, having changed nothing, when the loop must run
# as written (so a panic happens where it would have).

fn arr_mine(pa: ptr):
    if load_i64(load_ptr(pa, 0), ARR_RC) != 1:
        brine_arr_unique(pa)

# for i in lo..hi: a[i] = a[i + 1]
fn arr_shl(pa: ptr, lo: int, hi: int) -> bool:
    if lo >= hi:
        return true
    let a0 = load_ptr(pa, 0)
    let e = load_i64(a0, ARR_ESZ)
    if lo < 0 or hi >= load_i64(a0, ARR_LEN) or e == 0:
        return false
    arr_mine(pa)
    let d = load_ptr(load_ptr(pa, 0), ARR_DATA)
    memmove(d + lo * e, d + (lo + 1) * e, u64((hi - lo) * e))
    return true

# for i in lo..hi: b[i] = a[i], b and a different variables
fn arr_copy(pb: ptr, a: ptr, lo: int, hi: int) -> bool:
    if lo >= hi:
        return true
    let b0 = load_ptr(pb, 0)
    let e = load_i64(a, ARR_ESZ)
    if (
        lo < 0
        or hi > load_i64(a, ARR_LEN)
        or hi > load_i64(b0, ARR_LEN)
        or e != load_i64(b0, ARR_ESZ)
        or e == 0
    ):
        return false
    arr_mine(pb)
    memcpy(
        load_ptr(load_ptr(pb, 0), ARR_DATA) + lo * e,
        load_ptr(a, ARR_DATA) + lo * e,
        u64((hi - lo) * e)
    )
    return true

# x = a[lo]; for i in lo..hi: a[i] = a[i + 1]; a[hi] = x
fn arr_rotl(pa: ptr, lo: int, hi: int) -> bool:
    let a0 = load_ptr(pa, 0)
    let e = load_i64(a0, ARR_ESZ)
    if lo > hi or lo < 0 or hi >= load_i64(a0, ARR_LEN) or e == 0 or e > 64:
        return false
    arr_mine(pa)
    let d = load_ptr(load_ptr(pa, 0), ARR_DATA)
    let x = stack_mem(64)
    copy_bytes(x, d + lo * e, e)
    memmove(d + lo * e, d + (lo + 1) * e, u64((hi - lo) * e))
    copy_bytes(d + hi * e, x, e)
    return true

# The same on byte arrays: data d, length n, never shared.
fn bytes_shl(d: ptr, n: int, lo: int, hi: int) -> bool:
    if lo >= hi:
        return true
    if lo < 0 or hi >= n:
        return false
    memmove(d + lo, d + lo + 1, u64(hi - lo))
    return true

# (the brine_x_ names: x86-64 does these inline and calls these for the rest)
fn brine_x_bytes_rev(d: ptr, n: int, i0: int, j0: int) -> bool:
    if i0 >= j0:
        return true
    if i0 < 0 or j0 >= n or j0 - i0 >= 16:
        return false
    var i = i0
    var j = j0
    while i < j:
        let t = load_u8(d, i)
        store_u8(d, i, load_u8(d, j))
        store_u8(d, j, t)
        i += 1
        j -= 1
    return true

fn brine_x_bytes_rotl(d: ptr, n: int, lo: int, hi: int) -> bool:
    if lo > hi or lo < 0 or hi >= n:
        return false
    let x = load_u8(d, lo)
    memmove(d + lo, d + lo + 1, u64(hi - lo))
    store_u8(d, hi, x)
    return true

fn brine_x_bytes_copy(db: ptr, nb: int, da: ptr, na: int, lo: int, hi: int) -> bool:
    if lo >= hi:
        return true
    if lo < 0 or hi > na or hi > nb:
        return false
    copy_bytes(db + lo, da + lo, hi - lo)
    return true

# ------------------------------------------------------------ threads
fn os_thread_count() -> int:
    return brine_x_threads()

# how many chunks a parallel loop of n splits into
fn par_chunks(n: int) -> int:
    return par_plan(n)
