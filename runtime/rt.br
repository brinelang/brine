]
const SPACE_RANGES: [u32] = [
    0x9, 0xd, 0x1c, 0x20, 0x85, 0x85, 0xa0, 0xa0,
    0x1680, 0x1680, 0x2000, 0x200a, 0x2028, 0x2029, 0x202f, 0x202f,
    0x205f, 0x205f, 0x3000, 0x3000,
]
# fmt: on

# stands for a byte that isn't valid UTF-8: no case, no class
const NOT_CP = 0xffffffff

# the code point of the n-byte character at p (n from utf8_len)
fn utf8_cp(p: ptr, n: int) -> int:
    let b = int(load_u8(p, 0))
    if n == 1:
        return b if b < 0x80 else NOT_CP
    var c = b & (0x7f >> n)
    for i in 1..n:
        c = (c << 6) | (int(load_u8(p, i)) & 0x3f)
    return c

# the length of the character at byte i of s, and its code point in *pc
fn char_at(s: ptr, i: int, pc: ptr) -> int:
    let p = s + STR_DATA + i
    let n = utf8_len(p, load_i64(s, STR_LEN) - i)
    store_i64(pc, 0, utf8_cp(p, n))
    return n

fn sb_cp(sb: ptr, c: int):
    let b = stack_mem(8)
    var n = 4
    if c < 0x80:
        store_u8(b, 0, u8(c))
        n = 1
    elif c < 0x800:
        store_u8(b, 0, u8(0xc0 | (c >> 6)))
        store_u8(b, 1, u8(0x80 | (c & 0x3f)))
        n = 2
    elif c < 0x10000:
        store_u8(b, 0, u8(0xe0 | (c >> 12)))
        store_u8(b, 1, u8(0x80 | ((c >> 6) & 0x3f)))
        store_u8(b, 2, u8(0x80 | (c & 0x3f)))
        n = 3
    else:
        store_u8(b, 0, u8(0xf0 | (c >> 18)))
        store_u8(b, 1, u8(0x80 | ((c >> 12) & 0x3f)))
        store_u8(b, 2, u8(0x80 | ((c >> 6) & 0x3f)))
        store_u8(b, 3, u8(0x80 | (c & 0x3f)))
    brine_sb_cat(sb, b, n)

fn run_at(up: bool, k: int) -> int:
    return int(UPPER_RUNS[k]) if up else int(LOWER_RUNS[k])

# c mapped by the run that covers it (c itself if none does)
fn case_map(up: bool, c: int) -> int:
    var lo = 0
    var hi = (len(UPPER_RUNS) if up else len(LOWER_RUNS)) / 4
    while lo < hi:
        let m = (lo + hi) / 2
        if run_at(up, m * 4) <= c:
            lo = m + 1
        else:
            hi = m
    if lo == 0:
        return c
    let r = (lo - 1) * 4
    if c > run_at(up, r + 1) or (c - run_at(up, r)) % run_at(up, r + 3) != 0:
        return c
    return c + run_at(up, r + 2)

fn special_at(up: bool, k: int) -> int:
    return int(UPPER_SPECIAL[k]) if up else int(LOWER_SPECIAL[k])

# the special that maps c, or -1
fn special(up: bool, c: int) -> int:
    var lo = 0
    var hi = len(UPPER_SPECIAL) if up else len(LOWER_SPECIAL)
    while lo < hi:
        let m = (lo + hi) / 2
        let x = special_at(up, m)
        if x == c:
            return m
        if x < c:
            lo = m + 1
        else:
            hi = m
    return -1

fn put_special(sb: ptr, up: bool, k: int):
    if up:
        for j in int(UPPER_SPECIAL_AT[k])..int(UPPER_SPECIAL_AT[k + 1]):
            sb_byte(sb, UPPER_SPECIAL_BYTES[j])
    else:
        for j in int(LOWER_SPECIAL_AT[k])..int(LOWER_SPECIAL_AT[k + 1]):
            sb_byte(sb, LOWER_SPECIAL_BYTES[j])

fn range_at(alpha: bool, k: int) -> int:
    return int(ALPHA_RANGES[k]) if alpha else int(SPACE_RANGES[k])

fn in_ranges(alpha: bool, c: int) -> bool:
    var lo = 0
    var hi = (len(ALPHA_RANGES) if alpha else len(SPACE_RANGES)) / 2
    while lo < hi:
        let m = (lo + hi) / 2
        if range_at(alpha, m * 2) <= c:
            lo = m + 1
        else:
            hi = m
    return lo > 0 and c <= range_at(alpha, lo * 2 - 1)

fn is_alpha(c: int) -> bool:
    if c < 0x80:
        return u64(c | 32) - 97 < 26
    return c != NOT_CP and in_ranges(true, c)

# tab to carriage return, the four separators 0x1c-0x1f, and space
fn ascii_space(b: u8) -> bool:
    if b > 32:
        return false
    return (u64(0x1f0003e00) >> u64(b)) & 1 != 0

# the length of the character at byte i of s: positive if it is whitespace,
# negative if not
fn space_at(s: ptr, i: int) -> int:
    let b = load_u8(s, STR_DATA + i)
    if b < 0x80:
        return 1 if ascii_space(b) else -1
    return space_at_cold(s, i)

fn space_at_cold(s: ptr, i: int) -> int:
    let pc = stack_mem(8)
    let n = char_at(s, i, pc)
    return n if is_space(load_i64(pc, 0)) else -n

fn is_space(c: int) -> bool:
    if c < 0x80:
        return c == 32 or u64(c) - 9 < 5 or u64(c) - 0x1c < 4
    return c != NOT_CP and in_ranges(false, c)

# the length of the whitespace character ending at byte hi of s, or 0
fn space_before(s: ptr, hi: int) -> int:
    let b = load_u8(s, STR_DATA + hi - 1)
    if b < 0x80:
        return 1 if ascii_space(b) else 0
    return space_before_cold(s, hi)

fn space_before_cold(s: ptr, hi: int) -> int:
    let pc = stack_mem(8)
    var j = hi - 1
    while j > 0 and hi - j < 4 and load_u8(s, STR_DATA + j) & 0xc0 == 0x80:
        j -= 1
    var n = char_at(s, j, pc)
    if j + n != hi:
        n = char_at(s, hi - 1, pc)
    return n if is_space(load_i64(pc, 0)) else 0

fn str_case(s: ptr, up: bool) -> ptr:
    let sb = stack_mem(24)
    brine_sb_init(sb)
    let pc = stack_mem(8)
    let len = load_i64(s, STR_LEN)
    var prev_alpha = false
    var i = 0
    while i < len:
        let b = load_u8(s, STR_DATA + i)
        if b < 0x80:
            # ASCII: only a-z and A-Z change
            var o = b
            if up and u64(b) - 97 < 26:
                o = b - 32
            elif not up and u64(b) - 65 < 26:
                o = b + 32
            sb_byte(sb, o)
            prev_alpha = u64(b | 32) - 97 < 26
            i += 1
            continue
        let n = char_at(s, i, pc)
        let c = load_i64(pc, 0)
        let k = special(up, c) if c != NOT_CP else -1
        if k >= 0:
            put_special(sb, up, k)
        else:
            var m = c if c == NOT_CP else case_map(up, c)
            # a capital sigma that ends a word becomes the final form, as in Python
            if not up and c == 0x3a3 and prev_alpha:
                var next = NOT_CP
                if i + n < len:
                    char_at(s, i + n, pc)
                    next = load_i64(pc, 0)
                if not is_alpha(next):
                    m = 0x3c2
            if m == c:
                brine_sb_cat(sb, s + STR_DATA + i, n)
            else:
                sb_cp(sb, m)
        prev_alpha = is_alpha(c)
        i += n
    return brine_sb_finish(sb)

fn new_strs() -> ptr:
    let none = ptr_of("") + STR_DATA
    return brine_arr_new(0, 8, symbol("brine_rt_str"), symbol("brine_rl_str"), none)

fn brine_s_split_ws(s: ptr, loc: ptr) -> ptr:
    let pa = stack_mem(8)
    store_ptr(pa, 0, new_strs())
    let len = load_i64(s, STR_LEN)
    var i = 0
    while i < len:
        let n = space_at(s, i)
        if n > 0:
            i += n
            continue
        var j = i - n
        while j < len:
            let m = space_at(s, j)
            if m > 0:
                break
            j -= m
        push_str(pa, sub_str(s, i, j))
        i = j
    return load_ptr(pa, 0)

fn brine_s_join(sep: ptr, parts: ptr, loc: ptr) -> ptr:
    let sb = stack_mem(24)
    brine_sb_init(sb)
    let d = load_ptr(parts, ARR_DATA)
    for i in 0..load_i64(parts, ARR_LEN):
        if i > 0:
            brine_sb_str(sb, sep)
        brine_sb_str(sb, load_ptr(d, i * 8))
    return brine_sb_finish(sb)

fn brine_s_starts_with(s: ptr, p: ptr, loc: ptr) -> bool:
    let n = load_i64(p, STR_LEN)
    return n <= load_i64(s, STR_LEN) and memcmp(s + STR_DATA, p + STR_DATA, u64(n)) == 0

fn brine_s_ends_with(s: ptr, p: ptr, loc: ptr) -> bool:
    let n = load_i64(p, STR_LEN)
    let len = load_i64(s, STR_LEN)
    return n <= len and memcmp(s + STR_DATA + len - n, p + STR_DATA, u64(n)) == 0

fn strip(s: ptr, left: bool, right: bool) -> ptr:
    var lo = 0
    var hi = load_i64(s, STR_LEN)
    while left and lo < hi:
        let n = space_at(s, lo)
        if n < 0:
            break
        lo += n
    while right and hi > lo:
        let n = space_before(s, hi)
        if n == 0:
            break
        hi -= n
    if lo == hi:
        return brine_str_new(null_ptr(), 0)
    return sub_str(s, lo, hi)

fn brine_s_strip(s: ptr, loc: ptr) -> ptr:
    return strip(s, true, true)

fn brine_s_lstrip(s: ptr, loc: ptr) -> ptr:
    return strip(s, true, false)

fn brine_s_rstrip(s: ptr, loc: ptr) -> ptr:
    return strip(s, false, true)

fn brine_s_replace(s: ptr, a: ptr, b: ptr, loc: ptr) -> ptr:
    let na = load_i64(a, STR_LEN)
    if na == 0:
        brine_panic_at(loc, "replace() pattern is empty")
    let sb = stack_mem(24)
    brine_sb_init(sb)
    var at = 0
    while true:
        let i = find_from(s, a, at)
        if i < 0:
            break
        brine_sb_cat(sb, s + STR_DATA + at, i - at)
        brine_sb_str(sb, b)
        at = i + na
    brine_sb_cat(sb, s + STR_DATA + at, load_i64(s, STR_LEN) - at)
    return brine_sb_finish(sb)

fn brine_s_upper(s: ptr, loc: ptr) -> ptr:
    return str_case(s, true)

fn brine_s_lower(s: ptr, loc: ptr) -> ptr:
    return str_case(s, false)

fn brine_s_lines(s: ptr, loc: ptr) -> ptr:
    let pa = stack_mem(8)
    store_ptr(pa, 0, new_strs())
    let len = load_i64(s, STR_LEN)
    let d = s + STR_DATA
    var at = 0
    while at < len:
        var j = at
        while j < len and load_u8(d, j) != 10:
            j += 1
        let end = j - 1 if j > at and load_u8(d, j - 1) == 13 else j
        push_str(pa, sub_str(s, at, end) if end > at else brine_str_new(null_ptr(), 0))
        at = j + 1
    return load_ptr(pa, 0)

# Does every character of s (not empty) pass the test? kind: 0 digits
# (0-9, the ones int() reads), 1 letters, 2 spaces, 3 letters or digits.
fn all_chars(s: ptr, kind: int) -> bool:
    let len = load_i64(s, STR_LEN)
    if len == 0:
        return false
    let pc = stack_mem(8)
    var i = 0
    while i < len:
        var c = int(load_u8(s, STR_DATA + i))
        if c < 0x80:
            i += 1
        else:
            i += char_at(s, i, pc)
            c = load_i64(pc, 0)
        let digit = u64(c) - 48 < 10
        var ok = digit
        if kind == 1:
            ok = is_alpha(c)
        elif kind == 2:
            ok = is_space(c)
        elif kind == 3:
            ok = digit or is_alpha(c)
        if not ok:
            return false
    return true

fn brine_s_is_digit(s: ptr, loc: ptr) -> bool:
    return all_chars(s, 0)

fn brine_s_is_alpha(s: ptr, loc: ptr) -> bool:
    return all_chars(s, 1)

fn brine_s_is_space(s: ptr, loc: ptr) -> bool:
    return all_chars(s, 2)

fn brine_s_is_alnum(s: ptr, loc: ptr) -> bool:
    return all_chars(s, 3)

fn brine_s_count(s: ptr, sub: ptr, loc: ptr) -> int:
    let ns = load_i64(sub, STR_LEN)
    if ns == 0:
        brine_panic_at(loc, "count() pattern is empty")
    var n = 0
    var at = 0
    while true:
        let i = find_from(s, sub, at)
        if i < 0:
            break
        n += 1
        at = i + ns
    return n

fn brine_s_bytes(s: ptr, loc: ptr) -> ptr:
    let len = load_i64(s, STR_LEN)
    let a = brine_arr_new(len, 1, null_ptr(), null_ptr(), loc)
    memcpy(load_ptr(a, ARR_DATA), s + STR_DATA, u64(len))
    return a

fn brine_s_chars(s: ptr, loc: ptr) -> ptr:
    let pa = stack_mem(8)
    store_ptr(pa, 0, new_strs())
    let len = load_i64(s, STR_LEN)
    var i = 0
    while i < len:
        let b = load_u8(s, STR_DATA + i)
        if b < 0x80:
            push_str(pa, byte_str(b))
            i += 1
            continue
        let n = utf8_len(s + STR_DATA + i, len - i)
        push_str(pa, sub_str(s, i, i + n))
        i += n
    return load_ptr(pa, 0)

fn brine_s_repeat(s: ptr, n: int, loc: ptr) -> ptr:
    if n < 0:
        brine_panic_at(loc, f"repeat() count {n} is negative")
    let sb = stack_mem(24)
    brine_sb_init(sb)
    for _ in 0..n:
        brine_sb_str(sb, s)
    return brine_sb_finish(sb)

# the 128-bit product of a and b, folded to 64 bits
fn mum(a: u64, b: u64) -> u64:
    return (a * b) ^ mul_hi(a, b)

# Strings of 8 bytes or more (hash_str has the rest): 16 bytes per folded
# 64x64 -> 128 multiply (wyhash's scheme), then the last 1 to 16 bytes as
# two masked words, mixed with the top bit set.
fn brine_hash_long(p0: ptr, n0: u64) -> u64:
    let k0: u64 = 0xa0761d6478bd642f
    let k1: u64 = 0xe7037ed1a0b428db
    var p = p0
    var n = n0
    var seed = k0 ^ n
    while n > 16:
        seed = mum(load_u64(p, 0) ^ k1, load_u64(p, 8) ^ seed)
        p = p + 16
        n -= 16
    var a = load_u64(p, 0)
    var b: u64 = 0
    if n < 8:
        a = a & lowmask(n)
    elif n > 8:
        b = load_u64(p, 8) & lowmask(n - 8)
    return bswap((mum(k1 ^ n0, mum(a ^ k1, b ^ seed)) | (u64(1) << 63)) * 0x9e3779b97f4a7c15)

fn brine_str_cmp(a: ptr, b: ptr) -> i32:
    let na = load_i64(a, STR_LEN)
    let nb = load_i64(b, STR_LEN)
    let c = memcmp(a + STR_DATA, b + STR_DATA, u64(na if na < nb else nb))
    if c != 0:
        return c
    if na < nb:
        return -1
    return 1 if na > nb else 0

# ------------------------------------------------------------ floats
# Floats to text and back, exactly and the same everywhere: what C's printf
# and strtod give for correctly rounded conversions (ties to even). Big
# numbers live on the stack: a count of limbs, then the limbs, 32 bits each
# in a 64-bit word, the lowest first, no zero limbs on top.

const M32: u64 = 0xffffffff

# room for 10^1105 shifted 63 bits (parsing) and m * 5^1074 (printing)
const BN_SIZE = 1096

const F_SIGN: u64 = 0x8000000000000000

const F_INF: u64 = 0x7ff0000000000000

const F_NAN: u64 = 0x7ff8000000000000

# digits of a decimal: their count, the exponent of the first one (the value
# is d0.d1d2... * 10^x), then the digits in ASCII; missing ones are zeros
const DG_N = 0
const DG_X = 8
const DG_D = 16

# up to 767 significant digits (2^-1074 has 751)
const DG_SIZE = 816

# digits parsing keeps; past them, one more digit stands for the rest
const KEEP_DIGITS = 780

const DIGITS_ROOM = 788

# fast_digits couldn't
const NO_FAST = -100000

# 5^0 to 5^27, the powers of 5 below 2^64
const POW5_64: [u64] = [
    1, 5, 25, 125, 625, 3125, 15625, 78125, 390625, 1953125, 9765625, 48828125, 244140625,
    1220703125, 6103515625, 30517578125, 152587890625, 762939453125, 3814697265625, 19073486328125,
    95367431640625, 476837158203125, 2384185791015625, 11920928955078125, 59604644775390625,
    298023223876953125, 1490116119384765625, 7450580596923828125
]

# 10^0 to 10^19
const POW10_64: [u64] = [
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000,
    100000000000, 1000000000000, 10000000000000, 100000000000000, 1000000000000000,
    10000000000000000, 100000000000000000, 1000000000000000000, 10000000000000000000
]

