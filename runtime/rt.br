fn brine_x_fmod_i128(r: ptr, a: ptr, b: ptr):
    sdiv128(r, a, b, true, true)

fn brine_x_div_i128(r: ptr, a: ptr, b: ptr, loc: ptr):
    check(load_u64(b, 0) | load_u64(b, 8) != 0, "division by zero", loc)
    check(
        load_i64(b, 0) & load_i64(b, 8) != -1 or not is_min128(a),
        "integer overflow in division",
        loc
    )
    sdiv128(r, a, b, false, true)

fn brine_x_mod_i128(r: ptr, a: ptr, b: ptr, loc: ptr):
    check(load_u64(b, 0) | load_u64(b, 8) != 0, "remainder by zero", loc)
    sdiv128(r, a, b, true, true)

fn brine_x_abs_i128(r: ptr, a: ptr, loc: ptr):
    check(not is_min128(a), "integer overflow in abs", loc)
    if load_i64(a, 8) < 0:
        neg128(r, a)
    else:
        copy128(r, a)

fn brine_x_conv_i128_from_f64(r: ptr, x: float, loc: ptr):
    if not (
        x >= -170141183460469231731687303715884105728.0
        and x < 170141183460469231731687303715884105728.0
    ):
        conv_f_cold(x, "float to integer conversion out of range (or NaN) for i128", loc)
    from_f64_128(r, x)

fn brine_x_i128_add(r: ptr, a: ptr, b: ptr):
    let al = load_u64(a, 0)
    let lo = al + load_u64(b, 0)
    put128(r, lo, load_u64(a, 8) + load_u64(b, 8) + (u64(1) if lo < al else u64(0)))

fn brine_x_i128_sub(r: ptr, a: ptr, b: ptr):
    let al = load_u64(a, 0)
    let bl = load_u64(b, 0)
    put128(r, al - bl, load_u64(a, 8) - load_u64(b, 8) - (u64(1) if al < bl else u64(0)))

fn brine_x_i128_mul(r: ptr, a: ptr, b: ptr):
    mul128(r, a, b)

fn brine_x_i128_div(r: ptr, a: ptr, b: ptr):
    sdiv128(r, a, b, false, false)

fn brine_x_i128_rem(r: ptr, a: ptr, b: ptr):
    sdiv128(r, a, b, true, false)

fn brine_x_i128_shl(r: ptr, a: ptr, b: int):
    shl128(r, load_u64(a, 0), load_u64(a, 8), b & 127)

fn brine_x_i128_shr(r: ptr, a: ptr, b: int):
    shr128(r, load_u64(a, 0), load_u64(a, 8), b & 127, true)

fn brine_x_i128_neg(r: ptr, a: ptr):
    neg128(r, a)

fn brine_x_i128_cmp(a: ptr, b: ptr) -> i32:
    let ah = load_i64(a, 8)
    let bh = load_i64(b, 8)
    if ah != bh:
        return -1 if ah < bh else 1
    let al = load_u64(a, 0)
    let bl = load_u64(b, 0)
    if al == bl:
        return 0
    return -1 if al < bl else 1

fn brine_x_i128_from_i64(r: ptr, x: int):
    put128(r, u64(x), u64(x >> 63))

fn brine_x_i128_from_u64(r: ptr, x: u64):
    put128(r, x, 0)

fn brine_x_i128_from_f64(r: ptr, x: float):
    from_f64_128(r, x)

fn brine_x_i128_from_f32(r: ptr, x: f32):
    from_f64_128(r, float(x))

fn brine_x_i128_to_f64(a: ptr) -> float:
    return i128_to_f64(a)

fn brine_x_i128_to_f32(a: ptr) -> f32:
    return i128_to_f32(a)

# u128
fn brine_x_add_u128(r: ptr, a: ptr, b: ptr, loc: ptr):
    let al = load_u64(a, 0)
    let ah = load_u64(a, 8)
    let bh = load_u64(b, 8)
    let lo = al + load_u64(b, 0)
    let hi = ah + bh + (u64(1) if lo < al else u64(0))
    check(hi > ah or (hi == ah and lo >= al), "integer overflow in addition", loc)
    put128(r, lo, hi)

fn brine_x_sub_u128(r: ptr, a: ptr, b: ptr, loc: ptr):
    let al = load_u64(a, 0)
    let ah = load_u64(a, 8)
    let bl = load_u64(b, 0)
    let bh = load_u64(b, 8)
    let hi = ah - bh - (u64(1) if al < bl else u64(0))
    check(ah > bh or (ah == bh and al >= bl), "integer overflow in subtraction", loc)
    put128(r, al - bl, hi)

fn brine_x_mul_u128(r: ptr, a: ptr, b: ptr, loc: ptr):
    check(not mul_u128_ovf(r, a, b), "integer overflow in multiplication", loc)

fn brine_x_shl_u128(r: ptr, a: ptr, b: int, loc: ptr):
    shl128(r, load_u64(a, 0), load_u64(a, 8), int(shift_ok(b, 128, loc)))

fn brine_x_shr_u128(r: ptr, a: ptr, b: int, loc: ptr):
    shr128(r, load_u64(a, 0), load_u64(a, 8), int(shift_ok(b, 128, loc)), false)

fn brine_x_conv_u128_from_i64(r: ptr, x: int, loc: ptr):
    if not (x >= 0):
        conv_i_cold(x, "integer conversion out of range for u128", loc)
    put128(r, u64(x), u64(x >> 63))

fn brine_x_conv_u128_from_u64(r: ptr, x: u64, loc: ptr):
    put128(r, x, 0)

fn brine_x_conv_u128_from_i128(r: ptr, x: ptr, loc: ptr):
    if not (load_i64(x, 8) >= 0):
        conv_i128_cold(x, "integer conversion out of range for u128", loc)
    copy128(r, x)

fn brine_x_conv_u128_from_u128(r: ptr, x: ptr, loc: ptr):
    copy128(r, x)

fn brine_x_fdiv_u128(r: ptr, a: ptr, b: ptr):
    udiv128p(r, a, b, false)

fn brine_x_fmod_u128(r: ptr, a: ptr, b: ptr):
    udiv128p(r, a, b, true)

fn brine_x_div_u128(r: ptr, a: ptr, b: ptr, loc: ptr):
    check(load_u64(b, 0) | load_u64(b, 8) != 0, "division by zero", loc)
    udiv128p(r, a, b, false)

fn brine_x_mod_u128(r: ptr, a: ptr, b: ptr, loc: ptr):
    check(load_u64(b, 0) | load_u64(b, 8) != 0, "remainder by zero", loc)
    udiv128p(r, a, b, true)

fn brine_x_abs_u128(r: ptr, a: ptr, loc: ptr):
    copy128(r, a)

fn brine_x_conv_u128_from_f64(r: ptr, x: float, loc: ptr):
    if not (x >= 0.0 and x < 340282366920938463463374607431768211456.0):
        conv_f_cold(x, "float to integer conversion out of range (or NaN) for u128", loc)
    from_f64_128(r, x)

fn brine_x_u128_add(r: ptr, a: ptr, b: ptr):
    let al = load_u64(a, 0)
    let lo = al + load_u64(b, 0)
    put128(r, lo, load_u64(a, 8) + load_u64(b, 8) + (u64(1) if lo < al else u64(0)))

fn brine_x_u128_sub(r: ptr, a: ptr, b: ptr):
    let al = load_u64(a, 0)
    let bl = load_u64(b, 0)
    put128(r, al - bl, load_u64(a, 8) - load_u64(b, 8) - (u64(1) if al < bl else u64(0)))

fn brine_x_u128_mul(r: ptr, a: ptr, b: ptr):
    mul128(r, a, b)

fn brine_x_u128_div(r: ptr, a: ptr, b: ptr):
    udiv128p(r, a, b, false)

fn brine_x_u128_rem(r: ptr, a: ptr, b: ptr):
    udiv128p(r, a, b, true)

fn brine_x_u128_shl(r: ptr, a: ptr, b: int):
    shl128(r, load_u64(a, 0), load_u64(a, 8), b & 127)

fn brine_x_u128_shr(r: ptr, a: ptr, b: int):
    shr128(r, load_u64(a, 0), load_u64(a, 8), b & 127, false)

fn brine_x_u128_neg(r: ptr, a: ptr):
    neg128(r, a)

fn brine_x_u128_cmp(a: ptr, b: ptr) -> i32:
    let ah = load_u64(a, 8)
    let bh = load_u64(b, 8)
    if ah != bh:
        return -1 if ah < bh else 1
    let al = load_u64(a, 0)
    let bl = load_u64(b, 0)
    if al == bl:
        return 0
    return -1 if al < bl else 1

fn brine_x_u128_from_i64(r: ptr, x: int):
    put128(r, u64(x), u64(x >> 63))

fn brine_x_u128_from_u64(r: ptr, x: u64):
    put128(r, x, 0)

fn brine_x_u128_from_f64(r: ptr, x: float):
    from_f64_128(r, x)

fn brine_x_u128_from_f32(r: ptr, x: f32):
    from_f64_128(r, float(x))

fn brine_x_u128_to_f64(a: ptr) -> float:
    return u128_to_f64(load_u64(a, 0), load_u64(a, 8))

fn brine_x_u128_to_f32(a: ptr) -> f32:
    return u128_to_f32(load_u64(a, 0), load_u64(a, 8))

fn brine_x_neg_i128(r: ptr, a: ptr, loc: ptr):
    check(not is_min128(a), "integer overflow in negation", loc)
    neg128(r, a)

