# ---- __math_xflow, oflow, uflow, divzero, invalid

fn mexp_xflow(sign: u64, y: float) -> float:
    return (-y if sign != 0 else y) * y

fn mexp_oflow(sign: u64) -> float:
    return mexp_xflow(sign, MEXP_P769)

fn mexp_uflow(sign: u64) -> float:
    return mexp_xflow(sign, MEXP_PM767)

fn mexp_divzero(sign: u64) -> float:
    return (-1.0 if sign != 0 else 1.0) / 0.0

fn mexp_invalid(x: float) -> float:
    return (x - x) / (x - x)

# ---- scalbn

fn mexp_scalbn(x: float, mut n: int) -> float:
    var y = x
    if n > 1023:
        y *= MEXP_P1023
        n -= 1023
        if n > 1023:
            y *= MEXP_P1023
            n -= 1023
            if n > 1023:
                n = 1023
    elif n < -1022:
        # make sure final n < -53 to avoid double rounding in the subnormal range
        y *= MEXP_PM969
        n += 1022 - 53
        if n < -1022:
            y *= MEXP_PM969
            n += 1022 - 53
            if n < -1022:
                n = -1022
    return y * float.from_bits(u64(0x3ff + n) << 52)

# ---- exp
# Bit patterns and the top 12 bits of the C code's literals:
# top12(0x1p-54) = 0x3c9, top12(512.0) = 0x408, top12(1024.0) = 0x409,
# top12(INFINITY) = 0x7ff, asuint64(-INFINITY) = 0xfff0000000000000.

# scale*(1+tmp) when it may overflow or underflow; sbits is scale's bits with an
# exponent that may have run into the sign bit, (i32)ki the k of the reduction
fn mexp_exp_specialcase(tmp: float, mut sbits: u64, ki: u64) -> float:
    if ki & 0x80000000 == 0:
        # k > 0, the exponent of scale might have overflowed by <= 460
        sbits = sbits.wrapping_sub(u64(1009) << 52)
        let scale = float.from_bits(sbits)
        return MEXP_P1009 * (scale + scale * tmp)
    # k < 0, need special care in the subnormal range
    sbits = sbits.wrapping_add(u64(1022) << 52)
    let scale = float.from_bits(sbits)
    var y = scale + scale * tmp
    if y < 1.0:
        # round y to the right precision before scaling it into the subnormal
        # range, to avoid double rounding
        var lo = scale - y + scale * tmp
        let hi = 1.0 + y
        lo = 1.0 - hi + y + lo
        y = (hi + lo) - 1.0
        # avoid -0.0 with downward rounding
        if y == 0.0:
            y = 0.0
    return MEXP_PM1022 * y

fn f_exp(x: float) -> float:
    let ix = x.to_bits()
    var abstop = (ix >> 52) & 0x7ff
    if abstop.wrapping_sub(0x3c9) >= 0x408 - 0x3c9:
        if abstop < 0x3c9:
            # avoid spurious underflow for tiny x; 0 is a common input
            return 1.0 + x
        if abstop >= 0x409:
            if ix == 0xfff0000000000000:
                return 0.0
            if abstop >= 0x7ff:
                return 1.0 + x
            if ix >> 63 != 0:
                return mexp_uflow(0)
            return mexp_oflow(0)
        # large x is special cased below
        abstop = 0
    # exp(x) = 2^(k/N) * exp(r), with exp(r) in [2^(-1/2N),2^(1/2N)]
    # x = ln2/N*k + r, with int k and r in [-ln2/2N, ln2/2N]
    let z = MEXP_INVLN2N * x
    # z - kd is in [-1, 1] in non-nearest rounding modes
    var kd = z + MEXP_SHIFT
    let ki = kd.to_bits()
    kd -= MEXP_SHIFT
    let r = x + kd * MEXP_NEGLN2HIN + kd * MEXP_NEGLN2LON
    # 2^(k/N) ~= scale * (1 + tail)
    let idx = (ki & 127) << 1
    let top = ki << 45
    let tail = float.from_bits(MEXP_T[idx])
    # only a valid scale when -1023*N < k < 1024*N
    let sbits = MEXP_T[idx + 1].wrapping_add(top)
    # exp(x) = 2^(k/N) * exp(r) ~= scale + scale * (tail + exp(r) - 1)
    let r2 = r * r
    let tmp = tail + r + r2 * (MEXP_C2 + r * MEXP_C3) + r2 * r2 * (MEXP_C4 + r * MEXP_C5)
    if abstop == 0:
        return mexp_exp_specialcase(tmp, sbits, ki)
    let scale = float.from_bits(sbits)
    return scale + scale * tmp

# ---- exp2

fn mexp_exp2_specialcase(tmp: float, mut sbits: u64, ki: u64) -> float:
    if ki & 0x80000000 == 0:
        # k > 0, the exponent of scale might have overflowed by 1
        sbits = sbits.wrapping_sub(u64(1) << 52)
        let scale = float.from_bits(sbits)
        return 2.0 * (scale + scale * tmp)
    # k < 0, need special care in the subnormal range
    sbits = sbits.wrapping_add(u64(1022) << 52)
    let scale = float.from_bits(sbits)
    var y = scale + scale * tmp
    if y < 1.0:
        var lo = scale - y + scale * tmp
        let hi = 1.0 + y
        lo = 1.0 - hi + y + lo
        y = (hi + lo) - 1.0
        if y == 0.0:
            y = 0.0
    return MEXP_PM1022 * y

# asuint64(-1075.0) = 0xc090cc0000000000, asuint64(928.0) = 0x408d000000000000
fn f_exp2(x: float) -> float:
    let ix = x.to_bits()
    var abstop = (ix >> 52) & 0x7ff
    if abstop.wrapping_sub(0x3c9) >= 0x408 - 0x3c9:
        if abstop < 0x3c9:
            return 1.0 + x
        if abstop >= 0x409:
            if ix == 0xfff0000000000000:
                return 0.0
            if abstop >= 0x7ff:
                return 1.0 + x
            if ix >> 63 == 0:
                return mexp_oflow(0)
            elif ix >= 0xc090cc0000000000:
                return mexp_uflow(0)
        if ix << 1 > u64(0x408d000000000000) << 1:
            # large x is special cased below
            abstop = 0
    # exp2(x) = 2^(k/N) * 2^r, with 2^r in [2^(-1/2N),2^(1/2N)]
    # x = k/N + r, with int k and r in [-1/2N, 1/2N]
    var kd = x + MEXP_EXP2_SHIFT
    let ki = kd.to_bits()
    kd -= MEXP_EXP2_SHIFT
    let r = x - kd
    let idx = (ki & 127) << 1
    let top = ki << 45
    let tail = float.from_bits(MEXP_T[idx])
    let sbits = MEXP_T[idx + 1].wrapping_add(top)
    let r2 = r * r
    let tmp = (
        tail
        + r * MEXP_E2C1
        + r2 * (MEXP_E2C2 + r * MEXP_E2C3)
        + r2 * r2 * (MEXP_E2C4 + r * MEXP_E2C5)
    )
    if abstop == 0:
        return mexp_exp2_specialcase(tmp, sbits, ki)
    let scale = float.from_bits(sbits)
    return scale + scale * tmp

# ---- pow

# exp.c's specialcase, but for a signed result: the sign is in sbits
fn mexp_pow_specialcase(tmp: float, mut sbits: u64, ki: u64) -> float:
    if ki & 0x80000000 == 0:
        # k > 0, the exponent of scale might have overflowed by <= 460
        sbits = sbits.wrapping_sub(u64(1009) << 52)
        let scale = float.from_bits(sbits)
        return MEXP_P1009 * (scale + scale * tmp)
    # k < 0, need special care in the subnormal range
    sbits = sbits.wrapping_add(u64(1022) << 52)
    # sbits is signed scale
    let scale = float.from_bits(sbits)
    var y = scale + scale * tmp
    if f_fabs(y) < 1.0:
        var one = 1.0
        if y < 0.0:
            one = -1.0
        var lo = scale - y + scale * tmp
        let hi = one + y
        lo = one - hi + y + lo
        y = (hi + lo) - one
        # fix the sign of 0
        if y == 0.0:
            y = float.from_bits(sbits & 0x8000000000000000)
    return MEXP_PM1022 * y

# 0 if iy is not an integer, 1 if an odd one, 2 if an even one; iy is the bits
# of a non-zero finite float
fn mexp_checkint(iy: u64) -> int:
    let e = (iy >> 52) & 0x7ff
    if e < 0x3ff:
        return 0
    if e > 0x3ff + 52:
        return 2
    let s = u64(0x3ff + 52) - e
    if iy & ((u64(1) << s) - 1) != 0:
        return 0
    if iy & (u64(1) << s) != 0:
        return 1
    return 2

# whether i is the bits of 0, an infinity or a NaN
# (2 * asuint64(INFINITY) = 0xffe0000000000000)
fn mexp_zeroinfnan(i: u64) -> bool:
    return (i << 1).wrapping_sub(1) >= u64(0xffe0000000000000) - 1

# asuint64(1.0) = 0x3ff0000000000000
fn f_pow(x: float, y: float) -> float:
    var sign_bias = u64(0)
    var ix = x.to_bits()
    let iy = y.to_bits()
    var topx = ix >> 52
    let topy = iy >> 52
    if (
        topx.wrapping_sub(0x001) >= 0x7ff - 0x001
        or (topy & 0x7ff).wrapping_sub(0x3be) >= 0x43e - 0x3be
    ):
        # if |y| > 1075 * ln2 * 2^53 ~= 0x1.749p62 then pow(x,y) = inf/0 and
        # if |y| < 2^-54 / 1075 ~= 0x1.e7b6p-65 then pow(x,y) = +-1.
        # special cases: (x < 0x1p-126 or inf or nan) or
        # (|y| < 0x1p-65 or |y| >= 0x1p63 or nan)
        if mexp_zeroinfnan(iy):
            if iy << 1 == 0:
                return 1.0
            if ix == 0x3ff0000000000000:
                return 1.0
            if ix << 1 > 0xffe0000000000000 or iy << 1 > 0xffe0000000000000:
                return x + y
            if ix << 1 == 0x7fe0000000000000:
                return 1.0
            if (ix << 1 < 0x7fe0000000000000) == (iy >> 63 == 0):
                # |x|<1 && y==inf or |x|>1 && y==-inf
                return 0.0
            return y * y
        if mexp_zeroinfnan(ix):
            var x2 = x * x
            if ix >> 63 != 0 and mexp_checkint(iy) == 1:
                x2 = -x2
            return 1.0 / x2 if iy >> 63 != 0 else x2
        # here x and y are non-zero finite
        if ix >> 63 != 0:
            # finite x < 0
            let yint = mexp_checkint(iy)
            if yint == 0:
                return mexp_invalid(x)
            if yint == 1:
                sign_bias = 0x40000
            ix &= 0x7fffffffffffffff
            topx &= 0x7ff
        if (topy & 0x7ff).wrapping_sub(0x3be) >= 0x43e - 0x3be:
            # sign_bias == 0 here because y is not odd
            if ix == 0x3ff0000000000000:
                return 1.0
            if (topy & 0x7ff) < 0x3be:
                # |y| < 2^-65, x^y ~= 1 + y*log(x)
                return 1.0 + y if ix > 0x3ff0000000000000 else 1.0 - y
            if (ix > 0x3ff0000000000000) == (topy < 0x800):
                return mexp_oflow(0)
            return mexp_uflow(0)
        if topx == 0:
            # normalize subnormal x so the exponent becomes negative
            ix = (x * MEXP_P52).to_bits()
            ix &= 0x7fffffffffffffff
            ix = ix.wrapping_sub(u64(52) << 52)
    # log_inline (static inline in C, inlined by hand: as a function returning
    # a tuple it made pow 1.4x slower on the native backend).
    # hi + lo = log(x), lo with about 15 more bits. ix is x's bits, normalized
    # in the subnormal range using the sign bit for the exponent.
    # x = 2^k z, z in [OFF, 2*OFF) and exact, OFF = 0x3fe6955500000000; the
    # range is split into N subintervals, the ith contains z and c is near its center
    let ltmp = ix.wrapping_sub(0x3fe6955500000000)
    let i = (ltmp >> 45) & 127
    let iz = ix.wrapping_sub(ltmp & (u64(0xfff) << 52))
    let z = float.from_bits(iz)
    # kd = (double)((int64_t)tmp >> 52): the top 12 bits, sign-extended; exact,
    # and with no int conversion, which would cost a check
    let kd = float(int(ltmp) >> 52)
    # log(x) = k*Ln2 + log(c) + log1p(z/c-1)
    let invc = float.from_bits(MEXP_PT_INVC[i])
    let logc = float.from_bits(MEXP_PT_LOGC[i])
    let logctail = float.from_bits(MEXP_PT_LOGCTAIL[i])
    # split z such that rhi, rlo and rhi*rhi are exact and |rlo| <= |r|
    let zhi = float.from_bits((iz + (u64(1) << 31)) & 0xffffffff00000000)
    let zlo = z - zhi
    let rhi = zhi * invc - 1.0
    let rlo = zlo * invc
    let r = rhi + rlo
    # k*Ln2 + log(c) + r
    let t1 = kd * MEXP_LN2HI + logc
    let t2 = t1 + r
    let lo1 = kd * MEXP_LN2LO + logctail
    let lo2 = t1 - t2 + r
    let ar = MEXP_A0 * r
    let ar2 = r * ar
    let ar3 = r * ar2
    # k*Ln2 + log(c) + r + A[0]*r*r
    let arhi = MEXP_A0 * rhi
    let arhi2 = rhi * arhi
    let lhi0 = t2 + arhi2
    let lo3 = rlo * (ar + arhi)
    let lo4 = t2 - lhi0 + arhi2
    # p = log1p(r) - r - A[0]*r*r
    let p = ar3 * (
        MEXP_A1 + r * MEXP_A2 + ar2 * (MEXP_A3 + r * MEXP_A4 + ar2 * (MEXP_A5 + r * MEXP_A6))
    )
    let llo0 = lo1 + lo2 + lo3 + lo4 + p
    let hi = lhi0 + llo0
    let lo = lhi0 - hi + llo0
    # back in pow
    let yhi = float.from_bits(iy & 0xfffffffff8000000)
    let ylo = y - yhi
    let lhi = float.from_bits(hi.to_bits() & 0xfffffffff8000000)
    let llo = hi - lhi + lo
    let ehi = yhi * lhi
    # |elo| < |ehi| * 2^-25
    let elo = ylo * lhi + y * llo
    # exp_inline(ehi, elo, sign_bias), inlined by hand too: sign * exp(ehi + elo)
    # with |elo| < 2^-8/N and |elo| <= |ehi|; sign_bias is SIGN_BIAS
    # (0x800 << 7 = 0x40000) or 0 and makes the sign -1 or 1
    let eix = ehi.to_bits()
    var abstop = (eix >> 52) & 0x7ff
    if abstop.wrapping_sub(0x3c9) >= 0x408 - 0x3c9:
        if abstop < 0x3c9:
            # avoid spurious underflow for tiny x; 0 is a common input
            let one = 1.0 + ehi
            return -one if sign_bias != 0 else one
        if abstop >= 0x409:
            # inf and nan are already handled
            if eix >> 63 != 0:
                return mexp_uflow(sign_bias)
            return mexp_oflow(sign_bias)
        # large x is special cased below
        abstop = 0
    # exp(x) = 2^(k/N) * exp(r), with exp(r) in [2^(-1/2N),2^(1/2N)]
    # x = ln2/N*k + r, with int k and r in [-ln2/2N, ln2/2N]
    let ez = MEXP_INVLN2N * ehi
    var ekd = ez + MEXP_SHIFT
    let ki = ekd.to_bits()
    ekd -= MEXP_SHIFT
    var er = ehi + ekd * MEXP_NEGLN2HIN + ekd * MEXP_NEGLN2LON
    # the code assumes 2^-200 < |xtail| < 2^-8/N
    er += elo
    # 2^(k/N) ~= scale * (1 + tail)
    let idx = (ki & 127) << 1
    let top = (ki + sign_bias) << 45
    let tail = float.from_bits(MEXP_T[idx])
    # only a valid scale when -1023*N < k < 1024*N
    let sbits = MEXP_T[idx + 1].wrapping_add(top)
    # exp(x) = 2^(k/N) * exp(r) ~= scale + scale * (tail + exp(r) - 1)
    let er2 = er * er
    let tmp = tail + er + er2 * (MEXP_C2 + er * MEXP_C3) + er2 * er2 * (MEXP_C4 + er * MEXP_C5)
    if abstop == 0:
        return mexp_pow_specialcase(tmp, sbits, ki)
    let scale = float.from_bits(sbits)
    return scale + scale * tmp

const MLOG_OFF: u64 = 0x3fe6000000000000
const MLOG_ONE: u64 = 0x3ff0000000000000
const MLOG_INF: u64 = 0x7ff0000000000000
const MLOG_TOPMASK: u64 = 0xfff0000000000000
const MLOG_HIMASK: u64 = 0xffffffff00000000
const MLOG_LN2HI: float = 0.6931471805598903
const MLOG_LN2LO: float = 5.497923018708371e-14
const MLOG_B0: float = -0.5
const MLOG_B1: float = 0.3333333333333352
const MLOG_B2: float = -0.24999999999998432
const MLOG_B3: float = 0.19999999999320328
const MLOG_B4: float = -0.16666666669929706
const MLOG_B5: float = 0.14285715076560868
const MLOG_B6: float = -0.12499997863982555
