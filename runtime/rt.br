    let bh = load_u64(b, 8)
    let lo = al + load_u64(b, 0)
    let hi = ah + bh + (u64(1) if lo < al else u64(0))
    check(int((ah ^ hi) & (bh ^ hi)) >= 0, "integer overflow in addition", loc)
    put128(r, lo, hi)

fn brine_x_sub_i128(r: ptr, a: ptr, b: ptr, loc: ptr):
    let al = load_u64(a, 0)
    let ah = load_u64(a, 8)
    let bl = load_u64(b, 0)
    let bh = load_u64(b, 8)
    let hi = ah - bh - (u64(1) if al < bl else u64(0))
    check(int((ah ^ bh) & (ah ^ hi)) >= 0, "integer overflow in subtraction", loc)
    put128(r, al - bl, hi)

