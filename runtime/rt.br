# The runtime, in brine, for native code; what isn't here yet is still C
# (brine_rt.c). A function `f` here is used in place of the C runtime's
# `brine_f` (brine_rt.h has the same functions, with the same parameters
# and results) and native code inlines it. A function named `brine_f`
# replaces the C one outright: it is the program's `brine_f`, which the C
# runtime calls too, so brine_rt.c leaves its own out (BRINE_RT_BR). One
# whose name ends in `_cold` is a slow path, never inlined.
#
# This module alone has `ptr`, a raw address, with `p + n` and `p - n`, and
# the memory operations `load_<t>(p, off)` and `store_<t>(p, off, v)` (t is
# i8 to i64, u8 to u64, f32, f64, bool or ptr), `call_<t>(f, ...)` (a call
# of the C function at f; `call_void` has no result), `str_retain(p)` and
# `str_release(p)` (also arr_ and map_), `str_of(p)` and `ptr_of(s)` (a
# string's block as a `str` and back, borrowed), `stack_mem(n)` (n bytes of
# the frame), `bswap(x)`, `umulh(a, b)` (the high half of a * b),
# `thread_ptr()`, `addr(p)` (p as a number), `symbol("name")` (a C
# symbol's address) and `null_ptr()`. Its arithmetic wraps, and the prover
# doesn't look at it. Code here can't use what lowers to the function it is
# in (`a + b` on strings in brine_str_concat).

# brine_str: a reference count (negative: immortal), the length, then the
# bytes and a NUL. Every string can be read to the end of the 8-byte word
# that holds its NUL, so short ones are handled a word at a time.
const STR_RC = 0
const STR_LEN = 8
const STR_DATA = 16

# brine_map
const MAP_RC = 0
const MAP_LEN = 8
const MAP_NIDX = 32
const MAP_KEYS = 48
const MAP_VALS = 56
const MAP_HASHES = 64
const MAP_INDEX = 80

# brine_app, the appender of a loop doing `s += t[i]`
const APP_DATA = 0
const APP_LEN = 8
const APP_ROOM = 16
const APP_LIM = 24
const APP_W0 = 32

# brine_heap_info (brine_rt.c): where a thread's heap is, the heap's range,
# each chunk's size class, whether allocation may skip C, and how many free
# blocks of each class a thread keeps
const HI_OFF = 0
const HI_IND = 8
const HI_BASE = 16
const HI_END = 24
const HI_CLASSES = 32
const HI_FAST = 40
const HI_KEEP = 48

# br_heap_th: a free list and a count of free blocks per size class
const TH_HEAD = 0
const TH_COUNT = 96

const SMALL = 256

const ONES: u64 = 0xffffffffffffffff

extern fn brine_x_str_reset(ps: ptr, lit: ptr)

extern fn brine_x_str_add_byte(ps: ptr, c: u8)

extern fn brine_x_str_add(ps: ptr, b: ptr)

extern fn brine_x_str_at(s: ptr, i: int, loc: ptr) -> ptr

extern fn brine_x_str_room(n: int) -> int

extern fn brine_x_app_byte(ps: ptr, ap: ptr, c: u8)

extern fn brine_box_new(size: int, tag: int) -> ptr

extern fn brine_box_free(p: ptr)

# the low n bytes of a word, 0 <= n <= 8
fn lowmask(n: u64) -> u64:
    if n >= 8:
        return ONES
    return ~(ONES << (n * 8))

# The longest string the block of a string of length n holds (brine_str_room).
fn str_room(n: int) -> int:
    if n > 47:
        return brine_x_str_room(n)
    return ((n + 32) & ~15) - 17

fn str_eq(a: ptr, b: ptr) -> bool:
    if a == b:
        return true
    let n = load_u64(a, STR_LEN)
    if n != load_u64(b, STR_LEN):
        return false
    if n <= 8:
        return ((load_u64(a, STR_DATA) ^ load_u64(b, STR_DATA)) & lowmask(n)) == 0
    return brine_str_eq_long(a, b)

# The hashes of generated hash functions (splitmix64's finalizer)
fn hash_u64(x0: u64) -> u64:
    var x = x0
    x ^= x >> 30
    x *= 0xbf58476d1ce4e5b9
    x ^= x >> 27
    x *= 0x94d049bb133111eb
    x ^= x >> 31
    return x

fn hash_mix(h: u64, x: u64) -> u64:
    return hash_u64(h ^ (x + 0x9e3779b97f4a7c15 + (h << 6) + (h >> 2)))

# A string of up to 7 bytes hashes to its bytes and length, mixed one to
# one, so equal hashes mean equal strings (brine_hash_str).
fn hash_str(s: ptr) -> u64:
    let n = load_u64(s, STR_LEN)
    if n < 8:
        let w = (load_u64(s, STR_DATA) & lowmask(n)) | n << 56
        return bswap(w * 0x9e3779b97f4a7c15)
    return brine_hash_long(s + STR_DATA, n)

# The entry of key k (hash h) in map m, or -1. keq compares two keys of ksz
# bytes; `exact`: equal hashes are equal keys.
fn map_probe(m: ptr, k: ptr, h: u64, keq: ptr, ksz: int, exact: bool) -> int:
    if load_i64(m, MAP_LEN) == 0:
        return -1
    let mask = load_u64(m, MAP_NIDX) - 1
    let ix = load_ptr(m, MAP_INDEX)
    let hs = load_ptr(m, MAP_HASHES)
    var i = h & mask
    while true:
        let e = load_i64(ix, i * 8)
        if e == -1:
            return -1
        if e >= 0 and load_u64(hs, e * 8) == h:
            if exact or call_bool(keq, load_ptr(m, MAP_KEYS) + e * ksz, k):
                return e
        i = (i + 1) & mask
    return -1

# The value of entry e (from map_probe; -1 panics for the missing key k).
fn map_val(m: ptr, e: int, k: ptr, vsz: int, loc: ptr) -> ptr:
    if e < 0:
        return brine_map_at(m, k, loc)
    return load_ptr(m, MAP_VALS) + e * vsz

# Same, after making the map unique so the value can be changed.
fn map_val_mut(pm: ptr, e: int, k: ptr, vsz: int, loc: ptr) -> ptr:
    let m = load_ptr(pm, 0)
    if e >= 0 and load_i64(m, MAP_RC) == 1:
        return load_ptr(m, MAP_VALS) + e * vsz
    return brine_map_val_mut_slow(pm, e, k, loc)

# `var s = lit` run again: keeps s's block when nothing else holds it. A
# block always has room for 15 bytes, so a short literal is one word store.
fn str_reset(ps: ptr, lit: ptr):
    let a = load_ptr(ps, 0)
    let n = load_u64(lit, STR_LEN)
    if n < 8 and load_i64(a, STR_RC) == 1:
        store_u64(a, STR_DATA, load_u64(lit, STR_DATA) & lowmask(n))
        store_u64(a, STR_LEN, n)
        return
    brine_x_str_reset(ps, lit)

# `s[i]` (i in bounds): the byte as a one-character string, from the table
# of immortal ones (brine_bytes: brine_str1, 24 bytes each)
fn str_byte(s: ptr, i: int) -> ptr:
    return symbol("brine_bytes") + int(load_u8(s, STR_DATA + i)) * 24

fn str_at(s: ptr, i: int, loc: ptr) -> ptr:
    if u64(i) >= load_u64(s, STR_LEN):
        return brine_x_str_at(s, i, loc)
    return str_byte(s, i)

# `s += t`, in place when s is unshared, t is at most a word and the word
# written at s's end and the NUL after t fit in its room
# (the word's bytes past t are 0: the NUL when t is shorter).
fn str_add(ps: ptr, b: ptr):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    let lb = load_i64(b, STR_LEN)
    if lb <= 8 and load_i64(a, STR_RC) == 1 and la + 8 <= str_room(la):
        store_u64(a, STR_DATA + la, load_u64(b, STR_DATA) & lowmask(u64(lb)))
        if lb == 8:
            store_u8(a, STR_DATA + la + 8, 0)
        store_i64(a, STR_LEN, la + lb)
        return
    brine_x_str_add(ps, b)

# `s += t[i]`: one byte, in place when s is unshared and has room. Within
# the first word the whole word is rewritten, so a later word load forwards
# from one store.
fn str_add_byte(ps: ptr, c: u8):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    if la < 8 and load_i64(a, STR_RC) == 1:
        let sh = la * 8
        let w = load_u64(a, STR_DATA) & ~(ONES << sh)
        store_u64(a, STR_DATA, w | u64(c) << sh)
        if la == 7:
            store_u8(a, STR_DATA + 8, 0)
        store_i64(a, STR_LEN, la + 1)
        return
    brine_x_str_add_byte(ps, c)

# The appender (brine_app_open): the length and the first word in it, the
# bytes after those straight into s's block while it is unshared and has
# room. (Nothing is passed ap, so its fields can stay in registers.)
fn app_open(ps: ptr, ap: ptr):
    let a = load_ptr(ps, 0)
    let n = load_i64(a, STR_LEN)
    var room = -1
    if load_i64(a, STR_RC) == 1:
        room = str_room(n)
    store_ptr(ap, APP_DATA, a + STR_DATA)
    store_i64(ap, APP_LEN, n)
    store_i64(ap, APP_ROOM, room)
    store_i64(ap, APP_LIM, room if room < 8 else 8)
    store_u64(ap, APP_W0, load_u64(a, STR_DATA) & lowmask(load_u64(a, STR_LEN)))

fn app_byte(ps: ptr, ap: ptr, c: u8):
    let n = load_i64(ap, APP_LEN)
    if n < load_i64(ap, APP_LIM):
        store_u64(ap, APP_W0, load_u64(ap, APP_W0) | u64(c) << (n * 8))
        store_i64(ap, APP_LEN, n + 1)
        return
    if n > 8 and n < load_i64(ap, APP_ROOM):
        store_u8(load_ptr(ap, APP_DATA), n, c)
        store_i64(ap, APP_LEN, n + 1)
        return
    brine_x_app_byte(ps, ap, c)

fn app_close(ps: ptr, ap: ptr):
    let a = load_ptr(ps, 0)
    let n = load_i64(ap, APP_LEN)
    if load_i64(a, STR_LEN) == n:
        return
    store_i64(a, STR_LEN, n)
    # the bytes past n in w0 are 0: the NUL
    let d = load_ptr(ap, APP_DATA)
    if n <= 8:
        store_u64(d, 0, load_u64(ap, APP_W0))
    if n >= 8:
        store_u8(d, n, 0)

# This thread's heap (br_th_peek), at address 0 when there is none yet.
fn th_heap(hi: ptr) -> ptr:
    let at = thread_ptr() + load_i64(hi, HI_OFF)
    if load_i64(hi, HI_IND) != 0:
        return load_ptr(at, 0)
    return at

# The size class of a block of n bytes, 1 <= n <= 256 (br_class_of), and
# the size of its blocks.
fn size_class(n: int) -> int:
    if n <= 128:
        return ((n + 15) >> 4) - 1
    return ((n - 129) >> 5) + 8

fn class_size(c: int) -> int:
    if c < 8:
        return (c + 1) * 16
    return 128 + (c - 7) * 32

extern fn brine_alloc(n: int) -> ptr

extern fn brine_free(p: ptr)

# n bytes of brine_alloc's, counted for BRINE_LEAKCHECK (strings, arrays)
extern fn brine_x_counted(n: int) -> ptr

# A block of n bytes (1 <= n <= SMALL) off the thread's free list, or 0
# when C must make it: the list is empty, or BRINE_LEAKCHECK counts blocks.
fn pop_free(n: int) -> ptr:
    let hi = symbol("brine_heap_info")
    if load_i64(hi, HI_FAST) != 0:
        let h = th_heap(hi)
        if addr(h) != 0:
            let c = size_class(n)
            let p = load_ptr(h, TH_HEAD + c * 8)
            if addr(p) != 0:
                store_ptr(h, TH_HEAD + c * 8, load_ptr(p, 0))
                let k = load_i64(h, TH_COUNT + c * 8)
                if k > 0:
                    store_i64(h, TH_COUNT + c * 8, k - 1)
                return p
    return null_ptr()

# Block p back on the thread's free list; false when C must take it (not
# our heap's, or the list holds enough: C hands some to other threads).
fn push_free(p: ptr) -> bool:
    let hi = symbol("brine_heap_info")
    let base = load_u64(hi, HI_BASE)
    let off = addr(p) - base
    if load_i64(hi, HI_FAST) != 0 and off < load_u64(hi, HI_END) - base:
        let h = th_heap(hi)
        if addr(h) != 0:
            let c = int(load_u8(load_ptr(hi, HI_CLASSES), off >> 16))
            let n = load_i64(h, TH_COUNT + c * 8) + 1
            if n <= load_i64(hi, HI_KEEP + c * 8):
                store_ptr(p, 0, load_ptr(h, TH_HEAD + c * 8))
                store_ptr(h, TH_HEAD + c * 8, p)
                store_i64(h, TH_COUNT + c * 8, n)
                return true
    return false

# brine_alloc's n bytes (n >= 1), and their freeing
fn blk_alloc(n: int) -> ptr:
    if n > 0 and n <= SMALL:
        let p = pop_free(n)
        if addr(p) != 0:
            return p
    return brine_alloc(n)

fn blk_free(p: ptr):
    if not push_free(p):
        brine_free(p)

# A block BRINE_LEAKCHECK counts (strings, arrays, boxes); the free list is
# only used when it is off.
fn new_counted(n: int) -> ptr:
    if n > 0 and n <= SMALL:
        let p = pop_free(n)
        if addr(p) != 0:
            return p
    return brine_x_counted(n)

fn free_counted(p: ptr):
    if not push_free(p):
        brine_box_free(p)

fn box_new(size: int, tag: int) -> ptr:
    if size > 0 and size <= SMALL:
        let p = pop_free(size)
        if addr(p) != 0:
            store_i64(p, 0, 1)
            store_i64(p, 8, tag)
            return p
    return brine_box_new(size, tag)

fn box_free(p: ptr):
    free_counted(p)

# ------------------------------------------------------------ strings
# What C still does for them (brine_rt.c), and the C library.

extern fn memcpy(d: ptr, s: ptr, n: u64) -> ptr

extern fn memcmp(a: ptr, b: ptr, n: u64) -> i32

# a block for a string of n bytes: count 1, length n, the NUL (br_str_alloc)
extern fn brine_x_str_alloc(n: int) -> ptr

# The bytes a string of length n takes (brine_str_size): rounded up by at
# most a quarter, so `+=` can usually grow it in place.
fn str_block(n: int) -> int:
    let t = 17 + n
    if t <= 64:
        return (t + 15) & ~15
    let g = 1 << (61 - u64(t).leading_zeros())
    return (t + g - 1) & ~(g - 1)

# A string of n bytes with count 1 and its NUL; the bytes are not set.
fn new_str(n: int) -> ptr:
    let t = str_block(n)
    if t <= SMALL:
        let s = pop_free(t)
        if addr(s) != 0:
            store_i64(s, STR_RC, 1)
            store_i64(s, STR_LEN, n)
            store_u8(s, STR_DATA + n, 0)
            return s
    return brine_x_str_alloc(n)

fn brine_str_free(s: ptr):
    free_counted(s)

# s's block made big enough for a string of n bytes; it may move
extern fn brine_x_str_grow(s: ptr, n: int) -> ptr

extern fn brine_panic_at(loc: ptr, msg: str)

# n bytes from s to d (apart, or the same bytes); a short copy is a few
# loads and stores that overlap rather than a call
fn copy_bytes(d: ptr, s: ptr, n: int):
    if n >= 8:
        if n > 32:
            memcpy(d, s, u64(n))
        elif n > 16:
            let a = load_u64(s, 0)
            let b = load_u64(s, 8)
            let c = load_u64(s, n - 16)
            let e = load_u64(s, n - 8)
            store_u64(d, 0, a)
            store_u64(d, 8, b)
            store_u64(d, n - 16, c)
            store_u64(d, n - 8, e)
        else:
            let a = load_u64(s, 0)
            let b = load_u64(s, n - 8)
            store_u64(d, 0, a)
            store_u64(d, n - 8, b)
    elif n >= 4:
        let a = load_u32(s, 0)
        let b = load_u32(s, n - 4)
        store_u32(d, 0, a)
        store_u32(d, n - 4, b)
    elif n > 0:
        let a = load_u8(s, 0)
        let b = load_u8(s, n >> 1)
        let c = load_u8(s, n - 1)
        store_u8(d, 0, a)
        store_u8(d, n >> 1, b)
        store_u8(d, n - 1, c)

# the one-character string of byte c (brine_bytes: brine_str1, 24 bytes each)
fn byte_str(c: u8) -> ptr:
    return symbol("brine_bytes") + int(c) * 24

fn brine_str_new(p: ptr, n: int) -> ptr:
    let s = new_str(n)
    copy_bytes(s + STR_DATA, p, n)
    return s

fn brine_str_concat(a: ptr, b: ptr) -> ptr:
    let la = load_i64(a, STR_LEN)
    let lb = load_i64(b, STR_LEN)
    let s = new_str(la + lb)
    copy_bytes(s + STR_DATA, a + STR_DATA, la)
    copy_bytes(s + STR_DATA + la, b + STR_DATA, lb)
    return s

# `s += b`: grows s in place when nothing else holds it
fn brine_str_append(ps: ptr, b: ptr):
    let a = load_ptr(ps, 0)
    let lb = load_i64(b, STR_LEN)
    if lb == 0:
        return
    if load_i64(a, STR_RC) != 1:
        store_ptr(ps, 0, brine_str_concat(a, b))
        str_release(a)
        return
    let la = load_i64(a, STR_LEN)
    let n = la + lb
    let own = a == b
    let s = brine_x_str_grow(a, n)
    copy_bytes(s + STR_DATA + la, (s if own else b) + STR_DATA, lb)
    store_i64(s, STR_LEN, n)
    store_u8(s, STR_DATA + n, 0)
    store_ptr(ps, 0, s)

# brine_str_add_byte when s is shared or full: the usual case is the first
# `+=` to a literal (`var w = ""`), which gets a block of its own
fn brine_str_add_byte_slow(ps: ptr, c: u8):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    if load_i64(a, STR_RC) == 1:
        # grows the block
        brine_str_append(ps, byte_str(c))
        return
    let s = new_str(la + 1)
    if la < 8:
        let w = load_u64(a, STR_DATA) & lowmask(u64(la))
        store_u64(s, STR_DATA, w | u64(c) << u64(8 * la))
        store_u8(s, STR_DATA + 8, 0)
    else:
        copy_bytes(s + STR_DATA, a + STR_DATA, la)
        store_u8(s, STR_DATA + la, c)
    str_release(a)
    store_ptr(ps, 0, s)

fn brine_str_eq_long(a: ptr, b: ptr) -> bool:
    return memcmp(a + STR_DATA, b + STR_DATA, load_u64(a, STR_LEN)) == 0

fn brine_str_contains(s: ptr, sub: ptr) -> bool:
    return find_from(s, sub, 0) >= 0

# The first i >= from where sub is in s, or -1 (an empty sub is at from).
fn find_from(s: ptr, sub: ptr, from: int) -> int:
    let n = load_i64(sub, STR_LEN)
    let d = s + STR_DATA
    let last = load_i64(s, STR_LEN) - n
    if n == 0:
        return from if from <= last else -1
    let first = load_u8(sub, STR_DATA)
    var i = from
    while i <= last:
        if load_u8(d, i) == first and memcmp(d + i, sub + STR_DATA, u64(n)) == 0:
            return i
        i += 1
    return -1

# s[lo:hi] (in bounds, whole characters)
fn sub_str(s: ptr, lo: int, hi: int) -> ptr:
    if lo == 0 and hi == load_i64(s, STR_LEN):
        str_retain(s)
        return s
    if hi - lo == 1:
        return byte_str(load_u8(s, STR_DATA + lo))
    return brine_str_new(s + STR_DATA + lo, hi - lo)

# The length of the UTF-8 character at p (1 for an invalid byte).
fn utf8_len(p: ptr, avail: int) -> int:
    let b = load_u8(p, 0)
    var n = 1
    if b >= 0x80:
        if b >> 5 == 6:
            n = 2
        elif b >> 4 == 14:
            n = 3
        elif b >> 3 == 30:
            n = 4
    if n > avail:
        return 1
    for i in 1..n:
        if load_u8(p, i) & 0xc0 != 0x80:
            return 1
    return n

# Is byte i of s inside a character, not at its start?
fn mid_char(s: ptr, i: int) -> bool:
    return i > 0 and i < load_i64(s, STR_LEN) and load_u8(s, STR_DATA + i) & 0xc0 == 0x80

fn slice_splits(s: ptr, lo: int, hi: int, loc: ptr):
    let b = lo if mid_char(s, lo) else hi
    var a = b
    while a > 0 and b - a < 3 and mid_char(s, a):
        a -= 1
    let n = utf8_len(s + STR_DATA + a, load_i64(s, STR_LEN) - a)
    if a + n <= b:
        brine_panic_at(loc, f"slice [{lo}:{hi}] starts or ends inside a character (byte {b})")
    let c = brine_str_new(s + STR_DATA + a, n)
    brine_panic_at(
        loc,
        f"slice [{lo}:{hi}] splits the character \"{str_of(c)}\" (bytes {a}..{a + n})"
    )

# Strings are UTF-8, so a slice must not cut a character in two.
fn brine_str_slice(s: ptr, lo: int, hi: int, loc: ptr) -> ptr:
    let n = load_i64(s, STR_LEN)
    if lo < 0 or lo > hi or hi > n:
        brine_panic_at(loc, f"slice [{lo}:{hi}] is out of bounds for a string of length {n}")
    if mid_char(s, lo) or mid_char(s, hi):
        slice_splits(s, lo, hi, loc)
    return sub_str(s, lo, hi)

fn brine_ord(s: ptr, loc: ptr) -> int:
    let len = load_i64(s, STR_LEN)
    let p = s + STR_DATA
    let n = utf8_len(p, len) if len != 0 else 0
    if n == 0 or n != len:
        brine_panic_at(loc, f"ord() needs exactly one character, got a string of length {len}")
    if n == 1:
        return int(load_u8(p, 0))
    var c = int(load_u8(p, 0)) & (0x7f >> n)
    for i in 1..n:
        c = (c << 6) | (int(load_u8(p, i)) & 0x3f)
    return c

fn brine_chr(c: int, loc: ptr) -> ptr:
    if c < 0 or c > 0x10ffff or (c >= 0xd800 and c <= 0xdfff):
        brine_panic_at(loc, f"chr({c}) is not a valid character")
    if c < 0x80:
        return byte_str(u8(c))
    let b = stack_mem(8)
    var n = 4
    if c < 0x800:
        store_u8(b, 0, u8(0xc0 | (c >> 6)))
        store_u8(b, 1, u8(0x80 | (c & 0x3f)))
        n = 2
    elif c < 0x10000:
        store_u8(b, 0, u8(0xe0 | (c >> 12)))
        store_u8(b, 1, u8(0x80 | ((c >> 6) & 0x3f)))
        store_u8(b, 2, u8(0x80 | (c & 0x3f)))
        n = 3
    else:
        store_u8(b, 0, u8(0xf0 | (c >> 18)))
        store_u8(b, 1, u8(0x80 | ((c >> 12) & 0x3f)))
        store_u8(b, 2, u8(0x80 | ((c >> 6) & 0x3f)))
        store_u8(b, 3, u8(0x80 | (c & 0x3f)))
    return brine_str_new(b, n)

fn brine_s_find(s: ptr, sub: ptr, loc: ptr) -> int:
    return find_from(s, sub, 0)

fn brine_s_find_from(s: ptr, sub: ptr, start: int, loc: ptr) -> int:
    let n = load_i64(s, STR_LEN)
    if start < 0 or start > n:
        brine_panic_at(loc, f"find() start {start} is out of range for a string of {n} bytes")
    return find_from(s, sub, start)

fn brine_start_chk(start: int, len: int, loc: ptr) -> int:
    if start < 0 or start > len:
        brine_panic_at(loc, f"index() start {start} is out of range for an array of length {len}")
    return start

fn push_str(pa: ptr, s: ptr):
    let slot = stack_mem(8)
    store_ptr(slot, 0, s)
    brine_arr_push(pa, slot)

fn brine_s_split(s: ptr, sep: ptr, loc: ptr) -> ptr:
    let ns = load_i64(sep, STR_LEN)
    if ns == 0:
        brine_panic_at(loc, "split() separator is empty")
    let pa = stack_mem(8)
    let none = ptr_of("") + STR_DATA
    store_ptr(pa, 0, brine_arr_new(0, 8, symbol("brine_rt_str"), symbol("brine_rl_str"), none))
    var at = 0
    while true:
        let i = find_from(s, sep, at)
        if i < 0:
            break
        push_str(pa, sub_str(s, at, i))
        at = i + ns
    push_str(pa, sub_str(s, at, load_i64(s, STR_LEN)))
    return load_ptr(pa, 0)

# ------------------------------------------------------------ string builder
# brine_sb: the bytes (a block of brine_alloc's), the length, the room

const SB_P = 0
const SB_LEN = 8
const SB_CAP = 16

extern fn memmove(d: ptr, s: ptr, n: u64) -> ptr

extern fn memset(d: ptr, c: i32, n: u64) -> ptr

# p's block (from brine_alloc) made n bytes; it may move
extern fn brine_x_realloc(p: ptr, n: int) -> ptr

# pairs of decimal digits, 00 to 99
const DIGITS = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

const HEX = "0123456789abcdef"

fn brine_sb_init(sb: ptr):
    store_i64(sb, SB_CAP, 64)
    store_i64(sb, SB_LEN, 0)
    store_ptr(sb, SB_P, blk_alloc(64))

# Room for `extra` more bytes; the address they go at.
fn sb_room(sb: ptr, extra: int) -> ptr:
    let len = load_i64(sb, SB_LEN)
    let cap = load_i64(sb, SB_CAP)
    if len + extra > cap:
        var nc = cap * 2
        while nc < len + extra:
            nc *= 2
        store_ptr(sb, SB_P, brine_x_realloc(load_ptr(sb, SB_P), nc))
        store_i64(sb, SB_CAP, nc)
    return load_ptr(sb, SB_P) + len

fn brine_sb_cat(sb: ptr, p: ptr, n: int):
    copy_bytes(sb_room(sb, n), p, n)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n)

fn sb_byte(sb: ptr, c: u8):
    store_u8(sb_room(sb, 1), 0, c)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + 1)

fn sb_lit(sb: ptr, s: str):
    let p = ptr_of(s)
    brine_sb_cat(sb, p + STR_DATA, load_i64(p, STR_LEN))

fn brine_sb_str(sb: ptr, s: ptr):
    brine_sb_cat(sb, s + STR_DATA, load_i64(s, STR_LEN))

fn brine_sb_repr_str(sb: ptr, s: ptr):
    sb_byte(sb, 34)
    let n = load_i64(s, STR_LEN)
    for i in 0..n:
        let c = load_u8(s, STR_DATA + i)
        if c == 34:
            sb_lit(sb, "\\\"")
        elif c == 92:
            sb_lit(sb, "\\\\")
        elif c == 10:
            sb_lit(sb, "\\n")
        elif c == 9:
            sb_lit(sb, "\\t")
        elif c == 13:
            sb_lit(sb, "\\r")
        elif c < 0x20:
            sb_lit(sb, "\\u{")
            sb_base(sb, u64(c), 4)
            sb_byte(sb, 125)
        else:
            sb_byte(sb, c)
    sb_byte(sb, 34)

# The number of decimal digits of u.
fn dec_len(u: u64) -> int:
    var n = 1
    var t: u64 = 10
    while u >= t:
        n += 1
        if n == 20:
            return 20
        t *= 10
    return n

# u in decimal, its last digit at d + n - 1 (n is dec_len(u))
fn put_dec(d: ptr, n: int, u0: u64):
    let t = ptr_of(DIGITS) + STR_DATA
    var u = u0
    var i = n
    while u >= 100:
        let r = int(u % 100)
        u = u / 100
        i -= 2
        store_u16(d, i, load_u16(t, r * 2))
    if u >= 10:
        store_u16(d, i - 2, load_u16(t, int(u) * 2))
    else:
        store_u8(d, i - 1, u8(48 + u))

fn brine_sb_u64(sb: ptr, v: u64):
    let n = dec_len(v)
    put_dec(sb_room(sb, n), n, v)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n)

fn brine_sb_i64(sb: ptr, v: int):
    if v >= 0:
        brine_sb_u64(sb, u64(v))
        return
    # (wraps for the smallest int)
    let u = u64(0) - u64(v)
    let n = dec_len(u)
    let d = sb_room(sb, n + 1)
    store_u8(d, 0, 45)
    put_dec(d + 1, n, u)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n + 1)

fn brine_sb_bool(sb: ptr, v: bool):
    sb_lit(sb, "true" if v else "false")

# u in base 2^bits (hex: 4, binary: 1)
fn sb_base(sb: ptr, u: u64, bits: u64):
    let most = int(64 / bits)
    var n = 1
    while n < most and u >> (u64(n) * bits) != 0:
        n += 1
    sb_base_n(sb, u, bits, n)

# u in exactly n digits of base 2^bits
fn sb_base_n(sb: ptr, u: u64, bits: u64, n: int):
    let d = sb_room(sb, n)
    let t = ptr_of(HEX) + STR_DATA
    let mask = (u64(1) << bits) - 1
    var x = u
    var i = n
    while i > 0:
        i -= 1
        store_u8(d, i, load_u8(t, int(x & mask)))
        x = x >> bits
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n)

fn brine_sb_fmt_i64(sb: ptr, v: int, kind: int):
    if kind == 120 or kind == 98:
        if v < 0:
            sb_byte(sb, 45)
        let u = u64(0) - u64(v) if v < 0 else u64(v)
        sb_base(sb, u, 4 if kind == 120 else 1)
        return
    if kind == 102 or kind == 101 or kind == 103:
        brine_sb_fmt_f64(sb, float(v), -1, i32(kind))
        return
    brine_sb_i64(sb, v)

fn brine_sb_fmt_u64(sb: ptr, v: u64, kind: int):
    if kind == 120 or kind == 98:
        sb_base(sb, v, 4 if kind == 120 else 1)
    elif kind == 102 or kind == 101 or kind == 103:
        brine_sb_fmt_f64(sb, float(v), -1, i32(kind))
    else:
        brine_sb_u64(sb, v)

fn is_digit(c: u8) -> bool:
    return u64(c) - 48 < 10

# `{x:,}`: commas between groups of three digits in the integer part of the
# number written from `start` on
fn brine_sb_group(sb: ptr, start: int):
    var p = load_ptr(sb, SB_P)
    let len = load_i64(sb, SB_LEN)
    var a = start
    if a < len and (load_u8(p, a) == 45 or load_u8(p, a) == 43):
        a += 1
    var b = a
    while b < len and is_digit(load_u8(p, b)):
        b += 1
    let n = b - a
    let k = (n - 1) / 3
    if n <= 3:
        return
    sb_room(sb, k)
    p = load_ptr(sb, SB_P)
    memmove(p + b + k, p + b, u64(len - b))
    store_i64(sb, SB_LEN, len + k)
    # from the right: copy digits, a comma after every third
    var from = b - 1
    var to = b + k - 1
    var i = 0
    while from >= a:
        if i > 0 and i % 3 == 0:
            store_u8(p, to, 44)
            to -= 1
        store_u8(p, to, load_u8(p, from))
        to -= 1
        from -= 1
        i += 1

fn brine_sb_pad(sb: ptr, start: int, width: int, left: bool, zero: bool):
    let len = load_i64(sb, SB_LEN)
    let n = len - start
    if n >= width:
        return
    let pad = width - n
    sb_room(sb, pad)
    let p = load_ptr(sb, SB_P)
    if left:
        memset(p + len, 32, u64(pad))
    else:
        var at = start
        if zero and n > 0 and (load_u8(p, start) == 45 or load_u8(p, start) == 43):
            at += 1
        memmove(p + at + pad, p + at, u64(len - at))
        memset(p + at, 48 if zero else 32, u64(pad))
    store_i64(sb, SB_LEN, len + pad)

fn brine_sb_finish(sb: ptr) -> ptr:
    let p = load_ptr(sb, SB_P)
    let s = brine_str_new(p, load_i64(sb, SB_LEN))
    blk_free(p)
    store_u64(sb, SB_P, 0)
    return s

# ------------------------------------------------------------ integers

fn int_blank(c: u8) -> bool:
    return c == 32 or c == 10 or c == 13 or c == 9

# Integer text as `int()` reads it: blanks around it, a sign, decimal
# digits, and `_` between two digits, as in literals (`1_000`). The value
# goes to the u128 at out (low word first); the result is 1 if there was a
# minus sign, 0 if not, and -1 if it isn't an integer or doesn't fit in 128
# bits.
fn parse_128(s: ptr, out: ptr) -> int:
    let d = s + STR_DATA
    var i = 0
    var e = load_i64(s, STR_LEN)
    while i < e and int_blank(load_u8(d, i)):
        i += 1
    while e > i and int_blank(load_u8(d, e - 1)):
        e -= 1
    var neg = 0
    if i < e and (load_u8(d, i) == 43 or load_u8(d, i) == 45):
        if load_u8(d, i) == 45:
            neg = 1
        i += 1
    if i == e:
        return -1
    let first = i
    var v: u64 = 0
    while i < e:
        let c = load_u8(d, i)
        if c == 95 and i > first and i + 1 < e and is_digit(load_u8(d, i + 1)):
            i += 1
            continue
        if not is_digit(c):
            return -1
        # past here the next digit could overflow 64 bits
        if v > 1844674407370955160:
            return parse_128_cold(d, i, e, v, out, neg)
        v = v * 10 + u64(c - 48)
        i += 1
    store_u64(out, 0, v)
    store_u64(out, 8, 0)
    return neg

fn parse_128_cold(d: ptr, i0: int, e: int, v: u64, out: ptr, neg: int) -> int:
    let max = u128(0) - u128(1)
    var w = u128(v)
    var i = i0
    while i < e:
        let c = load_u8(d, i)
        if c == 95 and i + 1 < e and is_digit(load_u8(d, i + 1)):
            i += 1
            continue
        if not is_digit(c):
            return -1
        let g = u128(c - 48)
        if w > (max - g) / 10:
            return -1
        w = w * 10 + g
        i += 1
    store_u64(out, 0, u64(w))
    store_u64(out, 8, u64(w >> 64))
    return neg

fn bad_int_cold(s: ptr, loc: ptr):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, "invalid integer: \"")
    brine_sb_cat(sb, s + STR_DATA, load_i64(s, STR_LEN))
    sb_byte(sb, 34)
    brine_panic_at(loc, str_of(brine_sb_finish(sb)))

# The smallest int: no result of short_int
const NOT_INT = -9223372036854775807 - 1

# s as int() reads it when s is an optional minus and 1 to 18 digits (too
# few to overflow), the common case; NOT_INT for anything else
fn short_int(s: ptr) -> int:
    let d = s + STR_DATA
    let n = load_i64(s, STR_LEN)
    var i = 0
    if n > 0 and load_u8(d, 0) == 45:
        i = 1
    if n - i <= 0 or n - i > 18:
        return NOT_INT
    var v = 0
    while i < n:
        let g = u64(load_u8(d, i)) - 48
        if g >= 10:
            return NOT_INT
        v = v * 10 + int(g)
        i += 1
    return -v if load_u8(d, 0) == 45 else v

fn parse_i64(s: ptr, loc: ptr) -> int:
    let v = short_int(s)
    if v != NOT_INT:
        return v
    return parse_i64_cold(s, loc)

fn parse_i64_cold(s: ptr, loc: ptr) -> int:
    let o = stack_mem(16)
    let neg = parse_128(s, o)
    let u = load_u64(o, 0)
    if neg < 0 or load_u64(o, 8) != 0 or u > u64(9223372036854775807) + u64(neg):
        bad_int_cold(s, loc)
    return int(u64(0) - u) if neg == 1 else int(u)

fn parse_i128(s: ptr, loc: ptr) -> i128:
    let v = short_int(s)
    if v != NOT_INT:
        return i128(v)
    return parse_i128_cold(s, loc)

fn parse_i128_cold(s: ptr, loc: ptr) -> i128:
    let o = stack_mem(16)
    let neg = parse_128(s, o)
    let u = (u128(load_u64(o, 8)) << 64) | u128(load_u64(o, 0))
    if neg < 0 or u > (u128(1) << 127) - 1 + u128(neg):
        bad_int_cold(s, loc)
    return i128(u128(0) - u) if neg == 1 else i128(u)

fn parse_u128(s: ptr, loc: ptr) -> u128:
    let o = stack_mem(16)
    let neg = parse_128(s, o)
    let u = (u128(load_u64(o, 8)) << 64) | u128(load_u64(o, 0))
    if neg < 0 or (neg == 1 and u != 0):
        bad_int_cold(s, loc)
    return u

# `int(s, bits, signed)` as an Option: the value goes to out, in `bits` bits
fn try_parse_int(s: ptr, bits: int, sgn: bool, out: ptr) -> bool:
    let v = short_int(s)
    if v == NOT_INT or (v < 0 and not sgn):
        return try_parse_int_cold(s, bits, sgn, out)
    if bits < 64:
        let top = 1 << (bits - 1 if sgn else bits)
        if v >= top or v < -top:
            return false
    if bits == 8:
        store_u8(out, 0, u8(v))
    elif bits == 16:
        store_u16(out, 0, u16(v))
    elif bits == 32:
        store_u32(out, 0, u32(v))
    else:
        store_i64(out, 0, v)
        if bits == 128:
            store_i64(out, 8, v >> 63)
    return true

fn try_parse_int_cold(s: ptr, bits: int, sgn: bool, out: ptr) -> bool:
    let o = stack_mem(16)
    let neg = parse_128(s, o)
    if neg < 0:
        return false
    let u = (u128(load_u64(o, 8)) << 64) | u128(load_u64(o, 0))
    var max = u128(0) - u128(1)
    if bits < 128:
        max = (u128(1) << u128(bits)) - 1
    if sgn:
        max = max >> 1
    if neg == 1:
        if sgn and u > max + 1:
            return false
        if not sgn and u != 0:
            return false
    elif u > max:
        return false
    let v = u128(0) - u if neg == 1 else u
    if bits == 8:
        store_u8(out, 0, u8(v))
    elif bits == 16:
        store_u16(out, 0, u16(v))
    elif bits == 32:
        store_u32(out, 0, u32(v))
    elif bits == 64:
        store_u64(out, 0, u64(v))
    else:
        store_u64(out, 0, u64(v))
        store_u64(out, 8, u64(v >> 64))
    return true

# v in decimal: 19 digits at a time
fn sb_u128(sb: ptr, v: u128):
    if v >> 64 == 0:
        brine_sb_u64(sb, u64(v))
        return
    let p = u128(10000000000000000000)
    let a = v / p
    if a >> 64 == 0:
        brine_sb_u64(sb, u64(a))
    else:
        brine_sb_u64(sb, u64(a / p))
        sb_dec19(sb, u64(a % p))
    sb_dec19(sb, u64(v % p))

# u in exactly 19 decimal digits
fn sb_dec19(sb: ptr, u: u64):
    let d = sb_room(sb, 19)
    memset(d, 48, 19)
    put_dec(d, 19, u)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + 19)

fn sb_i128(sb: ptr, v: i128):
    if v < 0:
        sb_byte(sb, 45)
    sb_u128(sb, u128(0) - u128(v) if v < 0 else u128(v))

# u in base 2^bits (hex: 4, binary: 1)
fn sb_base128(sb: ptr, u: u128, bits: u64):
    let hi = u64(u >> 64)
    if hi == 0:
        sb_base(sb, u64(u), bits)
        return
    sb_base(sb, hi, bits)
    sb_base_n(sb, u64(u), bits, int(64 / bits))

fn sb_fmt_u128(sb: ptr, v: u128, kind: int):
    if kind == 120 or kind == 98:
        sb_base128(sb, v, 4 if kind == 120 else 1)
    elif kind == 102 or kind == 101 or kind == 103:
        brine_sb_fmt_f64(sb, float(v), -1, i32(kind))
    else:
        sb_u128(sb, v)

fn sb_fmt_i128(sb: ptr, v: i128, kind: int):
    if kind == 120 or kind == 98:
        if v < 0:
            sb_byte(sb, 45)
        sb_base128(sb, u128(0) - u128(v) if v < 0 else u128(v), 4 if kind == 120 else 1)
    elif kind == 102 or kind == 101 or kind == 103:
        brine_sb_fmt_f64(sb, float(v), -1, i32(kind))
    else:
        sb_i128(sb, v)

# ------------------------------------------------------------ integer helpers
# What native code calls for the integer operations it doesn't do inline:
# checked arithmetic, conversions and 128-bit operations (brine_x_* in
# brine_rt.c, 128-bit values by pointer, low word first). These use only
# 64-bit unsigned division and shifts, since AArch64 sends signed division,
# 128-bit operations and bswap back here.

fn panic_cold(msg: str, loc: ptr):
    brine_panic_at(loc, msg)

fn in_range(x: int, lo: int, hi: int, msg: str, loc: ptr) -> int:
    if x < lo or x > hi:
        panic_cold(msg, loc)
    return x

fn shift_ok(b: int, n: int, loc: ptr) -> u64:
    if b < 0 or b >= n:
        panic_cold("shift amount out of range", loc)
    return u64(b)

fn nonzero(b: int, msg: str, loc: ptr):
    if b == 0:
        panic_cold(msg, loc)

# a // b, rounded down
fn floor_div(a: int, b: int) -> int:
    let ua = u64(0) - u64(a) if a < 0 else u64(a)
    let ub = u64(0) - u64(b) if b < 0 else u64(b)
    let q = ua / ub
    if (a < 0) == (b < 0):
        return int(q)
    return -int(q) - (1 if q * ub != ua else 0)

# a % b, with the sign of b
fn floor_mod(a: int, b: int) -> int:
    return a - floor_div(a, b) * b

fn mul_i64_ovf(a: int, b: int, loc: ptr) -> int:
    let ua = u64(0) - u64(a) if a < 0 else u64(a)
    let ub = u64(0) - u64(b) if b < 0 else u64(b)
    let m = ua * ub
    let neg = (a < 0) != (b < 0)
    if umulh(ua, ub) != 0 or m > u64(9223372036854775807) + (u64(1) if neg else u64(0)):
        panic_cold("integer overflow in multiplication", loc)
    return -int(m) if neg else int(m)

fn check(ok: bool, msg: str, loc: ptr):
    if not ok:
        panic_cold(msg, loc)

fn popcnt64(x0: u64) -> int:
    var x = x0 - ((x0 >> 1) & 0x5555555555555555)
    x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
    x = (x + (x >> 4)) & 0x0f0f0f0f0f0f0f0f
    return int((x * 0x0101010101010101) >> 56)

fn clz64(x0: u64) -> int:
    var x = x0 | (x0 >> 1)
    x = x | (x >> 2)
    x = x | (x >> 4)
    x = x | (x >> 8)
    x = x | (x >> 16)
    x = x | (x >> 32)
    return 64 - popcnt64(x)

fn ctz64(x: u64) -> int:
    return popcnt64((x & (u64(0) - x)) - 1)

fn brine_x_popcnt_u64(x: u64) -> int:
    return popcnt64(x)

fn brine_x_clz_u64(x: u64) -> int:
    return clz64(x)

fn brine_x_ctz_u64(x: u64) -> int:
    return ctz64(x)

fn brine_x_bswap_u64(x0: u64) -> u64:
    var x = ((x0 >> 8) & 0x00ff00ff00ff00ff) | ((x0 & 0x00ff00ff00ff00ff) << 8)
    x = ((x >> 16) & 0x0000ffff0000ffff) | ((x & 0x0000ffff0000ffff) << 16)
    return (x >> 32) | (x << 32)

fn brine_x_popcnt_u128(x: ptr) -> int:
    return popcnt64(load_u64(x, 0)) + popcnt64(load_u64(x, 8))

fn brine_x_clz_u128(x: ptr) -> int:
    let hi = load_u64(x, 8)
    return clz64(hi) if hi != 0 else 64 + clz64(load_u64(x, 0))

fn brine_x_ctz_u128(x: ptr) -> int:
    let lo = load_u64(x, 0)
    return ctz64(lo) if lo != 0 else 64 + ctz64(load_u64(x, 8))

# ---- 128 bits

fn put128(r: ptr, lo: u64, hi: u64):
    store_u64(r, 0, lo)
    store_u64(r, 8, hi)

fn copy128(r: ptr, a: ptr):
    put128(r, load_u64(a, 0), load_u64(a, 8))

fn neg128(r: ptr, a: ptr):
    let lo = load_u64(a, 0)
    put128(r, u64(0) - lo, (load_u64(a, 8) ^ ONES) + (u64(1) if lo == 0 else u64(0)))

fn is_min128(a: ptr) -> bool:
    return load_u64(a, 0) == 0 and load_u64(a, 8) == u64(1) << 63

# (lo, hi) << n, for n below 128; `ar` shifts right arithmetically instead
fn shl128(r: ptr, lo: u64, hi: u64, n: int):
    if n == 0:
        put128(r, lo, hi)
    elif n < 64:
        let s = u64(n)
        put128(r, lo << s, (hi << s) | (lo >> (64 - s)))
    else:
        put128(r, 0, lo << u64(n - 64))

fn shr128(r: ptr, lo: u64, hi: u64, n: int, ar: bool):
    let fill = u64(int(hi) >> 63) if ar else u64(0)
    if n == 0:
        put128(r, lo, hi)
    elif n < 64:
        let s = u64(n)
        let h = u64(int(hi) >> int(s)) if ar else hi >> s
        put128(r, (lo >> s) | (hi << (64 - s)), h)
    else:
        put128(r, u64(int(hi) >> (n - 64)) if ar else hi >> u64(n - 64), fill)

# a * b, wrapping
fn mul128(r: ptr, a: ptr, b: ptr):
    let al = load_u64(a, 0)
    let bl = load_u64(b, 0)
    put128(r, al * bl, umulh(al, bl) + al * load_u64(b, 8) + load_u64(a, 8) * bl)

# a * b of two magnitudes (lo, hi); true if that doesn't fit in 128 bits
fn umul128(r: ptr, al: u64, ah: u64, bl: u64, bh: u64) -> bool:
    var bad = ah != 0 and bh != 0
    if umulh(al, bh) != 0 or umulh(ah, bl) != 0:
        bad = true
    let cross = al * bh + ah * bl
    let hi = umulh(al, bl) + cross
    put128(r, al * bl, hi)
    return bad or hi < cross

fn mul_u128_ovf(r: ptr, a: ptr, b: ptr) -> bool:
    return umul128(r, load_u64(a, 0), load_u64(a, 8), load_u64(b, 0), load_u64(b, 8))

fn mul_i128_ovf(r: ptr, a: ptr, b: ptr) -> bool:
    let ma = stack_mem(16)
    let mb = stack_mem(16)
    let an = load_i64(a, 8) < 0
    let bn = load_i64(b, 8) < 0
    if an:
        neg128(ma, a)
    else:
        copy128(ma, a)
    if bn:
        neg128(mb, b)
    else:
        copy128(mb, b)
    var bad = umul128(r, load_u64(ma, 0), load_u64(ma, 8), load_u64(mb, 0), load_u64(mb, 8))
    let neg = an != bn
    let hi = load_u64(r, 8)
    # the magnitude must be below 2^127, or exactly 2^127 for a negative result
    if hi > u64(1) << 63 or (hi == u64(1) << 63 and (not neg or load_u64(r, 0) != 0)):
        bad = true
    if neg:
        neg128(r, r)
    return bad

# The `divlu` prim where there's no instruction for it (AArch64): u1 * 2^64 +
# u0 divided by v0, for u1 < v0 (Hacker's Delight, divlu)
fn brine_x_divlu_u64(u1: u64, u0: u64, v0: u64) -> u64:
    if u1 == 0:
        return u0 / v0
    let b = u64(1) << 32
    let s = u64(v0.leading_zeros())
    let v = v0 << s
    let vn1 = v >> 32
    let vn0 = v & 0xffffffff
    let un32 = (u1 << s) | ((u0 >> (64 - s)) if s > 0 else u64(0))
    let un10 = u0 << s
    let un1 = un10 >> 32
    let un0 = un10 & 0xffffffff
    var q1 = un32 / vn1
    var rhat = un32 - q1 * vn1
    while q1 >= b or q1 * vn0 > b * rhat + un1:
        q1 -= 1
        rhat += vn1
        if rhat >= b:
            break
    let un21 = un32 * b + un1 - q1 * v
    var q0 = un21 / vn1
    rhat = un21 - q0 * vn1
    while q0 >= b or q0 * vn0 > b * rhat + un0:
        q0 -= 1
        rhat += vn1
        if rhat >= b:
            break
    return q1 * b + q0

# a / b to q and a % b to m, of unsigned (lo, hi) pairs, b not zero
fn udiv128(q: ptr, m: ptr, al: u64, ah: u64, bl: u64, bh: u64):
    if bh == 0:
        # (the remainders are the low words of what's left)
        var qh: u64 = 0
        var top = ah
        if ah >= bl:
            qh = ah / bl
            top = ah - qh * bl
        let ql = divlu(top, al, bl)
        put128(q, ql, qh)
        put128(m, al - ql * bl, 0)
        return
    # b has a high word, so the quotient fits in 64 bits: estimate it from the
    # top 64 bits of b (Hacker's Delight, divlu applied to 128 bits)
    let n = u64(bh.leading_zeros())
    let v1 = (bh << n) | ((bl >> (64 - n)) if n > 0 else u64(0))
    let q1 = divlu(ah >> 1, (al >> 1) | (ah << 63), v1)
    var e = q1 >> (63 - n)
    if e != 0:
        e -= 1
    # a - e * b, then one more if that is still at least b
    let pl = e * bl
    let ph = umulh(e, bl) + e * bh
    var rl = al - pl
    var rh = ah - ph - (u64(1) if al < pl else u64(0))
    if rh > bh or (rh == bh and rl >= bl):
        e += 1
        let t = rl
        rl = rl - bl
        rh = rh - bh - (u64(1) if t < bl else u64(0))
    put128(q, e, 0)
    put128(m, rl, rh)

fn udiv128p(r: ptr, a: ptr, b: ptr, want_rem: bool):
    let al = load_u64(a, 0)
    var ah = load_u64(a, 8)
    let bl = load_u64(b, 0)
    let bh = load_u64(b, 8)
    if bh == 0:
        var qh: u64 = 0
        if ah >= bl:
            qh = ah / bl
            ah = ah - qh * bl
        let ql = divlu(ah, al, bl)
        if want_rem:
            put128(r, al - ql * bl, 0)
        else:
            put128(r, ql, qh)
        return
    let t = stack_mem(16)
    if want_rem:
        udiv128(t, r, al, ah, bl, bh)
    else:
        udiv128(r, t, al, ah, bl, bh)

# signed a / b truncated (`floor` rounds down instead); a % b with `want_rem`
# takes the sign of a (or, with `floor`, of b)
fn sdiv128(r: ptr, a: ptr, b: ptr, want_rem: bool, floor: bool):
    var al = load_u64(a, 0)
    var ah = load_u64(a, 8)
    var bl = load_u64(b, 0)
    var bh = load_u64(b, 8)
    let x = int(al)
    let y = int(bl)
    # both fit in 64 bits (and b isn't -1, for -2^63 / -1): a 64-bit division
    if int(ah) == x >> 63 and int(bh) == y >> 63 and y != -1:
        var v = 0
        if want_rem:
            v = x % y
            if not floor and v != 0 and (v < 0) != (x < 0):
                v -= y
        else:
            v = x / y
            if not floor and (x < 0) != (y < 0) and v * y != x:
                v += 1
        put128(r, u64(v), u64(v >> 63))
        return
    let an = int(ah) < 0
    let bn = int(bh) < 0
    if an:
        ah = (ah ^ ONES) + (u64(1) if al == 0 else u64(0))
        al = u64(0) - al
    if bn:
        bh = (bh ^ ONES) + (u64(1) if bl == 0 else u64(0))
        bl = u64(0) - bl
    var ql: u64 = 0
    var qh: u64 = 0
    var lo: u64 = 0
    var hi: u64 = 0
    if bh == 0:
        # (as in udiv128, kept here in registers)
        if ah >= bl:
            qh = ah / bl
            ah = ah - qh * bl
        ql = divlu(ah, al, bl)
        lo = al - ql * bl
    else:
        let q = stack_mem(16)
        let m = stack_mem(16)
        udiv128(q, m, al, ah, bl, bh)
        ql = load_u64(q, 0)
        qh = load_u64(q, 8)
        lo = load_u64(m, 0)
        hi = load_u64(m, 8)
    let inexact = lo | hi != 0
    if want_rem:
        if an:
            hi = (hi ^ ONES) + (u64(1) if lo == 0 else u64(0))
            lo = u64(0) - lo
        if floor and inexact and an != bn:
            # m + b
            let t = lo
            lo = lo + load_u64(b, 0)
            hi = hi + load_u64(b, 8) + (u64(1) if lo < t else u64(0))
        put128(r, lo, hi)
        return
    lo = ql
    hi = qh
    if an != bn:
        if floor and inexact:
            lo += 1
            if lo == 0:
                hi += 1
        hi = (hi ^ ONES) + (u64(1) if lo == 0 else u64(0))
        lo = u64(0) - lo
    put128(r, lo, hi)

# x truncated to an integer (wrapping past 128 bits)
fn from_f64_128(r: ptr, x: float):
    let bits = x.to_bits()
    let e = int((bits >> 52) & 0x7ff) - 1075
    let m = (bits & 0xfffffffffffff) | (u64(1) << 52)
    if e <= -53 or e >= 128:
        put128(r, 0, 0)
    elif e < 0:
        put128(r, m >> u64(-e), 0)
    else:
        shl128(r, m, 0, e)
    if bits >> 63 != 0:
        neg128(r, r)

# 2^k, k from 0 to 127
fn pow2_f64(k: int) -> float:
    return float.from_bits(u64(1023 + k) << 52)

# (lo, hi) rounded once to the nearest float: its top 64 bits with a sticky
# bit for the rest, which a u64 conversion then rounds correctly
fn u128_top(lo: u64, hi: u64, out: ptr) -> u64:
    let n = u64(hi.leading_zeros())
    store_i64(out, 0, 64 - int(n))
    if n == 0:
        return hi | (u64(1) if lo != 0 else u64(0))
    let t = (hi << n) | (lo >> (64 - n))
    return t | (u64(1) if lo << n != 0 else u64(0))

fn u128_to_f64(lo: u64, hi: u64) -> float:
    if hi == 0:
        return float(lo)
    let k = stack_mem(8)
    let t = u128_top(lo, hi, k)
    return float(t) * pow2_f64(load_i64(k, 0))

fn u128_to_f32(lo: u64, hi: u64) -> f32:
    if hi == 0:
        return f32(lo)
    let k = stack_mem(8)
    let t = u128_top(lo, hi, k)
    return f32(t) * f32.from_bits(u32(127 + load_i64(k, 0)) << 23)

fn i128_to_f64(a: ptr) -> float:
    if load_i64(a, 8) < 0:
        let m = stack_mem(16)
        neg128(m, a)
        return -u128_to_f64(load_u64(m, 0), load_u64(m, 8))
    return u128_to_f64(load_u64(a, 0), load_u64(a, 8))

fn i128_to_f32(a: ptr) -> f32:
    if load_i64(a, 8) < 0:
        let m = stack_mem(16)
        neg128(m, a)
        return -u128_to_f32(load_u64(m, 0), load_u64(m, 8))
    return u128_to_f32(load_u64(a, 0), load_u64(a, 8))

# i8
fn brine_x_add_i8(a: i8, b: i8, loc: ptr) -> i8:
    return i8(in_range(int(a) + int(b), -128, 127, "integer overflow in addition", loc))

fn brine_x_sub_i8(a: i8, b: i8, loc: ptr) -> i8:
    return i8(in_range(int(a) - int(b), -128, 127, "integer overflow in subtraction", loc))

fn brine_x_mul_i8(a: i8, b: i8, loc: ptr) -> i8:
    return i8(in_range(int(a) * int(b), -128, 127, "integer overflow in multiplication", loc))

fn brine_x_shl_i8(a: i8, b: int, loc: ptr) -> i8:
    return i8(u64(a) << shift_ok(b, 8, loc))

fn brine_x_shr_i8(a: i8, b: int, loc: ptr) -> i8:
    return i8(int(a) >> int(shift_ok(b, 8, loc)))

fn brine_x_conv_i8_from_i64(x: int, loc: ptr) -> i8:
    check(x >= -128 and x <= 127, "integer conversion out of range for i8", loc)
    return i8(x)

fn brine_x_conv_i8_from_u64(x: u64, loc: ptr) -> i8:
    check(x <= 127, "integer conversion out of range for i8", loc)
    return i8(x)

fn brine_x_conv_i8_from_i128(x: ptr, loc: ptr) -> i8:
    let v = load_i64(x, 0)
    check(
        load_i64(x, 8) == v >> 63 and v >= -128 and v <= 127,
        "integer conversion out of range for i8",
        loc
    )
    return i8(v)

fn brine_x_conv_i8_from_u128(x: ptr, loc: ptr) -> i8:
    let v = load_u64(x, 0)
    check(load_u64(x, 8) == 0 and v <= 127, "integer conversion out of range for i8", loc)
    return i8(v)

fn brine_x_fdiv_i8(a: i8, b: i8) -> i8:
    return i8(floor_div(int(a), int(b)))

fn brine_x_fmod_i8(a: i8, b: i8) -> i8:
    return i8(floor_mod(int(a), int(b)))

fn brine_x_div_i8(a: i8, b: i8, loc: ptr) -> i8:
    nonzero(int(b), "division by zero", loc)
    check(b != -1 or a != -128, "integer overflow in division", loc)
    return i8(floor_div(int(a), int(b)))

fn brine_x_mod_i8(a: i8, b: i8, loc: ptr) -> i8:
    nonzero(int(b), "remainder by zero", loc)
    return i8(floor_mod(int(a), int(b)))

fn brine_x_abs_i8(a: i8, loc: ptr) -> i8:
    check(a != -128, "integer overflow in abs", loc)
    return -a if a < 0 else a

fn brine_x_neg_i8(a: i8, loc: ptr) -> i8:
    check(a != -128, "integer overflow in negation", loc)
    return -a

fn brine_x_conv_i8_from_f64(x: float, loc: ptr) -> i8:
    check(
        x >= -128.0 and x < 128.0,
        "float to integer conversion out of range (or NaN) for i8",
        loc
    )
    return i8(x)

# i16
fn brine_x_add_i16(a: i16, b: i16, loc: ptr) -> i16:
    return i16(in_range(int(a) + int(b), -32768, 32767, "integer overflow in addition", loc))

fn brine_x_sub_i16(a: i16, b: i16, loc: ptr) -> i16:
    return i16(in_range(int(a) - int(b), -32768, 32767, "integer overflow in subtraction", loc))

fn brine_x_mul_i16(a: i16, b: i16, loc: ptr) -> i16:
    return i16(in_range(int(a) * int(b), -32768, 32767, "integer overflow in multiplication", loc))

fn brine_x_shl_i16(a: i16, b: int, loc: ptr) -> i16:
    return i16(u64(a) << shift_ok(b, 16, loc))

fn brine_x_shr_i16(a: i16, b: int, loc: ptr) -> i16:
    return i16(int(a) >> int(shift_ok(b, 16, loc)))

fn brine_x_conv_i16_from_i64(x: int, loc: ptr) -> i16:
    check(x >= -32768 and x <= 32767, "integer conversion out of range for i16", loc)
    return i16(x)

fn brine_x_conv_i16_from_u64(x: u64, loc: ptr) -> i16:
    check(x <= 32767, "integer conversion out of range for i16", loc)
    return i16(x)

fn brine_x_conv_i16_from_i128(x: ptr, loc: ptr) -> i16:
    let v = load_i64(x, 0)
    check(
        load_i64(x, 8) == v >> 63 and v >= -32768 and v <= 32767,
        "integer conversion out of range for i16",
        loc
    )
    return i16(v)

fn brine_x_conv_i16_from_u128(x: ptr, loc: ptr) -> i16:
    let v = load_u64(x, 0)
    check(load_u64(x, 8) == 0 and v <= 32767, "integer conversion out of range for i16", loc)
    return i16(v)

fn brine_x_fdiv_i16(a: i16, b: i16) -> i16:
    return i16(floor_div(int(a), int(b)))

fn brine_x_fmod_i16(a: i16, b: i16) -> i16:
    return i16(floor_mod(int(a), int(b)))

fn brine_x_div_i16(a: i16, b: i16, loc: ptr) -> i16:
    nonzero(int(b), "division by zero", loc)
    check(b != -1 or a != -32768, "integer overflow in division", loc)
    return i16(floor_div(int(a), int(b)))

fn brine_x_mod_i16(a: i16, b: i16, loc: ptr) -> i16:
    nonzero(int(b), "remainder by zero", loc)
    return i16(floor_mod(int(a), int(b)))

fn brine_x_abs_i16(a: i16, loc: ptr) -> i16:
    check(a != -32768, "integer overflow in abs", loc)
    return -a if a < 0 else a

fn brine_x_neg_i16(a: i16, loc: ptr) -> i16:
    check(a != -32768, "integer overflow in negation", loc)
    return -a

fn brine_x_conv_i16_from_f64(x: float, loc: ptr) -> i16:
    check(
        x >= -32768.0 and x < 32768.0,
        "float to integer conversion out of range (or NaN) for i16",
        loc
    )
    return i16(x)

# i32
fn brine_x_add_i32(a: i32, b: i32, loc: ptr) -> i32:
    return i32(
        in_range(int(a) + int(b), -2147483648, 2147483647, "integer overflow in addition", loc)
    )

fn brine_x_sub_i32(a: i32, b: i32, loc: ptr) -> i32:
    return i32(
        in_range(int(a) - int(b), -2147483648, 2147483647, "integer overflow in subtraction", loc)
    )

fn brine_x_mul_i32(a: i32, b: i32, loc: ptr) -> i32:
    return i32(
        in_range(
            int(a) * int(b),
            -2147483648,
            2147483647,
            "integer overflow in multiplication",
            loc
        )
    )

fn brine_x_shl_i32(a: i32, b: int, loc: ptr) -> i32:
    return i32(u64(a) << shift_ok(b, 32, loc))

fn brine_x_shr_i32(a: i32, b: int, loc: ptr) -> i32:
    return i32(int(a) >> int(shift_ok(b, 32, loc)))

fn brine_x_conv_i32_from_i64(x: int, loc: ptr) -> i32:
    check(x >= -2147483648 and x <= 2147483647, "integer conversion out of range for i32", loc)
    return i32(x)

fn brine_x_conv_i32_from_u64(x: u64, loc: ptr) -> i32:
    check(x <= 2147483647, "integer conversion out of range for i32", loc)
    return i32(x)

fn brine_x_conv_i32_from_i128(x: ptr, loc: ptr) -> i32:
    let v = load_i64(x, 0)
    check(
        load_i64(x, 8) == v >> 63 and v >= -2147483648 and v <= 2147483647,
        "integer conversion out of range for i32",
        loc
    )
    return i32(v)

fn brine_x_conv_i32_from_u128(x: ptr, loc: ptr) -> i32:
    let v = load_u64(x, 0)
    check(load_u64(x, 8) == 0 and v <= 2147483647, "integer conversion out of range for i32", loc)
    return i32(v)

fn brine_x_fdiv_i32(a: i32, b: i32) -> i32:
    return i32(floor_div(int(a), int(b)))

fn brine_x_fmod_i32(a: i32, b: i32) -> i32:
    return i32(floor_mod(int(a), int(b)))

fn brine_x_div_i32(a: i32, b: i32, loc: ptr) -> i32:
    nonzero(int(b), "division by zero", loc)
    check(b != -1 or a != -2147483648, "integer overflow in division", loc)
    return i32(floor_div(int(a), int(b)))

fn brine_x_mod_i32(a: i32, b: i32, loc: ptr) -> i32:
    nonzero(int(b), "remainder by zero", loc)
    return i32(floor_mod(int(a), int(b)))

fn brine_x_abs_i32(a: i32, loc: ptr) -> i32:
    check(a != -2147483648, "integer overflow in abs", loc)
    return -a if a < 0 else a

fn brine_x_neg_i32(a: i32, loc: ptr) -> i32:
    check(a != -2147483648, "integer overflow in negation", loc)
    return -a

fn brine_x_conv_i32_from_f64(x: float, loc: ptr) -> i32:
    check(
        x >= -2147483648.0 and x < 2147483648.0,
        "float to integer conversion out of range (or NaN) for i32",
        loc
    )
    return i32(x)

# i64
fn brine_x_add_i64(a: int, b: int, loc: ptr) -> int:
    let r = a + b
    check(((a ^ r) & (b ^ r)) >= 0, "integer overflow in addition", loc)
    return r

fn brine_x_sub_i64(a: int, b: int, loc: ptr) -> int:
    let r = a - b
    check(((a ^ b) & (a ^ r)) >= 0, "integer overflow in subtraction", loc)
    return r

fn brine_x_mul_i64(a: int, b: int, loc: ptr) -> int:
    return mul_i64_ovf(a, b, loc)

fn brine_x_shl_i64(a: int, b: int, loc: ptr) -> int:
    return int(u64(a) << shift_ok(b, 64, loc))

fn brine_x_shr_i64(a: int, b: int, loc: ptr) -> int:
    return int(int(a) >> int(shift_ok(b, 64, loc)))

fn brine_x_conv_i64_from_i64(x: int, loc: ptr) -> int:
    return int(x)

fn brine_x_conv_i64_from_u64(x: u64, loc: ptr) -> int:
    check(x <= 9223372036854775807, "integer conversion out of range for i64", loc)
    return int(x)

fn brine_x_conv_i64_from_i128(x: ptr, loc: ptr) -> int:
    let v = load_i64(x, 0)
    check(load_i64(x, 8) == v >> 63, "integer conversion out of range for i64", loc)
    return int(v)

fn brine_x_conv_i64_from_u128(x: ptr, loc: ptr) -> int:
    let v = load_u64(x, 0)
    check(
        load_u64(x, 8) == 0 and v <= 9223372036854775807,
        "integer conversion out of range for i64",
        loc
    )
    return int(v)

fn brine_x_fdiv_i64(a: int, b: int) -> int:
    return int(floor_div(int(a), int(b)))

fn brine_x_fmod_i64(a: int, b: int) -> int:
    return int(floor_mod(int(a), int(b)))

fn brine_x_div_i64(a: int, b: int, loc: ptr) -> int:
    nonzero(int(b), "division by zero", loc)
    check(b != -1 or a != -9223372036854775808, "integer overflow in division", loc)
    return int(floor_div(int(a), int(b)))

fn brine_x_mod_i64(a: int, b: int, loc: ptr) -> int:
    nonzero(int(b), "remainder by zero", loc)
    return int(floor_mod(int(a), int(b)))

fn brine_x_abs_i64(a: int, loc: ptr) -> int:
    check(a != -9223372036854775808, "integer overflow in abs", loc)
    return -a if a < 0 else a

fn brine_x_neg_i64(a: int, loc: ptr) -> int:
    check(a != -9223372036854775808, "integer overflow in negation", loc)
