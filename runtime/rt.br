# The runtime, in brine, for native code; what isn't here yet is still C
# (brine_rt.c). A function `f` here is used in place of the C runtime's
# `brine_f` (brine_rt.h has the same functions, with the same parameters
# and results) and native code inlines it. A function named `brine_f`
# replaces the C one outright: it is the program's `brine_f`, which the C
# runtime calls too, so brine_rt.c leaves its own out (BRINE_RT_BR). One
# whose name ends in `_cold` is a slow path, never inlined.
#
# This module alone has `ptr`, a raw address, with `p + n` and `p - n`, and
# the memory operations `load_<t>(p, off)` and `store_<t>(p, off, v)` (t is
# i8 to i64, u8 to u64, f32, f64, bool or ptr), `call_<t>(f, ...)` (a call
# of the C function at f; `call_void` has no result), `str_retain(p)` and
# `str_release(p)` (also arr_ and map_), `str_of(p)` and `ptr_of(s)` (a
# string's block as a `str` and back, borrowed), `stack_mem(n)` (n bytes of
# the frame), `bswap(x)`, `thread_ptr()`, `addr(p)` (p as a number),
# `symbol("name")` (a C symbol's address) and `null_ptr()`. Its arithmetic
# wraps, and the prover doesn't look at it. Code here can't use what lowers
# to the function it is in (`a + b` on strings in brine_str_concat).

# brine_str: a reference count (negative: immortal), the length, then the
# bytes and a NUL. Every string can be read to the end of the 8-byte word
# that holds its NUL, so short ones are handled a word at a time.
const STR_RC = 0
const STR_LEN = 8
const STR_DATA = 16

# brine_map
const MAP_RC = 0
const MAP_LEN = 8
const MAP_NIDX = 32
const MAP_KEYS = 48
const MAP_VALS = 56
const MAP_HASHES = 64
const MAP_INDEX = 80

# brine_app, the appender of a loop doing `s += t[i]`
const APP_DATA = 0
const APP_LEN = 8
const APP_ROOM = 16
const APP_LIM = 24
const APP_W0 = 32

# brine_heap_info (brine_rt.c): where a thread's heap is, the heap's range,
# each chunk's size class, whether allocation may skip C, and how many free
# blocks of each class a thread keeps
const HI_OFF = 0
const HI_IND = 8
const HI_BASE = 16
const HI_END = 24
const HI_CLASSES = 32
const HI_FAST = 40
const HI_KEEP = 48

# br_heap_th: a free list and a count of free blocks per size class
const TH_HEAD = 0
const TH_COUNT = 96

const SMALL = 256

const ONES: u64 = 0xffffffffffffffff

extern fn brine_hash_long(p: ptr, n: u64) -> u64

extern fn brine_x_str_reset(ps: ptr, lit: ptr)

extern fn brine_x_str_add_byte(ps: ptr, c: u8)

extern fn brine_x_str_add(ps: ptr, b: ptr)

extern fn brine_x_str_at(s: ptr, i: int, loc: ptr) -> ptr

extern fn brine_x_str_room(n: int) -> int

extern fn brine_x_app_byte(ps: ptr, ap: ptr, c: u8)

extern fn brine_box_new(size: int, tag: int) -> ptr

extern fn brine_box_free(p: ptr)

# the low n bytes of a word, 0 <= n <= 8
fn lowmask(n: u64) -> u64:
    if n >= 8:
        return ONES
    return ~(ONES << (n * 8))

# The longest string the block of a string of length n holds (brine_str_room).
fn str_room(n: int) -> int:
    if n > 47:
        return brine_x_str_room(n)
    return ((n + 32) & ~15) - 17

fn str_eq(a: ptr, b: ptr) -> bool:
    if a == b:
        return true
    let n = load_u64(a, STR_LEN)
    if n != load_u64(b, STR_LEN):
        return false
    if n <= 8:
        return ((load_u64(a, STR_DATA) ^ load_u64(b, STR_DATA)) & lowmask(n)) == 0
    return brine_str_eq_long(a, b)

# The hashes of generated hash functions (splitmix64's finalizer)
fn hash_u64(x0: u64) -> u64:
    var x = x0
    x ^= x >> 30
    x *= 0xbf58476d1ce4e5b9
    x ^= x >> 27
    x *= 0x94d049bb133111eb
    x ^= x >> 31
    return x

fn hash_mix(h: u64, x: u64) -> u64:
    return hash_u64(h ^ (x + 0x9e3779b97f4a7c15 + (h << 6) + (h >> 2)))

# A string of up to 7 bytes hashes to its bytes and length, mixed one to
# one, so equal hashes mean equal strings (brine_hash_str).
fn hash_str(s: ptr) -> u64:
    let n = load_u64(s, STR_LEN)
    if n < 8:
        let w = (load_u64(s, STR_DATA) & lowmask(n)) | n << 56
        return bswap(w * 0x9e3779b97f4a7c15)
    return brine_hash_long(s + STR_DATA, n)

# The entry of key k (hash h) in map m, or -1. keq compares two keys of ksz
# bytes; `exact`: equal hashes are equal keys.
fn map_probe(m: ptr, k: ptr, h: u64, keq: ptr, ksz: int, exact: bool) -> int:
    if load_i64(m, MAP_LEN) == 0:
        return -1
    let mask = load_u64(m, MAP_NIDX) - 1
    let ix = load_ptr(m, MAP_INDEX)
    let hs = load_ptr(m, MAP_HASHES)
    var i = h & mask
    while true:
        let e = load_i64(ix, i * 8)
        if e == -1:
            return -1
        if e >= 0 and load_u64(hs, e * 8) == h:
            if exact or call_bool(keq, load_ptr(m, MAP_KEYS) + e * ksz, k):
                return e
        i = (i + 1) & mask
    return -1

# The value of entry e (from map_probe; -1 panics for the missing key k).
fn map_val(m: ptr, e: int, k: ptr, vsz: int, loc: ptr) -> ptr:
    if e < 0:
        return brine_map_at(m, k, loc)
    return load_ptr(m, MAP_VALS) + e * vsz

# Same, after making the map unique so the value can be changed.
fn map_val_mut(pm: ptr, e: int, k: ptr, vsz: int, loc: ptr) -> ptr:
    let m = load_ptr(pm, 0)
    if e >= 0 and load_i64(m, MAP_RC) == 1:
        return load_ptr(m, MAP_VALS) + e * vsz
    return brine_map_val_mut_slow(pm, e, k, loc)

# `var s = lit` run again: keeps s's block when nothing else holds it. A
# block always has room for 15 bytes, so a short literal is one word store.
fn str_reset(ps: ptr, lit: ptr):
    let a = load_ptr(ps, 0)
    let n = load_u64(lit, STR_LEN)
    if n < 8 and load_i64(a, STR_RC) == 1:
        store_u64(a, STR_DATA, load_u64(lit, STR_DATA) & lowmask(n))
        store_u64(a, STR_LEN, n)
        return
    brine_x_str_reset(ps, lit)

# `s[i]` (i in bounds): the byte as a one-character string, from the table
# of immortal ones (brine_bytes: brine_str1, 24 bytes each)
fn str_byte(s: ptr, i: int) -> ptr:
    return symbol("brine_bytes") + int(load_u8(s, STR_DATA + i)) * 24

fn str_at(s: ptr, i: int, loc: ptr) -> ptr:
    if u64(i) >= load_u64(s, STR_LEN):
        return brine_x_str_at(s, i, loc)
    return str_byte(s, i)

# `s += t`, in place when s is unshared, t is at most a word and the word
# written at s's end and the NUL after t fit in its room
# (the word's bytes past t are 0: the NUL when t is shorter).
fn str_add(ps: ptr, b: ptr):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    let lb = load_i64(b, STR_LEN)
    if lb <= 8 and load_i64(a, STR_RC) == 1 and la + 8 <= str_room(la):
        store_u64(a, STR_DATA + la, load_u64(b, STR_DATA) & lowmask(u64(lb)))
        if lb == 8:
            store_u8(a, STR_DATA + la + 8, 0)
        store_i64(a, STR_LEN, la + lb)
        return
    brine_x_str_add(ps, b)

# `s += t[i]`: one byte, in place when s is unshared and has room. Within
# the first word the whole word is rewritten, so a later word load forwards
# from one store.
fn str_add_byte(ps: ptr, c: u8):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    if la < 8 and load_i64(a, STR_RC) == 1:
        let sh = la * 8
        let w = load_u64(a, STR_DATA) & ~(ONES << sh)
        store_u64(a, STR_DATA, w | u64(c) << sh)
        if la == 7:
            store_u8(a, STR_DATA + 8, 0)
        store_i64(a, STR_LEN, la + 1)
        return
    brine_x_str_add_byte(ps, c)

# The appender (brine_app_open): the length and the first word in it, the
# bytes after those straight into s's block while it is unshared and has
# room. (Nothing is passed ap, so its fields can stay in registers.)
fn app_open(ps: ptr, ap: ptr):
    let a = load_ptr(ps, 0)
    let n = load_i64(a, STR_LEN)
    var room = -1
    if load_i64(a, STR_RC) == 1:
        room = str_room(n)
    store_ptr(ap, APP_DATA, a + STR_DATA)
    store_i64(ap, APP_LEN, n)
    store_i64(ap, APP_ROOM, room)
    store_i64(ap, APP_LIM, room if room < 8 else 8)
    store_u64(ap, APP_W0, load_u64(a, STR_DATA) & lowmask(load_u64(a, STR_LEN)))

fn app_byte(ps: ptr, ap: ptr, c: u8):
    let n = load_i64(ap, APP_LEN)
    if n < load_i64(ap, APP_LIM):
        store_u64(ap, APP_W0, load_u64(ap, APP_W0) | u64(c) << (n * 8))
        store_i64(ap, APP_LEN, n + 1)
        return
    if n > 8 and n < load_i64(ap, APP_ROOM):
        store_u8(load_ptr(ap, APP_DATA), n, c)
        store_i64(ap, APP_LEN, n + 1)
        return
    brine_x_app_byte(ps, ap, c)

fn app_close(ps: ptr, ap: ptr):
    let a = load_ptr(ps, 0)
    let n = load_i64(ap, APP_LEN)
    if load_i64(a, STR_LEN) == n:
        return
    store_i64(a, STR_LEN, n)
    # the bytes past n in w0 are 0: the NUL
    let d = load_ptr(ap, APP_DATA)
    if n <= 8:
        store_u64(d, 0, load_u64(ap, APP_W0))
    if n >= 8:
        store_u8(d, n, 0)

# This thread's heap (br_th_peek), at address 0 when there is none yet.
fn th_heap(hi: ptr) -> ptr:
    let at = thread_ptr() + load_i64(hi, HI_OFF)
    if load_i64(hi, HI_IND) != 0:
        return load_ptr(at, 0)
    return at

# The size class of a block of n bytes, 1 <= n <= 256 (br_class_of), and
# the size of its blocks.
fn size_class(n: int) -> int:
    if n <= 128:
        return ((n + 15) >> 4) - 1
    return ((n - 129) >> 5) + 8

fn class_size(c: int) -> int:
    if c < 8:
        return (c + 1) * 16
    return 128 + (c - 7) * 32

extern fn brine_alloc(n: int) -> ptr

extern fn brine_free(p: ptr)

# n bytes of brine_alloc's, counted for BRINE_LEAKCHECK (strings, arrays)
extern fn brine_x_counted(n: int) -> ptr

# A block of n bytes (1 <= n <= SMALL) off the thread's free list, or 0
# when C must make it: the list is empty, or BRINE_LEAKCHECK counts blocks.
fn pop_free(n: int) -> ptr:
    let hi = symbol("brine_heap_info")
    if load_i64(hi, HI_FAST) != 0:
        let h = th_heap(hi)
        if addr(h) != 0:
            let c = size_class(n)
            let p = load_ptr(h, TH_HEAD + c * 8)
            if addr(p) != 0:
                store_ptr(h, TH_HEAD + c * 8, load_ptr(p, 0))
                let k = load_i64(h, TH_COUNT + c * 8)
                if k > 0:
                    store_i64(h, TH_COUNT + c * 8, k - 1)
                return p
    return null_ptr()

# Block p back on the thread's free list; false when C must take it (not
# our heap's, or the list holds enough: C hands some to other threads).
fn push_free(p: ptr) -> bool:
    let hi = symbol("brine_heap_info")
    let base = load_u64(hi, HI_BASE)
    let off = addr(p) - base
    if load_i64(hi, HI_FAST) != 0 and off < load_u64(hi, HI_END) - base:
        let h = th_heap(hi)
        if addr(h) != 0:
            let c = int(load_u8(load_ptr(hi, HI_CLASSES), off >> 16))
            let n = load_i64(h, TH_COUNT + c * 8) + 1
            if n <= load_i64(hi, HI_KEEP + c * 8):
                store_ptr(p, 0, load_ptr(h, TH_HEAD + c * 8))
                store_ptr(h, TH_HEAD + c * 8, p)
                store_i64(h, TH_COUNT + c * 8, n)
                return true
    return false

# brine_alloc's n bytes (n >= 1), and their freeing
fn blk_alloc(n: int) -> ptr:
    if n > 0 and n <= SMALL:
        let p = pop_free(n)
        if addr(p) != 0:
            return p
    return brine_alloc(n)

fn blk_free(p: ptr):
    if not push_free(p):
        brine_free(p)

# A block BRINE_LEAKCHECK counts (strings, arrays, boxes); the free list is
# only used when it is off.
fn new_counted(n: int) -> ptr:
    if n > 0 and n <= SMALL:
        let p = pop_free(n)
        if addr(p) != 0:
            return p
    return brine_x_counted(n)

fn free_counted(p: ptr):
    if not push_free(p):
        brine_box_free(p)

fn box_new(size: int, tag: int) -> ptr:
    if size > 0 and size <= SMALL:
        let p = pop_free(size)
        if addr(p) != 0:
            store_i64(p, 0, 1)
            store_i64(p, 8, tag)
            return p
    return brine_box_new(size, tag)

fn box_free(p: ptr):
    free_counted(p)

# ------------------------------------------------------------ strings
# What C still does for them (brine_rt.c), and the C library.

extern fn memcpy(d: ptr, s: ptr, n: u64) -> ptr

extern fn memcmp(a: ptr, b: ptr, n: u64) -> i32

# a block for a string of n bytes: count 1, length n, the NUL (br_str_alloc)
extern fn brine_x_str_alloc(n: int) -> ptr

# The bytes a string of length n takes (brine_str_size): rounded up by at
# most a quarter, so `+=` can usually grow it in place.
fn str_block(n: int) -> int:
    let t = 17 + n
    if t <= 64:
        return (t + 15) & ~15
    let g = 1 << (61 - u64(t).leading_zeros())
    return (t + g - 1) & ~(g - 1)

# A string of n bytes with count 1 and its NUL; the bytes are not set.
fn new_str(n: int) -> ptr:
    let t = str_block(n)
    if t <= SMALL:
        let s = pop_free(t)
        if addr(s) != 0:
            store_i64(s, STR_RC, 1)
            store_i64(s, STR_LEN, n)
            store_u8(s, STR_DATA + n, 0)
            return s
    return brine_x_str_alloc(n)

fn brine_str_free(s: ptr):
    free_counted(s)

# s's block made big enough for a string of n bytes; it may move
extern fn brine_x_str_grow(s: ptr, n: int) -> ptr

extern fn brine_panic_at(loc: ptr, msg: str)

# n bytes from s to d (apart, or the same bytes); a short copy is a few
# loads and stores that overlap rather than a call
fn copy_bytes(d: ptr, s: ptr, n: int):
    if n >= 8:
        if n > 32:
            memcpy(d, s, u64(n))
        elif n > 16:
            let a = load_u64(s, 0)
            let b = load_u64(s, 8)
            let c = load_u64(s, n - 16)
            let e = load_u64(s, n - 8)
            store_u64(d, 0, a)
            store_u64(d, 8, b)
            store_u64(d, n - 16, c)
            store_u64(d, n - 8, e)
        else:
            let a = load_u64(s, 0)
            let b = load_u64(s, n - 8)
            store_u64(d, 0, a)
            store_u64(d, n - 8, b)
    elif n >= 4:
        let a = load_u32(s, 0)
        let b = load_u32(s, n - 4)
        store_u32(d, 0, a)
        store_u32(d, n - 4, b)
    elif n > 0:
        let a = load_u8(s, 0)
        let b = load_u8(s, n >> 1)
        let c = load_u8(s, n - 1)
        store_u8(d, 0, a)
        store_u8(d, n >> 1, b)
        store_u8(d, n - 1, c)

# the one-character string of byte c (brine_bytes: brine_str1, 24 bytes each)
fn byte_str(c: u8) -> ptr:
    return symbol("brine_bytes") + int(c) * 24

fn brine_str_new(p: ptr, n: int) -> ptr:
    let s = new_str(n)
    copy_bytes(s + STR_DATA, p, n)
    return s

fn brine_str_concat(a: ptr, b: ptr) -> ptr:
    let la = load_i64(a, STR_LEN)
    let lb = load_i64(b, STR_LEN)
    let s = new_str(la + lb)
    copy_bytes(s + STR_DATA, a + STR_DATA, la)
    copy_bytes(s + STR_DATA + la, b + STR_DATA, lb)
    return s

# `s += b`: grows s in place when nothing else holds it
fn brine_str_append(ps: ptr, b: ptr):
    let a = load_ptr(ps, 0)
    let lb = load_i64(b, STR_LEN)
    if lb == 0:
        return
    if load_i64(a, STR_RC) != 1:
        store_ptr(ps, 0, brine_str_concat(a, b))
        str_release(a)
        return
    let la = load_i64(a, STR_LEN)
    let n = la + lb
    let own = a == b
    let s = brine_x_str_grow(a, n)
    copy_bytes(s + STR_DATA + la, (s if own else b) + STR_DATA, lb)
    store_i64(s, STR_LEN, n)
    store_u8(s, STR_DATA + n, 0)
    store_ptr(ps, 0, s)

# brine_str_add_byte when s is shared or full: the usual case is the first
# `+=` to a literal (`var w = ""`), which gets a block of its own
fn brine_str_add_byte_slow(ps: ptr, c: u8):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    if load_i64(a, STR_RC) == 1:
        # grows the block
        brine_str_append(ps, byte_str(c))
        return
    let s = new_str(la + 1)
    if la < 8:
        let w = load_u64(a, STR_DATA) & lowmask(u64(la))
        store_u64(s, STR_DATA, w | u64(c) << u64(8 * la))
        store_u8(s, STR_DATA + 8, 0)
    else:
        copy_bytes(s + STR_DATA, a + STR_DATA, la)
        store_u8(s, STR_DATA + la, c)
    str_release(a)
    store_ptr(ps, 0, s)

fn brine_str_eq_long(a: ptr, b: ptr) -> bool:
    return memcmp(a + STR_DATA, b + STR_DATA, load_u64(a, STR_LEN)) == 0

fn brine_str_contains(s: ptr, sub: ptr) -> bool:
    return find_from(s, sub, 0) >= 0

# The first i >= from where sub is in s, or -1 (an empty sub is at from).
fn find_from(s: ptr, sub: ptr, from: int) -> int:
    let n = load_i64(sub, STR_LEN)
    let d = s + STR_DATA
    let last = load_i64(s, STR_LEN) - n
    if n == 0:
        return from if from <= last else -1
    let first = load_u8(sub, STR_DATA)
    var i = from
    while i <= last:
        if load_u8(d, i) == first and memcmp(d + i, sub + STR_DATA, u64(n)) == 0:
            return i
        i += 1
    return -1

# s[lo:hi] (in bounds, whole characters)
fn sub_str(s: ptr, lo: int, hi: int) -> ptr:
    if lo == 0 and hi == load_i64(s, STR_LEN):
        str_retain(s)
        return s
    if hi - lo == 1:
        return byte_str(load_u8(s, STR_DATA + lo))
    return brine_str_new(s + STR_DATA + lo, hi - lo)

# The length of the UTF-8 character at p (1 for an invalid byte).
fn utf8_len(p: ptr, avail: int) -> int:
    let b = load_u8(p, 0)
    var n = 1
    if b >= 0x80:
        if b >> 5 == 6:
            n = 2
        elif b >> 4 == 14:
            n = 3
        elif b >> 3 == 30:
            n = 4
    if n > avail:
        return 1
    for i in 1..n:
        if load_u8(p, i) & 0xc0 != 0x80:
            return 1
    return n

# Is byte i of s inside a character, not at its start?
fn mid_char(s: ptr, i: int) -> bool:
    return i > 0 and i < load_i64(s, STR_LEN) and load_u8(s, STR_DATA + i) & 0xc0 == 0x80

fn slice_splits(s: ptr, lo: int, hi: int, loc: ptr):
    let b = lo if mid_char(s, lo) else hi
    var a = b
    while a > 0 and b - a < 3 and mid_char(s, a):
        a -= 1
    let n = utf8_len(s + STR_DATA + a, load_i64(s, STR_LEN) - a)
    if a + n <= b:
        brine_panic_at(loc, f"slice [{lo}:{hi}] starts or ends inside a character (byte {b})")
    let c = brine_str_new(s + STR_DATA + a, n)
    brine_panic_at(
        loc,
        f"slice [{lo}:{hi}] splits the character \"{str_of(c)}\" (bytes {a}..{a + n})"
    )

# Strings are UTF-8, so a slice must not cut a character in two.
fn brine_str_slice(s: ptr, lo: int, hi: int, loc: ptr) -> ptr:
    let n = load_i64(s, STR_LEN)
    if lo < 0 or lo > hi or hi > n:
        brine_panic_at(loc, f"slice [{lo}:{hi}] is out of bounds for a string of length {n}")
    if mid_char(s, lo) or mid_char(s, hi):
        slice_splits(s, lo, hi, loc)
    return sub_str(s, lo, hi)

fn brine_ord(s: ptr, loc: ptr) -> int:
    let len = load_i64(s, STR_LEN)
    let p = s + STR_DATA
    let n = utf8_len(p, len) if len != 0 else 0
    if n == 0 or n != len:
        brine_panic_at(loc, f"ord() needs exactly one character, got a string of length {len}")
    if n == 1:
        return int(load_u8(p, 0))
    var c = int(load_u8(p, 0)) & (0x7f >> n)
    for i in 1..n:
        c = (c << 6) | (int(load_u8(p, i)) & 0x3f)
    return c

fn brine_chr(c: int, loc: ptr) -> ptr:
    if c < 0 or c > 0x10ffff or (c >= 0xd800 and c <= 0xdfff):
        brine_panic_at(loc, f"chr({c}) is not a valid character")
    if c < 0x80:
        return byte_str(u8(c))
    let b = stack_mem(8)
    var n = 4
    if c < 0x800:
        store_u8(b, 0, u8(0xc0 | (c >> 6)))
        store_u8(b, 1, u8(0x80 | (c & 0x3f)))
        n = 2
    elif c < 0x10000:
        store_u8(b, 0, u8(0xe0 | (c >> 12)))
        store_u8(b, 1, u8(0x80 | ((c >> 6) & 0x3f)))
        store_u8(b, 2, u8(0x80 | (c & 0x3f)))
        n = 3
    else:
        store_u8(b, 0, u8(0xf0 | (c >> 18)))
        store_u8(b, 1, u8(0x80 | ((c >> 12) & 0x3f)))
        store_u8(b, 2, u8(0x80 | ((c >> 6) & 0x3f)))
        store_u8(b, 3, u8(0x80 | (c & 0x3f)))
    return brine_str_new(b, n)

fn brine_s_find(s: ptr, sub: ptr, loc: ptr) -> int:
    return find_from(s, sub, 0)

fn brine_s_find_from(s: ptr, sub: ptr, start: int, loc: ptr) -> int:
    let n = load_i64(s, STR_LEN)
    if start < 0 or start > n:
        brine_panic_at(loc, f"find() start {start} is out of range for a string of {n} bytes")
    return find_from(s, sub, start)

fn brine_start_chk(start: int, len: int, loc: ptr) -> int:
    if start < 0 or start > len:
        brine_panic_at(loc, f"index() start {start} is out of range for an array of length {len}")
    return start

fn push_str(pa: ptr, s: ptr):
    let slot = stack_mem(8)
    store_ptr(slot, 0, s)
    brine_arr_push(pa, slot)

fn brine_s_split(s: ptr, sep: ptr, loc: ptr) -> ptr:
    let ns = load_i64(sep, STR_LEN)
    if ns == 0:
        brine_panic_at(loc, "split() separator is empty")
    let pa = stack_mem(8)
    let none = ptr_of("") + STR_DATA
    store_ptr(pa, 0, brine_arr_new(0, 8, symbol("brine_rt_str"), symbol("brine_rl_str"), none))
    var at = 0
    while true:
        let i = find_from(s, sep, at)
        if i < 0:
            break
        push_str(pa, sub_str(s, at, i))
        at = i + ns
    push_str(pa, sub_str(s, at, load_i64(s, STR_LEN)))
    return load_ptr(pa, 0)

# ------------------------------------------------------------ string builder
# brine_sb: the bytes (a block of brine_alloc's), the length, the room

const SB_P = 0
const SB_LEN = 8
const SB_CAP = 16

extern fn memmove(d: ptr, s: ptr, n: u64) -> ptr

extern fn memset(d: ptr, c: i32, n: u64) -> ptr

# p's block (from brine_alloc) made n bytes; it may move
extern fn brine_x_realloc(p: ptr, n: int) -> ptr

extern fn brine_sb_fmt_f64(sb: ptr, v: float, prec: int, kind: int)

# pairs of decimal digits, 00 to 99
const DIGITS = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

const HEX = "0123456789abcdef"

fn brine_sb_init(sb: ptr):
    store_i64(sb, SB_CAP, 64)
    store_i64(sb, SB_LEN, 0)
    store_ptr(sb, SB_P, blk_alloc(64))

# Room for `extra` more bytes; the address they go at.
fn sb_room(sb: ptr, extra: int) -> ptr:
    let len = load_i64(sb, SB_LEN)
    let cap = load_i64(sb, SB_CAP)
    if len + extra > cap:
        var nc = cap * 2
        while nc < len + extra:
            nc *= 2
        store_ptr(sb, SB_P, brine_x_realloc(load_ptr(sb, SB_P), nc))
        store_i64(sb, SB_CAP, nc)
    return load_ptr(sb, SB_P) + len

fn brine_sb_cat(sb: ptr, p: ptr, n: int):
    copy_bytes(sb_room(sb, n), p, n)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n)

fn sb_byte(sb: ptr, c: u8):
    store_u8(sb_room(sb, 1), 0, c)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + 1)

fn sb_lit(sb: ptr, s: str):
    let p = ptr_of(s)
    brine_sb_cat(sb, p + STR_DATA, load_i64(p, STR_LEN))

fn brine_sb_str(sb: ptr, s: ptr):
    brine_sb_cat(sb, s + STR_DATA, load_i64(s, STR_LEN))

fn brine_sb_repr_str(sb: ptr, s: ptr):
    sb_byte(sb, 34)
    let n = load_i64(s, STR_LEN)
    for i in 0..n:
        let c = load_u8(s, STR_DATA + i)
        if c == 34:
            sb_lit(sb, "\\\"")
        elif c == 92:
            sb_lit(sb, "\\\\")
        elif c == 10:
            sb_lit(sb, "\\n")
        elif c == 9:
            sb_lit(sb, "\\t")
        elif c == 13:
            sb_lit(sb, "\\r")
        elif c < 0x20:
            sb_lit(sb, "\\u{")
            sb_base(sb, u64(c), 4)
            sb_byte(sb, 125)
        else:
            sb_byte(sb, c)
    sb_byte(sb, 34)

# The number of decimal digits of u.
fn dec_len(u: u64) -> int:
    var n = 1
    var t: u64 = 10
    while u >= t:
        n += 1
        if n == 20:
            return 20
        t *= 10
    return n

# u in decimal, its last digit at d + n - 1 (n is dec_len(u))
fn put_dec(d: ptr, n: int, u0: u64):
    let t = ptr_of(DIGITS) + STR_DATA
    var u = u0
    var i = n
    while u >= 100:
        let r = int(u % 100)
        u = u / 100
        i -= 2
        store_u16(d, i, load_u16(t, r * 2))
    if u >= 10:
        store_u16(d, i - 2, load_u16(t, int(u) * 2))
    else:
        store_u8(d, i - 1, u8(48 + u))

fn brine_sb_u64(sb: ptr, v: u64):
    let n = dec_len(v)
    put_dec(sb_room(sb, n), n, v)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n)

fn brine_sb_i64(sb: ptr, v: int):
    if v >= 0:
        brine_sb_u64(sb, u64(v))
        return
    # (wraps for the smallest int)
    let u = u64(0) - u64(v)
    let n = dec_len(u)
    let d = sb_room(sb, n + 1)
    store_u8(d, 0, 45)
    put_dec(d + 1, n, u)
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n + 1)

fn brine_sb_bool(sb: ptr, v: bool):
    sb_lit(sb, "true" if v else "false")

# u in base 2^bits (hex: 4, binary: 1)
fn sb_base(sb: ptr, u: u64, bits: u64):
    let most = int(64 / bits)
    var n = 1
    while n < most and u >> (u64(n) * bits) != 0:
        n += 1
    let d = sb_room(sb, n)
    let t = ptr_of(HEX) + STR_DATA
    let mask = (u64(1) << bits) - 1
    var x = u
    var i = n
    while i > 0:
        i -= 1
        store_u8(d, i, load_u8(t, int(x & mask)))
        x = x >> bits
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n)

fn brine_sb_fmt_i64(sb: ptr, v: int, kind: int):
    if kind == 120 or kind == 98:
        if v < 0:
            sb_byte(sb, 45)
        let u = u64(0) - u64(v) if v < 0 else u64(v)
        sb_base(sb, u, 4 if kind == 120 else 1)
        return
    if kind == 102 or kind == 101 or kind == 103:
        brine_sb_fmt_f64(sb, float(v), -1, kind)
        return
    brine_sb_i64(sb, v)

fn brine_sb_fmt_u64(sb: ptr, v: u64, kind: int):
    if kind == 120 or kind == 98:
        sb_base(sb, v, 4 if kind == 120 else 1)
    elif kind == 102 or kind == 101 or kind == 103:
        brine_sb_fmt_f64(sb, float(v), -1, kind)
    else:
        brine_sb_u64(sb, v)

fn is_digit(c: u8) -> bool:
    return c >= 48 and c <= 57

# `{x:,}`: commas between groups of three digits in the integer part of the
# number written from `start` on
fn brine_sb_group(sb: ptr, start: int):
    var p = load_ptr(sb, SB_P)
    let len = load_i64(sb, SB_LEN)
    var a = start
    if a < len and (load_u8(p, a) == 45 or load_u8(p, a) == 43):
        a += 1
    var b = a
    while b < len and is_digit(load_u8(p, b)):
        b += 1
    let n = b - a
    let k = (n - 1) / 3
    if n <= 3:
        return
    sb_room(sb, k)
    p = load_ptr(sb, SB_P)
    memmove(p + b + k, p + b, u64(len - b))
    store_i64(sb, SB_LEN, len + k)
    # from the right: copy digits, a comma after every third
    var from = b - 1
    var to = b + k - 1
    var i = 0
    while from >= a:
        if i > 0 and i % 3 == 0:
            store_u8(p, to, 44)
            to -= 1
        store_u8(p, to, load_u8(p, from))
        to -= 1
        from -= 1
        i += 1

fn brine_sb_pad(sb: ptr, start: int, width: int, left: bool, zero: bool):
    let len = load_i64(sb, SB_LEN)
    let n = len - start
    if n >= width:
        return
    let pad = width - n
    sb_room(sb, pad)
    let p = load_ptr(sb, SB_P)
    if left:
        memset(p + len, 32, u64(pad))
    else:
        var at = start
        if zero and n > 0 and (load_u8(p, start) == 45 or load_u8(p, start) == 43):
            at += 1
        memmove(p + at + pad, p + at, u64(len - at))
        memset(p + at, 48 if zero else 32, u64(pad))
    store_i64(sb, SB_LEN, len + pad)

fn brine_sb_finish(sb: ptr) -> ptr:
    let p = load_ptr(sb, SB_P)
    let s = brine_str_new(p, load_i64(sb, SB_LEN))
    blk_free(p)
    store_u64(sb, SB_P, 0)
    return s

# ------------------------------------------------------------ arrays
# brine_arr: a count, the length, the room, the element size, the
# functions that retain and release an element (0 for plain data), the
# elements

const ARR_RC = 0
const ARR_LEN = 8
const ARR_CAP = 16
const ARR_ESZ = 24
const ARR_RT = 32
const ARR_RL = 40
const ARR_DATA = 48
const ARR_SIZE = 56

# n zero bytes from the C library's heap
extern fn brine_x_calloc(n: int) -> ptr

extern fn memchr(p: ptr, c: i32, n: u64) -> ptr

extern fn brine_panic_idx(i: int, len: int, loc: ptr)

# Is block p from our own heap (brine_rt.c's br_in_heap)?
fn in_heap(p: ptr) -> bool:
    let hi = symbol("brine_heap_info")
    let base = load_u64(hi, HI_BASE)
    return addr(p) - base < load_u64(hi, HI_END) - base

# an array header with count 1
fn arr_header(len: int, cap: int, esz: int, rt: ptr, rl: ptr) -> ptr:
    let a = new_counted(ARR_SIZE)
    store_i64(a, ARR_RC, 1)
    store_i64(a, ARR_LEN, len)
    store_i64(a, ARR_CAP, cap)
    store_i64(a, ARR_ESZ, esz)
    store_ptr(a, ARR_RT, rt)
    store_ptr(a, ARR_RL, rl)
    store_u64(a, ARR_DATA, 0)
    return a

# frees the elements first, past a depth on a list (brine_drop)
extern fn brine_x_arr_drop(a: ptr)

fn brine_arr_free(a: ptr):
    if addr(load_ptr(a, ARR_RL)) != 0:
        brine_x_arr_drop(a)
        return
    let d = load_ptr(a, ARR_DATA)
    if addr(d) != 0:
        blk_free(d)
    free_counted(a)

fn neg_len(len: int, loc: ptr):
    brine_panic_at(loc, f"cannot create an array with negative length {len}")

fn brine_arr_new(len: int, esz: int, rt: ptr, rl: ptr, loc: ptr) -> ptr:
    if len < 0:
        neg_len(len, loc)
    let a = arr_header(len, len, esz, rt, rl)
    # no data until the first push: `xs[i] = []`, which takes an inner
    # array out to change it, then costs one allocation, not two
    if len == 0:
        return a
    if esz > 0 and len <= SMALL / esz:
        # small: a block of our heap, whose spare room the first pushes use
        # (`[]` then `push` doesn't reallocate)
        let bytes = len * esz
        let d = blk_alloc(bytes)
        memset(d, 0, u64(bytes))
        store_ptr(a, ARR_DATA, d)
        if in_heap(d):
            store_i64(a, ARR_CAP, class_size(size_class(bytes)) / esz)
        return a
    store_ptr(a, ARR_DATA, brine_x_calloc(len * esz))
    return a

# An integer array kept as bytes (narrow.br), zeroed, with 16 more bytes
# than it needs for brine_bytes_rev and friends. It is never shared, so
# never copied.
fn brine_bytes_new(len: int, loc: ptr) -> ptr:
    if len < 0:
        neg_len(len, loc)
    let a = arr_header(len, len + 16, 1, null_ptr(), null_ptr())
    store_ptr(a, ARR_DATA, brine_x_calloc(len + 16))
    return a

# A `[bool]` kept as bits (the compiler's pack.br): `len` elements in 64-bit
# words. `esz` 0 marks it; only indexing, `len` and freeing ever see one.
fn brine_bits_new(len: int, fill: int, loc: ptr) -> ptr:
    if len < 0:
        neg_len(len, loc)
    let a = arr_header(len, len, 0, null_ptr(), null_ptr())
    let bytes = (len / 64 + 1) * 8
    let d = brine_x_calloc(bytes)
    if fill != 0:
        memset(d, 0xff, u64(bytes))
    store_ptr(a, ARR_DATA, d)
    return a

# Calls f (an element's retain or release) on each of the n elements at d.
fn each_elem(f: ptr, d: ptr, n: int, esz: int):
    for i in 0..n:
        call_void(f, d + i * esz)

fn brine_arr_unique(pa: ptr):
    let a = load_ptr(pa, 0)
    if load_i64(a, ARR_RC) == 1:
        return
    let n = new_counted(ARR_SIZE)
    memcpy(n, a, u64(ARR_SIZE))
    let len = load_i64(a, ARR_LEN)
    let esz = load_i64(a, ARR_ESZ)
    store_i64(n, ARR_RC, 1)
    store_i64(n, ARR_CAP, len)
    let bytes = len * esz if esz != 0 else (len / 64 + 1) * 8
    let d = blk_alloc(bytes)
    memcpy(d, load_ptr(a, ARR_DATA), u64(bytes))
    store_ptr(n, ARR_DATA, d)
    let rt = load_ptr(a, ARR_RT)
    if addr(rt) != 0:
        each_elem(rt, d, len, esz)
    arr_release(a)
    store_ptr(pa, 0, n)

fn arr_reserve(a: ptr, need: int):
    let cap = load_i64(a, ARR_CAP)
    if need <= cap:
        return
    var nc = cap * 2 if cap != 0 else 4
    if nc < need:
        nc = need
    let d = brine_x_realloc(load_ptr(a, ARR_DATA), nc * load_i64(a, ARR_ESZ))
    store_ptr(a, ARR_DATA, d)
    store_i64(a, ARR_CAP, nc)

# the address of element i
fn elem_at(a: ptr, i: int) -> ptr:
    return load_ptr(a, ARR_DATA) + i * load_i64(a, ARR_ESZ)

fn brine_arr_push(pa: ptr, elem: ptr):
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let len = load_i64(a, ARR_LEN)
    arr_reserve(a, len + 1)
    copy_bytes(elem_at(a, len), elem, load_i64(a, ARR_ESZ))
    store_i64(a, ARR_LEN, len + 1)

fn brine_arr_pop(pa: ptr, out: ptr, loc: ptr):
    if load_i64(load_ptr(pa, 0), ARR_LEN) == 0:
        brine_panic_at(loc, "pop() from an empty array")
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let len = load_i64(a, ARR_LEN) - 1
    store_i64(a, ARR_LEN, len)
    copy_bytes(out, elem_at(a, len), load_i64(a, ARR_ESZ))

fn brine_arr_pop_at(pa: ptr, i: int, out: ptr, loc: ptr):
    let len0 = load_i64(load_ptr(pa, 0), ARR_LEN)
    if u64(i) >= u64(len0):
        brine_panic_idx(i, len0, loc)
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let len = load_i64(a, ARR_LEN)
    copy_bytes(out, elem_at(a, i), esz)
    memmove(elem_at(a, i), elem_at(a, i + 1), u64((len - i - 1) * esz))
    store_i64(a, ARR_LEN, len - 1)

fn brine_arr_insert(pa: ptr, i: int, elem: ptr, loc: ptr):
    let a0 = load_ptr(pa, 0)
    let len0 = load_i64(a0, ARR_LEN)
    if i < 0 or i > len0:
        let rl = load_ptr(a0, ARR_RL)
        if addr(rl) != 0:
            call_void(rl, elem)
        brine_panic_at(loc, f"insert index {i} is out of bounds for length {len0}")
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let len = load_i64(a, ARR_LEN)
    arr_reserve(a, len + 1)
    memmove(elem_at(a, i + 1), elem_at(a, i), u64((len - i) * esz))
    copy_bytes(elem_at(a, i), elem, esz)
    store_i64(a, ARR_LEN, len + 1)

fn brine_arr_extend(pa: ptr, b: ptr):
    let n = load_i64(b, ARR_LEN)
    if n == 0:
        return
    # b may be *pa itself
    arr_retain(b)
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let len = load_i64(a, ARR_LEN)
    arr_reserve(a, len + n)
    let d = elem_at(a, len)
    memcpy(d, load_ptr(b, ARR_DATA), u64(n * esz))
    let rt = load_ptr(a, ARR_RT)
    if addr(rt) != 0:
        each_elem(rt, d, n, esz)
    store_i64(a, ARR_LEN, len + n)
    arr_release(b)

# a `str` argument of an `extern fn`: a NUL-terminated copy for the call
fn brine_cstr(s: ptr, loc: ptr) -> ptr:
    let n = load_i64(s, STR_LEN)
    let z = memchr(s + STR_DATA, 0, u64(n))
    if addr(z) != 0:
        let at = addr(z) - addr(s + STR_DATA)
        brine_panic_at(loc, f"a string passed to an extern function contains a NUL byte (at {at})")
    let p = blk_alloc(n + 1)
    memcpy(p, s + STR_DATA, u64(n))
    store_u8(p, n, 0)
    return p

fn brine_cstr_free(p: ptr):
    blk_free(p)

# A new array of the n elements at d, each retained.
fn copy_elems(a: ptr, d: ptr, n: int, loc: ptr) -> ptr:
    let esz = load_i64(a, ARR_ESZ)
    let rt = load_ptr(a, ARR_RT)
    let r = brine_arr_new(n, esz, rt, load_ptr(a, ARR_RL), loc)
    memcpy(load_ptr(r, ARR_DATA), d, u64(n * esz))
    if addr(rt) != 0:
        each_elem(rt, load_ptr(r, ARR_DATA), n, esz)
    return r

# `a + b`: a new array (or a shared one when a side is empty)
fn brine_arr_concat(a: ptr, b: ptr, loc: ptr) -> ptr:
    let la = load_i64(a, ARR_LEN)
    let lb = load_i64(b, ARR_LEN)
    if la == 0 or lb == 0:
        let r = b if la == 0 else a
        arr_retain(r)
        return r
    let esz = load_i64(a, ARR_ESZ)
    let rt = load_ptr(a, ARR_RT)
    let r = brine_arr_new(la + lb, esz, rt, load_ptr(a, ARR_RL), loc)
    let d = load_ptr(r, ARR_DATA)
    memcpy(d, load_ptr(a, ARR_DATA), u64(la * esz))
    memcpy(d + la * esz, load_ptr(b, ARR_DATA), u64(lb * load_i64(b, ARR_ESZ)))
    if addr(rt) != 0:
        each_elem(rt, d, la + lb, esz)
    return r

fn brine_arr_reverse(pa: ptr):
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let small = stack_mem(64)
    let t = small if esz <= 64 else blk_alloc(esz)
    var i = 0
    var j = load_i64(a, ARR_LEN) - 1
    while i < j:
        copy_bytes(t, elem_at(a, i), esz)
        copy_bytes(elem_at(a, i), elem_at(a, j), esz)
        copy_bytes(elem_at(a, j), t, esz)
        i += 1
        j -= 1
    if esz > 64:
        blk_free(t)

fn brine_arr_clear(pa: ptr):
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let rl = load_ptr(a, ARR_RL)
    if load_i64(a, ARR_RC) != 1:
        store_ptr(pa, 0, brine_arr_new(0, esz, load_ptr(a, ARR_RT), rl, ptr_of("") + STR_DATA))
        arr_release(a)
        return
    if addr(rl) != 0:
        each_elem(rl, load_ptr(a, ARR_DATA), load_i64(a, ARR_LEN), esz)
    store_i64(a, ARR_LEN, 0)

# A stable merge sort of the n elements at d; tmp holds n / 2 + 1.
fn msort(d: ptr, tmp: ptr, n: int, esz: int, cmp: ptr):
    if n < 2:
        return
    let h = n / 2
    msort(d, tmp, h, esz, cmp)
    msort(d + h * esz, tmp, n - h, esz, cmp)
    if call_i32(cmp, d + (h - 1) * esz, d + h * esz) <= 0:
        return
    memcpy(tmp, d, u64(h * esz))
    var i = 0
    var j = h
    var k = 0
    while i < h and j < n:
        if call_i32(cmp, d + j * esz, tmp + i * esz) < 0:
            copy_bytes(d + k * esz, d + j * esz, esz)
            j += 1
        else:
            copy_bytes(d + k * esz, tmp + i * esz, esz)
            i += 1
        k += 1
    while i < h:
        copy_bytes(d + k * esz, tmp + i * esz, esz)
        k += 1
        i += 1

fn brine_arr_sort(pa: ptr, cmp: ptr):
    if load_i64(load_ptr(pa, 0), ARR_LEN) < 2:
        return
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let len = load_i64(a, ARR_LEN)
    let esz = load_i64(a, ARR_ESZ)
    let tmp = blk_alloc((len / 2 + 1) * esz)
    msort(load_ptr(a, ARR_DATA), tmp, len, esz, cmp)
    blk_free(tmp)

fn brine_arr_slice(a: ptr, lo: int, hi: int, loc: ptr) -> ptr:
    let len = load_i64(a, ARR_LEN)
    if lo < 0 or lo > hi or hi > len:
        brine_panic_at(loc, f"slice [{lo}:{hi}] is out of bounds for an array of length {len}")
    if lo == 0 and hi == len:
        arr_retain(a)
        return a
    return copy_elems(a, elem_at(a, lo), hi - lo, loc)

# ------------------------------------------------------------ maps
# brine_map: entries in insertion order (keys, values, hashes, live flags;
# slots [0, used)) and `index`, an open-addressing table of entry numbers:
# -1 empty, -2 removed. brine_map_ty: the key and value sizes, then the
# functions that hash, compare, write and retain or release them.

const MAP_USED = 16
const MAP_CAP = 24
const MAP_TY = 40
const MAP_LIVE = 72
const MAP_SIZE = 88

const MT_KSZ = 0
const MT_VSZ = 8
const MT_HASH = 16
const MT_KEQ = 24
const MT_VEQ = 32
const MT_KFMT = 40
const MT_KRT = 48
const MT_KRL = 56
const MT_VRT = 64
const MT_VRL = 72

# frees a map whose keys or values hold something, past a depth on a list
# (brine_drop)
extern fn brine_x_map_drop(m: ptr)

fn brine_map_new(ty: ptr) -> ptr:
    let m = new_counted(MAP_SIZE)
    memset(m, 0, u64(MAP_SIZE))
    store_i64(m, MAP_RC, 1)
    store_ptr(m, MAP_TY, ty)
    return m

fn free_if(p: ptr):
    if addr(p) != 0:
        blk_free(p)

fn brine_map_free(m: ptr):
    let t = load_ptr(m, MAP_TY)
    if addr(load_ptr(t, MT_KRL)) != 0 or addr(load_ptr(t, MT_VRL)) != 0:
        brine_x_map_drop(m)
        return
    free_if(load_ptr(m, MAP_KEYS))
    free_if(load_ptr(m, MAP_VALS))
    free_if(load_ptr(m, MAP_HASHES))
    free_if(load_ptr(m, MAP_LIVE))
    free_if(load_ptr(m, MAP_INDEX))
    free_counted(m)

# The index made again for the entries (a sparse one: fewer probes, and few
# maps are big enough for it to cost much).
fn map_reindex(m: ptr):
    var n = 8
    while n < 4 * load_i64(m, MAP_CAP):
        n *= 2
    free_if(load_ptr(m, MAP_INDEX))
    store_i64(m, MAP_NIDX, n)
    let ix = blk_alloc(n * 8)
    # all -1
    memset(ix, 0xff, u64(n * 8))
    store_ptr(m, MAP_INDEX, ix)
    let mask = u64(n - 1)
    let hs = load_ptr(m, MAP_HASHES)
    let live = load_ptr(m, MAP_LIVE)
    for e in 0..load_i64(m, MAP_USED):
        if not load_bool(live, e):
            continue
        var i = load_u64(hs, e * 8) & mask
        while load_i64(ix, int(i) * 8) != -1:
            i = (i + 1) & mask
        store_i64(ix, int(i) * 8, e)

# The entry arrays with room for `cap` entries (at least `used`), without
# the removed ones.
fn map_resize_cold(m: ptr, cap: int):
    let t = load_ptr(m, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let ok = load_ptr(m, MAP_KEYS)
    let ov = load_ptr(m, MAP_VALS)
    let oh = load_ptr(m, MAP_HASHES)
    let ol = load_ptr(m, MAP_LIVE)
    let used = load_i64(m, MAP_USED)
    if used == load_i64(m, MAP_LEN):
        # nothing removed: the arrays just grow
        store_ptr(m, MAP_KEYS, brine_x_realloc(ok, cap * ksz + 1))
        store_ptr(m, MAP_VALS, brine_x_realloc(ov, cap * vsz + 1))
        store_ptr(m, MAP_HASHES, brine_x_realloc(oh, cap * 8))
        store_ptr(m, MAP_LIVE, brine_x_realloc(ol, cap))
    else:
        let k = blk_alloc(cap * ksz + 1)
        let v = blk_alloc(cap * vsz + 1)
        let h = blk_alloc(cap * 8)
        let l = blk_alloc(cap)
        var j = 0
        for i in 0..used:
            if not load_bool(ol, i):
                continue
            copy_bytes(k + j * ksz, ok + i * ksz, ksz)
            copy_bytes(v + j * vsz, ov + i * vsz, vsz)
            store_u64(h, j * 8, load_u64(oh, i * 8))
            store_bool(l, j, true)
            j += 1
        free_if(ok)
        free_if(ov)
        free_if(oh)
        free_if(ol)
        store_ptr(m, MAP_KEYS, k)
        store_ptr(m, MAP_VALS, v)
        store_ptr(m, MAP_HASHES, h)
        store_ptr(m, MAP_LIVE, l)
        store_i64(m, MAP_USED, j)
    store_i64(m, MAP_CAP, cap)
    map_reindex(m)

# A copy of block p's first n bytes in a new block of n + 1 bytes.
fn dup_bytes(p: ptr, n: int) -> ptr:
    let d = blk_alloc(n + 1)
    if n > 0:
        memcpy(d, p, u64(n))
    return d

fn brine_map_unique(pm: ptr):
    map_own(pm)

# Makes *pm a map nothing else holds, to change it.
fn map_own(pm: ptr):
    if load_i64(load_ptr(pm, 0), MAP_RC) != 1:
        map_copy_cold(pm)

fn map_copy_cold(pm: ptr):
    let a = load_ptr(pm, 0)
    let t = load_ptr(a, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let n = brine_map_new(t)
    # copies of the entry arrays; map_resize_cold then compacts them and makes
    # the index
    let used = load_i64(a, MAP_USED)
    store_i64(n, MAP_USED, used)
    store_ptr(n, MAP_KEYS, dup_bytes(load_ptr(a, MAP_KEYS), used * ksz))
    store_ptr(n, MAP_VALS, dup_bytes(load_ptr(a, MAP_VALS), used * vsz))
    store_ptr(n, MAP_HASHES, dup_bytes(load_ptr(a, MAP_HASHES), used * 8))
    store_ptr(n, MAP_LIVE, dup_bytes(load_ptr(a, MAP_LIVE), used))
    let len = load_i64(a, MAP_LEN)
    store_i64(n, MAP_LEN, len)
    map_resize_cold(n, len if len > 4 else 4)
    let krt = load_ptr(t, MT_KRT)
    let vrt = load_ptr(t, MT_VRT)
    if addr(krt) != 0:
        each_elem(krt, load_ptr(n, MAP_KEYS), load_i64(n, MAP_USED), ksz)
    if addr(vrt) != 0:
        each_elem(vrt, load_ptr(n, MAP_VALS), load_i64(n, MAP_USED), vsz)
    map_release(a)
    store_ptr(pm, 0, n)

# The entry of key k (hash h) in m, or -1.
fn map_lookup(m: ptr, k: ptr, h: u64) -> int:
    let t = load_ptr(m, MAP_TY)
    return map_probe(m, k, h, load_ptr(t, MT_KEQ), load_i64(t, MT_KSZ), false)

fn brine_map_find(m: ptr, k: ptr) -> int:
    if load_i64(m, MAP_LEN) == 0:
        return -1
    return map_lookup(m, k, call_u64(load_ptr(load_ptr(m, MAP_TY), MT_HASH), k))

fn map_missing_cold(m: ptr, k: ptr, loc: ptr):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, "key ")
    call_void(load_ptr(load_ptr(m, MAP_TY), MT_KFMT), sb, k)
    sb_lit(sb, " is not in the map")
    brine_panic_at(loc, str_of(brine_sb_finish(sb)))

fn brine_map_at(m: ptr, k: ptr, loc: ptr) -> ptr:
    let e = brine_map_find(m, k)
    if e < 0:
        map_missing_cold(m, k, loc)
    return load_ptr(m, MAP_VALS) + e * load_i64(load_ptr(m, MAP_TY), MT_VSZ)

# The value of entry e (of key k) after making the map unique; copying it
# compacts the entries, so e can change.
fn val_unique(pm: ptr, e0: int, k: ptr) -> ptr:
    let before = load_ptr(pm, 0)
    map_own(pm)
    let m = load_ptr(pm, 0)
    let e = e0 if m == before else brine_map_find(m, k)
    return load_ptr(m, MAP_VALS) + e * load_i64(load_ptr(m, MAP_TY), MT_VSZ)

fn brine_map_at_mut(pm: ptr, k: ptr, loc: ptr) -> ptr:
    let e = brine_map_find(load_ptr(pm, 0), k)
    if e < 0:
        map_missing_cold(load_ptr(pm, 0), k, loc)
    return val_unique(pm, e, k)

fn brine_map_val_mut_slow(pm: ptr, e: int, k: ptr, loc: ptr) -> ptr:
    if e < 0:
        # panics
        return brine_map_at_mut(pm, k, loc)
    return val_unique(pm, e, k)

fn brine_map_set(pm: ptr, k: ptr, v: ptr):
    map_own(pm)
    let m = load_ptr(pm, 0)
    let t = load_ptr(m, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let h = call_u64(load_ptr(t, MT_HASH), k)
    let found = map_lookup(m, k, h)
    if found >= 0:
        let krl = load_ptr(t, MT_KRL)
        if addr(krl) != 0:
            call_void(krl, k)
        let vp = load_ptr(m, MAP_VALS) + found * vsz
        let vrl = load_ptr(t, MT_VRL)
        if addr(vrl) != 0:
            call_void(vrl, vp)
        copy_bytes(vp, v, vsz)
        return
    if load_i64(m, MAP_USED) == load_i64(m, MAP_CAP):
        let n = load_i64(m, MAP_LEN) * 2
        map_resize_cold(m, n if n > 8 else 8)
    let e = load_i64(m, MAP_USED)
    store_i64(m, MAP_USED, e + 1)
    copy_bytes(load_ptr(m, MAP_KEYS) + e * ksz, k, ksz)
    copy_bytes(load_ptr(m, MAP_VALS) + e * vsz, v, vsz)
    store_u64(load_ptr(m, MAP_HASHES), e * 8, h)
    store_bool(load_ptr(m, MAP_LIVE), e, true)
    store_i64(m, MAP_LEN, load_i64(m, MAP_LEN) + 1)
    let mask = load_u64(m, MAP_NIDX) - 1
    let ix = load_ptr(m, MAP_INDEX)
    var i = h & mask
    while load_i64(ix, int(i) * 8) >= 0:
        i = (i + 1) & mask
    store_i64(ix, int(i) * 8, e)

fn brine_map_remove(pm: ptr, k: ptr) -> bool:
    if brine_map_find(load_ptr(pm, 0), k) < 0:
        return false
    map_own(pm)
    let m = load_ptr(pm, 0)
    let t = load_ptr(m, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let h = call_u64(load_ptr(t, MT_HASH), k)
    let e = map_lookup(m, k, h)
    let mask = load_u64(m, MAP_NIDX) - 1
    let ix = load_ptr(m, MAP_INDEX)
    var i = h & mask
    while load_i64(ix, int(i) * 8) != e:
        i = (i + 1) & mask
    store_i64(ix, int(i) * 8, -2)
    store_bool(load_ptr(m, MAP_LIVE), e, false)
    store_i64(m, MAP_LEN, load_i64(m, MAP_LEN) - 1)
    let krl = load_ptr(t, MT_KRL)
    if addr(krl) != 0:
        call_void(krl, load_ptr(m, MAP_KEYS) + e * ksz)
    let vrl = load_ptr(t, MT_VRL)
    if addr(vrl) != 0:
        call_void(vrl, load_ptr(m, MAP_VALS) + e * load_i64(t, MT_VSZ))
    return true

# The keys or the values, as an array.
fn map_column(m: ptr, keys: bool) -> ptr:
    let t = load_ptr(m, MAP_TY)
    let sz = load_i64(t, MT_KSZ if keys else MT_VSZ)
    let rt = load_ptr(t, MT_KRT if keys else MT_VRT)
    let rl = load_ptr(t, MT_KRL if keys else MT_VRL)
    let a = brine_arr_new(load_i64(m, MAP_LEN), sz, rt, rl, ptr_of("") + STR_DATA)
    let src = load_ptr(m, MAP_KEYS if keys else MAP_VALS)
    let live = load_ptr(m, MAP_LIVE)
    let d = load_ptr(a, ARR_DATA)
    var j = 0
    for i in 0..load_i64(m, MAP_USED):
        if not load_bool(live, i):
            continue
        copy_bytes(d + j * sz, src + i * sz, sz)
        if addr(rt) != 0:
            call_void(rt, d + j * sz)
        j += 1
    return a

fn brine_map_keys(m: ptr) -> ptr:
    return map_column(m, true)

fn brine_map_values(m: ptr) -> ptr:
    return map_column(m, false)

fn brine_map_eq(a: ptr, b: ptr) -> bool:
    if a == b:
        return true
    if load_i64(a, MAP_LEN) != load_i64(b, MAP_LEN):
        return false
    let t = load_ptr(a, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let veq = load_ptr(t, MT_VEQ)
    let live = load_ptr(a, MAP_LIVE)
    for i in 0..load_i64(a, MAP_USED):
        if not load_bool(live, i):
            continue
        let k = load_ptr(a, MAP_KEYS) + i * ksz
        let e = map_lookup(b, k, load_u64(load_ptr(a, MAP_HASHES), i * 8))
        if e < 0:
            return false
        if not call_bool(veq, load_ptr(a, MAP_VALS) + i * vsz, load_ptr(b, MAP_VALS) + e * vsz):
            return false
    return true
