const MLOG10_IVLN10HI: float = 0.4342944818781689
const MLOG10_IVLN10LO: float = 2.5082946711645275e-11
const MLOG10_LOG10_2HI: float = 0.30102999566361177
const MLOG10_LOG10_2LO: float = 3.694239077158931e-13
const MLOG10_LG1: float = 0.6666666666666735
const MLOG10_LG2: float = 0.3999999999940942
const MLOG10_LG3: float = 0.2857142874366239
const MLOG10_LG4: float = 0.22222198432149784
const MLOG10_LG5: float = 0.1818357216161805
const MLOG10_LG6: float = 0.15313837699209373
const MLOG10_LG7: float = 0.14798198605116586
const MLOG1P_LN2_HI: float = 0.6931471803691238
const MLOG1P_LN2_LO: float = 1.9082149292705877e-10
const MLOG1P_LG1: float = 0.6666666666666735
const MLOG1P_LG2: float = 0.3999999999940942
const MLOG1P_LG3: float = 0.2857142874366239
const MLOG1P_LG4: float = 0.22222198432149784
const MLOG1P_LG5: float = 0.1818357216161805
const MLOG1P_LG6: float = 0.15313837699209373
const MLOG1P_LG7: float = 0.14798198605116586
const MLOG_P27: float = 134217728.0
const MLOG_P52: float = 4503599627370496.0
const MLOG_P54: float = 1.8014398509481984e+16
const MLOG_LO: u64 = 0x3fee000000000000
const MLOG_HI: u64 = 0x3ff1090000000000
const MLOG2_LO: u64 = 0x3feea4af00000000
const MLOG2_HI: u64 = 0x3ff0b55900000000

fn mlog_divzero(sign: bool) -> float:
    return (-1.0 if sign else 1.0) / 0.0

fn mlog_invalid(x: float) -> float:
    return (x - x) / (x - x)

fn f_log(x: float) -> float:
    var ix = x.to_bits()
    let top = ix >> 48
    if ix.wrapping_sub(MLOG_LO) < MLOG_HI - MLOG_LO:
        # close to 1.0
        if ix == MLOG_ONE:
            return 0.0
        let r = x - 1.0
        let r2 = r * r
        let r3 = r * r2
        var y = r3 * (
            MLOG_B1
            + r * MLOG_B2
            + r2 * MLOG_B3
            + r3 * (
                MLOG_B4
                + r * MLOG_B5
                + r2 * MLOG_B6
                + r3 * (MLOG_B7 + r * MLOG_B8 + r2 * MLOG_B9 + r3 * MLOG_B10)
            )
        )
        var w = r * MLOG_P27
        let rhi = r + w - w
        let rlo = r - rhi
        w = rhi * rhi * MLOG_B0
        let hi = r + w
        var lo = r - hi + w
        lo += MLOG_B0 * rlo * (rhi + r)
        y += lo
        y += hi
        return y
    if top.wrapping_sub(0x0010) >= 0x7ff0 - 0x0010:
        # x < 0x1p-1022 or inf or nan
        if ix << 1 == 0:
            return mlog_divzero(true)
        if ix == MLOG_INF:
            return x
        if (top & 0x8000) != 0 or (top & 0x7ff0) == 0x7ff0:
            return mlog_invalid(x)
        # subnormal: normalize
        ix = (x * MLOG_P52).to_bits()
        ix = ix.wrapping_sub(u64(52) << 52)
    let tmp = ix.wrapping_sub(MLOG_OFF)
    let i = (tmp >> 44) & 0xfe  # 2 * ((tmp >> 45) % N): T holds pairs
    let kd = float(int(tmp) >> 52)
    let iz = ix.wrapping_sub(tmp & MLOG_TOPMASK)
    let invc = float.from_bits(MLOG_T[i])
    let logc = float.from_bits(MLOG_T[i + 1])
    let z = float.from_bits(iz)
    let r = (z - float.from_bits(MLOG_T2[i]) - float.from_bits(MLOG_T2[i + 1])) * invc
    let w = kd * MLOG_LN2HI + logc
    let hi = w + r
    let lo = w - hi + r + kd * MLOG_LN2LO
    let r2 = r * r
    return lo + r2 * MLOG_A0 + r * r2 * (MLOG_A1 + r * MLOG_A2 + r2 * (MLOG_A3 + r * MLOG_A4)) + hi

fn f_log2(x: float) -> float:
    var ix = x.to_bits()
    let top = ix >> 48
    if ix.wrapping_sub(MLOG2_LO) < MLOG2_HI - MLOG2_LO:
        # close to 1.0
        if ix == MLOG_ONE:
            return 0.0
        let r = x - 1.0
        let rhi = float.from_bits(r.to_bits() & MLOG_HIMASK)
        let rlo = r - rhi
        let hi = rhi * MLOG2_INVLN2HI
        var lo = rlo * MLOG2_INVLN2HI + r * MLOG2_INVLN2LO
        let r2 = r * r
        let r4 = r2 * r2
        let p = r2 * (MLOG2_B0 + r * MLOG2_B1)
        var y = hi + p
        lo += hi - y + p
        lo += r4 * (
            MLOG2_B2
            + r * MLOG2_B3
            + r2 * (MLOG2_B4 + r * MLOG2_B5)
            + r4 * (MLOG2_B6 + r * MLOG2_B7 + r2 * (MLOG2_B8 + r * MLOG2_B9))
        )
        y += lo
        return y
    if top.wrapping_sub(0x0010) >= 0x7ff0 - 0x0010:
        # x < 0x1p-1022 or inf or nan
        if ix << 1 == 0:
            return mlog_divzero(true)
        if ix == MLOG_INF:
            return x
        if (top & 0x8000) != 0 or (top & 0x7ff0) == 0x7ff0:
            return mlog_invalid(x)
        # subnormal: normalize
        ix = (x * MLOG_P52).to_bits()
        ix = ix.wrapping_sub(u64(52) << 52)
    let tmp = ix.wrapping_sub(MLOG_OFF)
    let i = (tmp >> 45) & 0x7e  # 2 * ((tmp >> 46) % N): T holds pairs
    let kd = float(int(tmp) >> 52)
    let iz = ix.wrapping_sub(tmp & MLOG_TOPMASK)
    let invc = float.from_bits(MLOG2_T[i])
    let logc = float.from_bits(MLOG2_T[i + 1])
    let z = float.from_bits(iz)
    let r = (z - float.from_bits(MLOG2_T2[i]) - float.from_bits(MLOG2_T2[i + 1])) * invc
    let rhi = float.from_bits(r.to_bits() & MLOG_HIMASK)
    let rlo = r - rhi
    let t1 = rhi * MLOG2_INVLN2HI
    let t2 = rlo * MLOG2_INVLN2HI + r * MLOG2_INVLN2LO
    let t3 = kd + logc
    let hi = t3 + t1
    let lo = t3 - hi + t1 + t2
    let r2 = r * r
    let r4 = r2 * r2
    let p = (
        MLOG2_A0 + r * MLOG2_A1 + r2 * (MLOG2_A2 + r * MLOG2_A3) + r4 * (MLOG2_A4 + r * MLOG2_A5)
    )
    return lo + r2 * p + hi

fn f_log10(mut x: float) -> float:
    var u = x.to_bits()
    var hx = u >> 32  # uint32_t
    # C's int k, kept as the double dk it becomes (small integers: exact)
    var dk = 0.0
    if hx < 0x00100000 or hx >= 0x80000000:
        if u << 1 == 0:
            return -1.0 / (x * x)  # log(+-0) = -inf
        if hx >= 0x80000000:
            return (x - x) / 0.0  # log(-#) = NaN
        # subnormal: scale x up
        dk -= 54.0
        x *= MLOG_P54
        u = x.to_bits()
        hx = u >> 32
    elif hx >= 0x7ff00000:
        return x
    elif hx == 0x3ff00000 and u << 32 == 0:
        return 0.0
    # reduce x into [sqrt(2)/2, sqrt(2)]
    hx += 0x3ff00000 - 0x3fe6a09e
    dk += float(hx >> 20) - 1023.0  # k += (int)(hx>>20) - 0x3ff
    hx = (hx & 0x000fffff) + 0x3fe6a09e
    u = (hx << 32) | (u & 0xffffffff)
    x = float.from_bits(u)
    let f = x - 1.0
    let hfsq = 0.5 * f * f
    let s = f / (2.0 + f)
    let z = s * s
    var w = z * z
    let t1 = w * (MLOG10_LG2 + w * (MLOG10_LG4 + w * MLOG10_LG6))
    let t2 = z * (MLOG10_LG1 + w * (MLOG10_LG3 + w * (MLOG10_LG5 + w * MLOG10_LG7)))
    let rr = t2 + t1
    # hi+lo = f - hfsq + s*(hfsq+R) ~ log(1+f)
    var hi = f - hfsq
    hi = float.from_bits(hi.to_bits() & MLOG_HIMASK)
    let lo = f - hi - hfsq + s * (hfsq + rr)
    # val_hi+val_lo ~ log10(1+f) + k*log10(2)
    var val_hi = hi * MLOG10_IVLN10HI
    let y = dk * MLOG10_LOG10_2HI
    var val_lo = dk * MLOG10_LOG10_2LO + (lo + hi) * MLOG10_IVLN10LO + lo * MLOG10_IVLN10HI
    w = y + val_hi
    val_lo += (y - w) + val_hi
    val_hi = w
    return val_lo + val_hi

fn f_log1p(x: float) -> float:
    var u = x.to_bits()
    let hx = u >> 32  # uint32_t
    # C's int k: `reduce` is k != 0 before the reduction, dk is (double)k after it
    var reduce = true
    var dk = 0.0
    var c = 0.0
    var f = 0.0
    if hx < 0x3fda827a or hx >= 0x80000000:
        # 1+x < sqrt(2)+
        if hx >= 0xbff00000:
            # x <= -1.0
            if x == -1.0:
                return x / 0.0  # log1p(-1) = -inf
            return (x - x) / 0.0  # log1p(x<-1) = NaN
        if (hx & 0x7fffffff) < 0x3ca00000:
            # |x| < 2**-53 (C: hx<<1 < 0x3ca00000<<1 on uint32_t)
            return x
        if hx <= 0xbfd2bec4:
            # sqrt(2)/2- <= 1+x < sqrt(2)+
            reduce = false  # k = 0
            c = 0.0
            f = x
    elif hx >= 0x7ff00000:
        return x
    if reduce:
        let uf = 1.0 + x
        u = uf.to_bits()
        var hu = u >> 32  # uint32_t
        hu += 0x3ff00000 - 0x3fe6a09e
        let kb = hu >> 20  # k + 0x3ff
        # correction term ~ log(1+x)-log(u), avoid underflow in c/u
        if kb < 54 + 0x3ff:
            c = 1.0 - (uf - x) if kb >= 2 + 0x3ff else x - (uf - 1.0)
            c /= uf
        else:
            c = 0.0
        # reduce u into [sqrt(2)/2, sqrt(2)]
        hu = (hu & 0x000fffff) + 0x3fe6a09e
        u = (hu << 32) | (u & 0xffffffff)
        f = float.from_bits(u) - 1.0
        dk = float(int(kb)) - 1023.0
    let hfsq = 0.5 * f * f
    let s = f / (2.0 + f)
    let z = s * s
    let w = z * z
    let t1 = w * (MLOG1P_LG2 + w * (MLOG1P_LG4 + w * MLOG1P_LG6))
    let t2 = z * (MLOG1P_LG1 + w * (MLOG1P_LG3 + w * (MLOG1P_LG5 + w * MLOG1P_LG7)))
    let rr = t2 + t1
    return s * (hfsq + rr) + (dk * MLOG1P_LN2_LO + c) - hfsq + f + dk * MLOG1P_LN2_HI

# expm1, sinh, cosh, tanh, hypot and cbrt: musl 1.2.5 (src/math), translated
# line by line from runtime/brine_math.c so they give the same bits.

const MHYP_ABS: u64 = 0x7fffffffffffffff
const MHYP_SIGN: u64 = 0x8000000000000000

# expm1.c
const MHYP_O_THRESHOLD: float = 709.782712893384
const MHYP_LN2_HI: float = 0.6931471803691238
const MHYP_LN2_LO: float = 1.9082149292705877e-10
const MHYP_INVLN2: float = 1.4426950408889634
const MHYP_Q1: float = -0.03333333333333313
const MHYP_Q2: float = 0.0015873015872548146
const MHYP_Q3: float = -7.93650757867488e-05
const MHYP_Q4: float = 4.008217827329362e-06
const MHYP_Q5: float = -2.0109921818362437e-07
const MHYP_P1023: float = 8.98846567431158e+307

fn f_expm1(x0: float) -> float:
    var x = x0
    let ui = x.to_bits()
    let hx = (ui >> 32) & 0x7fffffff
    let sign = ui >> 63
    var hi = 0.0
    var lo = 0.0
    var c = 0.0
    var t = 0.0
    var k = 0

    # filter out huge and non-finite argument
    if hx >= 0x4043687A:  # |x| >= 56*ln2
        if x != x:
            return x
        if sign != 0:
            return -1.0
        if x > MHYP_O_THRESHOLD:
            return x * MHYP_P1023

    # argument reduction
    if hx > 0x3fd62e42:  # |x| > 0.5 ln2
        if hx < 0x3FF0A2B2:  # and |x| < 1.5 ln2
            if sign == 0:
                hi = x - MHYP_LN2_HI
                lo = MHYP_LN2_LO
                k = 1
            else:
                hi = x + MHYP_LN2_HI
                lo = -MHYP_LN2_LO
                k = -1
        else:
            # |x| < 709.8 here, so k fits easily
            if sign != 0:
                k = int(MHYP_INVLN2 * x + -0.5)
            else:
                k = int(MHYP_INVLN2 * x + 0.5)
            t = float(k)
            hi = x - t * MHYP_LN2_HI  # t*ln2_hi is exact here
            lo = t * MHYP_LN2_LO
        x = hi - lo
        c = (hi - x) - lo
    elif hx < 0x3c900000:  # |x| < 2**-54, return x
        return x

    # x is now in primary range
    let hfx = 0.5 * x
    let hxs = x * hfx
    let r1 = 1.0 + hxs * (
        MHYP_Q1 + hxs * (MHYP_Q2 + hxs * (MHYP_Q3 + hxs * (MHYP_Q4 + hxs * MHYP_Q5)))
    )
    t = 3.0 - r1 * hfx
    var e = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0:  # c is 0
        return x - (x * e - hxs)
    e = x * (e - c) - c
    e -= hxs
    # exp(x) ~ 2^k (x_reduced - e + 1)
    if k == -1:
        return 0.5 * (x - e) - 0.5
    if k == 1:
        if x < -0.25:
            return -2.0 * (e - (x + 0.5))
        return 1.0 + 2.0 * (x - e)
    # k is in [-56, 1024] here: 0x3ff + k and 0x3ff - k are >= 0
    let twopk = float.from_bits(u64(0x3ff + k) << 52)  # 2^k
    var y = 0.0
    if k < 0 or k > 56:  # suffice to return exp(x)-1
        y = x - e + 1.0
        if k == 1024:
            y = y * 2.0 * MHYP_P1023
        else:
            y = y * twopk
        return y - 1.0
    let u = float.from_bits(u64(0x3ff - k) << 52)  # 2^-k
    if k < 20:
        y = (x - e + (1.0 - u)) * twopk
    else:
        y = (x - (e + u) + 1.0) * twopk
    return y

# __expo2.c: k = 2043 makes k*ln2 have minimal relative error
const MHYP_KLN2: float = 1416.0996898839683
# 2^(k/2) = 2^1021: high word (0x3ff + k/2) << 20, low word 0
const MHYP_EXPO2_SCALE: u64 = 0x7fc0000000000000

# exp(x)/2 for x >= log(DBL_MAX), slightly better than 0.5*exp(x/2)*exp(x/2)
fn mhyp_expo2(x: float, sign: float) -> float:
    # k is odd and scale*scale overflows
    let scale = float.from_bits(MHYP_EXPO2_SCALE)
    # exp(x - k ln2) * 2**(k-1)
    return f_exp(x - MHYP_KLN2) * (sign * scale) * scale

# sinh.c
fn f_sinh(x: float) -> float:
    var ui = x.to_bits()
    var h = 0.5
    if ui >> 63 != 0:
        h = -h
    # |x|
    ui &= MHYP_ABS
    let absx = float.from_bits(ui)
    let w = ui >> 32
    var t = 0.0

    # |x| < log(DBL_MAX)
    if w < 0x40862e42:
        t = f_expm1(absx)
        if w < 0x3ff00000:
            if w < 0x3ff00000 - (26 << 20):
                return x
            return h * (2.0 * t - t * t / (t + 1.0))
        return h * (t + t / (t + 1.0))

    # |x| > log(DBL_MAX) or nan
    t = mhyp_expo2(absx, 2.0 * h)
    return t

# cosh.c
fn f_cosh(x0: float) -> float:
    var ui = x0.to_bits()
    # |x|
    ui &= MHYP_ABS
    let x = float.from_bits(ui)
    let w = ui >> 32
    var t = 0.0

    # |x| < log(2)
    if w < 0x3fe62e42:
        if w < 0x3ff00000 - (26 << 20):
            return 1.0
        t = f_expm1(x)
        return 1.0 + t * t / (2.0 * (1.0 + t))

    # |x| < log(DBL_MAX)
    if w < 0x40862e42:
        t = f_exp(x)
        return 0.5 * (t + 1.0 / t)

    # |x| > log(DBL_MAX) or nan
    t = mhyp_expo2(x, 1.0)
    return t

# tanh.c
fn f_tanh(x0: float) -> float:
    var ui = x0.to_bits()
    let sign = ui >> 63
    ui &= MHYP_ABS
    let x = float.from_bits(ui)
    let w = ui >> 32
    var t = 0.0

    if w > 0x3fe193ea:
        # |x| > log(3)/2 ~= 0.5493 or nan
        if w > 0x40340000:
            # |x| > 20 or nan
            t = 1.0 - 0.0 / x
        else:
            t = f_expm1(2.0 * x)
            t = 1.0 - 2.0 / (t + 2.0)
    elif w > 0x3fd058ae:
        # |x| > log(5/3)/2 ~= 0.2554
        t = f_expm1(2.0 * x)
        t = t / (t + 2.0)
    elif w >= 0x00100000:
        # |x| >= 0x1p-1022, up to 2ulp error in [0.1,0.2554]
        t = f_expm1(-2.0 * x)
        t = -t / (t + 2.0)
    else:
        # |x| is subnormal
        t = x
    if sign != 0:
        return -t
    return t

# hypot.c
const MHYP_SPLIT: float = 134217729.0  # 0x1p27 + 1
const MHYP_P700: float = 5.260135901548374e+210
const MHYP_M700: float = 1.90109156629516e-211

fn f_hypot(x0: float, y0: float) -> float:
    var uxi = x0.to_bits() & MHYP_ABS
    var uyi = y0.to_bits() & MHYP_ABS
    # arrange |x| >= |y|
    if uxi < uyi:
        let ut = uxi
        uxi = uyi
        uyi = ut

    # special cases
    let ex = int(uxi >> 52)
    let ey = int(uyi >> 52)
    var x = float.from_bits(uxi)
    var y = float.from_bits(uyi)
    # hypot(inf,nan) == inf
    if ey == 0x7ff:
        return y
    if ex == 0x7ff or uyi == 0:
        return x
    # hypot(x,y) ~= x + y*y/x/2 with inexact for small y/x
    if ex - ey > 64:
        return x + y

    # precise sqrt argument in nearest rounding mode without overflow
    # xh*xh must not overflow and xl*xl must not underflow in sq
    var z = 1.0
    if ex > 0x3ff + 510:
        z = MHYP_P700
        x *= MHYP_M700
        y *= MHYP_M700
    elif ey < 0x3ff - 450:
        z = MHYP_M700
        x *= MHYP_P700
        y *= MHYP_P700
    # sq(&hx, &lx, x) and sq(&hy, &ly, y), written out: x*x as hi + lo
    # exactly (Dekker), in musl's operation order. A helper returning a tuple
    # costs a third of the time on the native backend.
    let xc = x * MHYP_SPLIT
    let xh = x - xc + xc
    let xl = x - xh
    let hx = x * x
    let lx = xh * xh - hx + 2.0 * xh * xl + xl * xl
    let yc = y * MHYP_SPLIT
    let yh = y - yc + yc
    let yl = y - yh
    let hy = y * y
    let ly = yh * yh - hy + 2.0 * yh * yl + yl * yl
    return z * sqrt(ly + lx + hy + hx)

# cbrt.c
const MHYP_B1: u64 = 715094163  # (1023-1023/3-0.03306235651)*2**20
const MHYP_B2: u64 = 696219795  # (1023-1023/3-54/3-0.03306235651)*2**20
const MHYP_P54: float = 1.8014398509481984e+16
# |1/cbrt(x) - p(x)| < 2**-23.5 (~[-7.93e-8, 7.929e-8])
const MHYP_P0: float = 1.87595182427177
const MHYP_P1: float = -1.8849797954337717
const MHYP_P2: float = 1.6214297201053545
const MHYP_P3: float = -0.758397934778766
const MHYP_P4: float = 0.14599619288661245

fn f_cbrt(x: float) -> float:
    var ui = x.to_bits()
    var hx = (ui >> 32) & 0x7fffffff

    if hx >= 0x7ff00000:  # cbrt(NaN,INF) is itself
        return x + x

    # rough cbrt to 5 bits: integer division of the bits (unsigned, so it
    # rounds down like C's)
    if hx < 0x00100000:  # zero or subnormal?
        ui = (x * MHYP_P54).to_bits()
        hx = (ui >> 32) & 0x7fffffff
        if hx == 0:
            return x  # cbrt(0) is itself
        hx = hx / 3 + MHYP_B2
    else:
        hx = hx / 3 + MHYP_B1
    ui &= MHYP_SIGN
    ui |= hx << 32
    var t = float.from_bits(ui)

    # new cbrt to 23 bits: cbrt(x) = t*cbrt(x/t**3) ~= t*P(t**3/x)
    var r = (t * t) * (t / x)
    t = t * ((MHYP_P0 + r * (MHYP_P1 + r * MHYP_P2)) + ((r * r) * r) * (MHYP_P3 + r * MHYP_P4))

    # round t away from zero to 23 bits (|t| is finite, so no carry out)
    ui = (t.to_bits() + 0x80000000) & 0xffffffffc0000000
    t = float.from_bits(ui)

    # one step Newton iteration to 53 bits with error < 0.667 ulps
    let s = t * t  # t*t is exact
    r = x / s  # error <= 0.5 ulps; |r| < |t|
    let w = t + t  # t+t is exact
    r = (r - t) / (w + r)  # r-t is exact; w+r ~= 3*t
    t = t + t * r  # error <= 0.5 + 0.5/3 + epsilon
    return t

# trig group: musl's sin, cos and tan (with __rem_pio2, __rem_pio2_large,
# __sin, __cos, __tan, scalbn and floor), ported from runtime/brine_math.c.

const MTRIG_P1023: float = 8.98846567431158e+307
const MTRIG_PM969: float = 2.004168360008973e-292
const MTRIG_P24: float = 16777216.0
const MTRIG_PM24: float = 5.960464477539063e-08
const MTRIG_P52: float = 4503599627370496.0
const MTRIG_TOINT: float = 6755399441055744.0
const MTRIG_PIO4: float = 0.7853981633974483
const MTRIG_INVPIO2: float = 0.6366197723675814
const MTRIG_PIO2_1: float = 1.5707963267341256
const MTRIG_PIO2_1T: float = 6.077100506506192e-11
const MTRIG_PIO2_2: float = 6.077100506303966e-11
const MTRIG_PIO2_2T: float = 2.0222662487959506e-21
const MTRIG_PIO2_3: float = 2.0222662487111665e-21
const MTRIG_PIO2_3T: float = 8.4784276603689e-32
const MTRIG_S1: float = -0.16666666666666632
const MTRIG_S2: float = 0.00833333333332249
const MTRIG_S3: float = -0.0001984126982985795
const MTRIG_S4: float = 2.7557313707070068e-06
const MTRIG_S5: float = -2.5050760253406863e-08
const MTRIG_S6: float = 1.58969099521155e-10
const MTRIG_C1: float = 0.0416666666666666
const MTRIG_C2: float = -0.001388888888887411
const MTRIG_C3: float = 2.480158728947673e-05
const MTRIG_C4: float = -2.7557314351390663e-07
const MTRIG_C5: float = 2.087572321298175e-09
const MTRIG_C6: float = -1.1359647557788195e-11
const MTRIG_TPIO4LO: float = 3.061616997868383e-17
const MTRIG_T0: float = 0.3333333333333341
const MTRIG_T1: float = 0.13333333333320124
const MTRIG_T2: float = 0.05396825397622605
const MTRIG_T3: float = 0.021869488294859542
const MTRIG_T4: float = 0.0088632398235993
const MTRIG_T5: float = 0.0035920791075913124
const MTRIG_T6: float = 0.0014562094543252903
const MTRIG_T7: float = 0.0005880412408202641
const MTRIG_T8: float = 0.0002464631348184699
const MTRIG_T9: float = 7.817944429395571e-05
const MTRIG_T10: float = 7.140724913826082e-05
const MTRIG_T11: float = -1.8558637485527546e-05
const MTRIG_T12: float = 2.590730518636337e-05

const MTRIG_PIO2: [u64] = [
    0x3ff921fb40000000, 0x3e74442d00000000, 0x3cf8469880000000, 0x3b78cc5160000000,
    0x39f01b8380000000, 0x387a252040000000, 0x36e3822280000000, 0x3569f31d00000000,
]
# ipio2: 2/pi in 24-bit pieces (musl's first 66: enough for double)
const MTRIG_IPIO2: [int] = [
    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62,
    0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A,
    0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41,
    0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
    0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5,
    0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08,
    0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880,
    0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B,
]

const MTRIG_ONES: u64 = 0xffffffffffffffff

# musl __rem_pio2_large.c for prec = 1 (jk = 4). x[] is (x0, x1, x2) with
# nx of them used; returns (n & 7, y[0], y[1]).
fn mtrig_rem_pio2_large(x0: float, x1: float, x2: float, e0: int, nx: int) -> (int, float, float):
    let iq = stack_mem(160)
    let f = stack_mem(160)
    let fq = stack_mem(160)
    let q = stack_mem(160)

    let jk = 4
    let jp = jk

    # determine jx, jv, q0, note that 3 > q0. jv: C truncates (e0-3)/24 and
    # brine rounds down; they differ only for negative e0-3, where both give
    # a value <= 0 and the clamp makes it 0.
    let jx = nx - 1
    var jv = (e0 - 3) / 24
    if jv < 0:
        jv = 0
    var q0 = e0 - 24 * (jv + 1)

    # set up f[0] to f[jx+jk] where f[jx+jk] = ipio2[jv+jk]
    var j = jv - jx
    let m = jx + jk
    var i = 0
    while i <= m:
        store_f64(f, 8 * i, 0.0 if j < 0 else float(MTRIG_IPIO2[j]))
        i += 1
        j += 1

    # compute q[0],q[1],...q[jk]
    var fw = 0.0
    i = 0
    while i <= jk:
        fw = 0.0
        fw += x0 * load_f64(f, 8 * (jx + i))
        if jx >= 1:
            fw += x1 * load_f64(f, 8 * (jx + i - 1))
            if jx >= 2:
                fw += x2 * load_f64(f, 8 * (jx + i - 2))
        store_f64(q, 8 * i, fw)
        i += 1

    var jz = jk
    var z = 0.0
    var n = 0
    var ih = 0
    var carry = 0
    var k = 0
    while true:
        # recompute: distill q[] into iq[] reversingly. Every value here is
        # >= 0 and < 2^31, so int() truncates as C's (int32_t) does.
        i = 0
        j = jz
        z = load_f64(q, 8 * jz)
        while j > 0:
            fw = float(int(MTRIG_PM24 * z))
            store_i64(iq, 8 * i, int(z - MTRIG_P24 * fw))
            z = load_f64(q, 8 * (j - 1)) + fw
            i += 1
            j -= 1

        # compute n
        z = mexp_scalbn(z, q0)
        z -= 8.0 * f_floor(z * 0.125)
        n = int(z)
        z -= float(n)
        ih = 0
        if q0 > 0:
            # need iq[jz-1] to determine n
            i = load_i64(iq, 8 * (jz - 1)) >> (24 - q0)
            n += i
            store_i64(iq, 8 * (jz - 1), load_i64(iq, 8 * (jz - 1)) - (i << (24 - q0)))
            ih = load_i64(iq, 8 * (jz - 1)) >> (23 - q0)
        elif q0 == 0:
            ih = load_i64(iq, 8 * (jz - 1)) >> 23
        elif z >= 0.5:
            ih = 2

        if ih > 0:
            # q > 0.5
            n += 1
            carry = 0
            i = 0
            while i < jz:
                # compute 1-q
                j = load_i64(iq, 8 * i)
                if carry == 0:
                    if j != 0:
                        carry = 1
                        store_i64(iq, 8 * i, 0x1000000 - j)
                else:
                    store_i64(iq, 8 * i, 0xffffff - j)
                i += 1
            if q0 > 0:
                # rare case: chance is 1 in 12
                if q0 == 1:
                    store_i64(iq, 8 * (jz - 1), load_i64(iq, 8 * (jz - 1)) & 0x7fffff)
                elif q0 == 2:
                    store_i64(iq, 8 * (jz - 1), load_i64(iq, 8 * (jz - 1)) & 0x3fffff)
            if ih == 2:
                z = 1.0 - z
                if carry != 0:
                    z -= mexp_scalbn(1.0, q0)

        # check if recomputation is needed
        if z == 0.0:
            j = 0
            i = jz - 1
            while i >= jk:
                j |= load_i64(iq, 8 * i)
                i -= 1
            if j == 0:
                # need recomputation; k = no. of terms needed
                k = 1
                while load_i64(iq, 8 * (jk - k)) == 0:
                    k += 1
                # add q[jz+1] to q[jz+k]
                i = jz + 1
                while i <= jz + k:
                    store_f64(f, 8 * (jx + i), float(MTRIG_IPIO2[jv + i]))
                    fw = 0.0
                    fw += x0 * load_f64(f, 8 * (jx + i))
                    if jx >= 1:
                        fw += x1 * load_f64(f, 8 * (jx + i - 1))
                        if jx >= 2:
                            fw += x2 * load_f64(f, 8 * (jx + i - 2))
                    store_f64(q, 8 * i, fw)
                    i += 1
                jz += k
                continue
        break

    # chop off zero terms
    if z == 0.0:
        jz -= 1
        q0 -= 24
        while load_i64(iq, 8 * jz) == 0:
            jz -= 1
            q0 -= 24
    else:
        # break z into 24-bit if necessary
        z = mexp_scalbn(z, -q0)
        if z >= MTRIG_P24:
            fw = float(int(MTRIG_PM24 * z))
            store_i64(iq, 8 * jz, int(z - MTRIG_P24 * fw))
            jz += 1
            q0 += 24
            store_i64(iq, 8 * jz, int(fw))
        else:
            store_i64(iq, 8 * jz, int(z))

    # convert integer "bit" chunk to floating-point value
    fw = mexp_scalbn(1.0, q0)
    i = jz
    while i >= 0:
        store_f64(q, 8 * i, fw * float(load_i64(iq, 8 * i)))
        fw *= MTRIG_PM24
        i -= 1

    # compute PIo2[0,...,jp]*q[jz,...,0]
    i = jz
    while i >= 0:
        fw = 0.0
        k = 0
        while k <= jp and k <= jz - i:
            fw += float.from_bits(MTRIG_PIO2[k]) * load_f64(q, 8 * (i + k))
            k += 1
        store_f64(fq, 8 * (jz - i), fw)
        i -= 1

    # compress fq[] into y[]
    fw = 0.0
    i = jz
    while i >= 0:
        fw += load_f64(fq, 8 * i)
        i -= 1
    let y0 = fw if ih == 0 else -fw
    fw = load_f64(fq, 8 * 0) - fw
    i = 1
    while i <= jz:
        fw += load_f64(fq, 8 * i)
        i += 1
    let y1 = fw if ih == 0 else -fw
    return (n & 7, y0, y1)

# the medium case of __rem_pio2: |x| ~< 2^20*(pi/2), and the cancellation
# cases near multiples of pi/2 that jump to it
fn mtrig_rem_pio2_medium(x: float, ix: u64) -> (int, float, float):
    # rint(x/(pi/2))
    var fnv = x * MTRIG_INVPIO2 + MTRIG_TOINT - MTRIG_TOINT
    var n = int(fnv)
    var r = x - fnv * MTRIG_PIO2_1
    var w = fnv * MTRIG_PIO2_1T
    # matters with directed rounding
    if r - w < -MTRIG_PIO4:
        n -= 1
        fnv -= 1.0
        r = x - fnv * MTRIG_PIO2_1
        w = fnv * MTRIG_PIO2_1T
    elif r - w > MTRIG_PIO4:
        n += 1
        fnv += 1.0
        r = x - fnv * MTRIG_PIO2_1
        w = fnv * MTRIG_PIO2_1T
    var y0 = r - w
    var ey = (y0.to_bits() >> 52) & 0x7ff
    let ex = ix >> 20
    # ex - ey > 16, in unsigned arithmetic that cannot wrap
    if ex > ey + 16:
        # 2nd round, good to 118 bits
        var t = r
        w = fnv * MTRIG_PIO2_2
        r = t - w
        w = fnv * MTRIG_PIO2_2T - ((t - r) - w)
        y0 = r - w
        ey = (y0.to_bits() >> 52) & 0x7ff
        if ex > ey + 49:
            # 3rd round, good to 151 bits, covers all cases
            t = r
            w = fnv * MTRIG_PIO2_3
            r = t - w
            w = fnv * MTRIG_PIO2_3T - ((t - r) - w)
            y0 = r - w
    let y1 = (r - y0) - w
    return (n, y0, y1)

# musl __rem_pio2.c: x rem pi/2 as (n, y[0], y[1]). The caller handles
# |x| ~<= pi/4, where no reduction is needed.
fn mtrig_rem_pio2(x: float) -> (int, float, float):
    let u = x.to_bits()
    let sign = (u >> 63) != 0
    let ix = (u >> 32) & 0x7fffffff
    if ix <= 0x400f6a7a:
        # |x| ~<= 5pi/4
        if (ix & 0xfffff) == 0x921fb:
            # |x| ~= pi/2 or 2pi/2: cancellation, use the medium case
            return mtrig_rem_pio2_medium(x, ix)
        if ix <= 0x4002d97c:
            # |x| ~<= 3pi/4
            if not sign:
                let z = x - MTRIG_PIO2_1
                let a = z - MTRIG_PIO2_1T
                return (1, a, (z - a) - MTRIG_PIO2_1T)
            let z = x + MTRIG_PIO2_1
            let a = z + MTRIG_PIO2_1T
            return (-1, a, (z - a) + MTRIG_PIO2_1T)
        if not sign:
            let z = x - 2.0 * MTRIG_PIO2_1
            let a = z - 2.0 * MTRIG_PIO2_1T
            return (2, a, (z - a) - 2.0 * MTRIG_PIO2_1T)
        let z = x + 2.0 * MTRIG_PIO2_1
        let a = z + 2.0 * MTRIG_PIO2_1T
        return (-2, a, (z - a) + 2.0 * MTRIG_PIO2_1T)
    if ix <= 0x401c463b:
        # |x| ~<= 9pi/4
        if ix <= 0x4015fdbc:
            # |x| ~<= 7pi/4
            if ix == 0x4012d97c:
                # |x| ~= 3pi/2
                return mtrig_rem_pio2_medium(x, ix)
            if not sign:
                let z = x - 3.0 * MTRIG_PIO2_1
                let a = z - 3.0 * MTRIG_PIO2_1T
                return (3, a, (z - a) - 3.0 * MTRIG_PIO2_1T)
            let z = x + 3.0 * MTRIG_PIO2_1
            let a = z + 3.0 * MTRIG_PIO2_1T
            return (-3, a, (z - a) + 3.0 * MTRIG_PIO2_1T)
        if ix == 0x401921fb:
            # |x| ~= 4pi/2
            return mtrig_rem_pio2_medium(x, ix)
        if not sign:
            let z = x - 4.0 * MTRIG_PIO2_1
            let a = z - 4.0 * MTRIG_PIO2_1T
            return (4, a, (z - a) - 4.0 * MTRIG_PIO2_1T)
        let z = x + 4.0 * MTRIG_PIO2_1
        let a = z + 4.0 * MTRIG_PIO2_1T
        return (-4, a, (z - a) + 4.0 * MTRIG_PIO2_1T)
    if ix < 0x413921fb:
        # |x| ~< 2^20*(pi/2), medium size
        return mtrig_rem_pio2_medium(x, ix)
    # all other (large) arguments
    if ix >= 0x7ff00000:
        # x is inf or NaN
        let d = x - x
        return (0, d, d)
    # set z = scalbn(|x|,-ilogb(x)+23)
    var z = float.from_bits((u & (MTRIG_ONES >> 12)) | (u64(0x3ff + 23) << 52))
    let tx0 = float(int(z))
    z = (z - tx0) * MTRIG_P24
    let tx1 = float(int(z))
    z = (z - tx1) * MTRIG_P24
    let tx2 = z
    # skip zero terms, first term is non-zero
    var nx = 3
    if tx2 == 0.0:
        nx = 2
        if tx1 == 0.0:
            nx = 1
    let (n, ty0, ty1) = mtrig_rem_pio2_large(tx0, tx1, tx2, int(ix >> 20) - (0x3ff + 23), nx)
    if sign:
        return (-n, -ty0, -ty1)
    return (n, ty0, ty1)

# musl __sin.c: sin on ~[-pi/4, pi/4]; y is the tail of x, iy = 0 when y is 0
fn mtrig_ksin(x: float, y: float, iy: int) -> float:
    let z = x * x
    let w = z * z
    let r = MTRIG_S2 + z * (MTRIG_S3 + z * MTRIG_S4) + z * w * (MTRIG_S5 + z * MTRIG_S6)
    let v = z * x
    if iy == 0:
        return x + v * (MTRIG_S1 + z * r)
    return x - ((z * (0.5 * y - v * r) - y) - v * MTRIG_S1)

# musl __cos.c: cos on [-pi/4, pi/4]; y is the tail of x
fn mtrig_kcos(x: float, y: float) -> float:
    let z = x * x
    var w = z * z
    let r = (
        z * (MTRIG_C1 + z * (MTRIG_C2 + z * MTRIG_C3))
        + w * w * (MTRIG_C4 + z * (MTRIG_C5 + z * MTRIG_C6))
    )
    let hz = 0.5 * z
    w = 1.0 - hz
    return w + (((1.0 - w) - hz) + (z * r - x * y))

# musl __tan.c: tan (odd = 0) or -1/tan (odd = 1) on ~[-pi/4, pi/4]
fn mtrig_ktan(mut x: float, mut y: float, odd: int) -> float:
    let hx = x.to_bits() >> 32
    let big = (hx & 0x7fffffff) >= 0x3FE59428
    let sign = (hx >> 31) != 0
    if big:
        # |x| >= 0.6744
        if sign:
            x = -x
            y = -y
        # musl's pio4 here has the same bits as __rem_pio2's
        x = (MTRIG_PIO4 - x) + (MTRIG_TPIO4LO - y)
        y = 0.0
    let z = x * x
    var w = z * z
    # break x^5*(T[1]+x^2*T[2]+...) into
    # x^5(T[1]+x^4*T[3]+...+x^20*T[11]) + x^5(x^2*(T[2]+x^4*T[4]+...+x^22*[T12]))
    var r = MTRIG_T1 + w * (
        MTRIG_T3 + w * (MTRIG_T5 + w * (MTRIG_T7 + w * (MTRIG_T9 + w * MTRIG_T11)))
    )
    var v = z * (
        MTRIG_T2 + w * (
            MTRIG_T4 + w * (MTRIG_T6 + w * (MTRIG_T8 + w * (MTRIG_T10 + w * MTRIG_T12)))
        )
    )
    var s = z * x
    r = y + z * (s * (r + v) + y) + s * MTRIG_T0
    w = x + r
    if big:
        s = float(1 - 2 * odd)
        v = s - 2.0 * (x + (r - w * w / (w + s)))
        return -v if sign else v
    if odd == 0:
        return w
    # -1.0/(x+r) has up to 2ulp error, so compute it accurately
    let w0 = float.from_bits(w.to_bits() & 0xffffffff00000000)
    v = r - (w0 - x)
    # w0+v = r+x
    let a = -1.0 / w
    let a0 = float.from_bits(a.to_bits() & 0xffffffff00000000)
    return a0 + a * (1.0 + a0 * w0 + a0 * v)

# musl sin.c
fn f_sin(x: float) -> float:
    let ix = (x.to_bits() >> 32) & 0x7fffffff
    # |x| ~< pi/4
    if ix <= 0x3fe921fb:
        if ix < 0x3e500000:
            # |x| < 2**-26
            return x
        return mtrig_ksin(x, 0.0, 0)
    # sin(Inf or NaN) is NaN
    if ix >= 0x7ff00000:
        return x - x
    # argument reduction needed
    let (n, y0, y1) = mtrig_rem_pio2(x)
    let c = n & 3
    if c == 0:
        return mtrig_ksin(y0, y1, 1)
    if c == 1:
        return mtrig_kcos(y0, y1)
    if c == 2:
        return -mtrig_ksin(y0, y1, 1)
    return -mtrig_kcos(y0, y1)

# musl cos.c
fn f_cos(x: float) -> float:
    let ix = (x.to_bits() >> 32) & 0x7fffffff
    # |x| ~< pi/4
    if ix <= 0x3fe921fb:
        if ix < 0x3e46a09e:
            # |x| < 2**-27 * sqrt(2)
            return 1.0
        return mtrig_kcos(x, 0.0)
    # cos(Inf or NaN) is NaN
    if ix >= 0x7ff00000:
        return x - x
    # argument reduction
    let (n, y0, y1) = mtrig_rem_pio2(x)
    let c = n & 3
    if c == 0:
        return mtrig_kcos(y0, y1)
    if c == 1:
        return -mtrig_ksin(y0, y1, 1)
    if c == 2:
        return -mtrig_kcos(y0, y1)
    return mtrig_ksin(y0, y1, 1)

# musl tan.c
fn f_tan(x: float) -> float:
    let ix = (x.to_bits() >> 32) & 0x7fffffff
    # |x| ~< pi/4
    if ix <= 0x3fe921fb:
        if ix < 0x3e400000:
            # |x| < 2**-27
            return x
        return mtrig_ktan(x, 0.0, 0)
    # tan(Inf or NaN) is NaN
    if ix >= 0x7ff00000:
        return x - x
    # argument reduction
    let (n, y0, y1) = mtrig_rem_pio2(x)
    return mtrig_ktan(y0, y1, n & 1)

# atan, atan2, asin and acos: musl 1.2.5's atan.c, atan2.c, asin.c and
# acos.c (FreeBSD msun, Sun Microsystems), translated line by line so they
# give the same bits as runtime/brine_math.c.

# atan.c: atanhi[], atanlo[] and aT[]
const MATR_ATANHI0: float = 0.4636476090008061
const MATR_ATANHI1: float = 0.7853981633974483
const MATR_ATANHI2: float = 0.982793723247329
const MATR_ATANHI3: float = 1.5707963267948966
const MATR_ATANLO0: float = 2.2698777452961687e-17
const MATR_ATANLO1: float = 3.061616997868383e-17
const MATR_ATANLO2: float = 1.3903311031230998e-17
const MATR_ATANLO3: float = 6.123233995736766e-17
const MATR_AT0: float = 0.3333333333333293
const MATR_AT1: float = -0.19999999999876483
const MATR_AT2: float = 0.14285714272503466
const MATR_AT3: float = -0.11111110405462356
const MATR_AT4: float = 0.09090887133436507
const MATR_AT5: float = -0.0769187620504483
const MATR_AT6: float = 0.06661073137387531
const MATR_AT7: float = -0.058335701337905735
const MATR_AT8: float = 0.049768779946159324
const MATR_AT9: float = -0.036531572744216916
const MATR_AT10: float = 0.016285820115365782
# atan2.c
const MATR_PI: float = 3.141592653589793
const MATR_PI_LO: float = 1.2246467991473532e-16
# asin.c and acos.c (the same values in both)
const MATR_PIO2_HI: float = 1.5707963267948966
const MATR_PIO2_LO: float = 6.123233995736766e-17
const MATR_PS0: float = 0.16666666666666666
const MATR_PS1: float = -0.3255658186224009
const MATR_PS2: float = 0.20121253213486293
const MATR_PS3: float = -0.04005553450067941
const MATR_PS4: float = 0.0007915349942898145
const MATR_PS5: float = 3.479331075960212e-05
const MATR_QS1: float = -2.403394911734414
const MATR_QS2: float = 2.0209457602335057
const MATR_QS3: float = -0.6882839716054533
const MATR_QS4: float = 0.07703815055590194
# 0x1p-120f
const MATR_TINY: float = 7.52316384526264e-37

fn matr_fabs(x: float) -> float:
    return float.from_bits(x.to_bits() & 0x7fffffffffffffff)

fn f_atan(x0: float) -> float:
    var x = x0
    let hw = x.to_bits() >> 32
    let sign = hw >> 31
    let ix = hw & 0x7fffffff
    # atanhi[id] and atanlo[id]; id < 0 is `full`
    var hi = 0.0
    var lo = 0.0
    var full = false
    if ix >= 0x44100000:
        # |x| >= 2^66
        if x != x:
            return x
        let z = MATR_ATANHI3 + MATR_TINY
        if sign != 0:
            return -z
        return z
    if ix < 0x3fdc0000:
        # |x| < 0.4375
        if ix < 0x3e400000:
            # |x| < 2^-27
            return x
        full = true
    else:
        x = matr_fabs(x)
        if ix < 0x3ff30000:
            # |x| < 1.1875
            if ix < 0x3fe60000:
                # 7/16 <= |x| < 11/16
                hi = MATR_ATANHI0
                lo = MATR_ATANLO0
                x = (2.0 * x - 1.0) / (2.0 + x)
            else:
                # 11/16 <= |x| < 19/16
                hi = MATR_ATANHI1
                lo = MATR_ATANLO1
                x = (x - 1.0) / (x + 1.0)
        else:
            if ix < 0x40038000:
                # |x| < 2.4375
                hi = MATR_ATANHI2
                lo = MATR_ATANLO2
                x = (x - 1.5) / (1.0 + 1.5 * x)
            else:
                # 2.4375 <= |x| < 2^66
                hi = MATR_ATANHI3
                lo = MATR_ATANLO3
                x = -1.0 / x
    var z = x * x
    let w = z * z
    # the sum from i=0 to 10 of aT[i]z**(i+1), as an odd and an even polynomial
    let s1 = z * (
        MATR_AT0 + w * (MATR_AT2 + w * (MATR_AT4 + w * (MATR_AT6 + w * (MATR_AT8 + w * MATR_AT10))))
    )
    let s2 = w * (MATR_AT1 + w * (MATR_AT3 + w * (MATR_AT5 + w * (MATR_AT7 + w * MATR_AT9))))
    if full:
        return x - x * (s1 + s2)
    z = hi - (x * (s1 + s2) - lo - x)
    if sign != 0:
        return -z
    return z

fn f_atan2(y: float, x: float) -> float:
    if x != x or y != y:
        # C's x+y: the C compiler commutes it to addsd y, x, and with two
        # NaNs x86 returns the first operand's, so the order matters
        return y + x
    let bx = x.to_bits()
    let by = y.to_bits()
    var ix = bx >> 32
    let lx = bx & 0xffffffff
    var iy = by >> 32
    let ly = by & 0xffffffff
    # C: (ix-0x3ff00000 | lx) == 0 in uint32_t, which is x == 1.0
    if ix == 0x3ff00000 and lx == 0:
        return f_atan(y)
    # 2*sign(x)+sign(y)
    let m = ((iy >> 31) & 1) | ((ix >> 30) & 2)
    ix = ix & 0x7fffffff
    iy = iy & 0x7fffffff
    # y = 0
    if (iy | ly) == 0:
        if m <= 1:
            return y
        if m == 2:
            return MATR_PI
        return -MATR_PI
    # x = 0
    if (ix | lx) == 0:
        if (m & 1) != 0:
            return -MATR_PI / 2.0
        return MATR_PI / 2.0
    # x is inf
    if ix == 0x7ff00000:
        if iy == 0x7ff00000:
            if m == 0:
                return MATR_PI / 4.0
            if m == 1:
                return -MATR_PI / 4.0
            if m == 2:
                return 3.0 * MATR_PI / 4.0
            return -3.0 * MATR_PI / 4.0
        else:
            if m == 0:
                return 0.0
            if m == 1:
                return -0.0
            if m == 2:
                return MATR_PI
            return -MATR_PI
    # |y/x| > 0x1p64 (no wraparound: ix and iy are below 2^31)
    if ix + (64 << 20) < iy or iy == 0x7ff00000:
        if (m & 1) != 0:
            return -MATR_PI / 2.0
        return MATR_PI / 2.0
    # z = atan(|y/x|) without spurious underflow
    var z = 0.0
    if (m & 2) != 0 and iy + (64 << 20) < ix:
        # |y/x| < 0x1p-64, x < 0
        z = 0.0
    else:
        z = f_atan(matr_fabs(y / x))
    if m == 0:
        return z
    if m == 1:
        return -z
    if m == 2:
        return MATR_PI - (z - MATR_PI_LO)
    return (z - MATR_PI_LO) - MATR_PI

# R(z) of asin.c and acos.c (the same function in both)
fn matr_r(z: float) -> float:
    let p = z * (
        MATR_PS0 + z * (MATR_PS1 + z * (MATR_PS2 + z * (MATR_PS3 + z * (MATR_PS4 + z * MATR_PS5))))
    )
    let q = 1.0 + z * (MATR_QS1 + z * (MATR_QS2 + z * (MATR_QS3 + z * MATR_QS4)))
    return p / q

fn f_asin(x0: float) -> float:
    var x = x0
    let b = x.to_bits()
    let hx = b >> 32
    let ix = hx & 0x7fffffff
    # |x| >= 1 or nan
    if ix >= 0x3ff00000:
        let lx = b & 0xffffffff
        # C: (ix-0x3ff00000 | lx) == 0, which is |x| == 1
        if ix == 0x3ff00000 and lx == 0:
            # asin(1) = +-pi/2 with inexact
            return x * MATR_PIO2_HI + MATR_TINY
        return 0.0 / (x - x)
    # |x| < 0.5
    if ix < 0x3fe00000:
        # 0x1p-1022 <= |x| < 0x1p-26
        if ix < 0x3e500000 and ix >= 0x00100000:
            return x
        return x + x * matr_r(x * x)
    # 1 > |x| >= 0.5
    let z = (1.0 - matr_fabs(x)) * 0.5
    let s = sqrt(z)
    let r = matr_r(z)
    if ix >= 0x3fef3333:
        # |x| > 0.975
        x = MATR_PIO2_HI - (2.0 * (s + s * r) - MATR_PIO2_LO)
    else:
        # f+c = sqrt(z)
        let f = float.from_bits(s.to_bits() & 0xffffffff00000000)
        let c = (z - f * f) / (s + f)
        x = 0.5 * MATR_PIO2_HI - (
            2.0 * s * r - (MATR_PIO2_LO - 2.0 * c) - (0.5 * MATR_PIO2_HI - 2.0 * f)
        )
    if (hx >> 31) != 0:
        return -x
    return x

fn f_acos(x: float) -> float:
    let b = x.to_bits()
    let hx = b >> 32
    let ix = hx & 0x7fffffff
    # |x| >= 1 or nan
    if ix >= 0x3ff00000:
        let lx = b & 0xffffffff
        if ix == 0x3ff00000 and lx == 0:
            # acos(1)=0, acos(-1)=pi
            if (hx >> 31) != 0:
                return 2.0 * MATR_PIO2_HI + MATR_TINY
            return 0.0
        return 0.0 / (x - x)
    # |x| < 0.5
    if ix < 0x3fe00000:
        if ix <= 0x3c600000:
            # |x| < 2**-57
            return MATR_PIO2_HI + MATR_TINY
        return MATR_PIO2_HI - (x - (MATR_PIO2_LO - x * matr_r(x * x)))
    # x < -0.5
    if (hx >> 31) != 0:
        let z = (1.0 + x) * 0.5
        let s = sqrt(z)
        let w = matr_r(z) * s - MATR_PIO2_LO
        return 2.0 * (MATR_PIO2_HI - (s + w))
    # x > 0.5
    let z = (1.0 - x) * 0.5
    let s = sqrt(z)
    let df = float.from_bits(s.to_bits() & 0xffffffff00000000)
    let c = (z - df * df) / (s + df)
    let w = matr_r(z) * s + c
    return 2.0 * (df + w)

# ---- the exact operations (musl's floor.c, ceil.c, round.c, fmod.c): any
# correct version gives the C library's bits

const MX_TOINT: float = 4503599627370496.0

fn f_floor(x: float) -> float:
    let u = x.to_bits()
    let e = (u >> 52) & 0x7ff
    if e >= 0x3ff + 52 or x == 0.0:
        return x
    # y = int(x) - x, where int(x) is an integer neighbor of x
    var y = 0.0
    if (u >> 63) != 0:
        y = x - MX_TOINT + MX_TOINT - x
    else:
        y = x + MX_TOINT - MX_TOINT - x
    if e <= 0x3ff - 1:
        return -1.0 if (u >> 63) != 0 else 0.0
    if y > 0.0:
        return x + y - 1.0
    return x + y

fn f_ceil(x: float) -> float:
    let u = x.to_bits()
    let e = (u >> 52) & 0x7ff
    if e >= 0x3ff + 52 or x == 0.0:
        return x
    var y = 0.0
    if (u >> 63) != 0:
        y = x - MX_TOINT + MX_TOINT - x
    else:
        y = x + MX_TOINT - MX_TOINT - x
    if e <= 0x3ff - 1:
        return -0.0 if (u >> 63) != 0 else 1.0
    if y < 0.0:
        return x + y + 1.0
    return x + y

# halfway cases away from zero
fn f_round(x0: float) -> float:
    let u = x0.to_bits()
    let e = (u >> 52) & 0x7ff
    if e >= 0x3ff + 52:
        return x0
    var x = x0
    if (u >> 63) != 0:
        x = -x
    if e < 0x3ff - 1:
        return 0.0 * x0
    var y = x + MX_TOINT - MX_TOINT - x
    if y > 0.5:
        y = y + x - 1.0
    elif y <= -0.5:
        y = y + x + 1.0
    else:
        y = y + x
    if (u >> 63) != 0:
        y = -y
    return y

fn f_fabs(x: float) -> float:
    return float.from_bits(x.to_bits() & 0x7fffffffffffffff)

# C's fmod: x - n*y for n = x/y truncated, exactly
fn mx_fmod(x: float, y: float) -> float:
    let ux = x.to_bits()
    var uy = y.to_bits()
    var ex = int((ux >> 52) & 0x7ff)
    var ey = int((uy >> 52) & 0x7ff)
    let sx = ux >> 63
    if uy << 1 == 0 or y != y or ex == 0x7ff:
        return (x * y) / (x * y)
    var uxi = ux
    if uxi << 1 <= uy << 1:
        if uxi << 1 == uy << 1:
            return 0.0 * x
        return x
    # normalize x and y
    var i: u64 = 0
    if ex == 0:
        i = uxi << 12
        while i >> 63 == 0:
            ex -= 1
            i <<= 1
        uxi <<= u64(-ex + 1)
    else:
        uxi &= ONES >> 12
        uxi |= u64(1) << 52
    if ey == 0:
        i = uy << 12
        while i >> 63 == 0:
            ey -= 1
            i <<= 1
        uy <<= u64(-ey + 1)
    else:
        uy &= ONES >> 12
        uy |= u64(1) << 52
    # x mod y
    while ex > ey:
        i = uxi - uy
        if i >> 63 == 0:
            if i == 0:
                return 0.0 * x
            uxi = i
        uxi <<= 1
        ex -= 1
    i = uxi - uy
    if i >> 63 == 0:
        if i == 0:
            return 0.0 * x
        uxi = i
    while uxi >> 52 == 0:
        uxi <<= 1
        ex -= 1
    # scale result
    if ex > 0:
        uxi -= u64(1) << 52
        uxi |= u64(ex) << 52
    else:
        uxi >>= u64(-ex + 1)
    uxi |= sx << 63
    return float.from_bits(uxi)

# float `%` also takes the sign of the divisor, like Python
fn f_fmod(a: float, b: float) -> float:
    let r = mx_fmod(a, b)
    if r != 0.0 and (r < 0.0) != (b < 0.0):
        return r + b
    return r

fn f_fmodf(a: f32, b: f32) -> f32:
    # (exact, so the same as C's fmodf)
    let r = f32(mx_fmod(float(a), float(b)))
    if r != f32(0.0) and (r < f32(0.0)) != (b < f32(0.0)):
        return r + b
    return r

# float min and max: a NaN loses to a number, and -0.0 is less than 0.0, the
# same on every platform (brine_rt.h's BR_MINMAX)
fn f_fmin(a: float, b: float) -> float:
    if a < b or b != b:
        return a
    if b < a or a != a:
        return b
    return a if (a.to_bits() >> 63) != 0 else b

fn f_fmax(a: float, b: float) -> float:
    if a > b or b != b:
        return a
    if b > a or a != a:
        return b
    return b if (a.to_bits() >> 63) != 0 else a

fn f_fminf(a: f32, b: f32) -> f32:
    if a < b or b != b:
        return a
    if b < a or a != a:
        return b
    return a if (a.to_bits() >> 31) != 0 else b

fn f_fmaxf(a: f32, b: f32) -> f32:
    if a > b or b != b:
        return a
    if b > a or a != a:
        return b
    return b if (a.to_bits() >> 31) != 0 else a

fn f_fabsf(x: f32) -> f32:
    return f32.from_bits(x.to_bits() & 0x7fffffff)

# f32: the f64 function, rounded (exact for floor, ceil and round)
fn f_floorf(x: f32) -> f32:
    return f32(f_floor(float(x)))

fn f_ceilf(x: f32) -> f32:
    return f32(f_ceil(float(x)))

fn f_roundf(x: f32) -> f32:
    return f32(f_round(float(x)))

fn f_sinf(x: f32) -> f32:
    return f32(f_sin(float(x)))

fn f_cosf(x: f32) -> f32:
    return f32(f_cos(float(x)))

fn f_tanf(x: f32) -> f32:
    return f32(f_tan(float(x)))

fn f_asinf(x: f32) -> f32:
    return f32(f_asin(float(x)))

fn f_acosf(x: f32) -> f32:
    return f32(f_acos(float(x)))

fn f_atanf(x: f32) -> f32:
    return f32(f_atan(float(x)))

fn f_sinhf(x: f32) -> f32:
    return f32(f_sinh(float(x)))

fn f_coshf(x: f32) -> f32:
    return f32(f_cosh(float(x)))

fn f_tanhf(x: f32) -> f32:
    return f32(f_tanh(float(x)))

fn f_expf(x: f32) -> f32:
