fn brine_x_i128_cmp(a: ptr, b: ptr) -> i32:
    let ah = load_i64(a, 8)
    let bh = load_i64(b, 8)
    if ah != bh:
        return -1 if ah < bh else 1
    let al = load_u64(a, 0)
    let bl = load_u64(b, 0)
    if al == bl:
        return 0
    return -1 if al < bl else 1

