# fmt: on

fn bn_len(b: ptr) -> int:
    return load_i64(b, 0)

fn bn_limb(b: ptr, i: int) -> u64:
    if i >= load_i64(b, 0):
        return 0
    return load_u64(b, 8 + i * 8)

fn bn_set(b: ptr, x: u64):
    store_u64(b, 8, x & M32)
    store_u64(b, 16, x >> 32)
    if x == 0:
        store_i64(b, 0, 0)
    elif x >> 32 == 0:
        store_i64(b, 0, 1)
    else:
        store_i64(b, 0, 2)

fn bn_copy(d: ptr, s: ptr):
    copy_bytes(d, s, 8 + load_i64(s, 0) * 8)

# b * k + c, k and c below 2^32
fn bn_mul_add(b: ptr, k: u64, c0: u64):
    let n = load_i64(b, 0)
    var c = c0
    for i in 0..n:
        let t = load_u64(b, 8 + i * 8) * k + c
        store_u64(b, 8 + i * 8, t & M32)
        c = t >> 32
    if c != 0:
        store_u64(b, 8 + n * 8, c)
        store_i64(b, 0, n + 1)

fn bn_mul_pow10(b: ptr, e: int):
    var k = e
    while k >= 9:
        bn_mul_add(b, 1000000000, 0)
        k -= 9
    if k > 0:
        var t: u64 = 1
        for _ in 0..k:
            t *= 10
        bn_mul_add(b, t, 0)

fn bn_mul_pow5(b: ptr, e: int):
    var k = e
    while k >= 13:
        bn_mul_add(b, 1220703125, 0)
        k -= 13
    if k > 0:
        var t: u64 = 1
        for _ in 0..k:
            t *= 5
        bn_mul_add(b, t, 0)

fn bn_shl(b: ptr, s: int):
    let n = load_i64(b, 0)
    if n == 0 or s == 0:
        return
    let w = s / 32
    let r = u64(s % 32)
    var top = n + w
    if r == 0:
        var i = n - 1
        while i >= 0:
            store_u64(b, 8 + (i + w) * 8, load_u64(b, 8 + i * 8))
            i -= 1
    else:
        let hi = load_u64(b, 8 + (n - 1) * 8) >> (32 - r)
        if hi != 0:
            store_u64(b, 8 + top * 8, hi)
            top += 1
        var i = n - 1
        while i > 0:
            let v = (
                ((load_u64(b, 8 + i * 8) << r) & M32) | (load_u64(b, 8 + (i - 1) * 8) >> (32 - r))
            )
            store_u64(b, 8 + (i + w) * 8, v)
            i -= 1
        store_u64(b, 8 + w * 8, (load_u64(b, 8) << r) & M32)
    for i in 0..w:
        store_u64(b, 8 + i * 8, 0)
    store_i64(b, 0, top)

fn bn_shr1(b: ptr):
    let n = load_i64(b, 0)
    for i in 0..n:
        var v = load_u64(b, 8 + i * 8) >> 1
        if i + 1 < n:
            v |= (load_u64(b, 16 + i * 8) & 1) << 31
        store_u64(b, 8 + i * 8, v)
    if n > 0 and load_u64(b, n * 8) == 0:
        store_i64(b, 0, n - 1)

fn bn_cmp(a: ptr, b: ptr) -> int:
    let na = load_i64(a, 0)
    let nb = load_i64(b, 0)
    if na != nb:
        return -1 if na < nb else 1
    var i = na - 1
    while i >= 0:
        let x = load_u64(a, 8 + i * 8)
        let y = load_u64(b, 8 + i * 8)
        if x != y:
            return -1 if x < y else 1
        i -= 1
    return 0

# a - b, for a >= b
fn bn_sub(a: ptr, b: ptr):
    var n = load_i64(a, 0)
    var borrow: u64 = 0
    for i in 0..n:
        let t = load_u64(a, 8 + i * 8) + 0x100000000 - bn_limb(b, i) - borrow
        store_u64(a, 8 + i * 8, t & M32)
        borrow = 1 - (t >> 32)
    while n > 0 and load_u64(a, n * 8) == 0:
        n -= 1
    store_i64(a, 0, n)

fn bn_bits(b: ptr) -> int:
    let n = load_i64(b, 0)
    if n == 0:
        return 0
    return (n - 1) * 32 + 64 - load_u64(b, n * 8).leading_zeros()

# b / k, the remainder the result; k below 2^32
fn bn_div_small(b: ptr, k: u64) -> u64:
    var n = load_i64(b, 0)
    var r: u64 = 0
    var i = n - 1
    while i >= 0:
        let t = (r << 32) | load_u64(b, 8 + i * 8)
        store_u64(b, 8 + i * 8, t / k)
        r = t % k
        i -= 1
    while n > 0 and load_u64(b, n * 8) == 0:
        n -= 1
    store_i64(b, 0, n)
    return r

# 10^0 to 10^22: all exact floats
const POW10F: [float] = [
    1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16,
    1e17, 1e18, 1e19, 1e20, 1e21, 1e22
]

# q * 2^b (plus a little when `sticky`) rounded to a float, ties to even;
# q isn't 0
fn make_f64(q: u64, b: int, sticky: bool) -> float:
    let top = b + 63 - q.leading_zeros()
    if top > 1023:
        return float.from_bits(F_INF)
    var lsb = top - 52
    if lsb < -1074:
        lsb = -1074
    let shift = lsb - b
    var kept: u64 = 0
    if shift <= 0:
        kept = q << u64(-shift)
    elif shift > 64:
        return 0.0
    else:
        var rem = q
        if shift < 64:
            kept = q >> u64(shift)
            rem = q & ((u64(1) << u64(shift)) - 1)
        let half = u64(1) << u64(shift - 1)
        if rem > half or (rem == half and (sticky or kept & 1 != 0)):
            kept += 1
    if kept == u64(1) << 53:
        kept = u64(1) << 52
        lsb += 1
    if kept < u64(1) << 52:
        # subnormal
        return float.from_bits(kept)
    let field = lsb + 1075
    if field >= 2047:
        return float.from_bits(F_INF)
    return float.from_bits((u64(field) << 52) | (kept & ((u64(1) << 52) - 1)))

# m * 10^e when m and 10^e are exact floats, so one multiply or divide rounds
# once (Clinger's fast path); -1.0 when that doesn't hold
fn dec_fast(m0: u64, e0: int) -> float:
    if m0 > u64(1) << 53:
        return -1.0
    var m = m0
    var e = e0
    if e > 22 and e <= 37:
        # 1234e25 is 1234000e22: move zeros into m while it stays exact
        while e > 22:
            if m > (u64(1) << 53) / 10:
                return -1.0
            m *= 10
            e -= 1
    if e < -22 or e > 22:
        return -1.0
    let d = float(m)
    return d / POW10F[-e] if e < 0 else d * POW10F[e]

# 64 bits of b from bit s on
fn bn_word(b: ptr, s: int) -> u64:
    let w = s / 32
    let r = u64(s % 32)
    let lo = bn_limb(b, w) | (bn_limb(b, w + 1) << 32)
    if r == 0:
        return lo
    return (lo >> r) | (bn_limb(b, w + 2) << (64 - r))

# d * 10^e rounded to a float, where d (a big number, which this changes)
# has nd significant digits
fn dec_slow_cold(d: ptr, nd: int, e: int) -> float:
    if nd + e > 310:
        return float.from_bits(F_INF)
    if nd + e < -324:
        return 0.0
    if e >= 0:
        bn_mul_pow10(d, e)
        let s = bn_bits(d) - 64
        if s <= 0:
            return make_f64(bn_word(d, 0), 0, false)
        var sticky = (bn_limb(d, s / 32) & ((u64(1) << u64(s % 32)) - 1)) != 0
        for i in 0..s / 32:
            if load_u64(d, 8 + i * 8) != 0:
                sticky = true
        return make_f64(bn_word(d, s), s, sticky)
    # d / 10^-e: 64 bits of the quotient by long division
    let sm = stack_mem(BN_SIZE)
    let tm = stack_mem(BN_SIZE)
    bn_set(sm, 1)
    bn_mul_pow10(sm, -e)
    let t = 63 - (bn_bits(d) - bn_bits(sm))
    if t >= 0:
        bn_shl(d, t)
    else:
        bn_shl(sm, -t)
    bn_copy(tm, sm)
    bn_shl(tm, 63)
    var q: u64 = 0
    var i = 63
    while i >= 0:
        if bn_cmp(d, tm) >= 0:
            bn_sub(d, tm)
            q |= u64(1) << u64(i)
        bn_shr1(tm)
        i -= 1
    return make_f64(q, -t, bn_len(d) != 0)

# The high 64 bits of a * b.
fn mul_hi(a: u64, b: u64) -> u64:
    return umulh(a, b)

# w * 10^q rounded to a float, for any w > 0 below 2^64: Eisel and
# Lemire's algorithm, which needs no fallback for such a w (Mushtak and
# Lemire, "Fast number parsing without fallback", 2023).
fn eisel_lemire(w0: u64, q: int) -> float:
    if q < -342:
        return 0.0
    if q > 308:
        return float.from_bits(F_INF)
    let lz = w0.leading_zeros()
    let w = w0 << u64(lz)
    let ix = 2 * (q + 342)
    let p5 = POW5[ix]
    var hi = mul_hi(w, p5)
    var lo = w * p5
    if hi & 0x1ff == 0x1ff:
        # the top 55 bits could still change: add the next 64 bits' part
        let h2 = mul_hi(w, POW5[ix + 1])
        lo += h2
        if h2 > lo:
            hi += 1
    let upper = int(hi >> 63)
    let shift = upper + 9
    var m = hi >> u64(shift)
    # the biased exponent: floor(q * log2(10)) + 63 + upper - lz + 1023
    var p2 = ((217706 * q) >> 16) + 63 + upper - lz + 1023
    if p2 <= 0:
        # subnormal (never halfway between two floats down here)
        if 1 - p2 >= 64:
            return 0.0
        m = m >> u64(1 - p2)
        m += m & 1
        return float.from_bits(m >> 1)
    if lo <= 1 and q >= -4 and q <= 23 and m & 3 == 1 and m << u64(shift) == hi:
        # exactly halfway: round to even, not up
        m &= ~u64(1)
    m += m & 1
    m = m >> 1
    if m >= u64(2) << 52:
        m = u64(1) << 52
        p2 += 1
    if p2 >= 2047:
        return float.from_bits(F_INF)
    return float.from_bits((u64(p2) << 52) | (m & ((u64(1) << 52) - 1)))

# m * 10^e rounded to a float
fn dec_u64(m: u64, e: int) -> float:
    if m == 0:
        return 0.0
    let r = dec_fast(m, e)
    if r >= 0.0:
        return r
    return eisel_lemire(m, e)

fn dg_at(dg: ptr, i: int) -> u8:
    if i < 0 or i >= load_i64(dg, DG_N):
        return 48
    return load_u8(dg, DG_D + i)

# All the digits of the float with bits ab (no sign), exactly.
fn f_expand(ab: u64, dg: ptr):
    let ef = int(ab >> 52)
    var m = ab & ((u64(1) << 52) - 1)
    var e = -1074
    if ef != 0:
        m |= u64(1) << 52
        e = ef - 1075
    if m == 0:
        store_i64(dg, DG_N, 1)
        store_i64(dg, DG_X, 0)
        store_u8(dg, DG_D, 48)
        return
    if e < 0:
        var z = m.trailing_zeros()
        if z > -e:
            z = -e
        m = m >> u64(z)
        e += z
    # the value is m * 2^e, or m * 5^f / 10^f for f = -e
    var f = 0
    if e < 0:
        f = -e
    var u = m
    var small = false
    if e >= 0:
        small = e <= 11
        u = m << u64(e)
    else:
        small = true
        for _ in 0..f:
            if u > ONES / 5:
                small = false
                break
            u *= 5
    if small:
        let n = dec_len(u)
        put_dec(dg + DG_D, n, u)
        store_i64(dg, DG_N, n)
        store_i64(dg, DG_X, n - 1 - f)
        return
    let b = stack_mem(BN_SIZE)
    bn_set(b, m)
    if e >= 0:
        bn_shl(b, e)
    else:
        bn_mul_pow5(b, f)
    # nine digits at a time, the lowest first
    let ch = stack_mem(720)
    var k = 0
    while bn_len(b) != 0:
        store_u64(ch, k * 8, bn_div_small(b, 1000000000))
        k += 1
    let top = load_u64(ch, (k - 1) * 8)
    let tn = dec_len(top)
    let d = dg + DG_D
    put_dec(d, tn, top)
    var at = tn
    var j = k - 2
    while j >= 0:
        memset(d + at, 48, 9)
        put_dec(d + at, 9, load_u64(ch, j * 8))
        at += 9
        j -= 1
    store_i64(dg, DG_N, at)
    store_i64(dg, DG_X, at - 1 - f)

# src's digits rounded to p of them (p >= 0, ties to even) into dst, which
# may be src; the result is the new exponent
fn dg_round(src: ptr, p: int, dst: ptr) -> int:
    let n = load_i64(src, DG_N)
    var x = load_i64(src, DG_X)
    var keep = n
    var up = false
    if n > p:
        keep = p
        let c = load_u8(src, DG_D + p)
        if c > 53:
            up = true
        elif c == 53:
            for i in p + 1..n:
                if load_u8(src, DG_D + i) != 48:
                    up = true
                    break
            if not up and p > 0:
                up = load_u8(src, DG_D + p - 1) & 1 != 0
    if dst != src:
        copy_bytes(dst + DG_D, src + DG_D, keep)
    if up:
        var i = keep - 1
        while i >= 0 and load_u8(dst, DG_D + i) == 57:
            i -= 1
        if i < 0:
            store_u8(dst, DG_D, 49)
            keep = 1
            x += 1
        else:
            store_u8(dst, DG_D + i, load_u8(dst, DG_D + i) + 1)
            keep = i + 1
    store_i64(dst, DG_N, keep)
    store_i64(dst, DG_X, x)
    return x

# v * 10^s for the float v with bits ab (positive): its floor at out and
# whether it rounds up (ties to even) at out + 8. Exact, in 128 bits, so
# only for 0 <= s <= 27 and a floor below 2^64; false otherwise.
fn fast_round(ab: u64, s: int, out: ptr) -> bool:
    if s < 0 or s > 27:
        return false
    let ef = int(ab >> 52)
    var m = ab & ((u64(1) << 52) - 1)
    var e = -1074
    if ef != 0:
        m |= u64(1) << 52
        e = ef - 1075
    let p5 = POW5_64[s]
    let hi = mul_hi(m, p5)
    let lo = m * p5
    # v * 10^s is (hi, lo) * 2^t
    let t = s + e
    var n: u64 = 0
    var up = false
    if t >= 0:
        if hi != 0 or t >= 64:
            return false
        if t > 0 and lo >> u64(64 - t) != 0:
            return false
        n = lo << u64(t)
    elif t > -64:
        let sh = u64(-t)
        if hi >> sh != 0:
            return false
        n = (lo >> sh) | (hi << (64 - sh))
        let rem = lo & ((u64(1) << sh) - 1)
        let half = u64(1) << (sh - 1)
        up = rem > half or (rem == half and n & 1 != 0)
    elif t == -64:
        n = hi
        up = lo > F_SIGN or (lo == F_SIGN and n & 1 != 0)
    elif t > -128:
        let k = u64(-t - 64)
        n = hi >> k
        let rh = hi & ((u64(1) << k) - 1)
        let hh = u64(1) << (k - 1)
        up = rh > hh or (rh == hh and (lo != 0 or n & 1 != 0))
    # (below that, under 2^-11: 0)
    store_u64(out, 0, n)
    store_bool(out, 8, up)
    return true

# The exponent of v's first decimal digit, or one less: floor(log10(2^k))
# for 2^k <= v < 2^(k+1).
fn exp10_guess(ab: u64) -> int:
    let ef = int(ab >> 52)
    var k = ef - 1023
    if ef == 0:
        k = -1074 + 63 - (ab & ((u64(1) << 52) - 1)).leading_zeros()
    return (k * 78913) >> 18

# v (bits ab, positive) rounded to p significant digits into dg; the
# result is their exponent, or NO_FAST when 128 bits don't do it (then
# f_expand and dg_round do).
fn fast_digits(ab: u64, p: int, dg: ptr) -> int:
    if p > 19:
        return NO_FAST
    let fr = stack_mem(16)
    var x = exp10_guess(ab)
    var tries = 0
    while true:
        if not fast_round(ab, p - 1 - x, fr):
            return NO_FAST
        let n = load_u64(fr, 0)
        tries += 1
        if n >= POW10_64[p] and tries < 3:
            x += 1
        elif n < POW10_64[p - 1] and tries < 3:
            x -= 1
        else:
            break
    var n = load_u64(fr, 0)
    if n >= POW10_64[p] or n < POW10_64[p - 1]:
        return NO_FAST
    if load_bool(fr, 8):
        n += 1
        if n == POW10_64[p]:
            n = POW10_64[p - 1]
            x += 1
    put_dec(dg + DG_D, p, n)
    store_i64(dg, DG_N, p)
    store_i64(dg, DG_X, x)
    return x

# v (bits ab, not negative) rounded to p significant digits into dg; the
# result is their exponent.
fn sig_digits(ab: u64, p: int, dg: ptr) -> int:
    if ab != 0:
        let x = fast_digits(ab, p, dg)
        if x != NO_FAST:
            return x
    f_expand(ab, dg)
    return dg_round(dg, p, dg)

# v (bits ab, not negative) rounded to `prec` decimals into dg.
fn fixed_digits(ab: u64, prec: int, dg: ptr):
    let fr = stack_mem(16)
    if ab != 0 and fast_round(ab, prec, fr) and load_u64(fr, 0) != ONES:
        var n = load_u64(fr, 0)
        if load_bool(fr, 8):
            n += 1
        var k = 0
        if n != 0:
            k = dec_len(n)
            put_dec(dg + DG_D, k, n)
        store_i64(dg, DG_N, k)
        store_i64(dg, DG_X, k - 1 - prec)
        return
    f_expand(ab, dg)
    let k = load_i64(dg, DG_X) + 1 + prec
    if k < 0:
        store_i64(dg, DG_N, 0)
    else:
        dg_round(dg, k, dg)

# Whether the decimal of t's first p digits reads back as a (or as a's f32).
fn reads_back(t: ptr, p: int, x: int, a: float, is32: bool) -> bool:
    var m: u64 = 0
    for i in 0..p:
        m = m * 10 + u64(dg_at(t, i) - 48)
    let r = dec_u64(m, x - (p - 1))
    if is32:
        return f32(r) == f32(a)
    return r == a

# The integer part and `prec` decimals of dg (already rounded there);
# `strip` drops the decimals' trailing zeros and then a bare point.
fn put_fixed(sb: ptr, dg: ptr, prec: int, strip: bool):
    let x = load_i64(dg, DG_X)
    var il = 1
    if x >= 0:
        il = x + 1
    var total = il
    if prec > 0:
        total += 1 + prec
    let d = sb_room(sb, total)
    if x >= 0:
        for i in 0..il:
            store_u8(d, i, dg_at(dg, i))
    else:
        store_u8(d, 0, 48)
    if prec > 0:
        store_u8(d, il, 46)
        for j in 1..prec + 1:
            store_u8(d, il + j, dg_at(dg, x + j))
    var len = total
    if strip and prec > 0:
        while load_u8(d, len - 1) == 48:
            len -= 1
        if load_u8(d, len - 1) == 46:
            len -= 1
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + len)

# d0.d1...e+XX with `prec` digits after the point
fn put_exp(sb: ptr, dg: ptr, prec: int, strip: bool):
    let x = load_i64(dg, DG_X)
    let d = sb_room(sb, prec + 7)
    store_u8(d, 0, dg_at(dg, 0))
    var len = 1
    if prec > 0:
        store_u8(d, 1, 46)
        for i in 1..prec + 1:
            store_u8(d, i + 1, dg_at(dg, i))
        len = prec + 2
        if strip:
            while load_u8(d, len - 1) == 48:
                len -= 1
            if load_u8(d, len - 1) == 46:
                len -= 1
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + len)
    put_exp10(sb, x)

# e+XX: the sign and at least two digits
fn put_exp10(sb: ptr, x: int):
    var ax = x
    if x < 0:
        ax = -x
    var n = 2
    if ax >= 100:
        n = 3
    let d = sb_room(sb, n + 2)
    store_u8(d, 0, 101)
    store_u8(d, 1, 45 if x < 0 else 43)
    store_u8(d, 2, 48)
    put_dec(d + 2, n, u64(ax))
    store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n + 2)

# The shortest decimal that reads back as v, Python style (repr): 0.1,
# 1e+16, 2.5e-08. One of up to 15 digits (6 for an f32) reads back as a
# normal float that prints as itself at that precision, so when the 15
# digits read back the shortest is them without their trailing zeros;
# otherwise it takes 16 or 17. Subnormals, with fewer bits, search from 1
# digit up.
fn fmt_short(sb: ptr, v: float, is32: bool):
    let bits = v.to_bits()
    let ab = bits & ~F_SIGN
    let neg = bits & F_SIGN != 0
    if ab > F_INF:
        sb_lit(sb, "nan")
        return
    if ab == F_INF:
        sb_lit(sb, "-inf" if neg else "inf")
        return
    # every digit, only when the fast way can't round
    let dg = stack_mem(DG_SIZE)
    var full = false
    let t = stack_mem(48)
    let a = float.from_bits(ab)
    var hi = 17
    var lo = 15
    var least: u64 = u64(1) << 52
    if is32:
        hi = 9
        lo = 6
        least = u64(897) << 52
    if ab < least:
        lo = 1
    var p = lo
    var x = 0
    var back = false
    while true:
        x = NO_FAST
        if ab != 0:
            x = fast_digits(ab, p, t)
        if x == NO_FAST:
            if not full:
                f_expand(ab, dg)
                full = true
            x = dg_round(dg, p, t)
        if p == hi:
            break
        back = reads_back(t, p, x, a, is32)
        if back:
            break
        p += 1
    while p > 1 and dg_at(t, p - 1) == 48:
        p -= 1
    if neg:
        sb_byte(sb, 45)
    if x >= -4 and x < 16:
        if x < 0:
            let d = sb_room(sb, p + 1 - x)
            store_u8(d, 0, 48)
            store_u8(d, 1, 46)
            for i in 0..-x - 1:
                store_u8(d, 2 + i, 48)
            for i in 0..p:
                store_u8(d, 1 - x + i, dg_at(t, i))
            store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + p + 1 - x)
        elif is32 and p <= x:
            # a big f32 integer prints all its digits: 16777216.0, not
            # 16777220.0 (for a double below 10^16 the two are the same)
            fixed_digits(ab, 0, dg)
            put_fixed(sb, dg, 0, false)
            sb_lit(sb, ".0")
        else:
            var n = x + 2 + p - x - 1
            if p <= x + 1:
                n = x + 3
            let d = sb_room(sb, n)
            for i in 0..x + 1:
                store_u8(d, i, dg_at(t, i) if i < p else 48)
            store_u8(d, x + 1, 46)
            if p <= x + 1:
                store_u8(d, x + 2, 48)
            for i in x + 1..p:
                store_u8(d, i + 1, dg_at(t, i))
            store_i64(sb, SB_LEN, load_i64(sb, SB_LEN) + n)
    else:
        sb_byte(sb, dg_at(t, 0))
        if p > 1:
            sb_byte(sb, 46)
            for i in 1..p:
                sb_byte(sb, dg_at(t, i))
        put_exp10(sb, x)

fn brine_sb_f64(sb: ptr, v: float):
    fmt_short(sb, v, false)

fn brine_sb_f32(sb: ptr, v: f32):
    fmt_short(sb, float(v), true)

# `{x:.3f}`, `{x:e}`, `{x:g}` as printf has them (precision 6 when prec < 0)
fn brine_sb_fmt_f64(sb: ptr, v: float, prec0: i32, kind0: i32):
    # C callers leave the high halves of int arguments undefined
    let prec = (int(prec0) << 32) >> 32
    let kind = (int(kind0) << 32) >> 32
    let bits = v.to_bits()
    let ab = bits & ~F_SIGN
    if ab >= F_INF or (kind != 102 and kind != 101 and kind != 103):
        fmt_short(sb, v, false)
        return
    var p = prec
    if p < 0:
        p = 6
    let dg = stack_mem(DG_SIZE)
    if bits & F_SIGN != 0:
        sb_byte(sb, 45)
    if kind == 102:
        fixed_digits(ab, p, dg)
        put_fixed(sb, dg, p, false)
    elif kind == 101:
        sig_digits(ab, p + 1, dg)
        put_exp(sb, dg, p, false)
    else:
        if p == 0:
            p = 1
        let x = sig_digits(ab, p, dg)
        if x < p and x >= -4:
            put_fixed(sb, dg, p - 1 - x, true)
        else:
            put_exp(sb, dg, p - 1, true)

fn is_cspace(c: u8) -> bool:
    return c == 32 or (c >= 9 and c <= 13)

fn hex_val(c: u8) -> int:
    if c >= 48 and c <= 57:
        return int(c) - 48
    let l = c | 32
    if l >= 97 and l <= 102:
        return int(l) - 87
    return -1

# Whether p[i..] starts with the lower case word w, in any case.
fn starts_ci(p: ptr, i: int, n: int, w: str) -> bool:
    let wp = ptr_of(w)
    let wn = load_i64(wp, STR_LEN)
    if i + wn > n:
        return false
    for j in 0..wn:
        if load_u8(p, i + j) | 32 != load_u8(wp, STR_DATA + j):
            return false
    return true

# An exponent's digits from *pi on, saturating; *pi moves past them. False
# (and *pi unmoved) if there are none.
fn read_exp(p: ptr, n: int, pi: ptr) -> bool:
    var j = load_i64(pi, 0) + 1
    var neg = false
    if j < n and (load_u8(p, j) == 43 or load_u8(p, j) == 45):
        neg = load_u8(p, j) == 45
        j += 1
    if j >= n or not is_digit(load_u8(p, j)):
        return false
    var x = 0
    while j < n and is_digit(load_u8(p, j)):
        if x < 100000:
            x = x * 10 + int(load_u8(p, j)) - 48
        j += 1
    store_i64(pi, 0, j)
    store_i64(pi, 8, -x if neg else x)
    return true

# A hexadecimal float from *pi on (at its `0x`), as strtod reads it.
fn parse_hex(p: ptr, n: int, pi: ptr) -> float:
    var i = load_i64(pi, 0) + 2
    var m: u64 = 0
    var nsig = 0
    var be = 0
    var sticky = false
    while i < n and hex_val(load_u8(p, i)) >= 0:
        let h = hex_val(load_u8(p, i))
        if nsig < 16:
            m = (m << 4) | u64(h)
            if m != 0:
                nsig += 1
        else:
            be += 4
            sticky = sticky or h != 0
        i += 1
    if i < n and load_u8(p, i) == 46:
        i += 1
        while i < n and hex_val(load_u8(p, i)) >= 0:
            let h = hex_val(load_u8(p, i))
            if nsig < 16:
                m = (m << 4) | u64(h)
                if m != 0:
                    nsig += 1
                be -= 4
            else:
                sticky = sticky or h != 0
            i += 1
    store_i64(pi, 0, i)
    if i < n and load_u8(p, i) | 32 == 112 and read_exp(p, n, pi):
        be += load_i64(pi, 8)
    if m == 0:
        return 0.0
    return make_f64(m, be, sticky)

# A decimal from *pi on, as strtod reads it; -1.0 if there is none.
fn parse_dec(p: ptr, n: int, pi: ptr) -> float:
    let start = load_i64(pi, 0)
    var i = start
    # the first 19 significant digits, how many there are, and the
    # exponent of m's last digit
    # (leading zeros leave m at 0, so they don't count)
    var m: u64 = 0
    var nd = 0
    var e = 0
    while i < n:
        let d = u64(load_u8(p, i)) - 48
        if d >= 10:
            break
        if nd < 19:
            m = m * 10 + d
            if m != 0:
                nd += 1
        else:
            nd += 1
            e += 1
        i += 1
    var any = i > start
    if i < n and load_u8(p, i) == 46:
        i += 1
        let f0 = i
        while i < n:
            let d = u64(load_u8(p, i)) - 48
            if d >= 10:
                break
            if nd < 19:
                m = m * 10 + d
                if m != 0:
                    nd += 1
                e -= 1
            else:
                nd += 1
            i += 1
        any = any or i > f0
    if not any:
        return -1.0
    store_i64(pi, 0, i)
    if i < n and load_u8(p, i) | 32 == 101 and read_exp(p, n, pi):
        e += load_i64(pi, 8)
    if nd == 0:
        return 0.0
    if nd <= 19:
        return dec_u64(m, e)
    # the value is from m * 10^e up to (m + 1) * 10^e: when both ends round
    # to the same float, so does the value
    let r = eisel_lemire(m, e)
    if r.to_bits() == eisel_lemire(m + 1, e).to_bits():
        return r
    return parse_dec_cold(p, n, start)

# A decimal of more than 19 digits from p[i] on, rounded exactly.
fn parse_dec_cold(p: ptr, n: int, i0: int) -> float:
    let dd = stack_mem(DIGITS_ROOM)
    var i = i0
    var nd = 0
    var e = 0
    var sticky = false
    while i < n and is_digit(load_u8(p, i)):
        let c = load_u8(p, i)
        if nd < KEEP_DIGITS:
            if nd > 0 or c != 48:
                store_u8(dd, nd, c)
                nd += 1
        else:
            e += 1
            sticky = sticky or c != 48
        i += 1
    if i < n and load_u8(p, i) == 46:
        i += 1
        while i < n and is_digit(load_u8(p, i)):
            let c = load_u8(p, i)
            if nd < KEEP_DIGITS:
                if nd > 0 or c != 48:
                    store_u8(dd, nd, c)
                    nd += 1
                e -= 1
            else:
                sticky = sticky or c != 48
            i += 1
    let pi = stack_mem(16)
    store_i64(pi, 0, i)
    if i < n and load_u8(p, i) | 32 == 101 and read_exp(p, n, pi):
        e += load_i64(pi, 8)
    if sticky:
        store_u8(dd, nd, 49)
        nd += 1
        e -= 1
    while nd > 0 and load_u8(dd, nd - 1) == 48:
        nd -= 1
        e += 1
    return parse_big(dd, nd, e)

# The digits dd[0..nd) * 10^e rounded to a float, exactly.
fn parse_big(dd: ptr, nd: int, e: int) -> float:
    let d = stack_mem(BN_SIZE)
    bn_set(d, 0)
    var j = 0
    while j < nd:
        var k = nd - j
        if k > 9:
            k = 9
        var c: u64 = 0
        var t: u64 = 1
        for q in 0..k:
            c = c * 10 + u64(load_u8(dd, j + q) - 48)
            t *= 10
        if bn_len(d) == 0:
            bn_set(d, c)
        else:
            bn_mul_add(d, t, c)
        j += k
    return dec_slow_cold(d, nd, e)

# Float text as strtod reads it, with spaces, tabs and newlines after it;
# false if it isn't one.
fn parse_text(p: ptr, n: int, out: ptr) -> bool:
    let pi = stack_mem(16)
    var i = 0
    while i < n and is_cspace(load_u8(p, i)):
        i += 1
    var neg = false
    if i < n and (load_u8(p, i) == 43 or load_u8(p, i) == 45):
        neg = load_u8(p, i) == 45
        i += 1
    var v = 0.0
    let c0 = load_u8(p, i) | 32 if i < n else 0
    if c0 == 105 and starts_ci(p, i, n, "inf"):
        i += 3
        if starts_ci(p, i, n, "inity"):
            i += 5
        v = float.from_bits(F_INF)
    elif c0 == 110 and starts_ci(p, i, n, "nan"):
        i += 3
        if i < n and load_u8(p, i) == 40:
            var j = i + 1
            while j < n and (
                is_digit(load_u8(p, j))
                or (load_u8(p, j) | 32 >= 97 and load_u8(p, j) | 32 <= 122)
                or load_u8(p, j) == 95
            ):
                j += 1
            if j < n and load_u8(p, j) == 41:
                i = j + 1
        v = float.from_bits(F_NAN)
    else:
        store_i64(pi, 0, i)
        let hex = (
            i + 2 < n
            and load_u8(p, i) == 48
            and load_u8(p, i + 1) | 32 == 120
            and (
                hex_val(load_u8(p, i + 2)) >= 0
                or (i + 3 < n and load_u8(p, i + 2) == 46 and hex_val(load_u8(p, i + 3)) >= 0)
            )
        )
        if hex:
            v = parse_hex(p, n, pi)
        else:
            v = parse_dec(p, n, pi)
        if v < 0.0:
            # nothing read: strtod gives 0 and the end is the start
            i = 0
            v = 0.0
            neg = false
        else:
            i = load_i64(pi, 0)
    while i < n and (
        load_u8(p, i) == 32 or load_u8(p, i) == 10 or load_u8(p, i) == 13 or load_u8(p, i) == 9
    ):
        i += 1
    if neg:
        v = -v
    store_f64(out, 0, v)
    return n != 0 and i == n

# Float text as `float()` reads it (`_` between digits too).
# The common case of parse_text, quickly: a sign, at most 19 significant
# digits and an exponent, then only spaces, tabs or newlines. False for
# anything else, which parse_text then reads.
fn parse_short(p: ptr, n: int, out: ptr) -> bool:
    var i = 0
    var neg = false
    if n > 0 and (load_u8(p, 0) == 45 or load_u8(p, 0) == 43):
        neg = load_u8(p, 0) == 45
        i = 1
    let start = i
    # leading zeros don't count; past 19 digits m wraps but isn't used
    while i < n and load_u8(p, i) == 48:
        i += 1
    var m: u64 = 0
    var d0 = i
    while i < n:
        let d = u64(load_u8(p, i)) - 48
        if d >= 10:
            break
        m = m * 10 + d
        i += 1
    var nd = i - d0
    var any = i > start
    var e = 0
    if i < n and load_u8(p, i) == 46:
        i += 1
        let f0 = i
        if nd == 0:
            while i < n and load_u8(p, i) == 48:
                i += 1
        d0 = i
        while i < n:
            let d = u64(load_u8(p, i)) - 48
            if d >= 10:
                break
            m = m * 10 + d
            i += 1
        nd += i - d0
        e = f0 - i
        any = any or i > f0
    if not any or nd > 19:
        return false
    if i < n and load_u8(p, i) | 32 == 101:
        i += 1
        var eneg = false
        if i < n and (load_u8(p, i) == 45 or load_u8(p, i) == 43):
            eneg = load_u8(p, i) == 45
            i += 1
        let x0 = i
        var x = 0
        while i < n:
            let d = u64(load_u8(p, i)) - 48
            if d >= 10:
                break
            if x > 10000:
                return false
            x = x * 10 + int(d)
            i += 1
        if i == x0:
            return false
        e += -x if eneg else x
    while i < n and (
        load_u8(p, i) == 32 or load_u8(p, i) == 10 or load_u8(p, i) == 13 or load_u8(p, i) == 9
    ):
        i += 1
    if i != n:
        return false
    let v = 0.0 if m == 0 else dec_u64(m, e)
    store_f64(out, 0, -v if neg else v)
    return true

fn parse_float(s: ptr, out: ptr) -> bool:
    let p = s + STR_DATA
    let n = load_i64(s, STR_LEN)
    if parse_short(p, n, out):
        return true
    # text with an underscore never reads as a number, but "nan(1_2)" reads
    # as a nan with or without it, and the underscores must still be checked
    if parse_text(p, n, out):
        let v = load_f64(out, 0)
        if v == v or memchr(p, 95, u64(n)) == null_ptr():
            return true
    elif n == 0 or memchr(p, 95, u64(n)) == null_ptr():
        return false
    let tmp = blk_alloc(n + 1)
    var m = 0
    for i in 0..n:
        let c = load_u8(p, i)
        if c != 95:
            store_u8(tmp, m, c)
            m += 1
        elif (
            i == 0
            or i + 1 == n
            or not is_digit(load_u8(p, i - 1))
            or not is_digit(load_u8(p, i + 1))
        ):
            blk_free(tmp)
            return false
    let ok = parse_text(tmp, m, out)
    blk_free(tmp)
    return ok

fn float_bad_cold(s: ptr, loc: ptr):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, "invalid float: \"")
    brine_sb_str(sb, s)
    sb_lit(sb, "\"")
    brine_panic_at(loc, str_of(brine_sb_finish(sb)))

fn brine_parse_f64(s: ptr, loc: ptr) -> float:
    let o = stack_mem(8)
    if not parse_float(s, o):
        float_bad_cold(s, loc)
    return load_f64(o, 0)

fn brine_try_parse_float(s: ptr, is32: bool, out: ptr) -> bool:
    let o = stack_mem(8)
    if not parse_float(s, o):
        return false
    if is32:
        store_f32(out, 0, f32(load_f64(o, 0)))
    else:
        store_f64(out, 0, load_f64(o, 0))
    return true

# ------------------------------------------------------------ arrays
# brine_arr: a count, the length, the room, the element size, the
# functions that retain and release an element (0 for plain data), the
# elements

const ARR_RC = 0
const ARR_LEN = 8
const ARR_CAP = 16
const ARR_ESZ = 24
const ARR_RT = 32
const ARR_RL = 40
const ARR_DATA = 48
const ARR_SIZE = 56

# n zero bytes from the C library's heap
extern fn brine_x_calloc(n: int) -> ptr

extern fn memchr(p: ptr, c: i32, n: u64) -> ptr

extern fn brine_panic_idx(i: int, len: int, loc: ptr)

# Is block p from our own heap (brine_rt.c's br_in_heap)?
fn in_heap(p: ptr) -> bool:
    let hi = symbol("brine_heap_info")
    let base = load_u64(hi, HI_BASE)
    return addr(p) - base < load_u64(hi, HI_END) - base

# an array header with count 1
fn arr_header(len: int, cap: int, esz: int, rt: ptr, rl: ptr) -> ptr:
    let a = new_counted(ARR_SIZE)
    store_i64(a, ARR_RC, 1)
    store_i64(a, ARR_LEN, len)
    store_i64(a, ARR_CAP, cap)
    store_i64(a, ARR_ESZ, esz)
    store_ptr(a, ARR_RT, rt)
    store_ptr(a, ARR_RL, rl)
    store_u64(a, ARR_DATA, 0)
    return a

# frees the elements first, past a depth on a list (brine_drop)
extern fn brine_x_arr_drop(a: ptr)

fn brine_arr_free(a: ptr):
    if addr(load_ptr(a, ARR_RL)) != 0:
        brine_x_arr_drop(a)
        return
    let d = load_ptr(a, ARR_DATA)
    if addr(d) != 0:
        blk_free(d)
    free_counted(a)

fn neg_len(len: int, loc: ptr):
    brine_panic_at(loc, f"cannot create an array with negative length {len}")

fn brine_arr_new(len: int, esz: int, rt: ptr, rl: ptr, loc: ptr) -> ptr:
    if len < 0:
        neg_len(len, loc)
    let a = arr_header(len, len, esz, rt, rl)
    # no data until the first push: `xs[i] = []`, which takes an inner
    # array out to change it, then costs one allocation, not two
    if len == 0:
        return a
    if esz > 0 and len <= SMALL / esz:
        # small: a block of our heap, whose spare room the first pushes use
        # (`[]` then `push` doesn't reallocate)
        let bytes = len * esz
        let d = blk_alloc(bytes)
        memset(d, 0, u64(bytes))
        store_ptr(a, ARR_DATA, d)
        if in_heap(d):
            store_i64(a, ARR_CAP, class_size(size_class(bytes)) / esz)
        return a
    store_ptr(a, ARR_DATA, brine_x_calloc(len * esz))
    return a

# An integer array kept as bytes (narrow.br), zeroed, with 16 more bytes
# than it needs for brine_bytes_rev and friends. It is never shared, so
# never copied.
fn brine_bytes_new(len: int, loc: ptr) -> ptr:
    if len < 0:
        neg_len(len, loc)
    let a = arr_header(len, len + 16, 1, null_ptr(), null_ptr())
    store_ptr(a, ARR_DATA, brine_x_calloc(len + 16))
    return a

# A `[bool]` kept as bits (the compiler's pack.br): `len` elements in 64-bit
# words. `esz` 0 marks it; only indexing, `len` and freeing ever see one.
fn brine_bits_new(len: int, fill: int, loc: ptr) -> ptr:
    if len < 0:
        neg_len(len, loc)
    let a = arr_header(len, len, 0, null_ptr(), null_ptr())
    let bytes = (len / 64 + 1) * 8
    let d = brine_x_calloc(bytes)
    if fill != 0:
        memset(d, 0xff, u64(bytes))
    store_ptr(a, ARR_DATA, d)
    return a

# Calls f (an element's retain or release) on each of the n elements at d.
fn each_elem(f: ptr, d: ptr, n: int, esz: int):
    for i in 0..n:
        call_void(f, d + i * esz)

fn brine_arr_unique(pa: ptr):
    let a = load_ptr(pa, 0)
    if load_i64(a, ARR_RC) == 1:
        return
    let n = new_counted(ARR_SIZE)
    memcpy(n, a, u64(ARR_SIZE))
    let len = load_i64(a, ARR_LEN)
    let esz = load_i64(a, ARR_ESZ)
    store_i64(n, ARR_RC, 1)
    store_i64(n, ARR_CAP, len)
    let bytes = len * esz if esz != 0 else (len / 64 + 1) * 8
    let d = blk_alloc(bytes)
    memcpy(d, load_ptr(a, ARR_DATA), u64(bytes))
    store_ptr(n, ARR_DATA, d)
    let rt = load_ptr(a, ARR_RT)
    if addr(rt) != 0:
        each_elem(rt, d, len, esz)
    arr_release(a)
    store_ptr(pa, 0, n)

fn arr_reserve(a: ptr, need: int):
    let cap = load_i64(a, ARR_CAP)
    if need <= cap:
        return
    var nc = cap * 2 if cap != 0 else 4
    if nc < need:
        nc = need
    let d = brine_x_realloc(load_ptr(a, ARR_DATA), nc * load_i64(a, ARR_ESZ))
    store_ptr(a, ARR_DATA, d)
    store_i64(a, ARR_CAP, nc)

# the address of element i
fn elem_at(a: ptr, i: int) -> ptr:
    return load_ptr(a, ARR_DATA) + i * load_i64(a, ARR_ESZ)

fn brine_arr_push(pa: ptr, elem: ptr):
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let len = load_i64(a, ARR_LEN)
    arr_reserve(a, len + 1)
    copy_bytes(elem_at(a, len), elem, load_i64(a, ARR_ESZ))
    store_i64(a, ARR_LEN, len + 1)

fn brine_arr_pop(pa: ptr, out: ptr, loc: ptr):
    if load_i64(load_ptr(pa, 0), ARR_LEN) == 0:
        brine_panic_at(loc, "pop() from an empty array")
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let len = load_i64(a, ARR_LEN) - 1
    store_i64(a, ARR_LEN, len)
    copy_bytes(out, elem_at(a, len), load_i64(a, ARR_ESZ))

fn brine_arr_pop_at(pa: ptr, i: int, out: ptr, loc: ptr):
    let len0 = load_i64(load_ptr(pa, 0), ARR_LEN)
    if u64(i) >= u64(len0):
        brine_panic_idx(i, len0, loc)
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let len = load_i64(a, ARR_LEN)
    copy_bytes(out, elem_at(a, i), esz)
    memmove(elem_at(a, i), elem_at(a, i + 1), u64((len - i - 1) * esz))
    store_i64(a, ARR_LEN, len - 1)

fn brine_arr_insert(pa: ptr, i: int, elem: ptr, loc: ptr):
    let a0 = load_ptr(pa, 0)
    let len0 = load_i64(a0, ARR_LEN)
    if i < 0 or i > len0:
        let rl = load_ptr(a0, ARR_RL)
        if addr(rl) != 0:
            call_void(rl, elem)
        brine_panic_at(loc, f"insert index {i} is out of bounds for length {len0}")
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let len = load_i64(a, ARR_LEN)
    arr_reserve(a, len + 1)
    memmove(elem_at(a, i + 1), elem_at(a, i), u64((len - i) * esz))
    copy_bytes(elem_at(a, i), elem, esz)
    store_i64(a, ARR_LEN, len + 1)

fn brine_arr_extend(pa: ptr, b: ptr):
    let n = load_i64(b, ARR_LEN)
    if n == 0:
        return
    # b may be *pa itself
    arr_retain(b)
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let len = load_i64(a, ARR_LEN)
    arr_reserve(a, len + n)
    let d = elem_at(a, len)
    memcpy(d, load_ptr(b, ARR_DATA), u64(n * esz))
    let rt = load_ptr(a, ARR_RT)
    if addr(rt) != 0:
        each_elem(rt, d, n, esz)
    store_i64(a, ARR_LEN, len + n)
    arr_release(b)

# a `str` argument of an `extern fn`: a NUL-terminated copy for the call
fn brine_cstr(s: ptr, loc: ptr) -> ptr:
    let n = load_i64(s, STR_LEN)
    let z = memchr(s + STR_DATA, 0, u64(n))
    if addr(z) != 0:
        let at = addr(z) - addr(s + STR_DATA)
        brine_panic_at(loc, f"a string passed to an extern function contains a NUL byte (at {at})")
    let p = blk_alloc(n + 1)
    memcpy(p, s + STR_DATA, u64(n))
    store_u8(p, n, 0)
    return p

fn brine_cstr_free(p: ptr):
    blk_free(p)

# A new array of the n elements at d, each retained.
fn copy_elems(a: ptr, d: ptr, n: int, loc: ptr) -> ptr:
    let esz = load_i64(a, ARR_ESZ)
    let rt = load_ptr(a, ARR_RT)
    let r = brine_arr_new(n, esz, rt, load_ptr(a, ARR_RL), loc)
    memcpy(load_ptr(r, ARR_DATA), d, u64(n * esz))
    if addr(rt) != 0:
        each_elem(rt, load_ptr(r, ARR_DATA), n, esz)
    return r

# `a + b`: a new array (or a shared one when a side is empty)
fn brine_arr_concat(a: ptr, b: ptr, loc: ptr) -> ptr:
    let la = load_i64(a, ARR_LEN)
    let lb = load_i64(b, ARR_LEN)
    if la == 0 or lb == 0:
        let r = b if la == 0 else a
        arr_retain(r)
        return r
    let esz = load_i64(a, ARR_ESZ)
    let rt = load_ptr(a, ARR_RT)
    let r = brine_arr_new(la + lb, esz, rt, load_ptr(a, ARR_RL), loc)
    let d = load_ptr(r, ARR_DATA)
    memcpy(d, load_ptr(a, ARR_DATA), u64(la * esz))
    memcpy(d + la * esz, load_ptr(b, ARR_DATA), u64(lb * load_i64(b, ARR_ESZ)))
    if addr(rt) != 0:
        each_elem(rt, d, la + lb, esz)
    return r

fn brine_arr_reverse(pa: ptr):
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let small = stack_mem(64)
    let t = small if esz <= 64 else blk_alloc(esz)
    var i = 0
    var j = load_i64(a, ARR_LEN) - 1
    while i < j:
        copy_bytes(t, elem_at(a, i), esz)
        copy_bytes(elem_at(a, i), elem_at(a, j), esz)
        copy_bytes(elem_at(a, j), t, esz)
        i += 1
        j -= 1
    if esz > 64:
        blk_free(t)

fn brine_arr_clear(pa: ptr):
    let a = load_ptr(pa, 0)
    let esz = load_i64(a, ARR_ESZ)
    let rl = load_ptr(a, ARR_RL)
    if load_i64(a, ARR_RC) != 1:
        store_ptr(pa, 0, brine_arr_new(0, esz, load_ptr(a, ARR_RT), rl, ptr_of("") + STR_DATA))
        arr_release(a)
        return
    if addr(rl) != 0:
        each_elem(rl, load_ptr(a, ARR_DATA), load_i64(a, ARR_LEN), esz)
    store_i64(a, ARR_LEN, 0)

# A stable merge sort of the n elements at d; tmp holds n / 2 + 1.
fn msort(d: ptr, tmp: ptr, n: int, esz: int, cmp: ptr):
    if n < 2:
        return
    let h = n / 2
    msort(d, tmp, h, esz, cmp)
    msort(d + h * esz, tmp, n - h, esz, cmp)
    if call_i32(cmp, d + (h - 1) * esz, d + h * esz) <= 0:
        return
    memcpy(tmp, d, u64(h * esz))
    var i = 0
    var j = h
    var k = 0
    while i < h and j < n:
        if call_i32(cmp, d + j * esz, tmp + i * esz) < 0:
            copy_bytes(d + k * esz, d + j * esz, esz)
            j += 1
        else:
            copy_bytes(d + k * esz, tmp + i * esz, esz)
            i += 1
        k += 1
    while i < h:
        copy_bytes(d + k * esz, tmp + i * esz, esz)
        k += 1
        i += 1

fn brine_arr_sort(pa: ptr, cmp: ptr):
    if load_i64(load_ptr(pa, 0), ARR_LEN) < 2:
        return
    brine_arr_unique(pa)
    let a = load_ptr(pa, 0)
    let len = load_i64(a, ARR_LEN)
    let esz = load_i64(a, ARR_ESZ)
    let tmp = blk_alloc((len / 2 + 1) * esz)
    msort(load_ptr(a, ARR_DATA), tmp, len, esz, cmp)
    blk_free(tmp)

fn brine_arr_slice(a: ptr, lo: int, hi: int, loc: ptr) -> ptr:
    let len = load_i64(a, ARR_LEN)
    if lo < 0 or lo > hi or hi > len:
        brine_panic_at(loc, f"slice [{lo}:{hi}] is out of bounds for an array of length {len}")
    if lo == 0 and hi == len:
        arr_retain(a)
        return a
    return copy_elems(a, elem_at(a, lo), hi - lo, loc)

# ------------------------------------------------------------ maps
# brine_map: entries in insertion order (keys, values, hashes, live flags;
# slots [0, used)) and `index`, an open-addressing table of entry numbers:
# -1 empty, -2 removed. brine_map_ty: the key and value sizes, then the
# functions that hash, compare, write and retain or release them.

const MAP_USED = 16
const MAP_CAP = 24
const MAP_TY = 40
const MAP_LIVE = 72
const MAP_SIZE = 88

const MT_KSZ = 0
const MT_VSZ = 8
const MT_HASH = 16
const MT_KEQ = 24
const MT_VEQ = 32
const MT_KFMT = 40
const MT_KRT = 48
const MT_KRL = 56
const MT_VRT = 64
const MT_VRL = 72

# frees a map whose keys or values hold something, past a depth on a list
# (brine_drop)
extern fn brine_x_map_drop(m: ptr)

fn brine_map_new(ty: ptr) -> ptr:
    let m = new_counted(MAP_SIZE)
    memset(m, 0, u64(MAP_SIZE))
    store_i64(m, MAP_RC, 1)
    store_ptr(m, MAP_TY, ty)
    return m

fn free_if(p: ptr):
    if addr(p) != 0:
        blk_free(p)

fn brine_map_free(m: ptr):
    let t = load_ptr(m, MAP_TY)
    if addr(load_ptr(t, MT_KRL)) != 0 or addr(load_ptr(t, MT_VRL)) != 0:
        brine_x_map_drop(m)
        return
    free_if(load_ptr(m, MAP_KEYS))
    free_if(load_ptr(m, MAP_VALS))
    free_if(load_ptr(m, MAP_HASHES))
    free_if(load_ptr(m, MAP_LIVE))
    free_if(load_ptr(m, MAP_INDEX))
    free_counted(m)

# The index made again for the entries (a sparse one: fewer probes, and few
# maps are big enough for it to cost much).
fn map_reindex(m: ptr):
    var n = 8
    while n < 4 * load_i64(m, MAP_CAP):
        n *= 2
    free_if(load_ptr(m, MAP_INDEX))
    store_i64(m, MAP_NIDX, n)
    let ix = blk_alloc(n * 8)
    # all -1
    memset(ix, 0xff, u64(n * 8))
    store_ptr(m, MAP_INDEX, ix)
    let mask = u64(n - 1)
    let hs = load_ptr(m, MAP_HASHES)
    let live = load_ptr(m, MAP_LIVE)
    for e in 0..load_i64(m, MAP_USED):
        if not load_bool(live, e):
            continue
        var i = load_u64(hs, e * 8) & mask
        while load_i64(ix, int(i) * 8) != -1:
            i = (i + 1) & mask
        store_i64(ix, int(i) * 8, e)

# The entry arrays with room for `cap` entries (at least `used`), without
# the removed ones.
fn map_resize_cold(m: ptr, cap: int):
    let t = load_ptr(m, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let ok = load_ptr(m, MAP_KEYS)
    let ov = load_ptr(m, MAP_VALS)
    let oh = load_ptr(m, MAP_HASHES)
    let ol = load_ptr(m, MAP_LIVE)
    let used = load_i64(m, MAP_USED)
    if used == load_i64(m, MAP_LEN):
        # nothing removed: the arrays just grow
        store_ptr(m, MAP_KEYS, brine_x_realloc(ok, cap * ksz + 1))
        store_ptr(m, MAP_VALS, brine_x_realloc(ov, cap * vsz + 1))
        store_ptr(m, MAP_HASHES, brine_x_realloc(oh, cap * 8))
        store_ptr(m, MAP_LIVE, brine_x_realloc(ol, cap))
    else:
        let k = blk_alloc(cap * ksz + 1)
        let v = blk_alloc(cap * vsz + 1)
        let h = blk_alloc(cap * 8)
        let l = blk_alloc(cap)
        var j = 0
        for i in 0..used:
            if not load_bool(ol, i):
                continue
            copy_bytes(k + j * ksz, ok + i * ksz, ksz)
            copy_bytes(v + j * vsz, ov + i * vsz, vsz)
            store_u64(h, j * 8, load_u64(oh, i * 8))
            store_bool(l, j, true)
            j += 1
        free_if(ok)
        free_if(ov)
        free_if(oh)
        free_if(ol)
        store_ptr(m, MAP_KEYS, k)
        store_ptr(m, MAP_VALS, v)
        store_ptr(m, MAP_HASHES, h)
        store_ptr(m, MAP_LIVE, l)
        store_i64(m, MAP_USED, j)
    store_i64(m, MAP_CAP, cap)
    map_reindex(m)

# A copy of block p's first n bytes in a new block of n + 1 bytes.
fn dup_bytes(p: ptr, n: int) -> ptr:
    let d = blk_alloc(n + 1)
    if n > 0:
        memcpy(d, p, u64(n))
    return d

fn brine_map_unique(pm: ptr):
    map_own(pm)

# Makes *pm a map nothing else holds, to change it.
fn map_own(pm: ptr):
    if load_i64(load_ptr(pm, 0), MAP_RC) != 1:
        map_copy_cold(pm)

fn map_copy_cold(pm: ptr):
    let a = load_ptr(pm, 0)
    let t = load_ptr(a, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let n = brine_map_new(t)
    # copies of the entry arrays; map_resize_cold then compacts them and makes
    # the index
    let used = load_i64(a, MAP_USED)
    store_i64(n, MAP_USED, used)
    store_ptr(n, MAP_KEYS, dup_bytes(load_ptr(a, MAP_KEYS), used * ksz))
    store_ptr(n, MAP_VALS, dup_bytes(load_ptr(a, MAP_VALS), used * vsz))
    store_ptr(n, MAP_HASHES, dup_bytes(load_ptr(a, MAP_HASHES), used * 8))
    store_ptr(n, MAP_LIVE, dup_bytes(load_ptr(a, MAP_LIVE), used))
    let len = load_i64(a, MAP_LEN)
    store_i64(n, MAP_LEN, len)
    map_resize_cold(n, len if len > 4 else 4)
    let krt = load_ptr(t, MT_KRT)
    let vrt = load_ptr(t, MT_VRT)
    if addr(krt) != 0:
        each_elem(krt, load_ptr(n, MAP_KEYS), load_i64(n, MAP_USED), ksz)
    if addr(vrt) != 0:
        each_elem(vrt, load_ptr(n, MAP_VALS), load_i64(n, MAP_USED), vsz)
    map_release(a)
    store_ptr(pm, 0, n)

# The entry of key k (hash h) in m, or -1.
fn map_lookup(m: ptr, k: ptr, h: u64) -> int:
    let t = load_ptr(m, MAP_TY)
    return map_probe(m, k, h, load_ptr(t, MT_KEQ), load_i64(t, MT_KSZ), false)

fn brine_map_find(m: ptr, k: ptr) -> int:
    if load_i64(m, MAP_LEN) == 0:
        return -1
    return map_lookup(m, k, call_u64(load_ptr(load_ptr(m, MAP_TY), MT_HASH), k))

fn map_missing_cold(m: ptr, k: ptr, loc: ptr):
    let sb = stack_mem(24)
    brine_sb_init(sb)
    sb_lit(sb, "key ")
    call_void(load_ptr(load_ptr(m, MAP_TY), MT_KFMT), sb, k)
    sb_lit(sb, " is not in the map")
    brine_panic_at(loc, str_of(brine_sb_finish(sb)))

fn brine_map_at(m: ptr, k: ptr, loc: ptr) -> ptr:
    let e = brine_map_find(m, k)
    if e < 0:
        map_missing_cold(m, k, loc)
    return load_ptr(m, MAP_VALS) + e * load_i64(load_ptr(m, MAP_TY), MT_VSZ)

# The value of entry e (of key k) after making the map unique; copying it
# compacts the entries, so e can change.
fn val_unique(pm: ptr, e0: int, k: ptr) -> ptr:
    let before = load_ptr(pm, 0)
    map_own(pm)
    let m = load_ptr(pm, 0)
    let e = e0 if m == before else brine_map_find(m, k)
    return load_ptr(m, MAP_VALS) + e * load_i64(load_ptr(m, MAP_TY), MT_VSZ)

fn brine_map_at_mut(pm: ptr, k: ptr, loc: ptr) -> ptr:
    let e = brine_map_find(load_ptr(pm, 0), k)
    if e < 0:
        map_missing_cold(load_ptr(pm, 0), k, loc)
    return val_unique(pm, e, k)

fn brine_map_val_mut_slow(pm: ptr, e: int, k: ptr, loc: ptr) -> ptr:
    if e < 0:
        # panics
        return brine_map_at_mut(pm, k, loc)
    return val_unique(pm, e, k)

fn brine_map_set(pm: ptr, k: ptr, v: ptr):
    map_own(pm)
    let m = load_ptr(pm, 0)
    let t = load_ptr(m, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let h = call_u64(load_ptr(t, MT_HASH), k)
    let found = map_lookup(m, k, h)
    if found >= 0:
        let krl = load_ptr(t, MT_KRL)
        if addr(krl) != 0:
            call_void(krl, k)
        let vp = load_ptr(m, MAP_VALS) + found * vsz
        let vrl = load_ptr(t, MT_VRL)
        if addr(vrl) != 0:
            call_void(vrl, vp)
        copy_bytes(vp, v, vsz)
        return
    if load_i64(m, MAP_USED) == load_i64(m, MAP_CAP):
        let n = load_i64(m, MAP_LEN) * 2
        map_resize_cold(m, n if n > 8 else 8)
    let e = load_i64(m, MAP_USED)
    store_i64(m, MAP_USED, e + 1)
    copy_bytes(load_ptr(m, MAP_KEYS) + e * ksz, k, ksz)
    copy_bytes(load_ptr(m, MAP_VALS) + e * vsz, v, vsz)
    store_u64(load_ptr(m, MAP_HASHES), e * 8, h)
    store_bool(load_ptr(m, MAP_LIVE), e, true)
    store_i64(m, MAP_LEN, load_i64(m, MAP_LEN) + 1)
    let mask = load_u64(m, MAP_NIDX) - 1
    let ix = load_ptr(m, MAP_INDEX)
    var i = h & mask
    while load_i64(ix, int(i) * 8) >= 0:
        i = (i + 1) & mask
    store_i64(ix, int(i) * 8, e)

fn brine_map_remove(pm: ptr, k: ptr) -> bool:
    if brine_map_find(load_ptr(pm, 0), k) < 0:
        return false
    map_own(pm)
    let m = load_ptr(pm, 0)
    let t = load_ptr(m, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let h = call_u64(load_ptr(t, MT_HASH), k)
    let e = map_lookup(m, k, h)
    let mask = load_u64(m, MAP_NIDX) - 1
    let ix = load_ptr(m, MAP_INDEX)
    var i = h & mask
    while load_i64(ix, int(i) * 8) != e:
        i = (i + 1) & mask
    store_i64(ix, int(i) * 8, -2)
    store_bool(load_ptr(m, MAP_LIVE), e, false)
    store_i64(m, MAP_LEN, load_i64(m, MAP_LEN) - 1)
    let krl = load_ptr(t, MT_KRL)
    if addr(krl) != 0:
        call_void(krl, load_ptr(m, MAP_KEYS) + e * ksz)
    let vrl = load_ptr(t, MT_VRL)
    if addr(vrl) != 0:
        call_void(vrl, load_ptr(m, MAP_VALS) + e * load_i64(t, MT_VSZ))
    return true

# The keys or the values, as an array.
fn map_column(m: ptr, keys: bool) -> ptr:
    let t = load_ptr(m, MAP_TY)
    let sz = load_i64(t, MT_KSZ if keys else MT_VSZ)
    let rt = load_ptr(t, MT_KRT if keys else MT_VRT)
    let rl = load_ptr(t, MT_KRL if keys else MT_VRL)
    let a = brine_arr_new(load_i64(m, MAP_LEN), sz, rt, rl, ptr_of("") + STR_DATA)
    let src = load_ptr(m, MAP_KEYS if keys else MAP_VALS)
    let live = load_ptr(m, MAP_LIVE)
    let d = load_ptr(a, ARR_DATA)
    var j = 0
    for i in 0..load_i64(m, MAP_USED):
        if not load_bool(live, i):
            continue
        copy_bytes(d + j * sz, src + i * sz, sz)
        if addr(rt) != 0:
            call_void(rt, d + j * sz)
        j += 1
    return a

fn brine_map_keys(m: ptr) -> ptr:
    return map_column(m, true)

fn brine_map_values(m: ptr) -> ptr:
    return map_column(m, false)

fn brine_map_eq(a: ptr, b: ptr) -> bool:
    if a == b:
        return true
    if load_i64(a, MAP_LEN) != load_i64(b, MAP_LEN):
        return false
    let t = load_ptr(a, MAP_TY)
    let ksz = load_i64(t, MT_KSZ)
    let vsz = load_i64(t, MT_VSZ)
    let veq = load_ptr(t, MT_VEQ)
    let live = load_ptr(a, MAP_LIVE)
    for i in 0..load_i64(a, MAP_USED):
        if not load_bool(live, i):
            continue
        let k = load_ptr(a, MAP_KEYS) + i * ksz
        let e = map_lookup(b, k, load_u64(load_ptr(a, MAP_HASHES), i * 8))
        if e < 0:
            return false
        if not call_bool(veq, load_ptr(a, MAP_VALS) + i * vsz, load_ptr(b, MAP_VALS) + e * vsz):
            return false
    return true
