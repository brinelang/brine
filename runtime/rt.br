# The runtime's fast paths, in brine. Native code calls these instead of the
# C runtime's (brine_rt.h has the same functions, with the same parameters
# and results) and inlines them; the slow paths stay in C for now.
#
# This module alone has `ptr`, a raw address, with `p + n` and `p - n`, and
# the memory operations `load_<t>(p, off)`, `store_<t>(p, off, v)` (t is
# i64, u64, u8 or ptr), `call_bool(f, ...)`, `bswap(x)`, `thread_ptr()`,
# `addr(p)` (p as a number) and `symbol("name")` (a C symbol's address).
# Its arithmetic wraps, and the prover doesn't look at it.

# brine_str: a reference count (negative: immortal), the length, then the
# bytes and a NUL. Every string can be read to the end of the 8-byte word
# that holds its NUL, so short ones are handled a word at a time.
const STR_RC = 0
const STR_LEN = 8
const STR_DATA = 16

# brine_map
const MAP_RC = 0
const MAP_LEN = 8
const MAP_NIDX = 32
const MAP_KEYS = 48
const MAP_VALS = 56
const MAP_HASHES = 64
const MAP_INDEX = 80

# brine_app, the appender of a loop doing `s += t[i]`
const APP_DATA = 0
const APP_LEN = 8
const APP_ROOM = 16
const APP_LIM = 24
const APP_W0 = 32

# brine_heap_info (brine_rt.c): where a thread's heap is, the heap's range,
# each chunk's size class, and whether allocation may skip C
const HI_OFF = 0
const HI_IND = 8
const HI_BASE = 16
const HI_END = 24
const HI_CLASSES = 32
const HI_FAST = 40

# br_heap_th: a free list and a count of free blocks per size class
const TH_HEAD = 0
const TH_COUNT = 96

const SMALL = 256
const SPARE = 65536

const ONES: u64 = 0xffffffffffffffff

extern fn brine_str_eq_long(a: ptr, b: ptr) -> bool

extern fn brine_hash_long(p: ptr, n: u64) -> u64

extern fn brine_map_at(m: ptr, k: ptr, loc: ptr) -> ptr

extern fn brine_map_val_mut_slow(pm: ptr, e: int, k: ptr, loc: ptr) -> ptr

extern fn brine_x_str_reset(ps: ptr, lit: ptr)

extern fn brine_x_str_add_byte(ps: ptr, c: u8)

extern fn brine_x_str_add(ps: ptr, b: ptr)

extern fn brine_x_str_at(s: ptr, i: int, loc: ptr) -> ptr

extern fn brine_x_str_room(n: int) -> int

extern fn brine_x_app_byte(ps: ptr, ap: ptr, c: u8)

extern fn brine_box_new(size: int, tag: int) -> ptr

extern fn brine_box_free(p: ptr)

# the low n bytes of a word, 0 <= n <= 8
fn lowmask(n: u64) -> u64:
    if n >= 8:
        return ONES
    return ~(ONES << (n * 8))

# The longest string the block of a string of length n holds (brine_str_room).
fn str_room(n: int) -> int:
    if n > 47:
        return brine_x_str_room(n)
    return ((n + 32) & ~15) - 17

fn str_eq(a: ptr, b: ptr) -> bool:
    if a == b:
        return true
    let n = load_u64(a, STR_LEN)
    if n != load_u64(b, STR_LEN):
        return false
    if n <= 8:
        return ((load_u64(a, STR_DATA) ^ load_u64(b, STR_DATA)) & lowmask(n)) == 0
    return brine_str_eq_long(a, b)

# The hashes of generated hash functions (splitmix64's finalizer)
fn hash_u64(x0: u64) -> u64:
    var x = x0
    x ^= x >> 30
    x *= 0xbf58476d1ce4e5b9
    x ^= x >> 27
    x *= 0x94d049bb133111eb
    x ^= x >> 31
    return x

fn hash_mix(h: u64, x: u64) -> u64:
    return hash_u64(h ^ (x + 0x9e3779b97f4a7c15 + (h << 6) + (h >> 2)))

# A string of up to 7 bytes hashes to its bytes and length, mixed one to
# one, so equal hashes mean equal strings (brine_hash_str).
fn hash_str(s: ptr) -> u64:
    let n = load_u64(s, STR_LEN)
    if n < 8:
        let w = (load_u64(s, STR_DATA) & lowmask(n)) | n << 56
        return bswap(w * 0x9e3779b97f4a7c15)
    return brine_hash_long(s + STR_DATA, n)

# The entry of key k (hash h) in map m, or -1. keq compares two keys of ksz
# bytes; `exact`: equal hashes are equal keys.
fn map_probe(m: ptr, k: ptr, h: u64, keq: ptr, ksz: int, exact: bool) -> int:
    if load_i64(m, MAP_LEN) == 0:
        return -1
    let mask = load_u64(m, MAP_NIDX) - 1
    let ix = load_ptr(m, MAP_INDEX)
    let hs = load_ptr(m, MAP_HASHES)
    var i = h & mask
    while true:
        let e = load_i64(ix, i * 8)
        if e == -1:
            return -1
        if e >= 0 and load_u64(hs, e * 8) == h:
            if exact or call_bool(keq, load_ptr(m, MAP_KEYS) + e * ksz, k):
                return e
        i = (i + 1) & mask
    return -1

# The value of entry e (from map_probe; -1 panics for the missing key k).
fn map_val(m: ptr, e: int, k: ptr, vsz: int, loc: ptr) -> ptr:
    if e < 0:
        return brine_map_at(m, k, loc)
    return load_ptr(m, MAP_VALS) + e * vsz

# Same, after making the map unique so the value can be changed.
fn map_val_mut(pm: ptr, e: int, k: ptr, vsz: int, loc: ptr) -> ptr:
    let m = load_ptr(pm, 0)
    if e >= 0 and load_i64(m, MAP_RC) == 1:
        return load_ptr(m, MAP_VALS) + e * vsz
    return brine_map_val_mut_slow(pm, e, k, loc)

# `var s = lit` run again: keeps s's block when nothing else holds it. A
# block always has room for 15 bytes, so a short literal is one word store.
fn str_reset(ps: ptr, lit: ptr):
    let a = load_ptr(ps, 0)
    let n = load_u64(lit, STR_LEN)
    if n < 8 and load_i64(a, STR_RC) == 1:
        store_u64(a, STR_DATA, load_u64(lit, STR_DATA) & lowmask(n))
        store_u64(a, STR_LEN, n)
        return
    brine_x_str_reset(ps, lit)

# `s[i]` (i in bounds): the byte as a one-character string, from the table
# of immortal ones (brine_bytes: brine_str1, 24 bytes each)
fn str_byte(s: ptr, i: int) -> ptr:
    return symbol("brine_bytes") + int(load_u8(s, STR_DATA + i)) * 24

fn str_at(s: ptr, i: int, loc: ptr) -> ptr:
    if u64(i) >= load_u64(s, STR_LEN):
        return brine_x_str_at(s, i, loc)
    return str_byte(s, i)

# `s += t`, in place when s is unshared, t is at most a word and the word
# written at s's end and the NUL after t fit in its room
# (the word's bytes past t are 0: the NUL when t is shorter).
fn str_add(ps: ptr, b: ptr):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    let lb = load_i64(b, STR_LEN)
    if lb <= 8 and load_i64(a, STR_RC) == 1 and la + 8 <= str_room(la):
        store_u64(a, STR_DATA + la, load_u64(b, STR_DATA) & lowmask(u64(lb)))
        if lb == 8:
            store_u8(a, STR_DATA + la + 8, 0)
        store_i64(a, STR_LEN, la + lb)
        return
    brine_x_str_add(ps, b)

# `s += t[i]`: one byte, in place when s is unshared and has room. Within
# the first word the whole word is rewritten, so a later word load forwards
# from one store.
fn str_add_byte(ps: ptr, c: u8):
    let a = load_ptr(ps, 0)
    let la = load_i64(a, STR_LEN)
    if la < 8 and load_i64(a, STR_RC) == 1:
        let sh = la * 8
        let w = load_u64(a, STR_DATA) & ~(ONES << sh)
        store_u64(a, STR_DATA, w | u64(c) << sh)
        if la == 7:
            store_u8(a, STR_DATA + 8, 0)
        store_i64(a, STR_LEN, la + 1)
        return
    brine_x_str_add_byte(ps, c)

# The appender (brine_app_open): the length and the first word in it, the
# bytes after those straight into s's block while it is unshared and has
# room. (Nothing is passed ap, so its fields can stay in registers.)
fn app_open(ps: ptr, ap: ptr):
    let a = load_ptr(ps, 0)
    let n = load_i64(a, STR_LEN)
    var room = -1
    if load_i64(a, STR_RC) == 1:
        room = str_room(n)
    store_ptr(ap, APP_DATA, a + STR_DATA)
    store_i64(ap, APP_LEN, n)
    store_i64(ap, APP_ROOM, room)
    store_i64(ap, APP_LIM, room if room < 8 else 8)
    store_u64(ap, APP_W0, load_u64(a, STR_DATA) & lowmask(load_u64(a, STR_LEN)))

fn app_byte(ps: ptr, ap: ptr, c: u8):
    let n = load_i64(ap, APP_LEN)
    if n < load_i64(ap, APP_LIM):
        store_u64(ap, APP_W0, load_u64(ap, APP_W0) | u64(c) << (n * 8))
        store_i64(ap, APP_LEN, n + 1)
        return
    if n > 8 and n < load_i64(ap, APP_ROOM):
        store_u8(load_ptr(ap, APP_DATA), n, c)
        store_i64(ap, APP_LEN, n + 1)
        return
    brine_x_app_byte(ps, ap, c)

fn app_close(ps: ptr, ap: ptr):
    let a = load_ptr(ps, 0)
    let n = load_i64(ap, APP_LEN)
    if load_i64(a, STR_LEN) == n:
        return
    store_i64(a, STR_LEN, n)
    # the bytes past n in w0 are 0: the NUL
    let d = load_ptr(ap, APP_DATA)
    if n <= 8:
        store_u64(d, 0, load_u64(ap, APP_W0))
    if n >= 8:
        store_u8(d, n, 0)

# This thread's heap (br_th_peek), at address 0 when there is none yet.
fn th_heap(hi: ptr) -> ptr:
    let at = thread_ptr() + load_i64(hi, HI_OFF)
    if load_i64(hi, HI_IND) != 0:
        return load_ptr(at, 0)
    return at

# The size class of a block of n bytes, 1 <= n <= 256 (br_class_of), and
# the size of its blocks.
fn size_class(n: int) -> int:
    if n <= 128:
        return ((n + 15) >> 4) - 1
    return ((n - 129) >> 5) + 8

fn class_size(c: int) -> int:
    if c < 8:
        return (c + 1) * 16
    return 128 + (c - 7) * 32

# A box from the thread's free list; C makes more when it is empty.
fn box_new(size: int, tag: int) -> ptr:
    let hi = symbol("brine_heap_info")
    if size > 0 and size <= SMALL and load_i64(hi, HI_FAST) != 0:
        let h = th_heap(hi)
        if addr(h) != 0:
            let c = size_class(size)
            let p = load_ptr(h, TH_HEAD + c * 8)
            if addr(p) != 0:
                store_ptr(h, TH_HEAD + c * 8, load_ptr(p, 0))
                let n = load_i64(h, TH_COUNT + c * 8)
                if n > 0:
                    store_i64(h, TH_COUNT + c * 8, n - 1)
                store_i64(p, 0, 1)
                store_i64(p, 8, tag)
                return p
    return brine_box_new(size, tag)

# A box back on the thread's free list, unless that holds enough already
# (C hands some over to other threads then).
fn box_free(p: ptr):
    let hi = symbol("brine_heap_info")
    let base = load_u64(hi, HI_BASE)
    let off = addr(p) - base
    if load_i64(hi, HI_FAST) != 0 and off < load_u64(hi, HI_END) - base:
        let h = th_heap(hi)
        if addr(h) != 0:
            let c = int(load_u8(load_ptr(hi, HI_CLASSES), off >> 16))
            let n = load_i64(h, TH_COUNT + c * 8) + 1
            if n * class_size(c) <= SPARE:
                store_ptr(p, 0, load_ptr(h, TH_HEAD + c * 8))
                store_ptr(h, TH_HEAD + c * 8, p)
                store_i64(h, TH_COUNT + c * 8, n)
                return
    brine_box_free(p)
