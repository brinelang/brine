# ------------------------------------------------------------ unicode
# Unicode 16.0.0 tables, from the Unicode Character Database (as Python's
# str.upper, str.lower, str.isalpha and str.isspace see it). A run is lo,
# hi, delta, step: it maps lo, lo+step, ..., hi by adding delta. A special
# maps one code point to several, given as UTF-8 bytes.

# fmt: off
const UPPER_RUNS: [i32] = [
    0x61, 0x7a, -32, 0x1, 0xb5, 0xb5, 0x2e7, 0x1,
    0xe0, 0xf6, -32, 0x1, 0xf8, 0xfe, -32, 0x1,
    0xff, 0xff, 0x79, 0x1, 0x101, 0x12f, -1, 0x2,
