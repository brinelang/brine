# The examples in the guide compile: every ```python block of
# docs/QUICKREF.md, wrapped in a `main` where they are statements.
#
#   brine test tests/docs.br            from the repository root
#
# (tests/integration.br runs it too.) Scratch files go to target/it/

fn brine_exe() -> str:
    match getenv("BRINE"):
        case Some(b):
            return b
        case None:
            return "brine"

# Runs brine; (exit code, stdout + stderr).
fn brine(args: [str]) -> (int, str):
    var cmd = [brine_exe()]
    cmd.extend(args)
    var h = 0
    match os.spawn(cmd, {"NO_COLOR": "1"}, true, false):
        case Ok(p):
            h = p
        case Err(msg):
            panic(f"cannot run brine: {msg}")
    let code = os.wait(h)
    let (o, e) = os.output(h)
    return (code, (o + e).replace("\r\n", "\n"))

fn scratch(name: str) -> str:
    let d = f"target/it/{name}-{os.pid()}"
    match os.make_dir(d):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    return d

fn write(path: str, s: str):
    match write_file(path, s):
        case Ok(_):
            pass
        case Err(e):
            panic(e)

# Lines that start an item at the top level of a file.
fn is_item(line: str) -> bool:
    for k in [
        "fn ",
        "struct ",
        "enum ",
        "const ",
        "import ",
        "from ",
        "extern ",
        "test ",
        "def ",
        "class "
    ]:
        if line.starts_with(k):
            return true
    return false

# A file made of an example: its items stay at the top level, everything else
# goes into a `main` (after `setup`), unless the example has its own `main`.
fn program(lines: [str], items: str, setup: [str]) -> str:
    var top = items
    var body = ""
    for s in setup:
        body += "    " + s + "\n"
    var item = false
    var has_main = false
    for l in lines:
        if l != "" and not l.starts_with(" "):
            item = is_item(l)
            if l.starts_with("fn main("):
                has_main = true
        if item:
            top += l + "\n"
        else:
            body += ("    " + l).rstrip() + "\n"
    if has_main:
        return top
    return top + "\nfn main() -> Result[(), str]:\n" + body + "    return Ok(())\n"

# A block of files, each after a `# name.br` line (RULES.br and the modules
# its rules name), written to `dir` with a main.br that imports the modules.
# Returns that main.br.
fn project(lines: [str], dir: str) -> str:
    match os.make_dir(dir):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    var files: {str: str} = {}
    var cur = ""
    for l in lines:
        if l.starts_with("# ") and l.ends_with(".br"):
            cur = l[2:]
            files[cur] = ""
        else:
            files[cur] = files.get(cur, "") + l + "\n"
    var main = ""
    for name in files:
        write(f"{dir}/{name}", files[name])
        if name != "RULES.br" and name.ends_with(".br"):
            main += "import " + name.replace(".br", "") + "\n"
    write(f"{dir}/main.br", main + "\nfn main():\n    pass\n")
    return f"{dir}/main.br"

# Every code a `--json` check reported, in order.
fn codes(out: str) -> [str]:
    var cs: [str] = []
    for line in out.lines():
        match line.find("\"code\":\""):
            case Some(i):
                let rest = line[i + 8:]
                match rest.find("\""):
                    case Some(j):
                        cs.push(rest[:j])
                    case None:
                        pass
            case None:
                pass
    return cs

# ---------------------------------------------------------------- the guide

# What a guide block uses without defining it, by the block's first line:
# (items, statements before it).
fn guide_setup(first: str) -> (str, [str]):
    if first.starts_with("let x = 10"):
        return (
            "",
            [
                "var u = 6",
                "var v = 4",
                "var xs = [1, 2]",
                "let i = 0",
                "let j = 1",
                "let bounds = (1, 2)",
                "var lo = 0"
            ]
        )
    if first.starts_with("if x < 0"):
        return (
            "",
            ["let x = 1", "let n = 3", "let xs = [1, 2]", "let pairs = [(\"a\", 1)]", "var j = 0"]
        )
    if first.starts_with("fn load("):
        return ("fn parse_bit(s: str) -> Result[int, str]:\n    return Ok(0)\n\n", [])
    if first.starts_with("match line.to_int()"):
        return ("", ["let line = \" 42 \"", "let bytes: [u8] = [104, 105]"])
    if first.starts_with("let ys = par"):
        return (
            "fn f(x: float) -> float:\n    return x\n\nfn ok(i: int) -> bool:\n    return i > 1\n\nfn work(k: int) -> int:\n    return k\n\n",
            ["let xs = [1.0, 2.0]", "let n = 2"]
        )
    if first.starts_with("par for i in 0..n:"):
        return ("", ["var a = [0.0] * 9", "let n = 4"])
    if first.starts_with("test \"clamp"):
        return (
            "fn clamp(x: int, lo: int, hi: int) -> int:\n    return min(max(x, lo), hi)\n\n",
            []
        )
    return ("", [])

# Blocks that need files of their own (a RULES.br and the modules it names), and
# the `os` module's list of signatures.
fn guide_skip(first: str) -> bool:
    return (
        first.starts_with("# RULES.br")
        or first.starts_with("import geometry")
        or first.starts_with("os.list_dir(")
    )

test "every example in the guide compiles":
    let d = scratch("guide")
    var guide = ""
    match read_file("docs/QUICKREF.md"):
        case Ok(t):
            guide = t.replace("\r\n", "\n")
        case Err(e):
            panic(e)
    var block: [str] = []
    var inside = false
    var n = 0
    var tried = 0
    for line in guide.lines():
        if not inside:
            if line == "```python":
                inside = true
                block = []
            continue
        if line != "```":
            block.push(line)
            continue
        inside = false
        n += 1
        if len(block) == 0 or guide_skip(block[0]):
            continue
        let (items, setup) = guide_setup(block[0])
        let f = f"{d}/block{n}.br"
        write(f, program(block, items, setup))
        let (code, out) = brine(["check", f])
        assert code == 0, f"the guide's block {n} (`{block[0].strip()}`) doesn't compile:\n{out}"
        tried += 1
    assert tried >= 20, f"only {tried} guide blocks found"
