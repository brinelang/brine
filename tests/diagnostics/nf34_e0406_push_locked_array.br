# mistake: pushes onto an invariant-read array from outside (only grows it)
# expect: E0406 or accepted; either way say why
struct Buf:
    n: int
    data: [u8]
    name: str
    invariant self.n <= len(self.data)

fn main():
    var b = Buf(n=1, data=[0], name="a")
    b.data.push(9)
    print(len(b.data))
