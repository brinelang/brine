# mistake: writes an invariant field through an outer struct
# expect: E0406 at w.buf.n
struct Buf:
    n: int
    data: [u8]
    name: str
    invariant self.n <= len(self.data)

struct Wrap:
    buf: Buf
    tag: int

fn main():
    var w = Wrap(buf=Buf(n=0, data=[0], name="a"), tag=1)
    w.tag = 2
    w.buf.n = 5
    print(w.buf.n)
