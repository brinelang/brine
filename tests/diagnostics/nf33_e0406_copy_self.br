# mistake: changes a copy of self inside a method
# expect: E0406 (copy): change self or build a whole value
struct Buf:
    n: int
    data: [u8]
    name: str
    invariant self.n <= len(self.data)

    fn grow(ref self):
        var s = self
        s.n = 0
        self = s

fn main():
    var b = Buf(n=0, data=[0], name="a")
    b.grow()
    print(b.n)
