# mistake: rebuilds the whole value breaking the invariant
# expect: E0609-style: the invariant fails where the value is built
struct Buf:
    n: int
    data: [u8]
    name: str
    invariant self.n <= len(self.data)

fn main():
    var b = Buf(n=0, data=[0], name="a")
    b = Buf(n=5, data=b.data, name=b.name)
    print(b.n)
