test "language features":
    for f in features():
        run_ok(f, expected(f), [])

# Dev builds are native where there is a native backend: the C backend gets
# the same programs.
test "language features through C":
    for f in features():
        run_with(f, expected(f), [], {"BRINE_BACKEND": "c"})
    run_with(
        "examples/parallel.br",
        "average steps: 131.43, longest: 524\n[0.0, 1.0, 1.4142135623730951, 1.7320508075688772, 2.0, 2.23606797749979, 2.449489742783178, 2.6457513110645907]\n111 118\n",
        [],
        {"BRINE_BACKEND": "c"}
    )

# Release builds go through C with more optimizations, and on x86-64 carry
# the program for three CPU levels: each must print the same.
# (native on x86-64 Windows and Linux: the SSA optimizations, ssa.br)
# BRINE_VERIFY_IR checks the IR before (and after) those (irverify.br).
test "language features in release builds":
    for f in features():
        run_with(f, expected(f), ["--release"], {"BRINE_VERIFY_IR": "1"})

# and at each CPU level the C build has
test "language features in release builds through C":
    for f in features():
        run_with(f, expected(f), ["--release"], {"BRINE_BACKEND": "c", "BRINE_VERIFY_IR": "1"})
        if os.arch() == "x86_64":
            for level in ["base", "v3"]:
                run_with(f, expected(f), ["--release"], {"BRINE_BACKEND": "c", "BRINE_CPU": level})

# Debug builds compile without optimizations (each value in its stack slot,
# for the debugger), so they get the programs too.
test "language features in debug builds":
    for f in features():
        run_ok(f, expected(f), ["--debug"])

fn gdb_ok(args: [str]) -> bool:
    var cmd = ["gdb", "-nx", "-batch"]
    cmd.extend(args)
    match os.spawn(cmd, {}, true, false):
        case Ok(p):
            return os.wait(p) == 0
        case Err(_):
            return false

# A debug build under gdb: brine files, lines, function names and values.
# Passes without checking anything where gdb isn't installed.
test "gdb debugs brine source":
    if not gdb_ok(["--version"]):
        return
    let d = scratch("gdb")
    let x = exe(d + "/debuggee")
    let b = brine(["build", "--debug", "tests/programs/debuggee.br", "-q", "-o", x])
    assert b.code == 0, b.all()
    # the pretty-printers need a gdb built with Python
    let py = gdb_ok(["-ex", "python import gdb"])
    var cmd = ["gdb", "-nx", "-batch"]
    if py:
        cmd.extend(["-x", "runtime/brine_gdb.py"])
    for c in [
        "break debuggee.br:15",
        "run",
        "bt",
        "info locals",
        "print name",
        "step",
        "bt",
        "next",
        "info locals",
        "finish",
        "next"
    ]:
        cmd.extend(["-ex", c])
    cmd.push(x)
    let o = exec(cmd, {})
    # elsewhere debug builds go through C: gdb sees the C names and values, so
    # only the brine lines are checked
    let native = os.name() == "linux" and (os.arch() == "x86_64" or os.arch() == "aarch64")
    if not (native or (os.name() == "windows" and os.arch() == "x86_64")):
        for w in ["debuggee.br, line 15.", "debuggee.br:15\n15\t    let a = area(p)\n"]:
            assert w in o.out, f"gdb's output lacks {w}:\n{o.all()}"
        return
    var want = [
        "debuggee.br, line 15.",
        "#0  main () at ",
        "debuggee.br:15\n15\t    let a = area(p)\n",
        "p = {x = 3, y = 4}",
        "area (p=...) at ",
        "debuggee.br:7\n7\t    let a = p.x * p.y\n",
        "#1  0x",
        "\n8\t    return a\na = 12\n",
        "Value returned is $2 = 12",
        "\n16\t    print("
    ]
    if py:
        want.extend(["name = \"brine\"", "xs = [1, 2, 3]", "o = Some(7)", "$1 = \"brine\""])
    for w in want:
        assert w in o.out, f"gdb's output lacks {w}:\n{o.all()}"

# `brine debug` breaks at `panic_stop`: a panic stops there once it is printed,
# with the frames that led to it still on the stack.
test "gdb stops at a panic":
    if not gdb_ok(["--version"]):
        return
    let d = scratch("gdb-panic")
    let x = exe(d + "/chain")
    let b = brine(["build", "--debug", "tests/programs/panic_chain.br", "-q", "-o", x])
    assert b.code == 0, b.all()
    let o = exec(
        [
            "gdb",
            "-nx",
            "-batch",
            "-ex",
            "break panic_stop",
            "-ex",
            "run",
            "-ex",
            "bt",
            "--args",
            x,
            "seq"
        ],
        {}
    )
    assert "panic: index 2 is out of bounds" in o.all(), o.all()
    assert "Breakpoint 1, " in o.out and "panic_stop" in o.out, o.all()

# The same under lldb on macOS, where the debug info stays in the
# executable's __DWARF segment.
test "lldb debugs brine source":
    if os.name() != "macos":
        return
    let d = scratch("lldb")
    let x = exe(d + "/debuggee")
    let b = brine(["build", "--debug", "tests/programs/debuggee.br", "-q", "-o", x])
    assert b.code == 0, b.all()
    var cmd = ["lldb", "-b"]
    for c in [
        "breakpoint set -f debuggee.br -l 15",
        "run",
        "frame variable",
        "step",
        "bt",
        "next",
        "frame variable",
        "finish"
    ]:
        cmd.extend(["-o", c])
    cmd.push(x)
    let o = exec(cmd, {})
    for w in [
        "at debuggee.br:15",
        "(P) p = (x = 3, y = 4)",
        "tag = Some",
        "area(p=(x = 3, y = 4)) at debuggee.br:7",
        "main at debuggee.br:15",
        "(long) a = 12",
        "Return value: (long) $0 = 12"
    ]:
        assert w in o.out, f"lldb's output lacks {w}:\n{o.all()}"

test "imports and generics":
    run_ok("tests/programs/imports", expected("tests/programs/imports"), [])
    assert error_codes("tests/programs/imports/bad.br") == ["E0201@1", "E0202@1"]
    run_ok(
        "tests/programs/imports/shapes/up.br",
        expected("tests/programs/imports/shapes/up.br"),
        []
    )
    let missing = brine(["check", "tests/programs/imports/shapes/missing.br"])
    assert "E0701" in missing.err and "import ..util" in missing.err, missing.all()
    run_ok("tests/programs/generics", expected("tests/programs/generics"), [])
    run_ok("tests/programs/reexport", expected("tests/programs/reexport"), [])
    assert error_codes("tests/programs/reexport/bad.br") == ["E0201@2"]

test "parallel results don't depend on the thread count":
    var runs: [str] = []
    for t in ["1", "3", "8"]:
        let o = brine(["run", "tests/programs/parallel_det.br", "-q", "--threads", t])
        assert o.code == 0, o.err
        runs.push(o.out)
        for f in [
            "tests/programs/reductions.br",
            "tests/programs/par_small.br",
            "tests/programs/first.br"
        ]:
            let r = brine(["run", f, "-q", "--threads", t])
            assert r.out == expected(f), r.all()
    assert runs[0] == runs[1] and runs[0] == runs[2]

# GPU offload (brine_rt.c, "GPU"). BRINE_GPU=on runs every construct that can
# run on a GPU there; without a usable GPU everything runs on the CPU, so the
# output checks still apply and only the GPU-only ones are skipped.
fn gpu_ready(err: str) -> bool:
    return "brine gpu: " in err and " ready in " in err

fn without_gpu_log(err: str) -> str:
    var out = ""
    for l in err.lines():
        if not l.starts_with("brine gpu: "):
            out += l + "\n"
    return out

test "par constructs give the same results on a GPU":
    let f = "tests/programs/gpu.br"
    for backend in ["native", "c"]:
        let o = brine_env(
            ["run", f, "-q"],
            {"BRINE_GPU": "on", "BRINE_GPU_LOG": "1", "BRINE_BACKEND": backend}
        )
        assert o.code == 0, o.all()
        assert o.out == expected(f), f"{backend}: unexpected output on the GPU:\n{o.out}"
        # what can run on a GPU is decided when compiling: the same with or without one
        # (Apple GPUs, through Metal, have no f64)
        let metal = os.name() == "macos"
        var cpu: [str] = []
        var gpu = 0
        let mine = "brine gpu: tests/programs/gpu.br:"
        for l in o.err.lines():
            # the compiler's own constructs are not logged
            assert not l.starts_with("brine gpu: compiler/"), o.err
            if not l.starts_with(mine):
                continue
            if "not GPU-eligible" in l:
                if not (metal and "uses f64" in l):
                    cpu.push(l[len(mine):].split(":")[0])
            elif " -> gpu " in l:
                gpu += 1
        assert cpu == (["109", "113", "135"] if metal else ["109", "111", "113", "135"]), o.err
        # and says why
        for why in ["its results are strings", "it reads `m`, a map", "its results are arrays"]:
            # (the log may add "; deciding took ..." before the parenthesis closes)
            assert f"(not GPU-eligible: {why}" in o.err, o.err
        if gpu_ready(o.err):
            assert gpu == (27 if metal else 59), o.err

test "128-bit integers give the same results on a GPU":
    let f = "tests/programs/gpu_u128.br"
    for backend in ["native", "c"]:
        let o = brine_env(
            ["run", f, "-q"],
            {"BRINE_GPU": "on", "BRINE_GPU_LOG": "1", "BRINE_BACKEND": backend}
        )
        assert o.code == 0, o.all()
        assert o.out == expected(f), f"{backend}: unexpected output on the GPU:\n{o.out}"
        # everything but the reduction can run on a GPU (on Apple's, nothing)
        let metal = os.name() == "macos"
        let why = "uses 128-bit integers" if metal else "reduces 128-bit integers"
        assert f"(not GPU-eligible: {why}" in o.err, o.err
        if gpu_ready(o.err) and not metal:
            assert o.err.count(" -> gpu ") == 25, o.err

test "a check that fails on a GPU panics as on the CPU":
    let f = "tests/programs/gpu_panic.br"
    for which, msg in [
        ("index", "index 100000 is out of bounds for an array of length 100000"),
        ("assert", "assertion failed: x != 77_777"),
        ("div", "division by zero"),
        ("overflow", "integer overflow in multiplication"),
        ("combine", "integer overflow in addition"),
        ("convert", "float to integer conversion out of range (or NaN) for i32"),
        ("shift", "shift amount out of range"),
        ("mul128", "integer overflow in multiplication"),
        ("smul128", "integer overflow in multiplication"),
        ("div128", "division by zero"),
        ("convert128", "integer conversion out of range for u64")
    ]:
        let off = brine_env(["run", f, "-q", "--", which], {"BRINE_GPU": "off"})
        let on = brine_env(["run", f, "-q", "--", which], {"BRINE_GPU": "on", "BRINE_GPU_LOG": "1"})
        assert off.code == 101 and msg in off.err, f"{which}: {off.all()}"
        assert on.code == 101 and without_gpu_log(on.err) == off.err, f"{which}: {on.all()}"
        if gpu_ready(on.err):
            assert "a check failed on the GPU, running it on the CPU" in on.err, on.err

test "GPU auto doesn't copy arrays of arrays that cost more than the work":
    # planning the copies visits every inner array: auto mode gives up on it
    # once it costs more than the CPU needs, and says so (v09#21)
    let f = "tests/programs/gpu_nested.br"
    for backend in ["native", "c"]:
        let o = brine_env(["run", f, "-q"], {"BRINE_GPU_LOG": "1", "BRINE_BACKEND": backend})
        assert o.code == 0 and o.out == expected(f), o.all()
        let lines = [
            l for l in o.err.lines() if l.starts_with("brine gpu: tests/programs/gpu_nested.br:")
        ]
        assert len(lines) == 4, o.err
        let why = "copying its arrays of arrays to the GPU takes longer than running it on the CPU"
        assert why in lines[3], o.err

test "ranks take one GPU each":
    # with BRINE_GPU=auto, a second rank on a one-GPU machine stays on the CPU
    let f = "tests/programs/gpu_ranks.br"
    let off = brine_env(["run", "--ranks", "2", f, "-q"], {"BRINE_GPU": "off"})
    let o = brine_env(["run", "--ranks", "2", f, "-q"], {"BRINE_GPU_LOG": "1"})
    assert off.code == 0 and o.code == 0 and o.out == off.out, o.all()
    if gpu_ready(o.err):
        assert "brine gpu: rank 0: " in o.err, o.err
        let shared = "brine gpu: rank 1: not used: 1 lower rank on this machine uses its 1 GPU"
        assert shared in o.err or o.err.count(" ready in ") == 2, o.err

test "panics are clear":
    for f, msg in [
        ("tests/programs/panic_assert.br", "x was 5"),
        ("tests/programs/panic_index.br", "index 7 is out of bounds"),
        ("tests/programs/panic_assert_check.br", "index 7 is out of bounds"),
        ("tests/programs/panic_overflow.br", "overflow"),
        ("tests/programs/panic_overflow128.br", "overflow in addition"),
        ("tests/programs/panic_slice.br", "slice [1:8] is out of bounds"),
        (
            "tests/programs/panic_str_split.br",
            "slice [0:2] splits the character \"é\" (bytes 1..3)"
        ),
        ("tests/programs/panic_str_byte.br", "index 3 is out of bounds"),
        ("tests/programs/panic_par.br", "out of bounds for an array of length 3"),
        ("tests/programs/panic_unwrap.br", "unwrap() called on Err: not a number: x"),
        (
            "tests/programs/panic_oom.br",
            "out of memory: could not allocate 9007199254740992 bytes (8192 TiB)"
        )
    ]:
        let o = brine(["run", f, "-q"])
        assert o.code == 101, f"{f}: exit {o.code}\n{o.err}"
        assert msg in o.err, f"{f}: expected `{msg}` in:\n{o.err}"
        assert f"--> {f}:" in o.err, f"{f}: no location in:\n{o.err}"
        # one report, even when many threads fail at once
        assert o.err.count("panic:") == 1, f"{f}: more than one panic in:\n{o.err}"
    # `s += t[i]` appends the byte without making a string of it (here through
    # the loop's appender), but panics where `t[i]` would, in every kind of build
    for extra in [["-q"], ["-q", "--release"], ["-q", "--debug"]]:
        var args = ["run", "tests/programs/panic_str_byte.br"]
        args.extend(extra)
        let o = brine(args)
        assert o.code == 101, f"{extra}: exit {o.code}\n{o.err}"
        assert "--> tests/programs/panic_str_byte.br:5:14" in o.err, f"{extra}: wrong location in:\n{o.err}"
    # unproven conversions and shifts are a compare and a branch in release
    # code, with the call that panics out of line
    for f, msg in [
        ("tests/programs/panic_convert.br", "integer conversion out of range for u8"),
        ("tests/programs/panic_shift.br", "shift amount out of range")
    ]:
        for extra in [["-q"], ["-q", "--release"]]:
            var args = ["run", f]
            args.extend(extra)
            let o = brine(args)
            assert o.code == 101, f"{f} {extra}: exit {o.code}\n{o.err}"
            assert (
                msg in o.err and f"--> {f}:2:12" in o.err
            ), f"{f} {extra}: wrong panic in:\n{o.err}"
    # the C runtime says the same about memory
    let c = brine_env(["run", "tests/programs/panic_oom.br", "-q"], {"BRINE_BACKEND": "c"})
    assert c.code == 101 and "out of memory: could not allocate" in c.err, c.all()
    assert "--> tests/programs/panic_oom.br:4:14" in c.err, c.err

test "a panic names the functions it came through":
    # (x86-64 code only: AArch64 and the C backend print the location alone)
    if os.arch() == "x86_64" and os.name() != "macos":
        let f = "tests/programs/panic_chain.br"
        let chain = (
            "  --> tests/programs/panic_chain.br:9:12\n"
            + "  in at (tests/programs/panic_chain.br:7)\n"
            + "  called from fib (tests/programs/panic_chain.br:2)\n"
            + "  called from fib (tests/programs/panic_chain.br:2), 2 more times\n"
            + "  called from main (tests/programs/panic_chain.br:11)\n"
        )
        # a `par` body ends the chain: the thread that ran it varies
        let in_par = (
            "  in at (tests/programs/panic_chain.br:7)\n"
            + "  called from a `par` body in main (tests/programs/panic_chain.br:11)\n"
        )
        for mode in ["-q", "--release"]:
            let o = brine(["run", f, mode, "-q", "--", "seq"])
            assert o.code == 101 and o.err.ends_with(chain), f"{mode}: {o.all()}"
            let p = brine(["run", f, mode, "-q", "--", "par"])
            assert p.code == 101 and p.err.ends_with(in_par), f"{mode}: {p.all()}"
        # a stack overflow names the function that overflowed
        let s = brine(["run", "tests/programs/panic_stack.br", "-q", "--", "100000000"])
        let deep = "  in depth (tests/programs/panic_stack.br:3)\n  called from depth (tests/programs/panic_stack.br:3), "
        assert s.code == 101 and deep in s.err, s.all()
        assert s.err.ends_with(
            " more times\n  called from main (tests/programs/panic_stack.br:8)\n"
        ), s.all()

test "brine run --json reports a panic like a build error":
    let f = "tests/programs/panic_chain.br"
    for backend in ["native", "c"]:
        let o = brine_env(["run", "--json", f, "-q", "--", "seq"], {"BRINE_BACKEND": backend})
        assert o.code == 101, o.all()
        let ls = [l for l in o.out.lines() if l.starts_with("{")]
        assert len(ls) == 1, o.all()
        let j = ls[0]
        assert j.starts_with(
            "{\"severity\":\"error\",\"code\":null,\"message\":\"index 2 is out of bounds for an array of length 2\",\"file\":\"tests/programs/panic_chain.br\",\"line\":9,\"column\":12,"
        ), j
        if backend == "native" and os.arch() == "x86_64" and os.name() != "macos":
            assert "\"notes\":[\"in at (tests/programs/panic_chain.br:7)\"," in j, j
        # the human-readable report is still on stderr
        assert "panic: index 2 is out of bounds" in o.err, o.all()
    # the same fields as a build error, in the same order
    let d = scratch("panic-json")
    write(f"{d}/bad.br", "fn main():\n    let x: int = \"a\"\n")
    let b = brine(["build", "--json", f"{d}/bad.br", "-q"])
    let e = [l for l in b.out.lines() if l.starts_with("{")][0]
    let keys = [
        "\"severity\":",
        "\"code\":",
        "\"message\":",
        "\"file\":",
        "\"line\":",
        "\"column\":",
        "\"end_line\":",
        "\"end_column\":",
        "\"label\":",
        "\"related\":",
        "\"notes\":",
        "\"help\":",
        "\"fixes\":"
    ]
    let p = brine(["run", "--json", f, "-q", "--", "seq"])
    let j = [l for l in p.out.lines() if l.starts_with("{")][0]
    for line in [e, j]:
        var at = 0
        for k in keys:
            match line.find(k, at):
                case Some(i):
                    at = i
                case None:
                    assert false, f"no {k} after byte {at} in {line}"

test "an overflow shows its operands and a failed conversion its value":
    let f = "tests/programs/panic_values.br"
    let cases = [
        ("add", "integer overflow in addition: 9223372036854775807 + 1"),
        ("sub", "integer overflow in subtraction: -2147483647 - 2"),
        ("mul", "integer overflow in multiplication: 4294967296 * 4294967296"),
        ("small", "integer overflow in addition: 100 + 28"),
        ("conv", "integer conversion out of range for u8: 300"),
        ("neg", "integer conversion out of range for u64: -8"),
        ("float", "float to integer conversion out of range (or NaN) for i32: 15000000000.0"),
        ("wide", "integer conversion out of range for i64: 1267650600228229401496703205377")
    ]
    # AArch64 code still reports an overflow without its operands
    let native = os.arch() == "x86_64"
    for backend in ["native", "c"]:
        for mode in ["-q", "--release"]:
            for which, msg in cases:
                let o = brine_env(["run", f, mode, "-q", "--", which], {"BRINE_BACKEND": backend})
                assert o.code == 101, f"{backend} {mode} {which}: {o.all()}"
                let ovf = msg.starts_with("integer overflow")
                if backend == "c" or native or not ovf:
                    assert f"panic: {msg}\n" in o.err, f"{backend} {mode} {which}: {o.all()}"

test "a stack overflow is a panic":
    let f = "tests/programs/panic_stack.br"
    # deeper than an OS's first thread allows (1 MB on Windows): `main` has
    # the stack of a `par` thread
    let modes: [[str]] = [[], ["par"]]
    for extra in modes:
        var args = ["run", f, "-q", "--", "100000"]
        args.extend(extra)
        let o = brine(args)
        assert o.code == 0 and o.out == "before\n100000\n", f"{extra}: {o.all()}"
        var deep = ["run", f, "-q", "--", "100000000"]
        deep.extend(extra)
        let p = brine(deep)
        assert (
            p.code == 101 and "panic: stack overflow (recursion too deep)" in p.err
        ), f"{extra}: {p.all()}"
        # what was printed before is still there
        assert p.out == "before\n", f"{extra}: {p.all()}"

test "a program knows how many threads par uses":
    let f = "tests/programs/thread_count.br"
    let e = brine_env(["run", f, "-q"], {"BRINE_THREADS": "3"})
    assert e.code == 0 and e.out == "3 3 true\n", e.all()
    let o = brine(["run", f, "-q", "--threads", "2"])
    assert o.code == 0 and o.out == "2 2 true\n", o.all()

test "stdout to a pipe is written line by line, and flush() writes the rest":
    let d = scratch("flush")
    let x = exe(d + "/flush")
    let b = brine(["build", "tests/programs/flush.br", "-q", "-o", x])
    assert b.code == 0, b.all()
    let marker = d + "/printed"
    var h = 0
    match os.spawn([x, marker], {}, true, false):
        case Ok(p):
            h = p
        case Err(e):
            panic(e)
    var waited = 0
    while not file_exists(marker) and waited < 1200:
        os.sleep(0.05)
        waited += 1
    # killed: nothing at exit writes out a buffer
    os.kill(h)
    os.wait(h)
    let (o, _) = os.output(h)
    assert o == "ready\npartial", f"got {o}"

# ------------------------------------------------------------ WebAssembly

# `--target wasm` needs wasi-sdk (and Node.js to run): without them these
# tests pass without checking anything, unless $BRINE_TEST_WASM is set (CI).
fn wasm_ready() -> bool:
    let must = getenv("BRINE_TEST_WASM").is_some()
    var node = false
    match os.spawn(["node", "--version"], {}, true, false):
        case Ok(p):
            node = os.wait(p) == 0
        case Err(_):
            pass
    assert node or not must, "BRINE_TEST_WASM is set but node doesn't run"
    if not node:
        return false
    let d = scratch("wasm-probe")
    let o = brine(["build", "--target", "wasm", "examples/hello.br", "-q", "-o", d + "/hello.wasm"])
    if "E0702" in o.all() and not must:
        return false
    assert o.code == 0, o.all()
    return true

# The same programs, compiled to WebAssembly and run by Node.js's WASI. Not
# strings.br and os.br: they use files and processes outside the sandbox.
test "WebAssembly programs give the same results":
    if not wasm_ready():
        return
    let wasm = ["--target", "wasm"]
    for f in features():
        if f != "tests/programs/strings.br" and f != "tests/programs/os.br":
            run_ok(f, expected(f), wasm)
    run_ok(
        "examples/parallel.br",
        "average steps: 131.43, longest: 524\n[0.0, 1.0, 1.4142135623730951, 1.7320508075688772, 2.0, 2.23606797749979, 2.449489742783178, 2.6457513110645907]\n111 118\n",
        wasm
    )
    # one thread, and the same answer as any number of threads
    let det = brine(["run", "tests/programs/parallel_det.br", "-q"])
    run_ok("tests/programs/parallel_det.br", det.out, wasm)
    run_ok(
        "examples/shapes",
        "Point(x=3.0, y=4.0) 5.0\n[6.0, 2.25] 8.25\nbig circle 3.14159\nShape.Square(side=2.0) 4.0\ndot\n",
        wasm
    )
    # deep recursion: Node's main thread would trap after ~10k frames
    let d = scratch("wasm-deep")
    write(
        d + "/deep.br",
        "fn depth(n: int) -> int:\n    if n == 0:\n        return 0\n    return 1 + depth(n - 1)\n\nfn main():\n    print(depth(200_000))\n"
    )
    run_ok(d + "/deep.br", "200000\n", wasm)
    # os.list_dir, of more names than one fd_readdir call returns: Node's WASI
    # has no fd_readdir on Windows, so brine_wasi.mjs makes one
    let ld = scratch("wasm-list")
    for i in 0..150:
        write(f"{ld}/a_file_with_a_rather_long_name_{i}.txt", "")
    write(
        ld + "/ls.br",
        f"fn main():\n    let n = os.list_dir(\"{ld}\").unwrap()\n    print(len(n), n[0], n[150])\n    print(os.list_dir(\"{ld}/ls.br\").is_err())\n"
    )
    run_ok(ld + "/ls.br", "151 a_file_with_a_rather_long_name_0.txt ls.br\ntrue\n", wasm)
    let p = brine(["run", "--target", "wasm", "tests/programs/panic_index.br", "-q"])
    assert p.code == 101 and "index 7 is out of bounds" in p.err, p.all()
    # the engine's stack runs out: a panic, and the output before it is kept
    let s = brine(
        ["run", "--target", "wasm", "tests/programs/panic_stack.br", "-q", "--", "10000000"]
    )
    assert s.code == 101 and s.out == "before\n" and "panic: stack overflow" in s.err, s.all()
    let t = brine(["test", "--target", "wasm", "examples/contracts.br"])
    assert t.code == 0 and "2 passed; 0 failed" in t.all(), t.all()
    # a runner that fails is an error, not zero tests
    let bad = brine_env(
        ["test", "--target", "wasm", "examples/contracts.br"],
        {"BRINE_WASM_RUNNER": "node --eval process.exit(7) --"}
    )
    assert bad.code != 0 and "could not list the tests" in bad.err, bad.all()
    let r = brine(["run", "--target", "wasm", "examples/world.br", "-q", "--ranks", "2"])
    assert r.code != 0 and "WebAssembly programs run as one rank" in r.err, r.all()

# A web build is a folder a browser opens; its loader also runs in Node.js.
test "web builds run through their loader":
    if not wasm_ready():
        return
    let d = scratch("web")
    let b = brine(["build", "--target", "web", "examples/hello.br", "-q", "-o", d + "/site"])
    assert b.code == 0, b.all()
    for f in ["index.html", "brine.js", "program.wasm"]:
        assert file_exists(d + "/site/" + f), f"missing {f}"
    assert len(os.list_dir(d + "/site").unwrap_or([])) == 3, "extra files in the web folder"
    write(
        d + "/load.mjs",
        "import { readFileSync } from 'node:fs';\n"
        + "import { pathToFileURL } from 'node:url';\n"
        + "const dir = process.argv[2];\n"
        + "const { run } = await import(pathToFileURL(dir + '/brine.js').href);\n"
        + "let out = '';\n"
        + "const code = await run(readFileSync(dir + '/program.wasm'), { stdout: (t) => (out += t), stderr: (t) => (out += t) });\n"
        + "process.stdout.write(out + 'exit ' + code + '\\n');\n"
        + "const mod = new WebAssembly.Module(readFileSync(dir + '/program.wasm'));\n"
        + "console.log('debug sections', WebAssembly.Module.customSections(mod, '.debug_info').length);\n"
    )
    let o = exec(["node", d + "/load.mjs", d + "/site"], {})
    # the C library's debug info is left out of builds without --debug
    assert o.code == 0 and o.out == "Hello, world!\nexit 0\ndebug sections 0\n", o.all()
    # `runInWorker` (what the page uses) runs it in a Web Worker: Node.js has
    # none, so a stand-in made of a worker thread
    let shim = [
        "import { parentPort, workerData } from 'node:worker_threads';",
        "globalThis.WorkerGlobalScope = class {};",
        "globalThis.postMessage = (m) => parentPort.postMessage(m);",
        "globalThis.addEventListener = (type, f) => parentPort.once('message', (data) => f({ data }));",
        "await import(workerData);"
    ]
    write(d + "/shim.mjs", "\n".join(shim) + "\n")
    let main = [
        "import { Worker } from 'node:worker_threads';",
        "import { readFileSync } from 'node:fs';",
        "import { pathToFileURL } from 'node:url';",
        "const dir = process.argv[2];",
        "globalThis.Worker = class {",
        "  constructor(url) {",
        "    this.w = new Worker(new URL('./shim.mjs', import.meta.url), { workerData: url.href });",
        "    this.w.on('message', (data) => this.onmessage({ data }));",
        "  }",
        "  postMessage(m) { this.w.postMessage(m); }",
        "  terminate() { this.w.terminate(); }",
        "};",
        "const { runInWorker } = await import(pathToFileURL(dir + '/brine.js').href);",
        "let out = '';",
        "const mod = new WebAssembly.Module(readFileSync(dir + '/program.wasm'));",
        "const code = await runInWorker(mod, { stdout: (t) => (out += t), stderr: (t) => (out += t) });",
        "console.log(out + 'exit ' + code);"
    ]
    write(d + "/worker.mjs", "\n".join(main) + "\n")
    let w = exec(["node", d + "/worker.mjs", d + "/site"], {})
    assert w.code == 0 and w.out == "Hello, world!\nexit 0\n", w.all()

test "a source file that isn't UTF-8 is reported once":
    let d = scratch("utf8")
    let f = d + "/latin1.br"
    let bytes: [u8] = [112, 114, 105, 110, 116, 40, 34, 233, 34, 41, 10]
    match os.write_bytes(f, bytes):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    let o = brine(["check", f])
    assert o.code != 0, o.all()
    assert f"cannot read {f}: the file is not valid UTF-8 text" in o.err, o.err
    assert o.err.count("cannot read") == 1, o.err

# v09#8: Notepad's "UTF-8 with BOM"
test "a byte order mark is skipped, and fmt removes it":
    let d = scratch("bom")
    let f = d + "/bom.br"
    write(f, "\u{FEFF}fn main():\n    print(\"hi\")\n")
    let o = brine(["run", f, "-q"])
    assert o.code == 0 and o.out == "hi\n", o.all()
    let c = brine(["fmt", "--check", f])
    assert c.code == 1 and "would reformat" in c.out, c.all()
    assert brine(["fmt", f]).code == 0
    assert text(f) == "fn main():\n    print(\"hi\")\n"
    assert brine(["fmt", "--check", f]).code == 0
    # anywhere else, it and other characters that can't be seen are named
    write(f, "fn main():\n    let x = 1\u{200B}\n    print(x)\u{FEFF}\n")
    let e = brine(["check", f])
    assert "unexpected character U+200B (zero-width space)" in e.err, e.err
    assert "unexpected character U+FEFF (byte order mark)" in e.err, e.err
    write(f, "fn main():\n    print(\u{201C}hi\u{201D})\n")
    let q = brine(["check", f])
    assert "`\u{201C}` (U+201C left double quotation mark)" in q.err, q.err
    assert "write `\"` instead" in q.err, q.err

# v09#9: what `brine check` accepts, `brine run` starts
test "check rejects what run would":
    let d = scratch("check-main")
    write(d + "/argv.br", "fn main(argv: [str]):\n    print(len(argv))\n")
    let o = brine(["check", d + "/argv.br"])
    assert o.code == 1 and "E0706" in o.err, o.all()
    # a lone file without `main` is a module: checked, and said so
    write(d + "/lib.br", "fn twice(x: int) -> int:\n    return x * 2\n")
    let l = brine(["check", d + "/lib.br"])
    assert l.code == 0 and "has no `main`" in l.err, l.all()
    let lj = brine(["check", d + "/lib.br", "--json"])
    assert lj.code == 0 and "\"has_main\":false" in lj.out, lj.all()
    # a project needs one, and its files nothing imports are checked too
    let p = d + "/proj"
    assert os.make_dir(p + "/src/sub").is_ok()
    write(p + "/brine.toml", "[package]\nname = \"proj\"\nversion = \"0.1.0\"\n")
    write(p + "/src/main.br", "fn helper() -> int:\n    return 1\n")
    let e = brine(["check", p])
    assert e.code == 1 and "E0703" in e.err, e.all()
    write(p + "/src/main.br", "fn main():\n    print(1)\n")
    write(p + "/src/sub/util.br", "fn broken() -> int:\n    return \"not an int\"\n")
    let u = brine(["check", p])
    assert u.code == 1 and "E0301" in u.err and "util.br" in u.err, u.all()
    write(p + "/src/sub/util.br", "fn fine() -> int:\n    return 2\n")
    let ok = brine(["check", p])
    assert ok.code == 0 and "proj (2 files)" in ok.err, ok.all()

test "main can return a Result":
    let d = scratch("main")
    write(
        d + "/ok.br",
        "fn main() -> Result[(), str]:\n    print(int(\"2\") + 1)\n    return Ok(())\n"
    )
    let o = brine(["run", d + "/ok.br", "-q"])
    assert o.code == 0 and o.out == "3\n", o.all()
    write(
        d + "/bad.br",
        "fn main() -> Result[(), str]:\n    let t = read_file(\"no/such/file.txt\")?\n    print(t)\n    return Ok(())\n"
    )
    let o2 = brine(["run", d + "/bad.br", "-q"])
    assert o2.code == 1, o2.all()
    assert "error: cannot read no/such/file.txt" in o2.err, o2.err
    write(d + "/sig.br", "fn main(n: int) -> str:\n    return \"x\"\n")
    let o3 = brine(["run", d + "/sig.br", "-q"])
    assert "error[E0706]" in o3.err, o3.err
    # `Result[int, E]`: `Ok(n)` is the exit code
    write(
        d + "/code.br",
        """
        fn main() -> Result[int, str]:
            let n = int("7")
            if len(args()) > 0:
                return Err("no args, please")
            return Ok(n)
        """
    )
    let o4 = brine(["run", d + "/code.br", "-q"])
    assert o4.code == 7, o4.all()
    let o5 = brine(["run", d + "/code.br", "-q", "--", "x"])
    assert o5.code == 1 and "error: no args, please" in o5.err, o5.all()

# ------------------------------------------------------------ errors

test "deadlocks are rejected":
    assert (
        error_codes("tests/programs/deadlock_errors.br")
        == [
            "E0510@17",
            "E0510@21",
            "E0511@24",
            "E0511@26",
            "E0510@30",
            "E0510@34",
            "E0511@35",
            "E0510@38"
        ]
    )
    # every line marked `# E05..` in the file, and nothing else
    let file = "tests/programs/deadlock_errors2.br"
    var want: [str] = []
    for i, l in enumerate(read_file(file).unwrap().lines()):
        if "# E05" in l:
            want.push(l[l.find("# E05").unwrap() + 2:].strip() + "@" + str(i + 1))
    assert error_codes(file) == want

