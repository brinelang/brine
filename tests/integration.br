# End-to-end tests: real programs through the `brine` binary.
#
#   brine test tests/integration.br            from the repository root
#
# `$BRINE` (set by `brine test`) is the compiler under test. Needs a C compiler,
# like `brine` itself. Scratch files go to target/it/.

struct Out:
    code: int
    out: str
    err: str

    fn all(self) -> str:
        return self.out + self.err

fn brine_exe() -> str:
    match getenv("BRINE"):
        case Some(b):
            return b
        case None:
            return "brine"

fn exec(cmd: [str], env: {str: str}) -> Out:
    var e = env
    e["NO_COLOR"] = "1"
    var h = 0
    match os.spawn(cmd, e, true, false):
        case Ok(p):
            h = p
        case Err(msg):
            panic(f"cannot run {cmd[0]}: {msg}")
    let code = os.wait(h)
    let (o, er) = os.output(h)
    return Out(code=code, out=o.replace("\r\n", "\n"), err=er.replace("\r\n", "\n"))

fn brine_env(args: [str], env: {str: str}) -> Out:
    var cmd = [brine_exe()]
    cmd.extend(args)
    return exec(cmd, env)

fn brine(args: [str]) -> Out:
    return brine_env(args, {})

fn text(path: str) -> str:
    match read_file(path):
        case Ok(t):
            return t.replace("\r\n", "\n")
        case Err(e):
            panic(e)

# The `.out` file next to a program (or a project directory).
fn expected(file: str) -> str:
    let base = file[:len(file) - 3] if file.ends_with(".br") else file
    return text(base + ".out")

# Run `file` and compare its output; also checks that nothing leaked.
fn run_ok(file: str, want: str, extra: [str]):
    run_with(file, want, extra, {})

# The same with extra environment variables (`BRINE_BACKEND`).
fn run_with(file: str, want: str, extra: [str], env: {str: str}):
    var args = ["run", file, "-q"]
    args.extend(extra)
    var e = env
    e["BRINE_LEAKCHECK"] = "1"
    let o = brine_env(args, e)
    assert o.code == 0, f"{file} failed:\n{o.all()}"
    assert o.out == want, f"unexpected output from {file}:\n{o.out}\nwanted:\n{want}"
    if "--ranks" not in extra:
        assert "brine: 0 live objects at exit" in o.err, f"{file} leaked memory:\n{o.err}"

fn field(line: str, key: str) -> str:
    let pat = "\"" + key + "\":"
    match line.find(pat):
        case Some(i):
            var rest = line[i + len(pat):]
            if rest.starts_with("\""):
                rest = rest[1:]
            var out = ""
            for c in rest.chars():
                if c == "," or c == "\"" or c == "}":
                    break
                out += c
            return out
        case None:
            return ""

# `code@line` for every error `brine check` reports.
fn error_codes(file: str) -> [str]:
    return error_codes_with(file, [])

fn error_codes_with(file: str, flags: [str]) -> [str]:
    var cmd = ["check", file, "--json"]
    cmd.extend(flags)
    let o = brine(cmd)
    assert o.code != 0, f"{file} has no errors"
    var out: [str] = []
    for l in o.out.lines():
        if "\"severity\":\"error\"" in l:
            out.push(field(l, "code") + "@" + field(l, "line"))
    return out

fn scratch(name: str) -> str:
    let d = f"target/it/{name}-{os.pid()}"
    match os.make_dir(d):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    return d

fn write(path: str, t: str):
    match write_file(path, t):
        case Ok(_):
            pass
        case Err(e):
            panic(e)

fn exe(path: str) -> str:
    return path + ".exe" if os.name() == "windows" else path

# ------------------------------------------------------------ programs

test "examples run":
    run_ok("examples/hello.br", "Hello, world!\n", [])
    run_ok("examples/contracts.br", "10 0\n3 -1\n2.5 11\n", [])
    run_ok(
        "examples/shapes",
        "Point(x=3.0, y=4.0) 5.0\n[6.0, 2.25] 8.25\nbig circle 3.14159\nShape.Square(side=2.0) 4.0\ndot\n",
        []
    )
    run_ok(
        "examples/parallel.br",
        "average steps: 131.43, longest: 524\n[0.0, 1.0, 1.4142135623730951, 1.7320508075688772, 2.0, 2.23606797749979, 2.449489742783178, 2.6457513110645907]\n111 118\n",
        []
    )

test "world programs run on several processes":
    run_ok(
        "examples/world.br",
        "1 ranks, total = 499999500000, squares = [0]\nafter one lap: token->0\nrank 0 received [[0, 0]]\n",
        []
    )
    run_ok(
        "examples/world.br",
        "4 ranks, total = 499999500000, squares = [0, 1, 4, 9]\nafter one lap: token->0->1->2->3\nrank 3 received [[0, 3], [1, 3], [2, 3], [3, 3]]\n",
        ["--ranks", "4"]
    )
    run_ok(
        "tests/programs/world_solver.br",
        "converged after 22 iterations true\n",
        ["--ranks", "3"]
    )
    # idioms the deadlock checker must accept
    run_ok("tests/programs/world_idioms.br", "100 2 [0, 1, 2] Ok(30) [3, 2, 4]\n", ["--ranks", "3"])
    run_ok("tests/programs/world_ops.br", text("tests/programs/world_ops.out"), ["--ranks", "4"])
    run_ok("tests/programs/world_ops.br", text("tests/programs/world_ops5.out"), ["--ranks", "5"])
    run_ok("tests/programs/world_child.br", "inherited: [false, false, false]\n", ["--ranks", "3"])
    run_ok("tests/programs/world_exit.br", "total 3 true\n", ["--ranks", "3"])

test "world runtime failures are clear":
    # every rank exits with the same code: it's the launcher's
    let o = brine(["run", "-q", "--ranks", "3", "tests/programs/world_exit.br", "--", "x"])
    assert o.code == 3 and o.out == "total 3 true\n" and "error:" not in o.err, o.all()
    # the first rank to fail is the cause; the others are stopped
    let p = brine(["run", "-q", "--ranks", "4", "tests/programs/world_panic.br"])
    assert p.code == 101, p.all()
    assert "panic (rank 1): rank 1 gives up" in p.err, p.all()
    assert "error: rank 1 failed (exit code 101), so the other ranks were stopped" in p.err, p.all()
    # ranks in different collectives (two programs in one world: the compiler
    # rejects a program that could do this) panic, naming both call sites
    let d = scratch("mismatch")
    write(f"{d}/a.br", "fn main():\n    print(world.sum(1))\n")
    write(f"{d}/b.br", "fn main():\n    world.barrier()\n")
    var exes: [str] = []
    for n in ["a", "b"]:
        let b = brine(["build", "-q", f"{d}/{n}.br", "-o", f"{d}/{n}.exe"])
        assert b.code == 0, b.all()
        exes.push(f"{d}/{n}.exe")
    var peers = ""
    match os.free_ports(2):
        case Ok(ps):
            peers = f"127.0.0.1:{ps[0]},127.0.0.1:{ps[1]}"
        case Err(e):
            panic(e)
    var kids: [int] = []
    for r in 0..2:
        let env = {"BRINE_RANK": f"{r}", "BRINE_WORLD_SIZE": "2", "BRINE_PEERS": peers}
        match os.spawn([exes[r]], env, true, false):
            case Ok(k):
                kids.push(k)
            case Err(e):
                panic(e)
    var errs: [str] = []
    for k in kids:
        let code = os.wait(k)
        let (_, er) = os.output(k)
        assert code == 101, er
        errs.push(er.replace("\r\n", "\n"))
    let (e0, e1) = (errs[0], errs[1])
    assert "mismatched communication: this rank is in `world.sum`, but rank 1 is in `world.barrier` at " in e0, e0
    assert "b.br:2:5" in e0, e0
    assert "this rank is in `world.barrier`, but rank 0 is in `world.sum` at " in e1, e1

