# ------------------------------------------------------------ tools

test "the test command":
    let o = brine(["test", "examples/contracts.br"])
    assert o.code == 0, o.all()
    assert "2 passed; 0 failed" in o.all(), o.all()

test "the formatter is stable":
    var files: [str] = []
    for dir in [
        "examples",
        "examples/shapes",
        "tests",
        "tests/programs",
        "tests/programs/generics",
        "tests/programs/imports",
        "tests/programs/imports/shapes",
        "tests/programs/typed/src",
        "runtime",
        "compiler"
    ]:
        match os.list_dir(dir):
            case Ok(names):
                for n in names:
                    if n.ends_with(".br"):
                        files.push(dir + "/" + n)
            case Err(e):
                panic(e)
    var args = ["fmt", "--check"]
    args.extend(files)
    let o = brine(args)
    assert o.code == 0, o.all()

test "a new project works out of the box":
    let d = scratch("new")
    match os.set_cwd(d):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    assert brine(["new", "app"]).code == 0
    for f in ["brine.toml", "src/main.br", "AGENTS.md", ".gitignore"]:
        assert file_exists("app/" + f), f"missing {f}"
    match os.set_cwd("app"):
        case Ok(_):
            pass
        case Err(e2):
            panic(e2)
    let o = brine(["run", "-q"])
    assert o.out == "Hello, brine!\n[0, 1, 4, 9, 16, 25, 36, 49, 64, 81]\n", o.all()
    assert brine(["test"]).code == 0
    assert brine(["check"]).code == 0
    assert brine(["fmt", "--check"]).code == 0

# Each tests/syntax/NAME.br has NAME.lex and NAME.parse: the expected `brine lex`
# and `brine parse` output (regenerate with `brine run tests/update_syntax.br`).
test "lexer and parser output":
    var names: [str] = []
    match os.list_dir("tests/syntax"):
        case Ok(ns):
            names = ns
        case Err(e):
            panic(e)
    var n = 0
    for name in names:
        if not name.ends_with(".br"):
            continue
        let f = "tests/syntax/" + name
        let base = f[:len(f) - 3]
        let lx = brine(["lex", f])
        assert lx.code == 0, lx.err
        assert lx.out == text(base + ".lex"), f"`brine lex {f}` changed"
        let ps = brine(["parse", f])
        assert ps.code == 0, ps.err
        assert ps.out == text(base + ".parse"), f"`brine parse {f}` changed"
        n += 1
    assert n > 20

test "the compiler's own unit tests":
    for f in ["compiler/dev_solver.br", "compiler/dev_diag.br"]:
        let o = brine(["test", f])
        assert o.code == 0, o.all()
    # the native backend's checks are a program: it compiles IR by hand,
    # links it and compares what it prints (on the hosts it targets)
    if os.arch() == "x86_64" and os.name() != "macos":
        let o = brine(["run", "compiler/dev_native.br", "-q"])
        assert o.code == 0, o.all()
        assert "0 wrong" in o.out, o.all()

# The compiler builds itself, and that build generates the same C again (a fixed point).
test "the compiler builds itself":
    let d = scratch("self")
    let s1 = exe(d + "/stage1")
    let s2 = exe(d + "/stage2")
    let o = brine(["build", "compiler/main.br", "-q", "-o", s1])
    assert o.code == 0, o.all()
    let o2 = exec([s1, "build", "compiler/main.br", "-q", "-o", s2], {})
    assert o2.code == 0, o2.all()
    let o3 = exec([s1, "emit-c", "compiler/main.br", "-o", d + "/stage1.c"], {})
    assert o3.code == 0, o3.all()
    let o4 = exec([s2, "emit-c", "compiler/main.br", "-o", d + "/stage2.c"], {})
    assert o4.code == 0, o4.all()
    assert text(
        d + "/stage1.c"
    ) == text(d + "/stage2.c"), "the self-built compiler generates different C"
    # a compiler built by the other backend (C, where dev builds are native) agrees
    let s3 = exe(d + "/stage3")
    let o5 = brine_env(["build", "compiler/main.br", "-q", "-o", s3], {"BRINE_BACKEND": "c"})
    assert o5.code == 0, o5.all()
    let o6 = exec([s3, "emit-c", "compiler/main.br", "-o", d + "/stage3.c"], {})
    assert o6.code == 0, o6.all()
    assert text(
        d + "/stage1.c"
    ) == text(d + "/stage3.c"), "the compilers built by the two backends disagree"
