# The number after `key` in a line of JSON.
fn json_int(s: str, key: str) -> int:
    let i = s.find(key).unwrap()
    var n = 0
    for c in s[i + len(key):].chars():
        if not c.is_digit():
            break
        n = n * 10 + c.to_int().unwrap()
    return n

# The string after `key` in a line of JSON, unescaped.
fn json_string(s: str, key: str) -> str:
    let cs = s[s.find(key).unwrap() + len(key) + 1:].chars()
    var out = ""
    var i = 0
    while cs[i] != "\"":
        if cs[i] == "\\":
            i += 1
            match cs[i]:
                case "n":
                    out += "\n"
                case "t":
                    out += "\t"
                case "r":
                    out += "\r"
                case "u":
                    var code = 0
                    for h in cs[i + 1:i + 5]:
                        code = code * 16 + "0123456789abcdef".find(h.lower()).unwrap()
                    out += chr(code)
                    i += 4
                case _:
                    out += cs[i]
        else:
            out += cs[i]
        i += 1
    return out

# `src` with every edit in the `fixes` of `brine check --json` output applied,
# last first (lines and columns are 1-based and count characters); an edit
# that overlaps one already applied is skipped.
fn apply_fixes(src: str, json: str) -> (str, int):
    let cs = src.chars()
    var starts = [0]
    for i, c in enumerate(cs):
        if c == "\n":
            starts.push(i + 1)
    var edits: [(int, int, str)] = []
    for l in json.lines():
        match l.find("\"fixes\":["):
            case Some(k):
                for part in l[k:].split("{\"file\":")[1:]:
                    let lo = (
                        starts[json_int(part, "\"line\":") - 1] + json_int(part, "\"column\":") - 1
                    )
                    let hi = (
                        starts[json_int(part, "\"end_line\":") - 1]
                        + json_int(part, "\"end_column\":")
                        - 1
                    )
                    edits.push((lo, hi, json_string(part, "\"replacement\":")))
            case None:
                pass
    edits.sort()
    var out = cs
    var limit = len(cs) + 1
    var n = 0
    var k = len(edits) - 1
    while k >= 0:
        let (lo, hi, r) = edits[k]
        if hi <= limit:
            out = out[:lo] + r.chars() + out[hi:]
            limit = lo
            n += 1
        k -= 1
    return ("".join(out), n)

test "suggested fixes give code that lexes and parses":
    # programs from the a_dx_errors corpus whose mistakes all come with fixes
    var names: [str] = []
    match os.list_dir("tests/fixes"):
        case Ok(ns):
            names = ns
        case Err(e):
            panic(e)
    let d = scratch("fixes")
    var n = 0
    for name in names:
        if not name.ends_with(".br"):
            continue
        let f = "tests/fixes/" + name
        let before = brine(["check", f, "--json"])
        let (fixed, edits) = apply_fixes(text(f), before.out)
        assert edits > 0, f"{f} has no suggested fixes"
        let g = d + "/" + name
        write(g, fixed)
        for l in brine(["check", g, "--json"]).out.lines():
            # E01xx are the lexer's and the parser's errors
            assert "\"code\":\"E01" not in l, f"the fixes of {f} don't parse:\n{fixed}\n{l}"
        let base = f[:len(f) - 3]
        match read_file(base + ".fixed"):
            case Ok(want):
                assert fixed == want.replace("\r\n", "\n"), f"the fixes of {f} gave:\n{fixed}"
            case Err(_):
                pass
        n += 1
    assert n > 30

test "helps say what works for the mistake at hand":
    # (program, code, part of its help): v09#10's wrong or dead-end helps
    let cases = [
        (
            "struct C:\n    n: int\n\n    fn bump(self):\n        self.n += 1\n\nfn main():\n    pass\n",
            "E0403",
            "fn name(ref self, ...)"
        ),
        (
            "fn main():\n    let total = 7\n    let n = 2\n    let avg: float = total / n\n    print(avg)\n",
            "E0301",
            "float(total) / float(n)"
        ),
        (
            "fn find(xs: [int]) -> int:\n    return None\n\nfn main():\n    print(find([]))\n",
            "E0301",
            "Option[int]"
        ),
        (
            "fn main():\n    let xs = [1, 2]\n    var total = 0\n    par for i in 0..len(xs):\n        total += xs[i]\n    print(total)\n",
            "E0501",
            "total += par sum("
        ),
        (
            "fn main():\n    var evens: [int] = []\n    par for i in 0..10:\n        evens.push(i)\n    print(evens)\n",
            "E0501",
            "evens = par ["
        ),
        (
            "fn main():\n    let opt = Some(1)\n    let Some(x) = opt\n    print(x)\n",
            "E0115",
            "match opt:"
        ),
        (
            "struct P:\n    x: int\n\nimpl P:\n    fn get(self) -> int:\n        return self.x\n\nfn main():\n    pass\n",
            "E0115",
            "inside the `struct`"
        ),
        (
            "struct R:\n    w: int\n\n    fn area(self) -> int:\n        return self.w\n\n    fn twice(self) -> int:\n        return 2 * area()\n\nfn main():\n    pass\n",
            "E0201",
            "self.area()"
        ),
        (
            "fn main():\n    let x = 3.7\n    print(int(x))\n",
            "E0607",
            "can't remove a float-to-int conversion check yet"
        )
    ]
    let d = scratch("helps")
    for i, c in enumerate(cases):
        let (src, code, help) = c
        let f = f"{d}/case{i}.br"
        write(f, src)
        let o = brine(
            ["check", f, "--json", "--proven"] if code == "E0607" else ["check", f, "--json"]
        )
        var found = false
        for l in o.out.lines():
            if f"\"code\":\"{code}\"" in l and help in l:
                found = true
        assert found, f"case {i}: no {code} with help `{help}`:\n{o.out}"

test "errors point at their cause and don't cascade":
    let d = scratch("cascade")
    # an unclosed bracket is reported at the bracket, not at the next line
    write(d + "/unclosed.br", "fn main():\n    print(max(1, 2)\n    let x = 3\n    print(x)\n")
    assert error_codes(d + "/unclosed.br") == ["E0110@2"]
    let u = brine(["check", d + "/unclosed.br"]).all()
    assert "this `(` is never closed" in u, u
    # after a broken string, later errors are a guess: one error, and a note
    write(d + "/string.br", "fn main():\n    let s = \"a\n    print(s +)\n    let t = \"b\"\n")
    assert error_codes(d + "/string.br") == ["E0102@2"]
    assert "later error" in brine(["check", d + "/string.br"]).all()
    # a name that is both a module and an imported function: one error
    os.make_dir(d + "/clash").unwrap()
    write(d + "/clash/load.br", "fn load(p: str) -> int:\n    return len(p)\n")
    write(
        d + "/clash/main.br",
        "import load\nfrom load import load\n\nfn main():\n    print(load(\"abc\"))\n"
    )
    assert error_codes(d + "/clash/main.br") == ["E0202@2"]
    # `println!(...)` and `a; b` each give one error
    write(
        d + "/rust.br",
        "fn main():\n    println!(\"hi\")\n    let a = 1; let b = 2\n    print(a + b)\n"
    )
    assert error_codes(d + "/rust.br") == ["E0115@2", "E0106@3"]

test "the deadlock checker iterates to a fixpoint":
    # a rank-dependent value passed along 120 functions...
    let d = scratch("fixpoint")
    var fns = "fn main():\n    if f0() == 0:\n        world.barrier()\n"
    for i in 0..120:
        fns += f"fn f{i}() -> int:\n    return f{i + 1}()\n"
    fns += "fn f120() -> int:\n    return world.rank()\n"
    write(d + "/fns.br", fns)
    assert error_codes(d + "/fns.br") == ["E0510@3"]
    # ... or 60 variables, copied in reverse order inside a loop
    var vars = "fn main():\n"
    for i in 0..61:
        vars += f"    var v{i} = 0\n"
    vars += "    for k in 0..100:\n"
    for i in 0..60:
        vars += f"        v{60 - i} = v{59 - i}\n"
    vars += "        v0 = world.rank()\n    if v60 == 0:\n        world.barrier()\n"
    write(d + "/vars.br", vars)
    assert error_codes(d + "/vars.br") == ["E0510@126"]

