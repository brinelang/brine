test "proofs remove runtime checks":
    for f in ["examples/contracts.br", "examples/find_signal.br"]:
        let o = brine(["check", f, "--report"])
        assert o.code == 0, o.all()
        assert "0 remain" in o.all(), o.all()

test "the report lists every remaining check":
    let o = brine(["check", "tests/programs/report_checks.br", "--report"])
    assert o.code == 0, o.all()
    var lines: [str] = []
    for l in o.out.lines():
        if l.starts_with("tests/programs/report_checks.br:"):
            lines.push(l.split(": ")[1].split(" `")[0])
    assert lines == [
        "overflow check",
        "overflow check",
        "overflow check",
        "conversion check",
        "conversion check",
        "array length check",
        "empty array check",
        "shift check",
        "map key check",
        "map key check",
        "overflow check",
        "index bounds check",
        "insert index check",
        "character check",
        "repeat count check",
        "assert"
    ], o.all()

test "every operation that can panic is a runtime check":
    let f = "tests/programs/proven_panics.br"
    # a str slice, int(s), float(s), a start offset, min of an array, sum,
    # unwrap() and split: each one, and none of the proven ones after them
    assert (
        error_codes_with(f, ["--proven"])
        == [
            "E0607@6",
            "E0607@9",
            "E0607@12",
            "E0607@15",
            "E0607@18",
            "E0607@21",
            "E0607@24",
            "E0607@27",
            "E0607@30"
        ]
    )
    let e = brine(["check", f, "--proven"]).err
    assert "slice `s.bytes()` instead" in e, e
    assert "use `s.to_int()` or `s.to_float()`" in e, e
    # without --proven they are listed, and the program builds
    let o = brine(["check", f, "--report"])
    assert o.code == 0, o.all()
    assert "unwrap check `s.find(\"e\").unwrap()`" in o.out, o.all()
    assert "9 remain" in o.all(), o.all()

test "a check that always fails is an error":
    # and the proofs after it still have to hold; code that can't run is quiet
    assert (
        error_codes("tests/programs/always_fails.br")
        == ["E0614@6", "E0614@8", "E0614@9", "E0605@10"]
    )

test "the report says which proven checks still run":
    let f = "tests/programs/report_kept.br"
    let o = brine(["check", f, "--report"])
    assert o.code == 0, o.all()
    # a proven conversion is a plain one: not listed, nothing runs
    assert "conversion check" not in o.out, o.all()
    assert "array length check `[0] * 65536` (proven, still runs)" in o.out, o.all()
    assert "assert `assert false, \"not written yet\"` (always fails)" in o.out, o.all()
    assert (
        "5 runtime checks proven unnecessary (1 of them still runs), 1 remain, 1 of them always fails" in o.all()
    ), o.all()
    let j = brine(["check", f, "--report", "--json"]).out
    assert "\"status\":\"proven, still runs\"" in j, j
    assert "\"checks_proven_still_run\":1" in j and "\"checks_always_fail\":1" in j, j

test "proofs remove compound assignment checks":
    let d = scratch("compound")
    let f = d + "/count.br"
    # `i += 1` can't overflow below `n`; `total += x` can
    write(
        f,
        "fn main():\n    let n = int(\"10\")\n    var i = 0\n    var total = 0\n    while i < n:\n        total += int(\"7\")\n        i += 1\n    print(i, total)\n"
    )
    let c = d + "/count.c"
    let o = brine(["emit-c", "--release", f, "-o", c])
    assert o.code == 0, o.all()
    assert text(c).count("brine_panic_ovf_ab(\"addition\"") == 1, text(c)
    run_ok(f, "10 70\n", [])
    # a counter goes up by at most 1 per iteration: `hits` can't overflow,
    # `big` (which starts near the top) can
    let g = d + "/counter.br"
    write(
        g,
        "fn main():\n    let n = int(\"5\")\n    var hits = 0\n    for i in 0..n:\n        if i % 3 == 0:\n            hits += 1\n    var big = int(\"9223372036854775800\")\n    for i in 0..n:\n        big += 1\n    print(hits, big)\n"
    )
    let gc = d + "/counter.c"
    let o2 = brine(["emit-c", "--release", g, "-o", gc])
    assert o2.code == 0, o2.all()
    assert text(gc).count("brine_panic_ovf_ab(\"addition\"") == 1, text(gc)
    run_ok(g, "2 9223372036854775805\n", [])

test "release builds interleave independent iterations":
    let d = scratch("interleave")
    let c = d + "/interleave.c"
    let o = brine(["emit-c", "--release", "tests/programs/interleave.br", "-o", c])
    assert o.code == 0, o.all()
    # each lane has its own copy of the loop's variables
    assert text(c).count("    double zr_") == 5, text(c)
    # a sum that overflows panics where it would one iteration at a time
    let f = "tests/programs/panic_interleave.br"
    for extra in [["-q"], ["-q", "--release"]]:
        var args = ["run", f]
        args.extend(extra)
        let r = brine(args)
        assert r.code == 101, f"{extra}: exit {r.code}\n{r.err}"
        assert "overflow in addition" in r.err and f"--> {f}:11:13" in r.err, r.err

test "release builds keep local bool arrays as bits":
    let d = scratch("bits")
    let c = d + "/bits.c"
    let o = brine(["emit-c", "--release", "tests/programs/bits.br", "-o", c])
    assert o.code == 0, o.all()
    # `primes`, `pattern` and `marks`, not `main`'s array, which is passed on
    assert text(c).count("brine_bits_new(") == 3, text(c)
    let f = "tests/programs/panic_bits.br"
    for extra in [["-q"], ["-q", "--release"]]:
        var args = ["run", f]
        args.extend(extra)
        let r = brine(args)
        assert r.code == 101, f"{extra}: exit {r.code}\n{r.err}"
        assert "index 70 is out of bounds" in r.err and f"--> {f}:5:11" in r.err, r.err

test "release builds build strings and count them in place":
    let d = scratch("strings")
    let c = d + "/string_building.c"
    let o = brine(["emit-c", "--release", "tests/programs/string_building.br", "-o", c])
    assert o.code == 0, o.all()
    let t = text(c)
    # `w += t[i]` appends the byte without a one-byte string, and the index in
    # `text[i] == " "` is proven (`i` only grows from 0), so no read is checked
    assert t.count("brine_str_at(") == 0, t
    # the `var w = ""` in each loop keeps its block from one iteration to the next
    assert t.count("brine_str_reset(") == 4, t
    # `if w in m: m[w] += 1` looks the key up once
    let body = t[t.find("static void * main__counts(void * v0) {").unwrap():]
    let f = body[:body.find("\n}\n").unwrap()]
    assert f.count("br_mf_map_str_i64(") == 1, f
    # a loop that only appends bytes to a string goes through an appender: all
    # but the loop that reads `r` and the `s += "|"` outside the inner loop
    let body2 = t[t.find("static void main__appenders(void) {").unwrap():]
    let g = body2[:body2.find("\n}\n").unwrap()]
    assert g.count("brine_app_open(") == 5 and g.count("brine_app_byte(") == 6, g
    assert g.count("brine_app_close(") == 5 and g.count("brine_str_add_byte(") == 3, g

test "release builds drop overflow checks a bound rules out":
    let d = scratch("versioned")
    let c = d + "/versioned.c"
    let o = brine(["emit-c", "--release", "tests/programs/versioned.br", "-o", c])
    assert o.code == 0, o.all()
    # `total`'s loop calls a clone of `tri` without checks
    assert text(c).count("main__tri__nc(") == 3, text(c)
    # the bound fails here: the loop as written panics where it would have
    let f = "tests/programs/panic_versioned.br"
    for extra in [["-q"], ["-q", "--release"]]:
        var args = ["run", f]
        args.extend(extra)
        let r = brine(args)
        assert r.code == 101, f"{extra}: exit {r.code}\n{r.err}"
        assert "overflow in multiplication" in r.err and f"--> {f}:3:12" in r.err, r.err

test "release builds run loop idioms as one operation":
    let d = scratch("idioms")
    let c = d + "/idioms.c"
    let o = brine(["emit-c", "--release", "tests/programs/idioms.br", "-o", c])
    assert o.code == 0, o.all()
    let t = text(c)
    for f in [
        "brine_bytes_new(",
        "brine_bytes_rev(",
        "brine_bytes_rotl(",
        "brine_bytes_copy(",
        "brine_arr_rotl(",
        "brine_arr_copy("
    ]:
        assert f in t, f
    # out of bounds: the loop as written panics where it would have
    for p in [
        ("tests/programs/panic_reverse.br", "11:20", "index 13"),
        ("tests/programs/panic_rotate.br", "7:20", "index 12"),
        ("tests/programs/panic_bounds.br", "7:15", "index 6"),
        ("tests/programs/panic_inlined.br", "2:12", "index 3"),
        ("tests/programs/panic_stack_array.br", "3:5", "index 6")
    ]:
        let (f, at, what) = p
        for extra in [["-q"], ["-q", "--release"]]:
            var args = ["run", f]
            args.extend(extra)
            let r = brine(args)
            assert r.code == 101, f"{extra}: exit {r.code}\n{r.err}"
            assert f"{what} is out of bounds" in r.err and f"--> {f}:{at}" in r.err, r.err

# Data is C string literals; a big `embed` is compiled once, not per CPU level.
test "embedded files survive every backend":
    let d = scratch("embed")
    let tail = "q?\"\\??=x\n\t\u{e9}\u{20ac}\u{1}7"
    write(d + "/blob.txt", "abcdefghij".repeat(30000) + tail)
    write(
        d + "/main.br",
        "const BLOB = embed(\"blob.txt\")\n\nfn main():\n    print(len(BLOB), BLOB.count(\"a\"), BLOB[len(BLOB) - 17:] == \""
        + tail.replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\t", "\\t")
        .replace("\u{1}", "\\u{1}")
        + "\")\n"
    )
    let want = "300017 30000 true\n"
    run_ok(d + "/main.br", want, ["--release"])
    run_with(d + "/main.br", want, [], {"BRINE_BACKEND": "c"})
    if wasm_ready():
        run_ok(d + "/main.br", want, ["--target", "wasm"])

test "release builds run small fixed-size loops as vector kernels":
    let d = scratch("kernels")
    let c = d + "/kernels.c"
    let o = brine(["emit-c", "--release", "tests/programs/kernels.br", "-o", c])
    assert o.code == 0, o.all()
    # one kernel per CPU level, for `step` and for `spread`
    let src = text(c)
    assert src.count("static void brk_main__step(char *a0, double f0, double f1) {") == 3, src
    assert src.count("static double brk_main__spread(char *a0) {") == 3, src
    # each CPU level prints what the code as written does
    for level in ["base", "v3", "v4"]:
        run_with(
            "tests/programs/kernels.br",
            expected("tests/programs/kernels.br"),
            ["--release"],
            {"BRINE_CPU": level}
        )
    # the array's length isn't what the callers showed: the function runs as
    # written and panics where it would have
    let f = "tests/programs/panic_kernels.br"
    let pc = d + "/panic.c"
    let o2 = brine(["emit-c", "--release", f, "-o", pc])
    assert o2.code == 0, o2.all()
    assert "brk_main__relax(" in text(pc), text(pc)
    for extra in [["-q"], ["-q", "--release"]]:
        var args = ["run", f]
        args.extend(extra)
        let r = brine(args)
        assert r.code == 101, f"{extra}: exit {r.code}\n{r.err}"
        assert "division by zero" in r.err and f"--> {f}:3:19" in r.err, r.err
        assert "-0.10206207261596574" in r.out, r.out
    # native release builds on x86-64 make the kernels as SSE2 code (xkern.br)
    if os.arch() == "x86_64" and os.name() != "macos":
        let native = {"BRINE_BACKEND": "native"}
        let ir = brine_env(["emit-ir", "--release", "--opt", "tests/programs/kernels.br"], native)
        assert ir.code == 0, ir.all()
        assert "call brk_main__step(" in ir.out and "call brk_main__spread(" in ir.out, ir.out
        # and as AVX-512 code (xwide.br), which runs the SSE2 code on CPUs
        # without AVX-512: both print what the code as written does
        let out = exe(d + "/kn")
        let b = brine_env(
            ["build", "tests/programs/kernels.br", "--release", "-q", "-o", out],
            native
        )
        assert b.code == 0, b.all()
        for k in ["step", "spread", "mix"]:
            assert count_in(out, f"brk_main__{k}_sse2") > 0, k
        let k = "tests/programs/kernels.br"
        run_with(k, expected(k), ["--release"], native)
        run_with(k, expected(k), ["--release"], {"BRINE_BACKEND": "native", "BRINE_VLOOP": "sse2"})
        let r = brine_env(["run", f, "-q", "--release"], native)
        assert r.code == 101, f"native: exit {r.code}\n{r.err}"
        assert "division by zero" in r.err and f"--> {f}:3:19" in r.err, r.err
        assert "-0.10206207261596574" in r.out, r.out

# How many times the bytes of `s` appear in a file.
fn count_in(path: str, s: str) -> int:
    match os.read_bytes(path):
        case Ok(b):
            let p = s.bytes()
            var n = 0
            for i in 0..len(b) - len(p) + 1:
                var j = 0
                while j < len(p) and b[i + j] == p[j]:
                    j += 1
                if j == len(p):
                    n += 1
            return n
        case Err(e):
            panic(e)

test "native release builds run loops over float arrays as vector kernels":
    if os.arch() == "x86_64" and os.name() != "macos":
        let f = "tests/programs/vector_loops.br"
        let d = scratch("vector_loops")
        let out = exe(d + "/vl")
        let native = {"BRINE_BACKEND": "native"}
        let o = brine_env(["build", f, "--release", "-q", "-o", out], native)
        assert o.code == 0, o.all()
        # every loop but `row`'s (its integer math checks for overflow) and
        # `total`'s (it reads the elements, not the indices)
        let ks = [
            "axpy_0",
            "axpy_1",
            "scaled_0",
            "chain_0",
            "ahead_0",
            "ramp_0",
            "dot_0",
            "two_sums_0",
            "ints_0"
        ]
        for k in ks:
            assert count_in(out, f"brv_main__{k}") > 0, k
        assert count_in(out, "brv_main__row") == 0 and count_in(out, "brv_main__total") == 0
        # the kernels' four- and two-lane versions, which CPUs without AVX-512
        # or AVX2 run
        for w in ["avx2", "sse2"]:
            run_with(f, expected(f), ["--release"], {"BRINE_BACKEND": "native", "BRINE_VLOOP": w})

