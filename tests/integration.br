# ------------------------------------------------------------ tools

test "the test command":
    let o = brine(["test", "examples/contracts.br"])
    assert o.code == 0, o.all()
    assert "2 passed; 0 failed" in o.all(), o.all()
    let s = brine(["test", "examples/find_signal.br"])
    assert s.code == 0, s.all()
    assert "1 passed; 0 failed" in s.all(), s.all()
    # a test that dies without a word, or never finishes, still says what happened
    let d = scratch("test-cmd")
    let down = "fn down(n: int) -> int:\n    if n == 0:\n        return 0\n    return 1 + down(n - 1)\n\n"
    write(
        d + "/t.br",
        down + "test \"silent\":\n    exit(3)\n\ntest \"forever\":\n    var i = 0\n    while i >= 0:\n        i = (i + 1) % 7\n\ntest \"deep\":\n    assert down(100_000_000) == 100_000_000\n"
    )
    let t = brine(["test", d + "/t.br", "--timeout", "1"])
    assert t.code == 1 and "0 passed; 3 failed" in t.out, t.all()
    assert "the test exited with code 3 and printed nothing" in t.out, t.out
    assert "timed out after 1s" in t.out, t.out
    if os.name() == "windows":
        # (the runtime may also say so itself)
        assert "stack overflow" in t.out, t.out
        # and `brine run` doesn't call a crash a success
        write(d + "/crash.br", down + "fn main():\n    print(down(100_000_000))\n")
        let r = brine(["run", d + "/crash.br", "-q"])
        assert r.code == 101 and "stack overflow" in r.err, r.all()

# Windows can't replace a running executable: that's not a compiler bug.
test "a locked executable is not called a compiler bug":
    if os.name() != "windows":
        return
    let d = scratch("locked")
    let f = d + "/slow.br"
    let out = exe(d + "/slow")
    write(f, "fn main():\n    os.sleep(20.0)\n")
    assert brine(["build", f, "-q", "-o", out]).code == 0
    var h = 0
    match os.spawn([out], {}, true, false):
        case Ok(p):
            h = p
        case Err(e):
            panic(e)
    write(f, "fn main():\n    os.sleep(20.0)\n    print(1)\n")
    let o = brine(["build", f, "-q", "-o", out])
    os.kill(h)
    os.wait(h)
    assert o.code == 1 and "E0704" in o.err and "still running" in o.err, o.all()
    assert "bug" not in o.err, o.err

test "every command describes itself":
    let h = brine(["help"])
    assert h.code == 0 and "Usage: brine <command>" in h.out, h.all()
    for c in [
        "new",
        "init",
        "run",
        "build",
        "check",
        "test",
        "debug",
        "fmt",
        "explain",
        "guide",
        "doctor",
        "version",
        "help"
    ]:
        for flag in ["--help", "-h"]:
            let o = brine([c, flag])
            assert o.code == 0 and o.out.starts_with(f"Usage: brine {c}"), f"{c} {flag}: {o.all()}"
        let o2 = brine(["help", c])
        assert o2.code == 0 and o2.out.starts_with(f"Usage: brine {c}"), f"help {c}: {o2.all()}"
    let bad = brine(["help", "nope"])
    assert bad.code == 2 and "unknown command `nope`" in bad.err, bad.all()

test "the formatter is stable":
    var files: [str] = []
    for dir in [
        "examples",
        "examples/shapes",
        "tests",
        "tests/programs",
        "tests/programs/generics",
        "tests/programs/imports",
        "tests/programs/imports/shapes",
        "tests/programs/typed/src",
        "runtime",
        "compiler"
    ]:
        match os.list_dir(dir):
            case Ok(names):
                for n in names:
                    if n.ends_with(".br"):
                        files.push(dir + "/" + n)
            case Err(e):
                panic(e)
    var args = ["fmt", "--check"]
    args.extend(files)
    let o = brine(args)
    assert o.code == 0, o.all()

test "a new project works out of the box":
    let d = scratch("new")
    match os.set_cwd(d):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    assert brine(["new", "app"]).code == 0
    for f in ["brine.toml", "src/main.br", "AGENTS.md", ".gitignore"]:
        assert file_exists("app/" + f), f"missing {f}"
    match os.set_cwd("app"):
        case Ok(_):
            pass
        case Err(e2):
            panic(e2)
    let o = brine(["run", "-q"])
    assert o.out == "Hello, brine!\n[0, 1, 4, 9, 16, 25, 36, 49, 64, 81]\n", o.all()
    assert brine(["test"]).code == 0
    assert brine(["check"]).code == 0
    assert brine(["fmt", "--check"]).code == 0

# Each tests/syntax/NAME.br has NAME.lex and NAME.parse: the expected `brine lex`
# and `brine parse` output (regenerate with `brine run tests/update_syntax.br`).
test "lexer and parser output":
    var names: [str] = []
    match os.list_dir("tests/syntax"):
        case Ok(ns):
            names = ns
        case Err(e):
            panic(e)
    var n = 0
    for name in names:
        if not name.ends_with(".br"):
            continue
        let f = "tests/syntax/" + name
        let base = f[:len(f) - 3]
        let lx = brine(["lex", f])
        assert lx.code == 0, lx.err
        assert lx.out == text(base + ".lex"), f"`brine lex {f}` changed"
        let ps = brine(["parse", f])
        assert ps.code == 0, ps.err
        assert ps.out == text(base + ".parse"), f"`brine parse {f}` changed"
        n += 1
    assert n > 20

test "the compiler's own unit tests":
    for f in ["compiler/dev_solver.br", "compiler/dev_diag.br"]:
        let o = brine(["test", f])
        assert o.code == 0, o.all()
    # the native backend's checks are a program: it compiles IR by hand,
    # links it and compares what it prints (on the hosts it targets)
    if os.arch() == "x86_64" and os.name() != "macos":
        let o = brine(["run", "compiler/dev_native.br", "-q"])
        assert o.code == 0, o.all()
        assert "0 wrong" in o.out, o.all()

# The compiler builds itself, and that build generates the same C again (a fixed point).
test "the compiler builds itself":
    let d = scratch("self")
    let s1 = exe(d + "/stage1")
    let s2 = exe(d + "/stage2")
    let o = brine(["build", "compiler/main.br", "-q", "-o", s1])
    assert o.code == 0, o.all()
    let o2 = exec([s1, "build", "compiler/main.br", "-q", "-o", s2], {})
    assert o2.code == 0, o2.all()
    let o3 = exec([s1, "emit-c", "compiler/main.br", "-o", d + "/stage1.c"], {})
    assert o3.code == 0, o3.all()
    let o4 = exec([s2, "emit-c", "compiler/main.br", "-o", d + "/stage2.c"], {})
    assert o4.code == 0, o4.all()
    assert text(
        d + "/stage1.c"
    ) == text(d + "/stage2.c"), "the self-built compiler generates different C"
    # a compiler built by the other backend (C, where dev builds are native) agrees
    let s3 = exe(d + "/stage3")
    let o5 = brine_env(["build", "compiler/main.br", "-q", "-o", s3], {"BRINE_BACKEND": "c"})
    assert o5.code == 0, o5.all()
    let o6 = exec([s3, "emit-c", "compiler/main.br", "-o", d + "/stage3.c"], {})
    assert o6.code == 0, o6.all()
    assert text(
        d + "/stage1.c"
    ) == text(d + "/stage3.c"), "the compilers built by the two backends disagree"
