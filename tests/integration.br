# A shell command that runs `prog args` with stdin from `input` (a file, or
# `cat`/`type` piped into it).
fn stdin_cmd(prog: str, args: str, input: str, pipe: bool) -> [str]:
    if os.name() == "windows":
        let p = prog.replace("/", "\\")
        let i = input.replace("/", "\\")
        if pipe:
            return ["cmd", "/c", f"type {i} | {p} {args}"]
        return ["cmd", "/c", f"{p} {args} < {i}"]
    if pipe:
        return ["sh", "-c", f"cat '{input}' | '{prog}' {args}"]
    return ["sh", "-c", f"'{prog}' {args} < '{input}'"]

# `input()` and `read_stdin()` with stdin a file, a pipe and the null device
test "programs read their standard input":
    let d = scratch("stdin")
    let prog = exe(d + "/stdin")
    let b = brine(["build", "-q", "tests/programs/stdin.br", "-o", prog])
    assert b.code == 0, b.all()
    # CR LF, an empty line, a byte that is not UTF-8, no newline at the end
    var bytes = "first\r\nsecond\n\nhé".bytes()
    bytes.push(u8(255))
    bytes.extend("x\nlast".bytes())
    match os.write_bytes(d + "/in.txt", bytes):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    write(d + "/ok.txt", "a\r\nb\n")
    let lines = "0> [first]\n1> [second]\n2> []\n3> [hé\u{fffd}x]\n4> [last]\n5> end after 5\n"
    let all_ok = "5 bytes: a<CR><LF>b<LF>\n"
    let cases = [
        (stdin_cmd(prog, "", d + "/in.txt", false), lines),
        (stdin_cmd(prog, "", d + "/in.txt", true), lines),
        (stdin_cmd(prog, "all", d + "/ok.txt", false), all_ok),
        (stdin_cmd(prog, "all", d + "/ok.txt", true), all_ok),
        (
            stdin_cmd(prog, "all", d + "/in.txt", false),
            "error: cannot read stdin: the input is not valid UTF-8 text\n"
        ),
        ([prog], "0> end after 0\n"),
        ([prog, "all"], "0 bytes: \n")
    ]
    for cmd, want in cases:
        let o = exec(cmd, {})
        assert o.code == 0 and o.out == want, f"{cmd}: {o.all()}"

test "proof errors":
    assert (
        error_codes("tests/programs/proof_errors.br")
        == ["E0602@6", "E0603@15", "E0604@15", "E0601@20", "E0601@22", "E0605@24"]
    )
    # preconditions that contradict each other, or the parameter's type
    let f = scratch("vacuous") + "/v.br"
    write(
        f,
        "fn f(n: int) -> int:\n    requires n > 0\n    requires n < 0\n    ensures result == 7\n    return 1\n\n"
        + "fn g(xs: [int]) -> int:\n    requires len(xs) < 0\n    return 0\n\n"
        + "fn h(n: int) -> int:\n    requires n > 0\n    requires n < 10\n    return n\n\n"
        + "fn main():\n    print(h(1))\n"
    )
    assert error_codes(f) == ["E0608@2", "E0608@8"]
    assert "the preconditions of `f` can never all hold" in brine(["check", f]).err

test "struct invariants are kept by every value":
    # built, returned from a `ref self` method, used whole in one
    assert (
        error_codes("tests/programs/invariant_errors.br")
        == ["E0609@6", "E0609@13", "E0609@24", "E0609@27"]
    )
    # only the struct's methods change the fields its invariants read
    assert (
        error_codes("tests/programs/invariant_fields.br")
        == ["E0406@17", "E0406@18", "E0406@19", "E0406@20", "E0406@45", "E0406@46"]
    )
    let fe = brine(["check", "tests/programs/invariant_fields.br"]).err
    assert "`hi` is in an `invariant` of `Tagged`" in fe, fe
    # a copy of `self` is a value of its own: nothing proves its invariant
    let cp = scratch("copy_self") + "/c.br"
    write(
        cp,
        "struct Acc:\n    items: [int]\n    invariant len(self.items) < 100\n\n    fn plus(self, x: int) -> int:\n        var s = self\n        if len(s.items) < 99:\n            s.items.push(x)\n        return len(s.items)\n\nfn main():\n    print(Acc(items=[1]).plus(3))\n"
    )
    assert error_codes(cp) == ["E0406@8"]
    # a loop that changes `self` only through calls that prove the invariant
    # keeps it; one that writes a field the invariant reads doesn't
    let lp = brine(["check", "tests/programs/invariant_loops.br"]).err
    var at: [str] = []
    for l in lp.lines():
        if "--> tests/programs/invariant_loops.br:" in l:
            at.push(l.split(":")[1])
    assert at == ["23", "27", "31"], lp
    let e = brine(["check", "tests/programs/invariant_errors.br"]).err
    assert "values the prover can't rule out: self.lo = 0, self.hi = 0, by = -1" in e, e
    assert "`self` is used here, where it might break the invariant" in e, e
    # generic structs can't have one yet; a field may still be named `invariant`
    let f = scratch("generic_inv") + "/g.br"
    write(
        f,
        "struct Pair[T]:\n    a: T\n    n: int\n    invariant self.n >= 0\n\n"
        + "struct K:\n    invariant: int\n\nfn main():\n    print(K(invariant=1).invariant)\n"
    )
    assert error_codes(f) == ["E0112@4"]
    # built through its module's name
    let d = scratch("module_inv")
    write(
        d + "/geo.br",
        "struct Range:\n    lo: int\n    hi: int\n    invariant self.lo <= self.hi\n"
    )
    write(d + "/main.br", "import geo\n\nfn main():\n    print(geo.Range(lo=3, hi=1))\n")
    assert error_codes(d + "/main.br") == ["E0609@4"]

test "the notes of failed proofs":
    let f = "tests/programs/proof_notes.br"
    assert error_codes(f) == ["E0605@16", "E0605@24", "E0605@29", "E0604@37", "E0604@47"]
    let e = brine(["check", f]).err
    # a `let` names its value, also when unpacking a tuple
    assert "to prove: len(t.xs) > i" in e, e
    assert "mk(n)" not in e, e
    assert "to prove: end >= 0" in e, e
    # only the part that isn't proven; a remainder's quotient in parentheses
    assert "to prove: i <= 4 and m > 0 (the rest of it is proven)" in e, e
    assert "m == 4*(m / 4)" in e, e
    # an inner loop forgot `bi`: no facts about its old value, and a hint
    assert "known facts here: n == len(xs)\n" in e, e
    assert "`bi` is changed by a loop before this point" in e, e
    assert "where `p` is p + 1" in e, e

test "the prover says when it gave up":
    let f = "tests/programs/proof_gave_up.br"
    assert error_codes(f) == ["E0605@25", "E0605@30"]
    let o = brine(["check", f])
    # only the true claim that needs too many cases, not the false one
    assert o.err.count("the prover gave up") == 1, o.all()
    assert o.err.find("gave up").unwrap() < o.err.find("30 |").unwrap(), o.all()

test "failed proofs show values the prover can't rule out":
    let d = scratch("values")
    let f = d + "/values.br"
    write(
        f,
        "fn last(xs: [int]) -> int:\n    ensures 0 <= result < len(xs)\n    return len(xs) - 1\n\n"
        + "fn clamp(x: int, lo: int, hi: int) -> int:\n    ensures lo <= result <= hi\n    if x < lo:\n        return lo\n    return min(x, hi)\n\n"
        + "fn sign(neg: bool, x: int) -> int:\n    ensures result >= 0\n    if neg:\n        return -x\n    return x\n\n"
        + "fn count(n: int) -> int:\n    var i = 0\n    while i < n:\n        invariant i <= n\n        i += 2\n    return i\n\n"
        + "fn main():\n    print(last([1]), clamp(1, 0, 2), sign(false, 1), count(4))\n"
    )
    let o = brine(["check", f])
    let e = o.err
    assert "values the prover can't rule out: len(xs) = 0\n" in e, e
    # both returns of `clamp` fail when the range is empty; to the prover,
    # a call's value is a value of its own
    assert "values the prover can't rule out: lo = 1, hi = 0\n" in e, e
    assert "values the prover can't rule out: lo = 1, min(x, hi) = 0\n" in e, e
    assert "values the prover can't rule out: x = 1\n" in e, e
    assert "values the prover can't rule out: x = -1\n" in e, e
    # an invariant that doesn't hold on entry, and one a step breaks
    assert "values the prover can't rule out: n = -1\n" in e, e
    assert "values the prover can't rule out: n = 1, i = 0\n" in e, e
    # and in the JSON diagnostics
    let j = brine(["check", f, "--json"]).out
    assert "values the prover can't rule out: len(xs) = 0" in j, j

test "proven projects can't keep runtime checks":
    let d = scratch("proven")
    match os.make_dir(d + "/src"):
        case _:
            pass
    write(d + "/brine.toml", "[package]\nname = \"p\"\n\n[check]\nproven = true\n")
    let src = (
        "fn get(xs: [int], i: int) -> int:\n    return xs[i]\n\n"
        + "fn get_ok(xs: [int], i: int) -> int:\n    requires 0 <= i < len(xs)\n    return xs[i]\n\n"
        + "fn half(n: int) -> int:\n    assert n % 2 == 0\n    return n / 2\n\n"
        + "fn main():\n    let m = {1: 2}\n    print(get([1], 0), get_ok([1], 0), half(2), m.get(1).unwrap_or(0), m[1])\n\n"
        + "test \"tests may check at runtime\":\n    let m = {1: 2}\n    assert m[1] == get([2], 0)\n"
    )
    write(d + "/src/main.br", src)
    # the bounds check, the assert and the map read: not the test block
    assert error_codes(d) == ["E0607@2", "E0607@9", "E0607@14"]
    let e = brine(["check", d]).err
    assert "values the prover can't rule out: len(xs) = 0, i = -1" in e, e
    assert "use `m.get(k)`" in e, e
    # the same file outside the project: allowed, unless asked for
    write(d + "/plain.br", src)
    let o = brine(["check", d + "/plain.br"])
    assert o.code == 0, o.all()
    # (the test block's map read is listed, as a test's checks always were)
    assert "4 remain" in o.all(), o.all()
    let p = brine(["check", d + "/plain.br", "--proven", "--json"])
    assert p.code != 0 and p.out.count("\"code\":\"E0607\"") == 3, p.all()

fn git(dir: str, args: [str]):
    var cmd = [
        "git",
        "-C",
        dir,
        "-c",
        "user.name=t",
        "-c",
        "user.email=t@t",
        "-c",
        "commit.gpgsign=false"
    ]
    cmd.extend(args)
    let o = exec(cmd, {})
    assert o.code == 0, f"git {args}: {o.all()}"

test "spec-diff finds specs that promise less":
    let d = scratch("specdiff")
    let f = d + "/main.br"
    let ring = "struct Ring:\n    items: [int]\n    cap: int\n"
    let clamp = "fn clamp(x: int, lo: int, hi: int) -> int:\n"
    let body = "    if x < lo:\n        return lo\n    if x > hi:\n        return hi\n    return x\n\n"
    let get = "fn get(xs: [int], i: int) -> int:\n"
    let main = "fn main():\n    var n = 0\n    bump(ref n)\n    print(clamp(5, 0, 3), n, get([1, 2], 1))\n"
    write(
        f,
        ring
        + "    invariant 0 < self.cap\n\n"
        + clamp
        + "    requires lo <= hi\n    ensures lo <= result <= hi\n"
        + body
        + "fn bump(ref n: int):\n    requires n >= 0\n    ensures n >= 1\n    n += 1\n\n"
        + get
        + "    requires 0 <= i and i < len(xs)\n    return xs[i]\n\n"
        + main
    )
    git(d, ["init", "-q"])
    git(d, ["add", "main.br"])
    git(d, ["commit", "-q", "-m", "v1"])
    let same = brine(["spec-diff", f])
    assert same.code == 0 and "no spec changes" in same.err, same.all()
    # weaker in four ways, the same `requires` written another way, a stronger
    # `ensures` and a new runtime check
    write(
        f,
        ring
        + "    invariant 0 <= self.cap\n\n"
        + clamp
        + "    requires lo <= hi\n    requires x >= 0\n    ensures lo <= result\n"
        + body
        + "fn bump(ref n: int):\n    requires n >= 0\n    ensures n >= 0\n    ensures n > 0 or n == 0\n    n += 1\n\n"
        + get
        + "    requires i < len(xs) and i >= 0\n    ensures result == xs[i]\n    return xs[i]\n\n"
        + "fn first(xs: [int]) -> int:\n    return xs[0]\n\n"
        + main
    )
    let o = brine(["spec-diff", f, "--json"])
    assert o.code == 1, o.all()
    var got: [str] = []
    for l in o.out.lines():
        if "\"change\":" in l:
            got.push(
                field(l, "change")
                + " "
                + field(l, "kind")
                + " "
                + field(l, "item")
                + ": "
                + field(l, "clause")
            )
    assert got == [
        "weaker narrowed clamp: x >= 0",
        "weaker weakened clamp: lo <= result <= hi",
        "weaker weakened bump: n >= 1",
        "weaker inv-weakened Ring: 0 < self.cap",
        "note inv-added Ring: 0 <= self.cap",
        "stronger stronger get: result == xs[i]"
    ], "\n".join(got)
    assert "\"checks_before\":1,\"checks_after\":2" in o.out, o.out
    let t = brine(["spec-diff", f])
    assert "main.br:6:4: weaker: `clamp` no longer promises `lo <= result <= hi`" in t.out, t.all()
    # and what it promises now
    assert "main.br:6:4: note: `clamp` now promises `lo <= result`" in t.out, t.all()
    assert "note: `bump` now promises `n >= 0` and `n > 0 or n == 0`" in t.out, t.all()
    assert "runtime checks left: 1 → 2 (+1 index bounds check)" in t.out, t.all()
    let bad = brine(["spec-diff", f, "--base", "nope"])
    assert bad.code == 2 and "could not read" in bad.err, bad.all()
    assert "there is no revision `nope` in this repository" in bad.err, bad.all()
    # a repository without commits has nothing to compare with yet
    let e = scratch("specdiff-empty")
    write(e + "/main.br", main)
    git(e, ["init", "-q"])
    let none = brine(["spec-diff", e + "/main.br"])
    assert none.code == 2 and "the repository has no commits yet" in none.err, none.all()

# `code@file:line` for each error and warning in `--json` output.
fn diag_codes(o: Out) -> [str]:
    var out: [str] = []
    for l in o.out.lines():
        if "\"severity\":\"error\"" in l or "\"severity\":\"warning\"" in l:
            let parts = field(l, "file").replace("\\\\", "/").split("/")
            let file = parts[len(parts) - 1]
            out.push(field(l, "code") + "@" + file + ":" + field(l, "line"))
    return out

const PUMP_SETTINGS = "struct Settings:\n    target: int\n    sensitivity: int\n    max_bolus: int\n    daily_limit: int\n    invariant 70 <= self.target <= 200\n    invariant 10 <= self.sensitivity <= 400\n    invariant 0 <= self.max_bolus <= 25_000\n    invariant 0 <= self.daily_limit <= 200_000\n"

const PUMP_RULES = "from pump import Pump, new_pump, dose_for\nfrom rules.dosing import Settings\n\nrule \"a dose is never more than one bolus\" for p: Pump, reading: int:\n    let d = dose_for(p, reading)\n    prove 0 <= d <= p.settings.max_bolus\n\nrule \"a day's insulin never goes over the daily limit\" for p: Pump, reading: int:\n    let d = dose_for(p, reading)\n    prove p.delivered_today + d <= p.settings.daily_limit\n\nrule \"a new pump has delivered nothing\" for s: Settings:\n    let p = new_pump(s)\n    prove p.delivered_today == 0\n\nrule \"dosing has no effects\":\n    effects pump: none\n"

# `dose_for` with `extra` lines before its return; `room` false drops the
# daily-limit clamp (and the `ensures` that says so).
fn pump_src(room: bool, extra: str) -> str:
    var s = "from rules.dosing import Settings\n\nstruct Pump:\n    settings: Settings\n    delivered_today: int\n    invariant 0 <= self.delivered_today <= self.settings.daily_limit\n\n"
    s += "fn new_pump(s: Settings) -> Pump:\n    ensures result.delivered_today == 0\n    return Pump(settings=s, delivered_today=0)\n\n"
    s += "fn dose_for(p: Pump, reading: int) -> int:\n    ensures 0 <= result <= p.settings.max_bolus\n"
    if room:
        s += "    ensures p.delivered_today + result <= p.settings.daily_limit\n"
    s += "    if reading < 40 or reading > 600:\n        return 0\n    let s = p.settings\n"
    s += "    var q = (reading - s.target) * 1000 / s.sensitivity\n    if q < 0:\n        q = 0\n    if q > s.max_bolus:\n        q = s.max_bolus\n"
    if room:
        s += "    let room = s.daily_limit - p.delivered_today\n    if q > room:\n        q = room\n"
    return s + extra + "    return q\n"

test "rules are proven on every build":
    let d = scratch("rules")
    for sub in ["/src", "/rules"]:
        match os.make_dir(d + sub):
            case _:
                pass
    write(d + "/brine.toml", "[package]\nname = \"pump\"\n")
    write(d + "/rules/dosing.br", PUMP_SETTINGS)
    write(d + "/RULES.br", PUMP_RULES)
    let main = "from rules.dosing import Settings\nfrom pump import new_pump, dose_for\n\nfn main():\n    let s = Settings(target=110, sensitivity=50, max_bolus=10_000, daily_limit=60_000)\n    print(dose_for(new_pump(s), 260))\n"
    write(d + "/src/main.br", main)
    let pump = d + "/src/pump.br"
    # the bug the rules exist for: nothing stops a dose at the daily limit
    write(pump, pump_src(false, ""))
    let bug = brine(["check", d, "--json"])
    assert bug.code == 1, bug.all()
    assert diag_codes(bug) == ["W0003@RULES.br:1", "E0605@RULES.br:10"], bug.out
    let e = brine(["build", d]).err
    assert "rule \"a day's insulin never goes over the daily limit\" isn't proven, so nothing is built" in e, e
    let r = brine(["rules", d, "--json"])
    assert (
        r.code == 1 and "\"status\":\"not proven\"" in r.out and "\"done\":false" in r.out
    ), r.all()
    let rt = brine(["rules", d])
    assert "4 rules, 3 proven" in rt.out and "✗ not proven  a day's insulin" in rt.out, rt.all()
    # fixed: every rule is proven, and the program runs
    write(pump, pump_src(true, ""))
    let ok = brine(["run", d])
    assert ok.code == 0 and ok.out == "3000\n", ok.all()
    assert "Proven 4 rules from " in ok.err, ok.err
    assert "RULES.br; the 2 functions they cover can't stop the program" in ok.err, ok.err
    assert "4 rules not approved yet" in ok.err, ok.err
    # approval: then no warning, and every change to what was approved stops the build
    let ci = {"CI": "true"}
    let dev = {"CI": "false"}
    let a = brine(["rules", "approve", d])
    assert a.code == 0 and file_exists(d + "/RULES.lock"), a.all()
    let lock = text(d + "/RULES.lock")
    assert "rule " in lock and "file " in lock and "rules/dosing.br" in lock, lock
    assert diag_codes(brine(["check", d, "--json"])) == [], "approved rules warn"
    let done = brine(["rules", d])
    assert (
        done.code == 0 and "4 rules, 4 proven" in done.out and "done: yes" in done.out
    ), done.all()
    # comments and layout don't count as changes
    write(
        d + "/RULES.br",
        "# what the pump promises\n" + PUMP_RULES.replace(
            "p.settings.max_bolus\n",
            "p.settings.max_bolus   # one bolus\n"
        )
    )
    assert brine(["check", d]).code == 0
    # weakening a rule, or the definitions it uses: CI and release builds stop,
    # dev builds warn, so the owner can draft
    write(d + "/RULES.br", PUMP_RULES.replace("0 <= d <= p.settings.max_bolus", "0 <= d"))
    let weak = brine_env(["check", d, "--json"], ci)
    assert weak.code == 1 and diag_codes(weak) == ["E0613@RULES.br:4"], weak.out
    let draft = brine_env(["check", d, "--json"], dev)
    assert draft.code == 0 and diag_codes(draft) == ["E0613@RULES.br:4"], draft.out
    assert "\"severity\":\"warning\"" in draft.out, draft.out
    let rel = brine_env(["build", "--release", d], dev)
    assert rel.code == 1 and "error[E0613]" in rel.err, rel.all()
    let dev_run = brine_env(["run", d], dev)
    assert dev_run.code == 0 and "warning[E0613]" in dev_run.err, dev_run.all()
    let rep = brine_env(["rules", d], dev)
    assert rep.code == 1 and "release builds and CI fail" in rep.out, rep.all()
    write(d + "/RULES.br", PUMP_RULES)
    write(d + "/rules/dosing.br", PUMP_SETTINGS.replace("<= 25_000", "<= 250_000"))
    let vocab = brine_env(["check", d, "--json"], ci)
    assert diag_codes(vocab) == ["E0613@dosing.br:1"], vocab.out
    write(d + "/rules/dosing.br", PUMP_SETTINGS)
    # a removed rule; a new one only warns
    write(
        d + "/RULES.br",
        PUMP_RULES.replace("\nrule \"dosing has no effects\":\n    effects pump: none\n", "")
    )
    let gone = brine_env(["check", d], ci)
    assert (
        gone.code == 1 and "approved rule \"dosing has no effects\" is gone" in gone.err
    ), gone.all()
    # nor can the rules go away with their file, or be replaced by a closer one
    match os.remove_file(d + "/RULES.br"):
        case _:
            pass
    let none = brine_env(["check", d], ci)
    assert none.code == 1 and "E0613" in none.err and "approves 4 rules" in none.err, none.all()
    write(d + "/RULES.br", PUMP_RULES)
    write(d + "/src/RULES.br", "rule \"nothing\":\n    prove 1 == 1\n")
    let near = brine(["check", d])
    assert near.code == 1 and "a second RULES.br" in near.err, near.all()
    match os.remove_file(d + "/src/RULES.br"):
        case _:
            pass
    write(
        d + "/RULES.br",
        PUMP_RULES
        + "\nrule \"readings out of range give nothing\" for p: Pump:\n    let d = dose_for(p, 1000)\n    prove d == 0\n"
    )
    let fresh = brine(["check", d, "--json"])
    assert fresh.code == 1 and diag_codes(fresh) == [
        "W0003@RULES.br:1",
        "E0605@RULES.br:21"
    ], fresh.out
    write(d + "/RULES.br", PUMP_RULES)
    # code a rule covers can't stop the program, or do what its effects line forbids
    for case_ in [
        ("    assert reading != 300\n", "E0607@pump.br:26"),
        ("    if reading == 300:\n        panic(\"too much\")\n", "E0611@pump.br:27"),
        ("    if {1: 2}.get(reading).unwrap() == 3:\n        q = 0\n", "E0611@pump.br:26"),
        ("    print(q)\n", "E0612@RULES.br:17"),
        # (unless the prover shows it can't happen)
        ("    assert q >= 0\n", ""),
        ("    if q < 0:\n        panic(\"can't happen\")\n", "")
    ]:
        let (extra, want) = case_
        write(pump, pump_src(true, extra))
        let o = brine(["check", d, "--json"])
        let got = diag_codes(o)
        if want == "":
            assert o.code == 0 and got == [], f"{extra}: {o.all()}"
        else:
            assert o.code == 1 and got == [want], f"{extra}: {got}\n{o.out}"
    write(pump, pump_src(true, "    print(q)\n"))
    let eff = brine(["check", d]).err
    assert "dose_for" in eff and "print" in eff, eff
    write(pump, pump_src(true, ""))
    # the owner's views: plain English and a pull-request receipt
    let ex = brine(["rules", d, "--explain"])
    assert ex.code == 0 and "a day's insulin never goes over the daily limit" in ex.out, ex.all()
    let rc = brine(["rules", d, "--receipt"])
    assert rc.code == 0 and "RULES.br" in rc.out and "proven" in rc.out, rc.all()
    let js = brine(["rules", d, "--json"])
    assert (
        js.code == 0 and js.out.count("\"status\":\"proven\"") == 4 and "\"done\":true" in js.out
    ), js.all()
    # `brine test` doesn't run rules
    assert brine(["test", d]).code == 0

test "rules next to a main file, outside a project":
    let d = scratch("folder-rules")
    write(
        d + "/lib.br",
        "fn twice(x: int) -> int:\n    if x > 1000 or x < -1000:\n        return 0\n    return 2 * x\n"
    )
    write(d + "/main.br", "import lib\n\nfn main():\n    print(lib.twice(2))\n")
    write(d + "/RULES.br", "rule \"lib is pure\":\n    effects lib: none\n")
    match os.set_cwd(d):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    # `brine check main.br` applies them, so `brine rules approve` finds them too
    assert "W0003" in brine(["check", "main.br"]).err
    let a = brine(["rules", "approve"])
    assert a.code == 0 and file_exists("RULES.lock"), a.all()
    assert "W0003" not in brine(["check", "main.br"]).err
    let r = brine(["rules"])
    assert r.code == 0 and "done: yes" in r.out, r.all()

test "rules are for the programs built from what they name":
    let d = scratch("scoped-rules")
    for sub in ["/src", "/repros", "/tools", "/tools/deep"]:
        match os.make_dir(d + sub):
            case _:
                pass
    write(d + "/brine.toml", "[package]\nname = \"scoped\"\n")
    write(
        d + "/src/lib.br",
        "fn twice(x: int) -> int:\n    if x > 1000 or x < -1000:\n        return 0\n    return 2 * x\n"
    )
    write(d + "/src/main.br", "import lib\n\nfn main():\n    print(lib.twice(2))\n")
    write(
        d + "/RULES.br",
        "rule \"main only prints\":\n    effects main: console\n\nrule \"lib is pure\":\n    effects lib: none\n"
    )
    # reads a file, which `main` may not: but these aren't the project's main file
    let reads = "fn main():\n    print(file_exists(\"RULES.br\"))\n"
    write(d + "/src/tool.br", reads)
    write(d + "/repros/x.br", reads)
    write(d + "/tools/deep/y.br", reads)
    let main = brine(["build", d])
    assert main.code == 0, main.all()
    assert "Proven 2 rules from " in main.err, main.err
    let tool = brine(["build", d + "/src/tool.br"])
    assert tool.code == 0, tool.all()
    assert (
        "2 rules from " in tool.err
        and "not checked: they are about modules this program doesn't use" in tool.err
    ), tool.err
    for f in ["/repros/x.br", "/tools/deep/y.br"]:
        let o = brine(["build", d + f])
        assert o.code == 0 and "RULES.br" not in o.err, o.all()
    let report = brine(["rules", d + "/src/tool.br"])
    assert (
        "- not used" in report.out and "every rule this program uses is proven" in report.out
    ), report.all()
    # the project's main file is still held to them, also from inside src/
    write(
        d + "/src/main.br",
        "import lib\n\nfn main():\n    print(file_exists(\"x\"), lib.twice(2))\n"
    )
    assert "E0612@" in " ".join(diag_codes(brine(["check", d, "--json"]))), "main isn't checked"
    match os.set_cwd(d + "/src"):
        case Ok(_):
            pass
        case Err(e):
            panic(e)
    let inside = brine(["check", "main.br"])
    assert inside.code == 1 and "E0612" in inside.err, inside.all()
    # a folder without a project: another main file next to RULES.br is its own program
    let f = scratch("scoped-folder")
    write(f + "/main.br", "fn main():\n    print(1)\n")
    write(f + "/other.br", reads)
    write(f + "/RULES.br", "rule \"main only prints\":\n    effects main: console\n")
    assert brine(["build", f + "/main.br"]).code == 0
    let other = brine(["build", f + "/other.br"])
    assert other.code == 0 and "not checked" in other.err, other.all()

test "rules read well to their owner":
    let d = scratch("rules-words")
    write(
        d + "/main.br",
        "fn half(x: u64) -> Option[u64]:\n    if x % 2 == 1:\n        return None\n    return Some(x / 2)\n\nfn main():\n    print(half(u64(4)).is_some())\n"
    )
    let header = "rule \"halves are never more than what they halve, for any of these three inputs\" for x: u64, y: f64, z: i32:"
    write(
        d + "/RULES.br",
        "from main import half\n\n"
        + header
        + "\n    match half(x):\n        case Some(h):\n            prove h <= x\n        case None:\n            pass\n"
    )
    # `fmt` keeps a long header whole: it has no brackets of its own to break in
    let f = brine(["fmt", d + "/RULES.br"])
    assert f.code == 0 and header + "\n" in text(d + "/RULES.br"), f.all() + text(d + "/RULES.br")
    let ex = brine(["rules", d + "/main.br", "--explain"])
    assert "(a u64) and every y (an f64) and every z (an i32)" in ex.out, ex.all()
    # an empty branch says so, and the closing sentence is about the whole rule
    assert (
        "     when half(x) is None:\n       nothing more is required.\n   Nothing this runs can stop the program." in ex.out
    ), ex.out
    # approving counts rules and vocabulary files apart
    let a = brine(["rules", "approve", d])
    assert "Approved 1 rule (1 new) and 1 vocabulary file (1 new)" in a.err, a.all()
    write(d + "/RULES.br", "from main import half\n")
    let b = brine(["rules", "approve", d])
    assert "Approved 0 rules (1 removed) and 1 vocabulary file (unchanged)" in b.err, b.all()

test "malformed rules":
    let d = scratch("bad-rules")
    write(d + "/lib.br", "fn twice(x: int) -> int:\n    return x + x\n")
    write(
        d + "/main.br",
        "import lib\n\nfn main():\n    print(lib.twice(2))\n\nrule \"not here\":\n    prove 1 == 1\n"
    )
    write(
        d + "/RULES.br",
        "import lib\n\nrule \"\":\n    prove 1 == 1\n\nrule \"a\":\n    prove 1 == 1\n\nrule \"a\":\n    prove 2 == 2\n\nrule \"empty\":\n    pass\n\nrule \"unknown\":\n    proven lib.thrice\n\nrule \"effects\":\n    effects lib: none, console\n    effects lib: disks\n"
    )
    let o = brine(["check", d + "/main.br", "--json"])
    assert o.code == 1, o.all()
    let got = [c for c in diag_codes(o) if c.starts_with("E")]
    assert got == [
        "E0610@main.br:6",
        "E0610@RULES.br:3",
        "E0610@RULES.br:9",
        "E0610@RULES.br:12",
        "E0610@RULES.br:16",
        "E0610@RULES.br:19",
        "E0610@RULES.br:20"
    ], "\n".join(got) + "\n" + o.out

# false claims the prover once accepted
test "proofs stay sound":
    assert (
        error_codes("tests/programs/proof_soundness.br")
        == [
            "E0601@15",
            "E0601@33",
            "E0601@48",
            "E0601@50",
            "E0605@53",
            "E0605@60",
            "E0605@65",
