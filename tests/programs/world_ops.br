# Collectives on every message type, element-wise reductions, any/all and the
# non-wrapping shift. Run with --ranks 4.
fn main():
    let r = world.rank()
    let p = world.size()
    let s = world.sum([r, 2 * r, 1])
    let m = world.max([float(r), -float(r)])
    let lo = world.min([10 - r, r])
    let any2 = world.any(r == 2)
    let all5 = world.all(r < 5)
    let all2 = world.all(r < 2)
    let bytes: [u8] = [u8(r), 255]
    let g = world.gather_all(bytes)
    let up = world.shift(r, 1, -1)
    let down = world.shift(f32(r) + f32(0.5), -1, f32(9.0))
    let big: i128 = i128(r) * i128(1000000000000) * i128(1000000000)
    let b = world.broadcast(p - 1, big)
    let x = world.exchange([i16(r * 100 + j) for j in 0..p])
    let ups = world.gather_all(up)
    let downs = world.gather_all(down)
    let xs = world.gather_all(x)
    let words = world.gather_all([f"r{r}", "x"])
    let flags = world.gather_all([r % 2 == 0])
    let i32s = world.broadcast(0, [i32(-7), i32(r)])
    if r == 0:
        print(s, m, lo, any2, all5, all2)
        print(g, b)
        print(ups, downs)
        print(xs)
        print(words, flags, i32s)
