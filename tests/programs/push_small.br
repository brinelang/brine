# Pushing and popping elements of one, two and three bytes (the runtime
# copies each in one store, or in a few that overlap).
struct Rgb:
    r: u8
    g: u8
    b: u8

fn main():
    var a: [u8] = []
    var h: [i16] = []
    var w: [u16] = []
    var f: [bool] = []
    var c: [Rgb] = []
    for i in 0..1000:
        a.push(u8(i % 256))
        h.push(i16(i - 500))
        w.push(u16(i * 60))
        f.push(i % 3 == 0)
        c.push(Rgb(r=u8(i % 256), g=u8((i * 7) % 256), b=u8((i * 13) % 256)))
    var s = 0
    for i in 0..1000:
        s += int(a[i]) + int(h[i]) + int(w[i]) + (1 if f[i] else 0)
        s += int(c[i].r) * 3 + int(c[i].g) * 5 + int(c[i].b) * 7
    print(len(a), len(h), len(w), len(f), len(c), s)
    let last = c.pop()
    print(a.pop(), h.pop(), w.pop(), f.pop(), last.r, last.g, last.b, len(c))
    print(a[0:4], h[0:3], w[998], c[998].b)
