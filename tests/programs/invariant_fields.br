struct Range:
    lo: int
    hi: int
    invariant self.lo <= self.hi

    fn set(ref self, lo: int, hi: int):
        requires lo <= hi
        self.lo = lo
        self.hi = hi

struct Box:
    r: Range
    n: int

# only the methods of `Range` change its fields
fn outside(ref r: Range, ref b: Box, ref rs: [Range]):
    r.lo = 5
    b.r.hi = 0
    bump(ref r.hi)
    rs[0].lo += 1
    b.n = 1
    b.r.set(0, 1)
    rs[0].set(1, 2)
    r = Range(lo=1, hi=2)

fn bump(ref x: int):
    x += 1

fn main():
    var r = Range(lo=0, hi=1)
    var b = Box(r=r, n=0)
    var rs = [r]
    outside(ref r, ref b, ref rs)
