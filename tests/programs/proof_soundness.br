# Each error here is a claim the prover once accepted: every one is false
# on some run, so it must be reported (see tests/integration.br).

# A `while` condition runs before every iteration: its effects are havocked.
fn step(ref xs: [int], ref i: int) -> bool:
    requires 0 <= i < len(xs)
    xs[i] = 1
    i += 1
    return true

fn while_cond():
    var xs = [0] * 3
    var i = 0
    var n = 0
    while step(ref xs, ref i):
        n += 1
        if n >= 6:
            break

struct Cursor:
    buf: [int]
    pos: int

    fn advance(ref self) -> bool:
        requires 0 <= self.pos < len(self.buf)
        self.buf[self.pos] = 1
        self.pos += 1
        return true

fn while_cond_self():
    var c = Cursor(buf=[0] * 3, pos=0)
    var n = 0
    while c.advance():
        n += 1
        if n >= 5:
            break

# A comprehension's body runs once per element.
fn step_n(ref xs: [int], ref i: int) -> int:
    requires 0 <= i < len(xs)
    xs[i] = 1
    i += 1
    return i

fn comprehension():
    var xs = [0] * 3
    var i = 0
    let ys = [step_n(ref xs, ref i) for k in 0..6]
    var j = 0
    let t = sum(step_n(ref xs, ref j) for k in 0..6)
    var zs = [1, 2, 3]
    let ws = [zs.pop() for k in 0..2]
    prove len(zs) == 2

# Every array method that changes the array changes what the prover knows
# (one function each: a failed claim is assumed afterwards).
fn m_clear():
    var a = [7] * 10
    a.clear()
    prove len(a) == 10

fn m_sort():
    var b = [3, 1, 2]
    b.sort()
    prove b[0] == 3

fn m_pop_at():
    var c = [1, 2, 3]
    c.pop(0)
    prove len(c) == 3

fn m_reverse():
    var d = [1, 2, 3]
    d.reverse()
    prove d[0] == 1

fn m_insert():
    var f = [1, 2, 3]
    f.insert(0, 9)
    prove len(f) == 3

fn m_extend(ys: [int]):
    var g = [1, 2, 3]
    g.extend(ys)
    prove len(g) == 3

fn m_nested():
    var h = [[1, 2], [3]]
    h[0].clear()
    prove len(h[0]) == 2

# Code that runs on some paths only changes the state on those paths.
fn c_ifelse(c: bool):
    var xs = [1, 2, 3]
    let v = xs.pop() if c else 0
    prove len(xs) == 2

fn c_and(c: bool):
    var ys = [1, 2, 3]
    if c and ys.pop() > 0:
        pass
    prove len(ys) == 2

fn c_or(c: bool):
    var ys = [1, 2, 3]
    if c or ys.pop() > 0:
        pass
    prove len(ys) == 2

fn c_chain(n: int):
    var xs = [1, 2, 3]
    let b = n < 0 < xs.pop()
    prove len(xs) == 2

# `xs[n]` is checked only when `n < 0`
fn c_chain_check(xs: [int], n: int):
    let b = n < 0 < xs[n]
    prove n < len(xs)

fn c_guard(k: int):
    var xs = [1, 2, 3]
    match k:
        case 1 if xs.pop() > 5:
            pass
        case _:
            prove len(xs) == 3

# An invariant about the element of `for v in xs` must hold for the next one.
fn elem_invariant() -> int:
    var x = 1
    for v in [0, 2, 4, 6]:
        invariant v < 4 or x == 1
        if v < 4:
            x = 0
    return x

# `ord` takes one character, which may be several bytes long.
fn ord_len(s: str) -> int:
    let c = ord(s)
    prove len(s) == 1
    return c

# lengths are bounded by memory, not by anything smaller
fn len_bound(xs: [int]):
    prove len(xs) < 1152921504606846976

# Bounds of `%`, bit operations, shifts and products are exact, not more.
fn b_mod(x: int, n: int):
    requires n != 0
    prove 0 <= x % n

fn b_mask(v: int):
    let b = v & 0xffffffff
    prove b >> 28 <= 14

fn b_shl_wraps(w: u64):
    prove w << 8 == w * 256

fn b_shl_wraps_int(v: int):
    prove v << 1 == 2 * v

fn b_shr(v: int, k: int):
    requires v >= 0 and 0 <= k < 64
    prove v >> k < v

fn b_or(a: int, b: int):
    requires a >= 0 and b >= 0
    prove a | b == a + b

fn b_sign(s: i32):
    prove s >> 31 == -1

fn b_top_bit(x: i64):
    prove x & 0x7fffffffffffffff < 9223372036854775807

fn b_product(i: int, j: int):
    requires -3 <= i <= 2 and -5 <= j <= 4
    prove i * j < 15

fn b_square(i: int):
    requires 0 <= i < 10
    prove i * i <= 80

# A loop local only moves one way when nothing else changes it.
fn l_zero_iterations(a: int, n: int):
    var b = a
    while b < n:
        b += 1
    prove b > a

fn l_both_ways(a: int, n: int, c: bool):
    var b = a
    var i = 0
    while i < n:
        i += 1
        if c:
            b += 1
        else:
            b -= 1
    prove b >= a

fn drop5(ref x: int):
    x -= 5

fn l_ref(a: int, n: int):
    var b = a
    var i = 0
    while i < n:
        i += 1
        b += 1
        drop5(ref b)
    prove b >= a

fn drop3(ref x: int) -> bool:
    x -= 3
    return x > 0

fn l_cond(a: int):
    var b = a
    while drop3(ref b):
        b += 1
    prove b >= a

fn l_reset(a: int, n: int, c: bool):
    var b = a
    var i = 0
    while i < n:
        i += 1
        b += 1
        if c:
            b = 0
    prove b >= a

# a write or a push makes elements no literal had
fn l_written():
    var ys = [4] * 3
    ys[0] = 7
    for y in ys:
        prove y == 4

fn l_pushed():
    var ys = [1, 2, 3]
    ys.push(10)
    for y in ys:
        prove y <= 3

# What a call or a loop changes in a struct: only the fields it writes stay
# unknown, so every way of writing one must count (calls of calls,
# recursion, `ref` arguments and aliases, replacing the whole value, elements).
struct HInner:
    a: [int]
    k: int

struct HBag:
    items: [int]
    count: int
    inner: HInner
    rows: [[int]]

    fn grow(ref self):
        self.items.push(1)

    fn via(ref self):
        self.grow()

    fn rec(ref self, n: int):
        if n > 0:
            self.rec(n - 1)
        else:
            self.items.push(1)

    fn mut_a(ref self, n: int):
        if n > 0:
            self.mut_b(n - 1)

    fn mut_b(ref self, n: int):
        self.count += 1
        self.mut_a(n)

    fn reset(ref self):
        self = HBag(items=[], count=0, inner=HInner(a=[], k=0), rows=[])

    fn via_arg(ref self):
        h_push(ref self.items)

    fn inner_k(ref self):
        h_set(ref self.inner)

    fn row_push(ref self, i: int):
        self.rows[i].push(1)

    fn alias(ref self):
        let d = ref self
        d.items.push(2)

fn h_push(ref xs: [int]):
    xs.push(1)

fn h_set(ref x: HInner):
    x.k += 1
    x.a.push(3)

fn h_calls(b0: HBag, n: int):
    var b = b0
    let m = len(b.items)
    b.via()
    prove len(b.items) == m

fn h_recursion(b0: HBag):
    var b = b0
    let m = len(b.items)
    b.rec(3)
    prove len(b.items) == m

fn h_mutual(b0: HBag):
    var b = b0
    let c = b.count
    b.mut_a(3)
    prove b.count == c

fn h_whole(b0: HBag):
    var b = b0
    let m = len(b.inner.a)
    b.reset()
    prove len(b.inner.a) == m

fn h_ref_arg(b0: HBag):
    var b = b0
    let m = len(b.items)
    b.via_arg()
    prove len(b.items) == m

fn h_nested_field(b0: HBag):
    var b = b0
    let m = len(b.inner.a)
    b.inner_k()
    prove len(b.inner.a) == m

fn h_element(b0: HBag):
    requires len(b0.rows) > 2
    var b = b0
    let m = len(b.rows[0])
    b.row_push(0)
    prove len(b.rows[0]) == m

fn h_alias(b0: HBag):
    var b = b0
    let m = len(b.items)
    b.alias()
    prove len(b.items) == m

fn h_ref_element(xs0: [[int]]):
    requires len(xs0) > 1
    var xs = xs0
    let m = len(xs[1])
    h_push(ref xs[1])
    prove len(xs[1]) == m

fn h_loop_elements(b0: HBag, v: int):
    requires len(b0.items) == 10
    var b = b0
    let x = b.items[3]
    for i in 0..10:
        b.items[i] = v
    prove b.items[3] == x

fn h_loop_tuple(t0: (int, int), n: int):
    var t = t0
    let a = t.0
    var i = 0
    while i < n:
        t.0 += 1
        i += 1
    prove t.0 == a

fn h_loop_calls(b0: HBag, n: int):
    var b = b0
    let c = b.count
    for i in 0..n:
        b.mut_b(2)
    prove b.count == c

fn h_loop_row(b0: HBag, n: int):
    requires len(b0.rows) > 2
    var b = b0
    let r = len(b.rows[1])
    for i in 0..n:
        b.rows[0].push(i)
    prove len(b.rows[1]) == r

fn main():
    while_cond()
    while_cond_self()
    comprehension()
    m_clear()
    m_sort()
    m_pop_at()
    m_reverse()
    m_insert()
    m_extend([4])
    m_nested()
    c_ifelse(true)
    c_and(true)
    c_or(false)
    c_chain(-1)
    c_chain_check([1], 0)
    c_guard(1)
    print(elem_invariant())
    print(ord_len("é"))
    len_bound([1])
    b_mod(1, 2)
    b_mask(1)
    b_shl_wraps(1)
    b_shl_wraps_int(1)
    b_shr(1, 0)
    b_or(1, 1)
    b_sign(1)
    b_top_bit(1)
    b_product(1, 1)
    b_square(1)
    l_zero_iterations(1, 0)
    l_both_ways(1, 1, false)
    l_ref(1, 1)
    l_cond(9)
    l_reset(1, 1, true)
    l_written()
    l_pushed()
    let hb = HBag(items=[1], count=0, inner=HInner(a=[], k=0), rows=[[1], [2], [3]])
    h_calls(hb, 1)
    h_recursion(hb)
    h_mutual(hb)
    h_whole(hb)
    h_ref_arg(hb)
    h_nested_field(hb)
    h_element(hb)
    h_alias(hb)
    h_ref_element([[1], [2]])
    h_loop_elements(HBag(items=[0] * 10, count=0, inner=HInner(a=[], k=0), rows=[]), 1)
    h_loop_tuple((1, 2), 1)
    h_loop_calls(hb, 1)
    h_loop_row(hb, 1)
