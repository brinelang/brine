# Each error here is a claim the prover once accepted: every one is false
# on some run, so it must be reported (see tests/integration.br).

# A `while` condition runs before every iteration: its effects are havocked.
fn step(ref xs: [int], ref i: int) -> bool:
    requires 0 <= i < len(xs)
    xs[i] = 1
    i += 1
    return true

fn while_cond():
    var xs = [0] * 3
    var i = 0
    var n = 0
    while step(ref xs, ref i):
        n += 1
        if n >= 6:
            break

struct Cursor:
    buf: [int]
    pos: int

    fn advance(ref self) -> bool:
        requires 0 <= self.pos < len(self.buf)
        self.buf[self.pos] = 1
        self.pos += 1
        return true

fn while_cond_self():
    var c = Cursor(buf=[0] * 3, pos=0)
    var n = 0
    while c.advance():
        n += 1
        if n >= 5:
            break

# A comprehension's body runs once per element.
fn step_n(ref xs: [int], ref i: int) -> int:
    requires 0 <= i < len(xs)
    xs[i] = 1
    i += 1
    return i

fn comprehension():
    var xs = [0] * 3
    var i = 0
    let ys = [step_n(ref xs, ref i) for k in 0..6]
    var j = 0
    let t = sum(step_n(ref xs, ref j) for k in 0..6)
    var zs = [1, 2, 3]
    let ws = [zs.pop() for k in 0..2]
    prove len(zs) == 2

# Every array method that changes the array changes what the prover knows
# (one function each: a failed claim is assumed afterwards).
fn m_clear():
    var a = [7] * 10
    a.clear()
    prove len(a) == 10

fn m_sort():
    var b = [3, 1, 2]
    b.sort()
    prove b[0] == 3

fn m_pop_at():
    var c = [1, 2, 3]
    c.pop(0)
    prove len(c) == 3

fn m_reverse():
    var d = [1, 2, 3]
    d.reverse()
    prove d[0] == 1

fn m_insert():
    var f = [1, 2, 3]
    f.insert(0, 9)
    prove len(f) == 3

fn m_extend(ys: [int]):
    var g = [1, 2, 3]
    g.extend(ys)
    prove len(g) == 3

fn m_nested():
    var h = [[1, 2], [3]]
    h[0].clear()
    prove len(h[0]) == 2

# Code that runs on some paths only changes the state on those paths.
fn c_ifelse(c: bool):
    var xs = [1, 2, 3]
    let v = xs.pop() if c else 0
    prove len(xs) == 2

fn c_and(c: bool):
    var ys = [1, 2, 3]
    if c and ys.pop() > 0:
        pass
    prove len(ys) == 2

fn c_or(c: bool):
    var ys = [1, 2, 3]
    if c or ys.pop() > 0:
        pass
    prove len(ys) == 2

fn c_chain(n: int):
    var xs = [1, 2, 3]
    let b = n < 0 < xs.pop()
    prove len(xs) == 2

# `xs[n]` is checked only when `n < 0`
fn c_chain_check(xs: [int], n: int):
    let b = n < 0 < xs[n]
    prove n < len(xs)

fn c_guard(k: int):
    var xs = [1, 2, 3]
    match k:
        case 1 if xs.pop() > 5:
            pass
        case _:
            prove len(xs) == 3

# An invariant about the element of `for v in xs` must hold for the next one.
fn elem_invariant() -> int:
    var x = 1
    for v in [0, 2, 4, 6]:
        invariant v < 4 or x == 1
        if v < 4:
            x = 0
    return x

# `ord` takes one character, which may be several bytes long.
fn ord_len(s: str) -> int:
    let c = ord(s)
    prove len(s) == 1
    return c

# lengths are bounded by memory, not by anything smaller
fn len_bound(xs: [int]):
    prove len(xs) < 1152921504606846976

# Bounds of `%`, bit operations, shifts and products are exact, not more.
fn b_mod(x: int, n: int):
    requires n != 0
    prove 0 <= x % n

fn b_mask(v: int):
    let b = v & 0xffffffff
    prove b >> 28 <= 14

fn b_shl_wraps(w: u64):
    prove w << 8 == w * 256

fn b_shl_wraps_int(v: int):
    prove v << 1 == 2 * v

fn b_shr(v: int, k: int):
    requires v >= 0 and 0 <= k < 64
    prove v >> k < v

fn b_or(a: int, b: int):
    requires a >= 0 and b >= 0
    prove a | b == a + b

fn b_sign(s: i32):
    prove s >> 31 == -1

fn b_top_bit(x: i64):
    prove x & 0x7fffffffffffffff < 9223372036854775807

fn b_product(i: int, j: int):
    requires -3 <= i <= 2 and -5 <= j <= 4
    prove i * j < 15

fn b_square(i: int):
    requires 0 <= i < 10
    prove i * i <= 80

fn main():
    while_cond()
    while_cond_self()
    comprehension()
    m_clear()
    m_sort()
    m_pop_at()
    m_reverse()
    m_insert()
    m_extend([4])
    m_nested()
    c_ifelse(true)
    c_and(true)
    c_or(false)
    c_chain(-1)
    c_chain_check([1], 0)
    c_guard(1)
    print(elem_invariant())
    print(ord_len("é"))
    len_bound([1])
    b_mod(1, 2)
    b_mask(1)
    b_shl_wraps(1)
    b_shl_wraps_int(1)
    b_shr(1, 0)
    b_or(1, 1)
    b_sign(1)
    b_top_bit(1)
    b_product(1, 1)
    b_square(1)
