struct P:
    x: int
    y: int

fn fib(n: int) -> int:
    var a = 0
    var b = 1
    for _ in 0..n:
        a, b = b, a + b
    return a

fn swap_ends(ref xs: [int]):
    let n = len(xs)
    xs[0], xs[n - 1] = xs[n - 1], xs[0]

fn divmod(a: int, b: int) -> (int, int):
    return (a / b, a % b)

fn main():
    print(fib(10))
    var xs = [1, 2, 3, 4]
    swap_ends(ref xs)
    print(xs)
    var p = P(x=1, y=2)
    p.x, p.y = p.y, p.x
    print(p.x, p.y)
    var q = 0
    var r = 0
    q, r = divmod(17, 5)
    print(q, r)
    var s: u8 = 0
    var t = "a"
    s, t = 200, "b"
    print(s, t)
    var a = 1
    var b = 2
    var c = 3
    (a, (b, c)) = (c, (a, b))
    print(a, b, c)
    q, _ = divmod(9, 2)
    print(q)
    var i = 1
    xs[i], xs[0] = xs[0], xs[i]
    print(xs)
