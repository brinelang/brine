# Release builds test once before `for j in lo..hi` that every `a[j + x]`
# (`x + j`, `j - x`, `j`) is in bounds and then run the loop without those
# checks; when the test fails the loop runs checked, as written.

fn window(a: [int], off: int, n: int) -> int:
    var t = 0
    for j in 0..n:
        t += a[j + off] * a[off + j] - a[j]
    return t

# the last indexes are out of bounds, but the loop stops before them
fn until_zero(a: [int], off: int) -> int:
    var t = 0
    for j in 0..len(a):
        if a[j + off] == 0:
            break
        t += a[j + off]
    return t

# `j - x` is negative at first: the guarded loop runs checked
fn lagged(a: [int], x: int) -> int:
    var t = 0
    for j in 0..len(a):
        if j >= x:
            t += a[j - x]
    return t

fn matmul(a: [f64], b: [f64], n: int) -> [f64]:
    var c = [0.0] * (n * n)
    for i in 0..n:
        for p in 0..n:
            let av = a[i * n + p]
            let brow = p * n
            let crow = i * n
            for j in 0..n:
                c[crow + j] += av * b[brow + j]
    return c

fn main():
    let a = [i * 3 % 7 for i in 0..20]
    print(window(a, 4, 16), window(a, 0, 0), window(a, 100, 0), window(a, -5, -3))
    print(until_zero([5, 4, 3, 0, 9], 1), until_zero([1, 2, 0], 0))
    print(lagged(a, 3), lagged(a, 0), lagged(a, 50))
    # offsets far out of range with an empty loop, or one that never reaches them
    let huge = 1 << 62
    print(window(a, huge, 0), window(a, -huge, 0))
    var t = 0
    for j in 0..2:
        if j > 5:
            t += a[j + huge] + a[j - huge]
    print(t)
    # inclusive ranges, and literal offsets
    var u = 0
    for j in 1..=18:
        u += a[j - 1] + a[j + 1] + a[j]
    print(u)
    # a loop that grows the array, or changes the offset, keeps its checks
    var g = [1, 2, 3]
    for j in 0..3:
        g.push(g[j] * 10)
    var off = 0
    var s = 0
    for j in 0..3:
        s += g[j + off]
        off += 1
    print(g, s)
    let n = 5
    let m = [float(i % 4) - 1.5 for i in 0..n * n]
    let c = matmul(m, m, n)
    var naive = [0.0] * (n * n)
    for i in 0..n:
        for j in 0..n:
            for p in 0..n:
                naive[i * n + j] += m[i * n + p] * m[p * n + j]
    print(c == naive, c[0], c[24])
