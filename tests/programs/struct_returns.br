# Small functions that return a struct or a tuple are inlined in native
# builds, and the copies of their results between slots become moves of the
# fields (opt.split_copies), so the values stay in registers. Mixed field
# sizes, padding, nested structs, strings and a slot that also goes to a call
# must all come out as the calls give them.
struct Roll:
    a: u32
    b: u32
    start: int
    k: int

fn roll(r: Roll, data: [u8]) -> Roll:
    let out = u32(data[r.start])
    var a = r.a.wrapping_sub(out)
    var b = r.b.wrapping_sub(u32(r.k & 0xffff).wrapping_mul(out))
    var k = r.k
    if r.start + r.k < len(data):
        a = a.wrapping_add(u32(data[r.start + r.k]))
        b = b.wrapping_add(a)
    else:
        k -= 1
    return Roll(a=a, b=b, start=r.start + 1, k=k)

fn g(a: u64, b: u64, c: u64, d: u64, x: u64) -> (u64, u64, u64, u64):
    let a1 = a.wrapping_add(b).wrapping_add(x)
    let d1 = (d ^ a1).rotate_right(32)
    let c1 = c.wrapping_add(d1)
    let b1 = (b ^ c1).rotate_right(24)
    return (a1, b1, c1, d1)

struct Mixed:
    tag: u8
    w: u16
    f: float
    on: bool
    n: i32

fn step(m: Mixed, i: int) -> Mixed:
    let t = m.tag ^ u8(i & 255)
    return Mixed(
        tag=t,
        w=m.w.wrapping_add(u16(t)),
        f=m.f * 0.5 + float(i),
        on=not m.on,
        n=m.n - i32(i)
    )

struct Pair:
    lo: Mixed
    hi: Mixed

fn swap(p: Pair) -> Pair:
    return Pair(lo=p.hi, hi=step(p.lo, 3))

struct Named:
    name: str
    n: int

fn rename(x: Named, i: int) -> Named:
    if i % 3 == 0:
        return Named(name=x.name + "!", n=x.n + 1)
    return Named(name=x.name, n=x.n * 2)

fn show(m: Mixed) -> str:
    return f"{m.tag} {m.w} {m.f} {m.on} {m.n}"

# not inlined (it loops and calls), so its struct goes through memory
fn keep(m: Mixed) -> Mixed:
    var x = m
    for i in 0..3:
        print(show(x))
        x = step(x, i)
    return x

fn main():
    var data = [u8(0)] * 5000
    for i in 0..len(data):
        data[i] = u8((i * 131 + (i >> 7)) & 255)
    var r = Roll(a=1, b=2, start=0, k=64)
    var acc = u32(0)
    while r.k > 0 and r.start + r.k < len(data):
        acc = acc ^ (r.a | (r.b << u32(16)))
        r = roll(r, data)
    print(acc, r.a, r.b, r.start, r.k)
    var a = u64(1)
    var b = u64(2)
    var c = u64(3)
    var d = u64(4)
    for i in 0..1000:
        a, b, c, d = g(a, b, c, d, u64(i))
    print(a, b, c, d)
    var m = Mixed(tag=7, w=65530, f=1.5, on=true, n=-3)
    for i in 0..10:
        m = step(m, i)
    print(show(m))
    var p = Pair(lo=m, hi=Mixed(tag=1, w=2, f=3.0, on=false, n=4))
    for _ in 0..5:
        p = swap(p)
    print(show(p.lo), "|", show(p.hi))
    var nm = Named(name="x", n=1)
    for i in 0..7:
        nm = rename(nm, i)
    print(nm.name, nm.n)
    var k = step(m, 1)
    k = keep(k)
    k = step(k, 2)
    print(show(k))
