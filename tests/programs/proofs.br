fn clamp(x: int, lo: int, hi: int) -> int:
    requires lo <= hi
    ensures lo <= result <= hi
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

fn binary_search(xs: [int], target: int) -> int:
    ensures -1 <= result < len(xs)
    var lo = 0
    var hi = len(xs)
    while lo < hi:
        invariant 0 <= lo <= hi <= len(xs)
        let mid = lo + (hi - lo) / 2
        if xs[mid] == target:
            return mid
        if xs[mid] < target:
            lo = mid + 1
        else:
            hi = mid
    return -1

fn sum_to(n: int) -> int:
    requires 0 <= n <= 1000
    ensures result >= 0
    var total = 0
    for i in 0..n:
        invariant 0 <= total <= i * 1000
        total += i
    return total

fn main():
    print(clamp(15, 0, 10))
    let xs = [1, 3, 5, 7, 9, 11]
    print(binary_search(xs, 7), binary_search(xs, 4))
    var out = [0] * 100
    for i in 0..len(out):
        out[i] = i * 2
    print(out[99], sum_to(10))
