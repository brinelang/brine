# str(float) is Python's repr: the shortest text that reads back as the same
# float. float(str) reads it back exactly. The expected output comes from
# Python (repr of the same arithmetic).
fn main():
    var tiny = 5e-324
    for i in 0..400:
        let f = float(i)
        let vals = [
            f * 0.37,
            f / 7.0,
            1.0 / (f + 1.0),
            f * 1e-310,
            f * f * f * 1e13,
            (f - 200.0) * 1e20,
            f * 0.001,
            tiny
        ]
        var line: [str] = []
        for v in vals:
            let s = str(v)
            assert float(s) == v, s
            line.push(s)
        print(" ".join(line))
        tiny = tiny * 3.0
    let z = 0.0
    let nan = z / z
    let inf = 1.0 / z
    print(
        nan,
        inf,
        -inf,
        -0.0,
        f"{nan:.3f}",
        f"[{nan:6.1f}]",
        f"{-inf:.2e}",
        f"{inf:f}",
        f"{f32(nan):.1f}"
    )
    print(float("1e400"), float("-1e400"), float(" 2.5"), float("2.5 "), float("+.5"), float("5."))
    print(float("123456789012345678901234567890"), float("0.1000000000000000055511151231257827"))
