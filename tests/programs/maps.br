struct Point:
    x: int
    y: int

enum Color:
    Red
    Green

fn count_words(text: [str]) -> {str: int}:
    var counts: {str: int} = {}
    for w in text:
        if w in counts:
            counts[w] += 1
        else:
            counts[w] = 1
    return counts

struct Index:
    names: {str: int}
    order: [str]

fn invert[K, V](m: {K: V}) -> {V: K}:
    var out: {V: K} = {}
    for k in m:
        out[m[k]] = k
    return out

fn add(ref ix: Index, name: str) -> int:
    if name in ix.names:
        return ix.names[name]
    let id = len(ix.order)
    ix.names[name] = id
    ix.order.push(name)
    return id

fn more():
    print(invert({"a": 1, "b": 2}))
    var ix = Index(names={}, order=[])
    let x1 = add(ref ix, "x")
    let y1 = add(ref ix, "y")
    print(x1, y1, add(ref ix, "x"))
    print(ix)
    let sq = {1: 1, 2: 4, 3: 9}
    let got = par [sq[i] for i in 1..4]
    print(got, ix == Index(names={"x": 0, "y": 1}, order=["x", "y"]))

fn main():
    let ages = {"ann": 31, "bob": 27}
    print(ages, len(ages), ages["bob"])
    var m = ages
    m["cy"] = 40
    m["ann"] = 32
    print(ages, m)
    print("bob" in m, "zed" in m, "zed" not in m)
    print(m.get("ann"), m.get("zed"), m.get("zed", -1))
    let gone = m.remove("bob")
    print(gone, m.remove("bob"))
    print(m)
    print(m.keys(), m.values(), m.items())
    for k in m:
        print(k, m[k])
        m[k + "!"] = 0
    print(m)
    let c = count_words(["a", "b", "a", "c", "a"])
    print(c)
    var grid: {(int, int): Point} = {}
    grid[(1, 2)] = Point(x=1, y=2)
    grid[(1, 2)].x = 10
    print(grid)
    var lists: {Color: [int]} = {Color.Red: [1]}
    lists[Color.Red].push(2)
    lists[Color.Green] = []
    print(lists)
    var big: {int: int} = {}
    for i in 0..1000:
        big[i] = i * i
    for i in 0..1000:
        if i % 3 != 0:
            big.remove(i)
    var total = 0
    for k in big:
        total += big[k]
    print(len(big), total, big[999])
    print({1: "a"} == {1: "a"}, {1: "a"} == {1: "b"}, 3 in [1, 2, 3], "ell" in "hello")
    let nested: {str: {str: int}} = {"a": {"x": 1}}
    print(nested["a"]["x"])
    let s = m.get("ann", 0) + m.get("cy").unwrap()
    print(s)
    more()
