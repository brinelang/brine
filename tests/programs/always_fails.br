# A check that fails every time it runs is an error (E0614), and the proofs
# after it still have to hold: `prove 1 == 2` is not vacuously true.
fn certain():
    let xs = [1, 2]
    prove len(xs) == 2
    print(xs[5])
    let d = 0
    print(10 / d)
    print(xs[-1])
    prove 1 == 2

# Code the prover already sees can't run is not reported.
fn after_panic(xs: [int]) -> int:
    if len(xs) == 0:
        panic("empty")
        return xs[0]
    return xs[0]

fn dead_branch() -> int:
    let xs = [1]
    let n = 1
    if n > 1:
        return xs[5]
    return xs[0]

fn unreachable_default(k: int) -> int:
    requires 0 <= k < 2
    let xs = [10, 20]
    match k:
        case 0:
            return xs[0]
        case 1:
            return xs[1]
        case _:
            return xs[2]

fn main():
    certain()
    print(after_panic([1]), dead_branch(), unreachable_default(1))
