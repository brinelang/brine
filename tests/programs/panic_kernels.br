fn relax(ref xs: [float], k: float):
    let n = len(xs)
    let q = float(12 / (n - 5))
    for i in 0..n:
        xs[i] = sqrt(xs[i] * xs[i] + k) / q

fn grow(ref xs: [float]):
    xs.insert(0, 0.0)

fn main():
    var a = [1.0, 2.0, 3.0, 4.0]
    relax(ref a, 0.5)
    print(a)
    # one more element: the kernel's length test fails and `relax` divides by zero
    var b = [1.0, 2.0, 3.0, 4.0]
    grow(ref b)
    relax(ref b, 0.5)
    print(b)
