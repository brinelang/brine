# Most iterations fail at once, on every thread: one panic is reported.
fn work(i: int, xs: [int]) -> int:
    var t = 0
    for k in 0..int("20000"):
        t += k % 7
    return t + xs[i]

fn main():
    print("before")
    let xs = [1, 2, 3]
    let r = par [work(i, xs) for i in 0..64]
    print(len(r))
