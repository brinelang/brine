# Rotates, 128-bit products cut back to 64 bits, and checked conversions and
# shifts: native release code makes them rol / ror, mul / umulh, and a compare
# with a branch to the panic.

fn rotl32(x: u32, n: int) -> u32:
    return x.rotate_left(n)

fn rotr32(x: u32, n: int) -> u32:
    return x.rotate_right(n)

fn rotl64(x: u64, n: int) -> u64:
    return x.rotate_left(n)

fn rotr64(x: u64, n: int) -> u64:
    return x.rotate_right(n)

# the same written out, with `|`, `^` and `+`
fn rol13(x: u64) -> u64:
    return (x << 13) | (x >> 51)

fn ror7(x: u32) -> u32:
    return (x >> 7) ^ (x << 25)

fn rol5(x: u32) -> u32:
    return (x << 5) + (x >> 27)

# not rotates: the counts don't add up to the width
fn not_rot(x: u32) -> u32:
    return (x << 5) | (x >> 26)

fn quarter(ref s: [u32], a: int, b: int, c: int, d: int):
    requires len(s) == 16
    requires 0 <= a < 16 and 0 <= b < 16 and 0 <= c < 16 and 0 <= d < 16
    s[a] = s[a].wrapping_add(s[b])
    s[d] = (s[d] ^ s[a]).rotate_left(16)
    s[c] = s[c].wrapping_add(s[d])
    s[b] = (s[b] ^ s[c]).rotate_left(12)
    s[a] = s[a].wrapping_add(s[b])
    s[d] = (s[d] ^ s[a]).rotate_left(8)
    s[c] = s[c].wrapping_add(s[d])
    s[b] = (s[b] ^ s[c]).rotate_left(7)

const M64: u128 = (1 << 64) - 1

fn mulhi(a: u64, b: u64) -> u64:
    return u64((u128(a).wrapping_mul(u128(b)) >> 64) & M64)

fn mullo(a: u64, b: u64) -> u64:
    return u64(u128(a).wrapping_mul(u128(b)) & M64)

fn smulhi(a: i64, b: i64) -> i64:
    return i64(i128(a).wrapping_mul(i128(b)) >> 64)

# unproven: checked at run time
fn to_u8(x: int) -> u8:
    return u8(x)

fn to_i8(x: int) -> i8:
    return i8(x)

fn to_i32(x: int) -> i32:
    return i32(x)

fn u_to_u16(x: u64) -> u16:
    return u16(x)

fn u_to_i64(x: u64) -> int:
    return int(x)

fn to_u64(x: int) -> u64:
    return u64(x)

fn i8_to_u32(x: i8) -> u32:
    return u32(x)

fn shl(x: u32, n: int) -> u32:
    return x << n

fn sar(x: i64, n: int) -> i64:
    return x >> n

fn main():
    var h: u64 = 0
    for n in -70..70:
        h = (
            h.wrapping_mul(31)
            .wrapping_add(u64(rotl32(0x80000001, n)))
            .wrapping_add(u64(rotr32(0x12345678, n)))
        )
        h ^= rotl64(0x8000000000000001, n) ^ rotr64(0x0123456789ABCDEF, n)
    print("rotates", h)
    print(rol13(0xF00000000000000F), ror7(0xFF), rol5(0x80000001), not_rot(0x80000001))
    var s = [u32(0)] * 16
    for i in 0..16:
        s[i] = u32(i * 0x01010101)
    for _ in 0..10:
        quarter(ref s, 0, 4, 8, 12)
        quarter(ref s, 1, 5, 9, 13)
    print("quarter", s[0], s[4], s[8], s[12], s[1])
    let big: u64 = 0xFFFFFFFFFFFFFFFF
    print("mulhi", mulhi(big, big), mulhi(0x9E3779B97F4A7C15, 12345), mulhi(0, big))
    print("mullo", mullo(big, big), mullo(0x9E3779B97F4A7C15, 12345))
    print(
        "smulhi",
        smulhi(-1, 1),
        smulhi(-9223372036854775807, 3),
        smulhi(123456789123, -987654321987)
    )
    var c = 0
    for x in 0..256:
        c += int(to_u8(x)) + int(to_i8(x - 128)) + int(to_i32(x * 1000000))
    print("convert", c, u_to_u16(65535), u_to_i64(9223372036854775807), to_u64(0), i8_to_u32(127))
    var t: u64 = 0
    for n in 0..32:
        t += u64(shl(0xFFFFFFFF, n))
    for n in 0..64:
        t += u64(sar(-1234567890123, n) & 0xFF)
    print("shifts", t)
