# 16 `elif`s, each with its own `if`: more cases than the prover keeps at
# their merge (v09#4). It used to say "nothing is known" about `i`.

fn f(b: [u8]) -> int:
    let n = len(b)
    var i = 0
    while i < n:
        invariant 0 <= i <= n
        let c = b[i]
        if c == 0:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 1:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 2:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 3:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 4:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 5:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 6:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 7:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 8:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 9:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 10:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 11:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 12:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 13:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 14:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        elif c == 15:
            i += 1
            if i < n and b[i] == 1:
                i += 1
        else:
            return -1
        prove 0 <= i <= n
    return i

fn main():
    print(f([u8(1), u8(2)]))
