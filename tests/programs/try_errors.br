fn number() -> Result[int, str]:
    return Ok(1)

fn count() -> Result[int, int]:
    return Ok(number()?)

fn plain() -> int:
    let n = number()?
    return n

fn first(xs: [int]) -> Option[int]:
    let n = 5?
    let ys = [number()? for x in xs]
    return Some(n)

fn main():
    print(count(), plain(), first([]))
