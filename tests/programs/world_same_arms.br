# Branches that differ between ranks but make the same `world` calls in the
# same order: every rank meets every other in each call (v091 §4). And code
# that runs only when there is one rank (v091 §7).
enum Cmd:
    Add(n: int)
    Scale(n: int)
    Stop

fn rank_cmd() -> Cmd:
    let r = world.rank()
    if r == 0:
        return Cmd.Add(1)
    elif r == 1:
        return Cmd.Scale(2)
    return Cmd.Stop

fn total(x: int) -> int:
    return world.sum(x)

fn both_return(r: int) -> int:
    if r == 0:
        return world.sum(10)
    else:
        return world.sum(1)

# with one rank there is nobody to agree with
fn all_ok(ok: bool) -> bool:
    if world.size() > 1:
        return world.all(ok)
    return ok

fn count(header: [str]) -> int:
    var n = 0
    for h in header:
        n += world.sum(len(h))
    return n

fn main():
    let r = world.rank()
    var out: [int] = []
    # the same call in both arms, with different values
    var t = 0
    if r == 0:
        t = world.sum(10)
    else:
        t = world.sum(1)
    out.push(t)
    # an elif chain, two calls in each arm
    if r == 0:
        out.push(world.sum(1) + world.max(r))
    elif r == 1:
        out.push(world.sum(2) + world.max(0))
    else:
        out.push(world.sum(3) + world.max(-1))
    # every case of a match, and a call of a function that communicates
    match rank_cmd():
        case Cmd.Add(k):
            out.push(total(k))
        case Cmd.Scale(k):
            out.push(world.sum(k * 10))
        case Cmd.Stop:
            out.push(total(0))
    # a loop with the same trip count in each arm
    var acc = 0
    if r % 2 == 0:
        for i in 0..3:
            acc += world.sum(i)
    else:
        for i in 0..3:
            acc += world.sum(i * 2)
    out.push(acc)
    # a conditional expression
    out.push(world.sum(1) if r == 0 else world.sum(r))
    # both arms return
    out.push(both_return(r))
    # an arm that panics may stop early
    if r < 100:
        out.push(world.sum(5))
    else:
        panic("no such rank")
    # the result of a collective is the same on every rank
    let ok = all_ok(r >= 0)
    if not ok:
        return
    let local = [f"rank{r}", "x"]
    let header = world.broadcast(0, local) if world.size() > 1 else local
    out.push(count(header))
    out.push(world.size())
    if r == 0:
        print(out)
