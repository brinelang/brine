# Reversals, rotations and copies of arrays kept as bytes (narrow.br), which
# release builds run 16 bytes at a time (idiom.br): every length up to 16 and
# past it, from every offset, as one hash per array length.

fn rev_test(n: int, i0: int, j0: int, seed: int) -> int:
    var a = [x for x in 0..n]
    for s in 0..n:
        let u = (s * 5 + seed) % n
        let t = a[u]
        a[u] = a[s]
        a[s] = t
    var i = i0
    var j = j0
    while i < j:
        let t = a[i]
        a[i] = a[j]
        a[j] = t
        i += 1
        j -= 1
    var o = 0
    for k in 0..n:
        o = (o * 31 + a[k] + 1) % 1000000007
    return (o * 31 + i) * 31 + j

fn rot_test(n: int, r: int, seed: int) -> int:
    var p = [x for x in 0..n]
    for s in 0..n:
        let u = (s * 3 + seed) % n
        let t = p[u]
        p[u] = p[s]
        p[s] = t
    let p0 = p[0]
    for i in 0..r:
        p[i] = p[i + 1]
    p[r] = p0
    var o = 0
    for k in 0..n:
        o = (o * 31 + p[k] + 1) % 1000000007
    return o

fn copy_test(n: int, m: int, seed: int) -> int:
    var a = [x for x in 0..n]
    var b = [9] * n
    for s in 0..n:
        let u = (s * 7 + seed) % n
        let t = a[u]
        a[u] = a[s]
        a[s] = t
    for i in 0..m:
        b[i] = a[i]
    var o = 0
    for k in 0..n:
        o = (o * 31 + b[k] + 1) % 1000000007
    return o

fn main():
    for n in [1, 2, 5, 8, 9, 15, 16, 17, 24, 40]:
        var h = 0
        for i0 in [-1, 0, 1, 3, 7, 8]:
            for j0 in [0, 1, 4, 7, 8, 9, 14, 15, 16, 22, n - 1]:
                if i0 < n and j0 < n and (i0 >= 0 or j0 <= i0):
                    h = (h * 7 + rev_test(n, i0, j0, n + i0)) % 1000000007
        for r in [0, 1, 2, 7, 8, 9, 14, 15, 16, 20, n - 1]:
            if r >= 0 and r < n:
                h = (h * 7 + rot_test(n, r, r + n)) % 1000000007
        for m in [0, 1, 7, 8, 9, 15, 16, 17, n]:
            if m <= n:
                h = (h * 7 + copy_test(n, m, m)) % 1000000007
        print(n, h)
