# A check that always fails (E0614) says which values make it fail, and what
# to do about that kind of check. Each `bad_` line is one; the `ok_` lines
# look alike but can pass, so they stay runtime checks.

fn bad_index():
    let xs = [1, 2, 3]
    print(xs[-1])
    print(xs[7])

fn bad_overflow():
    let a: i8 = 100
    let b: i8 = 100
    print(a + b)

fn bad_divide():
    let x = len(args())
    print(x / 0)
    print(x << 70)

fn bad_convert():
    let n = 300 + len(args())
    print(u8(n))

fn bad_text():
    print(int("abc"))
    print(int("1__0"))
    print({"a": 1} ["b"])
    let m = {"a": 1, "c": 2}
    print(m["b"])
    let o: Option[int] = None
    print(o.unwrap())

fn ok_text(c: bool):
    print(int(" -1_000 "), u8("+7"))
    let m = {"a": 1}
    print(m["a"])
    var w = {"a": 1}
    w["b"] = 2
    print(w["b"])
    var p: Option[int] = None
    if c:
        p = Some(1)
    print(p.unwrap())

fn main():
    bad_index()
    bad_overflow()
    bad_divide()
    bad_convert()
    bad_text()
    ok_text(true)
