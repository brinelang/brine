# Written types on every variable: this file passes `brine check --typed`.
struct Point:
    x: int
    y: int

fn bump(mut n: int) -> int:
    n += 1
    return n

fn main():
    let p: Point = Point(x=1, y=2)
    var total: int = 0
    for i: u8 in 0..3:
        total += int(i)
    for j: i64 in range(10, 0, -5):
        total += j
    var ages: {str: int} = {"ann": 31, "bob": 27}
    for name: str, age: int in ages.items():
        print(name, age)
    let (a, b): (int, str) = (p.x, "two")
    let squares: [int] = [k * k for k in 0..4]
    print(total, a, b, squares, bump(p.y))
