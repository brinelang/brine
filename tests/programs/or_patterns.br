enum Shape:
    Circle(r: int)
    Square(side: int)
    Rect(w: int, h: int)
    Dot

enum Tree:
    Leaf(v: int)
    Pair(a: int, b: int)

fn size(s: Shape) -> int:
    match s:
        case Shape.Circle(n) | Shape.Square(n):
            return n
        case Shape.Rect(w, h) | Shape.Rect(h=h, w=w):
            return w * h
        case Shape.Dot:
            return 0

fn first(t: (int, int)) -> int:
    match t:
        case (x, 0) | (0, x):
            return x
        case _:
            return -1

fn nested(o: Option[Tree]) -> int:
    match o:
        case Some(Tree.Leaf(v) | Tree.Pair(v, _)):
            return v
        case None:
            return -1

fn guarded(t: (int, int)) -> str:
    match t:
        case (x, _) | (_, x) if x > 5:
            return f"big {x}"
        case _:
            return "small"

fn main():
    print(size(Shape.Circle(3)), size(Shape.Square(4)), size(Shape.Rect(2, 5)), size(Shape.Dot))
    print(first((7, 0)), first((0, 8)), first((1, 1)))
    print(nested(Some(Tree.Leaf(1))), nested(Some(Tree.Pair(2, 3))), nested(None))
    print(guarded((1, 9)), guarded((6, 1)), guarded((1, 1)))
    var total = 0
    for s in [Shape.Circle(1), Shape.Square(2), Shape.Dot]:
        match s:
            case Shape.Circle(k) | Shape.Square(k):
                let twice = k * 2
                total += twice
            case _:
                pass
    print(total)
