struct Cursor:
    pos: int
    lim: int
    steps: int
    invariant 0 <= self.pos <= self.lim

    fn step(ref self) -> bool:
        if self.pos < self.lim:
            self.pos += 1
            return true
        return false

    # kept: only calls that prove it, and a field it doesn't read
    fn count(ref self):
        while self.step():
            self.steps += 1
        for _ in 0..3:
            reset(ref self)
            let _ = self.step()

    # a direct write in the loop can break it
    fn skip(ref self):
        while self.step():
            self.pos += 2

    # broken before the loop: not known at its head
    fn back(ref self):
        self.pos = -1
        while self.pos < 0:
            self.pos += 1
            let _ = self.step()

fn reset(ref c: Cursor):
    c.steps = 0

fn main():
    var c = Cursor(pos=0, lim=5, steps=0)
    c.count()
    c.skip()
    c.back()
    print(c.pos)
