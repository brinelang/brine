# Every operation here can stop the program, so `--proven` rejects each one
# (E0607); the ones after `# ok` are proven and pass.
fn head(s: str) -> str:
    if len(s) < 1:
        return ""
    return s[0:1]

fn parse_int(s: str) -> int:
    return int(s)

fn parse_float(s: str) -> float:
    return float(s)

fn find_from(s: str, k: int) -> Option[int]:
    return s.find("e", k)

fn index_from(xs: [int], k: int) -> Option[int]:
    return xs.index(3, k)

fn smallest(xs: [int]) -> int:
    return min(xs)

fn total(xs: [int]) -> int:
    return sum(xs)

fn first(s: str) -> int:
    return s.find("e").unwrap()

fn parts(s: str, sep: str) -> [str]:
    return s.split(sep)

# ok
fn whole(s: str) -> str:
    return s[0:len(s)]

fn find_start(s: str) -> Option[int]:
    return s.find("e", 0)

fn smallest_of_two(a: int, b: int) -> int:
    return min([a, b])

fn words(s: str) -> [str]:
    return s.split(" ")

fn main():
    print(head("é"), parse_int("1"), parse_float("1"), find_from("abc", 0))
    print(index_from([3], 0), smallest([1]), total([1]), first("e"), parts("a b", " "))
    print(whole("é"), find_start("e"), smallest_of_two(1, 2), words("a b"))
