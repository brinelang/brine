# Unpacking tuples in loops, `let` and comprehensions, nested or in parentheses.
fn pairs() -> [(int, (str, float))]:
    return [(1, ("a", 1.5)), (2, ("b", 2.5))]

fn main():
    let ps = [(1, "x"), (2, "y")]
    for (n, s) in ps:
        print(n, s)
    for i, (n, s) in enumerate(ps):
        print(i, n, s)
    for (n, (s, f)) in pairs():
        print(n + 1, s, f * 2.0)
    for k: int, (s: str, f: float) in pairs():
        print(k, s, f)
    let (a, (b, c)) = (1, ("two", 3.0))
    print(a, b, c)
    let x, (y, z) = (4, (5, 6))
    print(x + y + z)
    var (p, (q, r)): (int, (int, int)) = (7, (8, 9))
    q += 1
    print(p, q, r)
    print([s for _, (s, _) in pairs()], [n + i for i, (n, _) in enumerate(ps)])
    let m = {"k": (1, 2)}
    for key, (u, v) in m.items():
        print(key, u, v)
