# A local `[x] * n` (n a literal) that is only indexed, assigned at an index
# and measured lives in the stack frame. It must behave like any other array:
# a fresh one each time its `var` runs, one per call in recursion, and the
# arrays that do escape still on the heap.

fn walk(seed: int) -> int:
    var stack = [0] * 64
    var sp = 1
    stack[0] = seed
    var acc = 0
    var steps = 0
    while sp > 0 and steps < 20:
        sp -= 1
        let k = stack[sp]
        acc += k
        if sp < 62:
            stack[sp] = k / 2 + 1
            stack[sp + 1] = k / 3 + 1
            sp += 2
        steps += 1
    return acc

fn hist(xs: [int]) -> [int]:
    var counts = [0] * 8
    for x in xs:
        counts[x % 8] += 1
    # escapes: stays a heap array
    var out = [0] * 8
    for i in 0..len(counts):
        out[i] = counts[i]
    return out

fn depth(n: int) -> int:
    var mine = [n] * 4
    if n == 0:
        return mine[3]
    let below = depth(n - 1)
    mine[1] += below
    return mine[1] + mine[0]

fn kinds() -> str:
    var f = [0.5] * 5
    var nz = [-0.0] * 2
    var b = [true] * 3
    var small = [u8(7)] * 9
    var w = [i32(-3)] * 3
    var big: [i128] = [i128(1) << 100] * 2
    f[2] *= 3.0
    b[1] = false
    small[8] += 1
    w[0] -= 1
    big[1] += 1
    return f"{f[0]} {f[2]} {nz[1]} {b[0]} {b[1]} {small[0]} {small[8]} {w[0]} {w[2]} {big[0]} {big[1]} {len(f) + len(big)}"

# over 4 KB in all: the later arrays go on the heap
fn many() -> int:
    var a = [1] * 128
    var b = [2] * 128
    var c = [3] * 128
    var d = [4] * 128
    var e = [5] * 128
    a[0] += b[127]
    e[5] += d[3] + c[2]
    return a[0] + e[5] + len(e)

fn fresh() -> [int]:
    var seen: [int] = []
    for r in 0..3:
        var t = [r] * 3
        t[0] += 10
        seen.push(t[0] + t[1] + t[2])
    return seen

fn main():
    var a = 0
    for i in 0..1000:
        a += walk(i)
    print(a, walk(7), walk(1_000_000))
    print(hist([1, 2, 3, 9, 10, 17, 0, 8]))
    print(depth(5), depth(0))
    print(kinds())
    print(fresh(), many())
    # used whole: heap arrays as before
    var lst = [1] * 3
    lst.push(4)
    let copy = lst
    lst[0] = 9
    var it = [2] * 4
    var tot = 0
    for x in it:
        tot += x
    it[1] = 5
    print(lst, copy, tot, it, [3] * 2)
    var huge = [0] * 1000
    huge[999] = 1
    print(huge[999] + len(huge))
    # walk can run on a GPU
    var out = [0] * 3000
    par for i in 0..3000:
        out[i] = walk(i * 7)
    print(out[0], out[2999], sum(out))
