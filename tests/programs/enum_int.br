enum Color:
    Red
    Green
    Blue

enum Op:
    Add
    Sub

fn main():
    print(int(Color.Blue), u8(Color.Green), int(Op.Sub))
    for i in -1..4:
        match Color.from_int(i):
            case Some(c):
                print(i, c)
            case None:
                print(i, "none")
    let c = Color.from_int(2).unwrap()
    print(c == Color.Blue)
