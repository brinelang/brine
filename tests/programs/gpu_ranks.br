# A GPU-friendly reduction on every rank (tests: "ranks take one GPU each").
fn work(i: int) -> float:
    var x = float(i)
    for k in 0..200:
        x = x * 0.999 + 0.5
    return x

fn main():
    var t = 0.0
    for rep in 0..3:
        t += par sum(work(i + rep) for i in 0..1000000)
    let all = world.sum(t)
    if world.rank() == 0:
        print(all)
