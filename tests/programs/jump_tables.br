# Dev builds jump straight to the case of a `match` on dense integer
# constants or enum variants (a jump table): every case, guard, repeat and
# value outside the table must behave as the tests one by one would.

enum Op:
    Push
    Pop
    Add
    Sub
    Mul
    Jmp
    Halt

enum Node:
    Num(v: int)
    Neg(x: Node)
    Sum(l: Node, r: Node)
    Zero
    One

enum Small:
    A(v: int)
    B(s: str)
    C
    D(f: float)
    E

fn op_name(op: int) -> str:
    match op:
        case 0:
            return "zero"
        case 1:
            return "one"
        case 2:
            return "two"
        case 3:
            return "three"
        case 5:
            return "five"
        case 6:
            return "six"
        case _:
            return "other"

fn guarded(op: int, flag: bool) -> int:
    match op:
        case 10:
            return 100
        case 11 if flag:
            return 110
        case 12:
            return 120
        case 11:
            return 111
        case 13:
            return 130
        case 12:
            return -1
        case _:
            return 0

fn negs(x: i8) -> int:
    match x:
        case -3:
            return 1
        case -2:
            return 2
        case -1:
            return 3
        case 0:
            return 4
        case 1:
            return 5
        case _:
            return 6

fn bytes(b: u8) -> int:
    match b:
        case 250:
            return 1
        case 251:
            return 2
        case 252:
            return 3
        case 255:
            return 4
        case _:
            return 0

fn run(code: [Op]) -> int:
    var acc = 0
    for op in code:
        match op:
            case Op.Push:
                acc += 1
            case Op.Pop:
                acc -= 1
            case Op.Add:
                acc += 10
            case Op.Sub:
                acc -= 10
            case Op.Mul:
                acc *= 2
            case Op.Jmp:
                acc += 100
            case Op.Halt:
                return acc
    return acc

fn eval(n: Node) -> int:
    match n:
        case Node.Num(v):
            return v
        case Node.Neg(x):
            return -eval(x)
        case Node.Sum(l, r):
            return eval(l) + eval(r)
        case Node.Zero:
            return 0
        case Node.One:
            return 1

fn small(s: Small) -> str:
    match s:
        case Small.A(v):
            return f"a{v}"
        case Small.B(t):
            return "b" + t
        case Small.C:
            return "c"
        case Small.D(f):
            return f"d{f}"
        case Small.E:
            return "e"

# a body that starts with another match, and an or-pattern in the chain
fn nested(a: int, b: int) -> int:
    match a:
        case 0:
            match b:
                case 0:
                    return 1
                case 1:
                    return 2
                case 2:
                    return 3
                case 3:
                    return 4
                case _:
                    return 5
        case 1:
            return 10
        case 2 | 3:
            return 20
        case 4:
            return 30
        case 5:
            return 40
        case _:
            return 50

fn main():
    print([op_name(i) for i in -2..9])
    print([guarded(i, true) for i in 9..15], [guarded(i, false) for i in 9..15])
    print([negs(i8(i)) for i in -5..4])
    print([bytes(u8(i)) for i in 248..256])
    print(run([Op.Push, Op.Push, Op.Mul, Op.Add, Op.Sub, Op.Pop, Op.Jmp, Op.Halt, Op.Push]))
    let tree = Node.Sum(
        Node.Neg(Node.Num(7)),
        Node.Sum(Node.One, Node.Sum(Node.Zero, Node.Num(40)))
    )
    print(eval(tree))
    print([small(s) for s in [Small.E, Small.A(3), Small.D(1.5), Small.B("x"), Small.C]])
    var out: [int] = []
    for a in 0..7:
        for b in -1..5:
            out.push(nested(a, b))
    print(out)
