# In `par for i`, `xs[i] = step(xs[i])` moves xs[i] into step (no other
# iteration may touch it), so step changes it in place. Values shared with
# anything else must still be copied first.

struct State:
    data: [int]
    steps: int

    fn advanced(self, by: int) -> State:
        var t = self
        t.steps += by
        t.data[0] += by
        return t

fn step(s: State) -> State:
    var t = s
    t.data[t.steps % len(t.data)] += 1
    t.steps += 1
    return t

fn bump(xs: [int]) -> [int]:
    var ys = xs
    ys.push(len(ys))
    return ys

fn main():
    var xs = [State(data=[0] * 4, steps=i) for i in 0..8]
    let snap = xs
    let one = xs[2]
    for _ in 0..5:
        par for i in 0..8:
            xs[i] = step(xs[i])
    print(xs[0], xs[7])
    print(snap[0], snap[7], one)
    # the same element in every slot
    let s = State(data=[1, 2], steps=0)
    var ys = [s] * 6
    par for i in 0..6:
        ys[i] = step(ys[i])
    par for i in 0..6:
        ys[i] = ys[i].advanced(i)
    print(ys, s)
    # a place inside the element
    var zs = [State(data=[i], steps=0) for i in 0..4]
    let keep = zs[1].data
    for _ in 0..3:
        par for i in 0..4:
            zs[i].data = bump(zs[i].data)
    print(zs, keep)
    # nested arrays
    var ws: [[int]] = [[i] for i in 0..5]
    let w0 = ws
    par for i in 0..5:
        ws[i] = bump(ws[i])
    print(ws, w0)
