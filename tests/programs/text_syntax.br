# Multi-line strings, strings inside f-string fields, `test` and `case` as
# names, and a conditional expression as a `for` iterable.
const USAGE = """
usage:
  tool --verbose --out FILE
  tool --help"""

fn usage(name: str) -> str:
    return f"""
        {name}: a tool
          {name} --help   (prints "this")
        {{braces}} and {"long" if len(name) > 2 else "short"}
        """

fn main():
    print(USAGE)
    print(usage("tool"), end="")
    print("""one line""")
    print("""first
        second
    third""")
    print("""joined \
line""")
    print(len("""
"""))
    let d = {"k": 1}
    let xs = ["a", "b"]
    print(f"{d["k"]} {", ".join(xs)} {"x":>3} {'y'}")
    let test = 3
    var case = test + 1
    case += 1
    match case:
        case 5:
            print("case is", case, "and test is", test)
        case _:
            pass
    let short = true
    for x in [1, 2] if short else [3]:
        print(x)

test "test is still a keyword at the top level":
    assert len(USAGE) > 0
