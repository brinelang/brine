# Rotates of every unsigned width, by constant and variable counts, left and
# right, including counts of 0, the width, more and negative ones: native
# builds make one instruction of each (integration.br checks the IR), which
# must give what the shifts as written give.

fn l8(x: u8, n: int) -> u8:
    return x.rotate_left(n)

fn r8(x: u8, n: int) -> u8:
    return x.rotate_right(n)

fn l16(x: u16, n: int) -> u16:
    return x.rotate_left(n)

fn r16(x: u16, n: int) -> u16:
    return x.rotate_right(n)

fn l32(x: u32, n: int) -> u32:
    return x.rotate_left(n)

fn r32(x: u32, n: int) -> u32:
    return x.rotate_right(n)

fn l64(x: u64, n: int) -> u64:
    return x.rotate_left(n)

fn r64(x: u64, n: int) -> u64:
    return x.rotate_right(n)

fn k8(x: u8) -> u8:
    return x.rotate_left(3) ^ x.rotate_right(1)

fn k16(x: u16) -> u16:
    return x.rotate_right(5) ^ x.rotate_left(15)

fn main():
    let ns = [0, 1, 3, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, -1, -9, -33]
    var s8: [u8] = []
    var s16: [u16] = []
    var s32: [u32] = []
    var s64: [u64] = []
    for n in ns:
        s8.push(l8(0x81, n))
        s8.push(r8(0x81, n))
        s16.push(l16(0x8001, n))
        s16.push(r16(0xbeef, n))
        s32.push(l32(0x80000001, n))
        s32.push(r32(0x12345678, n))
        s64.push(l64(0x8000000000000001, n))
        s64.push(r64(0x9E3779B97F4A7C15, n))
    print(s8)
    print(s16)
    print(s32)
    print(s64)
    # in a loop, where the registers matter
    var a: u8 = 0x5a
    var b: u16 = 0xbeef
    var c: u32 = 7
    var d: u64 = 3
    for i in 0..1000:
        a = r8(a ^ u8(i & 255), i) ^ k8(a)
        b = l16(b ^ u16(i & 0xffff), i * 3) ^ k16(b)
        c = r32(c ^ u32(i), i * 7)
        d = r64(d ^ u64(i), i * 5)
    print(a, b, c, d)
