fn step(xs: [float], ref out: [float]) -> float:
    var worst = 0.0
    for i in 0..len(xs):
        out[i] = xs[i] * 0.5
        worst = max(worst, abs(out[i] - xs[i]))
    return world.max(worst)

fn halo(v: float) -> (float, float):
    let left = world.shift(v, 1)
    let right = world.shift(v, -1)
    return (left, right)

fn main():
    let rank = world.rank()
    var xs = [float(rank + 1)] * 10
    var out = [0.0] * 10
    var err = 1.0
    var iters = 0
    while err > 1e-6:
        err = step(xs, ref out)
        xs = out
        iters += 1
        if iters > 1000:
            break
    let (l, r) = halo(xs[0])
    if rank == 0:
        print(f"converged after {iters} iterations", l > 0.0 or r > 0.0)
    let n = world.broadcast(0, len(args()))
    for k in 0..n:
        world.barrier()
