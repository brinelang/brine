# Shifts where the facts can't all hold, so the range of the amount is empty:
# the prover crashed on `1 << lo` with such a range (0.9.2 before release).
# Each one's left side always overflows (E0614).

fn f(x: i16) -> i16:
    requires x <= i16(-20000)
    return (x + x if true else 0) << x

fn g(x: i16, y: i16) -> i16:
    requires x <= i16(-20000) and y >= 3 and y <= 5
    return (y if x > 0 else y) << (x + x if true else 0)

fn main():
    print(f(i16(-20000)))
    print(g(i16(-20000), 4))
