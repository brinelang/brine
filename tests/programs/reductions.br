# `par` reductions combine in a fixed order: leaves of 16 elements, each
# folded left to right, then a balanced tree over the leaves. These results
# pin that order (a sequential sum gives different bits).
fn main():
    let n = 100_003
    let xs = [float(i % 1000) * 0.001 - 0.3 for i in 0..n]
    print(par sum(x for x in xs), sum(x for x in xs))
    print(par sum(f32(x) for x in xs), sum(f32(x) for x in xs))
    print(par product(1.0 + x * 0.0001 for x in xs))
    # 1e16 + 1.0 rounds the 1.0 away: one by one they vanish, but the second
    # leaf adds up to 16.0 first
    let big = [1e16 if i == 0 else 1.0 for i in 0..32]
    print(par sum(x for x in big), sum(x for x in big))
    print(par min(x for x in xs), par max(x for x in xs))
    print(par min(x for x in xs if x > 0.5), par max(i for i in 0..n if i % 7 == 3))
    print(par sum(i for i in 0..n if i % 3 == 0), par sum(i32(i % 100) for i in 0..n))
    print(par product(i % 3 + 1 for i in 0..30))
    print(
        par any(x > 0.69 for x in xs),
        par all(x > -0.31 for x in xs),
        par any(x > 5.0 for x in xs)
    )
    print(par sum(x for x in xs if x > 100.0), par product(x for x in xs if x > 100.0))
    print(par sum(u8(i % 2) for i in 0..200), par sum(i128(i) * 1000000000000 for i in 0..n))
