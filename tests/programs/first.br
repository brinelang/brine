# first(...) and par first(...): the lowest-index Some, or None, whatever
# the thread count; par first stops chunks after one that found a value.
struct Hit:
    at: int
    name: str

fn hit(i: int) -> Option[int]:
    if i % 7 == 3 and i > 20:
        return Some(i * i)
    return None

fn named(i: int) -> Option[str]:
    return Some(f"n{i}") if i * i > 50 else None

fn find(xs: [int], v: int) -> Option[int]:
    return par first(Some(i) if xs[i] == v else None for i in 0..len(xs))

fn main():
    print(first(hit(i) for i in 0..100), par first(hit(i) for i in 0..100))
    print(first(hit(i) for i in 0..10), par first(hit(i) for i in 0..10))
    print(par first(hit(i) for i in 0..0))
    # many chunks, the value in the first
    print(par first(named(i) for i in 0..1000000))
    # filters
    print(first(named(i) for i in 0..20 if i % 2 == 1))
    print(par first(named(i) for i in 0..20 if i % 2 == 1))
    # over arrays, and arrays of options
    let words = ["a", "bb", "ccc", "dddd", "ee"]
    print(par first(Some(w) if len(w) > 2 else None for w in words))
    let opts: [Option[int]] = [None, Some(2), Some(3)]
    print(first(opts), first(named(i) for i in 0..3))
    # managed payloads
    let h = par first(Some(Hit(at=i, name=f"h{i}")) if i * 3 % 11 == 5 else None for i in 1..500)
    match h:
        case Some(x):
            print(x.at, x.name)
        case None:
            print("none")
    # the lowest index wins wherever the values are
    var xs: [int] = []
    for i in 0..5000:
        xs.push(i % 613)
    print(find(xs, 612), find(xs, 0), find(xs, 700))
    var total = 0
    for j in 1..300:
        match par first(Some(i) if i * j > 5000 else None for i in 0..10000):
            case Some(v):
                total += v
            case None:
                pass
    print(total)
    # inside a parallel body
    let firsts = par [par first(Some(k) if k * k >= i else None for k in 0..100) for i in 0..6]
    print(firsts)
