# Loops that write arrays check once, before the loop, that no other value
# shares them (integration.br counts the checks): also when the loop calls a
# function on numbers only, and when it passes the array itself by `ref` to a
# function that may grow or replace it (then the loop reloads it after the
# call). The values must be what checking at every write gives.

struct H:
    a: [int]
    b: [int]

    fn swap2(ref self, i: int, j: int):
        let x = self.a[i]
        self.a[i] = self.a[j]
        self.a[j] = x
        let y = self.b[i]
        self.b[i] = self.b[j]
        self.b[j] = y

# `%` by a variable is a call to the runtime, on numbers only
fn swaps(ref h: H, n: int):
    for i in 1..n:
        h.swap2(i, (i * 7) % (i / 2 + 1))

fn grow(ref st: [int], n: int):
    if len(st) < n:
        st.extend([0] * (n - len(st)))

# a constant array, which a write must copy first
fn reset(ref st: [int]):
    st = [1, 2, 3, 4, 5, 6, 7, 8]

fn stack(code: [int]) -> int:
    var st = [0] * 2
    var sp = 0
    var total = 0
    for op in code:
        if op == 0:
            if sp + 1 > len(st):
                grow(ref st, sp + 3)
            st[sp] = sp * 3 + total % 7
            sp += 1
        elif op == 1:
            let n = len(st)
            reset(ref st)
            sp = 1
            st[0] += 10
            total += n * 100 + len(st) + st[0]
        elif sp > 0:
            total += st[sp - 1]
    return total + st[0] + len(st)

# the call in an inner loop: the outer loop's arrays are reloaded too
fn nested(rows: int) -> [int]:
    var xs = [0]
    var ys = [5, 6]
    for r in 0..rows:
        for k in 0..r + 1:
            if k >= len(xs):
                grow(ref xs, k + 1)
            xs[k] += r
            ys[r % 2] += xs[k]
    xs.push(ys[0])
    xs.push(ys[1])
    return xs

fn main():
    let n = 2000
    var h = H(a=[i for i in 0..n], b=[i * 2 for i in 0..n])
    let keep = h.a
    swaps(ref h, n)
    print(h.a[0], h.a[1], h.a[n - 1], h.b[0], h.b[n - 1], keep[0], keep[n - 1])
    print(stack([0, 0, 0, 2, 0, 0, 1, 2, 0, 0, 0, 0, 0, 1, 2, 0, 2]))
    let c = [1, 2, 3, 4, 5, 6, 7, 8]
    print(c[0])
    print(nested(6))
