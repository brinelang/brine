# Float min and max: a NaN loses to a number, -0.0 is less than 0.0, and the
# answer is the same whether the loop is vectorized or not.
fn sign(x: float) -> str:
    if x != x:
        return "nan"
    if x == 0.0:
        return "-0" if 1.0 / x < 0.0 else "+0"
    return str(x)

fn main():
    let k = float(len(args()))
    let nan = sqrt(k * 0.0 - 1.0)
    let nz = -(k * 0.0)
    let vals = [nan, nz, 0.0, 1.0, -1.0, 2.5]
    var a: [float] = []
    var b: [float] = []
    for x in vals:
        for y in vals:
            a.push(x)
            b.push(y)
    var lo = [0.0] * len(a)
    var hi = [0.0] * len(a)
    for i in 0..len(a):
        lo[i] = min(a[i], b[i])
        hi[i] = max(a[i], b[i])
    for i in 0..len(a):
        print(sign(a[i]), sign(b[i]), "min", sign(lo[i]), "max", sign(hi[i]))
    var t = 1e30
    var u = -1e30
    for i in 0..len(a):
        t = min(t, a[i])
        u = max(u, b[i])
    print(t, u)
