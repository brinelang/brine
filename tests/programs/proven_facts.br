# Checks the prover removes: this file must pass `brine check --proven`
# (see tests/integration.br).

# true: at least as long as the prefix (bytes, since a `str` slice's
# character boundary check always stays)
fn strip_not(a: str) -> [u8]:
    let b = a.bytes()
    if a.starts_with("not:"):
        return b[4:]
    if a.ends_with("!!"):
        return b[:len(b) - 2]
    return b

# each element of `s.chars()` is one character
fn last_code(s: str) -> int:
    var n = 0
    for ch in s.chars():
        n = ord(ch)
    return n

# `s.bytes()` is as long as `s`
fn first_word(s: str) -> int:
    let b = s.bytes()
    var i = 0
    while i < len(b) and b[i] != 32:
        invariant 0 <= i <= len(b)
        i += 1
    return len(s.bytes()[0:i])

# the same `1 << root` in the check and in the invariant
struct T:
    table: [int]
    root: int
    invariant len(self.table) >= (1 << self.root)

fn make(root: int) -> Result[T, str]:
    let table = [0] * 8
    if root < 0 or root > 3:
        return Err("bad root")
    if len(table) < (1 << root):
        return Err("too small")
    return Ok(T(table=table, root=root))

# a pure call in the condition is the same value in the body
fn hexv(c: u8) -> int:
    ensures -1 <= result <= 15
    if c >= 48 and c <= 57:
        return int(c) - 48
    if c >= 97 and c <= 102:
        return int(c) - 87
    return -1

fn group(b: [u8]) -> int:
    var j = 0
    var v = 0
    while j < len(b) and hexv(b[j]) >= 0:
        invariant 0 <= j <= len(b)
        invariant 0 <= v <= 65535
        if v > 4095:
            return -1
        v = v * 16 + hexv(b[j])
        j += 1
    return v

# 128 bits: proven within 2^126 of zero
const BIG: i128 = 1_000_000_000_000_000_000_000_000_000_000_000_000

fn add128(a: i128, b: i128) -> i128:
    requires 0 <= a <= BIG and 0 <= b <= BIG
    ensures 0 <= result <= 2 * BIG
    return a.wrapping_add(b) + (-BIG / 10 + BIG / 10)

fn trim128(q: i128) -> i128:
    return q / 10

fn high(w: u128) -> u64:
    return u64(w >> 64)

# products: bounds through other facts, and products with a common factor
struct P:
    a: int
    b: int
    c: int
    invariant 1 <= self.a <= 255
    invariant 2 <= self.b <= 1 << 22
    invariant self.c == 4 * self.b

fn scaled(p: P, x: int) -> int:
    requires 0 <= x < p.a
    return p.a * p.c + x * p.b

fn index_of(x: int, y: int, w: int, h: int) -> int:
    requires 0 <= x < w <= 100000 and 0 <= y < h <= 100000
    ensures 0 <= result < w * h
    return y * w + x

fn main():
    print(
        len(strip_not("not:food")),
        len(strip_not("hey!!")),
        last_code("aé"),
        first_word("hello world")
    )
    print(make(3).is_ok(), group("ff0".bytes()))
    print(add128(1, 2), trim128(i128(120)), high(u128(1) << 70))
    print(scaled(P(a=3, b=4, c=16), 2), index_of(1, 1, 2, 2))
