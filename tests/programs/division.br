const C = -7 / 2

fn half(x: int) -> int:
    ensures 2 * result <= x
    ensures x <= 2 * result + 1
    return x / 2

fn neg_div(x: int) -> int:
    ensures result * -3 >= x
    return x / -3

fn main():
    let a = int("-7")
    let b = int("2")
    print(a / b, a % b, 7 / -2, 7 % -2, -7 / -2, -7 % -2, C, -7 % 2)
    print(a / 2, a % 2, half(-7), half(7), neg_div(7), neg_div(-7))
    print(-7.5 % 2.0, 7.5 % -2.0)
    let n = int("10")
    var xs = [0] * 5
    if n > 0:
        xs[n % 5] = 1
    print(xs)
    prove -7 / 2 == -4
