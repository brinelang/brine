struct Range:
    lo: int
    hi: int
    invariant self.lo <= self.hi

    fn widen(ref self, by: int):
        self.lo -= by
        self.hi += by

    # broken when used whole, and on return
    fn shift(ref self, by: int) -> Range:
        self.lo += by
        let copy = self
        return copy

    fn len(self) -> int:
        ensures result >= 0
        return self.hi - self.lo

struct Box:
    r: Range

fn bad() -> Range:
    return Range(lo=2, hi=1)

fn maybe(lo: int, hi: int) -> Range:
    return Range(lo=lo, hi=hi)

fn main():
    var r = Range(lo=0, hi=1)
    r.widen(1)
    print(r.len(), bad().len(), maybe(1, 2).len())
