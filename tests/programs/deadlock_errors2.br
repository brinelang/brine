# Each marked line must be rejected: some ranks could skip the communication.
struct Blk:
    rank: int
    px: int

fn set_ref(ref x: int):
    x = world.rank()

fn grow(ref xs: [int]):
    xs.push(world.rank())

fn quit_on(x: int):
    if x == 0:
        exit(0)

fn quit_on_rank0():
    if world.rank() == 0:
        exit(0)

fn pick() -> int:
    if world.rank() == 0:
        return 1
    return 2

fn early():
    if world.rank() == 0:
        return
    world.barrier()  # E0510

fn halo(b: Blk) -> float:
    return world.shift(1.0, b.px)

fn steps(t: (int, int)):
    for i in 0..t.1:
        world.barrier()

fn main():
    let r = world.rank()
    let ys = [world.sum(i) for i in 0..3 if r == 0]  # E0510
    let z = world.sum(1) if r == 0 else 0  # E0510
    for k in 0..3:
        if r == k:
            continue
        world.barrier()  # E0510
    var x = 0
    if r == 0:
        x = 1
    if x == 1:
        world.barrier()  # E0510
    var xs: [int] = []
    if r == 0:
        xs.push(1)
    for v in xs:
        world.barrier()  # E0510
    var b = Blk(rank=0, px=0)
    if r == 0:
        b.rank = 1
    if b.px == 0:
        world.barrier()
    if b.rank == 1:
        world.barrier()  # E0510
    var y = 0
    set_ref(ref y)
    if y == 0:
        world.barrier()  # E0510
    var zs: [int] = []
    grow(ref zs)
    for i in 0..len(zs):
        world.barrier()
    if zs[0] == 0:
        world.barrier()  # E0510
    if pick() == 1:
        world.barrier()  # E0510
    let o = Some(r)
    match o:
        case Some(3):
            world.barrier()  # E0510
        case _:
            pass
    let ib = world.exchange([r] * world.size())
    for q in ib:
        world.barrier()
        if q == 0:
            world.barrier()  # E0510
    let mine = [i for i in 0..10 if i % world.size() == r]
    for m in mine:
        world.barrier()  # E0510
    var w = 0
    while w < r:
        w += 1
    if w == 3:
        world.barrier()  # E0510
    var arr = [0, 0]
    arr[r] = 1
    if arr[0] == 1:
        world.barrier()  # E0510
    print(halo(Blk(rank=r, px=world.size())))
    print(halo(Blk(rank=0, px=r)))  # E0511
    steps((r, 3))
    steps((3, r))  # E0511
    var st = 0
    var it = 0
    while it < 3:
        it += 1
        if st == 1:
            world.barrier()  # E0510
        st = r
    early()
    quit_on(r)
    world.barrier()  # E0510
    print(ys, z)

fn main2():
    quit_on_rank0()
    world.barrier()  # E0510
    assert world.rank() != 1, f"partial sum {world.sum(1)}"  # E0510
    if write_file("x.txt", "hi").is_ok():
        world.barrier()  # E0510
    if os.pid() > 0 or clock() > 0.0:
        world.barrier()  # E0510
