# `par` constructs that can run on a GPU, and some that can't. The output
# must be the same with BRINE_GPU=off and BRINE_GPU=on (tests/integration.br).
struct Body:
    x: float
    y: float
    m: float

fn force(a: Body, b: Body) -> float:
    let dx = b.x - a.x
    let dy = b.y - a.y
    let d2 = dx * dx + dy * dy + 0.01
    return b.m / (d2 * sqrt(d2))

fn collatz(n: int) -> int:
    var k = n
    var steps = 0
    while k != 1:
        k = k / 2 if k % 2 == 0 else 3 * k + 1
        steps += 1
    return steps

fn mix(i: int) -> int:
    # floor division and remainder of negative numbers, shifts, abs, min, max
    let a = i - 5000
    return a / 7 + a % 7 * 3 + (a << 3) - (abs(a) >> 2) + min(a, 17) - max(a, -17)

fn main():
    let n = 10_000
    let xs = [float(i % 997) * 0.37 - 101.5 for i in 0..n]
    # maps
    let sq = par [x * x - 2.0 * x for x in xs]
    print(sq[0], sq[n - 1], sum(sq))
    let rt = par [sqrt(abs(x)) + floor(x) - ceil(x * 0.5) + round(x * 0.1) for x in xs]
    print(rt[3], rt[9_999], sum(rt))
    let mx = par [mix(i) for i in 0..n]
    print(mx[0], mx[4_999], mx[5_000], mx[n - 1], sum(mx))
    let small = par [i8(i % 200 - 100) for i in 0..n]
    print(small[0], small[150], sum(int(v) for v in small))
    let fl = par [f32(x) * f32(0.5) + f32(1) for x in xs]
    print(fl[0], fl[7], par sum(v for v in fl))
    let pairs = par [(i, float(i) * 0.5) for i in 0..n]
    print(pairs[3], pairs[n - 1])
    let flags = par [x > 0.0 and i % 3 != 0 for i, x in enumerate(xs)]
    print(flags[0], flags[300], par sum(1 for f in flags if f))
    # min and max: -0.0 is less than 0.0, and a NaN loses
    let zs = [0.0 if i % 2 == 0 else -0.0 for i in 0..n]
    let nan = zs[0] / zs[0]
    let mm = par [
        (min(z, zs[(i + 1) % n]), max(z, zs[(i + 1) % n]), min(nan, xs[i])) for i,
        z in enumerate(zs)
    ]
    let mf = par [max(f32(x), f32(nan)) for x in xs]
    print(mm[0], mm[1], mf[0], min(-0.0, 0.0), min(0.0, -0.0), max(-0.0, 0.0), max(0.0, -0.0))
    # conversions: float to int (checked), int to float, narrowing
    let cv = par [int(x * 3.0) + int(i32(i % 1000)) for i, x in enumerate(xs)]
    print(cv[0], cv[n - 1], sum(cv))
    let u = par [u16(i % 60000) * u16(1) + u16(7) for i in 0..n]
    print(u[0], u[n - 1])
    # loops and calls
    let cz = par [collatz(i + 1) for i in 0..n]
    print(cz[0], cz[26], max(cz))
    # par for, with structs and an array of arrays
    let bodies = [
        Body(x=float(i % 17), y=float(i % 23) * 0.5, m=1.0 + float(i % 5)) for i in 0..200
    ]
    var fx = [0.0] * len(bodies)
    par for i in 0..len(bodies):
        var f = 0.0
        for j in 0..len(bodies):
            if j != i:
                f += force(bodies[i], bodies[j])
        fx[i] = f
    print(fx[0], fx[199], sum(fx))
    let grid = [[float(r * 10 + c) for c in 0..10] for r in 0..50]
    var rows = [0.0] * 50
    par for r in 0..50:
        var t = 0.0
        for v in grid[r]:
            t += v * v
        rows[r] = t
    print(rows[0], rows[49])
    var hits = [0] * n
    par for i in range(0, n, 3):
        hits[i] = i * 2
    print(hits[0], hits[3], hits[4], sum(hits))
    var steps = [0] * n
    par for i in 0..n:
        steps[i] = steps[i] + collatz(i % 100 + 1)
    print(sum(steps))
    # reductions: every reducer, int and float kinds, filters
    print(par sum(x for x in xs), par product(1.0 + x * 0.00001 for x in xs))
    print(par min(x for x in xs), par max(x for x in xs), par min(x for x in xs if x > 3.3))
    print(par sum(f32(x) for x in xs), par min(f32(x) for x in xs), par max(f32(x) for x in xs))
    print(par sum(i * i for i in 0..n), par sum(i for i in 0..n if i % 7 == 2))
    print(par product(i % 2 + 1 for i in 0..60), par product(i32(i % 3 + 1) for i in 0..19))
    print(par min(i * 7 % 1000 - 300 for i in 0..n), par max(i * 7 % 1000 - 300 for i in 0..n))
    print(par sum(i8(i % 3) for i in 0..60), par sum(i16(i % 300) for i in 0..100))
    print(
        par sum(u8(i % 2) for i in 0..200),
        par sum(u32(i) for i in 0..n),
        par sum(u64(i) * u64(3) for i in 0..n)
    )
    print(par min(u8(i % 250 + 3) for i in 0..n), par max(i16(i % 1000 - 500) for i in 0..n))
    print(par any(x > 260.0 for x in xs), par any(x > 300.0 for x in xs))
    print(par all(x > -102.0 for x in xs), par all(x > -100.0 for x in xs))
    print(par sum(x for x in xs if x > 1000.0), par max(c for c in cz if c > 200))
    print(par sum(fx[i] * float(i) for i in 0..len(fx)), par sum(sum(r) for r in grid))
    # not on a GPU: strings, sin, a map
    let names = par [f"n{i}" for i in 0..10]
    print(names[9])
    print(par sum(sin(x) for x in xs) > 41.0)
    let m = {1: 2.0, 2: 3.0}
    print(par sum(m[i % 2 + 1] for i in 0..100))
    # Apple GPUs flush subnormal f32 values to zero, so these give up there and
    # run on the CPU: once in an element, once combining two normal sums
    let tiny = f32(1e-20)
    let sub = par [f32(i) * tiny * tiny for i in 0..n]
    print(sub[1] > f32(0), sub[n - 1])
    let edge = [f32(1.5e-38) if i == 0 else (f32(-1.4e-38) if i == 16 else f32(0)) for i in 0..32]
    print(par sum(v for v in edge) > f32(0))
    # f32 division and sqrt are exactly rounded on a GPU too: every element is
    # the CPU's
    let q = par [sqrt(f32(i) + f32(0.5)) / (f32(i % 89) * f32(1.37) + f32(3)) for i in 0..n]
    var differ = 0
    for i in 0..n:
        if q[i] != sqrt(f32(i) + f32(0.5)) / (f32(i % 89) * f32(1.37) + f32(3)):
            differ += 1
    print(q[1], q[n - 1], differ)
    let vs = [Body(x=float(i), y=1.0, m=2.0) for i in 0..1000]
    var sp = [0.0] * n
    par for i in 0..n:
        sp[i] = spread(vs, i % 1000)
    print(sp[7], sum(sp))
    # not on a GPU: its results are arrays
    let twos = par [[i, i + 1] for i in 0..10]
    print(twos[9])
    # strided writes: red-black sweeps in place, interleaved channels
    var rb = [0.0] * (2 * n + 2)
    for i in 0..len(rb):
        rb[i] = float(i % 17)
    for _ in 0..2:
        par for i in 0..n:
            rb[2 * i + 1] = 0.5 * (rb[2 * i] + rb[2 * i + 2])
        par for i in 1..n + 1:
            rb[2 * i] = 0.5 * (rb[2 * i - 1] + rb[2 * i + 1])
    print(rb[1], rb[1001], sum(rb))
    var rgb = [0] * (3 * n)
    par for i in 0..n:
        rgb[3 * i] = i
        rgb[i * 3 + 1] = 2 * i
        rgb[2 + 3 * i] = rgb[3 * i] + rgb[3 * i + 1]
    print(rgb[3 * 777], rgb[3 * 777 + 2], sum(rgb))
    var shifted = [0] * (n + 1)
    par for i in 0..n:
        shifted[i + 1] = i
    print(shifted[n], sum(shifted))

fn badd(a: Body, b: Body) -> Body:
    return Body(x=a.x + b.x, y=a.y + b.y, m=a.m + b.m)

# many stack slots: slot numbers once looked like vregs holding a global
fn spread(bs: [Body], i: int) -> float:
    var acc = bs[i]
    acc = badd(badd(acc, bs[i]), acc)
    acc = badd(badd(acc, bs[i]), acc)
    acc = badd(badd(acc, bs[i]), acc)
    acc = badd(badd(acc, bs[i]), acc)
    acc = badd(badd(acc, bs[i]), acc)
    return acc.x + acc.m
