# `exit` waits for the other ranks, like returning from `main`: rank 1 leaves
# early, after its last communication. With an argument, the others exit(3).
fn main():
    let total = world.sum(world.rank())
    if world.rank() == 1:
        exit(0)
    var acc = 0
    for i in 0..200_000:
        acc += i % 7
    if world.rank() == 0:
        print("total", total, acc > 0)
    if len(args()) > 0:
        exit(3)
