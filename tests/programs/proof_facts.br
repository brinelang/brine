# Facts the prover knows (each `prove` must hold; see tests/integration.br).

# array methods change lengths exactly
fn methods(ys: [int]) -> int:
    var a = [7] * 10
    a.clear()
    prove len(a) == 0
    var b = [3, 1, 2]
    b.sort()
    prove len(b) == 3
    b.pop(0)
    prove len(b) == 2
    b.insert(1, 5)
    prove len(b) == 3
    b.extend(ys)
    prove len(b) == 3 + len(ys)
    b.reverse()
    return b[2]

fn main():
    print(methods([4]))
