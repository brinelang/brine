# Facts the prover knows (each `prove` must hold; see tests/integration.br).

# array methods change lengths exactly
fn methods(ys: [int]) -> int:
    var a = [7] * 10
    a.clear()
    prove len(a) == 0
    var b = [3, 1, 2]
    b.sort()
    prove len(b) == 3
    b.pop(0)
    prove len(b) == 2
    b.insert(1, 5)
    prove len(b) == 3
    b.extend(ys)
    prove len(b) == 3 + len(ys)
    b.reverse()
    return b[2]

struct Sized:
    n: int

    fn size(self) -> int:
        ensures result == self.n
        return self.n

# what a call on one side of `and`, `or` or `if`/`else` ensures holds there
fn branches(s: Sized, c: bool) -> int:
    if c and s.size() > 0:
        prove s.n > 0
    if c or s.size() > 1:
        if not c:
            prove s.n > 1
    let v = s.size() if c else 1
    if c:
        prove v == s.n
    var xs = [1, 2]
    let w = xs.pop() if c else 0
    if c:
        prove len(xs) == 1
    else:
        prove len(xs) == 2
    return v + w

# no length comes near 2^63, so arithmetic on indexes and lengths fits
fn lengths(xs: [int], i: int, s: str) -> int:
    requires 0 <= i < len(xs)
    var ys = xs
    ys.push(i)
    ys.extend(xs)
    prove 2 * len(ys) + 1 <= 9223372036854775807
    let t = s + s
    prove len(t) * 4 <= 9223372036854775807
    return 2 * i + 1

# `%`, bit operations and shifts, as runtime computes them
fn bits(x: int, n: int, w: u64, s: i32) -> int:
    requires n >= 1
    let r = x % n
    prove 0 <= r < n
    let a = x & 15
    prove 0 <= a <= 15
    let b = x & 0xffffffff
    let h = b >> 28
    prove 0 <= h <= 15
    let c = x & -16
    prove c <= x and x - c <= 15
    prove ~x == -x - 1
    prove ~w == 18446744073709551615 - w
    prove (w & 255) | (w & 65280) <= 65535
    prove (b << 8) + 1 == b * 256 + 1
    prove -1 <= s >> 31 <= 0
    return r + a + h + c

# products of bounded values are bounded
fn products(i: int, j: int, a: u32, b: u32) -> u64:
    requires 0 <= i < 10 and -5 <= j <= 4
    prove i * i <= 81
    prove -45 <= i * j <= 36
    prove i * j * 0 + j * j >= 0
    return u64(a) * u64(b) + u64(i)

# a local a loop only adds constants to never goes down; the elements of a
# literal array are between its least and greatest
fn loops(a: int, xs: [int]) -> int:
    var b = a
    var i = 0
    while i < len(xs) and xs[i] > 0:
        b += 1
        i += 1
    prove b >= a and i >= 0
    var d = a
    for x in xs:
        d -= 2
    prove d <= a
    var s = 0
    for v in [3, -2, 7]:
        prove -2 <= v <= 7
        s += v
    for y in [5] * len(xs):
        prove y == 5
    return b + d + s

# each `if/elif` merge keeps the variables it changes within the branches'
# hull, so six in a row don't multiply into cases
fn splits(xs: [int]) -> int:
    var b = 0
    var a0 = 0
    var a1 = 0
    var a2 = 0
    var a3 = 0
    var a4 = 0
    var a5 = 0
    for i in 0..len(xs):
        invariant 0 <= a0 <= i and 0 <= a1 <= i and 0 <= a2 <= i and 0 <= a3 <= i and 0 <= a4 <= i and 0 <= a5 <= i
        if xs[i] == 0:
            a0 = a0 + 1
        elif xs[i] > 0:
            b = min(b, a0)
        if xs[i] == 1:
            a1 = a1 + 1
        elif xs[i] > 1:
            b = min(b, a1)
        if xs[i] == 2:
            a2 = a2 + 1
        elif xs[i] > 2:
            b = min(b, a2)
        if xs[i] == 3:
            a3 = a3 + 1
        elif xs[i] > 3:
            b = min(b, a3)
        if xs[i] == 4:
            a4 = a4 + 1
        elif xs[i] > 4:
            b = min(b, a4)
        if xs[i] == 5:
            a5 = a5 + 1
        elif xs[i] > 5:
            b = min(b, a5)
    return b + a1 + a5

# an invariant with one case per iteration: each case fixes k and s
fn doubling() -> int:
    var s = 1
    for k in 0..6:
        invariant (
            k == 0 and s == 1
        ) or (k == 1 and s == 2) or (k == 2 and s == 4) or (k == 3 and s == 8) or (k == 4 and s == 16) or (k == 5 and s == 32) or (k == 6 and s == 64)
        s = s * 2
    return s

fn main():
    print(methods([4]))
    print(branches(Sized(n=3), true), branches(Sized(n=3), false))
    print(lengths([1, 2], 1, "ab"))
    print(bits(-7, 3, 12345, -3))
    print(products(3, -2, 4000000000, 4000000000))
    print(loops(1, [1, 2]))
    print(splits([1, 2, 1, 5]), doubling())
