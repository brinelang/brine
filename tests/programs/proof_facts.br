# Facts the prover knows (each `prove` must hold; see tests/integration.br).

# array methods change lengths exactly
fn methods(ys: [int]) -> int:
    var a = [7] * 10
    a.clear()
    prove len(a) == 0
    var b = [3, 1, 2]
    b.sort()
    prove len(b) == 3
    b.pop(0)
    prove len(b) == 2
    b.insert(1, 5)
    prove len(b) == 3
    b.extend(ys)
    prove len(b) == 3 + len(ys)
    b.reverse()
    return b[2]

struct Sized:
    n: int

    fn size(self) -> int:
        ensures result == self.n
        return self.n

# what a call on one side of `and`, `or` or `if`/`else` ensures holds there
fn branches(s: Sized, c: bool) -> int:
    if c and s.size() > 0:
        prove s.n > 0
    if c or s.size() > 1:
        if not c:
            prove s.n > 1
    let v = s.size() if c else 1
    if c:
        prove v == s.n
    var xs = [1, 2]
    let w = xs.pop() if c else 0
    if c:
        prove len(xs) == 1
    else:
        prove len(xs) == 2
    return v + w

# no length comes near 2^63, so arithmetic on indexes and lengths fits
fn lengths(xs: [int], i: int, s: str) -> int:
    requires 0 <= i < len(xs)
    var ys = xs
    ys.push(i)
    ys.extend(xs)
    prove 2 * len(ys) + 1 <= 9223372036854775807
    let t = s + s
    prove len(t) * 4 <= 9223372036854775807
    return 2 * i + 1

# `%`, bit operations and shifts, as runtime computes them
fn bits(x: int, n: int, w: u64, s: i32) -> int:
    requires n >= 1
    let r = x % n
    prove 0 <= r < n
    let a = x & 15
    prove 0 <= a <= 15
    let b = x & 0xffffffff
    let h = b >> 28
    prove 0 <= h <= 15
    let c = x & -16
    prove c <= x and x - c <= 15
    prove ~x == -x - 1
    prove ~w == 18446744073709551615 - w
    prove (w & 255) | (w & 65280) <= 65535
    prove (b << 8) + 1 == b * 256 + 1
    prove -1 <= s >> 31 <= 0
    return r + a + h + c

# products of bounded values are bounded
fn products(i: int, j: int, a: u32, b: u32) -> u64:
    requires 0 <= i < 10 and -5 <= j <= 4
    prove i * i <= 81
    prove -45 <= i * j <= 36
    prove i * j * 0 + j * j >= 0
    return u64(a) * u64(b) + u64(i)

fn main():
    print(methods([4]))
    print(branches(Sized(n=3), true), branches(Sized(n=3), false))
    print(lengths([1, 2], 1, "ab"))
    print(bits(-7, 3, 12345, -3))
    print(products(3, -2, 4000000000, 4000000000))
