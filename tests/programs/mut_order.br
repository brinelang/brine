struct Rng:
    s: int

    fn below(ref self, n: int) -> int:
        self.s = (self.s * 1103515245 + 12345) % 2147483648
        return self.s % n

struct Tape:
    vals: [int]

    fn push(ref self, v: int) -> int:
        self.vals.push(v)
        return len(self.vals) - 1

    fn add(ref self, a: int, b: int) -> int:
        return self.push(self.vals[a] + self.vals[b])

struct Solver:
    unsat: [int]
    rng: Rng
    t: Tape

    fn pick(ref self) -> int:
        return self.unsat[self.rng.below(len(self.unsat))]

fn twice(ref xs: [int], v: int):
    xs.push(v)
    xs.push(v)

struct A:
    x: [int]

    fn add(ref self, ref b: B):
        self.x.push(len(b.y))
        b.y.push(1)

struct B:
    y: [int]

fn both(ref a: A, ref b: B):
    a.x.push(1)
    b.y.push(2)

struct S:
    a: A
    b: B

    fn go(ref self):
        both(ref self.a, ref self.b)
        self.a.add(ref self.b)

fn disjoint():
    var s = S(a=A(x=[]), b=B(y=[]))
    s.go()
    both(ref s.a, ref s.b)
    print(s.b.y, s.a.x.pop(), len(s.b.y))
    print(s.a.x)

fn main():
    disjoint()
    var t = Tape(vals=[])
    let x = t.add(t.push(20), 0)
    let y = t.add(x, t.push(100))
    print(t.vals, x, y)
    var s = Solver(unsat=[5, 6, 7], rng=Rng(s=1), t=Tape(vals=[]))
    let a = s.pick()
    print(a, s.pick())
    var xs = [1, 2, 3]
    xs.push(xs.pop())
    xs.push(xs.pop() * 10)
    twice(ref xs, xs.pop())
    print(xs)
    s.t.push(s.rng.below(10) + len(s.unsat))
    s.t.push(s.t.push(4))
    print(s.t.vals)
