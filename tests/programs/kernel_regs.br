# A loop kernel with seven invariant floats: its two-step copy needs more
# registers, and the caller keeps the floats for the scalar tail.
fn poly(
    xs: [float],
    ref ys: [float],
    a: float,
    b: float,
    c: float,
    d: float,
    e: float,
    f: float,
    g: float
):
    for i in 0..len(xs):
        let x = xs[i]
        ys[i] = a + x * (b + x * (c + x * (d + x * (e + x * (f + x * g)))))

fn main():
    var xs: [float] = []
    for i in 0..103:
        xs.push(float(i) * 0.01)
    var ys = [0.0] * 103
    var total = 0.0
    for r in 0..3:
        let s = float(r)
        poly(xs, ref ys, 1.0 + s, 2.0, 3.0, 4.0 - s, 5.0, 6.0, 7.0 + s)
        for y in ys:
            total += y
    print(f"{total:.6f}")
