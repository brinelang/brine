const BASE = [3, 4, 5, 6, 7, 8, 9, 10]
const N = len(BASE)
const GRID = [[1, 2], [3, 4]]
const NAMES = ["zero", "one", "two"]
const ZEROS = [0] * 4
const K = 2
const DERIVED = [K, K * K, -K, 1 << K]
const BYTES: [u8] = [1, 2, 255]
const GREETING = "hi"
const ON = true

fn total(xs: [int]) -> int:
    var t = 0
    for x in xs:
        t += x
    return t

fn kind(s: str) -> int:
    match s:
        case GREETING:
            return 1
        case _:
            return 0

fn main():
    print(BASE[3], N, len(BASE), total(BASE))
    print(GRID[1][0], NAMES[2], ZEROS, DERIVED, BYTES)
    var copy = BASE
    copy[0] = 100
    print(copy[0], BASE[0])
    var acc = 0
    for i in 0..N:
        acc += BASE[i] * i
    print(acc)
    print(kind("hi"), kind("x"))
    match ON:
        case ON:
            print("on")
        case _:
            print("off")
    const_more()

const FL = [1.5, 2.5]
const F32S: [f32] = [0.5, 1]
const FLAGS = [true, false, true]
const I8S: [i8] = [-1, -128, 127]
const EMPTY: [int] = []

fn const_more():
    print(FL, F32S, FLAGS, I8S, EMPTY, len(EMPTY))
    var xs = FLAGS
    xs.push(false)
    xs[0] = false
    print(xs, FLAGS)
    var s = 0
    for _ in 0..100000:
        s += BASE[s % 8]
    print(s)
