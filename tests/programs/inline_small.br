# Dev builds copy small functions that call nothing into their callers: their
# results, early returns, local structs and checks must work as calls do.
struct P:
    x: int
    y: int

fn clamp(v: int, lo: int, hi: int) -> int:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

fn swap(p: P) -> P:
    return P(x=p.y, y=p.x)

fn dot(a: P, b: P) -> int:
    return a.x * b.x + a.y * b.y

fn wide(a: i128) -> i128:
    return a * a + 1

fn at(xs: [int], i: int) -> int:
    return xs[i]

fn sign(f: float) -> float:
    return 1.0 if f > 0.0 else (-1.0 if f < 0.0 else 0.0)

fn bump(ref n: int):
    n += 1

fn main():
    var t = 0
    for i in -5..15:
        t += clamp(i, 0, 9) * 3
        let p = swap(P(x=i, y=2 * i))
        t += dot(p, P(x=1, y=-1))
        clamp(i, 1, 2)
    print(t)
    print(wide(10_000_000_000), [sign(float(i) - 1.5) for i in 0..4])
    var n = 0
    for _ in 0..7:
        bump(ref n)
    print(n)
    let xs = [4, 5, 6]
    print(at(xs, 0) + at(xs, 2))
