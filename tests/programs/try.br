struct Config:
    name: str
    size: int

fn parse_int(s: str) -> Result[int, str]:
    if s == "" or not s.is_digit():
        return Err(f"not a number: {s}")
    return Ok(int(s))

fn parse_config(text: str) -> Result[Config, str]:
    let lines = text.lines()
    if len(lines) < 2:
        return Err("need two lines")
    let size = parse_int(lines[1])?
    return Ok(Config(name=lines[0], size=size * 2))

fn first_word(s: str) -> Option[str]:
    let ws = s.split()
    if len(ws) == 0:
        return None
    return Some(ws[0])

fn first_letters(a: str, b: str) -> Option[str]:
    let x = first_word(a)?
    let y = first_word(b)?
    return Some(x[0] + y[0])

fn total(parts: [str]) -> Result[int, str]:
    var sum = 0
    for p in parts:
        sum += parse_int(p.strip())?
    return Ok(sum)

fn main() -> Result[(), str]:
    print(parse_config("demo\n21"))
    print(parse_config("demo\nx1"))
    print(parse_config("demo"))
    print(first_letters("hello world", "brine"), first_letters("hi", "  "))
    print(total("1, 2, 3".split(",")), total("1, b, 3".split(",")))
    print(read_file("tests/programs/try.br")?.lines()[0])
    print(make("q", "12"), make("q", "zz"))
    print(pair("q", "1"), pair("q", "z"))
    return Ok(())

struct Rec:
    name: str
    tags: [str]
    size: int

fn num(s: str) -> Result[int, str]:
    if s.is_digit():
        return Ok(int(s))
    return Err("bad " + s)

fn make(a: str, b: str) -> Result[Rec, str]:
    let c = Rec(name=a + "!", tags=[a + "1", a + "2"], size=num(b)?)
    return Ok(c)

fn pair(a: str, b: str) -> Result[([str], int), str]:
    return Ok(([a + "x"], num(b)?))
