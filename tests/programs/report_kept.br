# The report says which proven checks still run.
#
# The prover knows c is in [-32768, 32767], so the bounds check on
# xs[c + 32768] and the i32(c) conversion check are both removed; the
# length check of `[0] * 65536` is proven but still runs.
fn f(xs: [int], v: int) -> i32:
    requires len(xs) == 65536
    let c = max(-32768, min(32767, v))
    let _ = xs[c + 32768]
    return i32(c)

fn g(v: int) -> u8:
    return u8(v & 255)

# A failed `assert` on purpose is allowed: the report says it always fails.
fn todo() -> int:
    assert false, "not written yet"
    return 0

fn main():
    print(f([0] * 65536, 70000), g(300))
