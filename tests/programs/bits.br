# Local `[bool]` arrays, which release builds keep as one bit per element
# (pack.br): every size around a 64-bit word, both fills, reads and writes in
# and out of loops.

fn primes(n: int) -> int:
    var sieve = [true] * (n + 1)
    sieve[0] = false
    if n >= 1:
        sieve[1] = false
    var i = 2
    while i * i <= n:
        if sieve[i]:
            var j = i * i
            while j <= n:
                sieve[j] = false
                j += i
        i += 1
    var count = 0
    for k in 0..len(sieve):
        if sieve[k]:
            count += 1
    return count

# sets every third element, flips some back, and describes the result
fn pattern(n: int, fill: bool) -> str:
    var a = [fill] * n
    for i in 0..n:
        if i % 3 == 0:
            a[i] = not fill
    if n > 64:
        a[64] = a[0]
        a[n - 1] = true
    var s = ""
    var ones = 0
    for i in 0..len(a):
        if a[i]:
            ones += 1
    s += f"{len(a)}:{ones}"
    if n > 0:
        s += " " + ("1" if a[0] else "0") + ("1" if a[n - 1] else "0")
    return s

# kept as bytes: the array is passed on
fn total(a: [bool]) -> int:
    var t = 0
    for x in a:
        if x:
            t += 1
    return t

fn main():
    print(primes(1), primes(2), primes(100), primes(100_000))
    for n in [0, 1, 63, 64, 65, 127, 128, 129, 200]:
        print(pattern(n, true), pattern(n, false))
    let b = [true] * 70
    print(total(b))
