# Dev builds keep short-lived values (made once, read before the next label)
# in registers they share: values live across calls, used as call
# arguments, or both, must come out the same as in the C builds.
struct V:
    x: float
    y: float
    z: float

fn fmin(a: float, b: float) -> float:
    return a if a < b else b

fn fmax(a: float, b: float) -> float:
    return a if a > b else b

fn slab(lo: V, hi: V, o: V, inv: V) -> float:
    var t0 = fmin((lo.x - o.x) * inv.x, (hi.x - o.x) * inv.x)
    var t1 = fmax((lo.x - o.x) * inv.x, (hi.x - o.x) * inv.x)
    t0 = fmax(t0, fmin((lo.y - o.y) * inv.y, (hi.y - o.y) * inv.y))
    t1 = fmin(t1, fmax((lo.y - o.y) * inv.y, (hi.y - o.y) * inv.y))
    t0 = fmax(t0, fmin((lo.z - o.z) * inv.z, (hi.z - o.z) * inv.z))
    t1 = fmin(t1, fmax((lo.z - o.z) * inv.z, (hi.z - o.z) * inv.z))
    return t0 if t1 >= fmax(t0, 0.0) else 1e30

fn mix(a: int, b: int) -> int:
    return (a * 31 + b) % 1000003

# many values alive across a call at once
fn wide(a: int, b: int, c: int) -> int:
    let p = a * 3 + b
    let q = b * 5 - c
    let r = c * 7 + a
    let s = p ^ q
    let t = mix(p, q) + mix(r, s)
    let u = p + q + r + s
    let x = float(p) * 0.5 + float(q) * 0.25
    let y = fmax(x, float(r)) - fmin(x, float(s))
    return t + u + int(y)

fn main():
    var s = 0.0
    for i in 0..200:
        s += slab(
            V(-1.0, -1.0, -1.0),
            V(1.0, 1.0, 1.0),
            V(float(i % 3), float(i % 5) * 0.25, -5.0),
            V(1e30, 1e30, 1.0)
        )
    print(f"{s:.6e}")
    var h = 0
    for i in 0..100:
        h = mix(h, wide(i, i * 2 - 50, 7 - i))
    print(h)
