# `let ws = a[i]` borrows a[i] until its last use (v091#13): a change of `a`
# after that must not copy a[i] (integration.br times it), and every value
# read through ws, or through what borrows from ws, must stay right when `a`
# changes later.

fn pushes(n: int) -> int:
    var a: [[int]] = [[]]
    for i in 0..n:
        let ws = a[0]
        if len(ws) == 0 or ws[len(ws) - 1] != i:
            a[0].push(i)
    return len(a[0])

# `e` borrows from `ws`, so ws (and a[0]) must live as long as e
fn nested() -> str:
    var a = [[[1, 2], [3, 4]], [[5]]]
    let ws = a[0]
    let e = ws[1]
    a[0] = [[9]]
    a[0][0].push(7)
    return f"{e} {a}"

fn reassigned() -> str:
    var a = [["x", "y"], ["z"]]
    var e = a[1][0]
    for _ in 0..2:
        let ws = a[0]
        e = ws[1]
    a[0] = ["gone"]
    return f"{e} {a}"

# the last use in a later condition, and in a block
fn elifs(k: int) -> str:
    var a = [[1, 2, 3], [4]]
    let ws = a[0]
    if k == 0:
        a[0] = []
    elif len(ws) > 2:
        a[0].push(len(ws))
    else:
        a[1].push(0)
    return f"{a}"

fn in_block(k: int) -> str:
    var a = [[1, 2, 3], [4]]
    let ws = a[0]
    if k > 0:
        a[0].push(10)
        a[1].push(ws[0] + len(ws))
    return f"{a} {ws}"

fn returned(k: int) -> [int]:
    var a = [[k, k + 1], [7]]
    let ws = a[0]
    if ws[0] > 5:
        return ws
    a[0] = [0]
    return a[0]

fn main():
    print(pushes(1000))
    print(nested())
    print(reassigned())
    print(elifs(0), elifs(1))
    print(in_block(0), in_block(1))
    print(returned(1), returned(9))
