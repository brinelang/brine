fn is_ident_start(c: str) -> bool:
    return c.is_alpha() or c == "_"

fn words(line: str) -> [str]:
    var out: [str] = []
    var i = 0
    while i < len(line):
        if is_ident_start(line[i]):
            let start = i
            while i < len(line) and (line[i].is_alnum() or line[i] == "_"):
                i += 1
            out.push(line[start:i])
        else:
            i += 1
    return out

fn main():
    let s = "hello, brine world"
    print(s[0], s[7:12], s[:5], s[13:], len(s[:]))
    print(s.find("brine"), s.find("zzz"), s.split(", "), "a b  c ".split())
    print("-".join(["a", "b", "c"]), s.starts_with("hell"), s.ends_with("x"))
    print("[" + "  pad \n".strip() + "]", "[" + "  x ".lstrip() + "]", "[" + "  x ".rstrip() + "]")
    print(s.replace("l", "L"), s.upper(), "MiXeD".lower(), "a\nb\r\nc\n".lines())
    print(
        "123".is_digit(),
        "12a".is_digit(),
        "".is_digit(),
        "abc".is_alpha(),
        " \t".is_space(),
        "a1".is_alnum()
    )
    print("banana".count("an"), "hé".bytes(), "hé!".chars(), "ab".repeat(3))
    print(ord("a"), ord("é"), chr(98), chr(233), chr(0x1F600))
    for c in "añb":
        print(c, len(c))
    print(words("let x_1 = foo(bar, 42)"))
    var xs = [5, 3, 9, 1]
    xs.insert(0, 7)
    xs.insert(len(xs), 0)
    let second = xs.pop(1)
    print(second, xs)
    xs.extend([10, 11])
    xs.extend(xs)
    print(xs)
    xs.sort()
    print(xs, xs.index(9), xs.index(42))
    xs.reverse()
    print(xs, xs[2:5])
    var names = ["cy", "ann", "bob"]
    names.sort()
    let copy = names
    names.clear()
    print(names, copy, len(names))
    var fs = [2.5, -1.0, 3.0]
    fs.sort()
    print(fs)
    for i, w in enumerate(["a", "b"]):
        print(i, w)
    for k, v in [("x", 1), ("y", 2)]:
        print(k + "=" + str(v))
    print(save(true), save(false))
    save(true).unwrap()
    contains()
    print_args()
    unicode()
    io()

fn contains():
    print("brine".contains("rin"), "brine".contains("x"), [1, 2].contains(2))

fn print_args():
    print("a", "b", sep="")
    print("no newline", end="")
    print(" then", 1, 2, sep="-", end="!\n")

fn unicode():
    print("straße ǅ é".upper(), "ΣΑ İ Ж".lower(), "ΟΔΟΣ ΟΔΟΣ.".lower())
    print("é日本".is_alpha(), "a1é".is_alnum(), "٣".is_digit(), "\u{a0}\u{3000}".is_space())
    print("[" + "\u{3000} x \u{a0}".strip() + "]", "a\u{2003}b".split())

fn save(ok: bool) -> Result[(), str]:
    if ok:
        return Ok(())
    return Err("disk full")

fn io():
    let path = "target/brine_strings_test.txt"
    print(write_file(path, "one\ntwo ✓\n"), file_exists(path), file_exists("target/brine-nope.txt"))
    match read_file(path):
        case Ok(text):
            print(text.lines())
        case Err(e):
            print("read failed:", e)
    print(read_file("target/brine-nope.txt").is_err(), getenv("BRINE_TEST_UNSET_VAR"))
    print(run(["brine-no-such-program-xyz"]), run([]))
