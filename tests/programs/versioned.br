# Release builds run loops whose integers stay small without overflow
# checks (ranges.br); the results must not change.
fn tri(i: int, j: int) -> int:
    let s = i + j
    return s * (s + 1) / 2 + i % 7 - -j

fn total(n: int, base: int) -> int:
    var t = 0
    for i in 0..n:
        for j in 0..n:
            t = t ^ tri(i + base, j)
    return t

fn main():
    print(total(100, 5))
    print(total(int("60"), int("-1000")))
    # too large for the check-free copy: the loop as written
    print(total(3, int("3000000000")))
