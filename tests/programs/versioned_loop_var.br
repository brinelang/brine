# A release build runs a loop in two copies when its integers may be large
# (ranges.br): the second copy must not reuse what the first loaded for the
# loop's own variable (v09#1: `s.v` read through the first copy's `s`).
struct SV:
    v: [float]

fn render(series: [SV], start: int, step: int, n: int) -> str:
    var parts: [str] = []
    for s in series:
        for k in 0..min(n, len(s.v)):
            parts.push(str(s.v[k]) + str(float(start + k * step) / 1000.0))
    return ";".join(parts)

# the same with the loop variable an array
fn sums(rows: [[int]], start: int, step: int) -> int:
    var t = 0
    for r in rows:
        for k in 0..len(r):
            t += r[k] + (start + k * step) % 1000
    return t

fn main():
    let s = SV(v=[1.0, 1.0])
    print(render([s], 1, 1, 2))
    print(render([s, SV(v=[2.5])], 4294967296, 1, 2))
    let rows = [[1, 2, 3], [4, 5]]
    print(sums(rows, 1, 1))
    print(sums(rows, 4294967296, 1))
