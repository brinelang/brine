struct Counter:
    n: int

    fn bump(ref self):
        self.n += 1

fn fill(ref xs: [int], v: int):
    for i in 0..len(xs):
        xs[i] = v

fn countdown(mut n: int) -> int:
    requires n >= 0
    ensures result == n
    let start = n
    var steps = 0
    while n > 0:
        invariant n >= 0
        invariant steps + n == start
        n -= 1
        steps += 1
    return steps

fn total(mut xs: [int]) -> int:
    xs.push(100)
    return sum(x for x in xs)

fn main():
    var data = [0] * 4
    fill(ref data, 7)
    let d = ref data
    d[0] = 1
    d.push(9)
    let d2 = ref d
    d2[1] = 2
    print(data, len(d), d2)
    let keep = [1, 2, 3]
    print(total(keep), keep)
    print(countdown(5))
    var c = Counter(n=0)
    let rc = ref c
    rc.bump()
    c.bump()
    print(c, rc.n)
