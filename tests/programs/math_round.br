# atan2 and hypot round correctly (v091#9: 0.9.1 was 1 ulp off on every
# input below), and give the same bits on every backend.

fn main():
    # (y, x, the correctly rounded atan2(y, x))
    let a = [
        (-20.757170762298756, -0.02600896669038415, -1.572049337302762),
        (-214.4623956986627, -2.0573084594207812e-17, -1.5707963267948966),
        (4.457288479820978e+152, 2.0850641275921753e+153, 0.2106023587593422),
        (-349.2315382838165, -172.03403041103584, -2.02851236306133),
        (293.46602914124867, -91.04564402169757, 1.8716232500537167),
        (-382.997942189541, -8.788463927084054, -1.5937388049328975),
        (-1.2409327234620481e-170, -5.371614539706941e-178, -1.5707963700818084),
        (-3.927587226493452e+109, 3.8306021476520145e+116, -1.0253184943523491e-07),
        (-142.42721230298844, -0.08059552147710072, -1.571362198383418),
        (1.298783461398411e-224, -4.012198137773405e-238, 1.5707963267949274),
        (266.0316638945236, -18.117976526809798, 1.6387959105681538),
        (-302.2231785378633, -2.9631673960681004e-15, -1.5707963267948966),
    ]
    for y, x, want in a:
        print(atan2(y, x), atan2(y, x) == want)
    # (x, y, the correctly rounded hypot(x, y))
    let h = [
        (38.74437414948977, -390.83401090862475, 392.74973024963197),
        (2.760068583607008e+211, -9.144200721968501e+216, 9.144200722010156e+216),
        (71.58460098319728, -62.982086587292656, 95.34725129133403),
        (-1.0537036046093236e+204, -2.7053413829514526e+211, 2.7053413829514545e+211),
        (-8.092237414018236e-87, 3.199964683594039e-87, 8.70195841986651e-87),
        (366.97175632340804, 283.1052080045487, 463.4833640362786),
        (-11.279576552115145, -231.92298624334643, 232.19711538954675),
        (-314.06325271227695, -255.0104632706616, 404.5566253094034),
        (0.0010746034299038531, 191.71096916111856, 191.71096916413032),
        (-3.331059136087164e+251, -9.760598969235611e+249, 3.3324888442924437e+251),
        (-285.2182635342808, -32.009801066985744, 287.00885912782985),
        (-129.2237426704496, -150.94156199615068, 198.70110922588324),
    ]
    for x, y, want in h:
        print(hypot(x, y), hypot(x, y) == want)
    # special values, as C99 gives them
    let inf = float("inf")
    let nan = float("nan")
    for y in [0.0, -0.0, 1.0, -1.0, inf, -inf]:
        print([atan2(y, x) for x in [0.0, -0.0, 1.0, -1.0, inf, -inf]])
    print(atan2(nan, 1.0), atan2(1.0, nan), atan2(1.0, 1.0), atan2(-2.0, -2.0))
    print(hypot(inf, nan), hypot(nan, -inf), hypot(nan, 1.0), hypot(3.0, 4.0), hypot(-0.0, 0.0))
    print(hypot(1.7976931348623157e308, 1.7976931348623157e308), hypot(5e-324, 5e-324))
    print(
        atan2(5e-324, 1.7976931348623157e308),
        atan2(1e-300, 1e300),
        atan2(f32(1), f32(3)),
        hypot(f32(1), f32(2))
    )
