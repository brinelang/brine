# Every rank calls `exit(3)`, rank 0 a moment after the others (as on a busy
# machine): `brine run` waits for it, instead of stopping it as if the first
# `exit(3)` were a failure the other ranks won't follow.
fn main():
    world.barrier()
    if world.rank() == 0:
        os.sleep(0.8)
        print("rank 0 got there too")
    exit(3)
