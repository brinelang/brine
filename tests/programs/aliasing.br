struct Acc:
    xs: [int]
    name: str

    fn add_all(ref self, ys: [int]):
        var i = 0
        while i < len(ys):
            self.xs.push(ys[i])
            i += 1

    fn rename(ref self, prefix: str, old: Acc):
        self.name = prefix + old.name
        self.xs.push(len(old.xs))

fn append_twice(ref xs: [int], ys: [int]):
    xs.extend(ys)
    xs.extend(ys)

fn take(ref xs: [int]) -> bool:
    return len(xs) > 0 and xs.pop() > 0

# `and`/`or`/`if-else` run their parts in order
fn ordered():
    var xs = [0, 5, 6]
    let first = take(ref xs) or take(ref xs)
    let size = len(xs) if take(ref xs) else -1
    print(first, size, xs)

fn main():
    var a = Acc(xs=[1, 2], name="a")
    a.add_all(a.xs)
    print(a.xs)
    a.rename("new-", a)
    print(a.name, a.xs)
    var v = [7]
    append_twice(ref v, v)
    print(v)
    ordered()
