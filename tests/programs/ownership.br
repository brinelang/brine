struct Item:
    name: str
    vals: [int]

fn find(items: [Item], key: str) -> Item:
    for it in items:
        let tmp = it.name + "!"
        if it.name == key:
            return it
    return Item(name="none", vals=[])

fn build(n: int) -> [Item]:
    var out: [Item] = []
    for i in 0..n:
        out.push(Item(name=f"item{i}", vals=[i] * i))
    return out

fn first_long(xs: [str]) -> str:
    var i = 0
    while i < len(xs):
        let s = xs[i] + xs[i]
        if len(s) > 4:
            return s
        i += 1
    return ""

fn main():
    var items = build(5)
    let found = find(items, "item3")
    print(found)
    items[3].name = "changed"
    items[3].vals[0] = 99
    print(found, items[3])
    var words = ["a", "bb", "ccc"]
    for w in words:
        words.push(w + "x")
        if len(words) > 4:
            break
    print(words, first_long(words))
    let pairs = [(i, str(i)) for i in 0..3]
    print(pairs)
    var t = (1, "one")
    let t2 = t
    print(t == t2, t2)
    let nested = [[str(i)] for i in 0..3]
    var copy = nested
    copy[0][0] = "zero"
    print(nested, copy)
    let ok = len(words) > 2 and words[0] + "q" == "aq"
    print(ok)
    let msg = f"{len(items)} items: {items[0].name}" if ok else "no"
    print(msg)
    print(found.vals, any(v > 2 for v in found.vals))
