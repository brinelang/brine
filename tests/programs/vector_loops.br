# Loops over arrays of floats that native release builds on x86-64 run
# several elements at a time (vloop.br). Every result must be what the loop
# does one element at a time, to the bit: remainders, short arrays, writes
# that a later element reads, sums, and integer math on the index.

fn axpy(ref y: [f64], a: f64, x: [f64], n: int):
    for j in 0..n:
        y[j] = y[j] + a * x[j]

fn scaled(ref z: [f64], x: [f64], y: [f64], s: f64, t: f64, n: int):
    for j in 0..n:
        z[j] = (x[j] - s) / t + y[j] * s

# each element reads one written `k` elements before it
fn chain(ref v: [f64], k: int, n: int):
    for j in 0..n:
        v[j + k] = v[j] * 0.5 + 1.0

# each element reads one `k` elements ahead, not written yet
fn ahead(ref v: [f64], k: int, n: int):
    for j in 0..n:
        v[j] = v[j + k] * 3.0 - 0.25

fn ramp(n: int, s: f64) -> [f64]:
    var v = [0.0] * n
    for i in 0..n:
        v[i] = f64(i) * s + 0.125
    return v

fn total(v: [f64]) -> f64:
    var t = 0.0
    for x in v:
        t += x
    return t

fn dot(x: [f64], y: [f64]) -> f64:
    var s = 0.0
    for j in 0..len(x):
        s += x[j] * y[j]
    return s

# two sums at once, one a difference and one a product
fn two_sums(x: [f64]) -> [f64]:
    var a = 0.0
    var p = 1.0
    for j in 0..len(x):
        a -= x[j] / 3.0
        p *= x[j] * 0.0625 + 0.75
    return [a, p]

# spectral norm's matrix times v, row i: integers from j, then a double
fn row(i: int, v: [f64]) -> f64:
    var s = 0.0
    for j in 0..len(v):
        let t = i + j
        s += 1.0 / f64(t * (t + 1) / 2 + i + 1) * v[j]
    return s

# integer math that goes negative: / rounds toward zero, >> rounds down
fn ints(ref z: [f64], k: int, n: int):
    for j in 0..n:
        let t = j - k
        z[j] = f64(t / 4) + f64((t * 3) >> 1) + f64((j & 7) | (t ^ 5)) * 0.5 + f64(t << 2)

fn main():
    var sums: [f64] = []
    for n in 0..11:
        var y = ramp(n, 0.75)
        axpy(ref y, 1.0 / 3.0, ramp(n, 1.5), n)
        sums.push(total(y))
    print(sums)

    var z = [0.0] * 13
    scaled(ref z, ramp(13, 0.3), ramp(13, 2.5), 0.7, 3.0, 13)
    print(z)

    for k in [1, 2, 3, 4, 5, 9]:
        var v = ramp(20, 1.0)
        chain(ref v, k, 20 - k)
        var w = ramp(20, 1.0)
        ahead(ref w, k, 20 - k)
        print(k, total(v), v[19], total(w), w[0])

    var dots: [f64] = []
    var two: [f64] = []
    var rows: [f64] = []
    for n in [0, 1, 7, 8, 9, 16, 17, 31]:
        let x = ramp(n, 0.1)
        dots.push(dot(x, ramp(n, 1.0 / 7.0)))
        two.extend(two_sums(x))
        rows.push(row(3, ramp(n, 0.5)))
    print(dots)
    print(two)
    print(rows)
    var zi = [0.0] * 21
    ints(ref zi, 10, 21)
    print(zi)
