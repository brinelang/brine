# `T(x)` converts to what a type parameter stands for, checked per use.
fn mean[E](xs: [E]) -> E:
    var s: E = 0
    for x in xs:
        s += x
    return s / E(len(xs))

fn low[T](x: u64) -> T:
    return T(x & 0xffff_ffff)

fn label[T](x: T) -> str:
    return str(x)

fn main():
    print(mean([f32(1), f32(2)]), mean([1.0, 2.0, 4.5]), mean([3, 4, 8]))
    let v: u32 = low(0x1_0000_0007)
    let w: u64 = low(9)
    print(v, w, label(v), label("s"))
