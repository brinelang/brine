# Loops that only look for a byte (or for one that isn't it): native release
# builds move the index to the first byte that ends them 16 bytes at a time
# (ssa.scans), then run the loop from there. Every start, length and place of
# the byte must give what the loop gives.

# proven in bounds: no checks left in the loop
fn find_while(b: [u8], lo: int, hi: int, c: u8) -> int:
    requires 0 <= lo
    requires hi <= len(b)
    var i = lo
    while i < hi:
        invariant lo <= i
        if b[i] == c:
            return i
        i += 1
    return -1

# with its bounds check: hi may be past the end when c comes first
fn find_for(b: [u8], lo: int, hi: int, c: u8) -> int:
    for i in lo..hi:
        if b[i] == c:
            return i
    return -1

# the first byte that isn't c
fn first_not(b: [u8], lo: int, c: u8) -> int:
    for i in lo..len(b):
        if b[i] != c:
            return i
    return -1

fn token_end(b: [u8], i: int, hi: int) -> int:
    var j = max(i, 0)
    let e = min(hi, len(b))
    while j < e and b[j] != 32:
        j += 1
    return j

fn skip_spaces(b: [u8], i: int, hi: int) -> int:
    var j = max(i, 0)
    let e = min(hi, len(b))
    while j < e and b[j] == 32:
        j += 1
    return j

fn by_index(b: [u8], c: u8, lo: int) -> int:
    match b.index(c, lo):
        case Some(k):
            return k
        case None:
            return -1

# the reference: the count it keeps makes it no scan
fn naive(b: [u8], lo: int, hi: int, c: u8, eq: bool) -> int:
    var i = lo
    var steps = 0
    while i < hi:
        if (b[i] == c) == eq:
            return i + steps * 0
        i += 1
        steps += 1
    return -1

fn main():
    var bad = 0
    var sum = 0
    var cases = 0
    for n in 0..72:
        for at in -1..n:
            # spaces with one 'x' at `at`, and the opposite
            var sp = [u8(32)] * n
            var xs = [u8(120)] * n
            if at >= 0:
                sp[at] = 120
                xs[at] = 32
            for lo in 0..n + 1:
                let want = naive(sp, lo, n, 120, true)
                let want_sp = naive(xs, lo, n, 32, true)
                let got = [
                    find_while(sp, lo, n, 120),
                    find_for(sp, lo, n, 120),
                    first_not(sp, lo, 32),
                    by_index(sp, 120, lo),
                    token_end(xs, lo, n),
                    skip_spaces(sp, lo, n)
                ]
                let exp = [
                    want,
                    want,
                    want,
                    want,
                    n if want_sp < 0 else want_sp,
                    n if want < 0 else want
                ]
                for k in 0..len(got):
                    cases += 1
                    sum += got[k] * (k + 1)
                    if got[k] != exp[k]:
                        bad += 1
                        if bad <= 5:
                            print(f"n={n} at={at} lo={lo} form {k}: {got[k]}, want {exp[k]}")
                # an end before the byte, and an end past the array's
                if at >= lo and at > 0:
                    cases += 1
                    if find_while(sp, lo, at, 120) != -1:
                        bad += 1
                    if find_for(sp, lo, n + 50, 120) != at:
                        bad += 1
    print(f"{cases} cases, {bad} wrong, checksum {sum}")
    # one long scan, and bytes from 128 up
    var big = [u8(7)] * 100_003
    big[99_999] = 200
    print(find_while(big, 3, len(big), 200), find_while(big, 3, 99_999, 200), first_not(big, 17, 7))
    print(token_end(big, 0, len(big)), skip_spaces(big, 0, len(big)), by_index(big, 255, 0))
