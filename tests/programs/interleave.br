# Loops that release builds run several iterations at a time (jam.br): each
# must print what it does one iteration at a time.

# escape times, with `break` out of a counted `while`
fn escapes(n: int, m: int) -> (int, int):
    var inside = 0
    var steps = 0
    for p in 0..n:
        let cr = 3.0 * float(p) / float(n) - 2.0
        let ci = float(p % 7) / 7.0 - 0.5
        var zr = 0.0
        var zi = 0.0
        var i = 0
        var out = false
        while i < m:
            let tr = zr * zr - zi * zi + cr
            zi = 2.0 * zr * zi + ci
            zr = tr
            if zr * zr + zi * zi > 4.0:
                out = true
                break
            i += 1
        if not out:
            inside += 1
        steps += i
    return (inside, steps)

# float sums (added in order), `continue`, `elif`, an inner `for`
fn sums(n: int) -> (float, int):
    var total = 0.0
    var odd = 0
    for k in 0..n:
        var s = 0.0
        for j in 0..k % 13:
            if j % 3 == 1:
                continue
            elif j % 3 == 2:
                s += 1.0 / float(j + 1)
            else:
                s -= sqrt(float(j))
        if k % 2 == 1:
            odd += 1
        total += s * 0.1
    return (total, odd)

# a division only some iterations may do, reads of an outer array, a range
# that starts below zero
fn guarded(a: [int]) -> float:
    var acc = 0.0
    for x in -3..len(a) - 3:
        var q = 0.0
        for t in 0..3:
            let d = x + t
            if d != 0:
                q += float(100 / d)
        if x >= 0:
            q += float(a[x])
        acc += q
    return acc

# products, a step of 2, a `while` with no `break`
fn mixed(n: int) -> int:
    var prod = 1
    var flips = 0
    for i in 0..n:
        var flip = false
        var c = 0
        while c < 20:
            if (i % 3 + c % 3) % 2 == 0:
                flip = not flip
            c += 2
        if flip:
            prod *= 3
        else:
            flips -= 1
    return prod + flips

fn main():
    for n in [0, 1, 3, 4, 5, 8, 103]:
        print(n, escapes(n, 60), sums(n), mixed(n % 40))
    var a: [int] = []
    for i in 0..37:
        a.push(i * i % 11)
    print(guarded(a))
