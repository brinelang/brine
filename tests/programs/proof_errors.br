fn clamp(x: int, lo: int, hi: int) -> int:
    requires lo <= hi
    ensures lo <= result <= hi
    if x < lo:
        return lo
    return x

fn get(xs: [int], i: int) -> int:
    requires 0 <= i < len(xs)
    return xs[i]

fn count(n: int) -> int:
    var k = 0
    while k < n:
        invariant k <= n
        k += 2
    return k

fn main():
    print(clamp(5, 10, 0))
    let xs = [1, 2, 3]
    print(get(xs, 3))
    let a = int("4")
    prove a > 0
