# `embed("path")` puts a file's contents into the program when it is compiled.
# The path is relative to the file that contains the call; "\r\n" becomes "\n".
import embed_data.reader

const TEXT = embed("embed_data/text.txt")

fn main():
    let t = embed("embed_data/text.txt")
    print(t == TEXT, len(t), len(t.lines()))
    print(t)
    print(reader.text() == t)
