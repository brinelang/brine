struct Pair[A, B]:
    first: A
    second: B

struct Point:
    x: int

fn first[T](xs: [T]) -> T:
    return xs[0]

fn make[T]() -> [T]:
    return []

fn bigger[T](a: T, b: T) -> bool:
    return a > b

