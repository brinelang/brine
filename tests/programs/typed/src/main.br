fn bump(mut n: int) -> int:
    n += 1
    return n

fn total(xs: [int]) -> int:
    var s = 0
    for x in xs:
        s += x
    return s

fn main():
    let a = 5
    let b: int = 6
    let (c, d) = (1, "x")
    let (e, f): (int, str) = (2, "y")
    var m = {"k": 1}
    for k, v in m.items():
        print(k, v)
    for k2: str, v2: int in m.items():
        print(k2, v2)
    for i: u8 in 0..3:
        print(i)
    for j in range(2):
        print(j)
    let _ = 3
    print(a, b, c, d, e, f, total([1]), bump(1), [x * 2 for x in [1, 2]])
