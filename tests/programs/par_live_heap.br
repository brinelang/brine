# `par` jobs that allocate blocks of 32-128 KB must not slow down while
# 500 MB made by an earlier `par` is alive (v091#12: 5-20x on Windows, where
# every thread shared the C library's heap; about 1x with a heap per thread).
# Prints the ratio's class, not the times: the two differ far beyond noise.
fn work(seed: int) -> [u8]:
    var out: [u8] = []
    for k in 0..2000:
        for b in f"{seed} {k} 0 obj << /Type /Page >> endobj".bytes():
            out.push(b)
    return out

fn kept_buf(i: int) -> [u8]:
    let tmp = work(i)
    return tmp[0:min(len(tmp), 50000)]

# the best of 3 runs of 2000 jobs
fn jobs() -> float:
    var best = 1.0e9
    for _ in 0..3:
        let t = clock()
        let r = par [len(work(i)) for i in 0..2000]
        best = min(best, clock() - t)
        assert sum(r) > 0
    return best

fn main():
    let before = jobs()
    let kept = par [kept_buf(i) for i in 0..10000]
    let after = jobs()
    print(len(kept), "kept:", "slower" if after > 3.0 * before + 0.02 else "about as fast")
