# Writes into arrays through `ref` and `self`: the copy-on-write check runs
# once per array before a loop, or once for several writes, and a copy made
# before still sees the old values.
struct H:
    a: [int]
    b: [[int]]

    fn swap(ref self, i: int, j: int):
        let x = self.a[i]
        self.a[i] = self.a[j]
        self.a[j] = x

    fn bump(ref self, i: int):
        self.a[i] += 1
        self.a[i] *= 2

fn spin(ref h: H, n: int, rounds: int):
    for r in 0..rounds:
        for i in 1..n:
            h.swap(i, (i * 7 + r) % i)

fn fill(ref xs: [int], v: int):
    for i in 0..len(xs):
        xs[i] = v + i

# a write before the loop, a copy in it: the loop must check again
fn copy_in_loop(ref xs: [int]) -> [[int]]:
    var out: [[int]] = []
    xs[0] = 100
    for i in 0..3:
        out.push(xs)
        xs[0] += 1
    return out

fn main():
    var h = H(a=[i for i in 0..10], b=[[1, 2]])
    let before = h.a
    spin(ref h, 10, 5)
    print(before, h.a)
    let mid = h.a
    h.bump(3)
    h.bump(3)
    print(mid[3], h.a[3])
    # the inner array is shared with `row`
    let row = h.b[0]
    h.b[0][1] = 9
    print(row, h.b)
    var xs = [0] * 4
    let ys = xs
    fill(ref xs, 0)
    fill(ref xs, 10)
    print(ys, xs)
    # no trip: nothing changes
    var e: [int] = []
    fill(ref e, 1)
    print(e)
    var zs = [0, 0]
    let outs = copy_in_loop(ref zs)
    print(outs, zs)
