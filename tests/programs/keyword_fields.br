struct Spec:
    requires: [int]
    ensures: int
    par: bool

enum Shape:
    Box(in: int, if: int)

fn main():
    var s = Spec(requires=[1, 2], ensures=3, par=true)
    s.requires.push(4)
    let n = s.requires[0] - 1
    print(s.requires, s.ensures, s.par, n)
    match Shape.Box(in=5, if=6):
        case Shape.Box(in=a, if=b):
            print(a + b)
