struct Bag:
    items: [int]

    fn map[U](self, f: U) -> [U]:
        return [f for _ in self.items]

    fn first_or[T](self, d: T) -> (int, T):
        return (self.items[0], d)

    fn make[T](x: T) -> [T]:
        return [x, x]

struct Box[T]:
    v: T

    fn pair[U](self, u: U) -> (T, U):
        return (self.v, u)

    fn put[U](ref self, x: T, u: U) -> U:
        self.v = x
        return u

enum Shape:
    Dot
    Sq(n: int)

    fn tag[T](self, t: T) -> (T, bool):
        match self:
            case Shape.Dot:
                return (t, false)
            case _:
                return (t, true)

fn main():
    let b = Bag(items=[1, 2, 3])
    print(b.map("x"), b.map(1.5))
    print(b.first_or("d"), b.first_or[bool](true))
    print(Bag.make(7), Bag.make[str]("s"))
    var bx = Box(v=10)
    print(bx.pair("u"), bx.pair[float](2.5))
    let r = bx.put(20, "done")
    print(r, bx.v)
    print(Shape.Sq(n=3).tag("a"), Shape.Dot.tag(1))
