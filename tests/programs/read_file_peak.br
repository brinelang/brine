# read_file holds a big file in memory once. It read the bytes into one
# block and copied them into the string, so its peak was twice the file.
# Linux tells a program its peak memory (VmHWM in /proc/self/status);
# elsewhere this only reads the file.

# A "Key:   1234 kB" line's number, or -1
fn status_kb(status: str, key: str) -> int:
    for l in status.lines():
        if l.starts_with(key):
            return l[len(key):].strip().split(" ")[0].to_int().unwrap_or(-1)
    return -1

fn main():
    let path = os.temp_dir() + f"/brine_read_peak_{os.pid()}.txt"
    let mb = 96
    # written 1 MB at a time, so writing it doesn't raise the peak
    let chunk = "0123456789abcde\n" * 65536
    write_file(path, chunk).unwrap()
    for _ in 1..mb:
        append_file(path, chunk).unwrap()
    let before = read_file("/proc/self/status").unwrap_or("")
    let rss = status_kb(before, "VmRSS:")
    let text = read_file(path).unwrap()
    let after = read_file("/proc/self/status").unwrap_or("")
    let peak = status_kb(after, "VmHWM:")
    os.remove_file(path).unwrap()
    print(len(text) / 1048576, "MB")
    if rss > 0 and peak > 0:
        let grew = float(peak - rss) / float(mb * 1024)
        print("in memory once" if grew < 1.5 else f"in memory {grew:.1f} times")
