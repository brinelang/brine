# A failed `assert` on a comparison shows the values on both sides. The
# value comes from the second argument, so the compiler can't see it fail.
struct P:
    x: int
    y: int

fn main():
    let w = args()[0]
    let n = int(args()[1])
    if w == "int":
        assert n * 2 == 10
    elif w == "u":
        assert u64(n) < u64(3), "too big"
    elif w == "f":
        assert float(n) / 3.0 == 1.0
    elif w == "f32":
        assert f32(n) / f32(10) >= f32(1)
    elif w == "b":
        assert (n > 3) == false
    elif w == "s":
        assert f"a{n}" == "a"
    elif w == "arr":
        assert [n, 2] == [1, 2]
    elif w == "p":
        assert P(x=n, y=1) == P(x=1, y=1), f"n was {n}"
    elif w == "big":
        assert i128(n) * i128(10) == i128(1)
    elif w == "opt":
        assert "ab".find("b") == Some(n)
    elif w == "chain":
        assert 0 <= n < 3
    else:
        assert n > 0 and n < 3
