struct Point:
    x: int
    y: int

    fn norm1(self) -> int:
        return abs(self.x) + abs(self.y)

    fn shift(ref self, dx: int):
        self.x += dx

struct Named:
    name: str
    tags: [str]

const LIMIT = 10
const GREETING = "hi"

fn fill(ref xs: [int], v: int):
    for i in 0..len(xs):
        xs[i] = v

fn fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fn swap(a: int, b: int) -> (int, int):
    return (b, a)

fn main():
    var p = Point(x=3, y=-4)
    print(p, p.norm1())
    p.shift(10)
    print(p)
    var xs = [1, 2, 3]
    let ys = xs
    fill(ref xs, 7)
    print(xs, ys)
    xs.push(9)
    let last = xs.pop()
    print(last, len(xs))
    var s = "a"
    for i in 0..5:
        s += str(i)
    print(s, GREETING, LIMIT)
    let n = Named(name="bob", tags=["x", "y"])
    print(n)
    let (a, b) = swap(1, 2)
    print(a, b)
    print([i * i for i in 0..6 if i % 2 == 0])
    print(sum(i for i in 1..=100), max(x for x in [3, 9, 2]))
    var total = 0
    var k = 0
    while k < 10:
        k += 1
        if k == 3:
            continue
        if k == 8:
            break
        total += k
    print(total)
    print(fib(20))
    let f = 3.5
    print(f * 2.0, f"{f:.3f}|{42:>6}|{255:x}|{7:05}", 1.0 / 3.0, 1e20, 0.1 + 0.2)
    let grid = [[0] * 3] * 2
    print(grid)
    let words = ["b", "a"]
    print(words, words == ["b", "a"], "abc" < "abd")
    print(1 < 2 < 3, 3 > 2 > 2)
    let z = "big" if a > b else "small"
    print(z)
    for i in range(10, 0, -3):
        print(i)
    print(int("123") + 1, float("2.5"), i32(7), u8(200))
