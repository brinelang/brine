# A panic's call chain names the functions the compiler inlined, at the lines
# of the calls, and leaves the prelude's out.
fn c(xs: [int], i: int) -> int:
    return xs[i] * 2

fn b(xs: [int], i: int) -> int:
    return c(xs, i + 1) + 1

fn a(xs: [int]) -> int:
    var t = 0
    for i in 0..len(xs):
        t += b(xs, i)
    return t

fn grow(x: int) -> int:
    return x * 4611686018427387904

fn first(o: Option[int]) -> int:
    return o.unwrap()

struct Stack:
    xs: [int]

    fn top(self) -> int:
        return self.xs[len(self.xs) - 1]

fn main():
    let w = args()[0]
    if w == "index":
        print(a([1, 2, 3]))
    elif w == "overflow":
        print(grow(len(args()) + 1))
    elif w == "unwrap":
        print(first("ab".find(w)))
    elif w == "method":
        let s = Stack(xs=[])
        print(s.top())
    else:
        # a call on the line of another call's argument, not the call's
        # fmt: off
        print(max(
            first(Some(1)), grow(len(args()) + 1)
        ))
        # fmt: on
