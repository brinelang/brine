# An empty array has no data block until something is put in it: every array
# operation must work on one (and on what it becomes after a push).

struct Bag:
    items: [str]
    nums: [int]

fn lens(xss: [[int]]) -> [int]:
    return [len(xs) for xs in xss]

fn main():
    var a: [int] = []
    print(a, len(a), a == [], str(a), a[0:0], sum(x for x in a))
    let b = a
    a.push(3)
    a.push(1)
    a.push(2)
    print(a, b, len(b))
    var c: [int] = []
    c.extend(a)
    c.extend([])
    c.sort()
    print(c)
    var d: [int] = []
    d.reverse()
    d.sort()
    d.extend(d)
    d.clear()
    print(d, d == b, d == [])
    var s: [str] = []
    let s2 = s
    s.push("x" + str(1))
    print(s, s2, ", ".join(s2), "-".join(s))
    var bag = Bag(items=[], nums=[])
    bag.items.push("a" + "b")
    let copy = bag
    bag.items = []
    bag.nums.push(7)
    print(bag, copy)
    # take an inner array out, change it, put it back
    var xss: [[int]] = [[i, i + 1] for i in 0..4]
    for k in 0..8:
        let i = k % 4
        var ws = xss[i]
        xss[i] = []
        ws.push(k)
        xss[i] = ws
    print(xss, lens(xss))
    var e: [[str]] = [[], [], ["q"]]
    e[0].push("p")
    let f = e
    e[1] = []
    e[2] = []
    print(e, f)
    let zero = [0] * 0
    var z = zero
    z.push(5)
    let ee: [[int]] = [[]] * 2
    print(zero, z, ee, par [len([i] * i) for i in 0..3])
    var empt: [float] = []
    var copy2 = empt
    copy2.push(1.5)
    var both = empt
    both.extend(copy2)
    both.extend(empt)
    print(empt, copy2, both, copy2[1:], empt.contains(1.5), copy2.contains(1.5))
