# Every statement in `f` keeps a runtime check that `brine check --report`
# must list (see tests/integration.br). Each uses its own parameter: a
# check that passed is a fact afterwards.
fn f(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    g: int,
    h: int,
    i: int,
    j: int,
    k: int,
    l: int,
    o: int,
    mut m: {int: int},
    xs: [int],
    v: float
) -> int:
    var y = a
    y += b
    let w = -c
    let n = abs(d)
    let p = i8(e)
    let q = int(v)
    let r = [0] * g
    var ys = xs
    let s = ys.pop()
    let t = 1 << h
    let u = m[i]
    m[j] += 1
    let z = ys.pop(k)
    ys.insert(l, 1)
    let ch = chr(a)
    let st = "ab".repeat(b)
    assert o > 0
    return 0

fn main():
    print(f(1, 2, 3, 4, 5, 6, 7, 1, 2, 0, 0, 1, {1: 1, 2: 2}, [1, 2], 1.5))

# a test's asserts are what it checks at runtime: not listed
test "f":
    assert f(1, 2, 3, 4, 5, 6, 7, 1, 2, 0, 0, 1, {1: 1, 2: 2}, [1, 2], 1.5) == 0
