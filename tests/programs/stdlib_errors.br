fn main():
    let u: u64 = 5
    let s = "hi"
    let xs = [1, 2]
    print(-u, u.wrapping_mul(2.0), u.count_ones(1), u.to_bits(), (1.5).count_ones())
    print(u.wrapping_ad(1), float.from_bits(1.5), float.parse("1"))
    print(s.to_int[str](), s.to_float[int]())
    print(f"{s:g}", f"{s:,}", f"{u:,x}", f"{u:0,}")
    print(xs + 3, 3 * s, s - s)

extern fn getenv(name: str) -> str

extern fn fill(ref xs: [int])

fn io():
    var out = [0] * 4
    print(str.from_utf8("x"), input(1), input("a", "b"), read_stdin(1))
    par for i in 0..4:
        append_file("log", "x")
        out[i] = len(input().unwrap_or(""))
        out[i] = len(read_stdin().unwrap_or(""))
        os.append_bytes("bin", [u8(1)])
