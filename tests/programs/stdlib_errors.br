fn main():
    let u: u64 = 5
    let s = "hi"
    let xs = [1, 2]
    print(-u, u.wrapping_mul(2.0), u.count_ones(1), u.to_bits(), (1.5).count_ones())
    print(u.wrapping_ad(1), float.from_bits(1.5), float.parse("1"))
    print(s.to_int[str](), s.to_float[int]())
    print(f"{s:g}", f"{s:,}", f"{u:,x}", f"{u:0,}")
    print(xs + 3, 3 * s, s - s)
