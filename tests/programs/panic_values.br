# a failed check says which values made it fail
fn main():
    let w = args()[0]
    # from the command line, so nothing is folded at compile time
    let n = len(args())
    if w == "add":
        var x = int("9223372036854775800")
        for i in 0..10:
            x += n
        print(x)
    elif w == "sub":
        print(i32(-2147483647) - i32(n + 1))
    elif w == "mul":
        print(u64(4294967296) * u64(4294967295 + n))
    elif w == "small":
        print(i8(100) + i8(27 + n))
    elif w == "conv":
        print(u8(301 - n))
    elif w == "neg":
        print(u64(n - 9))
    elif w == "float":
        print(i32(1.5e10 * float(n)))
    elif w == "wide":
        print(int((i128(1) << 100) + i128(n)))
