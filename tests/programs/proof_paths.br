# What one path learns must not become a fact of another path, or of code
# that can't run: each `prove` here is false, and once was "proven" anyway,
# because a value made on another path (`x * 2` as a `u8`) contradicted it.

# the 0.9.1 lab's repro: a never-taken arm of `a if c else b`
fn dead_arm(x: u8) -> int:
    requires x > 200
    let v = int(x if true else ((x * 2) if true else x))
    prove v < 3
    return v

# the same with an ordinary condition
fn dead_arm_cond(x: u8) -> int:
    requires x > 200
    let v = int(x if x > 100 else ((x * 2) if x > 100 else x))
    prove v < 3
    return v

# a sibling branch of an `if`
fn sibling_ite(x: u8, c: bool, flag: bool) -> int:
    if flag:
        let y = (x * 2) if c else u8(0)
        return int(y)
    if c:
        prove x <= 127
    return 0

# an array element written on another path
fn sibling_store(x: u8, c: bool) -> int:
    var ys = [u8(0)]
    if c:
        ys[0] = x * 2
        return int(ys[0])
    prove x <= 127
    return 0

# an array literal made on another path
fn sibling_literal(x: u8, c: bool) -> int:
    if c:
        let ys = [x * 2]
        return int(ys[0])
    prove x <= 127
    return 0

# a `match` arm
fn match_arm(x: u8, k: int) -> int:
    match k:
        case 0:
            return int((x * 2) if true else x)
        case _:
            pass
    prove x <= 127
    return 0

# the right side of an `and` that never runs
fn dead_and(x: u8) -> bool:
    let ok = false and int((x * 2) if true else x) > 0
    prove x <= 127
    return ok

# a loop body that may not run
fn loop_body(x: u8, n: int) -> int:
    var t = 0
    for i in 0..n:
        t = int((x * 2) if true else x)
    prove x <= 127
    return t

# a float made from an int: its bounds and a new value's differ
fn float_conv(n: int, c: bool) -> float:
    requires 1 <= n <= 100
    let y = float(n) if c else 0.5
    if c:
        prove n == 1000
    return y

# a float literal in one arm
fn float_literal(c: bool) -> float:
    let h = 1.5 if c else 12.0
    prove c
    return h

# floats merged after an `if`
fn float_join(n: int, c: bool) -> float:
    requires 1 <= n <= 100
    var y = 0.5
    if c:
        y = float(n)
    if c:
        prove n == 1000
    return y

# a `requires` with such a value, at the call (`xs[10]` always fails)
fn needs(x: u8, c: bool) -> int:
    requires ((x * 2) if c else u8(0)) >= u8(0)
    return 1

fn call_site() -> int:
    let xs = [1, 2, 3]
    let r = needs(u8(250), true)
    return xs[10] + r

# the count of a comprehension's range is checked: it isn't a fact elsewhere
fn comp_count(a: int, b: int, c: bool) -> int:
    if c:
        let xs = [0 for i in a..b]
        return len(xs)
    if a < b:
        prove b - a <= 9223372036854775807
    return 0

# found by fuzzing 0.9.1 (each index was "proven" in bounds, and never is)
fn fz216(x: u8) -> int:
    requires u8(51) <= x and x <= u8(202)
    if false:
        return int((((u8(255) + x) << u8(0)) if true else ((x * x) if false else x)))
    prove int(x) < 1
    return 0

fn fz505(x: i16, y: i16) -> int:
    requires i16(32734) <= x and x <= i16(32745)
    requires i16(32724) <= y and y <= i16(32727)
    requires y != x
    if false:
        return int(((y if y == x else x) if false else (x + x)))
    prove int(x) < 2
    return 0

fn fz824(x: u16) -> int:
    requires u16(65398) <= x and x <= u16(65408)
    if x <= u16(16):
        return int(((u16(3) - x) if true else ((x & x) if x != x else x)))
    prove int(x) < 100
    return 0

fn fz1082(x: int, y: int) -> int:
    requires int(-34) <= x and x <= int(-21)
    requires int(-9223372036854775808) <= y and y <= int(-9223372036854775796)
    let i = (
        ((int(-128) | x) if x >= int(0) else (y if y != int(64) else x))
        if y <= x
        else ((y + y) if y == y else x)
    )
    prove 0 <= i < 16
    return i

fn fz1362(x: u32, y: u32, z: u32) -> int:
    requires u32(65529) <= x and x <= u32(65536)
    requires u32(0) <= y and y <= u32(12)
    requires u32(4294967293) <= z and z <= u32(4294967295)
    if x < y:
        return int((y + (min(x, z) if x <= y else (u32(1000) * z))))
    prove int(x) < 8
    return 0

fn fz1179(x: i8, y: i8) -> int:
    requires i8(122) <= x and x <= i8(127)
    requires i8(90) <= y and y <= i8(127)
    requires x == y
    if false:
        return int(((i8(-128) - y) if true else abs(x)))
    prove int((x if y != y else x) | (x if x > i8(15) else i8(7))) < 1
    return 0

fn main():
    print(dead_arm(u8(250)), dead_arm_cond(u8(250)))
    print(sibling_ite(u8(250), true, false), sibling_store(u8(250), false))
    print(sibling_literal(u8(250), false), match_arm(u8(250), 1), dead_and(u8(250)))
    print(loop_body(u8(250), 0), float_conv(5, true), float_literal(false))
    print(float_join(5, true), call_site(), comp_count(-5, 5, false))
    print(fz216(u8(60)), fz505(i16(32740), i16(32725)), fz824(u16(65400)))
    print(fz1082(-30, -9223372036854775800), fz1362(u32(65530), u32(3), u32(4294967294)))
    print(fz1179(i8(122), i8(122)))
