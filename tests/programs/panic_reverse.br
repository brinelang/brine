fn main():
    var a = [0] * 10
    a[0] = 3
    var k = a[0]
    var steps = 0
    while k != 0:
        var i = 0
        var j = k
        while i < j:
            let t = a[i]
            a[i] = a[j]
            a[j] = t
            i += 1
            j -= 1
        steps += 1
        k = steps * 4 + 1
    print(steps)
