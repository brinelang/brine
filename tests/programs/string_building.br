# Strings built a byte at a time and counted in maps: the fast paths for
# `s += t[i]` (and loops that do nothing else with `s`), `var w = ""` in a loop
# and `if k in m: m[k] += v` must give the same results as the general ones,
# whatever else holds the values.

fn lcg_words(n: int) -> [str]:
    let letters = "abcdefgh"
    var seed = 7
    var out: [str] = []
    for _ in 0..n:
        seed = (seed * 1103515245 + 12345) % 2147483648
        let len_ = 1 + seed % 12
        var w = ""
        for _ in 0..len_:
            seed = (seed * 1103515245 + 12345) % 2147483648
            w += letters[seed / 65536 % 8]
        out.push(w)
    return out

fn counts(words: [str]) -> {str: int}:
    var m: {str: int} = {}
    for w in words:
        if w in m:
            m[w] += 1
        else:
            m[w] = 1
    return m

fn bytes_one_by_one():
    # through every size a string block has room for, and past it
    let src = "the quick brown fox jumps over the lazy dog, then naps for a while!"
    var s = ""
    var sizes: [int] = []
    for i in 0..len(src):
        s += src[i]
        if i % 9 == 0:
            sizes.push(len(s))
    print(s == src, sizes)
    # a one-byte literal, the string itself, and bytes of a multi-byte character
    var t = "ab"
    t += "c"
    t += t[0]
    t += t[len(t) - 1]
    let e = "é"
    t += e[0]
    t += e[1]
    print(t, len(t))
    # appending to a string something else holds leaves that one alone
    var u = "shared"
    let held = u
    u += "!"[0]
    print(u, held)
    var arr = ["x"]
    var v = arr[0]
    v += "y"
    print(v, arr)

fn loop_strings():
    # `var w = ""` in a loop: each word must survive the next iteration
    var kept: [str] = []
    var m: {str: int} = {}
    var i = 0
    while i < 6:
        var w = ""
        for j in 0..i + 7:
            w += "abcdefghijklmnop"[(i + j) % 16]
        i += 1
        if i == 2:
            continue
        kept.push(w)
        m[w] = i
        if i == 5:
            break
    print(kept)
    print(m)
    var last = ""
    for k in 0..4:
        var w = ""
        w += "pq"[k % 2]
        last = w
        w += "!"
        print(w, last)
    print(last)

fn counted_maps():
    var m = counts(lcg_words(2000))
    var total = 0
    var squares = 0
    for w in m:
        total += m[w]
        squares += m[w] * m[w]
    print(len(m), total, squares)
    # the map before `+=` is shared: the copy must not change
    let before = m
    for w in ["abc", "a", "hhhhhhhhhhhh", "zzz"]:
        if w in m:
            m[w] += 100
        else:
            m[w] = 1
    for w in ["abc", "a", "hhhhhhhhhhhh", "zzz"]:
        print(w, w in before, before.get(w, -1), m.get(w, -1))
    # keys of every length around a word, and keys that differ only in length
    var n: {str: int} = {}
    var key = ""
    for j in 0..20:
        key += "k"
        n[key] = j
    for j in 0..20:
        key = key[1:]
        if key in n:
            n[key] += 1000
    print(len(n), n["k"], n["kkkkkkk"], n["kkkkkkkk"], n["kkkkkkkkkkkkkkkkkkkk"], "" in n)
    var z: {str: int} = {}
    z["a"] = 1
    z["a" + chr(0)] = 2
    z[chr(0)] = 3
    z[""] = 4
    if "a" in z:
        z["a"] += 10
    print(z["a"], z["a" + chr(0)], z[chr(0)], z[""], len(z))
    # other key types take the same path
    var by_len: {int: int} = {}
    for w in lcg_words(300):
        if len(w) in by_len:
            by_len[len(w)] += 1
        else:
            by_len[len(w)] = 1
    var lens: [int] = []
    for k in by_len:
        lens.push(by_len[k])
    print(len(by_len), lens)
    var pairs: {(int, str): int} = {}
    for p in [(1, "a"), (2, "b"), (1, "a"), (1, "b")]:
        if p in pairs:
            pairs[p] += 1
        else:
            pairs[p] = 1
    print(pairs)

# loops that only append bytes to a string
fn grow(t: str, n: int) -> str:
    var s = ""
    for i in 0..n:
        s += t[i % len(t)]
    return s

fn early(t: str) -> str:
    var s = "x"
    for i in 0..len(t):
        if t[i] == "!":
            break
        s += t[i]
    s += "."
    return s

fn return_in(t: str) -> int:
    var s = ""
    var i = 0
    while i < len(t):
        s += t[i]
        if i == 5:
            return i
        i += 1
    return len(s)

# a loop release builds lower twice (idiom.br's twin loops): the second copy
# takes over midway when a reversal is too long for the first
fn flips_log(n: int) -> str:
    var a = [i for i in 0..n]
    var seed = n * 7 + 1
    for x in 0..n:
        seed = (seed * 1103515245 + 12345) % 2147483648
        let y = seed % n
        let t = a[x]
        a[x] = a[y]
        a[y] = t
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var log = "<"
    var k = a[0]
    while k != 0:
        log += digits[k % 36]
        var i = 0
        var j = k
        while i < j:
            let t = a[i]
            a[i] = a[j]
            a[j] = t
            i += 1
            j -= 1
        log += "."
        k = a[0]
    log += ">"
    return log

fn appenders():
    for n in [0, 1, 7, 8, 9, 15, 16, 17, 31, 47, 48, 100, 1000]:
        let s = grow("abcdefghijklmnopqrstuvwxyz", n)
        print(n, len(s), s[0:min(n, 30)], s[max(n - 3, 0):])
    # starting from a string something else holds, short and long
    for base in ["abc", "abcdefgh", "abcdefghij"]:
        let held = base
        var s = base
        for i in 0..12:
            s += "0123456789xy"[i]
        print(held, s)
    print(early("hello!world"), early("abc"), early("abcdefghijklmn"))
    print(return_in("abcdefghij"), return_in("abc"))
    # an inner loop appends, the outer one reads
    var out: [str] = []
    var s = ""
    for k in 0..4:
        for i in 0..k * 5:
            s += "0123456789abcdef"[i]
        s += "|"
        out.push(s)
    print(out)
    # appends nested in another loop that only appends
    var t = ""
    for k in 0..5:
        t += "-"
        for i in 0..k:
            t += "abc"[i % 3]
    print(t)
    # the loop reads the string too
    var r = "q"
    for i in 0..3:
        r += r[0]
        r += "abc"[i]
    print(r)
    # through a `ref`
    var a = ""
    let ra = ref a
    for i in 0..10:
        ra += "refs and more"[i]
    print(a, len(a))
    var words: [str] = []
    let text = "the quick brown foxes jumped over a lazy dog verylongwordhere x"
    var i = 0
    while i < len(text):
        var w = ""
        while i < len(text):
            if text[i] == " ":
                break
            w += text[i]
            i += 1
        words.push(w)
        i += 1
    print(words)
    for n in [5, 9, 40, 300]:
        let l = flips_log(n)
        print(n, len(l), l[max(len(l) - 40, 0):])

struct Log:
    text: str

    fn add(ref self, x: str):
        self.text = self.text + x + ";"

fn tail_of(s: str) -> str:
    return s[len(s) - 1:]

fn try_part(x: Option[str], ref s: str) -> Option[int]:
    s = s + "<" + x? + ">"
    return Some(len(s))

# `s = s + x` appends in place when `x` doesn't read `s`
fn self_append():
    var s = ""
    for i in 0..1000:
        s = s + str(i % 10)
    let keep = s
    s = s + "!" + tail_of(keep)
    s = s + s[0:2]
    s = "<" + s
    print(len(s), s[0:6], s[len(s) - 6:], len(keep))
    var lg = Log(text="")
    for w in ["a", "b", "c"]:
        lg.add(w)
    print(lg.text)
    var t = "x"
    let r1 = try_part(Some("y"), ref t)
    print(r1, t)
    let r2 = try_part(None, ref t)
    print(r2, t)

fn main():
    bytes_one_by_one()
    loop_strings()
    counted_maps()
    appenders()
    self_append()
