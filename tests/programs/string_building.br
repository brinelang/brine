# Strings built a byte at a time and counted in maps: the fast paths for
# `s += t[i]`, `var w = ""` in a loop and `if k in m: m[k] += v` must give the
# same results as the general ones, whatever else holds the values.

fn lcg_words(n: int) -> [str]:
    let letters = "abcdefgh"
    var seed = 7
    var out: [str] = []
    for _ in 0..n:
        seed = (seed * 1103515245 + 12345) % 2147483648
        let len_ = 1 + seed % 12
        var w = ""
        for _ in 0..len_:
            seed = (seed * 1103515245 + 12345) % 2147483648
            w += letters[seed / 65536 % 8]
        out.push(w)
    return out

fn counts(words: [str]) -> {str: int}:
    var m: {str: int} = {}
    for w in words:
        if w in m:
            m[w] += 1
        else:
            m[w] = 1
    return m

fn bytes_one_by_one():
    # through every size a string block has room for, and past it
    let src = "the quick brown fox jumps over the lazy dog, then naps for a while!"
    var s = ""
    var sizes: [int] = []
    for i in 0..len(src):
        s += src[i]
        if i % 9 == 0:
            sizes.push(len(s))
    print(s == src, sizes)
    # a one-byte literal, the string itself, and bytes of a multi-byte character
    var t = "ab"
    t += "c"
    t += t[0]
    t += t[len(t) - 1]
    let e = "é"
    t += e[0]
    t += e[1]
    print(t, len(t))
    # appending to a string something else holds leaves that one alone
    var u = "shared"
    let held = u
    u += "!"[0]
    print(u, held)
    var arr = ["x"]
    var v = arr[0]
    v += "y"
    print(v, arr)

fn loop_strings():
    # `var w = ""` in a loop: each word must survive the next iteration
    var kept: [str] = []
    var m: {str: int} = {}
    var i = 0
    while i < 6:
        var w = ""
        for j in 0..i + 7:
            w += "abcdefghijklmnop"[(i + j) % 16]
        i += 1
        if i == 2:
            continue
        kept.push(w)
        m[w] = i
        if i == 5:
            break
    print(kept)
    print(m)
    var last = ""
    for k in 0..4:
        var w = ""
        w += "pq"[k % 2]
        last = w
        w += "!"
        print(w, last)
    print(last)

fn counted_maps():
    var m = counts(lcg_words(2000))
    var total = 0
    var squares = 0
    for w in m:
        total += m[w]
        squares += m[w] * m[w]
    print(len(m), total, squares)
    # the map before `+=` is shared: the copy must not change
    let before = m
    for w in ["abc", "a", "hhhhhhhhhhhh", "zzz"]:
        if w in m:
            m[w] += 100
        else:
            m[w] = 1
    for w in ["abc", "a", "hhhhhhhhhhhh", "zzz"]:
        print(w, w in before, before.get(w, -1), m.get(w, -1))
    # keys of every length around a word, and keys that differ only in length
    var n: {str: int} = {}
    var key = ""
    for j in 0..20:
        key += "k"
        n[key] = j
    for j in 0..20:
        key = key[1:]
        if key in n:
            n[key] += 1000
    print(len(n), n["k"], n["kkkkkkk"], n["kkkkkkkk"], n["kkkkkkkkkkkkkkkkkkkk"], "" in n)
    var z: {str: int} = {}
    z["a"] = 1
    z["a" + chr(0)] = 2
    z[chr(0)] = 3
    z[""] = 4
    if "a" in z:
        z["a"] += 10
    print(z["a"], z["a" + chr(0)], z[chr(0)], z[""], len(z))
    # other key types take the same path
    var by_len: {int: int} = {}
    for w in lcg_words(300):
        if len(w) in by_len:
            by_len[len(w)] += 1
        else:
            by_len[len(w)] = 1
    var lens: [int] = []
    for k in by_len:
        lens.push(by_len[k])
    print(len(by_len), lens)
    var pairs: {(int, str): int} = {}
    for p in [(1, "a"), (2, "b"), (1, "a"), (1, "b")]:
        if p in pairs:
            pairs[p] += 1
        else:
            pairs[p] = 1
    print(pairs)

fn main():
    bytes_one_by_one()
    loop_strings()
    counted_maps()
