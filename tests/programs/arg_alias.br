# By-value arguments are snapshots taken before the call, even when the same
# call changes (or grows, or frees) the memory they were read from through a
# `ref` argument.
struct V:
    a: int
    b: int

    fn bump(self, ref xs: [V]) -> int:
        xs[0] = V(self.a + 10, 0)
        return self.a

struct S:
    xs: [V]
    t: (int, int)
    n: int
    names: [str]

    fn f(ref self, v: V) -> int:
        let before = v.a
        self.xs[0] = V(9, 9)
        return before * 10 + v.a

    fn ft(ref self, t: (int, int)) -> int:
        self.t = (7, 7)
        return t.0

    fn count(ref self, names: [str]) -> int:
        self.n += 1
        self.names.push("x")
        return len(names)

fn g(ref xs: [V], v: V) -> int:
    xs[0] = V(9, 9)
    return v.a

fn grow(ref xs: [V], v: V) -> int:
    for i in 0..1000:
        xs.push(V(i, i))
    xs[0] = V(9, 9)
    return v.a

fn gs(ref s: S, v: V) -> int:
    s.xs[0] = V(8, 8)
    return v.a

fn gt(ref t: (int, int), u: (int, int)) -> int:
    t = (5, 5)
    return u.0

fn gf(ref a: int, v: V) -> int:
    a = 42
    return v.a

fn row(ref r: [int], grid: [[int]]) -> int:
    r.push(5)
    r[0] = 99
    return grid[0][0] + len(grid[0])

fn ret(ref xs: [V], v: V) -> V:
    for i in 0..100:
        xs.push(V(i, i))
    return v

fn shared(ref a: [int], b: [int]) -> int:
    a[0] = 100
    return b[0]

fn bump_opt(ref o: Option[V], v: V) -> int:
    o = None
    return v.a

fn main():
    var s = S(xs=[V(1, 1)], t=(1, 1), n=0, names=["a", "b"])
    var r = s.f(s.xs[0])
    print("ref self:", r, s.xs[0].a)
    r = s.ft(s.t)
    print("tuple:", r, s.t.0)
    var xs = [V(1, 1)]
    r = g(ref xs, xs[0])
    print("free fn:", r, xs[0].a)
    xs = [V(1, 1)]
    r = grow(ref xs, xs[0])
    print("grown:", r, len(xs))
    s.xs = [V(1, 1)]
    r = gs(ref s, s.xs[0])
    print("whole:", r, s.xs[0].a)
    var t = (1, 1)
    r = gt(ref t, t)
    print("tuple ref:", r, t.0)
    var v = V(1, 1)
    r = gf(ref v.a, v)
    print("field ref:", r, v.a)
    var grid = [[1, 2]]
    r = row(ref grid[0], grid)
    print("element ref first:", r, grid[0])
    xs = [V(1, 1)]
    xs[0] = ret(ref xs, xs[0])
    print("assigned:", xs[0].a, len(xs))
    xs = [V(3, 3)]
    r = xs[0].bump(ref xs)
    print("receiver:", r, xs[0].a)
    # disjoint fields need no copy, and still see the right values
    r = s.count(s.names)
    print("disjoint:", r, s.n, len(s.names))
    var a = [1, 2]
    let b = a
    r = shared(ref a, b)
    print("shared:", r, a[0], b[0])
    var o = Some(V(4, 4))
    match o:
        case Some(w):
            r = bump_opt(ref o, w)
            print("match:", r, o.is_some())
        case None:
            pass
    xs = [V(5, 5)]
    for x in xs:
        r = g(ref xs, x)
        print("loop:", r, xs[0].a)
    # growing an array or map with plain data read from it
    var zs = [V(3, 3)]
    for i in 0..100:
        zs.push(zs[0])
        zs.insert(0, zs[len(zs) - 1])
    print("push:", zs[200].a, zs[0].a, len(zs))
    var m: {int: V} = {0: V(4, 4)}
    for i in 1..100:
        m[i] = m[i - 1]
    print("map:", m[99].a, len(m))
