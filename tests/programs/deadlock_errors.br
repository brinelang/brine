fn total(x: int) -> int:
    return world.sum(x)

fn rounds(n: int, x: float) -> float:
    var v = x
    for i in 0..n:
        v = world.max(v) / 2.0
    return v

fn local_part() -> int:
    return world.rank() * 10

fn main():
    let rank = world.rank()
    let size = world.size()
    if rank == 0:
        world.barrier()
    let t = total(rank)
    if t > 5:
        world.barrier()
    if rank > 0 and total(1) > 0:
        print("x")
    let a = rounds(3, 1.0)
    let b = rounds(rank, 1.0)
    let p = local_part()
    let c = world.broadcast(p, 7)
    let ok = world.broadcast(size - 1, 7)
    var i = 0
    while i < rank:
        i += world.sum(1)
    for k in 0..size:
        if k == rank:
            break
        world.barrier()
    let s = world.shift(1, rank)
    if s > 100:
        return
    world.barrier()
