# Constants are computed at compile time as the program would compute them:
# conversions are checked, `f32` rounds at every step, `<<` drops high bits.
const SMALL = u8(3)
const FNV_OFFSET = u64(0xcbf29ce484222325)
const STALE_NAN = u64(0x7ff0000000000002)
const INV255 = f32(1) / f32(255)
const THIRD: f32 = 1.0 / 3.0
const BYTES = [u8(0), u8(1), u8(255)]
const LIMIT = 300
const HALF = i32(LIMIT / 2)
const TRUNC = int(2.9)
const NEG_TRUNC = int(-2.9)
const ALL_ONES = ~u8(0)
const TOP = 3 << 63
const BIT63 = u64(1) << 63
const WIDE_U8 = u8(200) << 1
const ORDERED = 1 < 2 < 3
const FROM_BOOL = u8(true)
const AS_FLOAT = float(LIMIT)

fn main():
    print(SMALL, FNV_OFFSET, STALE_NAN, BYTES)
    print(INV255, THIRD, HALF, TRUNC, NEG_TRUNC, ALL_ONES)
    print(TOP, BIT63, WIDE_U8, ORDERED, FROM_BOOL, AS_FLOAT)
    let one: f32 = 1.0
    let d: f32 = 255.0
    let three: f32 = 3.0
    print(one / d == INV255, one / three == THIRD)
