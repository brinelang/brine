# Builtins of the standard library: math, float bits, integer methods,
# parsing, searching, formatting, `+` on arrays, `*` on strings and strings
# passed to C. Output is the same on every backend and target.
fn opt_int(o: Option[int]) -> str:
    match o:
        case Some(n):
            return f"Some({n})"
        case None:
            return "None"

fn opt_float(o: Option[float]) -> str:
    match o:
        case Some(x):
            return f"Some({x})"
        case None:
            return "None"

fn math():
    print(atan(1.0) * 4.0, atan2(-1.0, -1.0), asin(0.5), acos(0.5))
    print(sinh(1.0), cosh(1.0), tanh(0.5), exp2(10.0), log2(1024.0), log10(0.001))
    print(hypot(3.0, 4.0), cbrt(-27.0), cbrt(2.0))
    let h: f32 = 1.5
    print(pow(h, f32(2.0)), atan2(h, f32(1.0)), hypot(h, f32(2.0)), sqrt(h))

fn bits():
    let x = 1.5
    print(f"{x.to_bits():x}", float.from_bits(0x3ff8000000000000), f64.from_bits(u64(0)))
    let y: f32 = -2.0
    print(f"{y.to_bits():x}", f32.from_bits(0x3fc00000), float.from_bits((-0.0).to_bits()))
    let m: u64 = 0xcbf29ce484222325
    print(m.wrapping_mul(0x100000001b3), m.wrapping_add(m), u64(0).wrapping_sub(1))
    let b: u8 = 200
    print(b.wrapping_add(100), b.wrapping_mul(3), b.wrapping_neg(), i8(-128).wrapping_neg())
    print(u16(65535).wrapping_mul(65535), i32(2147483647).wrapping_add(1))
    print(b.rotate_left(1), b.rotate_right(9), u32(1).rotate_right(1), i64(-2).rotate_left(-1))
    for v in [u64(0), u64(1), u64(0x8000000000000000), u64(0xf0)]:
        print(v.count_ones(), v.leading_zeros(), v.trailing_zeros())
    print(
        u8(0).leading_zeros(),
        u8(0).trailing_zeros(),
        u16(1).leading_zeros(),
        i32(-1).count_ones()
    )
    let big: u128 = 1 << 100
    print(big.count_ones(), big.leading_zeros(), big.trailing_zeros(), u128(0).trailing_zeros())
    var f = 0b1100
    f |= 0b0011
    f &= 0b1010
    f ^= 0b0001
    f <<= 4
    f >>= 2
    print(f)

fn parsing():
    for s in [
        "42",
        " -17 ",
        "1_000_000",
        "0x10",
        "",
        "4_",
        "_4",
        "9223372036854775807",
        "9223372036854775808"
    ]:
        print(f"\"{s}\"", opt_int(s.to_int()))
    print(opt_float("2.5".to_float()), opt_float("1e3".to_float()), opt_float("1_0.2_5".to_float()))
    print(opt_float("x".to_float()), opt_float("inf".to_float()))
    match "300".to_int[u8]():
        case Some(n):
            print("u8", n)
        case None:
            print("300 is no u8")
    match "255".to_int[u8]():
        case Some(n):
            print("u8", n)
        case None:
            print("255 is no u8")
    match "-1".to_int[u64]():
        case Some(n):
            print("u64", n)
        case None:
            print("-1 is no u64")
    match "0.1".to_float[f32]():
        case Some(x):
            print("f32", x)
        case None:
            print("none")
    print(int("1_000") + 1, float("2_5.0"))

fn searching():
    let s = "abcabc"
    print(opt_int(s.find("b", 2)), opt_int(s.find("b", 5)), opt_int(s.find("", 6)))
    let xs = [3, 1, 3, 1]
    print(opt_int(xs.index(1, 2)), opt_int(xs.index(3, 3)), opt_int(xs.index(3, 0)))

fn formatting():
    let x = 1234567.891
    print(f"{x:g} {x:.10g} {1e-7:g} {100000.0:g} {1e6:g} {0.0:g}")
    print(f"{x:,} {x:,.2f} {1234567:,} {-1234:,} {999:,} {x:,.3e} {12345:>10,}|{-0.5:<8,}|")
    let u: u64 = 18446744073709551615
    print(f"{u:,} {i128(-1) << 100:,}")

fn joining():
    let a = [1, 2]
    var b = a + [3] + a
    b += [9]
    b = b + b[:1]
    print(a, b, a + [], [] + a)
    var names = ["x"]
    names += names
    names = names + ["y"]
    print(names, "ab" * 3, "-" * 0, len("é" * 4))
    var s = "ab"
    s *= 2
    print(s)

extern fn strcmp(a: str, b: str) -> i32

extern fn atoi(s: str) -> i32

fn externs():
    var s = "hé"
    s += "llo"
    print(strcmp(s, "héllo") == 0, strcmp("", "a") < 0, atoi("  42x") + 1)

fn main():
    math()
    bits()
    parsing()
    searching()
    formatting()
    joining()
    externs()
