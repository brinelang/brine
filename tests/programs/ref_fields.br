struct In:
    xs: [int]
    pair: (int, str)

struct Out:
    inner: In
    n: int

    fn bump(ref self):
        let i = ref self.inner
        i.xs.push(len(i.xs))
        let p = ref i.pair
        p.0 += 10
        let first = ref self.inner.pair.0
        first += 1
        self.n += first

fn grow(ref o: Out):
    let xs = ref o.inner.xs
    xs.push(99)

fn main():
    var o = Out(inner=In(xs=[], pair=(0, "a")), n=0)
    o.bump()
    o.bump()
    grow(ref o)
    print(o)
    var t = (1, (2, 3))
    let inner = ref t.1
    inner = (7, 8)
    print(t, inner)
    let r = ref t
    let deep = ref (r.1).0
    deep += 1
    print(t)
    let ro = Out(inner=In(xs=[5], pair=(1, "b")), n=3)
    let v = ref ro.inner.xs
    print(v[0], len(v))
