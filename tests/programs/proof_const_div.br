# Remainders and quotients by constants, near the limits of 64-bit types: the
# solver alone loses its way in these bounds, the ranges of the values settle
# them (from a crypto core and a date library, v09#4). All are proven.

fn store32be(ref b: [u8], off: int, v: u32):
    requires 0 <= off and off + 4 <= len(b)
    b[off] = u8((v >> 24) & 0xff)
    b[off + 1] = u8((v >> 16) & 0xff)
    b[off + 2] = u8((v >> 8) & 0xff)
    b[off + 3] = u8(v & 0xff)

fn store64be(ref b: [u8], off: int, v: u64):
    requires 0 <= off and off + 8 <= len(b)
    store32be(ref b, off, u32((v >> 32) & 0xffffffff))
    store32be(ref b, off + 4, u32(v & 0xffffffff))

fn pack(y: int, m: int, d: int) -> int:
    requires 1 <= y <= 9999
    requires 1 <= m <= 12
    requires 1 <= d <= 31
    ensures 101 <= result <= 99991231
    return y * 10000 + m * 100 + d

fn from_days(z0: int) -> int:
    requires -720000 <= z0 <= 2940000
    ensures result == 0 or 101 <= result <= 99991231
    let z = z0 + 719468
    let era = z / 146097
    let doe = z % 146097
    prove 0 <= doe <= 146096
    let a = doe / 1460
    let b = doe / 36524
    let c = doe / 146096
    prove 0 <= a <= 101 and 0 <= b <= 4 and 0 <= c <= 1
    let yoe = (doe - a + b - c) / 365
    prove 0 <= yoe <= 400
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    if doy < 0 or doy > 365 or y < 0 or y > 9998:
        return 0
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    if d < 1 or d > 31 or mp < 0 or mp > 11:
        return 0
    if mp < 10:
        if y < 1:
            return 0
        return pack(y, mp + 3, d)
    return pack(y + 1, mp - 9, d)

fn main():
    var b = [u8(0)] * 8
    store64be(ref b, 0, u64(0x0102030405060708))
    print(b[0], b[7], from_days(19000))
