enum Suit:
    Clubs
    Hearts
    Spades

struct Card:
    rank: int
    suit: Suit

struct Job:
    prio: int
    name: str
    card: Card

fn smallest[T](xs: [T]) -> T:
    var best = xs[0]
    for x in xs:
        if x < best:
            best = x
    return best

fn loop_min():
    var xs: [int] = []
    for i in 0..1000:
        xs.push((i * 7919) % 1009)
    var best = (xs[0], 0)
    for i in 0..len(xs):
        best = min(best, (xs[i], i))
    var worst = ("", 0)
    for i in 0..len(xs):
        worst = max(worst, (str(xs[i]), i))
    print(best, worst, min((x, i) for i, x in enumerate(xs)))

fn main():
    var jobs = [(3, "c"), (1, "b"), (1, "a"), (2, "z")]
    jobs.sort()
    print(jobs, smallest(jobs))
    print((1, 2) < (1, 3), (1, 2) <= (1, 2), (2, 0) > (1, 9), (1, 2) >= (1, 3))
    print(Suit.Clubs < Suit.Spades, Suit.Hearts >= Suit.Spades, max(Suit.Clubs, Suit.Hearts))
    let a = Card(rank=3, suit=Suit.Hearts)
    let b = Card(rank=3, suit=Suit.Clubs)
    print(a < b, b < a, min(a, b), max(a, b))
    var cards = [Card(rank=2, suit=Suit.Spades), a, b, Card(rank=1, suit=Suit.Hearts)]
    cards.sort()
    print(cards)
    var js = [
        Job(prio=2, name="x", card=a),
        Job(prio=1, name="y", card=b),
        Job(prio=1, name="y", card=Card(rank=1, suit=Suit.Clubs))
    ]
    js.sort()
    print([j.card.rank for j in js])
    print(min("pear", "apple"), max("pear", "apple"))
    print(min(j for j in jobs), max(j for j in jobs if j.0 < 3))
    print(min(s for s in ["b", "a", "c"]), max(c for c in cards))
    let nan = 0.0 / 0.0
    print((nan, 1) < (1.0, 2), (1.0, 2) < (nan, 1), (1.0, 2) < (1.0, 3))
    var fs = [(2.0, 1), (nan, 0), (1.0, 5)]
    fs.sort()
    print(fs)
    # ties keep the first
    let t1 = (1, "first")
    print(min((1, "a"), (1, "a")), max(t1, (1, "first")))
    var words = ["b", "a"]
    for _ in 0..3:
        words.push(min(words[0], words[1]))
    print(words, max(w for w in words))
    loop_min()
