# Constants the 0.9.1 checker turned away: tables of pairs, untyped literals
# past `int`, negative 128-bit literals and 128-bit shifts.

const NAMES = [("letter", "L"), ("number", "N")]
const PAIR = (3, "three")
const NESTED = [(1, [u8(2), 3]), (4, [u8(5)])]
const SIGN = 0x8000000000000000
const HUGE = 0xffffffffffffffffffffffffffffffff
const LOW = -9223372036854775809
const BYTES = [u8(0), u8(1), u8(3)]
const STALE_NAN = u64(0x7ff0000000000002)
const TOP = i128(1) << 127
const UTOP = u128(1) << 127
const WIDE = i128(-12345678901234567890)

fn main():
    print(NAMES[0].1, NAMES[1], len(NAMES), PAIR.1, NESTED[0].1, NESTED[1])
    for name, short in NAMES:
        print(name, short)
    let x: u64 = SIGN
    let m = u64(5) | SIGN
    let h: u128 = HUGE
    let l: i128 = LOW
    print(x, m, h, l, i128(SIGN) + 1)
    match x:
        case SIGN:
            print("sign")
        case _:
            print("no")
    print(BYTES, STALE_NAN, TOP, UTOP, WIDE, i128(-12345678901234567890))
    print(u64(-0) == 0, i128(-170141183460469231731687303715884105727))
