# The notes of failed proofs name values as the source does (see
# tests/integration.br): never `?`, nor the compiler's hidden names.
struct F:
    fno: int

# `for i, f in ...` loops over a hidden variable that it unpacks: its parts
# are `i` and `f`
fn order(fs: [F]) -> [F]:
    var keyed: [(int, int)] = []
    for i, f in enumerate(fs):
        keyed.push((-f.fno, i))
    var out: [F] = []
    for (_, i) in keyed:
        out.push(fs[i])
    return out

struct Lines:
    data: [u8]
    starts: [int]

fn hash(d: [u8], s: int) -> int:
    requires 0 <= s and s < len(d)
    return int(d[s])

# what `a if c else b` chose is named after the `let`
fn pick(a: Lines, b: Lines, c: bool) -> int:
    let l = a if c else b
    var h = 0
    for i in 0..len(l.starts):
        h = hash(l.data, l.starts[i])
    return h

# each `let` of a chain is named, not written out again
fn chain(a: int, b: int) -> int:
    requires 0 <= a < 1000 and 0 <= b < 1000
    let d0 = a * b + b * b
    let d1 = d0 * a + d0 * b
    let d2 = d1 * d1 + d1 * a
    return d2 * d2

fn main():
    let l = Lines(data=[u8(1)], starts=[0])
    print(len(order([F(fno=2)])), pick(l, l, true), chain(1, 2))
