# Each line marked `# E....` reports that error, and no other line reports one.

fn tuple_places():
    var a = 1
    var b = 2
    a, b = 1, 2, 3  # E0301
    var xs = [1, 2]
    var i = 0
    i, xs[i] = 1, 5  # E0405
    a, a = 3, 4  # E0405
    (a, b) += (1, 2)  # E0404
    a, b = "x", 2  # E0301

enum E:
    A(x: int)
    B(x: str)
    C(x: int, y: int)
    D

fn or_binds(e: E) -> int:
    match e:
        case E.A(c) | E.B(c):  # E0321
            return 0
        case E.C(c, d) | E.A(c):  # E0321
            return 1
        case E.D | E.A(z):  # E0321
            return 2
        case _:
            return 3

fn main():
    tuple_places()
    print(or_binds(E.D))
