# Each line marked `# E....` reports that error, and no other line reports one.

fn tuple_places():
    var a = 1
    var b = 2
    a, b = 1, 2, 3  # E0301
    var xs = [1, 2]
    var i = 0
    i, xs[i] = 1, 5  # E0405
    a, a = 3, 4  # E0405
    (a, b) += (1, 2)  # E0404
    a, b = "x", 2  # E0301

enum E:
    A(x: int)
    B(x: str)
    C(x: int, y: int)
    D

fn or_binds(e: E) -> int:
    match e:
        case E.A(c) | E.B(c):  # E0321
            return 0
        case E.C(c, d) | E.A(c):  # E0321
            return 1
        case E.D | E.A(z):  # E0321
            return 2
        case _:
            return 3

const T = [1, 2]
const F = 1.5
const B: u8 = 3

fn consts(x: int) -> int:
    T[0] = 5  # E0401
    T.push(3)  # E0401
    match x:
        case F:  # E0322
            return 1
        case B:  # E0301
            return 2
        case T:  # E0322
            return 3
        case _:
            return 0

fn n() -> int:
    return 3

const CALLS = [1, n()]  # E0317

enum Many:
    A
    B

struct Listy:
    xs: [int]
    n: int

enum Payload:
    A(x: int)
    B

fn orders():
    let p = Listy(xs=[1], n=2)
    print(p < p)  # E0305
    print(Payload.B < Payload.B)  # E0305
    print(min(true, false))  # E0305
    var ps = [p]
    ps.sort()  # E0305
    print(par max(x for x in ["a"]))  # E0301
    print(min((1, [2]), (1, [3])))  # E0305

fn give() -> Listy:
    return Listy(xs=[], n=0)

fn bad_refs():
    var xs = [1, 2]
    let e = ref xs[0]  # E0404
    print(e + 1)
    let g = ref give().n  # E0404
    print(g)

struct Two:
    a: [int]
    b: [int]

    fn m(ref self) -> int:
        return 1

fn pair(ref x: [int], ref y: [int]):
    pass

fn add_to(ref x: int, n: int):
    x += n

fn orders2():
    var st = [1, 2]
    print(st.pop() + st.pop())  # E0405
    var p = Two(a=[1], b=[2])
    pair(ref p.a, ref p.a)  # E0405
    print(p.a.pop(), p.a)  # E0405
    add_to(ref p.a[0], sum(p.a.pop() for k in 0..1))  # E0405
    var xs = [[1], [2]]
    xs[0].push(xs.pop()[0])  # E0405
    print(p.m() + len(p.b))  # E0405

fn arith():
    let a = [1] - [2]  # E0305
    let s = "a" - "b"  # E0305
    let b = true + false  # E0305
    let t = (1, 2) * (3, 4)  # E0305

fn main():
    arith()
    orders2()
    bad_refs()
    orders()
    tuple_places()
    print(or_binds(E.D))
    print(consts(1), CALLS)
    print(int(Many.A), u8(Many.B))
