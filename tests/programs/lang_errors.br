# Each line marked `# E....` reports that error, and no other line reports one.

fn tuple_places():
    var a = 1
    var b = 2
    a, b = 1, 2, 3  # E0301
    var xs = [1, 2]
    var i = 0
    i, xs[i] = 1, 5  # E0405
    a, a = 3, 4  # E0405
    (a, b) += (1, 2)  # E0404
    a, b = "x", 2  # E0301

fn main():
    tuple_places()
