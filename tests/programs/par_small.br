# Reductions with few leaves for the threads run each element as a task and
# fold the leaves afterwards. The result bits must be the ones the leaves and
# the tree give, on any thread count (tests/integration.br runs 1, 3 and 8).
fn f(k: int) -> float:
    return float(k) * 0.1 - 1.3

fn main():
    let xs = [f(k) * f(k + 7) for k in 0..200]
    for n in [1, 2, 15, 16, 17, 31, 32, 33, 100, 200]:
        let s = par sum(f(k) for k in 0..n)
        let z = par sum(-0.0 for k in 0..n)
        let zf = par sum(-0.0 for k in 0..n if k % 2 == 1)
        let p = par product(1.0 + f(k) * 0.01 for k in 0..n)
        let lo = par min(f(k) * f(k) for k in 0..n if k % 3 != 1)
        let hi = par max(-0.0 if k % 2 == 0 else 0.0 for k in 0..n)
        let i = par sum(k * k - 50 for k in 0..n if k % 2 == 0)
        let b = par sum(i8(k % 5 - 2) for k in 0..n)
        let q = par product(u64(3) if k % 9 == 0 else u64(1) for k in 0..n)
        let a = par any(f(k) > 0.5 for k in 0..n)
        let e = par all(f(k) < 1.5 for k in 0..n)
        let ys = par sum(x for x in xs[:n])
        let f32s = par sum(f32(f(k)) * f32(0.3) for k in 0..n)
        print(n, s, z, zf, p, lo, hi, i, b, q, a, e, ys, f32s)
