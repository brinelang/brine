# Integer / and % (rounding down, the sign of the divisor) by constants and by
# variables, at every width: the native backend divides by a constant with a
# multiplication and fixes up idiv's rounding itself.

fn h(acc: int, v: int) -> int:
    return acc.wrapping_mul(1000003).wrapping_add(v)

fn by_consts(xs: [int]) -> int:
    var acc = 0
    for x in xs:
        acc = h(acc, x / 3)
        acc = h(acc, x % 3)
        acc = h(acc, x / 7)
        acc = h(acc, x % 7)
        acc = h(acc, x / 10)
        acc = h(acc, x % 10)
        acc = h(acc, x / 641)
        acc = h(acc, x % 641)
        acc = h(acc, x / 1000003)
        acc = h(acc, x % 1000003)
        acc = h(acc, x / 4294967311)
        acc = h(acc, x % 4294967311)
        acc = h(acc, x / 2305843009213693951)
        acc = h(acc, x % 2305843009213693951)
        acc = h(acc, x / 9223372036854775807)
        acc = h(acc, x % 9223372036854775807)
        acc = h(acc, x / -7)
        acc = h(acc, x % -7)
        acc = h(acc, x % -1)
    return acc

fn by_vars(xs: [int], ds: [int]) -> int:
    var acc = 0
    for x in xs:
        for d in ds:
            if d != 0:
                acc = h(acc, x % d)
                if d != -1 or x != -9223372036854775807 - 1:
                    acc = h(acc, x / d)
    return acc

fn unsigned(xs: [u64], ds: [u64]) -> int:
    var acc = 0
    for x in xs:
        acc = h(acc, int(x / 3 % 1000))
        acc = h(acc, int(x % 7))
        acc = h(acc, int(x / 10 % 1000))
        acc = h(acc, int(x / 1000003 % 1000))
        acc = h(acc, int(x % 1000003))
        acc = h(acc, int(x / 64 % 1000))
        acc = h(acc, int(x % 64))
        acc = h(acc, int(x / 4294967311 % 1000))
        acc = h(acc, int(x % 4294967311))
        for d in ds:
            if d != 0:
                acc = h(acc, int(x / d % 1000))
                acc = h(acc, int(x % d % 1000))
    return acc

fn narrow(xs: [i32], ys: [u32], bs: [i8], us: [u16]) -> int:
    var acc = 0
    for x in xs:
        acc = h(acc, int(x / 3))
        acc = h(acc, int(x % 3))
        acc = h(acc, int(x / 1000))
        acc = h(acc, int(x % 1000))
        acc = h(acc, int(x % -5))
        for y in xs:
            if y != 0 and (y != -1 or x != -2147483647 - 1):
                acc = h(acc, int(x / y))
                acc = h(acc, int(x % y))
    for y in ys:
        acc = h(acc, int(y / 7))
        acc = h(acc, int(y % 7))
        acc = h(acc, int(y / 100000))
    for b in bs:
        acc = h(acc, int(b / 3))
        acc = h(acc, int(b % 3))
        for c in bs:
            if c != 0 and (c != -1 or b != -128):
                acc = h(acc, int(b / c))
                acc = h(acc, int(b % c))
    for u in us:
        acc = h(acc, int(u / 10))
        acc = h(acc, int(u % 10))
    return acc

# the divisor isn't known to be nonzero: checked division
fn checked(xs: [int], ds: [int], us: [u64]) -> int:
    var acc = 0
    for x in xs:
        for d in ds:
            acc = h(acc, x % d)
            if d != -1 or x != -9223372036854775807 - 1:
                acc = h(acc, x / d)
    for u in us:
        for v in us:
            acc = h(acc, int(u / v % 1000))
            acc = h(acc, int(u % v % 1000))
    return acc

fn main():
    let lo = -9223372036854775807 - 1
    let xs = [
        0,
        1,
        2,
        3,
        6,
        7,
        9,
        10,
        11,
        640,
        641,
        642,
        999999,
        1000003,
        123456789,
        4294967310,
        4294967311,
        4294967312,
        9223372036854775807,
        lo,
        lo + 1,
        -1,
        -2,
        -3,
        -6,
        -7,
        -9,
        -10,
        -11,
        -641,
        -642,
        -1000003,
        -123456789,
        -4294967311
    ]
    let ds = [1, -1, 2, -2, 3, -3, 7, -7, 10, 1000003, -1000003, 9223372036854775807, lo, 0]
    print(by_consts(xs))
    print(by_vars(xs, ds))
    let ux: [u64] = [
        0, 1, 6, 7, 63, 64, 65, 1000002, 1000003, 4294967311, 9223372036854775808,
        18446744073709551615, 18446744073709551614, 12345678901234567890
    ]
    let ud: [u64] = [1, 2, 3, 7, 10, 18446744073709551615, 9223372036854775808, 0]
    print(unsigned(ux, ud))
    let n32: [i32] = [
        0, 1, 2, 3, 999, 1000, 1001, 2147483647, -2147483647 - 1, -1, -2, -3, -999, -1000, -1001, -5
    ]
    let u32s: [u32] = [0, 6, 7, 99999, 100000, 4294967295]
    let i8s: [i8] = [0, 1, 2, 3, 127, -128, -1, -2, -3, -127]
    let u16s: [u16] = [0, 9, 10, 65535]
    print(narrow(n32, u32s, i8s, u16s))
    let nz = [1, -1, 2, -2, 3, 7, -7, 10, 1000003, -1000003, 9223372036854775807, lo]
    let unz: [u64] = [1, 2, 3, 7, 10, 18446744073709551615, 9223372036854775808]
    print(checked(xs, nz, unz))
