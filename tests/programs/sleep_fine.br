# os.sleep sleeps about as long as asked. On Windows a 1 ms sleep took
# 15.6 ms: Sleep waits for the next tick of the system timer (v091#16).
#
# On a busy machine a thread can wait long after its sleep to run again,
# so the fastest of 20 is checked, and only when the fastest 30 ms sleep,
# taken in turn with them, came back within 4 ms: Sleep's ended on a tick
# (31.2 ms), and later than that the machine is too busy to tell.
fn main():
    # (it starts anywhere in a tick, and can end early in it)
    os.sleep(0.001)
    var short = 1.0e9
    var long = 1.0e9
    for _ in 0..20:
        var t = clock()
        os.sleep(0.001)
        short = min(short, clock() - t)
        t = clock()
        os.sleep(0.03)
        long = min(long, clock() - t)
    print("at least as long as asked" if short >= 0.0009 and long >= 0.0299 else f"{short} {long}")
    let busy = long > 0.034
    print("well under a tick" if busy or short < 0.008 else f"{short * 1000.0:.1f} ms at best")
