struct Bag:
    items: [int]

    fn map[U](self, f: U) -> [U]:
        return [f for _ in self.items]

    fn empty[U](self) -> [U]:
        return []

    fn plain(self) -> int:
        return 1

struct Box[T]:
    v: T

    fn bad[T](self) -> int:
        return 0

fn main():
    let b = Bag(items=[1])
    print(b.map[int, str](1))
    print(b.empty())
    print(b.plain[int]())
    print(b.mapp(1))
    var xs = [1]
    print(xs.pop[int]())
    print(Bag.map(1))
