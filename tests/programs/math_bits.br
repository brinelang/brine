# sin, exp, pow and the others give the same bits on every target and
# backend: they come from the runtime's own math library, not the C
# library's (which differ in the last bit). str(float) is exact, so equal
# text means equal bits. Inputs cover small arguments, big ones (trig's
# argument reduction), and the edges.
fn show(x: float) -> str:
    let vals = [sin(x), cos(x), tan(x), exp(x), log(abs(x)), pow(abs(x), 1.37), pow(1.0001, x)]
    return " ".join([str(v) for v in vals])

fn show32(x: f32) -> str:
    let vals = [sin(x), cos(x), tan(x), exp(x), log(abs(x)), sqrt(abs(x))]
    return " ".join([str(v) for v in vals])

fn mix(h: u64, b: u64) -> u64:
    return (h ^ b).wrapping_mul(1099511628211)

# The bits of a result, with every NaN as one: a NaN's sign and payload come
# from the hardware (x86 sets the sign bit, ARM doesn't), not the math code.
fn bits(r: float) -> u64:
    return r.to_bits() if r == r else 0x7ff8000000000000

fn bits32(r: f32) -> u64:
    return u64(r.to_bits()) if r == r else 0x7fc00000

fn input(ref st: u64, i: int) -> float:
    var x = st
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    st = x
    let r = x.wrapping_mul(2685821657736338717)
    match i % 6:
        case 0:
            let v = float.from_bits(r)
            # (a NaN: a quiet one)
            return v if v == v else 0.25
        case 1:
            return float(r >> 11) / 9007199254740992.0 * 2.0 - 1.0
        case 2:
            return (float(r >> 11) / 9007199254740992.0 - 0.5) * 40.0
        case 3:
            return (float(r >> 11) / 9007199254740992.0 - 0.5) * 1500.0
        case 4:
            return float(int(r >> 40)) - 8388608.0
        case _:
            return (float(r >> 11) / 9007199254740992.0) * 1.0e-6

# Every math builtin, f64 and f32, on 300k inputs: a hash of the result bits
# each. (No signaling NaNs, and no NaN % NaN: there C libraries disagree.)
fn hashes():
    let specials = [
        0.0, -0.0, 1.0, -1.0, 0.5, -0.5, 2.0, -2.0, 3.0, 1.0e308, -1.0e308, 5.0e-324, -5.0e-324,
        2.2250738585072014e-308, 0.1, 100.0, 710.0, -745.0, 1.0e300
    ]
    var xs: [float] = []
    let inf = 1.0e308 * 10.0
    xs.push(inf)
    xs.push(-inf)
    # (the NaN x86 makes, written out: a C compiler folds `inf - inf` to +NaN)
    xs.push(float.from_bits(0xfff8000000000000))
    for s in specials:
        xs.push(s)
    var st: u64 = 88172645463325252
    for i in 0..300000:
        xs.push(input(ref st, i))
    let names = [
        "sin",
        "cos",
        "tan",
        "asin",
        "acos",
        "atan",
        "sinh",
        "cosh",
        "tanh",
        "exp",
        "exp2",
        "log",
        "log2",
        "log10",
        "cbrt",
        "sqrt",
        "floor",
        "ceil",
        "round",
        "abs",
        "pow",
        "atan2",
        "hypot",
        "min",
        "max",
        "mod"
    ]
    for ni, n in enumerate(names):
        var h: u64 = 14695981039346656037
        var hf: u64 = 14695981039346656037
        for j, x in enumerate(xs):
            let y = xs[(j * 7 + 3) % len(xs)]
            var r = 0.0
            var rf: f32 = 0.0
            let xf = f32(x)
            let yf = f32(y)
            match ni:
                case 0:
                    r = sin(x)
                    rf = sin(xf)
                case 1:
                    r = cos(x)
                    rf = cos(xf)
                case 2:
                    r = tan(x)
                    rf = tan(xf)
                case 3:
                    r = asin(x)
                    rf = asin(xf)
                case 4:
                    r = acos(x)
                    rf = acos(xf)
                case 5:
                    r = atan(x)
                    rf = atan(xf)
                case 6:
                    r = sinh(x)
                    rf = sinh(xf)
                case 7:
                    r = cosh(x)
                    rf = cosh(xf)
                case 8:
                    r = tanh(x)
                    rf = tanh(xf)
                case 9:
                    r = exp(x)
                    rf = exp(xf)
                case 10:
                    r = exp2(x)
                    rf = exp2(xf)
                case 11:
                    r = log(x)
                    rf = log(xf)
                case 12:
                    r = log2(x)
                    rf = log2(xf)
                case 13:
                    r = log10(x)
                    rf = log10(xf)
                case 14:
                    r = cbrt(x)
                    rf = cbrt(xf)
                case 15:
                    r = sqrt(x)
                    rf = sqrt(xf)
                case 16:
                    r = floor(x)
                    rf = floor(xf)
                case 17:
                    r = ceil(x)
                    rf = ceil(xf)
                case 18:
                    r = round(x)
                    rf = round(xf)
                case 19:
                    r = abs(x)
                    rf = abs(xf)
                case 20:
                    r = pow(x, y)
                    rf = pow(xf, yf)
                case 21:
                    r = atan2(x, y)
                    rf = atan2(xf, yf)
                case 22:
                    r = hypot(x, y)
                    rf = hypot(xf, yf)
                case 23:
                    r = min(x, y)
                    rf = min(xf, yf)
                case 24:
                    r = max(x, y)
                    rf = max(xf, yf)
                case _:
                    if y != 0.0 and (x == x or y == y):
                        r = x % y
                    if yf != f32(0.0) and (xf == xf or yf == yf):
                        rf = xf % yf
            h = mix(h, bits(r))
            hf = mix(hf, bits32(rf))
        print(f"{n} {h:x} {hf:x}")

fn main():
    for i in 0..150:
        let f = float(i)
        print(show(f * 0.0731 - 5.0))
        print(show((f - 75.0) * 9876.54321))
        print(show(f * f * f * 123456.7 + 1e9))
    for i in 0..60:
        let f = f32(i)
        print(show32(f * f32(0.37) - f32(11.0)))
    let z = 0.0
    for x in [
        0.0,
        -z,
        1e-310,
        5e-324,
        1e-300,
        1e300,
        709.7,
        710.0,
        -745.0,
        1e22,
        3.141592653589793,
        z / z,
        1.0 / z,
        -1.0 / z
    ]:
        print(show(x))
    hashes()
