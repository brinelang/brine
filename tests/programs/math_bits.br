# sin, exp, pow and the others give the same bits on every target and
# backend: they come from the runtime's own math library, not the C
# library's (which differ in the last bit). str(float) is exact, so equal
# text means equal bits. Inputs cover small arguments, big ones (trig's
# argument reduction), and the edges.
fn show(x: float) -> str:
    let vals = [sin(x), cos(x), tan(x), exp(x), log(abs(x)), pow(abs(x), 1.37), pow(1.0001, x)]
    return " ".join([str(v) for v in vals])

fn show32(x: f32) -> str:
    let vals = [sin(x), cos(x), tan(x), exp(x), log(abs(x)), sqrt(abs(x))]
    return " ".join([str(v) for v in vals])

fn main():
    for i in 0..150:
        let f = float(i)
        print(show(f * 0.0731 - 5.0))
        print(show((f - 75.0) * 9876.54321))
        print(show(f * f * f * 123456.7 + 1e9))
    for i in 0..60:
        let f = f32(i)
        print(show32(f * f32(0.37) - f32(11.0)))
    let z = 0.0
    for x in [
        0.0,
        -z,
        1e-310,
        5e-324,
        1e-300,
        1e300,
        709.7,
        710.0,
        -745.0,
        1e22,
        3.141592653589793,
        z / z,
        1.0 / z,
        -1.0 / z
    ]:
        print(show(x))
