# A process that a rank starts is not part of its world: it doesn't inherit
# BRINE_RANK, BRINE_WORLD_SIZE or BRINE_PEERS (a brine program would try to
# join the world).
fn shell(win: str, unix: str) -> [str]:
    if os.name() == "windows":
        return ["cmd", "/c", win]
    return ["sh", "-c", unix]

fn main():
    var inherited = true
    match os.spawn(shell("echo %BRINE_PEERS%", "echo \"$BRINE_PEERS\""), {}, true, false):
        case Ok(p):
            os.wait(p)
            let (o, _) = os.output(p)
            inherited = "127.0.0.1" in o
        case Err(e):
            print("spawn failed:", e)
    let all = world.gather_all(inherited)
    if world.rank() == 0:
        print("inherited:", all)
