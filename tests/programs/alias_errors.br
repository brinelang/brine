fn add(ref xs: [int], n: int):
    xs.push(n)

fn take(ref xs: [int]) -> int:
    return xs.pop()

fn main():
    var xs = [1, 2, 3]
    add(ref xs, take(ref xs) + xs[0])
    add(ref xs, take(ref xs) + take(ref xs))
    print(xs.pop(), xs.pop())
    print(xs, xs.pop())
    xs.push(len(xs))
    add(ref xs, xs[0])
    # a call in the arguments runs first: fine
    xs.push(xs.pop())
    add(ref xs, take(ref xs))
