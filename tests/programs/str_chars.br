# `s[i]` is the character that starts at byte i, so pieces of a string are
# always UTF-8; `str.from_utf8` and the text read from outside follow RFC
# 3629 exactly.

fn show(name: str, b: [u8]):
    match str.from_utf8(b):
        case Ok(s):
            print(f"{name}: ok {s.bytes()}")
        case Err(e):
            print(f"{name}: {e}")

fn index_chars():
    let s = "aé€😀b"
    var at: [str] = []
    var i = 0
    while i < len(s):
        let c = s[i]
        at.push(f"{i}:{c}:{len(c)}:{ord(c)}")
        i += len(c)
    print(at)
    # the pieces glue back into the string, and stay UTF-8
    let glued = "a" + "é"[0] + "b"
    print(glued, glued.bytes(), len(glued.chars()), glued.upper())
    print(str.from_utf8(glued.bytes()).is_ok(), s[0] == "a", s[1] == "é", s[3] != "e")
    # ASCII compares as before, from byte 0 and from a known boundary
    print(s[len(s) - 1] == "b", "x,y"[1] == ",")

fn append_chars():
    # `s += t[i]` appends the whole character, plain and through a loop's appender
    let t = "añ€😀z"
    var s = ""
    var i = 0
    while i < len(t):
        s += t[i]
        i += len(t[i])
    print(s, s == t, len(s))
    var u = "x"
    for k in [0, 1, 3, 6, 10]:
        u += t[k]
    print(u, len(u))
    # appending a string's own character to it
    var w = "é"
    w += w[0]
    w += w[2]
    print(w, len(w))
    # longer than a word, so the block grows
    var long = "abcdefghij"
    for k in 0..5:
        long += "€"[0]
    print(long, len(long))

fn strict_utf8():
    show("ascii", [u8(104), 105])
    show("2-byte", [u8(0xc3), 0xa9])
    show("3-byte", [u8(0xe2), 0x82, 0xac])
    show("4-byte", [u8(0xf0), 0x9f, 0x98, 0x80])
    show("U+D7FF", [u8(0xed), 0x9f, 0xbf])
    show("U+E000", [u8(0xee), 0x80, 0x80])
    show("U+10FFFF", [u8(0xf4), 0x8f, 0xbf, 0xbf])
    show("C0 80", [u8(0xc0), 0x80])
    show("C1 BF", [u8(0xc1), 0xbf])
    show("E0 80 80", [u8(0xe0), 0x80, 0x80])
    show("E0 9F BF", [u8(0xe0), 0x9f, 0xbf])
    show("ED A0 80", [u8(0xed), 0xa0, 0x80])
    show("ED BF BF", [u8(0xed), 0xbf, 0xbf])
    show("F0 80 80 80", [u8(0xf0), 0x80, 0x80, 0x80])
    show("F0 8F BF BF", [u8(0xf0), 0x8f, 0xbf, 0xbf])
    show("F4 90 80 80", [u8(0xf4), 0x90, 0x80, 0x80])
    show("F5 80 80 80", [u8(0xf5), 0x80, 0x80, 0x80])
    show("FF", [u8(0xff)])
    show("80", [u8(0x80)])
    show("cut E2 82", [u8(0x61), 0xe2, 0x82])
    show("E2 28 A1", [u8(0xe2), 0x28, 0xa1])
    # past the 16-byte ASCII steps
    var b = [u8(97)] * 40
    b[33] = 0xc0
    b[34] = 0xaf
    show("long", b)

fn main():
    index_chars()
    append_chars()
    strict_utf8()
