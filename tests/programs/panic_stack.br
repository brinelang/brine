# Recursion deeper than the stack: a panic, after what was printed before.
# `main` has as much stack as a `par` thread.
fn depth(n: int) -> int:
    if n == 0:
        return 0
    return 1 + depth(n - 1)

fn main():
    let n = int(args()[0])
    print("before")
    if len(args()) > 1:
        let (d, _) = par(depth(n), 0)
        print(d)
    else:
        print(depth(n))
