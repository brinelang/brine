# Freeing a deep structure doesn't recurse once per level (that overflowed
# the stack): lists, trees deep on either side, and nesting through arrays
# and maps.
enum List:
    Nil
    Cons(v: int, rest: List)

enum Tree:
    Leaf
    Node(l: Tree, v: int, r: Tree)

enum Kids:
    N(kids: [Kids], name: str)

struct S:
    kids: [S]

struct M:
    m: {int: M}

fn main():
    let n = 300000
    var l = List.Nil
    for i in 0..n:
        l = List.Cons(i, l)
    l = List.Nil
    print("list")
    var t = Tree.Leaf
    for i in 0..n:
        t = Tree.Node(t, i, Tree.Leaf)
    t = Tree.Leaf
    for i in 0..n:
        t = Tree.Node(Tree.Leaf, i, t)
    t = Tree.Leaf
    print("trees")
    var k = Kids.N([], "x")
    for i in 0..n:
        k = Kids.N([k], "y")
    k = Kids.N([], "z")
    print("enum in an array")
    var s = S([])
    for i in 0..n:
        s = S([s])
    s = S([])
    print("struct in an array")
    var m = M({})
    for i in 0..n:
        m = M({0: m})
    m = M({})
    print("struct in a map")
