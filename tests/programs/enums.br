enum Color:
    Red
    Green
    Blue

    fn name(self) -> str:
        match self:
            case Color.Red:
                return "red"
            case Color.Green:
                return "green"
            case Color.Blue:
                return "blue"

enum Shape:
    Circle(radius: float)
    Rect(w: float, h: float)
    Empty

    fn area(self) -> float:
        match self:
            case Shape.Circle(r):
                return 3.0 * r * r
            case Shape.Rect(w, h):
                return w * h
            case Shape.Empty:
                return 0.0

enum Expr:
    Num(value: int)
    Add(left: Expr, right: Expr)
    Mul(left: Expr, right: Expr)
    Neg(inner: Expr)

fn eval(e: Expr) -> int:
    match e:
        case Expr.Num(v):
            return v
        case Expr.Add(a, b):
            return eval(a) + eval(b)
        case Expr.Mul(Expr.Num(0), _) | Expr.Mul(_, Expr.Num(0)):
            return 0
        case Expr.Mul(a, b):
            return eval(a) * eval(b)
        case Expr.Neg(x):
            return -eval(x)

fn show(e: Expr) -> str:
    match e:
        case Expr.Num(v) if v < 0:
            return f"({v})"
        case Expr.Num(v):
            return f"{v}"
        case Expr.Add(a, b):
            return f"({show(a)} + {show(b)})"
        case Expr.Mul(left=a, right=b):
            return f"{show(a)} * {show(b)}"
        case Expr.Neg(x):
            return f"-{show(x)}"

fn classify(n: int) -> str:
    match n:
        case 0:
            return "zero"
        case 1 | 2 | 3:
            return "small"
        case -1:
            return "minus one"
        case x if x < 0:
            return "negative"
        case _:
            return "big"

fn both(a: bool, b: bool) -> str:
    match (a, b):
        case (true, true):
            return "both"
        case (true, false) | (false, true):
            return "one"
        case (false, false):
            return "none"

struct Token:
    kind: Color
    text: str

fn main():
    let c = Color.Green
    print(c, c.name(), c == Color.Green, c != Color.Red)
    let shapes = [Shape.Circle(1.0), Shape.Rect(w=2.0, h=3.0), Shape.Empty]
    for s in shapes:
        print(s, s.area())
    let e = Expr.Add(Expr.Num(2), Expr.Mul(Expr.Num(3), Expr.Neg(Expr.Num(4))))
    print(show(e), "=", eval(e))
    print(eval(Expr.Mul(Expr.Num(0), e)))
    print(e == Expr.Add(Expr.Num(2), Expr.Mul(Expr.Num(3), Expr.Neg(Expr.Num(4)))))
    print(e == Expr.Num(2))
    print(e)
    for n in [0, 2, -1, -5, 10]:
        print(n, classify(n))
    print(both(true, false), both(false, false))
    let t = Token(kind=Color.Blue, text="x")
    print(t)
    var names: [str] = []
    match Shape.Rect(1.0, 2.0):
        case Shape.Rect(w, _):
            names.push(f"rect {w}")
        case _:
            pass
    print(names)
    var total = 0
    var list = [Expr.Num(1), Expr.Num(2), Expr.Neg(Expr.Num(3))]
    for x in list:
        match x:
            case Expr.Num(v):
                total += v
            case _:
                list = []
                continue
    print(total, len(list))
