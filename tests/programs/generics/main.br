import gmod

struct Pair[A, B]:
    first: A
    second: B

    fn swap(self) -> Pair[B, A]:
        return Pair(first=self.second, second=self.first)

enum Tree[T]:
    Leaf
    Node(left: Tree[T], value: T, right: Tree[T])

    fn size(self) -> int:
        match self:
            case Tree.Leaf:
                return 0
            case Tree.Node(l, _, r):
                return l.size() + 1 + r.size()

struct Stack[T]:
    items: [T]

    fn new() -> Stack[T]:
        return Stack(items=[])

    fn push(ref self, x: T):
        self.items.push(x)

    fn pop(ref self) -> Option[T]:
        if len(self.items) == 0:
            return None
        return Some(self.items.pop())

fn first[T](xs: [T]) -> Option[T]:
    if len(xs) == 0:
        return None
    return Some(xs[0])

fn largest[T](xs: [T]) -> T:
    requires len(xs) > 0
    var best = xs[0]
    for x in xs:
        if x > best:
            best = x
    return best

fn insert[T](t: Tree[T], x: T) -> Tree[T]:
    match t:
        case Tree.Leaf:
            return Tree.Node(Tree.Leaf, x, Tree.Leaf)
        case Tree.Node(l, v, r):
            if x < v:
                return Tree.Node(insert(l, x), v, r)
            return Tree.Node(l, v, insert(r, x))

fn to_list[T](t: Tree[T], ref out: [T]):
    match t:
        case Tree.Leaf:
            pass
        case Tree.Node(l, v, r):
            to_list(l, ref out)
            out.push(v)
            to_list(r, ref out)

fn parse_digit(c: str) -> Result[int, str]:
    if c == "0":
        return Ok(0)
    if c == "1":
        return Ok(1)
    return Err(f"not a digit: {c}")

fn or_else[T](o: Option[T], d: T) -> T:
    match o:
        case Some(v):
            return v
        case None:
            return d

fn wrap[T](x: T) -> [T]:
    return [x]

fn twice[T](x: T) -> [T]:
    var out = wrap[T](x)
    out.push(x)
    return out

fn count_some[T](xs: [Option[T]]) -> int:
    var n = 0
    for x in xs:
        if x.is_some():
            n += 1
    return n

fn main():
    let p = Pair(first=1, second="one")
    print(p, p.swap())
    print(first([3, 4]), first(["x"]), first[float]([]))
    print(largest([3, 9, 2]), largest(["b", "c", "a"]))
    var s = Stack[int].new()
    s.push(1)
    s.push(2)
    let p1 = s.pop()
    let p2 = s.pop()
    print(p1, p2, s.pop())
    var t: Tree[int] = Tree.Leaf
    for x in [5, 2, 8, 1, 9, 3]:
        t = insert(t, x)
    var out: [int] = []
    to_list(t, ref out)
    print(t.size(), out)
    let r = parse_digit("1")
    print(r, parse_digit("x"), r.unwrap() + 1, parse_digit("q").unwrap_or(-1))
    match first([10, 20]):
        case Some(v) if v > 5:
            print("big", v)
        case Some(v):
            print("small", v)
        case None:
            print("none")
    let o: Option[str] = None
    print(o, o.is_none(), Some(2.5).unwrap(), r.ok())
    print(Some(1) == Some(1), Some(1) == None, Pair[int, int](first=1, second=2))
    print(or_else(None, 5), or_else(Some("a"), "b"))
    let xs = [Some(1), None, Some(3)]
    print(xs, count_some(xs))
    var o2: Option[int] = None
    print(o2 == None, o2 != Some(1))
    o2 = Some(4)
    print(o2)
    print(twice("hi"), twice(Some(1.5)))
    let b = gmod.Box(value=7)
    print(b, b.get(), gmod.unbox(b), gmod.Box[str](value="s").get())
    let t2: (Option[int], Result[str, int]) = (None, Err(3))
    print(t2)
    let e: gmod.Either[int, bool] = gmod.Either.Left(1)
    print(e)
    let e2: gmod.Either[int, str] = gmod.Either.Right("r")
    match e2:
        case gmod.Either.Left(x):
            print("left", x)
        case gmod.Either.Right(y):
            print("right", y)
    var ys: [Option[int]] = []
    ys.push(None)
    ys.push(Some(2))
    print(ys)
