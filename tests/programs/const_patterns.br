const OP_ADD = 1
const OP_SUB = 2
const HI = "hi"
const ON = true
const SMALL: u8 = 7

fn run(op: int, a: int, b: int) -> int:
    match op:
        case OP_ADD:
            return a + b
        case OP_SUB:
            return a - b
        case _:
            return 0

fn greet(s: str) -> str:
    match s:
        case HI | "hello":
            return "greeting"
        case _:
            return "other"

fn main():
    print(run(OP_ADD, 5, 3), run(OP_SUB, 5, 3), run(9, 5, 3))
    print(greet("hi"), greet("hello"), greet("x"))
    let b: u8 = 7
    match b:
        case SMALL:
            print("small")
        case _:
            print("not small")
    match ON:
        case ON:
            print("on")
        case _:
            print("off")
