# Struct and tuple literals built from variables (`Span(buf=buf, ...)`)
# borrow those parts instead of retaining them, as do calls returning such
# literals and loops over a field (`for x in p.items`). Whatever keeps one
# (a return, a push, a `var`, a field) must still own its parts, and a part
# whose variable changes later must still see its own value.
struct Span:
    buf: [u8]
    start: int

struct Pair:
    a: Span
    names: [str]

fn at(sp: Span, i: int) -> int:
    return int(sp.buf[sp.start + i])

fn span(buf: [u8], start: int) -> Span:
    return Span(buf=buf, start=start)

fn both(buf: [u8], names: [str]) -> ([u8], [str]):
    return (buf, names)

fn keep(buf: [u8], start: int) -> Span:
    let sp = Span(buf=buf, start=start)
    return sp

fn total(buf: [u8]) -> int:
    var s = 0
    for i in 0..len(buf) - 1:
        let sp = Span(buf=buf, start=i)
        s += at(sp, 1)
        s += at(Span(buf=buf, start=i), 0)
        let t = (buf, i)
        s += int(t.0 [t.1])
        let h = span(buf, i)
        s += at(h, 0) + at(span(buf, i), 1)
    return s

# borrowed views pushed and returned: the array owns them
fn views(buf: [u8]) -> [Span]:
    var out: [Span] = []
    for i in 0..2:
        let sp = Span(buf=buf, start=i)
        out.push(sp)
        let h = span(buf, i)
        out.push(h)
        var w = h
        w.start += 1
        out.push(w)
    return out

struct Lits:
    items: [[u8]]
    tag: str

# recursive, so it stays a call
fn starts(buf: [u8], lit: [u8], k: int) -> bool:
    if k >= len(lit):
        return true
    if k >= len(buf) or buf[k] != lit[k]:
        return false
    return starts(buf, lit, k + 1)

fn count(p: Lits) -> int:
    var n = 0
    for lit in p.items:
        n += len(lit) + int(starts(p.items[0], lit, 0))
    for x in p.items[0]:
        n += int(x)
    return n

fn main():
    var buf = [u8(1), u8(2), u8(3), u8(4)]
    print(total(buf))
    # views that escape own their parts
    var kept: [Span] = []
    for i in 0..3:
        let sp = Span(buf=buf, start=i)
        kept.push(sp)
        kept.push(span(buf, i))
    kept.push(keep(buf, 0))
    var v = Span(buf=buf, start=0)
    let names = ["a", "b"]
    let pr = Pair(a=Span(buf=buf, start=1), names=names)
    let (b2, n2) = both(buf, names)
    # the variable changes after the view was made: the view keeps its value
    let old = Span(buf=buf, start=0)
    buf[0] = u8(9)
    buf.push(u8(5))
    print(at(old, 0), len(old.buf), at(v, 0), len(v.buf), buf[0], len(buf))
    v = Span(buf=buf, start=1)
    print(at(v, 0), at(pr.a, 0), pr.names, len(b2), n2)
    let vs = views(buf)
    buf = []
    print([at(s, 0) for s in kept], len(kept[0].buf), [at(s, 0) for s in vs])
    let p = Lits(items=[[u8(1), u8(2)], [u8(3)]], tag="t")
    print(count(p))
    let parts = par [count(p) + at(span(kept[0].buf, 0), i % 2) for i in 0..64]
    print(sum(parts))
