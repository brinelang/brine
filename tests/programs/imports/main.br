# `from module import names` brings items in unqualified; `import` still works.
from shapes.geo import Point, Dir, dist, ORIGIN_X, SIDE, pick
import shapes.geo

# constants from imported ones, and from ones further down
const SEALED = 64 + SIDE
const TWICE = LATER * 2
const LATER = 21

fn sealed(n: int) -> int:
    requires 0 <= n <= 100
    ensures result == n + 80
    return n + SEALED

fn turn(d: Dir) -> Dir:
    match d:
        case Dir.Up:
            return Dir.Down
        case Dir.Down:
            return Dir.Up

# a module's constant is a pattern too
fn on_axis(x: int) -> str:
    match x:
        case geo.ORIGIN_X:
            return "origin"
        case _:
            return "off"

fn main():
    let p = Point(x=3, y=-4)
    print(dist(p), geo.dist(p), ORIGIN_X)
    print(turn(Dir.Up), turn(geo.Dir.Down), pick("a", "b", false))
    let ps: [geo.Point] = [p, Point(x=1, y=1)]
    print(ps)
    print(on_axis(0), on_axis(2))
    print(sealed(1), SEALED, TWICE)
