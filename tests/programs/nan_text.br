# Text that reads as a NaN gives the canonical quiet NaN with its sign, on
# every backend (v09#6: the C runtime's strtod set every mantissa bit).
fn main():
    for s in ["NaN", "nan", "-NaN", "+nan", "nan(123)", " NAN\n"]:
        match s.to_float():
            case Some(v):
                print(f"{s.strip()}: {v.to_bits():x}")
            case None:
                print(f"{s.strip()}: None")
        match s.to_float[f32]():
            case Some(v):
                print(f"{s.strip()} f32: {v.to_bits():x}")
            case None:
                print(f"{s.strip()} f32: None")
    print(f"{float("-nan").to_bits():x}")
    print(f"{float.from_bits(u64(0x7ff8000000000000)).to_bits():x}")
