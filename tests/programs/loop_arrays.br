# Loops that index local arrays: the compiler loads such arrays once before
# the loop and makes the ones it writes unique there. Copies must still be
# independent, and arrays the function only borrows must be left alone.

fn count_none(xs: [Option[int]]) -> int:
    var n = 0
    for i in 0..len(xs):
        if xs[i].is_none():
            n += 1
    return n

fn fill(ref xs: [int]):
    for i in 0..len(xs):
        xs[i] = i * i

fn main():
    # a shared array is copied before the loop writes it
    var a = [1, 2, 3]
    let b = a
    for i in 0..len(a):
        a[i] *= 10
    print(a, b)

    # a borrowed parameter is only read
    let opts = [Some(1), None, Some(3), None]
    let keep = opts
    print(count_none(opts), count_none(keep), len(keep))

    # through a `ref` parameter, the caller's copy is untouched
    var sq = [0, 0, 0, 0]
    let before = sq
    fill(ref sq)
    print(sq, before)

    # nested arrays: an element copied before the loop keeps its values
    var grid = [[0, 0], [0, 0]]
    let row = grid[0]
    for i in 0..2:
        for j in 0..2:
            grid[i][j] = i * 2 + j
    print(grid, row)

    # a method that changes an element in place
    var rows: [[int]] = [[], []]
    let empty = rows
    for i in 0..len(rows):
        rows[i].push(i)
    print(rows, empty)

    # strings: the old element is released, the copy keeps its own
    var names = ["a", "b"]
    let orig = names
    var k = 0
    while k < len(names):
        names[k] = names[k] + "!"
        k += 1
    print(names, orig)

    # an array the loop replaces is not cached
    var grow = [1]
    for i in 0..3:
        grow[0] += i
        var next = grow
        next.push(i)
        grow = next
    print(grow)

    # an array declared inside the loop
    var total = 0
    for i in 0..3:
        var t = [i, i]
        t[1] += 1
        total += t[0] + t[1]
    print(total)
