# A `match` inside a loop, where release builds move the constants it tests
# out of the loop: release builds must jump straight to the case as dev
# builds do (integration.br checks each function below has a jump table),
# and every key type, or-pattern, guard and value outside the table must
# behave as the tests one by one would.

enum Op:
    Inc
    Dec
    Dbl
    Neg
    Sq
    Nop

fn ints(ops: [int]) -> int:
    var x = 1
    for op in ops:
        match op:
            case 0:
                x += 1
            case 1:
                x -= 3
            case 2:
                x *= 2
            case 3:
                x = -x
            case 4:
                x += 7
            case 5:
                x %= 1000
            case _:
                x += 100
    return x

fn negs(ops: [int]) -> int:
    var x = 0
    for op in ops:
        match op:
            case -3:
                x += 1
            case -2:
                x += 10
            case -1:
                x += 100
            case 0:
                x += 1000
            case 1:
                x += 10000
            case _:
                x -= 1
    return x

fn bytes(ops: [u8]) -> int:
    var x = 0
    for op in ops:
        match op:
            case 250:
                x += 1
            case 251:
                x += 2
            case 252:
                x += 3
            case 253:
                x += 4
            case 255:
                x += 5
            case _:
                x += 1000
    return x

fn wide(ops: [u64]) -> u64:
    var x: u64 = 0
    for op in ops:
        match op:
            case 0:
                x = x ^ 1
            case 1:
                x = x ^ 2
            case 2:
                x = x ^ 4
            case 3:
                x = x ^ 8
            case 4:
                x = x ^ 16
            case _:
                x = x ^ 1024
    return x

fn ors(ops: [int], flag: bool) -> int:
    var x = 0
    for op in ops:
        match op:
            case 0:
                x += 1
            case 1 | 2:
                x += 10
            case 3 if flag:
                x += 100
            case 4 | 5 | 6:
                x += 1000
            case 3:
                x += 10000
            case 7:
                x += 100000
            case _:
                x -= 1
    return x

fn enums(ops: [Op]) -> int:
    var x = 3
    for op in ops:
        match op:
            case Op.Inc:
                x += 1
            case Op.Dec:
                x -= 1
            case Op.Dbl:
                x *= 2
            case Op.Neg:
                x = -x
            case Op.Sq:
                x = x * x % 1009
            case Op.Nop:
                pass
    return x

# an interpreter's loop: the opcode read from the program each time
fn interp(code: [int], steps: int) -> int:
    var acc = 0
    var pc = 0
    var n = 0
    while n < steps:
        n += 1
        let op = code[pc]
        pc = (pc + 1) % len(code)
        match op:
            case 0:
                acc += 1
            case 1:
                acc -= 2
            case 2:
                acc ^= 5
            case 3:
                acc = acc * 3 % 1000
            case 4:
                pc = 0
            case 5:
                acc += pc
            case _:
                acc -= 7
    return acc

fn main():
    let xs = [i % 9 - 1 for i in 0..40]
    print(ints(xs), negs([i % 7 - 4 for i in 0..30]))
    print(bytes([u8(245 + i % 11) for i in 0..30]))
    print(wide([u64(0), 3, 4, 5, 18446744073709551615, 2, 9223372036854775808, 1]))
    print(ors([i % 10 - 1 for i in 0..30], true), ors([i % 10 - 1 for i in 0..30], false))
    print(enums([Op.Inc, Op.Dbl, Op.Sq, Op.Neg, Op.Dec, Op.Nop, Op.Sq, Op.Dbl, Op.Inc]))
    print(interp([0, 2, 3, 1, 5, 6, 0, 3, 4, 9], 1000))
