# a panic names the functions it came through
fn fib(n: int) -> int:
    if n < 2:
        return at(n)
    return fib(n - 1) + fib(n - 2)

fn at(n: int) -> int:
    let xs = [1, 2]
    return xs[n + len(args())]

fn main():
    if args()[0] == "par":
        let ys = par [at(i) for i in 0..100]
        print(ys)
    else:
        print(fib(5))
