# parallel results must not depend on the thread count
fn main():
    let n = 3_000_000
    let xs = par [float(i) * 0.25 for i in 0..n]
    let total = par sum(x * x for x in xs)
    var out = [0] * 1000
    par for i in 0..1000:
        out[i] = i * i
    print(total, par max(x for x in out), sum(x for x in out))
    let (a, b) = par(len(xs), out[999])
    print(a, b)
