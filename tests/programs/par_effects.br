# Functions that write files or read input can't be called from `par` bodies,
# however deep the call.
fn log(i: int) -> int:
    match append_file("par_log.txt", f"{i}\n"):
        case _:
            pass
    return i

fn logs_twice(i: int) -> int:
    return log(i) + log(i)

fn pure(i: int) -> int:
    return i * 2

fn through_calls(n: int) -> int:
    let a = par sum(log(i) for i in 0..n)  # E0503
    let b = par [logs_twice(i) for i in 0..n]  # E0503
    var out = [0] * n
    par for i in 0..n:
        out[i] = log(i)  # E0503
    let (x, y) = par(pure(1), log(2))  # E0503
    # fine: outside `par`, or only in the iterable
    let c = log(1) + par sum(pure(i) for i in [log(2)])
    return a + len(b) + x + y + c

fn main():
    print(through_calls(2))
