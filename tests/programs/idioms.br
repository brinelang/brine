# Loops release builds run as one operation (compiler/idiom.br), on arrays
# kept as bytes (compiler/narrow.br) and on plain ones, with lengths that fit
# in 16 bytes and ones that don't.

fn shuffled(n: int, seed: int) -> [int]:
    var a = [i for i in 0..n]
    var s = seed
    for x in 0..n:
        s = (s * 1103515245 + 12345) % 2147483648
        let y = s % n
        let t = a[x]
        a[x] = a[y]
        a[y] = t
    return a

# Topswops: reverse the first a[0] + 1 elements until a[0] is 0. `a` is
# bytes while n <= 256, and the reversals get longer than 16 when n > 16.
fn flips(n: int, seed: int) -> (int, int):
    var a = [i for i in 0..n]
    var s = seed
    for x in 0..n:
        s = (s * 1103515245 + 12345) % 2147483648
        let y = s % n
        let t = a[x]
        a[x] = a[y]
        a[y] = t
    var count = 0
    var k = a[0]
    while k != 0:
        var i = 0
        var j = k
        while i < j:
            let t = a[i]
            a[i] = a[j]
            a[j] = t
            i += 1
            j -= 1
        count += 1
        k = a[0]
    var h = 0
    for x in 0..n:
        h = (h * 31 + a[x]) % 1000000007
    return (count, h)

# The same on an array of large values, never bytes.
fn flips_wide(n: int, seed: int) -> int:
    let p = shuffled(n, seed)
    var a = [v * 1000 for v in p]
    var count = 0
    var k = a[0] / 1000
    while k != 0:
        var i = 0
        var j = k
        while i < j:
            let t = a[i]
            a[i] = a[j]
            a[j] = t
            i += 1
            j -= 1
        count += 1
        k = a[0] / 1000
    return count

# Rotations of a[0..=r], copies and shifts, as bytes.
fn rotations(n: int, rounds: int) -> int:
    var a = [i for i in 0..n]
    var b = [0] * n
    var r = 0
    var h = 0
    for _ in 0..rounds:
        let x = a[0]
        for i in 0..r:
            a[i] = a[i + 1]
        a[r] = x
        r = (r + 3) % n
        for i in 0..n:
            b[i] = a[i]
        for i in 1..n - 1:
            b[i] = b[i + 1]
        for i in 0..n:
            h = (h * 7 + b[i]) % 1000000007
    return h

# The same on floats, strings and wide integers: plain arrays.
fn rotations_plain(n: int, rounds: int) -> str:
    var f = [float(i) / 2.0 for i in 0..n]
    var s = [str(i) for i in 0..n]
    var w = [i * 100000 for i in 0..n]
    var g = [0.0] * n
    var r = 1
    for _ in 0..rounds:
        let x = f[0]
        for i in 0..r:
            f[i] = f[i + 1]
        f[r] = x
        let y = s[0]
        for i in 0..r:
            s[i] = s[i + 1]
        s[r] = y
        let z = w[2]
        for i in 2..r:
            w[i] = w[i + 1]
        w[r] = z
        for i in 0..n:
            g[i] = f[i]
        r = (r + 5) % n
    return f"{g[0]} {g[n - 1]} {s[0]} {s[n - 1]} {w[0]} {w[2]} {w[n - 1]}"

fn main():
    for n in [1, 5, 11, 16, 17, 23, 40, 64, 256, 300]:
        let (c, h) = flips(n, 7)
        print(f"flips({n}) = {c} {h} {flips_wide(n, 7)}")
    for n in [1, 2, 15, 16, 17, 33]:
        print(f"rotations({n}) = {rotations(n, 200)}")
    for n in [3, 9, 30]:
        print(f"rotations_plain({n}) = {rotations_plain(n, 50)}")
