# A lexer whose loop keeps `invariant i >= 0` through an `elif` chain whose
# branches know too much to merge (v091 lab R1): 0.9.1 said the invariant
# might not be preserved (E0604), with the impossible value i = -1.
const T_NUM = 1
const T_LBRACK = 10

struct Tok:
    kind: int
    text: str
    num: float
    pos: int

fn is_ident_byte(b: u8, first: bool) -> bool:
    if ((b >= u8(97) and b <= u8(122))):
        return true
    return not first and b >= u8(48) and b <= u8(57)

fn is_digit(b: u8) -> bool:
    return b >= u8(48) and b <= u8(57)

fn lex(src: str) -> Result[[Tok], str]:
    let b = src.bytes()
    var toks: [Tok] = []
    var i = 0
    while i < len(b):
        invariant i >= 0
        let c = b[i]
        if c == u8(40):
            i += 1
            i += 1
        elif c == u8(123):
            i += 1
        elif c == u8(125):
            i += 1
            var j = i + 1
            while j < len(b) and b[j] != u8(93):
                j += 1
            if j >= len(b):
                return Err(f"unclosed '[' at {i}")
            toks.push(Tok(kind=T_LBRACK, text=src[i + 1:j].strip(), num=0.0, pos=i))
            i = j + 1
        elif c == u8(44):
            i += 1
        elif c == u8(34) or c == u8(39) or c == u8(96):
            let q = c
            var j = i + 1
            var parts: [str] = []
            var seg = j
            while j < len(b) and b[j] != q:
                j += 1
            parts.push(src[seg:j])
            i = j + 1
        elif is_digit(c) or (c == u8(46) and i + 1 < len(b) and is_digit(b[i + 1])):
            var j = i
            while (
                j < len(b)
                and (
                    is_digit(b[j])
                    or b[j] == u8(101)
                    or b[j] == u8(69)
                    or b[j] == u8(120)
                    or b[j] == u8(88)
                    or (b[j] >= u8(97) and b[j] <= u8(102))
                    or (b[j] >= u8(65) and b[j] <= u8(70))
                    or (
                        (b[j] == u8(43) or b[j] == u8(45))
                        and j > i
                        and (b[j - 1] == u8(101) or b[j - 1] == u8(69))
                    )
                )
            ):
                j += 1
            var k = j
            while (
                k < len(b)
                and (
                    b[k] == u8(115)
                    or b[k] == u8(109)
                    or b[k] == u8(104)
                    or b[k] == u8(100)
                    or b[k] == u8(119)
                    or b[k] == u8(121)
                    or is_digit(b[k])
                )
            ):
                k += 1
            let word = src[i:k]
            let ns = src[i:j]
            var v = 0.0
            if ns.starts_with("0x") or ns.starts_with("0X"):
                var acc = 0.0
                for d in ns[2:].bytes():
                    var dv = 0
                    acc = acc * 16.0 + float(dv)
                v = acc
            else:
                match ns.to_float():
                    case Some(x):
                        v = x
                    case None:
                        return Err(f"bad number '{ns}' at {i}")
            toks.push(Tok(kind=T_NUM, text=word, num=v, pos=i))
            i = k
        elif is_ident_byte(c, true):
            var j = i
            while j < len(b) and is_ident_byte(b[j], j == i):
                j += 1
            let word = src[i:j]
            let lw = word.lower()
            if lw == "inf" or lw == "nan":
                toks.push(
                    Tok(
                        kind=T_NUM,
                        text=word,
                        num=float.from_bits(u64(0x7ff8000000000000))
                        if lw == "nan"
                        else word.to_float().unwrap_or(0.0),
                        pos=i
                    )
                )
            var op = ""
            let two = src[i:i + 2] if i + 2 <= len(b) and b[i + 1] < u8(128) else ""
            if (two == "==" or two == ">=" or two == "=~" or two == "!~"):
                op = two
            elif (
                c == u8(43)
                or c == u8(45)
                or c == u8(42)
                or c == u8(47)
                or c == u8(37)
                or c == u8(94)
                or c == u8(60)
                or c == u8(62)
                or c == u8(61)
            ):
                op = src[i:i + 1]
            i += 1
        else:
            i += 1
    return Ok(toks)

fn main():
    match lex("}xa] 'q' 12e3s nan"):
        case Ok(ts):
            print(len(ts), [t.text for t in ts], ts[1].num, ts[2].kind)
        case Err(e):
            print(e)
