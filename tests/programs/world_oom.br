# Rank 1 runs out of memory while rank 0 waits for it: `brine run` names
# rank 1 as the failure and stops rank 0 before it reports rank 1 missing.
fn main():
    if world.rank() == 1:
        let n = 1 << 50
        let xs = [0] * n
        print(len(xs))
    world.barrier()
    print("unreachable")
