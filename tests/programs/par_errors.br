# `par` bodies that would race: each marked line must get that error, and no
# other line an error (tests/integration.br).
fn over_elems(xs: [int]) -> [int]:
    var out = [0] * 4
    # the elements may repeat: two iterations would write the same element
    par for x in xs:
        out[x] = 1  # E0501
    return out

fn over_enumerate(xs: [int]) -> [int]:
    var out = [0] * len(xs)
    par for i, x in enumerate(xs):
        out[i] = x  # E0501
    return out

fn other_index(n: int) -> [int]:
    var out = [0] * (n + 1)
    par for i in 0..n:
        out[i] = 0
        out[i + 1] = i  # E0501
    return out

fn read_other(n: int) -> [int]:
    var out = [0] * (n + 1)
    par for i in 0..n:
        out[i] = out[i + 1]  # E0502
    return out

fn strided(n: int) -> [int]:
    var out = [0] * (3 * n + 3)
    par for i in 0..n:
        out[2 * i] = 1
        out[2 * i + 2] = 1  # E0501
    par for i in 0..n:
        out[2 * i] = 1
        out[3 * i + 1] = 1  # E0501
    par for i in 0..n:
        out[2 * i + 1] = out[2 * i + 3]  # E0502
    par for i in 0..n:
        out[i * i] = 1  # E0501
    # fine: the even elements are only read, the odd ones only written
    par for i in 0..n:
        out[2 * i + 1] = out[2 * i] + out[2 * i + 2]
    return out

fn main():
    print(strided(3))
    print(over_elems([1, 1]), over_enumerate([1]), other_index(3), read_other(3))
