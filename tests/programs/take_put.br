# Taking an array out of a place (`var w = p; p = []`) and putting it back
# (`p = w` as w's last use) move it instead of copying it, and every other
# variable still sees its own value.
struct Bag:
    items: [int]
    n: int

fn idx(k: int) -> int:
    return k % 3

fn main():
    var xs: [[int]] = [[i, i + 1] for i in 0..3]
    let before = xs
    for k in 0..30:
        let i = k % 3
        var w = xs[i]
        xs[i] = []
        w.push(k)
        xs[i] = w
    print("take/put:", [len(x) for x in xs], xs[0][0], xs[2][11])
    print("copy kept:", before)
    # a field, and a two-level place
    var b = Bag(items=[1], n=0)
    var w = b.items
    b.items = []
    w.push(2)
    b.items = w
    print("field:", b.items)
    var grid: [[[int]]] = [[[1], [2]], [[3], [4]]]
    for r in 0..2:
        for c in 0..2:
            var cell = grid[r][c]
            grid[r][c] = []
            cell.push(r * 10 + c)
            grid[r][c] = cell
    print("grid:", grid)
    var ys: [[int]] = [[1], [2]]
    var j = 0
    var y = ys[j + b.n]
    ys[j + b.n] = []
    print("taken:", y, ys)
    ys[j] = y
    # still used afterwards: a copy
    var z = [5]
    ys[0] = z
    z.push(6)
    print("used later:", ys[0], z)
    # declared outside the loop: each slot shares it until written
    var shared = [7]
    for i in 0..2:
        ys[i] = shared
    ys[0].push(8)
    print("shared:", ys, shared)
    # a different place, or an index that is a call: plain copies
    var p = ys[0]
    ys[1] = []
    print("other place:", p, ys)
    var q = ys[idx(3)]
    ys[idx(3)] = []
    q.push(1)
    print("call index:", q, ys)
    # leaving the loop between taking and putting back
    var zs: [[int]] = [[1], [2], [3]]
    for i in 0..3:
        var t = zs[i]
        zs[i] = []
        if i == 1:
            continue
        if i == 2:
            break
        t.push(9)
        zs[i] = t
    print("left early:", zs)
    # the whole variable
    var all = [1, 2]
    var old = all
    all = []
    all.push(3)
    old.push(4)
    print("whole:", all, old)
