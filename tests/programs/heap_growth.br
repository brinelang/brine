# Many small blocks live at once, some freed and reused, with big arrays in
# between: the WebAssembly runtime takes its chunks for small blocks from
# regions that grow with the heap.
enum Tree:
    Leaf(v: int)
    Node(l: Tree, r: Tree)

fn build(d: int, v: int) -> Tree:
    if d == 0:
        return Tree.Leaf(v)
    return Tree.Node(build(d - 1, v), build(d - 1, v + 1))

fn total(t: Tree) -> int:
    match t:
        case Tree.Leaf(v):
            return v
        case Tree.Node(l, r):
            return total(l) + total(r)

fn main():
    var keep: [Tree] = []
    var bigs: [[int]] = []
    for batch in 0..4:
        for i in 0..20_000:
            keep.push(build(4, i))
        bigs.push([batch] * 100_000)
        # free every other tree, then build again in their place
        for i in 0..len(keep):
            if i % 2 == 1:
                keep[i] = Tree.Leaf(i)
        var s = 0
        for t in keep:
            s += total(t)
        print(batch, len(keep), s, len(bigs[batch]))
    var words: [str] = []
    for i in 0..50_000:
        words.push(f"w{i}")
    print(len(words), words[49_999])
