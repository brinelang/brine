# Branches that make different `world` calls, or the same ones in a
# different order, are still rejected; so are guards that aren't exactly
# "one rank".
fn work(r: int) -> int:
    if r == 0:
        let a = world.sum(1)
        return a
    else:
        let b = world.sum(2)
    # only the ranks that didn't return get here
    return world.sum(3)

fn all_ok(ok: bool) -> bool:
    if world.size() > 2:
        return world.all(ok)
    return ok

fn main():
    let r = world.rank()
    var t = 0
    if r == 0:
        t = world.sum(1)  # E0510
    else:
        t = world.max(1)  # E0510
    if r == 0:
        t = world.sum(1)  # E0510
        world.barrier()  # E0510
    else:
        world.barrier()  # E0510
        t = world.sum(1)  # E0510
    if r == 0:
        t = world.sum(1)  # E0510
    elif r == 1:
        t = world.sum(2)  # E0510
    var xs = [1, 2]
    if r == 0:
        xs = world.sum([1, 2])
    else:
        xs = world.sum([1])
    if r == 0:
        xs.push(world.sum(1))  # E0510
    else:
        xs.push(int(world.sum(1.0)))  # E0510
    var f = 0.0
    if r == 0:
        f = world.broadcast(0, 1.0)  # E0510
    else:
        f = world.broadcast(1, 1.0)  # E0510
    if r == 0:
        f = world.shift(1.0, 1)  # E0510
    else:
        f = world.shift(1.0, 2)  # E0510
    for i in 0..3:
        if r == i:
            world.barrier()  # E0510
            break
        else:
            world.barrier()  # E0510
    world.barrier()
    print(work(r))  # E0511
    if not all_ok(r == 0):
        return
    world.barrier()  # E0510
    if world.size() > 1 and r == 0:
        world.barrier()  # E0510
    var x = 0
    if world.size() > 1:
        x = r
    if x == 0:
        world.barrier()  # E0510
    print(t, xs, f)
