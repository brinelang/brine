fn main():
    if os.name() == "linux":
        world.barrier()
    if os.cpu_count() > 4:
        world.barrier()
    let n = world.sum(1) if os.is_file("x") else 0
    let same = world.broadcast(0, os.cwd())
    if same == "/":
        world.barrier()
    print(n)
    # each rank reads its own stdin; pure functions are the same everywhere
    if input().is_some():
        world.barrier()
    let m = world.sum(1) if read_stdin().is_ok() else 0
    if atan(1.0) > 0.5 and u64(3).count_ones() == 2 and "7".to_int() == Some(7):
        world.barrier()
    print(m)
