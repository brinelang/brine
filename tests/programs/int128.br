fn fact(n: int) -> u128:
    var r: u128 = 1
    for i in 1..=n:
        r *= u128(i)
    return r

fn basics():
    let big: i128 = 170141183460469231731687303715884105727
    let neg: i128 = -170141183460469231731687303715884105727 - 1
    print(big, neg)
    let u: u128 = u128(big) * 2 + 1
    print(u, f"{u:x}", f"{255:b}")
    print(fact(34))
    let x: i128 = 12345678901234567890123
    print(x / 7, x % 7, -x / 7, -x % 7, x << 3, x >> 70)
    print(i128("-98765432109876543210987654321"), u128("340282366920938463463374607431768211455"))
    print(u64("18446744073709551615"), int(x / 1000000000000000))
    var m: {i128: str} = {}
    m[x] = "big"
    m[x + 1] = "bigger"
    print(m[x], len(m))
    print(f"{big:>45}|", float(u), [x, -x])
    let small: u8 = u8(u128(200))
    print(small, i128(-5) / 2)

fn inc(x: i128) -> i128:
    requires x > 0
    ensures result > x
    return x + 1

fn half(x: u128) -> u128:
    ensures result <= x
    return x / 2

fn proofs():
    let a = inc(5)
    prove a > 5
    print(inc(5), half(u128(9)))

const U128_TOP: u128 = 340282366920938463463374607431768211455

fn main():
    basics()
    proofs()
    let top: u128 = 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff
    print(top == U128_TOP, top, top / 3, top - 170141183460469231731687303715884105728)
