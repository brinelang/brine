# Each kind of runtime panic, with its line of help. The value comes from
# the second argument, so the compiler can't see the panic coming.
fn main():
    let w = args()[0]
    let n = int(args()[1])
    let xs = [1, 2, 3]
    let m = {"a": 1}
    if w == "index":
        print(xs[n])
    elif w == "slice":
        print(xs[n:2])
    elif w == "char":
        print("é"[0:n])
    elif w == "none":
        print("ab".find(w).unwrap())
    elif w == "err":
        let r: Result[int, str] = Err(w) if n > 0 else Ok(n)
        print(r.unwrap())
    elif w == "div":
        print(10 / n)
    elif w == "rem":
        print(10 % n)
    elif w == "add":
        print(9223372036854775807 + n)
    elif w == "conv":
        print(u8(n))
    elif w == "float":
        print(int(float(n) * 1e300))
    elif w == "int":
        print(int(w))
    elif w == "parse":
        print(float(w))
    elif w == "key":
        print(m[w])
    elif w == "pop":
        var ys = [i for i in 0..n]
        ys.pop()
        ys.pop()
    elif w == "max":
        let ys = [i for i in 0..n]
        print(max(ys))
    else:
        # the program's own message: no help
        panic(f"index {n} is out of bounds for an array of length 3")
