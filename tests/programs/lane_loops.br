# Interleaved loops (jam.br) that native release builds run as AVX2 vectors
# (vlane.br): each must print what it does one iteration at a time.

# escape times: float math, a comparison, a `break`
fn escape(n: int, m: int) -> (int, int):
    var inside = 0
    var steps = 0
    for p in 0..n:
        let cr = 3.0 * float(p) / float(n) - 2.0
        let ci = float(p % 7) / 7.0 - 0.5
        var zr = 0.0
        var zi = 0.0
        var i = 0
        var out = false
        while i < m:
            let tr = zr * zr - zi * zi + cr
            zi = 2.0 * zr * zi + ci
            zr = tr
            if zr * zr + zi * zi > 4.0:
                out = true
                break
            i += 1
        if not out:
            inside += 1
        steps += i
    return (inside, steps)

# integer comparisons of every kind, and integer and boolean operations
fn ints(n: int) -> int:
    var total = 0
    for p in 0..n:
        var a = p & 255
        var b = (p ^ 77) & 255
        var odd = false
        var c = 0
        while c < 30:
            if a < b:
                a = (a ^ c) | 1
            if a <= (b | 2):
                b = b & (a | 64)
            if b >= a:
                odd = not odd
            if a == b or b != 5:
                a = (a ^ 5) & 1023
            if a > b and not odd:
                b = b ^ (a | 3)
            odd = odd != (c == 7)
            c += 1
        total += (a ^ b) | (256 if odd else 0)
    return total

# comparisons with NaN, which only != holds
fn nans(n: int) -> float:
    var count = 0.0
    for p in 0..n:
        var x = float(p) - 2.0
        var hits = 0.0
        var k = 0
        while k < 10:
            let y = x / (x - x)
            if y < 1.0 or y <= 1.0 or y > 1.0 or y >= 1.0 or y == y:
                hits += 1.0
            if y != y:
                hits += 2.0
            x = x * 0.5 + 1.0
            k += 1
        count += hits
    return count

fn main():
    for n in [0, 1, 7, 8, 9, 17, 103]:
        print(n, escape(n, 60), ints(n), nans(n))
