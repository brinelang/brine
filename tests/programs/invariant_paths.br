# An invariant locks only what it reads: a path of fields, and for
# `len(...)` only the length (storing an element keeps it).
struct Inner:
    lo: int
    note: str

struct Table:
    inner: Inner
    keys: [u32]
    grid: [[int]]
    m: {str: int}
    invariant self.inner.lo >= 0
    invariant len(self.keys) == 4
    invariant len(self.grid) == 2
    invariant len(self.m) < 10

fn set(ref x: u32):
    x = u32(9)

fn free(ref t: Table):
    t.inner.note = "x"
    t.keys[1] = u32(3)
    t.keys[2] += u32(1)
    set(ref t.keys[3])
    t.grid[0].push(5)
    t.grid[1] = [7]
    # still known after the changes
    prove len(t.keys) == 4

fn locked(ref t: Table):
    t.inner.lo = -1
    t.inner = Inner(lo=0, note="")
    t.keys.push(u32(1))
    t.keys = []
    t.m["k"] = 1

fn main():
    var t = Table(inner=Inner(lo=0, note=""), keys=[u32(0)] * 4, grid=[[1], [2]], m={})
    free(ref t)
    locked(ref t)
