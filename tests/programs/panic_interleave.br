# A sum that overflows in a loop release builds run several iterations at a
# time (here the 4th): the panic must be the sum's, as one at a time.
fn main():
    let n = int("9")
    var total = int("9223372036854775457")
    for i in 0..n:
        var s = 0.0
        for j in 0..4:
            s += float(j)
        if s > 1.0:
            total += i % 10 * 100 + 1
    print(total)
