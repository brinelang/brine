# A `par` map that reads an array of arrays (tests: "GPU auto doesn't copy
# arrays of arrays that cost more than the work").
fn deg(outs: [[int]], v: int) -> int:
    var s = 0
    for w in outs[v]:
        s += w
    return s

fn main():
    let n = 300_000
    let outs = [[v % 7, v % 5, 1] for v in 0..n]
    let vs = [v for v in 0..n]
    var t = 0
    for _ in 0..4:
        let a = par [deg(outs, v) for v in vs]
        t += a[n - 1] + a[n / 2]
    print(t)
