enum Shape:
    Circle(radius: float)
    Rect(w: float, h: float)
    Empty

enum Expr:
    Num(value: int)
    Add(left: Expr, right: Expr)

fn f(s: Shape) -> float:
    match s:
        case Shape.Circle(r):
            return r
        case Shape.Empty:
            return 0.0

fn g(n: int) -> int:
    match n:
        case 0:
            return 1
        case 1:
            return 2

fn h(e: Expr) -> int:
    match e:
        case Expr.Num(v):
            return v
        case Expr.Add(Expr.Num(a), _):
            return a

fn k(s: Shape) -> float:
    match s:
        case Shape.Circle:
            return 1.0
        case Shape.Square(x):
            return x
        case Circle(r):
            return r
        case Shape.Rect(w):
            return w
        case _:
            return 0.0

fn m(s: Shape):
    let a = Shape.Circle
    let b = Shape.Empty()
    let c = Shape.Cirle(1.0)
    let d = Shape.Rect(w=1.0, height=2.0)
    print(s.radius)
    match s:
        case 1:
            pass
        case _:
            pass
        case Shape.Empty:
            pass

