# Reads its standard input line by line with `input()`, or all at once with
# `read_stdin()` when given `all`. tests/integration.br pipes text into it.
fn main():
    let a = args()
    if len(a) > 0 and a[0] == "all":
        match read_stdin():
            case Ok(t):
                print(len(t), "bytes:", t.replace("\r", "<CR>").replace("\n", "<LF>"))
            case Err(e):
                print("error:", e)
        return
    var n = 0
    while true:
        match input(f"{n}> "):
            case Some(line):
                print(f"[{line}]")
                n += 1
            case None:
                break
    print("end after", n)
