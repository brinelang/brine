# Reference counts are plain increments while one thread runs and locked ones
# while a `par` construct runs: the counts must stay exact across the switches
# (the leak check at exit sees every value freed once).

struct Rec:
    name: str
    tags: [str]

enum Tree:
    Leaf(s: str)
    Node(l: Tree, r: Tree)

fn build(d: int, s: str) -> Tree:
    if d == 0:
        return Tree.Leaf(s)
    return Tree.Node(build(d - 1, s + "l"), build(d - 1, s + "r"))

fn size(t: Tree) -> int:
    match t:
        case Tree.Node(l, r):
            return size(l) + size(r)
        case Tree.Leaf(s):
            return len(s)

fn tag_len(r: Rec, k: int) -> int:
    var n = len(r.name)
    for s in r.tags:
        let c = s
        n += len(c) + k % 2
    return n

fn work(t: Tree, rs: [Rec], k: int) -> int:
    var n = size(t)
    var mine: [Rec] = []
    for r in rs:
        n += tag_len(r, k)
        mine.push(r)
    return n + len(mine)

fn main():
    let shared = "shared" + str(1)
    let rs = [Rec(name=shared + str(i), tags=[shared, str(i) + "x"]) for i in 0..50]
    let t = build(8, shared)
    for round in 0..3:
        # one thread
        var keep: [Rec] = []
        for r in rs:
            keep.push(r)
        # many threads copying and dropping the same values
        let ns = par [work(t, keep, i) for i in 0..256]
        let total = par sum(work(t, rs, i) for i in 0..256)
        var out = [""] * 256
        par for i in 0..256:
            out[i] = rs[i % 50].name + shared
        let made = par [Rec(name=shared + str(i), tags=rs[i % 50].tags) for i in 0..256]
        let (a, b) = par(work(t, rs, 1), size(t))
        # and back to one thread with what they made
        var names: [str] = []
        for m in made:
            names.push(m.name)
            keep.push(m)
        print(round, ns[0], ns[255], total, out[7], a, b, len(keep), names[200], made[3].tags)
