# What the notes of failed proofs say (see tests/integration.br): values
# named as in the source, only the part of a claim that isn't proven, and
# why a loop's invariant isn't kept.
struct S:
    k: int
    xs: [int]

fn mk(n: int) -> S:
    requires n >= 1
    ensures len(result.xs) == n
    return S(k=n, xs=[0] * n)

fn named(n: int, i: int) -> int:
    requires n >= 1 and i <= n
    let t = mk(n)
    prove i < len(t.xs)
    return t.xs[i]

fn pair(n: int) -> (int, int):
    return (n, n - 5)

fn unpacked(n: int) -> int:
    let (a, end) = pair(n)
    prove end >= 0
    return a

fn part(i: int, m: int) -> int:
    requires i >= 0 and m % 4 == 0
    prove i >= 0 and i < 5 and m > 0
    return i

fn inner(xs: [int], n: int) -> int:
    requires n == len(xs)
    var bi = -1
    var i = 0
    while i < 10:
        invariant -1 <= bi < n
        for k in 0..n:
            if xs[k] > 0:
                bi = k
        i += 1
    return bi

fn next(n: int) -> int:
    var s = 0
    for p in 0..n:
        invariant s == p
        s += 2
    return s

fn main():
    print(named(3, 2), unpacked(9), part(1, 4), inner([1], 1), next(1))
