# Enums with small payloads that can't hold themselves are stored inline
# (no box); the others stay boxed. Both must behave the same.

enum Val:
    Nil
    Int(n: int)
    Real(x: float)
    Text(s: str)
    List(items: [int])

    fn show(self) -> str:
        match self:
            case Val.Nil:
                return "nil"
            case Val.Int(n):
                return f"{n}"
            case Val.Real(x):
                return f"{x}"
            case Val.Text(s):
                return s
            case Val.List(xs):
                return f"{xs}"

enum Key:
    Nothing
    Num(n: int)
    Name(s: str)

struct Pt:
    x: int
    y: int

enum Hit:
    Miss
    At(p: Pt, name: str)

# over 64 bytes of payload: boxed
enum Big:
    Small
    Wide(a: (int, int, int, int), b: (int, int, int, int), c: int)

# can hold itself: boxed, holding an inline Option
enum Tree:
    Leaf(v: Option[int])
    Node(l: Tree, r: Tree)

struct Holder:
    v: Val
    o: Option[str]

fn half(i: int) -> Option[int]:
    if i % 2 != 0:
        return None
    return Some(i / 2)

fn digit(s: str) -> Result[int, str]:
    if len(s) == 1 and "0" <= s and s <= "9":
        return Ok(int(s))
    if s.starts_with("-"):
        return Ok(-1)
    return Err(f"not a digit: {s}")

fn parse_pos(s: str) -> Result[int, str]:
    let n = digit(s)?
    if n < 0:
        return Err(f"{n} is negative")
    return Ok(n)

fn quarter(i: int) -> Option[int]:
    let h = half(i)?
    return half(h)

fn add(a: Val, b: Val) -> Val:
    match (a, b):
        case (Val.Int(x), Val.Int(y)):
            return Val.Int(x + y)
        case (Val.Text(x), Val.Text(y)):
            return Val.Text(x + y)
        case _:
            return Val.Nil

fn sum_tree(t: Tree) -> int:
    match t:
        case Tree.Leaf(Some(v)):
            return v
        case Tree.Leaf(None):
            return 0
        case Tree.Node(l, r):
            return sum_tree(l) + sum_tree(r)

# a tuple only for the match: borrows `t`, owns the new string
fn pair_kind(t: Tree, s: str) -> str:
    match (t, s + "!", half(len(s))):
        case (Tree.Leaf(Some(v)), x, Some(h)):
            return f"{x} {v} {h}"
        case (Tree.Leaf(_), x, _):
            return x
        case _:
            return "node"

fn first_word(s: str) -> Option[str]:
    for w in s.split(" "):
        if w != "":
            return Some(w)
    return None

fn bump(ref v: Val):
    match v:
        case Val.Int(n):
            v = Val.Int(n + 1)
        case _:
            pass

fn main():
    # Option and Result of scalars and strings
    print(half(4), half(3), quarter(8), quarter(6))
    print(parse_pos("7"), parse_pos("-3"), parse_pos("x"), parse_pos("x").is_err())
    print(first_word("  hello world"), first_word("   "))
    var c = 0
    for i in 0..1000:
        c += half(i).unwrap_or(0)
    print(c)

    # values with strings and arrays inside
    let t = Val.Text("ab")
    var acc = Val.Text("")
    for i in 0..5:
        acc = add(acc, t)
    print(acc, acc.show(), add(Val.Int(2), Val.Int(3)), add(t, Val.Int(1)))
    let l = Val.List([1, 2, 3])
    var l2 = l
    match l2:
        case Val.List(xs):
            var ys = xs
            ys.push(4)
            l2 = Val.List(ys)
        case _:
            pass
    print(l, l2)

    # arrays of inline enums
    var vs: [Val] = [Val.Nil] * 3
    vs[0] = Val.Int(7)
    vs[1] = Val.Text("seven")
    vs.push(Val.Real(7.5))
    vs.push(Val.List([7]))
    let last = vs.pop()
    print(vs, last, len(vs))
    print(Val.Text("seven") in vs, Val.Text("eight") in vs, vs.index(Val.Real(7.5)))
    var shown: [str] = []
    for v in vs:
        shown.push(v.show())
    print(" ".join(shown))
    bump(ref vs[0])
    print(vs[0])

    # equality, hashing (map keys and values)
    print(Val.Int(1) == Val.Int(1), Val.Int(1) == Val.Int(2), Val.Int(1) == Val.Real(1.0))
    print(Val.Text("a") == Val.Text("a"), Some("x") == Some("x"), Some(1) != None)
    var m: {Key: Option[str]} = {}
    m[Key.Num(1)] = Some("one")
    m[Key.Name("two")] = Some("2")
    m[Key.Nothing] = None
    m[Key.Num(1)] = Some("uno")
    print(m, m[Key.Name("two")], m.get(Key.Num(1)), m.get(Key.Num(9)))
    var om: {Option[int]: int} = {}
    for i in 0..10:
        let k = half(i)
        om[k] = om.get(k, 0) + 1
    print(om)

    # structs and enums inside each other
    let h = Hit.At(Pt(x=1, y=2), "here")
    let hs = [h, Hit.Miss, Hit.At(Pt(x=3, y=4), "there")]
    for x in hs:
        match x:
            case Hit.At(p, n) if p.x > 1:
                print("far", n, p)
            case Hit.At(p, n):
                print("near", n, p.y)
            case Hit.Miss:
                print("miss")
    let hd = Holder(v=Val.Text("held"), o=Some("opt"))
    var hd2 = hd
    hd2.o = None
    print(hd, hd2)
    let oo: Option[Option[int]] = Some(None)
    print(oo, Some(Some(3)), oo == Some(None))

    # boxed enums next to inline ones
    let b = Big.Wide((1, 2, 3, 4), (5, 6, 7, 8), 9)
    print(b, Big.Small, b == Big.Small)
    let tr = Tree.Node(Tree.Leaf(Some(4)), Tree.Node(Tree.Leaf(None), Tree.Leaf(Some(5))))
    print(sum_tree(tr), tr)
    print(pair_kind(Tree.Leaf(Some(1)), "ab"), pair_kind(Tree.Leaf(None), "abc"), pair_kind(tr, ""))

    # in parallel code
    let xs = [i for i in 0..100]
    let hv = par [half(x) for x in xs]
    var n = 0
    for o in hv:
        match o:
            case Some(v):
                n += v
            case None:
                pass
    print(n, hv[2], hv[3])
    let words = par [Val.Text(f"w{x}") for x in 0..4]
    print(words)
