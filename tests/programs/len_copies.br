# Copy loops bounded by an array's length (`for j in 0..len(src)`) run as
# one copy in release builds, as loops bounded by a local do
# (compiler/idiom.br), for bytes and for wider elements.

fn copy_bytes(src: [u8], lo: int) -> [u8]:
    var out = [u8(0)] * (len(src) + 3)
    for j in lo..len(src):
        out[j] = src[j]
    return out

fn copy_ints(src: [int]) -> [int]:
    var out = [0] * len(src)
    for j in 0..len(out):
        out[j] = src[j]
    return out

fn shift_down(a: [i32]) -> [i32]:
    var b = a
    for i in 0..len(b) - 1:
        b[i] = b[i + 1]
    return b

fn sum_u8(a: [u8]) -> int:
    var s = 0
    for i, x in enumerate(a):
        s += int(x) * (i + 1)
    return s

fn main():
    var h = 0
    for n in 0..40:
        var src = [u8(0)] * n
        var wide = [0] * n
        var w32 = [i32(0)] * n
        for i in 0..n:
            src[i] = u8((i * 37 + n) & 255)
            wide[i] = i * 1000003 - n
            w32[i] = i32(i * 7 - 20)
        for lo in 0..n + 2:
            h = (h * 31 + sum_u8(copy_bytes(src, lo))) % 1000000007
        let c = copy_ints(wide)
        let s = shift_down(w32)
        for i in 0..n:
            h = (h * 31 + c[i] + int(s[i])) % 1000000007
    print(h)
