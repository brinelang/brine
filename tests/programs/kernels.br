# Functions that release builds turn into vector kernels (kernel.br, slp.br)
# when every caller passes an array of one small length: each must print
# what it does as written, bit for bit.

struct P:
    x: float
    y: float
    vx: float
    vy: float
    m: float

fn cloud() -> [P]:
    return [
        P(x=0.0, y=0.0, vx=0.1, vy=-0.2, m=3.0),
        P(x=1.5, y=0.25, vx=-0.3, vy=0.05, m=1.0),
        P(x=-0.75, y=2.0, vx=0.0, vy=0.4, m=0.5),
        P(x=0.5, y=-1.25, vx=0.2, vy=0.1, m=2.0)
    ]

# softened gravity between every pair, a velocity limit, then the moves: a
# kernel with stores, divisions, square roots and adds and subtracts mixed
fn step(ref ps: [P], dt: float, soft: float):
    let n = len(ps)
    for i in 0..n:
        for j in i + 1..n:
            let dx = ps[i].x - ps[j].x
            let dy = ps[i].y - ps[j].y
            let d2 = dx * dx + dy * dy + soft
            let f = dt / (d2 * sqrt(d2))
            ps[i].vx -= dx * ps[j].m * f
            ps[i].vy -= dy * ps[j].m * f
            ps[j].vx += dx * ps[i].m * f
            ps[j].vy += dy * ps[i].m * f
    for k in 0..n:
        ps[k].x += dt * ps[k].vx
        ps[k].y = ps[k].y + dt * ps[k].vy - 0.0

# a kernel that returns a float: the sum of the distances between pairs
fn spread(ps: [P]) -> float:
    var s = 0.0
    for i in 0..len(ps):
        for j in i + 1..len(ps):
            let dx = ps[i].x - ps[j].x
            let dy = ps[i].y - ps[j].y
            s += sqrt(dx * dx + dy * dy) / (ps[i].m + ps[j].m)
    return s

# changes the length behind the hint's back: the kernel's test fails and
# `step` runs as written
fn add_one(ref ps: [P]):
    ps.push(P(x=3.0, y=3.0, vx=-0.1, vy=-0.1, m=0.25))

fn show(ps: [P]):
    for p in ps:
        print(p.x, p.y, p.vx, p.vy)

fn main():
    var a = cloud()
    print(spread(a))
    # `before` shares `a`'s elements until `step` writes them
    let before = a
    for _ in 0..1000:
        step(ref a, 0.001, 0.01)
    show(a)
    print(spread(a))
    print(before[0].x, before[1].vy)
    var b = cloud()
    add_one(ref b)
    for _ in 0..1000:
        step(ref b, 0.001, 0.01)
    show(b)
    print(len(b))
