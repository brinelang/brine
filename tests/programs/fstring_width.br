# f-string widths as in Python (v09#12): strings align left and numbers right
# unless `<` or `>` says otherwise, and the width counts characters, not bytes
fn main():
    let s = "ab"
    print(f"[{s:6}] [{s:>6}] [{s:<6}]")
    print(f"[{42:6}] [{42:<6}] [{-4:06}] [{1.5:6}] [{255:6x}]")
    print(f"[{true:6}] [{'x':3}]")
    let name = "café"
    print(f"[{name:6}] [{name:>6}] [{"日本":6}] [{"日本":>6}]")
    # already as wide as asked, or wider: unchanged
    print(f"[{name:4}] [{name:2}]")
