# `x = f(x)` hands x to f, which then changes it in place; `var t = s` as the
# last use of `s` moves it. Every other name still sees its own value.
struct State:
    data: [int]
    steps: int
    name: str

    fn step(self) -> State:
        var t = self
        t.data[0] += 100
        t.steps += 1
        return t

struct Holder:
    items: [int]
    tag: str

fn step(s: State) -> State:
    var t = s
    t.data[t.steps % len(t.data)] += 1
    t.steps += 1
    return t

fn bump(xs: [int]) -> [int]:
    var ys = xs
    ys[0] += 1
    return ys

fn bump_late(xs: [int]) -> [int]:
    if len(xs) == 0:
        return [0]
    if xs[0] < 0:
        return xs
    var ys = xs
    ys.push(len(ys))
    return ys

fn reads_after(xs: [int]) -> [int]:
    var ys = xs
    ys[0] += 1
    print("  original inside:", xs[0])
    return ys

fn grow(mut xs: [int], n: int) -> [int]:
    for i in 0..n:
        xs.push(i)
    return xs

fn pair(n: int, xs: [int]) -> [int]:
    var ys = xs
    ys.push(n)
    return ys

fn with_first(xs: [int], f: int) -> [int]:
    var ys = xs
    ys.push(f)
    return ys

fn shout(s: str) -> str:
    var t = s
    t += "!"
    return t

fn count(m: {str: int}, k: str) -> {str: int}:
    var n = m
    n[k] = n.get(k).unwrap_or(0) + 1
    return n

fn down(xs: [int], n: int) -> [int]:
    if n == 0:
        return xs
    var ys = xs
    ys.push(n)
    return down(ys, n - 1)

fn update(ref s: State):
    s = step(s)

fn main():
    var s = State(data=[0, 0, 0], steps=0, name="s")
    let early = s
    for _ in 0..7:
        s = step(s)
    print("step:", s.data, s.steps, "kept:", early.data, early.steps)
    s = s.step()
    print("method:", s.data, s.steps)
    update(ref s)
    print("ref root:", s.data, s.steps)
    var xs = [1, 2]
    let keep = xs
    xs = bump(xs)
    xs = bump(xs)
    print("bump:", xs, "kept:", keep)
    xs = bump_late(xs)
    var e: [int] = []
    e = bump_late(e)
    var neg = [-1]
    neg = bump_late(neg)
    print("early returns:", xs, e, neg)
    xs = reads_after(xs)
    print("reads after:", xs)
    xs = grow(xs, 2)
    print("mut param:", xs)
    xs = pair(7, xs)
    print("second argument:", xs)
    xs = with_first(xs, xs[0])
    print("argument reads it:", xs)
    var grid = [[1], [2], [3]]
    let g0 = grid
    for i in 0..3:
        grid[i] = bump(grid[i])
    print("elements:", grid, "kept:", g0)
    var h = Holder(items=[5], tag="h")
    h.items = bump(h.items)
    print("field:", h.items, h.tag)
    var st = "hi"
    let st0 = st
    st = shout(st)
    st = shout(st)
    print("string:", st, st0)
    var m: {str: int} = {}
    for w in ["a", "b", "a"]:
        m = count(m, w)
    print("map:", m["a"], m["b"], len(m))
    xs = down(xs, 3)
    print("recursion:", xs)
    # moving one local into another
    for i in 0..2:
        var a = [i]
        var b = a
        b.push(9)
        print("moved local:", b)
    var c = [1]
    var d = c
    d.push(2)
    print("still used:", c, d)
