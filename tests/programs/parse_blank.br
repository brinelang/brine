# Blank text is no number, for every way of reading one: spaces around a
# number are fine, spaces alone are not.

fn main():
    for t in ["", " ", "\t", "  \n", "\r\n", " _ "]:
        print(
            [t],
            t.to_float(),
            t.to_float[f32](),
            t.to_int(),
            t.to_int[u8](),
            t.to_int[i128](),
            t.to_int[u64]()
        )
    for t in [" 1.5 ", "\t-2\n", " +3 ", "4\r\n"]:
        print([t], t.to_float(), t.to_float[f32](), t.to_int())
    # a number cut short is no number either
    for t in ["-", "+", " - ", ".", " e5", "1e", "1e+"]:
        print([t], t.to_float(), t.to_int())
