# Loops that index an array field (`self.stack[sp] = v`) load it once, unless
# something in the loop could replace, grow or share it; and push, pop and
# clear with room to spare stay in place.
struct VM:
    stack: [int]
    sp: int
    log: [int]

    fn run(ref self, n: int) -> int:
        for i in 0..n:
            self.stack[self.sp] = i
            self.sp = (self.sp + 1) % len(self.stack)
        return self.stack[0] + self.stack[1]

    fn grow(ref self, n: int) -> int:
        for i in 0..n:
            self.stack[0] = i
            self.stack.push(i)
        return len(self.stack)

    fn swap(ref self, n: int) -> int:
        for i in 0..n:
            self.stack[0] = i
            if i == 2:
                self.stack = [7, 7, 7]
        return self.stack[0] + self.stack[1]

    fn helper(ref self):
        self.stack = [100, 200]

    fn calls(ref self, n: int) -> int:
        for i in 0..n:
            self.stack[1] += i
            if i == 1:
                self.helper()
        return self.stack[1]

    fn copies(ref self) -> int:
        var total = 0
        for i in 0..3:
            let snap = self.stack
            self.stack[0] = i * 10
            total += snap[0]
        return total

    fn other_field(ref self, n: int) -> int:
        for i in 0..n:
            self.log[i % len(self.log)] = self.stack[i % len(self.stack)]
        return self.log[0] + self.log[1]

struct Outer:
    vm: VM

fn nested(ref o: Outer, n: int) -> int:
    for i in 0..n:
        o.vm.stack[i % 4] += i
    return o.vm.stack[0] + o.vm.stack[3]

fn main():
    var vm = VM(stack=[0] * 4, sp=0, log=[0, 0])
    print("run:", vm.run(10))
    vm.stack = [0]
    let g = vm.grow(5)
    print("grow:", g, vm.stack[0])
    print("swap:", vm.swap(4))
    vm.stack = [0, 0]
    print("calls:", vm.calls(4))
    vm.stack = [1, 2]
    let before = vm.stack
    let c = vm.copies()
    print("copies:", c, before[0], vm.stack[0])
    vm.stack = [5, 6, 7]
    print("other field:", vm.other_field(5))
    var o = Outer(vm=VM(stack=[0] * 4, sp=0, log=[]))
    let keep = o
    print("nested:", nested(ref o, 8), keep.vm.stack[0])
    var st: [int] = []
    var total = 0
    for k in 0..1000:
        st.push(k)
        if k % 4 == 3:
            total += st.pop()
            total += st.pop()
            let t = st
            st.clear()
            total += len(t)
    print("stack:", total, len(st))
    var strs: [str] = []
    for k in 0..10:
        strs.push(str(k))
    let shared = strs
    strs.pop()
    strs.clear()
    print("strings:", len(shared), shared[9], len(strs))
