# Proofs the 0.9.1 stress lab needed (v091 §7, §4): this file must pass
# `brine check --proven` (see tests/integration.br).

# a str slice where the code showed a character starts
fn rest(a: str) -> str:
    if a.starts_with("not:"):
        return a[4:]
    return a

fn ext(s: str) -> str:
    if s.ends_with(".br"):
        return s[:len(s) - 3]
    return s

fn whole(a: str) -> str:
    return a[0:len(a)] + a[0:0]

fn after_colon(s: str) -> str:
    match s.find(":"):
        case Some(i):
            return s[i + 1:]
        case None:
            return s

fn cut(s: str, t: str) -> str:
    match s.find(t):
        case Some(i):
            return s[:i] + s[i + len(t):]
        case None:
            return s

fn key(s: str) -> Option[str]:
    let i = s.find("=")?
    return Some(s[:i])

fn joined(a: str, b: str) -> str:
    let s = a + b
    return s[len(a):]

# anywhere in an ASCII string: a literal, `str(n)`, or one checked byte by byte
fn ascii_only(a: str) -> str:
    for c in a.bytes():
        if c >= 128:
            return ""
    if len(a) >= 2:
        return a[1:]
    return a

fn digits(n: int) -> str:
    let s = str(n)
    if len(s) > 2:
        return s[1:2]
    return "hello"[1:3]

# shifts by a variable amount
fn top(k: int) -> int:
    requires 1 <= k <= 56
    ensures result > 0
    return 1 << k

fn mask(n: int) -> u64:
    requires 0 <= n <= 32
    return (u64(1) << n) - 1

fn at_least(r: int, n: int) -> int:
    requires 0 <= r <= 20 and n >= (1 << r)
    ensures result >= 1
    return n

fn shr(x: int, s: int) -> int:
    requires 0 <= x <= 1000 and 2 <= s <= 10
    ensures 0 <= result <= 250
    return x >> s

# products whose factors are bounded only through other facts
fn halves(n: int, rec: int) -> int:
    requires 0 <= n <= 65535 and 0 <= rec <= 34
    var lo = 0
    var hi = n
    var acc = 0
    while lo < hi:
        invariant 0 <= lo <= hi <= n
        let mid = lo + (hi - lo) / 2
        acc = mid * rec
        hi = mid
    return acc

struct L:
    r: int
    x: int

fn mk(r: int, x: int) -> L:
    requires 0 <= r <= 100 and 0 <= x <= 100
    ensures result.r == r
    ensures result.r * result.x <= 5000
    if r * x > 5000:
        return L(r=r, x=0)
    return L(r=r, x=x)

fn same_product(r: int, x: int) -> int:
    requires 0 <= r <= 100 and 0 <= x <= 100
    let l = mk(r, x)
    prove r * l.x <= 5000
    return l.x

fn pixel_of(i: int, w: int, h: int, ch: int) -> int:
    requires w >= 1 and h >= 1 and ch >= 1 and 0 <= i < w * h * ch
    ensures 0 <= result < w * h
    return i / ch

fn mul_hi(x: u64, y: u64) -> u64:
    return u64((u128(x) * u128(y)) >> 64)

# `^` of values bounded through a division or a loop's invariant
fn xor_div(c: int) -> int:
    requires 0 <= c <= 0xffffffff
    ensures 0 <= result <= 0xffffffff
    let h = c / 256
    return (h ^ c) + (c >> 8 ^ 0xffffffff) * 0

fn xor_loop(n: int) -> int:
    requires 0 <= n <= 1000
    ensures 0 <= result <= 0xffffffff
    var c = 0
    for i in 0..n:
        invariant 0 <= c <= 0xffffffff
        c = (c + i) & 0xffff
    return c ^ 0xffffffff

# facts about arrays a loop only grows, nested elements, `enumerate`, literals
fn grown(n: int) -> int:
    var a = [7]
    for i in 0..n:
        a.push(i)
    var s = "x"
    for i in 0..n:
        s += "y"
    let b = a[0]
    return len(s.bytes()[0:1])

struct E:
    outs: [int]

fn first_out(es: [E], e: int) -> int:
    if not (0 <= e < len(es)):
        return -1
    if len(es[e].outs) > 0:
        return es[e].outs[0]
    return -1

struct T:
    n: int

struct Inv:
    t: T

fn bump(t: T) -> T:
    requires t.n < 100
    return T(n=t.n + 1)

fn nested_field() -> int:
    var out = [Inv(t=T(n=0))]
    let k = 0
    if out[k].t.n >= 100:
        return 0
    out[k].t = bump(out[k].t)
    return out[0].t.n

fn indexes(ids: [int], hs: [int]) -> int:
    var s = 0
    for k, n in enumerate(ids):
        if k < len(hs) and 0 <= hs[k] <= 100 and s < 1000000:
            s += hs[k]
    return s

fn both(xs: [float], p: int, q: int) -> float:
    requires 0 <= p < len(xs) and 0 <= q < len(xs)
    var t = 0.0
    for i in [p, q]:
        t += xs[i]
    return t

const P = [1, 2, 4, 8]

fn table(z: int) -> int:
    requires 0 <= z < 4
    ensures result == P[z]
    return P[z]

# float to int after a range check: `floor`, `ceil`, `round`, `f32`
fn floors(x: float) -> int:
    let t = [0] * 10
    if 0.0 <= x and x < 10.0:
        return t[int(floor(x))]
    return -1

fn ceils(est: float) -> int:
    ensures result >= 2
    if est != est or est > 20000.0 or est < 2.0:
        return 2
    return int(ceil(est))

fn rounds(y: float) -> int:
    if y >= 32767.0 or y <= -32768.0 or y != y:
        return 0
    return int(round(y))

fn small(x: f32) -> int:
    let t = [0] * 10
    if 0.0 <= x < 10.0:
        return t[int(x)]
    return -1

# the same call with the same `str` gives the same value
fn need(t: [u8], e: int):
    requires e <= len(t)
    pass

# a one-line getter is what its body says
struct Buf:
    xs: [int]
    end: int

    fn size(self) -> int:
        return len(self.xs)

    fn has(self, i: int) -> bool:
        return 0 <= i < len(self.xs)

fn getters(b: Buf, i: int) -> int:
    if b.size() > 1 and b.has(i) and b.xs[i] == 3 and b.xs[1] == 2:
        return b.xs[1] * 10 + i
    return 0

fn main():
    print(rest("not:x"), ext("a.br"), whole("é"), after_colon("a:b"), cut("abc", "b"))
    print(key("a=b"), joined("é", "z"), ascii_only("ab"), digits(123))
    for i in 0..10:
        need(str(i).bytes(), len(str(i)))
    print(top(3), mask(4), at_least(3, 8), shr(100, 2), halves(65535, 34), same_product(3, 4))
    print(pixel_of(5, 2, 2, 3), mul_hi(u64(1) << 40, u64(1) << 40), xor_div(1000), xor_loop(3))
    print(grown(3), first_out([E(outs=[1])], 0), nested_field(), indexes([1, 2], [3]))
    print(
        both([1.0, 2.0, 3.0], 0, 2),
        table(2),
        floors(9.9),
        ceils(188.8),
        rounds(-2.5),
        small(f32(9.5))
    )
    print(getters(Buf(xs=[1, 2, 3], end=0), 2))
