# Proofs the 0.9.1 stress lab needed (v091 §7, §4): this file must pass
# `brine check --proven` (see tests/integration.br).

# a str slice where the code showed a character starts
fn rest(a: str) -> str:
    if a.starts_with("not:"):
        return a[4:]
    return a

fn ext(s: str) -> str:
    if s.ends_with(".br"):
        return s[:len(s) - 3]
    return s

fn whole(a: str) -> str:
    return a[0:len(a)] + a[0:0]

fn after_colon(s: str) -> str:
    match s.find(":"):
        case Some(i):
            return s[i + 1:]
        case None:
            return s

fn cut(s: str, t: str) -> str:
    match s.find(t):
        case Some(i):
            return s[:i] + s[i + len(t):]
        case None:
            return s

fn key(s: str) -> Option[str]:
    let i = s.find("=")?
    return Some(s[:i])

fn joined(a: str, b: str) -> str:
    let s = a + b
    return s[len(a):]

# anywhere in an ASCII string: a literal, `str(n)`, or one checked byte by byte
fn ascii_only(a: str) -> str:
    for c in a.bytes():
        if c >= 128:
            return ""
    if len(a) >= 2:
        return a[1:]
    return a

fn digits(n: int) -> str:
    let s = str(n)
    if len(s) > 2:
        return s[1:2]
    return "hello"[1:3]

# the same call with the same `str` gives the same value
fn need(t: [u8], e: int):
    requires e <= len(t)
    pass

fn main():
    print(rest("not:x"), ext("a.br"), whole("é"), after_colon("a:b"), cut("abc", "b"))
    print(key("a=b"), joined("é", "z"), ascii_only("ab"), digits(123))
    for i in 0..10:
        need(str(i).bytes(), len(str(i)))
