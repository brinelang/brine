# `_` ignores a value: it can repeat in one scope and can't be read.
# Tuples unpack in `let`, `for` and comprehensions.
fn pair() -> (int, str):
    return (1, "a")

fn second(_: str, _: [int], n: int) -> int:
    return n

fn main():
    let (a, _) = pair()
    let (_, b) = pair()
    var count = 0
    for _ in 0..3:
        count += 1
    for _, v in [(1, "x"), (2, "y")]:
        print(v)
    print(a, b, count, second("s", [1], 7))
    # comprehensions unpack tuples too
    let pairs = [(1, "a"), (2, "b"), (3, "c")]
    print([s for _, s in pairs], [n * 10 for n, s in pairs if s != "b"])
    print(sum(n for n, _ in pairs), par [n + 1 for n, _ in pairs])
    print([f"{k}={v}" for k, v in {"x": 1, "y": 2}.items()])
