# The prover's numbers stop at i128's limits, so the upper bound it knows
# for a `u128` stands for any larger one. Each `prove` here is false, and
# 0.9.1 "proved" the first three from that bound, divided as if it were real.

fn high_half(x: u128) -> u128:
    let q = x / 18446744073709551616
    prove q < 9223372036854775808
    return q

fn half(x: u128) -> u128:
    let h = x / 2
    prove h < 85070591730234615865843651857942052864
    return h

fn high_int(x: u128) -> int:
    let q = x / 18446744073709551616
    prove q <= 9223372036854775807
    return 0

fn shifted(x: u128) -> u128:
    let q = x >> 64
    prove q < 9223372036854775808
    return q

fn main():
    let x: u128 = 340282366920938463463374607431768211455
    print(high_half(x), half(x), high_int(x), shifted(x))
