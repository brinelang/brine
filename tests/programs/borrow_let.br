# `let d = r.f` / `let d = r[i]` borrows when nothing after it can change or
# move `r`; whenever something could, d must still see its own value.
struct Node:
    op: int
    kids: [int]
    name: str

struct Tab:
    a: [int]
    b: [int]

struct Pos:
    t: Tab
    nodes: [Node]

    fn via_local(self, i: int) -> int:
        let t = self.t
        let a = t.a
        return a[i] + t.b[i]

    fn first_kids(self) -> [int]:
        let n = self.nodes[0]
        return n.kids

    fn add(ref self, k: int):
        let n = self.nodes[0]
        self.nodes[0].kids.push(k)
        print("  inside add:", n.kids, self.nodes[0].kids)

fn run_code(ps: [Pos]) -> int:
    var code = ps[0].t.a
    var acc = 0
    for q in 0..4:
        code = ps[q % 2].t.b
        acc += code[0] + len(code)
    var n = ps[0].nodes[0]
    for q in 0..2:
        n = ps[q].nodes[0]
        acc += n.op + len(n.kids)
    return acc

fn last_code(ps: [Pos]) -> [int]:
    var code = ps[0].t.a
    for q in 0..2:
        code = ps[q].nodes[0].kids
    return code

fn change(ref xs: [[int]]):
    xs[0] = [99]

fn first(xs: [[int]]) -> [int]:
    let d = xs[0]
    return d

fn main():
    var xs: [[int]] = [[1], [2]]
    let d1 = xs[0]
    xs[0] = [9]
    print("written:", d1, xs)
    let d2 = xs[1]
    xs[1].push(3)
    print("method:", d2, xs)
    let d3 = xs[0]
    change(ref xs)
    print("ref:", d3, xs)
    let d4 = xs[1]
    var ys = xs
    ys[1] = []
    print("moved root:", d4, ys)
    var i = 0
    let d5 = xs[i]
    i += 1
    print("index changes:", d5, xs[i])
    for k in 0..3:
        xs[0] = [k]
        let d6 = xs[0]
        print("loop:", d6)
    for k in 0..2:
        let d7 = xs[1]
        for j in 0..1:
            xs[1] = [k, j]
        print("written in a loop:", d7, xs[1])
    print("returned:", first(xs))
    var keep: [[int]] = []
    if true:
        var src = [[4, 5]]
        let d8 = src[0]
        keep.push(d8)
    print("kept:", keep)
    let z = [1] * 4
    var p = Pos(t=Tab(a=z, b=[2] * 4), nodes=[Node(op=1, kids=[7], name="n")])
    print("nested:", p.via_local(2), p.first_kids())
    p.add(8)
    let nd = p.nodes[0]
    let nm = nd.name
    p.nodes[0].name = "m"
    print("field then write:", nm, nd.name, p.nodes[0].name)
    let nd2 = p.nodes[0]
    match nd2.op:
        case 1:
            print("match:", nd2.kids, nd2.name)
        case _:
            pass
    let shown = p.nodes[0].kids
    print("string of borrowed:", f"{shown}", len(shown))
    var ws: [[int]] = [[1], [2]]
    let r = ref ws
    let d9 = ws[0]
    r[0] = [9]
    print("ref name:", d9, ws)
    # `var`s given only places
    var ps: [Pos] = [p, p]
    var code = ps[0].t.a
    var acc = 0
    for q in 0..4:
        code = ps[q % 2].t.b
        acc += code[0]
    print("var reassigned:", acc, code)
    var c1 = ps[0].t.a
    ps[1].t.a = [5]
    print("root written:", c1, ps[1].t.a)
    var c2 = ps[0].t.a
    c2.push(6)
    print("var changed:", c2, ps[0].t.a)
    var c3 = ps[0].t.a
    c3 = [7]
    print("var given a new array:", c3, ps[0].t.a)
    var c4 = ps[0].t.a
    c4[0] = 8
    print("element set:", c4, ps[0].t.a)
    var c5 = ps[0].t.a
    var c6 = c5
    c6.push(9)
    print("copied on:", c5, c6)
    var n = ps[0].nodes[0]
    let qs = [Node(op=2, kids=[3], name="q")]
    n = qs[0]
    print("struct var:", n.op, n.kids, n.name)
    var other = [[1], [2]]
    var c7 = other[0]
    for q in 0..2:
        c7 = other[q]
    other[0] = []
    print("root written later:", c7, other)
    print("borrowing vars:", run_code(ps), last_code(ps))
