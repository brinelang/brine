# A check that fails inside a GPU kernel: the runtime drops the device's work
# and runs the construct on the CPU, which panics as usual. Each case fails
# at exactly one element, so the message is the same on any thread count.
fn check(x: int) -> int:
    assert x != 77_777
    return x * 2

fn main():
    let which = args()[0]
    let n = 100_000
    let xs = [i for i in 0..n]
    if which == "index":
        let ys = par [xs[i + i / 99_999] for i in 0..n]
        print(ys[0])
    elif which == "assert":
        var out = [0] * n
        par for i in 0..n:
            out[i] = check(xs[i])
        print(out[5])
    elif which == "div":
        let d = [1 if i != 4321 else 0 for i in 0..n]
        var q = [0] * n
        par for i in 0..n:
            q[i] = 100 / d[i]
        print(q[4])
    elif which == "overflow":
        let ys = par [x * (1 if x != 54_321 else 400_000_000_000_000) for x in xs]
        print(ys[1])
    elif which == "combine":
        # every leaf fits; leaves 0 and 1 overflow when the tree adds them
        let big = 288_230_376_151_711_744
        print(par sum(big if x < 32 else 0 for x in xs))
    elif which == "convert":
        let fs = [float(i) * (1.0 if i != 9_999 else 1e9) for i in 0..n]
        let ys = par [i32(f) for f in fs]
        print(ys[1])
    elif which == "shift":
        let ys = par [1 << (x % 64 + x / 99_999 * 64) for x in xs]
        print(ys[1])
