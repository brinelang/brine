struct P:
    x: int

fn main():
    let a = world.any(1)
    let b = world.sum(["a"])
    let c = world.max([true])
    let d = world.shift(1.0, 1, "x")
    let e = world.broadcast(0, P(x=1))
    let f = world.gather_all((1, 2))
    let g = world.shift(1, 1, 2, 3)
    let h: [u8] = world.sum([u8(1)])
    print(a, b, c, d, e, f, g, h)
