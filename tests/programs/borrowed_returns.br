# A function whose returns all give back part of a by-value parameter (or a
# constant) hands its result to the caller borrowed, and `for x in xs` over a
# `let` or a parameter borrows the array. The results must live as long as
# owned ones would.

struct Val:
    i: int
    s: str

enum Expr:
    Lit(v: Val)
    Name(n: str)
    Pair(l: Expr, r: Expr)
    Other

fn lit_of(e: Expr) -> Val:
    match e:
        case Expr.Lit(v):
            return v
        case _:
            return Val(i=0, s="none")

fn name_of(e: Expr) -> str:
    match e:
        case Expr.Name(n):
            return n
        case Expr.Lit(v):
            return v.s
        case _:
            return "?"

fn left(e: Expr) -> Expr:
    match e:
        case Expr.Pair(l, _):
            return l
        case _:
            return Expr.Other

fn same(s: str) -> str:
    return s

fn pick(xs: [str], i: int) -> str:
    let ys = xs
    for x in ys:
        if len(x) == i:
            return x
    return xs[0]

fn make(n: int) -> Expr:
    return Expr.Lit(Val(i=n, s="v" + str(n)))

fn count_long(words: [str]) -> int:
    var n = 0
    for w in words:
        match w:
            case "":
                pass
            case _:
                if len(w) > 2:
                    n += 1
    return n

fn main():
    # results of temps: each argument lives to the end of its statement
    let a = lit_of(make(7))
    print(a, lit_of(make(8)).s, name_of(make(9)), lit_of(Expr.Other))
    var keep: [str] = []
    for i in 0..3:
        keep.push(name_of(make(i)))
        keep.push(same("x" + str(i)))
    print(keep)
    var v = lit_of(make(1))
    v.s += "!"
    v = lit_of(Expr.Lit(v))
    print(v)
    let e = Expr.Pair(Expr.Name("n" + str(5)), make(6))
    let l = left(e)
    print(l, name_of(left(e)), name_of(left(left(e))), left(make(2)))
    var s = "start" + str(len(keep))
    s = same(s)
    s = same(s + "-") + same(s)
    print(s)
    let words = ["a" + "b", "abc" + "d", "xyz"]
    print(pick(words, 3), pick(words, 9), pick(["q" + "r"], 2))
    var acc: [Val] = []
    for w in words:
        acc.push(lit_of(Expr.Lit(Val(i=len(w), s=w))))
    print(acc, count_long(words), count_long(["", "abcd" + "e"]))
    let parts = par [lit_of(make(k)).s for k in 0..4]
    print(parts)
