# Struct invariants: proven when a value is built and when a `ref self`
# method returns, and known about every value of the type everywhere else.

struct Ring:
    items: [int]
    cap: int
    invariant 0 < self.cap
    invariant len(self.items) <= self.cap

    fn push(ref self, x: int) -> bool:
        if len(self.items) == self.cap:
            return false
        self.items.push(x)
        return true

    # broken in between, restored before returning
    fn refill(ref self, xs: [int]):
        self.items = []
        self.cap = 1
        for x in xs:
            invariant len(self.items) <= self.cap
            if len(self.items) == self.cap:
                self.cap += 1
            self.items.push(x)
        self.cap += 1

    fn room(self) -> int:
        ensures result >= 0
        return self.cap - len(self.items)

struct Pool:
    rings: [Ring]
    main: Ring

fn new_ring(cap: int) -> Result[Ring, str]:
    if cap <= 0:
        return Err("the capacity must be positive")
    return Ok(Ring(items=[], cap=cap))

# the invariant is a fact about any `Ring`: no `requires` needed
fn last_slot(r: Ring) -> int:
    ensures 0 <= result < r.cap
    return r.cap - 1

fn fill(ref r: Ring, n: int) -> int:
    var added = 0
    for i in 0..n:
        if r.push(i):
            added += 1
    return added

fn main():
    var r = new_ring(3).unwrap()
    let added = fill(ref r, 5)
    print(added, r.room(), last_slot(r))
    r.refill([1, 2, 3, 4])
    print(r.items, r.cap, r.room())
    var p = Pool(rings=[r, Ring(items=[], cap=1)], main=Ring(items=[7], cap=1))
    let a = p.rings[1].push(9)
    let b = p.rings[1].push(10)
    let c = p.main.push(8)
    print(a, b, c)
    print(p.rings[1].items, p.rings[1].room(), last_slot(p.rings[0]))
    match new_ring(0):
        case Ok(_):
            print("built")
        case Err(e):
            print(e)
