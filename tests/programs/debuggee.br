# Debugged by the "gdb debugs brine source" test: it breaks at lines by number.
struct P:
    x: int
    y: int

fn area(p: P) -> int:
    let a = p.x * p.y
    return a

fn main():
    let name = "brine"
    let xs = [1, 2, 3]
    let p = P(x=3, y=4)
    let o: Option[int] = Some(7)
    let a = area(p)
    print(f"{name} {xs} {a} {o}")
