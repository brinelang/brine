# Regenerate the expected lexer and parser output in tests/syntax/:
#
#   brine run tests/update_syntax.br [-- path/to/brine]
#
# Review the diff afterwards: every change must be intended.

fn output(cmd: [str]) -> str:
    var h = 0
    match os.spawn(cmd, {"NO_COLOR": "1"}, true, false):
        case Ok(p):
            h = p
        case Err(e):
            panic(f"cannot run {cmd[0]}: {e}")
    let code = os.wait(h)
    let (out, err) = os.output(h)
    if code != 0:
        panic(f"{' '.join(cmd)} failed:\n{err}")
    return out.replace("\r\n", "\n")

fn main():
    let a = args()
    let exe = a[0] if len(a) > 0 else "brine"
    var names: [str] = []
    match os.list_dir("tests/syntax"):
        case Ok(ns):
            names = ns
        case Err(e):
            panic(e)
    for name in names:
        if not name.ends_with(".br"):
            continue
        let f = "tests/syntax/" + name
        let base = f[:len(f) - 3]
        for kind in ["lex", "parse"]:
            match write_file(base + "." + kind, output([exe, kind, f])):
                case Ok(_):
                    pass
                case Err(e2):
                    panic(e2)
    print(f"updated {len(names)} files")
