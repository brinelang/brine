from pump import Pump, dose_for

rule "a dose is never negative" for p: Pump, reading: int:
    requires reading >= 0
    let d = dose_for(p, reading)
    prove d >= 0

rule "dosing has no effects":
    effects pump: none
    effects pump.alarm: console, clock

rule "dosing can't crash":
    proven pump.dose_for
    proven pump.Pump.step

# `rule` is still an ordinary name
fn rule(x: int) -> int:
    return x
