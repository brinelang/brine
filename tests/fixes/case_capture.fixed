# mistake: a variant written without its enum in a `case`
# expect: W0006, the name captures every value; write `Color.Red`
enum Color:
    Red
    Green

fn code(c: Color) -> int:
    match c:
        case Color.Green:
            return 1
        case Color.Red:
            return 0

fn main():
    print(code(Color.Green))
