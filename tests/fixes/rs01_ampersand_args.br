# mistake: Rust habit: pass `&mut xs` to a function that should change the caller's array
# expect: parse/type error at `&mut` saying: declare `ref xs: [int]` and call `fill(ref xs)`
fn fill(xs: &mut [int], v: int):
    for i in 0..len(xs):
        xs[i] = v

fn main():
    var data = [0] * 4
    fill(&mut data, 7)
    print(data)
