# mistake: Python habit: method mutates self.field with plain `self` (Python self is always mutable)
# expect: error at the assignment: write `ref self`
struct Acc:
    total: int

    fn add(self, x: int):
        self.total += x

fn main():
    var a = Acc(total=0)
    a.add(3)
    print(a.total)
