# mistake: Python habit: call another method without `self.`
# expect: E0201 on `area`, suggesting `self.area()`
struct Rect:
    w: float
    h: float

    fn area(self) -> float:
        return self.w * self.h

    fn describe(self) -> str:
        return f"area {area()}"

fn main():
    print(Rect(w=2.0, h=3.0).describe())
