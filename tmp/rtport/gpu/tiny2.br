# The runtime's cost per small `par for` and per small reduction.
fn main():
    var a = [0] * 8
    var t = 0
    let t0 = clock()
    for rep in 0..2_000_000:
        par for i in 0..8:
            a[i] = i * rep
    let t1 = clock()
    for rep in 0..2_000_000:
        t += par sum(x + rep for x in a)
    let t2 = clock()
    print(t, a[7])
    eprint(f"for {t1 - t0:.3f} s, sum {t2 - t1:.3f} s")
