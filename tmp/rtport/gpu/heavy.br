# GPU-heavy: big maps and reductions (copies dominate), then many small
# constructs (the runtime's own cost per construct dominates).
fn work(x: float) -> float:
    var y = x
    for k in 0..400:
        y = y * 0.999 + 0.5
    return y

fn main():
    let n = 1 << 22
    let xs = [float(i % 1000) * 0.001 for i in 0..n]
    var t = 0.0
    let t0 = clock()
    for rep in 0..8:
        let ys = par [work(x + float(rep)) for x in xs]
        t += par sum(y * 0.5 for y in ys)
    let t1 = clock()
    # small ones: each is one launch
    let m = 8192
    let small = [float(i) for i in 0..m]
    var s = 0.0
    for rep in 0..400:
        let zs = par [z * 2.0 + float(rep) for z in small]
        s += par sum(z for z in zs)
    let t2 = clock()
    var out = [0.0] * n
    for rep in 0..4:
        par for i in 0..n:
            out[i] = work(xs[i]) + float(rep)
    let t3 = clock()
    print(t, s, out[0], out[n - 1])
    eprint(f"big {t1 - t0:.3f} s, small {t2 - t1:.3f} s, par for {t3 - t2:.3f} s")
