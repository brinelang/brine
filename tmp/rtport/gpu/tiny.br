# Many tiny constructs: the runtime's cost per `par for` and reduction.
fn main():
    var a = [0] * 8
    var t = 0
    let t0 = clock()
    for rep in 0..1_000_000:
        par for i in 0..8:
            a[i] = i * rep
        t += par sum(x for x in a)
    let t1 = clock()
    # not GPU-eligible (a string result)
    var u = 0
    for rep in 0..300_000:
        let ss = par [str(i + rep) for i in 0..4]
        u += len(ss[3])
    let t2 = clock()
    print(t, u)
    eprint(f"eligible {t1 - t0:.3f} s, not {t2 - t1:.3f} s")
