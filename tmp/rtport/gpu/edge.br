# GPU paths that the tests don't reach: two constructs at once (fork-join:
# one finds the GPU busy), a construct nested in another, reductions of each
# kind and value type, filters, dense and whole writes after a probe, arrays
# of arrays, empty and one-element constructs.
fn spin(x: float) -> float:
    var y = x
    for k in 0..200:
        y = y * 0.999 + 0.25
    return y

fn half(xs: [float], k: int) -> float:
    var t = 0.0
    for rep in 0..6:
        let ys = par [spin(x + float(k * 10 + rep)) for x in xs]
        t += par sum(ys[i] for i in 0..len(ys))
    return t

fn main():
    let n = 300_000
    let xs = [float(i % 777) * 0.01 for i in 0..n]
    let (a, b) = par(half(xs, 1), half(xs, 2))
    print(a, b)
    # nested: the inner construct stays on the CPU
    var rows = [0.0] * 64
    par for r in 0..64:
        let inner = par [float(r * j) for j in 0..5000]
        rows[r] = inner[4999]
    print(rows[0], rows[63])
    # every reducer, ints and floats, with and without a filter
    let is = [i % 1001 - 500 for i in 0..n]
    print(par sum(v for v in is), par min(v for v in is), par max(v for v in is))
    print(par sum(v for v in is if v > 0), par min(x for x in xs if x > 3.0))
    print(par any(v == 499 for v in is), par all(v > -501 for v in is))
    print(par sum(i32(v) for v in is), par max(u8(v + 500 & 255) for v in is))
    print(par sum(f32(x) for x in xs), par max(x * -1.0 for x in xs))
    print(par sum(1 for v in is if v == 12345))
    # a probe, then the rest: whole writes and dense ones
    var out = [0.0] * n
    var whole = [1.0] * n
    par for i in 0..n:
        out[i] = spin(xs[i])
    par for i in 0..n / 2:
        whole[2 * i + 1] = spin(whole[2 * i])
    print(out[0], out[n - 1], whole[1], whole[n - 1], whole[n - 2])
    # arrays of arrays
    let grid = [[float(r + c) for c in 0..300] for r in 0..2000]
    let rs = par [spin(row[7]) + row[299] for row in grid]
    print(rs[0], rs[1999])
    # empty and tiny
    let none: [float] = []
    print(len(par [x * 2.0 for x in none]), par sum(x for x in none), par [x + 1.0 for x in xs[0:1]])
