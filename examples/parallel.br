# Parallelism is part of the language and data-race free by construction.
# Run with: brine run examples/parallel.br --release

fn collatz_len(n: int) -> int:
    var x = n
    var steps = 0
    while x != 1:
        x = x / 2 if x % 2 == 0 else 3 * x + 1
        steps += 1
    return steps

fn main():
    let n = 1_000_000

    # parallel map
    let lens = par [collatz_len(i) for i in 1..=n]

    # parallel reduction: same bits on any machine and any thread count
    let total = par sum(float(l) for l in lens)
    let longest = par max(l for l in lens)
    print(f"average steps: {total / float(n):.2f}, longest: {longest}")

    # parallel loop: each iteration may write only out[i]
    var out = [0.0] * 8
    par for i in 0..8:
        out[i] = sqrt(float(i))
    print(out)

    # fork-join
    let (a, b) = par(collatz_len(27), collatz_len(97))
    print(a, b)
