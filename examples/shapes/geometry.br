struct Point:
    x: float
    y: float

    fn move_by(ref self, dx: float, dy: float):
        self.x += dx
        self.y += dy

    fn dist(self, other: Point) -> float:
        let dx = self.x - other.x
        let dy = self.y - other.y
        return sqrt(dx * dx + dy * dy)

struct Rect:
    w: float
    h: float

    fn area(self) -> float:
        return self.w * self.h

enum Shape:
    Circle(radius: float)
    Square(side: float)
    Dot

    fn area(self) -> float:
        match self:
            case Shape.Circle(r):
                return 3.14159 * r * r
            case Shape.Square(s):
                return s * s
            case Shape.Dot:
                return 0.0
