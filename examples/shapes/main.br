# Structs, enums, methods and modules. Run with: brine run examples/shapes
import geometry

fn main():
    var p = geometry.Point(x=1.0, y=2.0)
    p.move_by(2.0, 2.0)
    print(p, p.dist(geometry.Point(x=0.0, y=0.0)))

    let rects = [geometry.Rect(w=2.0, h=3.0), geometry.Rect(w=1.5, h=1.5)]
    let areas = [r.area() for r in rects]
    print(areas, sum(a for a in areas))

    let shapes = [geometry.Shape.Circle(1.0), geometry.Shape.Square(side=2.0), geometry.Shape.Dot]
    for s in shapes:
        match s:
            case geometry.Shape.Circle(radius=r) if r > 0.5:
                print("big circle", s.area())
            case geometry.Shape.Dot:
                print("dot")
            case _:
                print(s, s.area())
