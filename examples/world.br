# Several cooperating processes, like MPI.
# Run with: brine run examples/world.br --ranks 4
#
# Every rank takes part in every communication, in the same order. The
# compiler checks this, so a brine program can't deadlock.

fn main():
    let rank = world.rank()
    let size = world.size()

    # each rank sums its own slice of the numbers
    var local = 0
    for i in 0..1_000_000:
        if i % size == rank:
            local += i
    let total = world.sum(local)

    # every rank contributes one value; everyone gets the whole list
    let all = world.gather_all(rank * rank)

    if rank == 0:
        print(f"{size} ranks, total = {total}, squares = {all}")

    # pass a message around the ring: each rank sends to rank + 1
    var token = "token"
    for step in 0..size:
        token = world.shift(token + f"->{rank}", 1)
    if rank == 0:
        print(f"after one lap: {token}")

    # all-to-all: element j of the array goes to rank j
    let outbox = [[rank, j] for j in 0..size]
    let inbox = world.exchange(outbox)
    if rank == size - 1:
        print(f"rank {rank} received {inbox}")
