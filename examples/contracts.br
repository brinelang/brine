# Contracts are checked by the compiler, not at runtime.
# Try `brine check examples/contracts.br --report`: every array access
# and every arithmetic operation here is proven safe, so no runtime
# checks remain in the binary.

fn clamp(x: int, lo: int, hi: int) -> int:
    requires lo <= hi
    ensures lo <= result <= hi
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

# Binary search over a sorted array. The invariant keeps `mid` inside
# the array, so `xs[mid]` needs no bounds check.
fn index_of(xs: [int], target: int) -> int:
    ensures -1 <= result < len(xs)
    var lo = 0
    var hi = len(xs)
    while lo < hi:
        invariant 0 <= lo <= hi <= len(xs)
        let mid = lo + (hi - lo) / 2
        if xs[mid] == target:
            return mid
        if xs[mid] < target:
            lo = mid + 1
        else:
            hi = mid
    return -1

# `requires` moves the burden to the caller: inside, `len(xs) > 0` is a
# known fact, so the division can never divide by zero.
fn mean(xs: [float]) -> float:
    requires len(xs) > 0
    var total = 0.0
    for x in xs:
        total += x
    return total / float(len(xs))

fn last(xs: [int]) -> int:
    requires len(xs) >= 1
    return xs[len(xs) - 1]

fn main():
    let xs = [1, 3, 5, 7, 9, 11]
    print(clamp(42, 0, 10), clamp(-3, 0, 10))
    print(index_of(xs, 7), index_of(xs, 4))
    print(mean([1.0, 2.0, 4.5]), last(xs))

test "clamp stays in range":
    assert clamp(15, 0, 10) == 10
    assert clamp(-5, 0, 10) == 0
    assert clamp(5, 0, 10) == 5

test "binary search finds every element":
    let xs = [2, 4, 6, 8]
    for i in 0..len(xs):
        assert index_of(xs, xs[i]) == i
    assert index_of(xs, 5) == -1
