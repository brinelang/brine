# The ChaCha20 block function (RFC 8439) over 2 million counters: u32
# additions, xors and rotations.

fn quarter(ref x: [u32], a: int, b: int, c: int, d: int):
    requires len(x) == 16
    requires 0 <= a < 16 and 0 <= b < 16 and 0 <= c < 16 and 0 <= d < 16
    x[a] = x[a].wrapping_add(x[b])
    x[d] = (x[d] ^ x[a]).rotate_left(16)
    x[c] = x[c].wrapping_add(x[d])
    x[b] = (x[b] ^ x[c]).rotate_left(12)
    x[a] = x[a].wrapping_add(x[b])
    x[d] = (x[d] ^ x[a]).rotate_left(8)
    x[c] = x[c].wrapping_add(x[d])
    x[b] = (x[b] ^ x[c]).rotate_left(7)

fn block(ref out: [u32], st: [u32]):
    requires len(out) == 16 and len(st) == 16
    for i in 0..16:
        out[i] = st[i]
    for _ in 0..10:
        quarter(ref out, 0, 4, 8, 12)
        quarter(ref out, 1, 5, 9, 13)
        quarter(ref out, 2, 6, 10, 14)
        quarter(ref out, 3, 7, 11, 15)
        quarter(ref out, 0, 5, 10, 15)
        quarter(ref out, 1, 6, 11, 12)
        quarter(ref out, 2, 7, 8, 13)
        quarter(ref out, 3, 4, 9, 14)
    for i in 0..16:
        out[i] = out[i].wrapping_add(st[i])

fn main():
    var st = [u32(0)] * 16
    for i in 0..16:
        st[i] = u32(i * 0x01010101 + 7)
    var out = [u32(0)] * 16
    var acc: u32 = 0
    for k in 0..2_000_000:
        st[12] = u32(k)
        block(ref out, st)
        for i in 0..16:
            acc = (acc ^ out[i]).rotate_left(1)
    print(acc)
