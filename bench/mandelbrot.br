# Mandelbrot: counts the points of a 4000 x 4000 grid in the set (tight float loops).

fn main():
    let n = 4000
    var count = 0
    for py in 0..n:
        let ci = 2.0 * float(py) / float(n) - 1.0
        for px in 0..n:
            let cr = 2.0 * float(px) / float(n) - 1.5
            var zr = 0.0
            var zi = 0.0
            var i = 0
            var inside = true
            while i < 50:
                let tr = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = tr
                if zr * zr + zi * zi > 4.0:
                    inside = false
                    break
                i += 1
            if inside:
                count += 1
    print(count)
