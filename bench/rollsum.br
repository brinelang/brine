# An rsync-style rolling checksum over 64 MB: the step that moves the window
# by a byte returns the checksum as a struct, and counts the windows whose
# checksum marks a cut.

struct Roll:
    a: u32
    b: u32

fn roll(r: Roll, out: u8, inp: u8, w: u32) -> Roll:
    let a = r.a.wrapping_sub(u32(out)).wrapping_add(u32(inp))
    let b = r.b.wrapping_sub(w.wrapping_mul(u32(out))).wrapping_add(a)
    return Roll(a=a, b=b)

fn main():
    let n = 64_000_000
    let w = 64
    var data = [u8(0)] * n
    var s = u32(12345)
    for i in 0..n:
        s = s.wrapping_mul(1103515245).wrapping_add(12345)
        data[i] = u8(s >> 24)
    var cuts = 0
    var h = u32(0)
    for _ in 0..4:
        var r = Roll(a=0, b=0)
        for i in 0..w:
            r = roll(r, 0, data[i], u32(w))
        for i in w..n:
            r = roll(r, data[i - w], data[i], u32(w))
            if (r.a ^ r.b) & 4095 == 0:
                cuts += 1
                h = h.rotate_left(5) ^ r.b
    print(cuts, h)
