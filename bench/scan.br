# A byte tokenizer over 64 MB of log lines: find each line's end, then the
# spaces in it, and add up a field.

fn find_byte(b: [u8], lo: int, hi: int, c: u8) -> int:
    requires 0 <= lo
    requires hi <= len(b)
    ensures result <= hi
    ensures result >= min(lo, hi)
    if lo >= hi:
        return hi
    var i = lo
    while i < hi:
        invariant lo <= i <= hi
        if b[i] == c:
            return i
        i += 1
    return hi

fn main():
    let words = ["GET", "/api/v1/users/12345", "HTTP/1.1", "200", "Mozilla/5.0", "-", "0.042"]
    var text: [u8] = []
    var k = 0
    while len(text) < 64_000_000:
        for j in 0..7:
            text.extend(words[(j + k) % 7].bytes())
            text.push(32)
        text.push(10)
        k += 1
    var sum = 0
    for _ in 0..4:
        var lo = 0
        while lo < len(text):
            invariant lo >= 0
            let nl = find_byte(text, lo, len(text), 10)
            var i = lo
            var n = 0
            while i < nl:
                invariant lo <= i
                let sp = find_byte(text, i, nl, 32)
                n += 1
                sum += sp - i
                i = sp + 1
            sum += n
            lo = nl + 1
    print(len(text), sum)
