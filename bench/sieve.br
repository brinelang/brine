# The sieve of Eratosthenes up to 100 million: a big bool array, strided writes.

fn main():
    let n = 100_000_000
    var is_prime = [true] * (n + 1)
    is_prime[0] = false
    is_prime[1] = false
    var i = 2
    while i * i <= n:
        if is_prime[i]:
            var j = i * i
            while j <= n:
                is_prime[j] = false
                j += i
        i += 1
    var count = 0
    for k in 0..n + 1:
        if is_prime[k]:
            count += 1
    print(count)
