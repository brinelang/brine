# Matrix multiply, 800 x 800 floats in flat arrays (i-k-j order).

fn main():
    let n = 800
    var a = [0.0] * (n * n)
    var b = [0.0] * (n * n)
    for i in 0..n:
        for j in 0..n:
            a[i * n + j] = float((i * 7 + j * 3) % 17) / 17.0
            b[i * n + j] = float((i * 5 + j * 11) % 13) / 13.0
    var c = [0.0] * (n * n)
    for i in 0..n:
        for k in 0..n:
            let aik = a[i * n + k]
            for j in 0..n:
                c[i * n + j] += aik * b[k * n + j]
    var trace = 0.0
    for i in 0..n:
        trace += c[i * n + i]
    print(f"{trace:.6f}")
