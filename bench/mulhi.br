# The high halves of 200 million 64 x 64-bit products (as in 51-bit-limb
# field arithmetic): u128 multiplications cut back to 64 bits.
const M64: u128 = (1 << 64) - 1

fn mulhi(a: u64, b: u64) -> u64:
    return u64((u128(a).wrapping_mul(u128(b)) >> 64) & M64)

fn main():
    var acc: u64 = 0
    var x: u64 = 0x9E3779B97F4A7C15
    for i in 0..200_000_000:
        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
        acc ^= mulhi(x, x ^ u64(i))
        acc = acc.wrapping_add(u64(u128(acc).wrapping_mul(u128(x)) & M64))
    print(acc)
