# Compares brine with C on the programs in this folder: each one is built as C
# (`cc -O2`), as brine `--release` (through C) and as a brine dev build (native
# x86-64 where there is one), checked to print the same, and timed (best of a
# few runs).
#
#     brine run bench/compare.br -- [path/to/brine] [name ...]

const PROGRAMS = "nbody spectral fannkuch mandelbrot sieve binarytrees wordfreq matmul"
const RUNS = 3

fn exe(path: str) -> str:
    return path + ".exe" if os.name() == "windows" else path

# Runs cmd; Ok((seconds, stdout)) if it exits with 0.
fn timed(cmd: [str]) -> Result[(float, str), str]:
    let t0 = clock()
    let p = os.spawn(cmd, {}, true, false)?
    let code = os.wait(p)
    let dt = clock() - t0
    let (out, err) = os.output(p)
    if code != 0:
        return Err(f"{cmd[0]} exited with {code}: {err}")
    # C's stdout writes \r\n on Windows
    return Ok((dt, out.replace("\r\n", "\n")))

fn best(cmd: [str]) -> Result[(float, str), str]:
    var t = 1.0e9
    var out = ""
    for _ in 0..RUNS:
        let (dt, o) = timed(cmd)?
        t = min(t, dt)
        out = o
    return Ok((t, out))

# $CC, or the first of cc, gcc and clang that runs
fn find_cc() -> str:
    match getenv("CC"):
        case Some(c):
            return c
        case None:
            pass
    for c in ["cc", "gcc", "clang"]:
        if timed([c, "--version"]).is_ok():
            return c
    return "cc"

fn build(cmd: [str]) -> Result[(), str]:
    timed(cmd)?
    return Ok(())

fn main() -> Result[(), str]:
    let argv = args()
    var brine = "brine"
    var names: [str] = []
    for i, a in enumerate(argv):
        if i == 0 and (a.ends_with(".exe") or "/" in a or "\\" in a):
            brine = a
        else:
            names.push(a)
    if len(names) == 0:
        names = PROGRAMS.split()
    let cc = find_cc()
    let dir = "target/bench"
    os.make_dir(dir)?
    let (h1, h2, h3, h4) = ("program", "C -O2", "release", "dev (native)")
    print(f"{h1:<12} {h2:>8} {h3:>16} {h4:>16}")
    for name in names:
        let src = f"bench/{name}"
        let c_exe = exe(f"{dir}/{name}_c")
        let rel_exe = exe(f"{dir}/{name}_release")
        let dev_exe = exe(f"{dir}/{name}_dev")
        build([cc, "-O2", "-o", c_exe, src + ".c", "-lm"])?
        build([brine, "build", "--release", "-q", src + ".br", "-o", rel_exe])?
        build([brine, "build", "-q", src + ".br", "-o", dev_exe])?
        let (tc, oc) = best([c_exe])?
        let (tr, orl) = best([rel_exe])?
        let (td, od) = best([dev_exe])?
        if orl != oc or od != oc:
            return Err(f"{name}: brine and C print different results:\n{oc}\n{orl}\n{od}")
        let rel = f"{tr:.3f}s {tr / tc:.2f}x"
        let dev = f"{td:.3f}s {td / tc:.2f}x"
        print(f"{name:<12} {tc:>7.3f}s {rel:>16} {dev:>16}")
    return Ok(())
