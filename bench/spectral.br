# The spectral-norm benchmark: float math, small function calls, array reads.

fn a(i: int, j: int) -> float:
    let s = i + j
    return 1.0 / float(s * (s + 1) / 2 + i + 1)

fn mul_av(v: [float], ref out: [float]):
    let n = len(v)
    for i in 0..n:
        var s = 0.0
        for j in 0..n:
            s += a(i, j) * v[j]
        out[i] = s

fn mul_atv(v: [float], ref out: [float]):
    let n = len(v)
    for i in 0..n:
        var s = 0.0
        for j in 0..n:
            s += a(j, i) * v[j]
        out[i] = s

fn mul_atav(v: [float], ref out: [float], ref tmp: [float]):
    mul_av(v, ref tmp)
    mul_atv(tmp, ref out)

fn main():
    let n = 3000
    var u = [1.0] * n
    var v = [0.0] * n
    var tmp = [0.0] * n
    for _ in 0..10:
        mul_atav(u, ref v, ref tmp)
        mul_atav(v, ref u, ref tmp)
    var vbv = 0.0
    var vv = 0.0
    for i in 0..n:
        vbv += u[i] * v[i]
        vv += v[i] * v[i]
    print(f"{sqrt(vbv / vv):.9f}")
