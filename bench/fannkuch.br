# The fannkuch-redux benchmark: small int arrays, swaps and index arithmetic.

fn fannkuch(n: int) -> (int, int):
    var perm1 = [i for i in 0..n]
    var perm = [0] * n
    var count = [0] * n
    var max_flips = 0
    var checksum = 0
    var r = n
    var perm_count = 0
    var done = false
    while not done:
        while r != 1:
            count[r - 1] = r
            r -= 1
        for i in 0..n:
            perm[i] = perm1[i]
        var flips = 0
        var k = perm[0]
        while k != 0:
            var i = 0
            var j = k
            while i < j:
                let t = perm[i]
                perm[i] = perm[j]
                perm[j] = t
                i += 1
                j -= 1
            flips += 1
            k = perm[0]
        max_flips = max(max_flips, flips)
        if perm_count % 2 == 0:
            checksum += flips
        else:
            checksum -= flips
        # the next permutation
        var more = true
        while more:
            if r == n:
                done = true
                more = false
            else:
                let perm0 = perm1[0]
                for i in 0..r:
                    perm1[i] = perm1[i + 1]
                perm1[r] = perm0
                count[r] -= 1
                if count[r] > 0:
                    more = false
                else:
                    r += 1
        perm_count += 1
    return (checksum, max_flips)

fn main():
    let n = 11
    let (checksum, flips) = fannkuch(n)
    print(checksum)
    print(f"Pfannkuchen({n}) = {flips}")
