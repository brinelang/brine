# Mandelbrot set, 4096 x 4096 pixels, up to 512 iterations each.
fn escape(px: int, py: int, size: int) -> i32:
    let cx = float(px) * 3.0 / float(size) - 2.25
    let cy = float(py) * 3.0 / float(size) - 1.5
    var x = 0.0
    var y = 0.0
    var k: i32 = 0
    while k < 512 and x * x + y * y <= 4.0:
        let t = x * x - y * y + cx
        y = 2.0 * x * y + cy
        x = t
        k += 1
    return k

fn main():
    let size = 4096
    var times: [float] = []
    var check = 0
    for rep in 0..4:
        let t0 = clock()
        let img = par [escape(i % size, i / size, size) for i in 0..size * size]
        times.push((clock() - t0) * 1000.0)
        check = par sum(int(k) for k in img)
    print(check)
    eprint(f"mandelbrot {size}x{size}: cold {times[0]:.1f} ms, warm {min(times[1:]):.1f} ms")
