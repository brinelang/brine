# One n-body step (accelerations of 16384 bodies, all pairs), in f64 and f32.
fn step64(px: [float], py: [float], pz: [float], m: [float]) -> [(float, float, float)]:
    let n = len(px)
    return par [accel64(i, px, py, pz, m) for i in 0..n]

fn accel64(i: int, px: [float], py: [float], pz: [float], m: [float]) -> (float, float, float):
    var ax = 0.0
    var ay = 0.0
    var az = 0.0
    for j in 0..len(px):
        let dx = px[j] - px[i]
        let dy = py[j] - py[i]
        let dz = pz[j] - pz[i]
        let d2 = dx * dx + dy * dy + dz * dz + 0.0001
        let s = m[j] / (d2 * sqrt(d2))
        ax += dx * s
        ay += dy * s
        az += dz * s
    return (ax, ay, az)

fn step32(px: [f32], py: [f32], pz: [f32], m: [f32]) -> [(f32, f32, f32)]:
    let n = len(px)
    return par [accel32(i, px, py, pz, m) for i in 0..n]

fn accel32(i: int, px: [f32], py: [f32], pz: [f32], m: [f32]) -> (f32, f32, f32):
    var ax: f32 = 0
    var ay: f32 = 0
    var az: f32 = 0
    for j in 0..len(px):
        let dx = px[j] - px[i]
        let dy = py[j] - py[i]
        let dz = pz[j] - pz[i]
        let d2 = dx * dx + dy * dy + dz * dz + f32(0.0001)
        let s = m[j] / (d2 * sqrt(d2))
        ax += dx * s
        ay += dy * s
        az += dz * s
    return (ax, ay, az)

fn main():
    let n = 16384
    let px = [float(i * 7919 % 10007) * 0.001 for i in 0..n]
    let py = [float(i * 104729 % 10009) * 0.001 for i in 0..n]
    let pz = [float(i * 1299709 % 10037) * 0.001 for i in 0..n]
    let m = [1.0 + float(i % 7) * 0.1 for i in 0..n]
    var t64: [float] = []
    var c64 = 0.0
    for rep in 0..4:
        let t0 = clock()
        let a = step64(px, py, pz, m)
        t64.push((clock() - t0) * 1000.0)
        c64 = a[0].0 + a[n / 2].1 + a[n - 1].2
    let qx = [f32(x) for x in px]
    let qy = [f32(y) for y in py]
    let qz = [f32(z) for z in pz]
    let qm = [f32(v) for v in m]
    var t32: [float] = []
    var c32: f32 = 0
    for rep in 0..4:
        let t0 = clock()
        let a = step32(qx, qy, qz, qm)
        t32.push((clock() - t0) * 1000.0)
        c32 = a[0].0 + a[n / 2].1 + a[n - 1].2
    print(c64, c32)
    eprint(f"nbody f64 n={n}: cold {t64[0]:.1f} ms, warm {min(t64[1:]):.1f} ms")
    eprint(f"nbody f32 n={n}: cold {t32[0]:.1f} ms, warm {min(t32[1:]):.1f} ms")
