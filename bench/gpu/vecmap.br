# A big vector map: a degree-16 polynomial of every element of 16M floats.
# Prints a checksum on stdout and the times (ms) on stderr; `bench/gpu/run.sh`
# runs it with BRINE_GPU=off, on and auto.
fn poly(x: float) -> float:
    var p = 0.0
    for k in 0..16:
        p = p * x + 1.0 / float(k + 1)
    return p

fn main():
    let n = 1 << 24
    let xs = [float(i % 1000) * 0.001 - 0.5 for i in 0..n]
    var times: [float] = []
    var check = 0.0
    for rep in 0..6:
        let t0 = clock()
        let ys = par [poly(x) for x in xs]
        times.push((clock() - t0) * 1000.0)
        check = ys[0] + ys[n / 2] + ys[n - 1]
    print(check)
    eprint(f"vecmap f64 n={n}: cold {times[0]:.1f} ms, warm {min(times[1:]):.1f} ms")
