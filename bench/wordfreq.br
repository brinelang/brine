# Word frequencies: building strings and counting them in a {str: int} map.

fn main():
    let letters = "abcdefgh"
    var seed = 42
    var counts: {str: int} = {}
    for _ in 0..3_000_000:
        seed = (seed * 1103515245 + 12345) % 2147483648
        let len_ = 3 + seed % 4
        var w = ""
        for _ in 0..len_:
            seed = (seed * 1103515245 + 12345) % 2147483648
            w += letters[seed / 65536 % 8]
        if w in counts:
            counts[w] += 1
        else:
            counts[w] = 1
    var squares = 0
    var top = 0
    for w in counts:
        let c = counts[w]
        squares += c * c
        top = max(top, c)
    print(len(counts), squares, top)
