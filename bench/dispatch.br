# A bytecode interpreter's dispatch loop: a `match` on 40 dense opcodes,
# the shape of a WebAssembly or Lua interpreter, which a jump table runs in
# one indirect jump instead of up to 40 tests. The program is a loop of 256
# instructions, as an interpreter's hot loop would be.

fn main():
    let n = 256
    var code = [0] * n
    var s: u64 = 12345
    for i in 0..n:
        s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
        code[i] = int(s >> 33) % 40
    var a: u64 = 1
    var b: u64 = 2
    var pc = 0
    for _ in 0..300_000_000:
        match code[pc]:
            case 0:
                a = a.wrapping_add(b ^ 3652509721)
            case 1:
                b = b.rotate_left(8) ^ a
            case 2:
                a = a.wrapping_mul(3628718147)
            case 3:
                b = b.wrapping_sub(a >> 22)
            case 4:
                a = a ^ (b << 29) ^ 4
            case 5:
                a = a.wrapping_add(b ^ 1445547138)
            case 6:
                b = b.rotate_left(43) ^ a
            case 7:
                a = a.wrapping_mul(1421755565)
            case 8:
                b = b.wrapping_sub(a >> 57)
            case 9:
                a = a ^ (b << 3) ^ 9
            case 10:
                a = a.wrapping_add(b ^ 3533551851)
            case 11:
                b = b.rotate_left(17) ^ a
            case 12:
                a = a.wrapping_mul(3509760277)
            case 13:
                b = b.wrapping_sub(a >> 31)
            case 14:
                a = a ^ (b << 6) ^ 14
            case 15:
                a = a.wrapping_add(b ^ 1326589268)
            case 16:
                b = b.rotate_left(52) ^ a
            case 17:
                a = a.wrapping_mul(1302797695)
            case 18:
                b = b.wrapping_sub(a >> 5)
            case 19:
                a = a ^ (b << 12) ^ 19
            case 20:
                a = a.wrapping_add(b ^ 3414593981)
            case 21:
                b = b.rotate_left(26) ^ a
            case 22:
                a = a.wrapping_mul(3390802407)
            case 23:
                b = b.wrapping_sub(a >> 40)
            case 24:
                a = a ^ (b << 15) ^ 24
            case 25:
                a = a.wrapping_add(b ^ 1207631398)
            case 26:
                b = b.rotate_left(61) ^ a
            case 27:
                a = a.wrapping_mul(1183839825)
            case 28:
                b = b.wrapping_sub(a >> 14)
            case 29:
                a = a ^ (b << 21) ^ 29
            case 30:
                a = a.wrapping_add(b ^ 3295636111)
            case 31:
                b = b.rotate_left(35) ^ a
            case 32:
                a = a.wrapping_mul(3271844537)
            case 33:
                b = b.wrapping_sub(a >> 49)
            case 34:
                a = a ^ (b << 24) ^ 34
            case 35:
                a = a.wrapping_add(b ^ 1088673528)
            case 36:
                b = b.rotate_left(9) ^ a
            case 37:
                a = a.wrapping_mul(1064881955)
            case 38:
                b = b.wrapping_sub(a >> 23)
            case 39:
                a = a ^ (b << 30) ^ 39
            case _:
                pass
        pc = (pc + 1) & (n - 1)
    print(a, b)
