# Large float sums: of an array (memory-bound, the array must reach the GPU)
# and of a computed series (compute-bound, nothing to copy).
fn main():
    let n = 1 << 26
    let xs = [float(i % 1000) * 0.001 for i in 0..n]
    let ys = [f32(x) for x in xs]
    var ta: [float] = []
    var tf: [float] = []
    var ts: [float] = []
    var a = 0.0
    var f: f32 = 0
    var s = 0.0
    for rep in 0..6:
        var t0 = clock()
        a = par sum(x for x in xs)
        ta.push((clock() - t0) * 1000.0)
        t0 = clock()
        f = par sum(y for y in ys)
        tf.push((clock() - t0) * 1000.0)
        t0 = clock()
        s = par sum(1.0 / (float(i) * float(i) + 1.0) for i in 0..n * 4)
        ts.push((clock() - t0) * 1000.0)
    print(a, f, s)
    eprint(f"sum of [float] n={n}: cold {ta[0]:.1f} ms, warm {min(ta[1:]):.1f} ms")
    eprint(f"sum of [f32] n={n}: cold {tf[0]:.1f} ms, warm {min(tf[1:]):.1f} ms")
    eprint(f"sum of a series n={n * 4}: cold {ts[0]:.1f} ms, warm {min(ts[1:]):.1f} ms")
