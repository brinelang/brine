# The binary-trees benchmark: allocating and freeing many small recursive values.

enum Tree:
    Leaf
    Node(left: Tree, right: Tree)

fn make(depth: int) -> Tree:
    if depth == 0:
        return Tree.Node(left=Tree.Leaf, right=Tree.Leaf)
    return Tree.Node(left=make(depth - 1), right=make(depth - 1))

fn check(t: Tree) -> int:
    match t:
        case Tree.Leaf:
            return 0
        case Tree.Node(l, r):
            return 1 + check(l) + check(r)

fn main():
    let min_depth = 4
    let max_depth = 18
    let stretch = max_depth + 1
    print(f"stretch tree of depth {stretch}\t check: {check(make(stretch))}")
    let long_lived = make(max_depth)
    var d = min_depth
    while d <= max_depth:
        let iterations = 1 << (max_depth - d + min_depth)
        var total = 0
        for _ in 0..iterations:
            total += check(make(d))
        print(f"{iterations}\t trees of depth {d}\t check: {total}")
        d += 2
    print(f"long lived tree of depth {max_depth}\t check: {check(long_lived)}")
